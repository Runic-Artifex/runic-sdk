{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://runic-artifex.eu/schemas/translations/locale-artifact-v5.schema.json",
  "title": "Runic RMF2 resolved locale artifact v5",
  "type": "object",
  "required": [
    "artifactVersion",
    "messageGrammarVersion",
    "profile",
    "catalog",
    "locale",
    "contractFingerprint",
    "messages",
    "markupContract"
  ],
  "properties": {
    "artifactVersion": {
      "const": 5
    },
    "messageGrammarVersion": {
      "const": 5
    },
    "profile": {
      "const": "rmf2-execution-v2"
    },
    "catalog": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]*$"
    },
    "locale": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$"
    },
    "contractFingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "messages": {
      "type": "object",
      "maxProperties": 50000,
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "contentLocale",
          "ast"
        ],
        "properties": {
          "contentLocale": {
            "type": "string",
            "minLength": 1
          },
          "ast": {
            "$ref": "message-ast-v5.schema.json"
          }
        },
        "additionalProperties": false
      }
    },
    "markupContract": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "contracts": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "paired",
                  "standalone"
                ]
              },
              "interactive": {
                "type": "boolean"
              },
              "plainText": {
                "enum": [
                  "children",
                  "lineBreak",
                  "alternateText",
                  "explicit",
                  "omit"
                ]
              },
              "options": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "enum": [
                        "string",
                        "number",
                        "boolean",
                        "enum"
                      ]
                    },
                    "values": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "default": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "literalOnly": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "type",
                    "values",
                    "default",
                    "literalOnly"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "kind",
              "interactive",
              "plainText",
              "options"
            ],
            "additionalProperties": false
          }
        },
        "messages": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "slots": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "enum": [
                        "runic:link",
                        "runic:action",
                        "runic:icon"
                      ]
                    },
                    "min": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "max": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 4096
                    }
                  },
                  "required": [
                    "kind",
                    "min",
                    "max"
                  ],
                  "additionalProperties": false
                }
              },
              "structured": {
                "type": "boolean"
              },
              "contentLocales": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            },
            "required": [
              "slots",
              "structured",
              "contentLocales"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "version",
        "contracts",
        "messages"
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
