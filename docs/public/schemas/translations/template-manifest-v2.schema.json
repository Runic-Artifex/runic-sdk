{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://runic-artifex.eu/schemas/translations/template-manifest-v2.schema.json",
  "title": "Runic Translations Template Manifest v2",
  "description": "Versioned, value-free edge contract for schema-v2 and RMF2 template compilers and editor tooling.",
  "type": "object",
  "required": [
    "manifestVersion",
    "messageGrammarVersion",
    "catalog",
    "contractFingerprint",
    "messages"
  ],
  "properties": {
    "manifestVersion": {
      "const": 2
    },
    "messageGrammarVersion": {
      "enum": [2, 4]
    },
    "catalog": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]*$"
    },
    "contractFingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "messages": {
      "type": "object",
      "maxProperties": 50000,
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/message"
      },
      "unevaluatedProperties": false
    }
  },
  "additionalProperties": false,
  "unevaluatedProperties": false,
  "$defs": {
    "message": {
      "type": "object",
      "required": [
        "description",
        "since",
        "deprecated",
        "tags",
        "arguments"
      ],
      "properties": {
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "since": {
          "type": [
            "string",
            "null"
          ]
        },
        "deprecated": {
          "type": [
            "string",
            "null"
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "arguments": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/argument"
          }
        }
      },
      "additionalProperties": false,
      "unevaluatedProperties": false
    },
    "argument": {
      "type": "object",
      "required": [
        "name",
        "type",
        "format"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "type": {
          "enum": [
            "string",
            "int",
            "number",
            "bool",
            "date",
            "time",
            "datetime",
            "guid"
          ]
        },
        "format": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "unevaluatedProperties": false
    }
  }
}
