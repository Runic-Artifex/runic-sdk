{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://runic-artifex.eu/schemas/translations/web-module-manifest-v3.schema.json",
  "title": "Runic.Translations staged RMF2 web module manifest v3",
  "type": "object",
  "required": [
    "webModuleManifestVersion", "esmAbiVersion", "rmf2RuntimeAbiVersion",
    "messageGrammarVersion", "profile", "generatedNameVersion", "catalog",
    "contractFingerprint", "sourceHash", "entrypoints", "assets"
  ],
  "properties": {
    "webModuleManifestVersion": { "const": 3 },
    "esmAbiVersion": { "const": 4 },
    "rmf2RuntimeAbiVersion": { "const": 2 },
    "messageGrammarVersion": { "const": 5 },
    "profile": { "const": "rmf2-execution-v2" },
    "generatedNameVersion": { "const": 1 },
    "catalog": { "type": "string", "pattern": "^[a-z][a-z0-9.-]*$" },
    "contractFingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "sourceHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "entrypoints": {
      "type": "object",
      "required": ["messages", "types", "runtime", "server", "transport", "dynamic"],
      "properties": {
        "messages": { "const": "messages.js" }, "types": { "const": "messages.d.ts" },
        "runtime": { "const": "runtime.js" }, "server": { "const": "server.js" },
        "transport": { "const": "transport.js" }, "dynamic": { "const": "dynamic.js" }
      },
      "additionalProperties": false
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256", "byteLength", "mediaType"],
        "properties": {
          "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_$.-]+(?:/[A-Za-z0-9_$.-]+)*$" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "byteLength": { "type": "integer", "minimum": 0 },
          "mediaType": { "enum": ["text/javascript", "text/typescript"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
