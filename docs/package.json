{
  "name": "runic-artifex-docs",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite dev",
    "generate:release-data": "node scripts/generate-release-data.mjs",
    "check:release-data": "node scripts/generate-release-data.mjs --check",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "npm run check:release-data && npm run build && node --test tests/*.test.mjs",
    "lint": "prettier --check . && eslint ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@lucide/svelte": "^1.31.0",
