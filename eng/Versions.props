<Project>
  <PropertyGroup>
    <RunicSdkVersion>0.25.0</RunicSdkVersion>
    <!-- Last published release; package validation compares shipping libraries with it. -->
    <RunicPackageValidationBaselineVersion>0.24.0</RunicPackageValidationBaselineVersion>
    <!-- Runic.Application.Views.CsWebUi is the preview package. It depends on the prerelease CsWebUi, so from 1.0
         it ships on a prerelease version of its own; the package, central package management and the runic-app
         template's cswebui host read it here. eng/workspace.json owns it ("version" on the package's entry);
         this is a copy that `bun eng/version.mjs check` compares and `bump` rewrites. -->
    <RunicCsWebUiPackageVersion Condition="'$(RunicCsWebUiPackageVersion)' == ''">0.25.0-preview.1</RunicCsWebUiPackageVersion>
    <!-- Last published Runic.Application.Views.CsWebUi, its package validation baseline (0.24.0 shipped it as 0.24.0-preview.1).
         Update it with RunicPackageValidationBaselineVersion after each release. -->
    <RunicCsWebUiPackageValidationBaselineVersion>0.24.0-preview.1</RunicCsWebUiPackageValidationBaselineVersion>
    <!-- Runic.Spelling, an application's own spell checker (D074.10), is a preview package outside the 1.0 promise like
         CsWebUi, on a version of its own; eng/workspace.json owns it ("version" on the package's entry). -->
    <RunicSpellingPackageVersion Condition="'$(RunicSpellingPackageVersion)' == ''">0.25.0-preview.1</RunicSpellingPackageVersion>
    <!-- Last published Runic.Spelling, its package validation baseline (0.24.0 shipped it as 0.24.0-preview.1).
         Update it with RunicPackageValidationBaselineVersion after each release. -->
    <RunicSpellingPackageValidationBaselineVersion>0.24.0-preview.1</RunicSpellingPackageValidationBaselineVersion>
    <Version Condition="'$(Version)' == ''">$(RunicSdkVersion)</Version>
    <PackageVersion Condition="'$(PackageVersion)' == ''">$(RunicSdkVersion)</PackageVersion>
  </PropertyGroup>
</Project>
