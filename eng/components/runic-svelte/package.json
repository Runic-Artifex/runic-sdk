{
  "name": "@runic-artifex/runic-svelte-workspace",
  "private": true,
  "version": "0.0.0-private",
  "license": "MIT",
  "type": "module",
  "packageManager": "npm@11.16.0",
  "workspaces": ["packages/*"],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "check": "npm run check --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:package-consumers": "node test/package-consumers.mjs",
    "verify": "npm run check && npm run test && npm run pack:check --workspaces --if-present && npm run test:package-consumers"
  },
  "devDependencies": {
    "@runic-artifex/application-bridge": "^0.1.0-preview.30.1",
    "@runic-artifex/vite-plugin-runic": "file:./test/fixtures/vite-plugin-runic",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.70.2",
    "@sveltejs/package": "2.5.8",
    "@sveltejs/vite-plugin-svelte": "7.2.0",
    "@types/node": "24.10.12",
    "effect": "3.22.1",
    "happy-dom": "^20.11.2",
    "svelte": "5.56.8",
    "svelte-check": "4.7.5",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=24.18.0"
  }
}
