{
  "name": "@runic-artifex/runic-svelte-workspace",
  "private": true,
  "version": "0.0.0-private",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --workspaces --if-present build",
    "check": "bun run --workspaces --if-present check",
    "test": "bun run --filter @runic-artifex/svelte test && bun run --filter @runic-artifex/sveltekit test",
    "test:package-consumers": "node test/package-consumers.mjs",
    "verify": "bun run check && bun run test && bun run --workspaces --if-present pack:check && bun run test:package-consumers && node --test eng/prepare-packages.test.mjs"
  },
  "devDependencies": {
    "@runic-artifex/application-bridge": "^0.1.0-preview.30.1",
    "@runic-artifex/svelte": "workspace:*",
    "@runic-artifex/vite-plugin-runic": "file:./test/fixtures/vite-plugin-runic",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.70.2",
    "@sveltejs/package": "2.5.8",
    "@sveltejs/vite-plugin-svelte": "7.2.0",
    "@types/node": "24.10.12",
    "effect": "3.22.1",
    "happy-dom": "^20.11.2",
    "svelte": "5.56.8",
    "svelte-check": "4.7.5",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=24.18.0"
  }
}
