<Project>
  <PropertyGroup Condition="'$(RunicTextResourcesShippingProject)' == 'true'">
    <EnableTrimAnalyzer Condition="'$(EnableTrimAnalyzer)' == '' and ('$(RunicTextResourcesVerificationBuild)' == 'true' or '$(PublishTrimmed)' == 'true' or '$(PublishAot)' == 'true')">true</EnableTrimAnalyzer>
    <EnableTrimAnalyzer Condition="'$(EnableTrimAnalyzer)' == ''">false</EnableTrimAnalyzer>
    <EnableAotAnalyzer Condition="'$(EnableAotAnalyzer)' == '' and ('$(RunicTextResourcesVerificationBuild)' == 'true' or '$(PublishAot)' == 'true')">true</EnableAotAnalyzer>
    <EnableAotAnalyzer Condition="'$(EnableAotAnalyzer)' == ''">false</EnableAotAnalyzer>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <Target Name="ValidateRunicTextResourcesBuildMode" BeforeTargets="PrepareForBuild">
    <Error
      Condition="'$(RunicTextResourcesBuildMode)' != 'Development' and '$(RunicTextResourcesBuildMode)' != 'Verification'"
      Text="RunicTextResourcesBuildMode must be either Development or Verification." />
  </Target>
</Project>
