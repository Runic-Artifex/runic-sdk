{
  "name": "@runic-artifex/runic-desktop-workspace",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=24.18.0"
  },
  "workspaces": [
    "web/packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present && npm run build:browser-fixture",
    "build:browser-fixture": "esbuild web/packages/desktop/test/browser-entry.ts --bundle --format=esm --platform=browser --target=es2022 --outfile=artifacts/browser/runic-desktop-test.js",
    "test": "npm run verify:contract && npm run build && npm run test:quality-receipt && npm run test --workspaces --if-present",
    "test:quality-receipt": "node --test eng/verify-linux-native-quality-receipt.test.mjs",
    "verify:contract": "node eng/verify-contract.mjs",
    "verify:linux-native-quality": "node eng/verify-linux-native-quality-receipt.mjs verify-receipt evidence/native-quality/linux-x64.json",
    "verify": "npm run test"
  },
  "devDependencies": {
    "esbuild": "0.27.4",
    "typescript": "7.0.2"
  }
}
