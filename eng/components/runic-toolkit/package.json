{
  "name": "@runic-artifex/runic-toolkit-workspace",
  "private": true,
  "version": "0.0.0-private",
  "license": "MIT",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": "24.18.x",
    "npm": "11.16.x"
  },
  "workspaces": [
    "web/packages/*"
  ],
  "scripts": {
    "generate:application-bridge": "node eng/generate-application-bridge-contract.mjs && node eng/generate-application-bridge-contract.mjs protocol/application-bridge/counter/contract.mjs protocol/application-bridge/counter/generated",
    "verify:application-bridge-artifacts": "node eng/generate-application-bridge-contract.mjs --check && node eng/generate-application-bridge-contract.mjs protocol/application-bridge/counter/contract.mjs protocol/application-bridge/counter/generated --check",
    "build": "node eng/run-workspaces.mjs build",
    "test": "node eng/run-workspaces.mjs test",
    "verify:frontend-parity": "node eng/verify-frontend-parity.mjs",
    "verify": "npm run verify:application-bridge-artifacts && npm run build && npm run test && npm run verify:frontend-parity"
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "typescript": "5.9.3",
    "vite": "8.1.5"
  }
}
