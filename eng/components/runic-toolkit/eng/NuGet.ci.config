<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="github" value="https://nuget.pkg.github.com/Runic-Artifex/index.json" protocolVersion="3" />
    <add key="verification" value="../artifacts/verification/packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <config>
    <add key="globalPackagesFolder" value="../.packages/nuget" />
  </config>
  <packageSourceMapping>
    <packageSource key="github">
      <package pattern="Runic.CommandLine" />
      <package pattern="Runic.CommandLine.*" />
      <package pattern="Runic.Assets" />
      <package pattern="Runic.Assets.*" />
      <package pattern="Runic.Translations" />
      <package pattern="Runic.Translations.*" />
      <package pattern="Runic.Desktop" />
    </packageSource>
    <packageSource key="verification">
      <package pattern="Runic.Application" />
      <package pattern="Runic.Application.*" />
      <package pattern="dotnet-runic" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
