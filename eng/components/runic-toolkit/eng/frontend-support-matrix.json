{
  "schema": "runic-toolkit.frontend-support-matrix/3",
  "policy": "Effect owns the application protocol and lifetime once; renderers project validated domain state without protocol adapters.",
  "protocolOwner": "@runic-artifex/application-bridge",
  "sharedGates": {
    "contract": "protocol/application-bridge/setup/contract.mjs",
    "manifest": "protocol/application-bridge/setup/generated/bridge.manifest.json",
    "runtime": "web/packages/application-bridge",
    "dotnet": "src/RunicToolkit.ApplicationBridge",
    "generator": "src/RunicToolkit.ApplicationBridge.Generators",
    "transport": "src/RunicToolkit.Hosting.CsWebUi.ApplicationBridge"
  },
  "renderers": {
    "react": { "ownsProtocolState": false },
    "vue": { "ownsProtocolState": false },
    "svelte": { "ownsProtocolState": false },
    "angular": { "ownsProtocolState": false }
  }
}
