<Project>
  <!-- Internal fixture experiment: this file is intentionally not imported by shipping targets. -->
  <PropertyGroup>
    <_RunicPostMvvmDiscoveryRoot>$(MSBuildThisFileDirectory)../../</_RunicPostMvvmDiscoveryRoot>
    <!-- A selected fixture mode can build the same source project with a
         different compiled contract. Keep those generated artifacts outside
         the default consumer path. The empty key preserves its established
         path for the ordinary fixture. -->
    <_RunicPostMvvmDiscoveryOutputSegment Condition="'$(RunicPostMvvmDiscoveryOutputKey)' != ''">$(RunicPostMvvmDiscoveryOutputKey)/</_RunicPostMvvmDiscoveryOutputSegment>
    <_RunicPostMvvmDiscoveryGeneratedDir>$(MSBuildProjectDirectory)/obj/runic-post-mvvm-discovery/$(_RunicPostMvvmDiscoveryOutputSegment)$(Configuration)/$(TargetFramework)/</_RunicPostMvvmDiscoveryGeneratedDir>
    <_RunicPostMvvmDiscoveryBootstrapDir>$(MSBuildProjectDirectory)/obj/runic-post-mvvm-discovery/bootstrap/$(_RunicPostMvvmDiscoveryOutputSegment)$(Configuration)/</_RunicPostMvvmDiscoveryBootstrapDir>
    <_RunicPostMvvmDiscoveryInspectorProject>$(_RunicPostMvvmDiscoveryRoot)tools/Runic.Application.Bridge.Inspector/Runic.Application.Bridge.Inspector.csproj</_RunicPostMvvmDiscoveryInspectorProject>
    <_RunicPostMvvmDiscoveryInspectorDll>$(_RunicPostMvvmDiscoveryRoot)tools/Runic.Application.Bridge.Inspector/bin/$(Configuration)/net10.0/Runic.Application.Bridge.Inspector.dll</_RunicPostMvvmDiscoveryInspectorDll>
    <_RunicPostMvvmDiscoveryBootstrapAssembly>$(_RunicPostMvvmDiscoveryBootstrapDir)bin/$(AssemblyName).dll</_RunicPostMvvmDiscoveryBootstrapAssembly>
    <_RunicPostMvvmDiscoveryIr>$(_RunicPostMvvmDiscoveryGeneratedDir)view-bridge.ir.json</_RunicPostMvvmDiscoveryIr>
    <_RunicPostMvvmDiscoveryEsm>$(_RunicPostMvvmDiscoveryGeneratedDir)view-bridge.contract.ts</_RunicPostMvvmDiscoveryEsm>
    <_RunicPostMvvmDiscoveryReady>$(_RunicPostMvvmDiscoveryGeneratedDir)view-bridge.ready.json</_RunicPostMvvmDiscoveryReady>
    <_RunicPostMvvmDiscoveryAdapter>$(_RunicPostMvvmDiscoveryGeneratedDir)PostMvvmDiscoveryAdapter.g.cs</_RunicPostMvvmDiscoveryAdapter>
    <_RunicPostMvvmDiscoveryStages>$(_RunicPostMvvmDiscoveryGeneratedDir)stages.log</_RunicPostMvvmDiscoveryStages>
  </PropertyGroup>

  <Target Name="RunicPostMvvmDiscoveryPrepare" BeforeTargets="RunicPostMvvmDiscoveryGenerate"
          Condition="'$(_RunicPostMvvmDiscovery)' == 'true' and '$(RunicPostMvvmDiscoveryBootstrap)' != 'true' and '$(RunicPostMvvmDiscoveryGenerate)' != 'false'">
    <RemoveDir Directories="$(_RunicPostMvvmDiscoveryGeneratedDir)" />
    <MakeDir Directories="$(_RunicPostMvvmDiscoveryGeneratedDir)" />
    <WriteLinesToFile File="$(_RunicPostMvvmDiscoveryStages)" Lines="" Overwrite="true" />
  </Target>

  <Target Name="RunicPostMvvmDiscoveryBootstrapMarker" BeforeTargets="CoreCompile"
          Condition="'$(RunicPostMvvmDiscoveryBootstrap)' == 'true'">
    <MakeDir Directories="$(_RunicPostMvvmDiscoveryGeneratedDir)" />
    <WriteLinesToFile File="$(_RunicPostMvvmDiscoveryStages)" Lines="bootstrap" Overwrite="false" />
  </Target>

  <Target Name="RunicPostMvvmDiscoveryClean" AfterTargets="CoreClean"
          Condition="'$(_RunicPostMvvmDiscovery)' == 'true' and '$(RunicPostMvvmDiscoveryBootstrap)' != 'true'">
    <RemoveDir Directories="$(_RunicPostMvvmDiscoveryGeneratedDir);$(_RunicPostMvvmDiscoveryBootstrapDir)" />
  </Target>

  <Target Name="RunicPostMvvmDiscoveryGenerate" BeforeTargets="CoreCompile"
          DependsOnTargets="RunicPostMvvmDiscoveryPrepare"
          Condition="'$(_RunicPostMvvmDiscovery)' == 'true' and '$(RunicPostMvvmDiscoveryBootstrap)' != 'true' and '$(RunicPostMvvmDiscoveryGenerate)' != 'false'">
    <!-- A parent NativeAOT publish is a global MSBuild property. Remove it
         explicitly for these build-time tools: they execute under `dotnet`,
         and trimming them both breaks reflection-based inspection and says
         nothing about the application being published. -->
    <MSBuild Projects="$(_RunicPostMvvmDiscoveryInspectorProject)" Targets="Build"
             Properties="Configuration=$(Configuration);TargetFramework=net10.0;RuntimeIdentifier=;PublishAot=false;PublishTrimmed=false;EnableTrimAnalyzer=false;EnableAotAnalyzer=false;SelfContained=false"
             RemoveProperties="PublishAot;PublishTrimmed;EnableTrimAnalyzer;EnableAotAnalyzer;RuntimeIdentifier;SelfContained;OutputPath;IntermediateOutputPath" />
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="Build"
             Properties="RunicPostMvvmDiscoveryBootstrap=true;RunicPostMvvmDiscoveryGenerate=false;_RunicPostMvvmDiscovery=false;Configuration=$(Configuration);TargetFramework=$(TargetFramework);RuntimeIdentifier=;PublishAot=false;PublishTrimmed=false;EnableTrimAnalyzer=false;EnableAotAnalyzer=false;SelfContained=false;CopyLocalLockFileAssemblies=true;OutputPath=$(_RunicPostMvvmDiscoveryBootstrapDir)bin/;IntermediateOutputPath=$(_RunicPostMvvmDiscoveryBootstrapDir)obj/$(TargetFramework)/"
             RemoveProperties="PublishAot;PublishTrimmed;EnableTrimAnalyzer;EnableAotAnalyzer;RuntimeIdentifier;SelfContained" />
    <Error Condition="!Exists('$(_RunicPostMvvmDiscoveryBootstrapAssembly)')"
           Text="The post-MVVM discovery bootstrap assembly was not produced at $(_RunicPostMvvmDiscoveryBootstrapAssembly)." />
    <Exec Command="dotnet &quot;$(_RunicPostMvvmDiscoveryInspectorDll)&quot; __post-mvvm-discover --assembly &quot;$(_RunicPostMvvmDiscoveryBootstrapAssembly)&quot; --ir &quot;$(_RunicPostMvvmDiscoveryIr)&quot; --esm &quot;$(_RunicPostMvvmDiscoveryEsm)&quot; --adapter &quot;$(_RunicPostMvvmDiscoveryAdapter)&quot; --ready &quot;$(_RunicPostMvvmDiscoveryReady)&quot;" />
    <ItemGroup><Compile Include="$(_RunicPostMvvmDiscoveryAdapter)" /></ItemGroup>
    <WriteLinesToFile File="$(_RunicPostMvvmDiscoveryStages)" Lines="outer" Overwrite="false" />
    <Message Importance="high" Text="POST_MVVM_SDK_DISCOVERY_TARGET|configuration=$(Configuration)|bootstrap=1|outer=1" />
  </Target>
</Project>
