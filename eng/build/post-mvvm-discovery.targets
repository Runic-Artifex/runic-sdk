<Project>
  <!-- Internal fixture experiment: this file is intentionally not imported by shipping targets. -->
  <PropertyGroup>
    <_RunicPostMvvmDiscoveryRoot>$(MSBuildThisFileDirectory)../../</_RunicPostMvvmDiscoveryRoot>
    <!-- This is a directory name, not a path. The validation target below is
         a dependency of every target that removes generated output. -->
    <_RunicPostMvvmDiscoveryGeneratedDir>$(_RunicPostMvvmDiscoveryOwnerRoot)generated/$(Configuration)/$(TargetFramework)/</_RunicPostMvvmDiscoveryGeneratedDir>
    <_RunicPostMvvmDiscoveryInspectorProject>$(_RunicPostMvvmDiscoveryRoot)tools/Runic.Application.Bridge.Inspector/Runic.Application.Bridge.Inspector.csproj</_RunicPostMvvmDiscoveryInspectorProject>
    <_RunicPostMvvmDiscoveryInspectorDll>$(_RunicPostMvvmDiscoveryOwnerRoot)inspector/bin/$(Configuration)/net10.0/Runic.Application.Bridge.Inspector.dll</_RunicPostMvvmDiscoveryInspectorDll>
    <_RunicPostMvvmDiscoveryBootstrapAssembly>$(_RunicPostMvvmDiscoveryOwnerRoot)bootstrap/bin/$(Configuration)/$(TargetFramework)/$(AssemblyName).dll</_RunicPostMvvmDiscoveryBootstrapAssembly>
    <_RunicPostMvvmDiscoveryIr>$(_RunicPostMvvmDiscoveryGeneratedDir)view-bridge.ir.json</_RunicPostMvvmDiscoveryIr>
    <_RunicPostMvvmDiscoveryEsm>$(_RunicPostMvvmDiscoveryGeneratedDir)view-bridge.contract.ts</_RunicPostMvvmDiscoveryEsm>
    <_RunicPostMvvmDiscoveryReady>$(_RunicPostMvvmDiscoveryGeneratedDir)view-bridge.ready.json</_RunicPostMvvmDiscoveryReady>
    <_RunicPostMvvmDiscoveryAdapter>$(_RunicPostMvvmDiscoveryGeneratedDir)PostMvvmDiscoveryAdapter.g.cs</_RunicPostMvvmDiscoveryAdapter>
    <_RunicPostMvvmDiscoveryStages>$(_RunicPostMvvmDiscoveryGeneratedDir)stages.log</_RunicPostMvvmDiscoveryStages>
  </PropertyGroup>

  <Target Name="RunicPostMvvmDiscoveryValidateOutputKey">
    <Error Condition="'$(RunicPostMvvmDiscoveryOutputKey)' == '' or $([System.Text.RegularExpressions.Regex]::IsMatch('$(RunicPostMvvmDiscoveryOutputKey)', '[^A-Za-z0-9_-]'))"
           Code="RUNICPM008"
           Text="RunicPostMvvmDiscoveryOutputKey must be a nonempty single segment containing only ASCII letters, digits, hyphen, or underscore." />
  </Target>

  <Target Name="RunicPostMvvmDiscoveryValidateBuildOwner">
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(RunicPostMvvmDiscoveryBuildOwner)', '^[a-f0-9]{32}$'))"
           Code="RUNICPM009"
           Text="The internal post-MVVM discovery fixture requires RunicPostMvvmDiscoveryBuildOwner: a 32-character lowercase hexadecimal build-owner token supplied by its top-level wrapper." />
  </Target>

  <Target Name="RunicPostMvvmDiscoveryPrepare" BeforeTargets="RunicPostMvvmDiscoveryGenerate"
          DependsOnTargets="RunicPostMvvmDiscoveryValidateOutputKey;RunicPostMvvmDiscoveryValidateBuildOwner"
          Condition="'$(_RunicPostMvvmDiscovery)' == 'true' and '$(RunicPostMvvmDiscoveryBootstrap)' != 'true' and '$(RunicPostMvvmDiscoveryGenerate)' != 'false'">
    <RemoveDir Directories="$(_RunicPostMvvmDiscoveryGeneratedDir)" />
    <MakeDir Directories="$(_RunicPostMvvmDiscoveryGeneratedDir)" />
    <WriteLinesToFile File="$(_RunicPostMvvmDiscoveryStages)" Lines="" Overwrite="true" />
  </Target>

  <Target Name="RunicPostMvvmDiscoveryBootstrapMarker" BeforeTargets="CoreCompile"
          Condition="'$(RunicPostMvvmDiscoveryBootstrap)' == 'true'">
    <MakeDir Directories="$(_RunicPostMvvmDiscoveryGeneratedDir)" />
    <WriteLinesToFile File="$(_RunicPostMvvmDiscoveryStages)" Lines="bootstrap" Overwrite="false" />
  </Target>

  <Target Name="RunicPostMvvmDiscoveryClean" AfterTargets="CoreClean"
          DependsOnTargets="RunicPostMvvmDiscoveryValidateOutputKey;RunicPostMvvmDiscoveryValidateBuildOwner"
          Condition="'$(_RunicPostMvvmDiscovery)' == 'true' and '$(RunicPostMvvmDiscoveryBootstrap)' != 'true'">
    <RemoveDir Directories="$(_RunicPostMvvmDiscoveryOwnerRoot)" />
  </Target>

  <Target Name="RunicPostMvvmDiscoveryGenerate" BeforeTargets="CoreCompile"
          DependsOnTargets="RunicPostMvvmDiscoveryPrepare"
          Condition="'$(_RunicPostMvvmDiscovery)' == 'true' and '$(RunicPostMvvmDiscoveryBootstrap)' != 'true' and '$(RunicPostMvvmDiscoveryGenerate)' != 'false'">
    <!-- A parent NativeAOT publish is a global MSBuild property. Remove it
         explicitly for these build-time tools: they execute under `dotnet`,
         and trimming them both breaks reflection-based inspection and says
         nothing about the application being published. -->
    <MSBuild Projects="$(_RunicPostMvvmDiscoveryInspectorProject)" Targets="Restore;Build"
             Properties="RunicPostMvvmDiscoveryBuildOwner=$(RunicPostMvvmDiscoveryBuildOwner);RunicPostMvvmDiscoveryOwnerDriver=true;RunicPostMvvmDiscoveryOutputKey=$(RunicPostMvvmDiscoveryOutputKey);RunicPostMvvmDiscoveryBuildRole=inspector;Configuration=$(Configuration);TargetFramework=net10.0;RuntimeIdentifier=;PublishAot=false;PublishTrimmed=false;EnableTrimAnalyzer=false;EnableAotAnalyzer=false;SelfContained=false"
             RemoveProperties="PublishAot;PublishTrimmed;EnableTrimAnalyzer;EnableAotAnalyzer;RuntimeIdentifier;SelfContained;OutputPath;IntermediateOutputPath;BaseOutputPath;BaseIntermediateOutputPath;MSBuildProjectExtensionsPath;ProjectAssetsFile" />
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="Restore;Build"
             Properties="RunicPostMvvmDiscoveryBuildOwner=$(RunicPostMvvmDiscoveryBuildOwner);RunicPostMvvmDiscoveryOwnerDriver=true;RunicPostMvvmDiscoveryOutputKey=$(RunicPostMvvmDiscoveryOutputKey);RunicPostMvvmDiscoveryBuildRole=bootstrap;RunicPostMvvmDiscoveryBootstrap=true;RunicPostMvvmDiscoveryGenerate=false;_RunicPostMvvmDiscovery=false;Configuration=$(Configuration);TargetFramework=$(TargetFramework);RuntimeIdentifier=;PublishAot=false;PublishTrimmed=false;EnableTrimAnalyzer=false;EnableAotAnalyzer=false;SelfContained=false;CopyLocalLockFileAssemblies=true"
             RemoveProperties="PublishAot;PublishTrimmed;EnableTrimAnalyzer;EnableAotAnalyzer;RuntimeIdentifier;SelfContained;OutputPath;IntermediateOutputPath;BaseOutputPath;BaseIntermediateOutputPath;MSBuildProjectExtensionsPath;ProjectAssetsFile" />
    <Error Condition="!Exists('$(_RunicPostMvvmDiscoveryBootstrapAssembly)')"
           Text="The post-MVVM discovery bootstrap assembly was not produced at $(_RunicPostMvvmDiscoveryBootstrapAssembly)." />
    <Exec Command="dotnet &quot;$(_RunicPostMvvmDiscoveryInspectorDll)&quot; __post-mvvm-discover --assembly &quot;$(_RunicPostMvvmDiscoveryBootstrapAssembly)&quot; --ir &quot;$(_RunicPostMvvmDiscoveryIr)&quot; --esm &quot;$(_RunicPostMvvmDiscoveryEsm)&quot; --adapter &quot;$(_RunicPostMvvmDiscoveryAdapter)&quot; --ready &quot;$(_RunicPostMvvmDiscoveryReady)&quot;" />
    <ItemGroup><Compile Include="$(_RunicPostMvvmDiscoveryAdapter)" /></ItemGroup>
    <WriteLinesToFile File="$(_RunicPostMvvmDiscoveryStages)" Lines="outer" Overwrite="false" />
    <Message Importance="high" Text="POST_MVVM_SDK_DISCOVERY_TARGET|configuration=$(Configuration)|bootstrap=1|outer=1" />
  </Target>
</Project>
