<Project>
  <PropertyGroup>
    <RunicBuildModeProperty>RunicAssetsBuildMode</RunicBuildModeProperty>
    <RunicBuildMode>$(RunicAssetsBuildMode)</RunicBuildMode>
    <RunicPolicyIcon>$(MSBuildThisFileDirectory)../branding/assets/icon.png</RunicPolicyIcon>
    <PackageTags Condition="'$(PackageTags)' == ''">runic-artifex;assets;dotnet;nativeaot</PackageTags>
  </PropertyGroup>
  <Import Project="common.props" />
  <PropertyGroup>
    <RunicAssetsBuildMode>$(RunicBuildMode)</RunicAssetsBuildMode>
    <RunicAssetsDefaultTargetFramework>$(RunicTargetFramework)</RunicAssetsDefaultTargetFramework>
  </PropertyGroup>
</Project>
