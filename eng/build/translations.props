<Project>
  <PropertyGroup>
    <RunicBuildModeProperty>RunicTranslationsBuildMode</RunicBuildModeProperty>
    <RunicBuildMode>$(RunicTranslationsBuildMode)</RunicBuildMode>
    <RunicPolicyIcon>$(MSBuildThisFileDirectory)../branding/translations/icon.png</RunicPolicyIcon>
    <PackageTags Condition="'$(PackageTags)' == ''">runic-artifex;i18n;localization;resources;dotnet;nativeaot</PackageTags>
  </PropertyGroup>
  <Import Project="common.props" />
  <PropertyGroup>
    <RunicTranslationsBuildMode>$(RunicBuildMode)</RunicTranslationsBuildMode>
    <RunicTranslationsCompatibilityTargetFramework>$(RunicTargetFramework)</RunicTranslationsCompatibilityTargetFramework>
    <RunicTranslationsGeneratorTargetFramework>$(RunicTargetFramework)</RunicTranslationsGeneratorTargetFramework>
  </PropertyGroup>
</Project>
