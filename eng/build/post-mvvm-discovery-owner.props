<Project>
  <!--
    This is an opt-in early props import for the internal post-MVVM fixture.
    Repository Directory.Build.props imports it when the private owner token is
    present, before each participating project selects its obj/bin paths. It
    is not imported by shipping SDK projects.
  -->
  <PropertyGroup>
    <RunicPostMvvmDiscoveryOutputKey Condition="'$(RunicPostMvvmDiscoveryOutputKey)' == ''">ordinary</RunicPostMvvmDiscoveryOutputKey>
    <!-- At this import point these values can only be command-line/global
         overrides. Remember them so the fixture can reject a path that would
         bypass its per-owner Base* policy. -->
    <_RunicPostMvvmDiscoveryInheritedOutputPath Condition="'$(OutputPath)' != ''">$(OutputPath)</_RunicPostMvvmDiscoveryInheritedOutputPath>
    <_RunicPostMvvmDiscoveryInheritedIntermediateOutputPath Condition="'$(IntermediateOutputPath)' != ''">$(IntermediateOutputPath)</_RunicPostMvvmDiscoveryInheritedIntermediateOutputPath>
    <_RunicPostMvvmDiscoveryInheritedBaseOutputPath Condition="'$(BaseOutputPath)' != ''">$(BaseOutputPath)</_RunicPostMvvmDiscoveryInheritedBaseOutputPath>
    <_RunicPostMvvmDiscoveryInheritedBaseIntermediateOutputPath Condition="'$(BaseIntermediateOutputPath)' != ''">$(BaseIntermediateOutputPath)</_RunicPostMvvmDiscoveryInheritedBaseIntermediateOutputPath>
    <_RunicPostMvvmDiscoveryInheritedProjectExtensionsPath Condition="'$(MSBuildProjectExtensionsPath)' != ''">$(MSBuildProjectExtensionsPath)</_RunicPostMvvmDiscoveryInheritedProjectExtensionsPath>
    <_RunicPostMvvmDiscoveryInheritedProjectAssetsFile Condition="'$(ProjectAssetsFile)' != ''">$(ProjectAssetsFile)</_RunicPostMvvmDiscoveryInheritedProjectAssetsFile>
    <_RunicPostMvvmDiscoveryInheritedOutDir Condition="'$(OutDir)' != ''">$(OutDir)</_RunicPostMvvmDiscoveryInheritedOutDir>
    <_RunicPostMvvmDiscoveryInheritedRestoreOutputPath Condition="'$(RestoreOutputPath)' != ''">$(RestoreOutputPath)</_RunicPostMvvmDiscoveryInheritedRestoreOutputPath>
    <_RunicPostMvvmDiscoveryOwnerIsValid Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(RunicPostMvvmDiscoveryBuildOwner)', '^[a-f0-9]{32}$'))">true</_RunicPostMvvmDiscoveryOwnerIsValid>
    <_RunicPostMvvmDiscoveryOutputKeyIsValid Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(RunicPostMvvmDiscoveryOutputKey)', '^[A-Za-z0-9_-]+$'))">true</_RunicPostMvvmDiscoveryOutputKeyIsValid>
    <!-- Never interpolate an unvalidated key into a filesystem path. The
         fixture-local target reports RUNICPM008 before Restore/Build/Clean. -->
    <!-- Keep this private fixture root short enough for conventional Windows
         path limits even after a dependency name, configuration, and generated
         compiler filename are appended. The repository obj folder is ignored. -->
    <_RunicPostMvvmDiscoveryOwnerRoot Condition="'$(_RunicPostMvvmDiscoveryOwnerIsValid)' == 'true' and '$(_RunicPostMvvmDiscoveryOutputKeyIsValid)' == 'true'">$(MSBuildThisFileDirectory)../../obj/pmd/$(RunicPostMvvmDiscoveryOutputKey)/$(RunicPostMvvmDiscoveryBuildOwner)/</_RunicPostMvvmDiscoveryOwnerRoot>

    <!-- The outer fixture, its bootstrap, and the inspector use intentional
         slots. Every referenced project receives a name-qualified slot, so a
         single build session has no shared compiler or restore directories. -->
    <_RunicPostMvvmDiscoveryProjectSlot Condition="'$(_RunicPostMvvmDiscoveryOwnerRoot)' != '' and '$(MSBuildProjectName)' == 'PostMvvmDiscovery' and '$(RunicPostMvvmDiscoveryBuildRole)' == 'bootstrap'">bootstrap</_RunicPostMvvmDiscoveryProjectSlot>
    <_RunicPostMvvmDiscoveryProjectSlot Condition="'$(_RunicPostMvvmDiscoveryOwnerRoot)' != '' and '$(MSBuildProjectName)' == 'PostMvvmDiscovery' and '$(RunicPostMvvmDiscoveryBuildRole)' == ''">outer</_RunicPostMvvmDiscoveryProjectSlot>
    <_RunicPostMvvmDiscoveryProjectSlot Condition="'$(_RunicPostMvvmDiscoveryOwnerRoot)' != '' and '$(MSBuildProjectName)' == 'Runic.Application.Bridge.Inspector'">inspector</_RunicPostMvvmDiscoveryProjectSlot>
    <_RunicPostMvvmDiscoveryProjectSlot Condition="'$(_RunicPostMvvmDiscoveryOwnerRoot)' != '' and '$(_RunicPostMvvmDiscoveryProjectSlot)' == ''">$(RunicPostMvvmDiscoveryBuildRole)-dependencies/$(MSBuildProjectName)</_RunicPostMvvmDiscoveryProjectSlot>
    <_RunicPostMvvmDiscoveryProjectSlot Condition="'$(_RunicPostMvvmDiscoveryOwnerRoot)' != '' and '$(_RunicPostMvvmDiscoveryProjectSlot)' == '-dependencies/$(MSBuildProjectName)'">dependencies/$(MSBuildProjectName)</_RunicPostMvvmDiscoveryProjectSlot>

    <BaseIntermediateOutputPath Condition="'$(_RunicPostMvvmDiscoveryOwnerRoot)' != ''">$(_RunicPostMvvmDiscoveryOwnerRoot)$(_RunicPostMvvmDiscoveryProjectSlot)/obj/</BaseIntermediateOutputPath>
    <BaseOutputPath Condition="'$(_RunicPostMvvmDiscoveryOwnerRoot)' != ''">$(_RunicPostMvvmDiscoveryOwnerRoot)$(_RunicPostMvvmDiscoveryProjectSlot)/bin/</BaseOutputPath>
    <!-- The SDK normally excludes obj/bin via BaseIntermediateOutputPath and
         BaseOutputPath. Redirecting those bases outside a referenced project's
         folder must not make its conventional, pre-existing obj/bin eligible
         for the default Compile glob (notably generated assembly attributes). -->
    <DefaultItemExcludes Condition="'$(_RunicPostMvvmDiscoveryOwnerRoot)' != ''">$(DefaultItemExcludes);obj/**;bin/**</DefaultItemExcludes>
  </PropertyGroup>
</Project>
