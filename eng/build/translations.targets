<Project>
  <PropertyGroup Condition="'$(RunicTranslationsShippingProject)' == 'true'">
    <EnableTrimAnalyzer Condition="'$(EnableTrimAnalyzer)' == '' and ('$(RunicTranslationsVerificationBuild)' == 'true' or '$(PublishTrimmed)' == 'true' or '$(PublishAot)' == 'true')">true</EnableTrimAnalyzer>
    <EnableTrimAnalyzer Condition="'$(EnableTrimAnalyzer)' == ''">false</EnableTrimAnalyzer>
    <EnableAotAnalyzer Condition="'$(EnableAotAnalyzer)' == '' and ('$(RunicTranslationsVerificationBuild)' == 'true' or '$(PublishAot)' == 'true')">true</EnableAotAnalyzer>
    <EnableAotAnalyzer Condition="'$(EnableAotAnalyzer)' == ''">false</EnableAotAnalyzer>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <Target Name="ValidateRunicTranslationsBuildMode" BeforeTargets="PrepareForBuild">
    <Error
      Condition="'$(RunicTranslationsBuildMode)' != 'Development' and '$(RunicTranslationsBuildMode)' != 'Verification'"
      Text="RunicTranslationsBuildMode must be either Development or Verification." />
  </Target>
</Project>
