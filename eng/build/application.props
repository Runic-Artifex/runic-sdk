<Project>
  <PropertyGroup>
    <RunicBuildModeProperty>RunicApplicationBuildMode</RunicBuildModeProperty>
    <RunicBuildMode>$(RunicApplicationBuildMode)</RunicBuildMode>
    <RunicPolicyIcon>$(MSBuildThisFileDirectory)../branding/application/icon.png</RunicPolicyIcon>
    <PackageTags Condition="'$(PackageTags)' == ''">runic-artifex;application;webui;desktop;dotnet;nativeaot</PackageTags>
  </PropertyGroup>
  <Import Project="common.props" />
  <PropertyGroup>
    <RunicApplicationBuildMode>$(RunicBuildMode)</RunicApplicationBuildMode>
    <RunicApplicationDefaultTargetFramework>$(RunicTargetFramework)</RunicApplicationDefaultTargetFramework>
  </PropertyGroup>
</Project>
