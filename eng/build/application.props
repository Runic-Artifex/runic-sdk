<Project>
  <PropertyGroup>
    <RunicBuildModeProperty>RunicToolkitBuildMode</RunicBuildModeProperty>
    <RunicBuildMode>$(RunicToolkitBuildMode)</RunicBuildMode>
    <RunicPolicyIcon>$(MSBuildThisFileDirectory)../branding/application/icon.png</RunicPolicyIcon>
    <PackageTags Condition="'$(PackageTags)' == ''">runic-artifex;toolkit;webui;desktop;dotnet;nativeaot</PackageTags>
  </PropertyGroup>
  <Import Project="common.props" />
  <PropertyGroup>
    <RunicToolkitBuildMode>$(RunicBuildMode)</RunicToolkitBuildMode>
    <RunicToolkitDefaultTargetFramework>$(RunicTargetFramework)</RunicToolkitDefaultTargetFramework>
  </PropertyGroup>
</Project>
