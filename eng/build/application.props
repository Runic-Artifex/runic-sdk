<Project>
  <PropertyGroup>
    <!--
      Development is the approachable inner loop. Verification is selected by CI
      and eng/verify.ps1 for release-grade analysis.
    -->
    <RunicToolkitBuildMode Condition="'$(RunicToolkitBuildMode)' == '' and '$(CI)' == 'true'">Verification</RunicToolkitBuildMode>
    <RunicToolkitBuildMode Condition="'$(RunicToolkitBuildMode)' == ''">Development</RunicToolkitBuildMode>
    <RunicToolkitVerificationBuild Condition="'$(RunicToolkitBuildMode)' == 'Verification'">true</RunicToolkitVerificationBuild>
    <RunicToolkitVerificationBuild Condition="'$(RunicToolkitVerificationBuild)' == ''">false</RunicToolkitVerificationBuild>

    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors Condition="'$(RunicToolkitVerificationBuild)' == 'true'">true</TreatWarningsAsErrors>
    <TreatWarningsAsErrors Condition="'$(TreatWarningsAsErrors)' == ''">false</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <DebugType>embedded</DebugType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RepositoryType>git</RepositoryType>
    <Authors>RunicArtifex</Authors>
    <Company>RunicArtifex</Company>
    <Copyright>Copyright (c) 2026 Viktor Jannicke</Copyright>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PackageIcon>icon.png</PackageIcon>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags Condition="'$(PackageTags)' == ''">runic-artifex;toolkit;webui;desktop;dotnet;nativeaot</PackageTags>
    <!-- Libraries leave dependency resolution to their consuming applications. -->
    <NuGetAudit Condition="'$(RunicToolkitVerificationBuild)' == 'true'">true</NuGetAudit>
    <NuGetAudit Condition="'$(NuGetAudit)' == ''">false</NuGetAudit>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <VersionPrefix Condition="'$(VersionPrefix)' == ''">0.1.0</VersionPrefix>
    <RunicAssetsPackageVersion>$(RunicSdkVersion)</RunicAssetsPackageVersion>
    <RunicDesktopPackageVersion>$(RunicSdkVersion)</RunicDesktopPackageVersion>
    <RunicTranslationsPackageVersion>$(RunicSdkVersion)</RunicTranslationsPackageVersion>
    <RunicCommandLinePackageVersion>$(RunicSdkVersion)</RunicCommandLinePackageVersion>
    <RunicToolkitDefaultTargetFramework>net10.0</RunicToolkitDefaultTargetFramework>
    <RunicToolkitCompatibilityTargetFramework>net10.0</RunicToolkitCompatibilityTargetFramework>
    <RunicToolkitGeneratorTargetFramework>net10.0</RunicToolkitGeneratorTargetFramework>
    <!-- Package consumer verification supplies an isolated artifact feed. -->
    <RestoreAdditionalProjectSources Condition="'$(RunicVerificationFeed)' != ''">$(RunicVerificationFeed)</RestoreAdditionalProjectSources>
    <IsPackable Condition="'$(MSBuildProjectName)' == 'Runic.Application.Bridge.Generators'">false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../../packages/runic-toolkit/.github/assets/brand/icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
</Project>
