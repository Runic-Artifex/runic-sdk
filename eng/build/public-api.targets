<Project>
  <!--
    Shipping libraries track their public API with PublicApiAnalyzers and validate each
    package against the last published release. RunicIsShippingProject comes from the
    generated shipping-projects.props. Tools and template packages expose no
    referenceable assemblies, so they are not tracked.
  -->
  <PropertyGroup Condition="'$(RunicIsShippingProject)' == 'true' and '$(OutputType)' != 'Exe' and '$(IncludeBuildOutput)' != 'false'">
    <RunicTrackPublicApi>true</RunicTrackPublicApi>
    <EnablePackageValidation>true</EnablePackageValidation>
    <!-- A package that was never published has no baseline; it sets RunicPackageValidationBaselineMissing until its first release. -->
    <PackageValidationBaselineVersion Condition="'$(PackageValidationBaselineVersion)' == '' and '$(RunicPackageValidationBaselineMissing)' != 'true'">$(RunicPackageValidationBaselineVersion)</PackageValidationBaselineVersion>
  </PropertyGroup>

  <ItemGroup Condition="'$(RunicTrackPublicApi)' == 'true'">
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt;PublicAPI.Unshipped.txt" Pack="false" />
  </ItemGroup>
</Project>
