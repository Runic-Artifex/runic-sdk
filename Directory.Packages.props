<Project>
  <Import Project="eng/Versions.props" Condition="'$(RunicSdkVersion)' == ''" />
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <CentralPackageVersionOverrideEnabled>false</CentralPackageVersionOverrideEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Microsoft.Windows.CsWin32" Version="0.3.333" />
    <PackageVersion Include="System.DirectoryServices.Protocols" Version="10.0.12" />
    <PackageVersion Include="System.Reflection.MetadataLoadContext" Version="10.0.12" />
    <PackageVersion Include="Tmds.DBus.Protocol" Version="0.95.1" />
    <PackageVersion Include="Tmds.DBus.Generator" Version="0.95.1" />
    <PackageVersion Include="GirCore.Gtk-4.0" Version="0.8.1" />
    <PackageVersion Include="GirCore.WebKit-6.0" Version="0.8.1" />
    <PackageVersion Include="Spectre.Console" Version="0.57.2" />
    <PackageVersion Include="CsWebUi" Version="2.5.0-beta.4.5" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="Microsoft.Build.Framework" Version="18.9.6" />
    <PackageVersion Include="Microsoft.Build.Locator" Version="1.11.2" />
    <PackageVersion Include="Microsoft.NET.StringTools" Version="18.9.6" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Features" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.9.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.400" />
    <PackageVersion Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <PackageVersion Include="ReactiveUI" Version="25.1.1" />
    <PackageVersion Include="ReactiveUI.Reactive" Version="25.1.1" />
    <!-- Include the Binding patch released after ReactiveUI 25.1.1's 8.8.0 dependency. -->
    <PackageVersion Include="ReactiveUI.Binding" Version="8.8.1" />
    <PackageVersion Include="ReactiveUI.Binding.Reactive" Version="8.8.1" />
    <PackageVersion Include="ReactiveUI.SourceGenerators" Version="4.2.0" />
    <PackageVersion Include="Splat" Version="21.0.0" />
    <!-- Used only by compiler contract tests to validate emitted instances against draft 2020-12 schemas. -->
    <PackageVersion Include="JsonSchema.Net" Version="9.4.0" />
    <PackageVersion Include="Runic.Platform" Version="$(RunicSdkVersion)" />
    <PackageVersion Include="Runic.Platform.Runtime" Version="$(RunicSdkVersion)" />
    <PackageVersion Include="Runic.Platform.Administration.Windows" Version="$(RunicSdkVersion)" />
    <PackageVersion Include="Runic.Platform.Windows" Version="$(RunicSdkVersion)" />
    <PackageVersion Include="Runic.Platform.Linux" Version="$(RunicSdkVersion)" />
    <PackageVersion Include="Runic.Platform.MacOS" Version="$(RunicSdkVersion)" />
    <PackageVersion Include="Runic.Application" Version="$(RunicSdkVersion)" />
    <PackageVersion Include="Runic.Application.ReactiveUI" Version="$(RunicSdkVersion)" />
    <PackageVersion Include="Runic.Application.ReactiveUI.Reactive" Version="$(RunicSdkVersion)" />
    <PackageVersion Include="Runic.Application.CsWebUi" Version="$(RunicSdkVersion)" />
    <PackageVersion Include="Runic.Application.Desktop" Version="$(RunicSdkVersion)" />
    <PackageVersion Include="Runic.Assets" Version="$(RunicSdkVersion)" />
    <PackageVersion Include="Runic.Assets.AspNetCore" Version="$(RunicSdkVersion)" />
    <PackageVersion Include="Runic.Assets.Desktop" Version="$(RunicSdkVersion)" />
    <PackageVersion Include="Runic.CommandLine" Version="$(RunicSdkVersion)" />
    <PackageVersion Include="Runic.Desktop.Gtk4" Version="$(RunicSdkVersion)" />
    <PackageVersion Include="Runic.Platform.Linux.Gtk4" Version="$(RunicSdkVersion)" />
    <PackageVersion Include="Runic.Platform.Linux.Portal" Version="$(RunicSdkVersion)" />
    <PackageVersion Include="Runic.Desktop" Version="$(RunicSdkVersion)" />
    <PackageVersion Include="Runic.Translations" Version="$(RunicSdkVersion)" />
    <PackageVersion Include="Runic.Translations.Build" Version="$(RunicSdkVersion)" />
    <PackageVersion Include="Runic.Translations.Tooling" Version="$(RunicSdkVersion)" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>
</Project>
