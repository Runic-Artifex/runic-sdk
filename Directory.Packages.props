<Project>
  <Import Project="eng/Versions.props" Condition="'$(RunicSdkVersion)' == ''" />
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <CentralPackageVersionOverrideEnabled>false</CentralPackageVersionOverrideEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Microsoft.Windows.CsWin32" Version="0.3.346" />
    <PackageVersion Include="System.DirectoryServices.Protocols" Version="10.0.12" />
    <PackageVersion Include="Tmds.DBus.Protocol" Version="0.95.1" />
    <PackageVersion Include="Tmds.DBus.Generator" Version="0.95.1" />
    <PackageVersion Include="GirCore.Gtk-4.0" Version="0.8.1" />
    <PackageVersion Include="GirCore.WebKit-6.0" Version="0.8.1" />
    <PackageVersion Include="Spectre.Console" Version="0.57.2" />
    <!-- Exposed third-party packages are bounded to the tested major (eng/release/README.md,
         "Third-party dependencies"). -->
    <PackageVersion Include="CsWebUi" Version="[2.5.0-beta.4.7, 3)" />
    <PackageVersion Include="CsWebUi.Native" Version="[2.5.0-beta.4.7, 3)" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="Microsoft.Build.Framework" Version="18.9.6" />
    <PackageVersion Include="Microsoft.NET.StringTools" Version="18.9.6" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="[10.10.0, 11)" />
    <PackageVersion Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <!-- The ReactiveUI adapters reference every package whose types their API exposes, bounded to
         the tested major (eng/release/README.md, "Third-party dependencies"). -->
    <PackageVersion Include="ReactiveUI" Version="[26.0.1, 27)" />
    <PackageVersion Include="ReactiveUI.Core" Version="[26.0.1, 27)" />
    <PackageVersion Include="ReactiveUI.Reactive" Version="[26.0.1, 27)" />
    <!-- The WPF platform package: the ReactiveUI variant of examples/wpf-navigation, and the dispatcher case of
         Runic.Application.Views.Wpf.Windows.Tests. -->
    <PackageVersion Include="ReactiveUI.WPF" Version="26.0.1" />
    <!-- Binding matches the 9.1.0 dependency of ReactiveUI 26.0.1. -->
    <PackageVersion Include="ReactiveUI.Binding" Version="[9.1.0, 10)" />
    <PackageVersion Include="ReactiveUI.Binding.Reactive" Version="[9.1.0, 10)" />
    <!-- Primitives and Disposables match the 9.0.0 dependencies of ReactiveUI 26.0.1. -->
    <PackageVersion Include="ReactiveUI.Disposables" Version="[9.0.0, 10)" />
    <PackageVersion Include="ReactiveUI.Primitives" Version="[9.0.0, 10)" />
    <PackageVersion Include="ReactiveUI.Primitives.Reactive" Version="[9.0.0, 10)" />
    <PackageVersion Include="System.Reactive" Version="[7.0.0, 8)" />
    <!-- Test-only: the Bridge's ValidationContext reader (#478) against both flavors of the RunicArtifex
         ReactiveUI.Validation fork. No shipped package references them. -->
    <PackageVersion Include="RunicArtifex.ReactiveUI.Validation" Version="9.0.0-runic.9" />
    <PackageVersion Include="RunicArtifex.ReactiveUI.Validation.Reactive" Version="9.0.0-runic.9" />
    <PackageVersion Include="ReactiveUI.SourceGenerators" Version="4.2.0" />
    <PackageVersion Include="Splat" Version="21.0.0" />
    <!-- Used only by compiler contract tests to validate emitted instances against draft 2020-12 schemas. -->
    <PackageVersion Include="JsonSchema.Net" Version="9.4.0" />
    <!-- Used only by tests/dotnet/Runic.Application.Logging.Tests, an application that logs through Serilog.
         No shipped package depends on Serilog. -->
    <PackageVersion Include="Serilog" Version="4.4.0" />
    <PackageVersion Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <!-- Used only by tests/benchmarks, which CI builds but never runs. -->
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="Runic.Platform" Version="$(RunicSdkVersion)" />
    <PackageVersion Include="Runic.Platform.Runtime" Version="$(RunicSdkVersion)" />
    <PackageVersion Include="Runic.Platform.Administration.Windows" Version="$(RunicSdkVersion)" />
    <PackageVersion Include="Runic.Platform.Windows" Version="$(RunicSdkVersion)" />
    <PackageVersion Include="Runic.Platform.Linux" Version="$(RunicSdkVersion)" />
    <PackageVersion Include="Runic.Platform.MacOS" Version="$(RunicSdkVersion)" />
    <PackageVersion Include="Runic.Application.Views" Version="$(RunicSdkVersion)" />
    <PackageVersion Include="Runic.Application.Views.ReactiveUI" Version="$(RunicSdkVersion)" />
    <PackageVersion Include="Runic.Application.Views.ReactiveUI.Reactive" Version="$(RunicSdkVersion)" />
    <PackageVersion Include="Runic.Application.Views.CsWebUi" Version="$(RunicCsWebUiPackageVersion)" />
    <PackageVersion Include="Runic.Application.Views.Desktop" Version="$(RunicSdkVersion)" />
    <PackageVersion Include="Runic.Assets" Version="$(RunicSdkVersion)" />
    <PackageVersion Include="Runic.Assets.AspNetCore" Version="$(RunicSdkVersion)" />
    <PackageVersion Include="Runic.Assets.Desktop" Version="$(RunicSdkVersion)" />
    <!-- Command Line is released independently from this SDK. -->
    <PackageVersion Include="Runic.CommandLine" Version="0.8.0" />
    <PackageVersion Include="Runic.CommandLine.Spectre" Version="0.8.0" />
    <PackageVersion Include="Runic.Desktop.Gtk4" Version="$(RunicSdkVersion)" />
    <PackageVersion Include="Runic.Platform.Linux.Gtk4" Version="$(RunicSdkVersion)" />
    <PackageVersion Include="Runic.Platform.Linux.Portal" Version="$(RunicSdkVersion)" />
    <PackageVersion Include="Runic.Platform.Linux.Polkit" Version="$(RunicSdkVersion)" />
    <PackageVersion Include="Runic.Platform.Linux.DBus" Version="$(RunicSdkVersion)" />
    <PackageVersion Include="Runic.Platform.Windows.Elevation" Version="$(RunicSdkVersion)" />
    <PackageVersion Include="Runic.Desktop" Version="$(RunicSdkVersion)" />
    <!-- The runic-app template test project pins the same TUnit version. The
         TUnit suites (see CONTRIBUTING.md) keep TUnit.Core and TUnit.Engine on it too. -->
    <PackageVersion Include="TUnit" Version="1.73.19" />
    <PackageVersion Include="TUnit.Core" Version="1.73.19" />
    <PackageVersion Include="TUnit.Engine" Version="1.73.19" />
    <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="2.5.1" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <!-- Runic.Desktop.Tests runs on TUnit and keeps xUnit's assertion library for its cases. -->
    <PackageVersion Include="xunit.assert" Version="2.9.3" />
  </ItemGroup>
</Project>
