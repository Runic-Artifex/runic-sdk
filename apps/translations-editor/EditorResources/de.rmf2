      .input {$languages :integer select=plural}
      .input {$files :integer select=plural}
      .match $languages $files
      one one {{Eine Sprache · eine Datei · vom Compiler geprüft}}
      one * {{Eine Sprache · {$files} Dateien · vom Compiler geprüft}}
      * one {{{$languages} Sprachen · eine Datei · vom Compiler geprüft}}
      * * {{{$languages} Sprachen · {$files} Dateien · vom Compiler geprüft}}

  }
}
ui {
  count {
    quality_summary =
      .input {$findings :integer select=plural}
      .input {$messages :integer select=plural}
      .match $findings $messages
      one one {{Ein Befund in einer Nachricht. Die CSV-Spalten folgen der Berichtsreihenfolge.}}
      one * {{Ein Befund in {$messages} Nachrichten. Die CSV-Spalten folgen der Berichtsreihenfolge.}}
      * one {{{$findings} Befunde in einer Nachricht. Die CSV-Spalten folgen der Berichtsreihenfolge.}}
      * * {{{$findings} Befunde in {$messages} Nachrichten. Die CSV-Spalten folgen der Berichtsreihenfolge.}}

  }
}
