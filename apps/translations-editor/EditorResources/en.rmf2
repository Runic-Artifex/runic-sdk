ui {
  count {
    project_summary =
      .input {$languages :integer select=plural}
      .input {$files :integer select=plural}
      .match $languages $files
      one one {{One language · one file · compiler validated}}
      one * {{One language · {$files} files · compiler validated}}
      * one {{{$languages} languages · one file · compiler validated}}
      * * {{{$languages} languages · {$files} files · compiler validated}}

  }
}
ui {
  count {
    quality_summary =
      .input {$findings :integer select=plural}
      .input {$messages :integer select=plural}
      .match $findings $messages
      one one {{One finding across one message. CSV columns follow the report order.}}
      one * {{One finding across {$messages} messages. CSV columns follow the report order.}}
      * one {{{$findings} findings across one message. CSV columns follow the report order.}}
      * * {{{$findings} findings across {$messages} messages. CSV columns follow the report order.}}

  }
}
ui {
  count {
    recovered_drafts =
      .input {$count :integer select=plural}
      .match $count
      one {{One document draft was found in local application storage.}}
      * {{{$count} document drafts were found in local application storage.}}

  }
}
ui {
  count {
    recovery_journal =
      .input {$count :integer select=plural}
      .input {$catalog :string}
      .match $count
      one {{The journal for {$catalog} lists one file. No further editing is allowed until it is resolved.}}
      * {{The journal for {$catalog} lists {$count} files. No further editing is allowed until it is resolved.}}

  }
}
ui {
  count {
    resource_variants =
      .input {$count :integer select=plural}
