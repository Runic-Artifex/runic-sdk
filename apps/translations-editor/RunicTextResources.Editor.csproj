<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>RunicTextResources.Editor</AssemblyName>
    <RootNamespace>RunicTextResources.Editor</RootNamespace>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <ImplicitUsings>enable</ImplicitUsings>
    <TextResourcesEmitEsm>true</TextResourcesEmitEsm>
    <TextResourcesToolCommand>dotnet tool run runic-textresources --</TextResourcesToolCommand>
    <TextResourcesRuntimePath Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)/</TextResourcesRuntimePath>
    <TextResourcesOutputPath>$(BaseIntermediateOutputPath)$(Configuration)/$(TargetFramework)/$(TextResourcesRuntimePath)text-resources</TextResourcesOutputPath>
    <RunicEditorUpdateChannel Condition="'$(RunicEditorUpdateChannel)' == ''">preview</RunicEditorUpdateChannel>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="RunicUpdateChannel" Value="$(RunicEditorUpdateChannel)" />
    <AssemblyMetadata Include="RepositoryCommit" Value="$(SourceRevisionId)" Condition="'$(SourceRevisionId)' != ''" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CsWebUi" />
    <PackageReference Include="RunicTextResources.Authoring" />
    <PackageReference Include="RunicTextResources.Build" PrivateAssets="all" />
    <PackageReference Include="RunicTextResources.Compiler" />
  </ItemGroup>

  <ItemGroup>
    <TextResourceCatalog Include="EditorResources/editor.catalog.json" />
    <TextResourceDocument Include="EditorResources/editor.en.json" />
    <TextResourceDocument Include="EditorResources/editor.de.json" />
    <EditorFrontendInput Include="Frontend/package.json;Frontend/package-lock.json;Frontend/svelte.config.js;Frontend/tsconfig.json;Frontend/vite.config.ts;Frontend/src/**/*;EditorResources/*.json" />
    <None Update="ExampleWorkspace/**/*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Include="LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="BuildTextResourcesEditorFrontend"
          BeforeTargets="BeforeCompile"
          DependsOnTargets="RunicTextResourcesGenerateTextResourceArtifacts"
          Inputs="@(EditorFrontendInput);$(TextResourcesOutputPath)/editor.esm/web-module-manifest-v1.json"
          Outputs="Frontend/build/index.html">
    <Exec WorkingDirectory="Frontend"
          Command="npm ci --ignore-scripts --no-audit --no-fund" />
    <Exec WorkingDirectory="Frontend"
          Command="npm run build"
          EnvironmentVariables="RUNIC_TEXT_MANIFEST=$(MSBuildProjectDirectory)/$(TextResourcesOutputPath)/editor.esm/web-module-manifest-v1.json" />
  </Target>

  <Target Name="CopyTextResourcesEditorFrontend"
          AfterTargets="Build"
          DependsOnTargets="BuildTextResourcesEditorFrontend">
    <ItemGroup>
      <_EditorFrontendOutput Include="Frontend/build/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(_EditorFrontendOutput)"
          DestinationFiles="@(_EditorFrontendOutput->'$(OutputPath)www/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="IncludeTextResourcesEditorFrontendInPublish"
          BeforeTargets="ComputeFilesToPublish"
          DependsOnTargets="BuildTextResourcesEditorFrontend">
    <ItemGroup>
      <_EditorFrontendPublish Include="Frontend/build/**/*" />
      <ResolvedFileToPublish Include="@(_EditorFrontendPublish)"
                             RelativePath="www/%(RecursiveDir)%(Filename)%(Extension)"
                             CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
