<Project>
  <Import Project="../../Directory.Packages.props" />
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <CentralPackageVersionOverrideEnabled>false</CentralPackageVersionOverrideEnabled>
    <RunicApplicationPackageVersion Condition="'$(RunicApplicationPackageVersion)' == ''">0.5.0-preview.2</RunicApplicationPackageVersion>
    <RunicCommandLinePackageVersion Condition="'$(RunicCommandLinePackageVersion)' == ''">0.5.0-preview.2</RunicCommandLinePackageVersion>
    <RunicTranslationsPackageVersion Condition="'$(RunicTranslationsPackageVersion)' == ''">0.5.0-preview.2</RunicTranslationsPackageVersion>
    <RunicAssetsPackageVersion Condition="'$(RunicAssetsPackageVersion)' == ''">0.5.0-preview.2</RunicAssetsPackageVersion>
  </PropertyGroup>
  <ItemGroup>
  </ItemGroup>
</Project>
