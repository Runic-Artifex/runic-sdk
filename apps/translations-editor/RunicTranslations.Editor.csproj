<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>RunicTranslations.Editor</AssemblyName>
    <RootNamespace>RunicTranslations.Editor</RootNamespace>
    <Product>Runic Translations Editor</Product>
    <Title>Runic Translations Editor</Title>
    <Description>A focused desktop editor for Runic Translations workspaces.</Description>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <ImplicitUsings>enable</ImplicitUsings>
    <TranslationsEmitEsm>true</TranslationsEmitEsm>
    <TranslationsToolCommand>dotnet tool run runic-translations --</TranslationsToolCommand>
    <TranslationsRuntimePath Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)/</TranslationsRuntimePath>
    <TranslationsOutputPath>$(BaseIntermediateOutputPath)$(Configuration)/$(TargetFramework)/$(TranslationsRuntimePath)translations</TranslationsOutputPath>
    <RunicEditorUpdateChannel Condition="'$(RunicEditorUpdateChannel)' == ''">preview</RunicEditorUpdateChannel>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="RunicUpdateChannel" Value="$(RunicEditorUpdateChannel)" />
    <AssemblyMetadata Include="RepositoryCommit" Value="$(SourceRevisionId)" Condition="'$(SourceRevisionId)' != ''" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CsWebUi" />
    <PackageReference Include="RunicTranslations.Authoring" />
    <PackageReference Include="RunicTranslations.Build" PrivateAssets="all" />
    <PackageReference Include="RunicTranslations.Compiler" />
  </ItemGroup>

  <ItemGroup>
    <TranslationCatalog Include="EditorResources/editor.catalog.json" />
    <TranslationDocument Include="EditorResources/editor.en.json" />
    <TranslationDocument Include="EditorResources/editor.de.json" />
    <EditorFrontendInput Include="Frontend/package.json;Frontend/package-lock.json;Frontend/svelte.config.js;Frontend/tsconfig.json;Frontend/vite.config.ts;Frontend/src/**/*;EditorResources/*.json" />
    <None Update="ExampleWorkspace/**/*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Include="LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="BuildTranslationsEditorFrontend"
          BeforeTargets="BeforeCompile"
          DependsOnTargets="RunicTranslationsGenerateTranslationArtifacts"
          Inputs="@(EditorFrontendInput);$(TranslationsOutputPath)/editor.esm/web-module-manifest-v1.json"
          Outputs="Frontend/build/index.html">
    <Exec WorkingDirectory="Frontend"
          Command="npm ci --ignore-scripts --no-audit --no-fund" />
    <Exec WorkingDirectory="Frontend"
          Command="npm run build"
          EnvironmentVariables="RUNIC_TRANSLATIONS_MANIFEST=$(MSBuildProjectDirectory)/$(TranslationsOutputPath)/editor.esm/web-module-manifest-v1.json" />
  </Target>

  <Target Name="CopyTranslationsEditorFrontend"
          AfterTargets="Build"
          DependsOnTargets="BuildTranslationsEditorFrontend">
    <ItemGroup>
      <_EditorFrontendOutput Include="Frontend/build/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(_EditorFrontendOutput)"
          DestinationFiles="@(_EditorFrontendOutput->'$(OutputPath)www/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="IncludeTranslationsEditorFrontendInPublish"
          BeforeTargets="ComputeFilesToPublish"
          DependsOnTargets="BuildTranslationsEditorFrontend">
    <ItemGroup>
      <_EditorFrontendPublish Include="Frontend/build/**/*" />
      <ResolvedFileToPublish Include="@(_EditorFrontendPublish)"
                             RelativePath="www/%(RecursiveDir)%(Filename)%(Extension)"
                             CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
