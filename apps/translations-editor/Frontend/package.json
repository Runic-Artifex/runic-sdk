    "@runic-artifex/vite-plugin-runic-translations": "1.0.0-preview.1",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.70.2",
    "@sveltejs/vite-plugin-svelte": "7.2.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "24.10.4",
    "bits-ui": "^2.18.1",
    "clsx": "^2.1.1",
    "shadcn-svelte": "^1.5.0",
    "svelte-check": "4.7.5",
