{
  "name": "@runic-artifex/translations-editor-frontend",
  "private": true,
  "version": "1.0.0-preview.1",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": ">=24.18.0"
  },
  "scripts": {
    "build": "vite build",
    "contract:generate": "runic-bridge generate",
    "contract:check": "runic-bridge check",
    "dev": "vite dev",
    "dev:mock": "vite dev --mode mock",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "verify:checks": "bun run check && node test/verify-appearance.mjs && node test/verify-message-preview.mjs && node --expose-gc test/verify-review-model.mjs && node test/verify-message-search.mjs && node test/verify-message-virtualization.mjs && node test/verify-message-list-catalog.mjs && node test/verify-ui-catalog.mjs && node test/verify-localization-readiness.mjs && node test/verify-command-palette.mjs && node test/verify-keyboard-a11y.mjs && node test/verify-w03-simulation.mjs && node test/verify-local-state.mjs && node test/verify-verification-wiring.mjs",
    "verify:built": "bun run verify:checks && node test/verify-production.mjs",
    "verify": "bun run verify:checks && bun run build && node test/verify-production.mjs"
  },
  "dependencies": {
    "@runic-artifex/application-bridge": "1.0.0-preview.1",
    "@runic-artifex/desktop": "1.0.0-preview.1",
