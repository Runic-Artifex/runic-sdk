{
  "name": "@runic-artifex/translations-editor-frontend",
  "private": true,
  "version": "1.0.0-preview.1",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "build": "vite build",
    "contract:generate": "runic-bridge generate --authority effect --source src/application.bridge.ts",
    "contract:check": "runic-bridge check --authority effect --source src/application.bridge.ts",
    "dev": "vite dev",
    "dev:mock": "vite dev --mode mock",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "verify:checks": "bun run --bun check && bun test/verify-appearance.mjs && bun test/verify-message-preview.mjs && bun --expose-gc test/verify-review-model.mjs && bun test/verify-message-search.mjs && bun test/verify-message-virtualization.mjs && bun test/verify-message-list-catalog.mjs && bun test/verify-ui-catalog.mjs && bun test/verify-localization-readiness.mjs && bun test/verify-command-palette.mjs && bun test/verify-keyboard-a11y.mjs && bun test/verify-w03-simulation.mjs && bun test/verify-local-state.mjs && bun test/verify-verification-wiring.mjs",
    "verify:built": "bun run --bun verify:checks && bun test/verify-production.mjs",
    "verify": "bun run --bun verify:checks && bun run --bun build && bun test/verify-production.mjs"
  },
  "dependencies": {
    "@runic-artifex/application-bridge": "workspace:*",
    "@runic-artifex/desktop": "workspace:*",
    "@runic-artifex/svelte": "workspace:*",
    "effect": "4.0.0-rc.112",
    "svelte": "5.57.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.42.0",
    "@runic-artifex/application-bridge-tooling": "workspace:*",
    "@runic-artifex/sveltekit": "workspace:*",
    "@runic-artifex/vite-plugin-runic": "workspace:*",
    "@runic-artifex/vite-plugin-runic-translations": "workspace:*",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "24.13.3",
    "bits-ui": "^2.19.0",
    "clsx": "^2.1.1",
    "shadcn-svelte": "^1.6.1",
    "svelte-check": "4.7.6",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "6.0.3",
    "vite": "8.2.2"
  }
}
