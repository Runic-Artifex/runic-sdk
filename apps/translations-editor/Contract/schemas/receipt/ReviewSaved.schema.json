{
  "$id": "runic.translations.editor/1/ReviewSaved",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "_tag": {
      "enum": [
        "ReviewSaved"
      ],
      "type": "string"
    },
    "result": {
      "additionalProperties": false,
      "properties": {
        "history": {
          "additionalProperties": false,
          "properties": {
            "canRedo": {
              "type": "boolean"
            },
            "canUndo": {
              "type": "boolean"
            },
            "redoLabel": {
              "type": "string"
            },
            "undoLabel": {
              "type": "string"
            }
          },
          "required": [
            "canUndo",
            "canRedo"
          ],
          "type": "object"
        },
        "message": {
          "type": "string"
        },
        "ok": {
          "type": "boolean"
        },
        "review": {
          "additionalProperties": false,
          "properties": {
            "entries": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "key": {
                    "type": "string"
                  },
                  "locale": {
                    "type": "string"
                  },
                  "note": {
                    "type": "string"
                  },
                  "samples": {
                    "items": {
                      "additionalProperties": false,
                      "properties": {
                        "key": {
                          "type": "string"
                        },
                        "value": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "key",
                        "value"
                      ],
                      "type": "object"
                    },
                    "type": "array"
                  },
                  "sourceFingerprint": {
                    "type": "string"
                  },
                  "state": {
                    "enum": [
                      "draft",
                      "translated",
                      "needs-review",
                      "approved"
                    ],
                    "type": "string"
                  }
                },
                "required": [
                  "key",
                  "locale",
                  "state",
                  "samples"
                ],
                "type": "object"
              },
              "type": "array"
            },
            "error": {
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "revision": {
              "type": "string"
            },
            "terminology": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "locale": {
                    "type": "string"
                  },
                  "note": {
                    "type": "string"
                  },
                  "preferred": {
                    "type": "string"
                  },
                  "source": {
                    "type": "string"
                  }
                },
                "required": [
                  "source",
                  "preferred"
                ],
                "type": "object"
              },
              "type": "array"
            }
          },
          "required": [
            "path",
            "entries",
            "terminology"
          ],
          "type": "object"
        }
      },
      "required": [
        "ok"
      ],
      "type": "object"
    }
  },
  "required": [
    "_tag",
    "result"
  ],
  "type": "object"
}
