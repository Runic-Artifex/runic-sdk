<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="$(RunicSdkRoot)packages/dotnet/Runic.Translations.Build/build/Runic.Translations.Build.props"
          Condition="'$(RunicSdkRoot)' != ''" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RunicApplicationBridgeAuthority>effect</RunicApplicationBridgeAuthority>
    <RunicApplicationBridgeGenerate>false</RunicApplicationBridgeGenerate>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Runic.Translations.Editor</AssemblyName>
    <RootNamespace>Runic.Translations.Editor</RootNamespace>
    <Product>Runic Translations Editor</Product>
    <Title>Runic Translations Editor</Title>
    <Description>A focused desktop editor for Runic Translations workspaces.</Description>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <ImplicitUsings>enable</ImplicitUsings>
    <TranslationsEmitEsm>true</TranslationsEmitEsm>
    <TranslationsToolCommand>dotnet tool run runic-translations --</TranslationsToolCommand>
    <TranslationsToolCommand Condition="'$(RunicSdkRoot)' != ''">dotnet run --project &quot;$(RunicSdkRoot)tools/dotnet-runic-translations/dotnet-runic-translations.csproj&quot; --configuration Release --</TranslationsToolCommand>
    <TranslationsRuntimePath Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)/</TranslationsRuntimePath>
    <TranslationsOutputPath>$(BaseIntermediateOutputPath)$(Configuration)/$(TargetFramework)/$(TranslationsRuntimePath)translations</TranslationsOutputPath>
    <RunicEditorUpdateChannel Condition="'$(RunicEditorUpdateChannel)' == ''">preview</RunicEditorUpdateChannel>
    <!-- The frontend build is packed and embedded as a Runic Assets archive;
         Runic Desktop serves it through a request-scoped content handler. -->
    <RunicAssetsDist>$(MSBuildProjectDirectory)/Frontend/build</RunicAssetsDist>
    <RunicAssetsEntryPoint>index.html</RunicAssetsEntryPoint>
    <!-- The editor hosts its own generated Runic.CommandLine catalog beside the one
         published inside Runic.Translations.Tooling; the identical well-known
         generated type name is expected and the locally generated catalog wins. -->
    <NoWarn>$(NoWarn);CS0436</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="RunicUpdateChannel" Value="$(RunicEditorUpdateChannel)" />
    <AssemblyMetadata Include="RepositoryCommit" Value="$(SourceRevisionId)" Condition="'$(SourceRevisionId)' != ''" />
  </ItemGroup>

  <!-- Hosted-browser fixtures are compiled only for the disposable E2E host.
       Release and package builds have no route or environment switch for them. -->
  <ItemGroup>
    <Compile Remove="tests/HostedBrowserE2E/EditorHostedE2EFixtures.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(RunicEditorHostedE2E)' == 'true'">
    <Compile Include="tests/HostedBrowserE2E/EditorHostedE2EFixtures.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../packages/dotnet/Runic.Application.Desktop/Runic.Application.Desktop.csproj" />
    <ProjectReference Include="../../packages/dotnet/Runic.Application.Hosting/Runic.Application.Hosting.csproj" />
    <ProjectReference Include="../../packages/dotnet/Runic.Application.Bridge/Runic.Application.Bridge.csproj" />
    <ProjectReference Include="../../packages/dotnet/Runic.Application.Bridge.Generators/Runic.Application.Bridge.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../packages/dotnet/Runic.Assets.Desktop/Runic.Assets.Desktop.csproj" />
    <ProjectReference Include="../../packages/dotnet/Runic.Assets.AspNetCore/Runic.Assets.AspNetCore.csproj" />
    <!-- The base package owns the archive build/embed targets even when the
         runtime adapters are supplied by workspace project references. -->
    <ProjectReference Include="../../packages/dotnet/Runic.Assets/Runic.Assets.csproj" />
    <ProjectReference Include="../../packages/dotnet/Runic.CommandLine/Runic.CommandLine.csproj" />
    <ProjectReference Include="../../packages/dotnet/Runic.CommandLine.Generators/Runic.CommandLine.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../packages/dotnet/Runic.Translations/Runic.Translations.csproj" />
    <ProjectReference Include="../../tools/Runic.Translations.Compiler/Runic.Translations.Compiler.csproj" />
    <ProjectReference Include="../../packages/dotnet/Runic.Translations.Authoring/Runic.Translations.Authoring.csproj" />
    <ProjectReference Include="../../packages/dotnet/Runic.Translations.Tooling/Runic.Translations.Tooling.csproj" />
    <ProjectReference Include="../../packages/dotnet/Runic.Translations.Generator/Runic.Translations.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
    <Analyzer Include="$(RunicSdkRoot)tools/Runic.Translations.Compiler/bin/$(Configuration)/net10.0/Runic.Translations.Compiler.dll"
              Condition="'$(RunicSdkRoot)' != ''" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="Contract/bridge.ir.json" />
  </ItemGroup>

  <Target Name="GenerateApplicationBridgeContract"
          BeforeTargets="CoreCompile"
          Condition="'$(RunicBridgeInspect)' != 'true' and '$(DesignTimeBuild)' != 'true'">
    <Exec WorkingDirectory="Frontend" Command="bun run --bun contract:generate" />
  </Target>

  <ItemGroup>
    <TranslationProject Include="EditorResources/runic.json" />
    <TranslationMf2 Include="EditorResources/**/*.mf2" />
    <EditorFrontendInput Include="Frontend/package.json;../../bun.lock;Frontend/svelte.config.js;Frontend/tsconfig.json;Frontend/vite.config.ts;Frontend/src/**/*;EditorResources/**/*" />
    <None Update="ExampleWorkspace/**/*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Include="LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="PREVIEW-NOTICE.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="launchers/runic-translations-editor" Link="runic-translations-editor" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="launchers/runic-translations-editor.cmd" Link="runic-translations-editor.cmd" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Generated ESM artifacts persist across builds, but the generator target only
       registers them in @(FileWrites) when it actually runs. On an up-to-date rebuild
       IncrementalClean would otherwise classify them as orphaned obj/ writes and delete
       them, breaking the frontend build that consumes the manifest. -->
  <Target Name="KeepGeneratedTranslationsOutOfIncrementalClean"
          BeforeTargets="_CleanGetCurrentAndPriorFileWrites"
          Condition="'$(TranslationsOutputPath)' != '' and Exists('$(TranslationsOutputPath)/editor.esm/web-module-manifest-v1.json')">
    <ItemGroup>
      <_ExistingTranslationsArtifacts Include="$(TranslationsOutputPath)/editor.esm/**/*" />
      <FileWrites Include="@(_ExistingTranslationsArtifacts)" />
    </ItemGroup>
  </Target>

  <!-- The Runic Assets pack/embed targets consume Frontend/build during the
       resource-preparation phase, so the frontend build must run immediately
       before packing on both build and publish. -->
  <Target Name="BuildTranslationsEditorFrontend"
          BeforeTargets="RunicAssetsPackFileSystem"
          DependsOnTargets="RunicTranslationsGenerateTranslationArtifacts"
          Inputs="@(EditorFrontendInput);$(TranslationsOutputPath)/editor.esm/web-module-manifest-v1.json"
          Outputs="Frontend/build/index.html">
    <Exec WorkingDirectory="Frontend"
          Command="bun run --bun build"
          EnvironmentVariables="RUNIC_TRANSLATIONS_MANIFEST=$(MSBuildProjectDirectory)/$(TranslationsOutputPath)/editor.esm/web-module-manifest-v1.json" />
  </Target>

  <Import Project="../../packages/dotnet/Runic.Assets/buildTransitive/Runic.Assets.targets"
          Condition="Exists('../../packages/dotnet/Runic.Assets/buildTransitive/Runic.Assets.targets')" />

  <Import Project="$(RunicSdkRoot)packages/dotnet/Runic.Translations.Build/build/Runic.Translations.Build.targets"
          Condition="'$(RunicSdkRoot)' != ''" />
</Project>
