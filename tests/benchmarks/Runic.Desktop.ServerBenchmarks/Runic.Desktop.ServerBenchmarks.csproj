<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../../eng/build/application.props" />
  <!-- Kestrel against the experimental native server (X1): Views requests, bursts and pushes through a real surface
       over loopback. The native library comes from artifacts/native/runic-server (eng/native/build-runic-server.sh);
       each benchmark selects its server with the Runic.Desktop.NativeServer switch at setup. -->
  <PropertyGroup>
    <!-- Not named *Tests: the managed CI groups must not run benchmarks. -->
    <OutputType>Exe</OutputType>
    <TargetFramework>$(RunicApplicationDefaultTargetFramework)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <RunicImportDesktopTargets>true</RunicImportDesktopTargets>
    <RunicDesktopServer>Native</RunicDesktopServer>
    <!-- BenchmarkDotNet requires public, non-sealed benchmark classes. -->
    <NoWarn>$(NoWarn);CA1001;CA1515;CA1822;CA1852;CA2007</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <ProjectReference Include="../../../packages/dotnet/Runic.Application.Views.Desktop/Runic.Application.Views.Desktop.csproj" />
  </ItemGroup>
  <Import Project="../../../eng/build/application.targets" />
</Project>
