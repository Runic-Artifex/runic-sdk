<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../../eng/build/application.props" />
  <PropertyGroup>
    <!-- Not named *Tests: the managed CI groups must not run benchmarks. -->
    <OutputType>Exe</OutputType>
    <TargetFramework>$(RunicApplicationDefaultTargetFramework)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- BenchmarkDotNet requires public, non-sealed benchmark classes. -->
    <NoWarn>$(NoWarn);CA1001;CA1515;CA1822;CA1852</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <ProjectReference Include="../../../packages/dotnet/Runic.Application.Testing/Runic.Application.Testing.csproj" />
  </ItemGroup>
  <Import Project="../../../eng/build/application.targets" />
</Project>
