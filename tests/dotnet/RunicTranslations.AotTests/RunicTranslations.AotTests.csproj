<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>RunicTranslations.AotTests</AssemblyName>
    <RootNamespace>RunicTranslations.AotTests</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <RestoreAdditionalProjectSources Condition="'$(TranslationsPackageFeed)' != ''">$(TranslationsPackageFeed)</RestoreAdditionalProjectSources>
    <!-- Packages under test change on every source commit. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="RunicTranslations" Version="1.0.0" />
  </ItemGroup>
</Project>
