<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../../eng/build/application.props" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../packages/dotnet/Runic.Platform.Windows/Runic.Platform.Windows.csproj" />
    <ProjectReference Include="../../../packages/dotnet/Runic.Platform.Linux/Runic.Platform.Linux.csproj" />
    <ProjectReference Include="../../../packages/dotnet/Runic.Platform.MacOS/Runic.Platform.MacOS.csproj" />

    <ProjectReference Include="../../../packages/dotnet/Runic.Application.Platform.Desktop/Runic.Application.Platform.Desktop.csproj" />
    <ProjectReference Include="../../../packages/dotnet/Runic.Platform.Runtime/Runic.Platform.Runtime.csproj" />
    <ProjectReference Include="../../../packages/dotnet/Runic.Application.Desktop/Runic.Application.Desktop.csproj" />
    <ProjectReference Include="../../../packages/dotnet/Runic.Application.CsWebUi/Runic.Application.CsWebUi.csproj" />
  </ItemGroup>
  <ItemGroup>
    <_NativeHostFrontendInput Include="Frontend/native-host.ts;../../../packages/web/desktop/src/**/*.ts;../../../bun.lock" />
  </ItemGroup>
  <Target Name="BuildNativeHostFrontend" Inputs="@(_NativeHostFrontendInput)" Outputs="$(IntermediateOutputPath)native-host.js">
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <Exec Command="bun build Frontend/native-host.ts --target browser --format esm --minify --outfile &quot;$(IntermediateOutputPath)native-host.js&quot;" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>
  <Target Name="IncludeNativeHostFrontend" BeforeTargets="AssignTargetPaths" DependsOnTargets="BuildNativeHostFrontend">
    <ItemGroup>
      <EmbeddedResource Include="$(IntermediateOutputPath)native-host.js" LogicalName="Runic.Platform.NativeHost.Frontend" />
    </ItemGroup>
  </Target>
  <Import Project="../../../eng/build/application.targets" />
</Project>
