<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../../eng/build/application.props" />
  <PropertyGroup>
    <RunicTestTimeouts>true</RunicTestTimeouts>
    <!-- A TUnit test application on Microsoft.Testing.Platform: run it with dotnet run or the built executable. -->
    <OutputType>Exe</OutputType>
    <RunicImportDesktopTargets>true</RunicImportDesktopTargets>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TUnitImplicitUsings>false</TUnitImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <!-- The tests construct generated-code support types directly. -->
    <Using Include="Runic.Application.Views.Generated" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="TUnit.Core" />
    <PackageReference Include="TUnit.Engine" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <ProjectReference Include="../../../packages/dotnet/Runic.Application.Testing/Runic.Application.Testing.csproj" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../../packages/dotnet/Runic.Application.Views.Desktop/Runic.Application.Views.Desktop.csproj" />
    <!-- Exercise the exact session implementation without loading WPF on Linux. -->
    <Compile Include="../../../packages/dotnet/Runic.Application.Views.Wpf/WpfBridgeView.cs" Link="Host/WpfBridgeView.cs" />
    <Compile Include="../../../packages/dotnet/Runic.Application.Views.Wpf/WpfPresentationOptions.cs" Link="Host/WpfPresentationOptions.cs" />
    <Compile Include="../../../packages/dotnet/Runic.Application.Views.Wpf/PresentationLifecycle.cs" Link="Host/PresentationLifecycle.cs" />
    <Compile Include="../../../packages/dotnet/Runic.Application.Views.Wpf/WpfViewsLog.cs" Link="Host/WpfViewsLog.cs" />
    <Compile Include="../../../packages/dotnet/Runic.Application.Views.Wpf/RunicViewHostState.cs" Link="Host/RunicViewHostState.cs" />
  </ItemGroup>
  <Import Project="../../../eng/build/application.targets" />
</Project>
