<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../../eng/build/application.props" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <OutputType Condition="'$(RunicApplicationFrontendBootstrap)' == 'true'">Library</OutputType>
    <TargetFramework>$(RunicApplicationDefaultTargetFramework)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Tests exercise the experimental navigation API. -->
    <NoWarn>$(NoWarn);RUNICNAV001</NoWarn>
    <!-- NavOrphanViewModel deliberately has no View. -->
    <NoWarn>$(NoWarn);RUNICBRIDGE013</NoWarn>
    <RunicApplicationFrontendGenerationEnabled>true</RunicApplicationFrontendGenerationEnabled>
    <RunicApplicationFrontendBuildCommand>dotnet --version</RunicApplicationFrontendBuildCommand>
    <RunicApplicationFrontendDirectory>$(MSBuildProjectDirectory)/obj/bridge-frontend</RunicApplicationFrontendDirectory>
    <RunicApplicationFrontendGeneratedDirectory>$(RunicApplicationFrontendDirectory)/generated</RunicApplicationFrontendGeneratedDirectory>
    <!-- Map PDB source paths to /_/ as a CI build does, so local runs also
         check that the generator resolves them to the source it documents. -->
    <DeterministicSourcePaths>true</DeterministicSourcePaths>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <!-- Compiles small invalid ViewModel assemblies for generator diagnostics tests. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <ProjectReference Include="../../../packages/dotnet/Runic.Application.Testing/Runic.Application.Testing.csproj" />
    <ProjectReference Include="../../../packages/dotnet/Runic.Application.Views.ReactiveUI/Runic.Application.Views.ReactiveUI.csproj" />
    <!-- The navigation adapter is a separate package since W250-014. -->
    <ProjectReference Include="../../../packages/dotnet/Runic.Navigation.ReactiveUI/Runic.Navigation.ReactiveUI.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../../specs/application/fixtures/collection-deltas/*.json" Link="fixtures/collection-deltas/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../../specs/application/fixtures/domain-failures/*.json" Link="fixtures/domain-failures/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="'$(RunicApplicationFrontendBootstrap)' == 'true'">
    <Compile Remove="Program.cs" />
    <Compile Remove="*Tests.cs" />
    <!-- The exporter intentionally instantiates generated bridge types, which
         do not exist during the source-only bootstrap compilation. -->
    <Compile Remove="GeneratedClientFixtureExporter.cs" />
    <Compile Remove="ToolkitGeneratedClientFixture.cs" />
    <Compile Remove="FailureGeneratedClientFixture.cs" />
  </ItemGroup>
  <Import Project="../../../packages/dotnet/Runic.Application.Views/build/Runic.Application.Views.targets" />
  <Import Project="../../../eng/build/application.targets" />
</Project>
