<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <OutputType Condition="'$(RunicBridgeBootstrap)' == 'true'">Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RunicBridgeBuildEnabled>true</RunicBridgeBuildEnabled>
    <RunicBridgeRegisterGlobally>false</RunicBridgeRegisterGlobally>
    <RunicBridgeFrontendBuildCommand>dotnet --version</RunicBridgeFrontendBuildCommand>
    <RunicBridgeFrontendDir>$(MSBuildProjectDirectory)/obj/bridge-frontend</RunicBridgeFrontendDir>
    <RunicBridgeTypescriptDir>$(RunicBridgeFrontendDir)/generated</RunicBridgeTypescriptDir>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <ProjectReference Include="../../../packages/dotnet/Runic.Application.Testing/Runic.Application.Testing.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(RunicBridgeBootstrap)' == 'true'">
    <Compile Remove="Program.cs" />
  </ItemGroup>
  <Import Project="../../../packages/dotnet/Runic.Application.Views/build/Runic.Application.Views.targets" />
</Project>
