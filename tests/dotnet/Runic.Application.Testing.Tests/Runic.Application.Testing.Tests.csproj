<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../../eng/build/application.props" />
  <PropertyGroup>
    <!-- A TUnit test application on Microsoft.Testing.Platform: run it with dotnet run or the built executable. -->
    <OutputType>Exe</OutputType>
    <OutputType Condition="'$(RunicApplicationFrontendBootstrap)' == 'true'">Library</OutputType>
    <TargetFramework>$(RunicApplicationDefaultTargetFramework)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TUnitImplicitUsings>false</TUnitImplicitUsings>
    <!-- Program.cs is hand-written: GeneratedClientHarness also starts this executable as a helper
         with the export-generated-client-fixture argument, which writes wire payloads instead of running tests. -->
    <GenerateTestingPlatformEntryPoint>false</GenerateTestingPlatformEntryPoint>
    <!-- NavOrphanViewModel deliberately has no View. -->
    <NoWarn>$(NoWarn);RUNICBRIDGE013</NoWarn>
    <RunicApplicationFrontendGenerationEnabled>true</RunicApplicationFrontendGenerationEnabled>
    <RunicApplicationFrontendBuildCommand>dotnet --version</RunicApplicationFrontendBuildCommand>
    <RunicApplicationFrontendDirectory>$(MSBuildProjectDirectory)/obj/bridge-frontend</RunicApplicationFrontendDirectory>
    <RunicApplicationFrontendGeneratedDirectory>$(RunicApplicationFrontendDirectory)/generated</RunicApplicationFrontendGeneratedDirectory>
    <!-- Map PDB source paths to /_/ as a CI build does, so local runs also
         check that the generator resolves them to the source it documents. -->
    <DeterministicSourcePaths>true</DeterministicSourcePaths>
  </PropertyGroup>
  <ItemGroup>
    <!-- The tests construct generated-code support types directly. -->
    <Using Include="Runic.Application.Views.Generated" />
    <!-- The generated bridges, which the bootstrap pass does not have yet. -->
    <Using Include="Runic.Application.Views.Generated.Bridges" Condition="'$(RunicApplicationFrontendBootstrap)' != 'true'" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="TUnit.Core" />
    <PackageReference Include="TUnit.Engine" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <!-- #478: a ReactiveValidationObject read through its ValidationContext. -->
    <PackageReference Include="RunicArtifex.ReactiveUI.Validation" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <!-- Compiles small invalid ViewModel assemblies for generator diagnostics tests. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <ProjectReference Include="../../../packages/dotnet/Runic.Application.Testing/Runic.Application.Testing.csproj" />
    <ProjectReference Include="../../../packages/dotnet/Runic.Application.Views.ReactiveUI/Runic.Application.Views.ReactiveUI.csproj" />
    <!-- The navigation adapter is a separate package since W250-014. -->
    <ProjectReference Include="../../../packages/dotnet/Runic.Navigation.ReactiveUI/Runic.Navigation.ReactiveUI.csproj" />
    <!-- The file transfer engine, for watching what a transfer writes. -->
    <ProjectReference Include="../../../packages/dotnet/Runic.Platform.Runtime/Runic.Platform.Runtime.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../../specs/application/fixtures/collection-deltas/*.json" Link="fixtures/collection-deltas/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../../specs/application/fixtures/domain-failures/*.json" Link="fixtures/domain-failures/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../../specs/application/fixtures/text-deltas/*.json" Link="fixtures/text-deltas/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../../specs/application/fixtures/released/*.json" Link="fixtures/released/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../../specs/application/fixtures/error-reasons/*.json" Link="fixtures/error-reasons/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="'$(RunicApplicationFrontendBootstrap)' == 'true'">
    <Compile Remove="Program.cs" />
    <Compile Remove="*Tests.cs" />
    <!-- The exporter intentionally instantiates generated bridge types, which
         do not exist during the source-only bootstrap compilation. -->
    <Compile Remove="GeneratedClientFixtureExporter.cs" />
    <Compile Remove="ToolkitGeneratedClientFixture.cs" />
    <Compile Remove="FailureGeneratedClientFixture.cs" />
  </ItemGroup>
  <Import Project="../../../packages/dotnet/Runic.Application.Views/build/Runic.Application.Views.targets" />
  <Import Project="../../../eng/build/application.targets" />
  <!-- The protocol-3 generated-client fixture exporter; P6 replaces it with a live generated-client harness. -->
  <ItemGroup>
    <Compile Remove="ToolkitGeneratedClientFixture.cs" />
    <Compile Remove="GeneratedClientFixtureExporter.cs" />
    <Compile Remove="FailureGeneratedClientFixture.cs" />
  </ItemGroup>
</Project>
