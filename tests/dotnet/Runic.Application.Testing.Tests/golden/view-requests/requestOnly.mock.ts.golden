/** The state of a mock RequestOnly: the client state, with content as `{ kind, id }` and command state optional. */
export type RequestOnlyMockState = RequestOnlyState;

export interface RequestOnlyMockDefinition {
  /** Presents the mock as content on route `content{id}`; omit it for the root route `requestOnly`. */
