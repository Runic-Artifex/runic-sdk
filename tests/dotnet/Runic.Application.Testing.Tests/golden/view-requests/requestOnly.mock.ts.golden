const spec: MockTypedViewSpec = {
  kind: "requestOnly",
  route: "requestOnly",
  contract: "Runic.Application.Testing.Tests.RequestOnlyViewModel:<fingerprint>",
  fields: {},
  defaults: {},
  requests: {
    focus: { encodeInput: (value: unknown) => { const typed = value as ViewRequestFocusTarget; return { ["field"]: typed["field"], ["selectAll"]: typed["selectAll"] }; } },
