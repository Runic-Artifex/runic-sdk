/**
 * Serves the RequestOnly routes from `bridge` with typed state and handlers, so a test
 * can connect the generated client without .NET.
 */
export function mockRequestOnly(bridge: MockBridge, definition: RequestOnlyMockDefinition): RequestOnlyMock {
