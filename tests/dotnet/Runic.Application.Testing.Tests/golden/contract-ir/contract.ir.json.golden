    "Runic.Navigation.NavigationArrivalState": {
      "kind": "enum",
      "name": {
        "source": "Runic.Navigation.NavigationArrivalState",
        "base": "NavigationArrivalState",
        "qualifiers": [
          "Navigation",
          "Runic"
        ]
      },
      "doc": "How the arrival hooks of a committed transition ended (`Arrival`).",
      "cases": [
        {
          "wire": "None",
          "value": "0",
          "doc": "No entry the commit made current has an arrival hook."
        },
        {
          "wire": "Completed",
          "value": "1",
          "doc": "Every arrival hook returned."
        },
        {
          "wire": "Failed",
          "value": "2",
          "doc": "An arrival hook threw; the commit stands."
        },
        {
          "wire": "Cancelled",
          "value": "3",
          "doc": "An arrival hook was cancelled, because its entry stopped being current or retired, or the navigator closed, or it was never started for that reason."
        }
      ]
    },
    "Runic.Navigation.NavigationOutcome": {
      "kind": "object",
      "name": {
        "source": "Runic.Navigation.NavigationOutcome",
        "base": "NavigationOutcome",
        "qualifiers": [
          "Navigation",
          "Runic"
        ]
      },
      "doc": "A summary of a `NavigationResult` without its .NET content and exception, so a ViewModel can return it to a Runic View, for example as the output of a back command.",
      "members": [
        {
          "wire": "kind",
          "type": {
            "kind": "named",
            "ref": "Runic.Navigation.NavigationOutcomeKind"
          },
          "doc": "How the request ended."
        },
        {
          "wire": "rejection",
          "type": {
            "kind": "named",
            "ref": "Runic.Navigation.NavigationRejection",
            "nullable": true
          },
          "optional": true,
          "doc": "Why the request was rejected, for `Rejected`; otherwise `null`."
        },
        {
          "wire": "arrival",
          "type": {
            "kind": "named",
            "ref": "Runic.Navigation.NavigationArrivalState"
          },
          "doc": "Gets how the arrival hooks (`INavigationArrived`) of the entries a `Committed` transition made current ended, so a page can show that their data failed to load; `None` for every other kind. Only the full navigation result carries the exception of a `Failed` hook."
        }
      ]
    },
    "Runic.Navigation.NavigationOutcomeKind": {
      "kind": "enum",
      "name": {
        "source": "Runic.Navigation.NavigationOutcomeKind",
        "base": "NavigationOutcomeKind",
        "qualifiers": [
          "Navigation",
          "Runic"
        ]
      },
      "doc": "How a navigation request ended, as reported by `Kind`.",
      "cases": [
        {
          "wire": "Committed",
          "value": "0",
          "doc": "The transition committed."
        },
        {
          "wire": "Rejected",
          "value": "1",
          "doc": "The transition was rejected; `Rejection` says why."
        },
        {
          "wire": "Superseded",
          "value": "2",
          "doc": "A later request replaced this one before it committed."
        },
        {
          "wire": "Failed",
          "value": "3",
          "doc": "The transition failed. Only the full navigation result carries the exception."
        }
      ]
    },
    "Runic.Navigation.NavigationRejection": {
      "kind": "enum",
      "name": {
        "source": "Runic.Navigation.NavigationRejection",
        "base": "NavigationRejection",
        "qualifiers": [
          "Navigation",
          "Runic"
        ]
      },
      "doc": "Why a navigation request was rejected.",
      "cases": [
        {
          "wire": "Guard",
          "value": "0",
          "doc": "A departure guard returned `false`."
        },
        {
          "wire": "Cancelled",
          "value": "1",
          "doc": "The caller's token was cancelled before the commit."
        },
        {
          "wire": "Closed",
          "value": "2",
          "doc": "The navigator or the region is closed."
        },
        {
          "wire": "Reentrant",
          "value": "3",
          "doc": "The request came from a hook of an in-flight transition of the same region, or of a region that holds it or is held by it (an ancestor or a descendant region). The rejection is conservative: such a request could wait on the transition that is running the hook."
        },
        {
          "wire": "NoHistory",
          "value": "4",
          "doc": "A back request found no retained entry."
        },
        {
          "wire": "NotCurrent",
          "value": "5",
          "doc": "The expected current entry is not current."
        },
        {
          "wire": "EntryNotFound",
          "value": "6",
          "doc": "The back-to target is not in the region."
        },
        {
          "wire": "Busy",
          "value": "7",
          "doc": "The region admits requests with `RejectWhileBusy` and was busy: an earlier request had not completed."
        }
      ]
    }
  },
