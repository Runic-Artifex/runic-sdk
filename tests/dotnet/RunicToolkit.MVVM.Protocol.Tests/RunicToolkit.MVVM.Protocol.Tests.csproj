<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>RunicToolkit.MVVM.Protocol.Tests</AssemblyName>
    <RootNamespace>RunicToolkit.MVVM.Protocol.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/RunicToolkit.MVVM/RunicToolkit.MVVM.csproj" />

    <Content Include="../../protocol/mvvm/schema/v1/*.json"
             Link="Protocol/schema/v1/%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../protocol/mvvm/corpus/v1/**/*.json"
             Link="Protocol/corpus/v1/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
