<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(RunicToolkitDefaultTargetFramework)</TargetFramework>
    <AssemblyName>RunicToolkit.MVVM.ReactiveUI.Tests</AssemblyName>
    <RootNamespace>RunicToolkit.MVVM.ReactiveUI.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/RunicToolkit.MVVM.ReactiveUI/RunicToolkit.MVVM.ReactiveUI.csproj" />
    <ProjectReference Include="../../src/RunicToolkit.MVVM.Build/RunicToolkit.MVVM.Build.csproj" />
    <PackageReference Include="ReactiveUI" />
    <PackageReference Include="ReactiveUI.SourceGenerators"
                      PrivateAssets="all"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="AotSmoke/**/*.cs" />
  </ItemGroup>
</Project>
