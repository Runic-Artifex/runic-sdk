<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../../eng/build/application.props" />
  <PropertyGroup>
    <RunicTestTimeouts>true</RunicTestTimeouts>
    <RunicImportDesktopTargets>true</RunicImportDesktopTargets>
    <!-- A TUnit test application on Microsoft.Testing.Platform: run it with dotnet run or the built executable. -->
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- The opt-in macOS native cases need the AppKit loop on the main thread (see Program.cs), so the entry point is hand-written. -->
    <GenerateTestingPlatformEntryPoint>false</GenerateTestingPlatformEntryPoint>
    <TUnitImplicitUsings>false</TUnitImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="TUnit.Core" />
    <PackageReference Include="TUnit.Engine" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <ProjectReference Include="../../../packages/dotnet/Runic.Desktop.Kestrel/Runic.Desktop.Kestrel.csproj" />
    <ProjectReference Include="../../../packages/dotnet/Runic.Platform.Windows/Runic.Platform.Windows.csproj" />
    <ProjectReference Include="../../../packages/dotnet/Runic.Platform.Linux/Runic.Platform.Linux.csproj" />
    <ProjectReference Include="../../../packages/dotnet/Runic.Platform.MacOS/Runic.Platform.MacOS.csproj" />
    <ProjectReference Include="../../../packages/dotnet/Runic.Platform.Runtime/Runic.Platform.Runtime.csproj" />
    <ProjectReference Include="../../../packages/dotnet/Runic.Desktop/Runic.Desktop.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The menu entry rules the Runic Desktop menu bar checks too (Runic.Desktop.Tests). -->
    <None Include="../../../specs/desktop/fixtures/menu-entries.json" Link="fixtures/menu-entries.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Import Project="../../../eng/build/application.targets" />
</Project>
