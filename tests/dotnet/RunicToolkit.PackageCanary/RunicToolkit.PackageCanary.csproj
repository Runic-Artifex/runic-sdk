<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <RestoreAdditionalProjectSources>$(PackageDirectory);$(RunicVerificationFeed);https://api.nuget.org/v3/index.json</RestoreAdditionalProjectSources>
  </PropertyGroup>

  <Target Name="ValidatePackageCanaryProperties" BeforeTargets="Restore">
    <Error Condition="'$(PackageVersion)' == ''" Text="PackageVersion is required." />
    <Error Condition="'$(PackageDirectory)' == ''" Text="PackageDirectory is required." />
  </Target>

  <ItemGroup>
    <PackageReference Include="Runic.Application" Version="$(PackageVersion)" />
    <PackageReference Include="Runic.Application.Bridge" Version="$(PackageVersion)" />
    <PackageReference Include="Runic.Application.Desktop" Version="$(PackageVersion)" />
    <PackageReference Include="Runic.Application.Hosting" Version="$(PackageVersion)" />
    <PackageReference Include="Runic.Application.Testing" Version="$(PackageVersion)" />
  </ItemGroup>
</Project>
