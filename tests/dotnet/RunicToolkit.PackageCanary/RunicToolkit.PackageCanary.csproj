<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <RunicToolkitFrontendEnabled>false</RunicToolkitFrontendEnabled>
    <RestoreAdditionalProjectSources>$(PackageDirectory);https://api.nuget.org/v3/index.json</RestoreAdditionalProjectSources>
  </PropertyGroup>

  <Target Name="ValidatePackageCanaryProperties" BeforeTargets="Restore">
    <Error Condition="'$(PackageVersion)' == ''" Text="PackageVersion is required." />
    <Error Condition="'$(PackageDirectory)' == ''" Text="PackageDirectory is required." />
  </Target>

  <ItemGroup>
    <PackageReference Include="RunicToolkit.Collections" Version="$(PackageVersion)" />
    <PackageReference Include="RunicToolkit.Desktop" Version="$(PackageVersion)" />
    <PackageReference Include="RunicToolkit.ApplicationBridge" Version="$(PackageVersion)" />
    <PackageReference Include="RunicToolkit.ApplicationBridge.Generators" Version="$(PackageVersion)" PrivateAssets="all" />
    <PackageReference Include="RunicToolkit.Hosting.Build" Version="$(PackageVersion)" />
    <PackageReference Include="RunicToolkit.Hosting.CsWebUi.App" Version="$(PackageVersion)" />
    <PackageReference Include="RunicToolkit.Hosting.CsWebUi.ApplicationBridge" Version="$(PackageVersion)" />
    <PackageReference Include="RunicToolkit.Hosting.Generators" Version="$(PackageVersion)" />
  </ItemGroup>
</Project>
