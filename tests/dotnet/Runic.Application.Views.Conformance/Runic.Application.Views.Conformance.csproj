<Project Sdk="Microsoft.NET.Sdk">
  <!-- The conformance adapter of the .NET Views producer (eng/conformance/PROTOCOL.md, rax.conformance-adapter/1):
       `bun run conformance dotnet-views` builds and starts it. It is never packed or shipped (R7 T1-17). It compiles
       the test Views, the scenario transport and the codec table of Runic.Application.Testing.Tests/Conformance in
       place, and has its own InternalsVisibleTo grants (R6 F10). -->
  <Import Project="../../../eng/build/application.props" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(RunicApplicationDefaultTargetFramework)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <RunicTestTimeouts>true</RunicTestTimeouts>
    <!-- The test Views have no generated TypeScript client. -->
    <RunicApplicationFrontendGenerationEnabled>false</RunicApplicationFrontendGenerationEnabled>
    <!-- As in Runic.Application.Testing.Tests: the test Views keep small observable lists of rows without keys. -->
    <NoWarn>$(NoWarn);RUNICBRIDGE013;RUNICBRIDGE032</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="Runic.Application.Views.Generated" />
  </ItemGroup>
  <ItemGroup>
    <!-- ValidationSignal of the form View. -->
    <Compile Include="../Runic.Application.Testing.Tests/ReactiveValidationFixture.cs" Link="Support/ReactiveValidationFixture.cs" />
    <Compile Include="../Runic.Application.Testing.Tests/Conformance/*.cs" Exclude="../Runic.Application.Testing.Tests/Conformance/*Tests.cs" Link="Conformance/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="RunicArtifex.ReactiveUI.Validation" />
    <PackageReference Include="Runic.Translations" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <ProjectReference Include="../../../packages/dotnet/Runic.Application.Testing/Runic.Application.Testing.csproj" />
    <ProjectReference Include="../../../packages/dotnet/Runic.Application.Views.ReactiveUI/Runic.Application.Views.ReactiveUI.csproj" />
    <ProjectReference Include="../../../packages/dotnet/Runic.Navigation.ReactiveUI/Runic.Navigation.ReactiveUI.csproj" />
    <ProjectReference Include="../../../packages/dotnet/Runic.Platform.Runtime/Runic.Platform.Runtime.csproj" />
  </ItemGroup>
  <Import Project="../../../eng/build/application.targets" />
</Project>
