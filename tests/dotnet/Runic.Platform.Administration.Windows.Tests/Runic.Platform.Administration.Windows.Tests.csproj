<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../../eng/build/application.props" />
  <PropertyGroup>
    <!-- A TUnit test application on Microsoft.Testing.Platform: run it with dotnet run or the built executable. -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
    <TUnitImplicitUsings>false</TUnitImplicitUsings>
    <!-- ApiShapeTests builds native DNS records to check their conversion on every operating system. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <TrimmerRootAssembly Include="Runic.Platform.Administration.Windows" />
    <PackageReference Include="TUnit.Core" />
    <PackageReference Include="TUnit.Engine" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <PackageReference Include="System.DirectoryServices.Protocols" />
    <ProjectReference Include="../../../packages/dotnet/Runic.Platform.Administration.Windows/Runic.Platform.Administration.Windows.csproj" />
    <!-- VerifierPayloadTests pins the verifier's runic.administration.verify/1 payload. -->
    <ProjectReference Include="../../../tools/Runic.Administration.Verify/Runic.Administration.Verify.csproj" />
  </ItemGroup>
  <Import Project="../../../eng/build/application.targets" />
</Project>
