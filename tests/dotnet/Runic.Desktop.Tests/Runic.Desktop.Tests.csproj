<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../../eng/build/desktop.props" />
  <PropertyGroup>
    <RunicTestTimeouts>true</RunicTestTimeouts>
    <RunicImportDesktopTargets>true</RunicImportDesktopTargets>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <IsPackable>false</IsPackable>
    <!-- A TUnit test application on Microsoft.Testing.Platform: run it with dotnet run or the built executable. -->
    <OutputType>Exe</OutputType>
    <TUnitImplicitUsings>false</TUnitImplicitUsings>
    <!-- The executable is also the application ShutdownSignalTests stops (ShutdownSignalFixture.cs),
         so Program.cs chooses between that fixture and the test application. -->
    <GenerateTestingPlatformEntryPoint>false</GenerateTestingPlatformEntryPoint>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit.Core" />
    <PackageReference Include="TUnit.Engine" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <!-- The cases keep xUnit's assertions. -->
    <PackageReference Include="xunit.assert" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../packages/dotnet/Runic.Desktop/Runic.Desktop.csproj" />
    <ProjectReference Include="../../../packages/dotnet/Runic.Desktop.Gtk4/Runic.Desktop.Gtk4.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../../specs/desktop/conformance/scenarios/*.json" Link="conformance/scenarios/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../../specs/desktop/conformance/vectors/*.json" Link="conformance/vectors/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../../specs/desktop/fixtures/shortcuts.json" Link="fixtures/shortcuts.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../../specs/desktop/fixtures/menu-entries.json" Link="fixtures/menu-entries.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../fixtures/desktop/evidence/conformance/dotnet-m6.json" Link="conformance/dotnet-m6.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../../packages/dotnet/Runic.Desktop/Internal/Wayland/*" Link="wayland/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />

  </ItemGroup>
  <Target Name="IncludeWebView2AbiContract" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <_WebView2Sdk Include="@(PackageVersion)" Condition="'%(Identity)' == 'Microsoft.Web.WebView2'" />
      <None Include="@(_WebView2Sdk->'$(NuGetPackageRoot)/microsoft.web.webview2/%(Version)/build/native/include/WebView2.h')"
            Link="interop/WebView2.h" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
