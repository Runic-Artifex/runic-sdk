<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN" "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<!-- A media player shaped like MPRIS, for the generator's end-to-end tests. -->
<node xmlns:doc="http://www.freedesktop.org/dbus/1.0/doc.dtd">
  <interface name="org.runic.Test.Media">
    <doc:doc><doc:summary>The player as a whole.</doc:summary></doc:doc>
    <method name="Raise"/>
    <property name="Identity" type="s" access="read"/>
    <property name="CanQuit" type="b" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="const"/>
    </property>
  </interface>
  <interface name="org.runic.Test.Media.Player">
    <method name="Seek">
      <arg name="offset" type="x" direction="in"/>
      <arg name="position" type="x" direction="out"/>
    </method>
    <method name="OpenUri">
      <arg name="uri" type="s" direction="in"/>
    </method>
    <method name="Describe">
      <arg name="tags" type="a{sv}" direction="in"/>
      <arg name="tracks" type="a(oss)" direction="in"/>
      <arg name="name" type="s" direction="out"/>
      <arg name="count" type="u" direction="out"/>
      <arg name="lookup" type="a{oa{sv}}" direction="out"/>
    </method>
    <method name="Mirror">
      <arg name="byte" type="y" direction="in"/>
      <arg name="flag" type="b" direction="in"/>
      <arg name="small" type="n" direction="in"/>
      <arg name="usmall" type="q" direction="in"/>
      <arg name="int" type="i" direction="in"/>
      <arg name="uint" type="u" direction="in"/>
      <arg name="long" type="x" direction="in"/>
      <arg name="ulong" type="t" direction="in"/>
      <arg name="double" type="d" direction="in"/>
      <arg name="path" type="o" direction="in"/>
      <arg name="signature" type="g" direction="in"/>
      <arg name="any" type="v" direction="in"/>
      <arg name="bytes" type="ay" direction="in"/>
      <arg name="pair" type="(iy)" direction="in"/>
      <arg name="names" type="a{ss}" direction="in"/>
      <arg name="result" type="(ybnqiuxtdogvay(iy)a{ss})" direction="out"/>
    </method>
    <method name="ReadFile">
      <arg name="file" type="h" direction="in"/>
      <arg name="text" type="s" direction="out"/>
    </method>
    <property name="Volume" type="d" access="readwrite"/>
    <property name="PlaybackStatus" type="s" access="read"/>
    <property name="Metadata" type="a{sv}" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="invalidates"/>
    </property>
    <property name="Rate" type="d" access="write"/>
    <signal name="Seeked">
      <arg name="position" type="x"/>
    </signal>
    <signal name="Stopped"/>
    <signal name="TrackChanged">
      <arg name="track" type="o"/>
      <arg name="title" type="s"/>
    </signal>
  </interface>
</node>
