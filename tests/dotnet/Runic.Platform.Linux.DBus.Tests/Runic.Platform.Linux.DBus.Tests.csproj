<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../../eng/build/application.props" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- A TUnit test application on Microsoft.Testing.Platform: run it with dotnet run or the built executable. -->
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TUnitImplicitUsings>false</TUnitImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="TUnit.Core" />
    <PackageReference Include="TUnit.Engine" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <ProjectReference Include="../../../packages/dotnet/Runic.Platform.Linux.DBus/Runic.Platform.Linux.DBus.csproj" />
    <!-- The package's analyzer and props, as a project reference instead of the packed package. -->
    <ProjectReference Include="../../../packages/dotnet/Runic.Platform.Linux.DBus.Generator/Runic.Platform.Linux.DBus.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false"
        UndefineProperties="RuntimeIdentifier;SelfContained;PublishAot;IlcTreatWarningsAsErrors" />
    <AdditionalFiles Include="Interfaces/org.runic.Test.Media.xml" RunicDBusMode="Proxy,Service" RunicDBusNamespace="Runic.Platform.Linux.DBus.Tests.Generated" />
  </ItemGroup>
  <Import Project="../../../packages/dotnet/Runic.Platform.Linux.DBus/buildTransitive/Runic.Platform.Linux.DBus.props" />
  <Import Project="../../../eng/build/application.targets" />
</Project>
