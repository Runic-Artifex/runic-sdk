<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>WebUIToolkit.MVVM.CommunityToolkit.AotSmoke</AssemblyName>
    <RootNamespace>WebUIToolkit.MVVM.CommunityToolkit.AotSmoke</RootNamespace>
    <IsPackable>false</IsPackable>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <TrimMode>full</TrimMode>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <ProjectReference
      Condition="'$(CommunityToolkitAdapterPackageVersion)' == ''"
      Include="../../../src/WebUIToolkit.MVVM.CommunityToolkit/WebUIToolkit.MVVM.CommunityToolkit.csproj" />
    <PackageReference
      Condition="'$(CommunityToolkitAdapterPackageVersion)' != ''"
      Include="WebUIToolkit.MVVM.CommunityToolkit"
      Version="$(CommunityToolkitAdapterPackageVersion)" />
  </ItemGroup>
</Project>
