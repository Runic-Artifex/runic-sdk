<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>WebUIToolkit.MVVM.CommunityToolkit.PackageConsumer</AssemblyName>
    <RootNamespace>WebUIToolkit.MVVM.CommunityToolkit.PackageConsumer</RootNamespace>
    <IsPackable>false</IsPackable>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference
      Condition="'$(CommunityToolkitAdapterPackageVersion)' == ''"
      Include="../../../../src/WebUIToolkit.MVVM.CommunityToolkit/WebUIToolkit.MVVM.CommunityToolkit.csproj" />
    <PackageReference
      Condition="'$(CommunityToolkitAdapterPackageVersion)' != ''"
      Include="WebUIToolkit.MVVM.CommunityToolkit"
      Version="$(CommunityToolkitAdapterPackageVersion)" />
  </ItemGroup>
</Project>
