<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../../eng/build/application.props" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);RUNICWPF001;RUNICNAV001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <ProjectReference Include="../../../packages/dotnet/Runic.Application.Testing/Runic.Application.Testing.csproj" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../../packages/dotnet/Runic.Application.Desktop/Runic.Application.Desktop.csproj" />
    <!-- Exercise the exact session implementation without loading WPF on Linux. -->
    <Compile Include="../../../packages/dotnet/Runic.Application.Wpf/WpfBridgeView.cs" Link="Host/WpfBridgeView.cs" />
    <Compile Include="../../../packages/dotnet/Runic.Application.Wpf/WpfPresentationOptions.cs" Link="Host/WpfPresentationOptions.cs" />
    <Compile Include="../../../packages/dotnet/Runic.Application.Wpf/WpfDiagnostics.cs" Link="Host/WpfDiagnostics.cs" />
  </ItemGroup>
  <Import Project="../../../eng/build/application.targets" />
</Project>
