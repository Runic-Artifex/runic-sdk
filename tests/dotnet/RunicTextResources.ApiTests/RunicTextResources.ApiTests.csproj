    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NoWarn>$(NoWarn);CA1305;CA1815</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\RunicTextResources\RunicTextResources.csproj" />
    <ProjectReference Include="..\..\src\RunicTextResources.Compiler\RunicTextResources.Compiler.csproj" />
    <ProjectReference Include="..\..\src\RunicTextResources.Generator\RunicTextResources.Generator.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
