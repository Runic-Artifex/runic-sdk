    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../packages/dotnet/Runic.Translations.Wpf/Runic.Translations.Wpf.csproj" />
    <ProjectReference Include="../../../tools/Runic.Translations.Compiler/Runic.Translations.Compiler.csproj" />
    <None Include="../../../specs/translations/examples/rmf2/*" Link="payment/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Import Project="../../../eng/build/translations.targets" />
</Project>
