<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(RunicToolkitDefaultTargetFramework)</TargetFramework>
    <AssemblyName>RunicToolkit.ApplicationBridge.Tests</AssemblyName>
    <RootNamespace>RunicToolkit.ApplicationBridge.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/RunicToolkit.ApplicationBridge/RunicToolkit.ApplicationBridge.csproj" />
    <ProjectReference Include="../../src/RunicToolkit.ApplicationBridge.Generators/RunicToolkit.ApplicationBridge.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <AdditionalFiles Include="../../protocol/application-bridge/setup/generated/bridge.manifest.json" />
    <AdditionalFiles Include="../../protocol/application-bridge/setup/generated/schemas/**/*.schema.json" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../protocol/application-bridge/setup/fixtures/*.json"
          Link="fixtures/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
