<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../../eng/build/application.props" />
  <PropertyGroup>
    <!-- A TUnit test application on Microsoft.Testing.Platform: run it with dotnet run or the built executable. -->
    <OutputType>Exe</OutputType>
    <RunicImportDesktopTargets>true</RunicImportDesktopTargets>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TUnitImplicitUsings>false</TUnitImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <!-- The tests construct generated-code support types directly. -->
    <Using Include="Runic.Application.Views.Generated" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="TUnit.Core" />
    <PackageReference Include="TUnit.Engine" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <ProjectReference Include="../../../packages/dotnet/Runic.Application.Testing/Runic.Application.Testing.csproj" />
    <ProjectReference Include="../../../packages/dotnet/Runic.Application.Views.Wpf/Runic.Application.Views.Wpf.csproj" />
    <!-- The portable cases, run here on the WPF dispatcher (AssemblyInfo.cs selects WpfDispatcherExecutor). -->
    <Compile Include="../Runic.Application.Views.Wpf.Tests/AssemblyInfo.cs" Link="AssemblyInfo.cs" />
    <Compile Include="../../native/Runic.Desktop.WebViewSmoke/SurfaceScripts.cs" Link="SurfaceScripts.cs" />
    <Compile Include="../Runic.Application.Views.Wpf.Tests/Program.cs" Link="Program.cs" />
    <Compile Include="../Runic.Application.Views.Wpf.Tests/HostLifecycleTests.cs" Link="HostLifecycleTests.cs" />
  </ItemGroup>
  <Import Project="../../../eng/build/application.targets" />
</Project>
