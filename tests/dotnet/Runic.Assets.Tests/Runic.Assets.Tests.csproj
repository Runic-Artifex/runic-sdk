<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../../eng/build/assets.props" />
  <PropertyGroup>
    <!-- A TUnit test application on Microsoft.Testing.Platform: run it with dotnet run or the built executable. -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CA1861</NoWarn>
    <TUnitImplicitUsings>false</TUnitImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit.Core" />
    <PackageReference Include="TUnit.Engine" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <ProjectReference Include="../../../packages/dotnet/Runic.Assets/Runic.Assets.csproj" />
    <ProjectReference Include="../../../packages/dotnet/Runic.Assets.AspNetCore/Runic.Assets.AspNetCore.csproj" />
    <ProjectReference Include="../../../tools/Runic.Assets.Packer/Runic.Assets.Packer.csproj" />
    <EmbeddedResource Include="TestAssets/index.html" LogicalName="Runic.Assets.Tests.index.html" />
    <EmbeddedResource Include="TestAssets/app.css" LogicalName="Runic.Assets.Tests.app.css" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <Import Project="../../../eng/build/assets.targets" />
</Project>
