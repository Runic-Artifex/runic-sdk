<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../../eng/build/application.props" />
  <PropertyGroup>
    <RunicTestTimeouts>true</RunicTestTimeouts>
    <!-- Runic.Desktop is referenced for DesktopStandardMenuTitles only; a Desktop executable references a server. -->
    <RunicImportDesktopTargets>true</RunicImportDesktopTargets>
    <!-- A TUnit test application on Microsoft.Testing.Platform: run it with dotnet run or the built executable. -->
    <OutputType>Exe</OutputType>
    <OutputType Condition="'$(RunicApplicationFrontendBootstrap)' == 'true'">Library</OutputType>
    <TargetFramework>$(RunicApplicationDefaultTargetFramework)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TUnitImplicitUsings>false</TUnitImplicitUsings>
    <!-- The window's Bridge is generated as in an application; the page is not built. -->
    <RunicApplicationFrontendGenerationEnabled>true</RunicApplicationFrontendGenerationEnabled>
    <RunicApplicationFrontendBuildCommand>dotnet --version</RunicApplicationFrontendBuildCommand>
    <RunicApplicationFrontendDirectory>$(MSBuildProjectDirectory)/obj/bridge-frontend</RunicApplicationFrontendDirectory>
    <RunicApplicationFrontendGeneratedDirectory>$(RunicApplicationFrontendDirectory)/generated</RunicApplicationFrontendGeneratedDirectory>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="Runic.Application.Views.Generated.Bridges" Condition="'$(RunicApplicationFrontendBootstrap)' != 'true'" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="TUnit.Core" />
    <PackageReference Include="TUnit.Engine" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <!-- Compiles translations/: an application catalog with French, which runic-views lacks (ServiceCollectionTests). -->
    <PackageReference Include="Runic.Translations.Build" PrivateAssets="all" />
    <ProjectReference Include="../../../packages/dotnet/Runic.Application.Views.Translations/Runic.Application.Views.Translations.csproj" />
    <ProjectReference Include="../../../packages/dotnet/Runic.Application.Testing/Runic.Application.Testing.csproj" />
    <!-- Only to check that the catalog has a title for every DesktopStandardMenuTitles member (StandardMenuTitlesTests). -->
    <ProjectReference Include="../../../packages/dotnet/Runic.Desktop/Runic.Desktop.csproj" />
    <ProjectReference Include="../../../packages/dotnet/Runic.Desktop.Kestrel/Runic.Desktop.Kestrel.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(RunicApplicationFrontendBootstrap)' == 'true'">
    <Compile Remove="*Tests.cs" />
  </ItemGroup>
  <Import Project="../../../packages/dotnet/Runic.Application.Views/build/Runic.Application.Views.targets" />
  <Import Project="../../../eng/build/application.targets" />
</Project>
