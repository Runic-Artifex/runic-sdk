<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>WebUIToolkit.TextResources.AotTests</AssemblyName>
    <RootNamespace>WebUIToolkit.TextResources.AotTests</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <RestoreAdditionalProjectSources Condition="'$(TextResourcesPackageFeed)' != ''">$(TextResourcesPackageFeed)</RestoreAdditionalProjectSources>
    <InvariantGlobalization>false</InvariantGlobalization>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WebUIToolkit.TextResources" Version="1.0.0" />
  </ItemGroup>
</Project>
