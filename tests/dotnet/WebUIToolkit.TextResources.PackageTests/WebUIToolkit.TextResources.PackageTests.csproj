<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>WebUIToolkit.TextResources.PackageTests</AssemblyName>
    <RootNamespace>WebUIToolkit.TextResources.PackageTests</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <RestoreAdditionalProjectSources Condition="'$(TextResourcesPackageFeed)' != ''">$(TextResourcesPackageFeed)</RestoreAdditionalProjectSources>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WebUIToolkit.TextResources" Version="1.0.0" />
    <PackageReference Include="WebUIToolkit.TextResources.Build" Version="1.0.0" PrivateAssets="all" />
    <PackageReference Include="WebUIToolkit.TextResources.Generator"
                      Version="1.0.0"
                      PrivateAssets="all"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <TextResourceCatalog Include="Fixtures\catalog.json" />
    <TextResourceDocument Include="Fixtures\en.json" />
  </ItemGroup>
</Project>
