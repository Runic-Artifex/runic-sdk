<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Runic.Translations.PackageTests</AssemblyName>
    <RootNamespace>Runic.Translations.PackageTests</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <TranslationsPackageVersion Condition="'$(TranslationsPackageVersion)' == ''">1.0.0-preview.1</TranslationsPackageVersion>
    <RestoreAdditionalProjectSources Condition="'$(TranslationsPackageFeed)' != ''">$(TranslationsPackageFeed);$(RunicCommandLinePackageFeed)</RestoreAdditionalProjectSources>
    <!-- Packages under test change on every source commit. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Runic.Translations" Version="$(TranslationsPackageVersion)" />
    <PackageReference Include="Runic.Translations.Tooling" Version="$(TranslationsPackageVersion)" />
    <PackageReference Include="Runic.Translations.Build" Version="$(TranslationsPackageVersion)" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <TranslationCatalog Include="Fixtures\catalog.json" />
    <TranslationDocument Include="Fixtures\en.json" />
  </ItemGroup>
</Project>
