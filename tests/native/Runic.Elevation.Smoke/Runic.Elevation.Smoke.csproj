<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../../eng/build/desktop.props" />
  <PropertyGroup>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <OutputType>Exe</OutputType>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>Runic.Elevation.Smoke</RootNamespace>
    <!-- The elevated helper of Runic.Platform.Windows.Elevation.Tests' RealElevation cases, with the package's
         requireAdministrator manifest. CI publishes it for win-x64 with -p:PublishAot=true (RUNICEL002 refuses
         anything else) and installs it under Program Files. PublishAot is not set here, so the RID-neutral restore of
         RunicSdk.Core.slnx keeps a lock file; an application's helper sets it in its project. -->
    <RunicWindowsElevatedHelper>true</RunicWindowsElevatedHelper>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../packages/dotnet/Runic.Platform.Windows.Elevation/Runic.Platform.Windows.Elevation.csproj" />
  </ItemGroup>
  <Import Project="actions.props" />
  <!-- A package consumer gets these targets from the packages' buildTransitive folders. -->
  <Import Project="../../../packages/dotnet/Runic.Platform/buildTransitive/Runic.Platform.targets" />
  <Import Project="../../../packages/dotnet/Runic.Platform.Windows.Elevation/buildTransitive/Runic.Platform.Windows.Elevation.targets" />
</Project>
