<Project Sdk="Microsoft.NET.Sdk">
  <!-- The application that CI packages with dotnet runic package on each platform, then
       installs and opens through its URL scheme. It opens no window: it writes a receipt of what the installed
       package sees (see README.md). -->
  <Import Project="../../../eng/build/desktop.props" />
  <PropertyGroup>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <OutputType>Exe</OutputType>
    <!-- As in the template: a Windows GUI application, whose diagnostics the template's DiagnosticsLog keeps. -->
    <OutputType Condition="$(RuntimeIdentifier.StartsWith('win')) Or ('$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('Windows')))">WinExe</OutputType>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- The template's identity properties, which dotnet runic package reads. The name has spaces, as a bundle name may. -->
    <ApplicationId>org.runic.tests.PackagingProbe</ApplicationId>
    <ApplicationTitle>Runic Packaging Probe</ApplicationTitle>
    <Version>1.2.3</Version>
    <Description>Checks Runic application packages</Description>
    <PackageProjectUrl>https://github.com/Runic-Artifex/runic-sdk</PackageProjectUrl>
    <RunicApplicationPublisher>CN=Runic Packaging Test</RunicApplicationPublisher>
    <RunicApplicationUrlSchemes>runic-packaging-probe</RunicApplicationUrlSchemes>
    <!-- Two files of this type opened at once reach one packaged process (MultiSelectModel="Player"). -->
    <RunicApplicationFileTypes>.runicprobe</RunicApplicationFileTypes>
    <!-- The Flatpak exports a D-Bus service file and the desktop entry sets DBusActivatable=true. -->
    <RunicApplicationDBusActivatable>true</RunicApplicationDBusActivatable>
    <!-- The template's ApplicationIdentity.cs with its Desktop part. -->
    <DefineConstants>$(DefineConstants);desktopHost</DefineConstants>
    <ApplicationIcon>../../../tools/Runic.Application.Templates/content/runic-app/icons/icon.ico</ApplicationIcon>
    <!-- The template's icons; the package uses icon.png and, on Linux, the icon.svg beside it. -->
    <RunicPackageIcon>../../../tools/Runic.Application.Templates/content/runic-app/icons/icon.png</RunicPackageIcon>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="ApplicationId" Value="$(ApplicationId)" />
    <AssemblyMetadata Include="ApplicationTitle" Value="$(ApplicationTitle)" />
    <Compile Include="../../../tools/Runic.Application.Templates/content/runic-app/ApplicationIdentity.cs" Link="ApplicationIdentity.cs" />
    <None Update="www/index.html" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../../packages/dotnet/Runic.Application.Views/Runic.Application.Views.csproj" />
    <ProjectReference Include="../../../packages/dotnet/Runic.Platform.Windows/Runic.Platform.Windows.csproj" />
  </ItemGroup>
  <!-- As Runic.Application.Views.Desktop brings them to an application: on macOS, dotnet run starts the probe from its
       development bundle (G-8), which the macOS packaging leg checks. -->
  <Import Project="../../../packages/dotnet/Runic.Platform.MacOS/buildTransitive/Runic.Platform.MacOS.targets" />
</Project>
