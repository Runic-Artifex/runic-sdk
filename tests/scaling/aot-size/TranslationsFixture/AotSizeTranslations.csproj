<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Translations variant of the CS-WebUI fixture (tests/scaling/README.md, "NativeAOT size"): ../Fixture with
       Runic.Translations.Hosting and Runic.Application.Views.Translations (Runic's own en/de text) registered, K = 0.
       aot/views-translations/executable-bytes measures what an application with Translations ships. Only published,
       never run. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>AotSize</RootNamespace>
    <RunicApplicationFrontendBuildEnabled>false</RunicApplicationFrontendBuildEnabled>
    <RunicApplicationFrontendGeneratedDirectory>$(BaseIntermediateOutputPath)runic-bridge/typescript</RunicApplicationFrontendGeneratedDirectory>
    <AotSizeModelsDirectory Condition="'$(AotSizeModelsDirectory)' == ''">$(MSBuildThisFileDirectory)../../../../artifacts/scaling/aot-size/models</AotSizeModelsDirectory>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(AotSizeModelsDirectory)/ViewModels.g.cs" />
    <Compile Include="../Fixture/Shared.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Runic.Translations.Hosting" />
  </ItemGroup>
  <Import Project="../../../../packages/dotnet/Runic.Application.Views.CsWebUi/build/Runic.Application.Views.CsWebUi.props" />
  <ItemGroup>
    <ProjectReference Include="../../../../packages/dotnet/Runic.Application.Views.CsWebUi/Runic.Application.Views.CsWebUi.csproj" />
    <ProjectReference Include="../../../../packages/dotnet/Runic.Application.Views.Translations/Runic.Application.Views.Translations.csproj" />
  </ItemGroup>
  <Import Project="../../../../packages/dotnet/Runic.Application.Views/build/Runic.Application.Views.targets" />
  <Import Project="../../../../packages/dotnet/Runic.Application.Views.CsWebUi/build/Runic.Application.Views.CsWebUi.targets" />
</Project>
