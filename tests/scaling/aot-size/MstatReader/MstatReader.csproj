<Project Sdk="Microsoft.NET.Sdk">
  <!-- Reads an ILC mstat file (IlcGenerateMstatFile) and prints one record per line: kind<TAB>size<TAB>name, where kind is
       Types, Methods or Blobs and size is the node's size in bytes. tests/scaling/aot-size/measure.mjs groups them.
       System.Reflection.Metadata is in the shared framework: no package. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
</Project>
