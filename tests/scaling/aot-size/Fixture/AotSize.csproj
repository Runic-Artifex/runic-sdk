<Project Sdk="Microsoft.NET.Sdk">
  <!-- The NativeAOT size fixture of the scaling suite (tests/scaling/README.md, "NativeAOT size"). measure.mjs writes
       the K bridged ViewModels of one fixed shape (ViewModels.g.cs, in AotSizeModelsDirectory) and publishes this
       project for linux-x64 with an mstat file. The application is only published, never run. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>AotSize</RootNamespace>
    <RunicApplicationFrontendBuildEnabled>false</RunicApplicationFrontendBuildEnabled>
    <RunicApplicationFrontendGeneratedDirectory>$(BaseIntermediateOutputPath)runic-bridge/typescript</RunicApplicationFrontendGeneratedDirectory>
    <AotSizeModelsDirectory Condition="'$(AotSizeModelsDirectory)' == ''">$(MSBuildThisFileDirectory)../../../../artifacts/scaling/aot-size/models</AotSizeModelsDirectory>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(AotSizeModelsDirectory)/ViewModels.g.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>
  <Import Project="../../../../packages/dotnet/Runic.Application.Views.CsWebUi/build/Runic.Application.Views.CsWebUi.props" />
  <ItemGroup>
    <ProjectReference Include="../../../../packages/dotnet/Runic.Application.Views.CsWebUi/Runic.Application.Views.CsWebUi.csproj" />
  </ItemGroup>
  <Import Project="../../../../packages/dotnet/Runic.Application.Views/build/Runic.Application.Views.targets" />
  <Import Project="../../../../packages/dotnet/Runic.Application.Views.CsWebUi/build/Runic.Application.Views.CsWebUi.targets" />
</Project>
