{
  "format": "runic.desktop.conformance-scenario/1",
  "id": "protocol.used-before-created.v1",
  "contract": { "id": "runic.desktop.presentation", "version": 1 },
  "area": "protocol",
  "ids": { "host": "host-1", "surface": "surface-1", "session": "session-1" },
