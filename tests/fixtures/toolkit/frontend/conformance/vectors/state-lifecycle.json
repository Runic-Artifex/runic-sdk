{
  "format": "webuitoolkit.mvvm.conformance-scenarios/1",
  "protocolIdentity": "webuitoolkit.mvvm/1",
  "category": "state-lifecycle",
  "revisionEncoding": "Expected revisions are canonical decimal strings so runners must compare them losslessly.",
  "scenarios": [
    {
      "id": "opened-installs-complete-revision-zero-state",
      "initial": { "status": "opening", "revision": null, "members": [] },
      "steps": [
        {
          "action": "receive",
          "message": {
            "v": 1,
            "kind": "opened",
            "contract": "Example.Counter",
            "session": "00000000-0000-4000-8000-000000000004",
            "view": "00000000-0000-4000-8000-000000000002",
            "request": "00000000-0000-4000-8000-000000000003",
            "capability": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
            "payload": {
              "snapshot": {
                "revision": 0,
                "members": [
                  { "type": "property", "member": 1, "value": "ready" },
                  { "type": "collection", "member": 2, "items": [1, 2, 3] },
                  { "type": "command", "member": 3, "canExecute": true, "isExecuting": false },
                  { "type": "validation", "member": 1, "errors": [] }
                ]
              }
            }
          },
          "expect": { "status": "open", "revision": "0", "property:1": "ready", "collection:2": [1, 2, 3], "command:3": { "canExecute": true, "isExecuting": false }, "validation:1": [] }
        }
      ]
    },
    {
      "id": "atomic-patch-applies-ordered-change-kinds",
      "initial": { "status": "open", "revision": "7", "property:1": "old", "collection:2": ["a", "b", "c"], "command:3": { "canExecute": true, "isExecuting": false }, "validation:1": ["old error"] },
      "steps": [
        {
          "action": "receive",
          "message": {
            "v": 1,
            "kind": "patch",
            "session": "00000000-0000-4000-8000-000000000004",
            "view": "00000000-0000-4000-8000-000000000002",
            "payload": {
              "fromRevision": 7,
              "toRevision": 8,
              "changes": [
                { "type": "property", "member": 1, "value": "new" },
                { "type": "collection", "member": 2, "operation": "insert", "index": 1, "items": ["x"] },
                { "type": "collectionMove", "member": 2, "from": 3, "to": 0, "count": 1 },
                { "type": "collection", "member": 2, "operation": "replace", "index": 2, "items": ["y"] },
                { "type": "collection", "member": 2, "operation": "insert", "index": 3, "items": ["z"] },
                { "type": "collection", "member": 2, "operation": "remove", "index": 1, "items": ["a"] },
                { "type": "command", "member": 3, "canExecute": false, "isExecuting": true },
                { "type": "validation", "member": 1, "errors": ["required", "too short"] }
              ]
            }
          },
          "expect": { "revision": "8", "property:1": "new", "collection:2": ["c", "y", "z", "b"], "command:3": { "canExecute": false, "isExecuting": true }, "validation:1": ["required", "too short"], "notifications": 1 }
        }
      ]
    },
    {
      "id": "collection-reset-replaces-all-items",
      "initial": { "status": "open", "revision": "8", "collection:2": [1, 2, 3] },
      "steps": [
        {
          "action": "receive",
          "message": { "v": 1, "kind": "patch", "session": "00000000-0000-4000-8000-000000000004", "view": "00000000-0000-4000-8000-000000000002", "payload": { "fromRevision": 8, "toRevision": 9, "changes": [{ "type": "collection", "member": 2, "operation": "reset", "index": 0, "items": [4, 5] }] } },
          "expect": { "revision": "9", "collection:2": [4, 5] }
        }
      ]
    },
    {
      "id": "authoritative-snapshot-removes-absent-state",
      "initial": { "status": "open", "revision": "12", "property:1": "stale", "collection:2": [1], "command:3": { "canExecute": false, "isExecuting": true }, "validation:1": ["stale"] },
      "steps": [
        {
          "action": "receive",
          "message": { "v": 1, "kind": "snapshot", "session": "00000000-0000-4000-8000-000000000004", "view": "00000000-0000-4000-8000-000000000002", "request": "00000000-0000-4000-8000-000000000009", "payload": { "revision": 14, "members": [{ "type": "property", "member": 1, "value": "fresh" }] } },
          "expect": { "revision": "14", "property:1": "fresh", "absent": ["collection:2", "command:3", "validation:1"] }
        }
      ]
    },
    {
      "id": "patch-gap-does-not-speculate",
      "initial": { "status": "open", "revision": "4", "property:1": "kept" },
      "steps": [
        {
          "action": "receive",
          "message": { "v": 1, "kind": "patch", "session": "00000000-0000-4000-8000-000000000004", "view": "00000000-0000-4000-8000-000000000002", "payload": { "fromRevision": 6, "toRevision": 7, "changes": [{ "type": "property", "member": 1, "value": "must-not-apply" }] } },
          "expect": { "revision": "4", "property:1": "kept", "outboundKinds": ["requestSnapshot"], "recovery": "snapshot-required" }
        }
      ]
    },
    {
      "id": "byte-identical-duplicate-patch-is-idempotent",
      "initial": { "status": "open", "revision": "5", "property:1": "applied", "lastPatchUtf8": "{\"v\":1,\"kind\":\"patch\",\"session\":\"00000000-0000-4000-8000-000000000004\",\"view\":\"00000000-0000-4000-8000-000000000002\",\"payload\":{\"fromRevision\":4,\"toRevision\":5,\"changes\":[{\"type\":\"property\",\"member\":1,\"value\":\"applied\"}]}}" },
      "steps": [
        {
          "action": "receiveUtf8",
          "frame": "{\"v\":1,\"kind\":\"patch\",\"session\":\"00000000-0000-4000-8000-000000000004\",\"view\":\"00000000-0000-4000-8000-000000000002\",\"payload\":{\"fromRevision\":4,\"toRevision\":5,\"changes\":[{\"type\":\"property\",\"member\":1,\"value\":\"applied\"}]}}",
          "expect": { "revision": "5", "property:1": "applied", "notifications": 0, "outboundKinds": [] }
        }
      ]
    },
    {
      "id": "conflicting-duplicate-patch-requires-snapshot",
      "initial": { "status": "open", "revision": "5", "property:1": "applied", "lastPatchUtf8": "{\"fromRevision\":4,\"toRevision\":5,\"changes\":[{\"type\":\"property\",\"member\":1,\"value\":\"applied\"}]}" },
      "steps": [
        {
          "action": "receive",
          "message": { "v": 1, "kind": "patch", "session": "00000000-0000-4000-8000-000000000004", "view": "00000000-0000-4000-8000-000000000002", "payload": { "fromRevision": 4, "toRevision": 5, "changes": [{ "type": "property", "member": 1, "value": "conflict" }] } },
          "expect": { "revision": "5", "property:1": "applied", "outboundKinds": ["requestSnapshot"], "recovery": "snapshot-required" }
        }
      ]
    },
    {
      "id": "revision-above-binary64-safe-range-is-lossless",
      "initial": { "status": "open", "revision": "9007199254740992", "property:1": "before" },
      "steps": [
        {
          "action": "receiveUtf8",
          "frame": "{\"v\":1,\"kind\":\"patch\",\"session\":\"00000000-0000-4000-8000-000000000004\",\"view\":\"00000000-0000-4000-8000-000000000002\",\"payload\":{\"fromRevision\":9007199254740992,\"toRevision\":9007199254740993,\"changes\":[{\"type\":\"property\",\"member\":1,\"value\":\"after\"}]}}",
          "expect": { "revision": "9007199254740993", "property:1": "after", "outboundKinds": [] }
        }
      ]
    }
  ]
}
