{
  "format": "runic.toolkit.mvvm.hostile-input/1",
  "protocolIdentity": "runic.toolkit.mvvm/1",
  "encoding": "Each case supplies exact hexadecimal bytes, exact UTF-8 text, or a deterministic generator recipe. Generators emit compact JSON with ASCII keys in the listed order.",
  "cases": [
    { "id": "invalid-utf8", "input": { "kind": "hex", "value": "7b226b696e64223a22c328227d" }, "expect": { "accepted": false, "dispatchCount": 0, "reason": "invalid-utf8" } },
    { "id": "utf8-bom", "input": { "kind": "hex", "value": "efbbbf7b7d" }, "expect": { "accepted": false, "dispatchCount": 0, "reason": "byte-order-mark" } },
    { "id": "duplicate-object-key", "input": { "kind": "utf8", "value": "{\"v\":1,\"v\":1,\"kind\":\"handshake\",\"request\":\"00000000-0000-4000-8000-000000000001\",\"payload\":{\"supportedVersions\":[1],\"capabilities\":[]}}" }, "expect": { "accepted": false, "dispatchCount": 0, "reason": "duplicate-key" } },
    { "id": "trailing-document", "input": { "kind": "utf8", "value": "{}{}" }, "expect": { "accepted": false, "dispatchCount": 0, "reason": "trailing-data" } },
    { "id": "json-comment", "input": { "kind": "utf8", "value": "{/*comment*/}" }, "expect": { "accepted": false, "dispatchCount": 0, "reason": "comment" } },
    { "id": "trailing-comma", "input": { "kind": "utf8", "value": "{\"v\":1,}" }, "expect": { "accepted": false, "dispatchCount": 0, "reason": "trailing-comma" } },
    { "id": "non-finite-number", "input": { "kind": "utf8", "value": "{\"value\":NaN}" }, "expect": { "accepted": false, "dispatchCount": 0, "reason": "non-finite-number" } },
    { "id": "revision-at-signed-64-maximum", "input": { "kind": "utf8", "value": "{\"v\":1,\"kind\":\"setProperty\",\"session\":\"ffffffff-ffff-4fff-bfff-ffffffffffff\",\"view\":\"ffffffff-ffff-4fff-afff-ffffffffffff\",\"request\":\"ffffffff-ffff-4fff-9fff-ffffffffffff\",\"baseRevision\":9223372036854775807,\"capability\":\"___________________________________________\",\"payload\":{\"member\":1,\"value\":null}}" }, "expect": { "accepted": true, "baseRevision": "9223372036854775807", "reason": null } },
    { "id": "revision-above-signed-64-maximum", "input": { "kind": "utf8", "value": "{\"v\":1,\"kind\":\"setProperty\",\"session\":\"ffffffff-ffff-4fff-bfff-ffffffffffff\",\"view\":\"ffffffff-ffff-4fff-afff-ffffffffffff\",\"request\":\"ffffffff-ffff-4fff-9fff-ffffffffffff\",\"baseRevision\":9223372036854775808,\"capability\":\"___________________________________________\",\"payload\":{\"member\":1,\"value\":null}}" }, "expect": { "accepted": false, "dispatchCount": 0, "reason": "revision-overflow" } },
    { "id": "fractional-revision", "input": { "kind": "utf8", "value": "{\"v\":1,\"kind\":\"setProperty\",\"session\":\"00000000-0000-4000-8000-000000000004\",\"view\":\"00000000-0000-4000-8000-000000000002\",\"request\":\"00000000-0000-4000-8000-000000000005\",\"baseRevision\":1.5,\"capability\":\"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\",\"payload\":{\"member\":1,\"value\":null}}" }, "expect": { "accepted": false, "dispatchCount": 0, "reason": "fractional-revision" } },
    { "id": "negative-zero-revision-normalizes-losslessly", "input": { "kind": "utf8", "value": "{\"v\":1,\"kind\":\"setProperty\",\"session\":\"00000000-0000-4000-8000-000000000004\",\"view\":\"00000000-0000-4000-8000-000000000002\",\"request\":\"00000000-0000-4000-8000-000000000005\",\"baseRevision\":-0,\"capability\":\"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\",\"payload\":{\"member\":1,\"value\":null}}" }, "expect": { "accepted": true, "baseRevision": "0", "reason": null } },
    { "id": "depth-at-ceiling", "input": { "kind": "generated", "generator": "nestedArrays", "parameters": { "depth": 32, "leaf": null } }, "expect": { "accepted": true, "reason": null } },
    { "id": "depth-above-ceiling", "input": { "kind": "generated", "generator": "nestedArrays", "parameters": { "depth": 33, "leaf": null } }, "expect": { "accepted": false, "dispatchCount": 0, "reason": "max-json-depth" } },
    { "id": "frame-at-byte-ceiling", "input": { "kind": "generated", "generator": "spacePaddedDocument", "parameters": { "document": "{}", "totalUtf8Bytes": 1048576 } }, "expect": { "accepted": true, "reason": null } },
    { "id": "frame-above-byte-ceiling", "input": { "kind": "generated", "generator": "spacePaddedDocument", "parameters": { "document": "{}", "totalUtf8Bytes": 1048577 } }, "expect": { "accepted": false, "dispatchCount": 0, "reason": "max-frame-bytes" } },
    { "id": "general-string-at-byte-ceiling", "input": { "kind": "generated", "generator": "jsonStringValue", "parameters": { "unicodeScalar": "é", "repeat": 32768, "utf8Bytes": 65536 } }, "expect": { "accepted": true, "reason": null } },
    { "id": "general-string-above-byte-ceiling", "input": { "kind": "generated", "generator": "jsonStringValue", "parameters": { "unicodeScalar": "é", "repeat": 32769, "utf8Bytes": 65538 } }, "expect": { "accepted": false, "dispatchCount": 0, "reason": "max-general-string-utf8-bytes" } },
    { "id": "property-name-at-byte-ceiling", "input": { "kind": "generated", "generator": "singlePropertyObject", "parameters": { "unicodeScalar": "é", "repeat": 64, "nameUtf8Bytes": 128, "value": null } }, "expect": { "accepted": true, "reason": null } },
    { "id": "property-name-above-byte-ceiling", "input": { "kind": "generated", "generator": "singlePropertyObject", "parameters": { "unicodeScalar": "é", "repeat": 65, "nameUtf8Bytes": 130, "value": null } }, "expect": { "accepted": false, "dispatchCount": 0, "reason": "max-property-name-utf8-bytes" } },
    { "id": "object-properties-at-ceiling", "input": { "kind": "generated", "generator": "numberedPropertyObject", "parameters": { "count": 4096, "prefix": "p", "value": null } }, "expect": { "accepted": true, "reason": null } },
    { "id": "object-properties-above-ceiling", "input": { "kind": "generated", "generator": "numberedPropertyObject", "parameters": { "count": 4097, "prefix": "p", "value": null } }, "expect": { "accepted": false, "dispatchCount": 0, "reason": "max-object-properties" } },
    { "id": "array-items-at-ceiling", "input": { "kind": "generated", "generator": "repeatedArray", "parameters": { "count": 10000, "value": null } }, "expect": { "accepted": true, "reason": null } },
    { "id": "array-items-above-ceiling", "input": { "kind": "generated", "generator": "repeatedArray", "parameters": { "count": 10001, "value": null } }, "expect": { "accepted": false, "dispatchCount": 0, "reason": "max-array-items" } },
    { "id": "snapshot-members-above-ceiling", "input": { "kind": "generated", "generator": "hostSnapshot", "parameters": { "memberCount": 4097, "revision": "0" } }, "expect": { "accepted": false, "dispatchCount": 0, "reason": "max-snapshot-members" } },
    { "id": "patch-changes-above-ceiling", "input": { "kind": "generated", "generator": "hostPatch", "parameters": { "changeCount": 1025, "fromRevision": "0", "toRevision": "1" } }, "expect": { "accepted": false, "dispatchCount": 0, "reason": "max-patch-changes" } },
    { "id": "inserted-items-above-ceiling", "input": { "kind": "generated", "generator": "hostCollectionInsertPatch", "parameters": { "itemCount": 10001, "fromRevision": "0", "toRevision": "1" } }, "expect": { "accepted": false, "dispatchCount": 0, "reason": "max-inserted-items" } },
    { "id": "control-character-in-contract", "input": { "kind": "utf8", "value": "{\"v\":1,\"kind\":\"open\",\"contract\":\"Example\\u0000Counter\",\"view\":\"00000000-0000-4000-8000-000000000002\",\"request\":\"00000000-0000-4000-8000-000000000003\",\"payload\":{}}" }, "expect": { "accepted": false, "dispatchCount": 0, "reason": "control-character" } },
    { "id": "prototype-pollution-payload-key", "input": { "kind": "utf8", "value": "{\"v\":1,\"kind\":\"setProperty\",\"session\":\"00000000-0000-4000-8000-000000000004\",\"view\":\"00000000-0000-4000-8000-000000000002\",\"request\":\"00000000-0000-4000-8000-000000000005\",\"baseRevision\":0,\"capability\":\"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\",\"payload\":{\"member\":1,\"value\":{\"__proto__\":{\"polluted\":true}}}}" }, "expect": { "accepted": true, "prototypePolluted": false, "reason": null } }
  ]
}
