{
  "format": "webuitoolkit.mvvm.conformance-scenarios/1",
  "protocolIdentity": "webuitoolkit.mvvm/1",
  "category": "reconnect-lifecycle",
  "scenarios": [
    {
      "id": "reconnect-handshakes-before-snapshot-request",
      "initial": { "connection": "disconnected", "status": "recovering", "revision": "12", "property:1": "cached" },
      "steps": [
        { "action": "transportConnected", "handshakeRequest": "00000000-0000-4000-8000-000000000070", "expect": { "outboundKinds": ["handshake"], "status": "recovering" } },
        { "action": "receive", "message": { "v": 1, "kind": "handshakeResult", "request": "00000000-0000-4000-8000-000000000070", "payload": { "selectedVersion": 1, "capabilities": ["patches", "validation"], "limits": { "maxFrameBytes": 1048576, "maxJsonDepth": 32, "maxSessions": 16, "maxPendingRequests": 64, "maxSnapshotMembers": 4096, "maxPatchChanges": 1024, "maxCollectionItems": 10000, "commandTimeoutMilliseconds": 30000 } } }, "expect": { "outboundKinds": ["requestSnapshot"], "status": "recovering" } },
        { "action": "receive", "message": { "v": 1, "kind": "snapshot", "session": "00000000-0000-4000-8000-000000000004", "view": "00000000-0000-4000-8000-000000000002", "request": "00000000-0000-4000-8000-000000000071", "payload": { "revision": 14, "members": [{ "type": "property", "member": 1, "value": "authoritative" }] } }, "expect": { "status": "open", "revision": "14", "property:1": "authoritative" } }
      ]
    },
    {
      "id": "transport-loss-rejects-pending-requests-once",
      "initial": { "connection": "connected", "status": "open", "revision": "14", "pending": ["00000000-0000-4000-8000-000000000072", "00000000-0000-4000-8000-000000000073"] },
      "steps": [
        { "action": "transportDisconnected", "expect": { "status": "recovering", "pending": [], "rejectedCount": 2, "rejectedCode": "transport.disconnected", "settlementsPerRequest": 1 } },
        { "action": "transportDisconnected", "expect": { "rejectedCount": 0, "settlementsPerRequest": 1 } }
      ]
    },
    {
      "id": "stale-fault-enters-snapshot-recovery",
      "initial": { "connection": "connected", "status": "open", "revision": "14", "property:1": "kept", "pending": ["00000000-0000-4000-8000-000000000074"] },
      "steps": [
        { "action": "receive", "message": { "v": 1, "kind": "fault", "session": "00000000-0000-4000-8000-000000000004", "view": "00000000-0000-4000-8000-000000000002", "request": "00000000-0000-4000-8000-000000000074", "payload": { "code": "revision.stale", "message": "The request is based on an obsolete revision.", "retryable": true, "currentRevision": 16, "snapshotRequired": true } }, "expect": { "status": "recovering", "revision": "14", "property:1": "kept", "outboundKinds": ["requestSnapshot"], "rejectedCode": "revision.stale" } }
      ]
    },
    {
      "id": "patch-during-recovery-is-not-applied",
      "initial": { "connection": "connected", "status": "recovering", "revision": "14", "property:1": "kept" },
      "steps": [
        { "action": "receive", "message": { "v": 1, "kind": "patch", "session": "00000000-0000-4000-8000-000000000004", "view": "00000000-0000-4000-8000-000000000002", "payload": { "fromRevision": 14, "toRevision": 15, "changes": [{ "type": "property", "member": 1, "value": "speculative" }] } }, "expect": { "status": "recovering", "revision": "14", "property:1": "kept", "patchApplied": false } }
      ]
    },
    {
      "id": "session-closed-requires-new-open-not-snapshot",
      "initial": { "connection": "connected", "status": "open", "revision": "18" },
      "steps": [
        { "action": "receive", "message": { "v": 1, "kind": "fault", "session": "00000000-0000-4000-8000-000000000004", "view": "00000000-0000-4000-8000-000000000002", "request": "00000000-0000-4000-8000-000000000075", "payload": { "code": "session.closed", "message": "The session is closed.", "retryable": false } }, "expect": { "status": "closed", "recovery": "open-new-session", "outboundKinds": [] } }
      ]
    }
  ]
}
