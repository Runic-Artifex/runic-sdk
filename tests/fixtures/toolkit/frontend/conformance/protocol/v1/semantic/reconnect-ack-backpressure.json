{
  "reconnect": {
    "steps": ["handshake", "requestSnapshot", "replaceLocalState", "resumeMutations"],
    "patchReplayRequired": false,
    "mutationBeforeSnapshotAllowed": false
  },
  "ackCases": [
    {
      "id": "advance-watermark",
      "hostRevision": 12,
      "previousAcknowledgedRevision": 8,
      "requestedRevision": 10,
      "expectedAcknowledgedRevision": 10,
      "expected": "result",
      "revisionIncrements": 0
    },
    {
      "id": "older-watermark",
      "hostRevision": 12,
      "previousAcknowledgedRevision": 10,
      "requestedRevision": 8,
      "expectedAcknowledgedRevision": 10,
      "expected": "result",
      "revisionIncrements": 0
    },
    {
      "id": "future-watermark",
      "hostRevision": 12,
      "previousAcknowledgedRevision": 10,
      "requestedRevision": 13,
      "expectedAcknowledgedRevision": 10,
      "expected": "request.invalid",
      "revisionIncrements": 0
    }
  ],
  "pendingQueue": {
    "capacity": 64,
    "countIncludes": ["queued", "executing"],
    "countExcludes": ["completedTombstones"],
    "atCapacity": "accepted",
    "aboveCapacity": "limit.exceeded",
    "consumerInvocationsForRejectedAdmission": 0,
    "revisionIncrementsForRejectedAdmission": 0
  },
  "boundedTransportWriter": {
    "finiteConfiguredBoundRequired": true,
    "terminalCapacityReservedForEveryAdmittedRequest": true,
    "maxMessagesPerMutation": 2,
    "messages": ["optionalPatch", "terminalResponse"],
    "whenCapacityExhausted": ["stopReading", "pauseAdmission"],
    "droppableOrReplaceableMessages": [],
    "writeTimeout": "documentedBounded",
    "writeTimeoutOutcome": "closeTransport"
  },
  "patchHistory": {
    "retention": "optionalBounded",
    "unacknowledgedPatchRetentionRequired": false,
    "atHistoryBound": ["stopReplayRetention", "stopLivePatchPublication"],
    "terminalRevisionPublicationContinues": true,
    "clientRecoveryForRevisionGap": "requestSnapshot"
  },
  "ackIsAdvisoryBackpressureOnly": true,
  "ackPermitsReclamation": true,
  "ackPromisesReplay": false
}
