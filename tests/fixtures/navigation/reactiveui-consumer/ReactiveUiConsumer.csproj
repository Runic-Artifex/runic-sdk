<Project Sdk="Microsoft.NET.Sdk">
  <!-- Built only by package-smoke.mjs, in a temporary copy that restores the packed
       Runic.Navigation.ReactiveUI (or, with RunicNavigationFlavor=Reactive, the
       .Reactive package) from a local feed. It references no other Runic package. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <!-- The fixture exercises the experimental navigation API. -->
    <NoWarn>$(NoWarn);RUNICNAV001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- The container; the adapter itself needs only the abstractions. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="$(RunicContainerVersion)" />
  </ItemGroup>
  <ItemGroup Condition="'$(RunicNavigationFlavor)' != 'Reactive'">
    <PackageReference Include="Runic.Navigation.ReactiveUI" Version="$(RunicPackageVersion)" />
  </ItemGroup>
  <ItemGroup Condition="'$(RunicNavigationFlavor)' == 'Reactive'">
    <PackageReference Include="Runic.Navigation.ReactiveUI.Reactive" Version="$(RunicPackageVersion)" />
  </ItemGroup>
  <PropertyGroup Condition="'$(RunicNavigationFlavor)' == 'Reactive'">
    <DefineConstants>$(DefineConstants);SYSTEM_REACTIVE</DefineConstants>
  </PropertyGroup>
</Project>
