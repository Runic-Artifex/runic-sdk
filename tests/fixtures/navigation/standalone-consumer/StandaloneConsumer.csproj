<Project Sdk="Microsoft.NET.Sdk">
  <!-- Built only by package-smoke.mjs, in a temporary copy that restores the
       packed Runic.Navigation (RunicPackageVersion) from a local feed. It
       references no other Runic package: no build targets, generator, Node or host. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <!-- The fixture exercises the experimental navigation API. -->
    <NoWarn>$(NoWarn);RUNICNAV001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Runic.Navigation" Version="$(RunicPackageVersion)" />
    <!-- The container that builds container-resolved targets (W240-004). package-smoke.mjs passes
         the version from the repository's Directory.Packages.props. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="$(RunicDependencyInjectionVersion)" />
  </ItemGroup>
</Project>
