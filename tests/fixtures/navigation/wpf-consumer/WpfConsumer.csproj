<Project Sdk="Microsoft.NET.Sdk">
  <!-- Built only by package-smoke.mjs, in a temporary copy that restores the packed
       Runic.Navigation.Wpf from a local feed. It references no other Runic package. -->
  <PropertyGroup>
    <!-- Exe, not WinExe, so the smoke run reports to the console. -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <StartupObject>WpfConsumer.Program</StartupObject>
    <!-- The fixture exercises the experimental navigation API. -->
    <NoWarn>$(NoWarn);RUNICNAV001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- The container; the package itself needs only the abstractions. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="$(RunicContainerVersion)" />
    <PackageReference Include="Runic.Navigation.Wpf" Version="$(RunicPackageVersion)" />
  </ItemGroup>
</Project>
