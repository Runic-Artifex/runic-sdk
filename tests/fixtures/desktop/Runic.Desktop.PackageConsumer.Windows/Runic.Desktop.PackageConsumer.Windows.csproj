<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RunicDesktopPackageVersion Condition="'$(RunicDesktopPackageVersion)' == ''">1.0.0-preview.1</RunicDesktopPackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- This project deliberately names no WebView2 package. It verifies that
         the Runic.Desktop package carries the native loader to a clean
         Windows-targeted consumer without exposing the WebView2 API. -->
    <PackageReference Include="Runic.Desktop" Version="$(RunicDesktopPackageVersion)" />
  </ItemGroup>
</Project>
