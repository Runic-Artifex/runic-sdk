<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RunicDesktopPackageVersion Condition="'$(RunicDesktopPackageVersion)' == ''">$(RunicSdkVersion)</RunicDesktopPackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Runic.Desktop" Version="$(RunicDesktopPackageVersion)" />
    <!-- The presentation server (since 0.15). -->
    <PackageReference Include="Runic.Desktop.Kestrel" Version="$(RunicDesktopPackageVersion)" />
  </ItemGroup>
</Project>
