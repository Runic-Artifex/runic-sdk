<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RunicDesktopPackageVersion Condition="'$(RunicDesktopPackageVersion)' == ''">1.0.0-preview.1</RunicDesktopPackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Runic.Desktop" Version="$(RunicDesktopPackageVersion)" />
  </ItemGroup>
</Project>
