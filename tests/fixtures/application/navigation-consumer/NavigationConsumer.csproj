<Project Sdk="Microsoft.NET.Sdk">
  <!-- Built only by package-smoke.mjs, in a temporary copy that restores the
       packed Runic packages (RunicPackageVersion) from a local feed. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <!-- No project-wide RUNICNAV001 suppression: the sources suppress it where they use the
         experimental navigation API, and generated code must need none (package-smoke.mjs). -->
    <RunicApplicationFrontendBuildEnabled>false</RunicApplicationFrontendBuildEnabled>
    <RunicApplicationFrontendGeneratedDirectory>$(BaseIntermediateOutputPath)runic-bridge/typescript</RunicApplicationFrontendGeneratedDirectory>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="$(DependencyInjectionVersion)" />
    <PackageReference Include="Runic.Application.Views.CsWebUi" Version="$(RunicPackageVersion)" />
  </ItemGroup>
</Project>
