<Project>
  <Import Project="../../../../Directory.Build.targets" />
  <Target Name="RunicPostMvvmDiscoveryRequireBuildOwner"
          BeforeTargets="Restore;PrepareForBuild;CoreCompile;CoreClean"
          Condition="'$(MSBuildProjectName)' == 'PostMvvmDiscovery'">
    <Error Condition="'$(RunicPostMvvmDiscoveryOutputKey)' == '' or $([System.Text.RegularExpressions.Regex]::IsMatch('$(RunicPostMvvmDiscoveryOutputKey)', '[^A-Za-z0-9_-]'))"
           Code="RUNICPM008"
           Text="RunicPostMvvmDiscoveryOutputKey must be a nonempty single segment containing only ASCII letters, digits, hyphen, or underscore." />
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(RunicPostMvvmDiscoveryBuildOwner)', '^[a-f0-9]{32}$'))"
           Code="RUNICPM009"
           Text="The internal post-MVVM discovery fixture requires RunicPostMvvmDiscoveryBuildOwner: a 32-character lowercase hexadecimal build-owner token supplied by its top-level wrapper." />
    <Error Condition="'$(RunicPostMvvmDiscoveryOwnerDriver)' != 'true'"
           Code="RUNICPM011"
           Text="The internal post-MVVM discovery fixture requires its top-level owner driver to establish owner-scoped restore and compiler paths." />
    <Error Condition="'$(_RunicPostMvvmDiscoveryInheritedOutputPath)' != '' or '$(_RunicPostMvvmDiscoveryInheritedIntermediateOutputPath)' != '' or '$(_RunicPostMvvmDiscoveryInheritedBaseOutputPath)' != '' or '$(_RunicPostMvvmDiscoveryInheritedBaseIntermediateOutputPath)' != '' or '$(_RunicPostMvvmDiscoveryInheritedProjectExtensionsPath)' != '' or '$(_RunicPostMvvmDiscoveryInheritedProjectAssetsFile)' != ''"
           Code="RUNICPM010"
           Text="The internal post-MVVM discovery fixture does not accept global output, intermediate, or restore path overrides because they bypass its build-owner isolation." />
  </Target>
</Project>
