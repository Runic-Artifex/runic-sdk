<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../../../eng/build/application.props" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Runic.Application.Bridge.PostMvvmDiscovery.Fixture</AssemblyName>
    <RootNamespace>Runic.Application.Bridge.PostMvvmFixture</RootNamespace>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <_RunicPostMvvmDiscovery>true</_RunicPostMvvmDiscovery>
    <!-- A concrete default makes the effective deletion key nonempty. A global
         empty or malformed override remains empty/malformed and is rejected by
         the imported target before it can reach RemoveDir. -->
    <RunicPostMvvmDiscoveryOutputKey Condition="'$(RunicPostMvvmDiscoveryOutputKey)' == ''">ordinary</RunicPostMvvmDiscoveryOutputKey>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Smoke/**/*.cs" />
    <!-- The inspector runs at build time. App publish properties must not turn it into an AOT target. -->
    <ProjectReference Include="../../../../tools/Runic.Application.Bridge.Inspector/Runic.Application.Bridge.Inspector.csproj" ReferenceOutputAssembly="false" GlobalPropertiesToRemove="PublishAot;PublishTrimmed;EnableTrimAnalyzer;EnableAotAnalyzer;RuntimeIdentifier;SelfContained;OutputPath;IntermediateOutputPath" />
    <ProjectReference Include="../../../../packages/dotnet/Runic.Application.Bridge/Runic.Application.Bridge.csproj" GlobalPropertiesToRemove="OutputPath;IntermediateOutputPath" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="ReactiveUI" />
  </ItemGroup>
  <Import Project="../../../../eng/build/application.targets" />
  <Import Project="../../../../eng/build/post-mvvm-discovery.targets" />
</Project>
