<Project Sdk="Microsoft.NET.Sdk">
  <!-- CS-WebUI Window lifetime probes. CI publishes this project with
       NativeAOT, and examples/first-window/package-smoke.mjs builds the same
       Program.cs against the packed packages. No frontend is involved. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RunicApplicationFrontendBuildEnabled>false</RunicApplicationFrontendBuildEnabled>
    <RunicApplicationFrontendGeneratedDirectory>$(BaseIntermediateOutputPath)runic-bridge/typescript</RunicApplicationFrontendGeneratedDirectory>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>
  <Import Project="../../../../packages/dotnet/Runic.Application.Views.CsWebUi/build/Runic.Application.Views.CsWebUi.props" />
  <ItemGroup>
    <ProjectReference Include="../../../../packages/dotnet/Runic.Application.Views.CsWebUi/Runic.Application.Views.CsWebUi.csproj" />
    <!-- UnownedDialogProbe.cs (- -probe-unowned-dialogs): the providers' unowned file dialogs. The package smoke builds
         Program.cs alone, without these references or the constant. -->
    <ProjectReference Include="../../../../packages/dotnet/Runic.Platform.Windows/Runic.Platform.Windows.csproj" />
    <ProjectReference Include="../../../../packages/dotnet/Runic.Platform.MacOS/Runic.Platform.MacOS.csproj" />
  </ItemGroup>
  <PropertyGroup>
    <DefineConstants>$(DefineConstants);RUNIC_UNOWNED_DIALOG_PROBE</DefineConstants>
  </PropertyGroup>
  <Import Project="../../../../packages/dotnet/Runic.Application.Views/build/Runic.Application.Views.targets" />
  <Import Project="../../../../packages/dotnet/Runic.Application.Views.CsWebUi/build/Runic.Application.Views.CsWebUi.targets" />
</Project>
