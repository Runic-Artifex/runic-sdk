<Project Sdk="Microsoft.NET.Sdk">
  <!-- CS-WebUI Window lifetime probes. CI publishes this project with
       NativeAOT, and examples/first-window/package-smoke.mjs builds the same
       Program.cs against the packed packages. No frontend is involved. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RunicBridgeBuildFrontend>false</RunicBridgeBuildFrontend>
    <RunicBridgeTypescriptDir>$(BaseIntermediateOutputPath)runic-bridge/typescript</RunicBridgeTypescriptDir>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>
  <Import Project="../../../../packages/dotnet/Runic.Application.Views.CsWebUi/build/Runic.Application.CsWebUi.props" />
  <ItemGroup>
    <ProjectReference Include="../../../../packages/dotnet/Runic.Application.Views.CsWebUi/Runic.Application.Views.CsWebUi.csproj" />
  </ItemGroup>
  <Import Project="../../../../packages/dotnet/Runic.Application.Views/build/Runic.Application.Views.targets" />
  <Import Project="../../../../packages/dotnet/Runic.Application.Views.CsWebUi/build/Runic.Application.Views.CsWebUi.targets" />
</Project>
