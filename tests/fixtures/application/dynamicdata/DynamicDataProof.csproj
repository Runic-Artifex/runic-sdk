<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <OutputType Condition="'$(RunicBridgeBootstrap)' == 'true'">Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RunicBridgeBuildEnabled>true</RunicBridgeBuildEnabled>
    <RunicBridgeFrontendDir>$(MSBuildProjectDirectory)/obj/frontend</RunicBridgeFrontendDir>
    <RunicBridgeTypescriptDir>$(RunicBridgeFrontendDir)/generated</RunicBridgeTypescriptDir>
    <RunicBridgeFrontendBuildCommand>dotnet --version</RunicBridgeFrontendBuildCommand>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ReactiveUI" />
    <ProjectReference Include="$(DynamicDataForkRoot)/src/DynamicData/DynamicData.csproj" />
    <ProjectReference Include="../../../../packages/dotnet/Runic.Application.Views/Runic.Application.Views.csproj" />
    <ProjectReference Include="../../../../packages/dotnet/Runic.Application.Views.ReactiveUI/Runic.Application.Views.ReactiveUI.csproj" />
    <Compile Include="../../../../examples/dynamicdata/RowsViewModel.cs" Link="RowsViewModel.cs" />
    <Compile Include="../../../../examples/dynamicdata/Benchmarks.cs" Link="Benchmarks.cs" Condition="'$(RunicBridgeBootstrap)' != 'true'" />
  </ItemGroup>
  <ItemGroup Condition="'$(RunicBridgeBootstrap)' == 'true'">
    <Compile Remove="Program.cs" />
  </ItemGroup>
  <Import Project="../../../../packages/dotnet/Runic.Application.Views/build/Runic.Application.Views.targets" />
</Project>
