<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RunicSdkRoot Condition="'$(RUNIC_SDK_ROOT)' != ''">$(RUNIC_SDK_ROOT)</RunicSdkRoot>
  </PropertyGroup>
  <Import Project="$(RunicSdkRoot)/eng/build/application.props" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Runic.Application.Bridge.PostMvvmDiscovery.Fixture</AssemblyName>
    <RootNamespace>Runic.Application.Bridge.PostMvvmFixture</RootNamespace>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <_RunicPostMvvmDiscovery>true</_RunicPostMvvmDiscovery>
    <!-- The current internal discovery selection key. The owner token keeps
         this disposable dev session independent from every other build. -->
    <RunicPostMvvmDiscoveryOutputKey Condition="'$(RunicPostMvvmDiscoveryOutputKey)' == ''">ordinary</RunicPostMvvmDiscoveryOutputKey>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(RunicSdkRoot)/tools/Runic.Application.Bridge.Inspector/Runic.Application.Bridge.Inspector.csproj" ReferenceOutputAssembly="false" GlobalPropertiesToRemove="PublishAot;PublishTrimmed;EnableTrimAnalyzer;EnableAotAnalyzer;RuntimeIdentifier;SelfContained" />
    <ProjectReference Include="$(RunicSdkRoot)/packages/dotnet/Runic.Application.Bridge/Runic.Application.Bridge.csproj" />
    <!-- This project is copied outside Central Package Management by the
         browser fixture, so its test-only dependencies remain explicit. -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" Condition="'$(ManagePackageVersionsCentrally)' != 'true'" />
    <PackageReference Include="ReactiveUI" Version="24.2.0" Condition="'$(ManagePackageVersionsCentrally)' != 'true'" />
    <PackageReference Include="CommunityToolkit.Mvvm" Condition="'$(ManagePackageVersionsCentrally)' == 'true'" />
    <PackageReference Include="ReactiveUI" Condition="'$(ManagePackageVersionsCentrally)' == 'true'" />
  </ItemGroup>
  <Import Project="$(RunicSdkRoot)/eng/build/application.targets" />
  <Import Project="$(RunicSdkRoot)/eng/build/post-mvvm-discovery.targets" />
</Project>
