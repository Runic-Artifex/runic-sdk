<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../../../packages/dotnet/Runic.Application.Views/build/Runic.Application.Views.targets" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <OutputType Condition="'$(RunicBridgeBootstrap)' == 'true'">Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RunicBridgeBuildEnabled>true</RunicBridgeBuildEnabled>
    <RunicBridgeReactiveUiFlavor>reactive</RunicBridgeReactiveUiFlavor>
    <RunicBridgeTypescriptDir>$(BaseIntermediateOutputPath)runic-bridge/typescript</RunicBridgeTypescriptDir>
    <RunicBridgeFrontendDir>$(MSBuildProjectDirectory)</RunicBridgeFrontendDir>
    <RunicBridgeFrontendBuildCommand>dotnet --version</RunicBridgeFrontendBuildCommand>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="SourceGeneratorProgram.cs" />
    <Compile Remove="Program.cs" Condition="'$(RunicBridgeBootstrap)' == 'true'" />
    <PackageReference Include="ReactiveUI.Reactive" />
    <ProjectReference Include="../../../../packages/dotnet/Runic.Application.Views/Runic.Application.Views.csproj" />
    <ProjectReference Include="../../../../packages/dotnet/Runic.Application.Testing/Runic.Application.Testing.csproj" />
    <ProjectReference Include="../../../../packages/dotnet/Runic.Application.Views.ReactiveUI.Reactive/Runic.Application.Views.ReactiveUI.Reactive.csproj" />
  </ItemGroup>
</Project>
