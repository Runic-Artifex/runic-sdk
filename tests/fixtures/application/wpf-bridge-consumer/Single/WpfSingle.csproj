<Project Sdk="Microsoft.NET.Sdk">
  <!-- Built only by ../package-smoke.mjs from the packed packages. The app
       references only Runic.Application.Views.Wpf and sets no RunicBridge property:
       the adapter turns generation on, and the default Frontend folder
       receives the generated client. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <NoWarn>$(NoWarn);RUNICWPF001;RUNICNAV001</NoWarn>
    <!-- The stand-in frontend has no dependencies to install. -->
    <RunicApplicationFrontendInstallEnabled>false</RunicApplicationFrontendInstallEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="$(RunicContainerVersion)" />
    <PackageReference Include="Runic.Application.Views.Wpf" Version="$(RunicPackageVersion)" />
  </ItemGroup>
</Project>
