<Window x:Class="WpfSingle.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:rv="https://runic-artifex.eu/xaml/views"
        xmlns:local="clr-namespace:WpfSingle"
        Title="Editor">
  <!-- A local type makes WPF compile its temporary *_wpftmp assembly. The
       markup compiler resolves rv: through the package's XmlnsDefinition. -->
  <local:EditorHost>
    <rv:RunicViewHost />
  </local:EditorHost>
</Window>
