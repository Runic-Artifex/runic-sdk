<Project Sdk="Microsoft.NET.Sdk">
  <!-- Built only by ../package-smoke.mjs from the packed packages (I-153). A WPF application whose bridged
       ViewModel is a ReactiveObject with a ReactiveCommand, from ReactiveUI.WPF and the Runic ReactiveUI
       adapter. Its local XAML type makes WPF compile the temporary *_wpftmp assembly, which already contains
       the generated Bridge, so the ReactiveUI flavor must be inferred before the markup compile: generated
       with no flavor, the command is RUNICBRIDGE025. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <!-- The stand-in frontend has no dependencies to install. -->
    <RunicApplicationFrontendInstallEnabled>false</RunicApplicationFrontendInstallEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="$(RunicContainerVersion)" />
    <!-- ReactiveUI.WPF brings ReactiveUI's ReactiveUI.Primitives flavor, whose adapter is Runic.Application.Views.ReactiveUI. -->
    <PackageReference Include="ReactiveUI.WPF" Version="$(RunicReactiveUiWpfVersion)" />
    <PackageReference Include="Runic.Application.Views.ReactiveUI" Version="$(RunicPackageVersion)" />
    <PackageReference Include="Runic.Application.Views.Wpf" Version="$(RunicPackageVersion)" />
    <PackageReference Include="Runic.Desktop.Kestrel" Version="$(RunicPackageVersion)" />
  </ItemGroup>
</Project>
