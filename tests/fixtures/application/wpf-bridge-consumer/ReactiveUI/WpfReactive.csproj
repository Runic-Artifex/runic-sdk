<Project Sdk="Microsoft.NET.Sdk">
  <!-- Built only by ../package-smoke.mjs from the packed packages (I-153, #1173). A WPF application with ReactiveUI.WPF
       and the Runic ReactiveUI adapter whose bridged ReactiveObject has a ReactiveCommand. The build infers the
       generator's ReactiveUI flavor from the adapter in the resolved references, and WPF's markup pass (the local
       XAML type makes it compile a *_wpftmp assembly) needs the generated code first; a flavor inferred any later
       leaves the command without its adapter, RUNICBRIDGE025. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <!-- The stand-in frontend has no dependencies to install. -->
    <RunicApplicationFrontendInstallEnabled>false</RunicApplicationFrontendInstallEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="$(RunicContainerVersion)" />
    <PackageReference Include="ReactiveUI.WPF" Version="$(RunicReactiveUiWpfVersion)" />
    <PackageReference Include="Runic.Application.Views.Wpf" Version="$(RunicPackageVersion)" />
    <PackageReference Include="Runic.Application.Views.ReactiveUI" Version="$(RunicPackageVersion)" />
    <PackageReference Include="Runic.Desktop.Kestrel" Version="$(RunicPackageVersion)" />
  </ItemGroup>
</Project>
