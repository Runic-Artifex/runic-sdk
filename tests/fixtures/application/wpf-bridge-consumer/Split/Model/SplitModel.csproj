<Project Sdk="Microsoft.NET.Sdk">
  <!-- A WPF-free model project: the ViewModel and its logical web View. It
       references Runic.Application directly, which turns generation on, and
       builds the shared frontend. The generated client lands in
       <frontend>/src/generated by default. -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <RunicBridgeCompositionType>SplitModel.RunicBridgeComposition</RunicBridgeCompositionType>
    <RunicBridgeFrontendDir>$(MSBuildProjectDirectory)/../Frontend</RunicBridgeFrontendDir>
    <!-- The stand-in frontend has no dependencies to install. -->
    <RunicBridgeInstallFrontend>false</RunicBridgeInstallFrontend>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="$(RunicContainerVersion)" />
    <PackageReference Include="Runic.Application" Version="$(RunicPackageVersion)" />
  </ItemGroup>
</Project>
