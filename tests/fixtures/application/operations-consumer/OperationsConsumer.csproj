<Project Sdk="Microsoft.NET.Sdk">
  <!-- package-smoke.mjs copies this application outside the repository. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <RunicApplicationFrontendCompositionType>OperationsConsumer.RunicBridgeComposition</RunicApplicationFrontendCompositionType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="$(DependencyInjectionVersion)" />
    <PackageReference Include="Runic.Application.Views.Desktop" Version="$(RunicPackageVersion)" />
    <PackageReference Include="Runic.Application.Views.ReactiveUI" Version="$(RunicPackageVersion)" />
    <!-- The shared library is built independently; it has no Runic reference. -->
    <Reference Include="SharedContracts"><HintPath>contracts/SharedContracts.dll</HintPath></Reference>
    <Compile Remove="SharedContracts/**/*.cs" />
    <Compile Remove="OptIn.cs" Condition="'$(EnableJsonIgnoreOptIn)' == 'false'" />
  </ItemGroup>
</Project>
