<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefineConstants>$(DefineConstants);SYSTEM_REACTIVE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="ReactiveUI.Reactive" />
    <ProjectReference Include="../../../../packages/dotnet/Runic.Application.Views/Runic.Application.Views.csproj" />
    <ProjectReference Include="../../../../packages/dotnet/Runic.Application.Testing/Runic.Application.Testing.csproj" />
    <ProjectReference Include="../../../../packages/dotnet/Runic.Application.Views.ReactiveUI.Reactive/Runic.Application.Views.ReactiveUI.Reactive.csproj" />
    <!-- Proves System.Reactive.Unit and Runic.Platform types do not collide when both are imported. -->
    <ProjectReference Include="../../../../packages/dotnet/Runic.Platform/Runic.Platform.csproj" />
  </ItemGroup>
</Project>
