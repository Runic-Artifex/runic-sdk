<Project Sdk="Microsoft.NET.Sdk">
  <!-- The application that the packaging job's flathub leg builds with dotnet runic package flathub and its build option: from a git
       repository of this directory, offline from the sources the command generates from packages.aot.lock.json and
       Frontend/package-lock.json. It opens no window: opened with its URL scheme, it writes a receipt. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ApplicationId>org.runic.tests.FlathubProbe</ApplicationId>
    <ApplicationTitle>Runic Flathub Probe</ApplicationTitle>
    <Version>1.0.0</Version>
    <Description>Checks the Flathub source build of dotnet runic package</Description>
    <PackageProjectUrl>https://github.com/Runic-Artifex/runic-sdk</PackageProjectUrl>
    <RunicApplicationUrlSchemes>runic-flathub-probe</RunicApplicationUrlSchemes>
    <!-- The lock files the Flathub sources come from: the NativeAOT restore has its own, for both Flathub
         architectures. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RuntimeIdentifiers>linux-x64;linux-arm64</RuntimeIdentifiers>
    <NuGetLockFilePath Condition="'$(PublishAot)' == 'true'">packages.aot.lock.json</NuGetLockFilePath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <None Update="www/index.html" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- The frontend's npm dependency, which npm ci installs offline in the Flathub build. -->
    <None Include="Frontend/node_modules/is-number/package.json" Link="www/is-number.json" CopyToPublishDirectory="PreserveNewest"
          Condition="Exists('Frontend/node_modules/is-number/package.json')" />
  </ItemGroup>
  <Target Name="RequireFrontendDependency" BeforeTargets="Build" Condition="'$(PublishAot)' == 'true'">
    <Error Condition="!Exists('Frontend/node_modules/is-number/package.json')" Text="npm ci did not install the frontend's dependency." />
  </Target>
</Project>
