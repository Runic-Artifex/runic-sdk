<Project>
  <Import Project="eng/Versions.props" />
  <!-- Internal post-MVVM fixture ownership is opt-in. Import its path policy
       while this repository-level props file is still early enough for NuGet
       and the compiler to select owner-scoped obj/bin paths. -->
  <Import Project="eng/build/post-mvvm-discovery-owner.props"
          Condition="'$(RunicPostMvvmDiscoveryBuildOwner)' != ''" />
  <PropertyGroup>
    <RunicSdkRoot>$(MSBuildThisFileDirectory)</RunicSdkRoot>
    <RepositoryUrl>https://github.com/Runic-Artifex/runic-sdk</RepositoryUrl>
    <PackageProjectUrl>$(RepositoryUrl)</PackageProjectUrl>
  </PropertyGroup>
</Project>
