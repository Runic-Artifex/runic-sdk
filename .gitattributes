* text=auto
*.cs text eol=lf
*.csproj text eol=lf
*.props text eol=lf
*.targets text eol=lf
*.json text eol=lf
*.md text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
# Generated clients' declaration maps (#952) are committed beside their .d.ts; a CRLF checkout would differ from the
# generator's output.
*.map text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
# The exported-symbol lists (eng/native/symbols.mjs), compared with each OS's library by name.
*.symbols text eol=lf
# Unified diffs preserve upstream whitespace, including context prefixes.
eng/ci/*.patch text eol=lf -whitespace
# Recorded `git diff -U0` output of real commits (eng/ci/plan.test.mjs, diffKind); the gzipped one is binary.
eng/ci/fixtures/diff-kind/*.diff text eol=lf -whitespace
eng/ci/fixtures/diff-kind/*.gz binary
# Pinned upstream protocol files: their SHA-256 is checked, so every checkout keeps upstream's bytes.
packages/dotnet/Runic.Desktop/Internal/Wayland/*.xml -text
.* text eol=lf
*.ps1 text eol=crlf
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
