* text=auto
*.cs text eol=lf
*.csproj text eol=lf
*.props text eol=lf
*.targets text eol=lf
*.json text eol=lf
*.md text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
# Unified diffs preserve upstream whitespace, including context prefixes.
eng/ci/*.patch text eol=lf -whitespace
# Pinned upstream protocol files: their SHA-256 is checked, so every checkout keeps upstream's bytes.
packages/dotnet/Runic.Desktop/Internal/Wayland/*.xml -text
.* text eol=lf
*.ps1 text eol=crlf
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
