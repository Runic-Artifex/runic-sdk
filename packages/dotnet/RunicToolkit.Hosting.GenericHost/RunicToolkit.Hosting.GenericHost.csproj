<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(RunicToolkitDefaultTargetFramework)</TargetFramework>
    <RunicToolkitShippingProject>true</RunicToolkitShippingProject>
    <AssemblyName>RunicToolkit.Hosting.GenericHost</AssemblyName>
    <RootNamespace>RunicToolkit.Hosting</RootNamespace>
    <PackageId>RunicToolkit.Hosting.GenericHost</PackageId>
    <Description>Generic Host and structured logging adapters for RunicToolkit Hosting.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RunicToolkit.Hosting\RunicToolkit.Hosting.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
