<Project>
  <PropertyGroup>
    <_DependencyNoticesArtifactVersionArgument Condition="'$(DependencyNoticesArtifactVersion)' != ''"> --artifact-version &quot;$(DependencyNoticesArtifactVersion)&quot;</_DependencyNoticesArtifactVersionArgument>
    <_DependencyNoticesCommonArguments>--root &quot;$(DependencyNoticesRoot)&quot; --config &quot;$(DependencyNoticesConfig)&quot; --output &quot;$(DependencyNoticesOutputDirectory)&quot; --artifact-name &quot;$(DependencyNoticesArtifactName)&quot;$(_DependencyNoticesArtifactVersionArgument)</_DependencyNoticesCommonArguments>
    <_DependencyNoticesToolArguments Condition="'$(DependencyNoticesMode)' == 'Generate'">generate $(_DependencyNoticesCommonArguments)</_DependencyNoticesToolArguments>
    <_DependencyNoticesToolArguments Condition="'$(DependencyNoticesMode)' == 'Verify'">verify $(_DependencyNoticesCommonArguments)</_DependencyNoticesToolArguments>
  </PropertyGroup>

  <Target Name="_ValidateDependencyNoticesTool"
          Condition="'$(DependencyNoticesEnabled)' == 'true'">
    <Error Condition="'$(DependencyNoticesToolPath)' == ''"
           Text="DependencyNoticesToolPath must explicitly identify the installed dependency-notices executable." />
    <Error Condition="!Exists('$(DependencyNoticesToolPath)')"
           Text="DependencyNoticesToolPath does not identify an existing file: '$(DependencyNoticesToolPath)'." />
    <Error Condition="'$(DependencyNoticesRoot)' == ''"
           Text="DependencyNoticesRoot must identify the deterministic input root." />
    <Error Condition="'$(DependencyNoticesConfig)' == ''"
           Text="DependencyNoticesConfig must identify the configuration path relative to DependencyNoticesRoot." />
    <Error Condition="'$(DependencyNoticesOutputDirectory)' == ''"
           Text="DependencyNoticesOutputDirectory must identify the generated output directory." />
    <Error Condition="'$(DependencyNoticesArtifactName)' == ''"
           Text="DependencyNoticesArtifactName must be non-empty." />
    <Error Condition="'$(_DependencyNoticesToolArguments)' == ''"
           Text="DependencyNoticesMode must be Generate or Verify." />
  </Target>

  <Target Name="RunDependencyNoticesTool"
          Condition="'$(DependencyNoticesEnabled)' == 'true'"
          DependsOnTargets="_ValidateDependencyNoticesTool">
    <Exec Command="&quot;$(DependencyNoticesToolPath)&quot; $(_DependencyNoticesToolArguments)"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          StandardOutputImportance="High"
          StandardErrorImportance="High" />
  </Target>

  <Target Name="GenerateDependencyNotices"
          BeforeTargets="Pack;Publish"
          Condition="'$(DependencyNoticesEnabled)' == 'true' and '$(DependencyNoticesMode)' == 'Generate'"
          DependsOnTargets="RunDependencyNoticesTool" />

  <Target Name="VerifyDependencyNotices"
          BeforeTargets="Pack;Publish"
          Condition="'$(DependencyNoticesEnabled)' == 'true' and '$(DependencyNoticesMode)' == 'Verify'"
          DependsOnTargets="RunDependencyNoticesTool" />

  <Target Name="CollectDependencyNoticeOutputs">
    <ItemGroup>
      <DependencyNoticeCollectedOutput Include="@(DependencyNoticeOutput)"
                                       Condition="Exists('%(DependencyNoticeOutput.Identity)')" />
    </ItemGroup>
  </Target>
</Project>
