<Project>
  <!-- The old-name guards (D079.11) of the SDK's packages, which Runic.Application.Views ships too; one of the copies is
       imported. -->
  <Import Project="$(MSBuildThisFileDirectory)Runic.Sdk.RenamedNames.targets" Condition="'$(_RunicSdkRenamedNamesImported)' != 'true'" />
  <!-- The presentation server (X2): Runic.Desktop has none of its own. The project references Runic.Desktop.Kestrel
       (ASP.NET Core Kestrel) or the experimental Runic.Desktop.NativeServer, whose props set the Referenced properties.
       With both, the native server serves unless RunicDesktopServer is Kestrel. None declares an executable that opens
       no Runic Desktop window, such as a tool that only uses Runic Desktop's types. -->
  <PropertyGroup>
    <!-- The server packages of 0.20 and earlier set the markers without the underscore; read them through 0.21. -->
    <_RunicDesktopNativeServerReferenced Condition="'$(_RunicDesktopNativeServerReferenced)' == '' and '$(RunicDesktopNativeServerReferenced)' == 'true'">true</_RunicDesktopNativeServerReferenced>
    <_RunicDesktopKestrelReferenced Condition="'$(_RunicDesktopKestrelReferenced)' == '' and '$(RunicDesktopKestrelReferenced)' == 'true'">true</_RunicDesktopKestrelReferenced>
    <RunicDesktopServer Condition="'$(RunicDesktopServer)' == '' and '$(_RunicDesktopNativeServerReferenced)' == 'true'">Native</RunicDesktopServer>
    <RunicDesktopServer Condition="'$(RunicDesktopServer)' == '' and '$(_RunicDesktopKestrelReferenced)' == 'true'">Kestrel</RunicDesktopServer>
    <_RunicDesktopNativeServer Condition="'$(RunicDesktopServer)' == 'Native'">true</_RunicDesktopNativeServer>
  </PropertyGroup>
  <ItemGroup>
    <!-- A trimming feature switch: a trimmed or NativeAOT application keeps one server and drops the other. -->
    <RuntimeHostConfigurationOption Include="Runic.Desktop.NativeServer" Value="true" Trim="true" Condition="'$(RunicDesktopServer)' == 'Native'" />
    <RuntimeHostConfigurationOption Include="Runic.Desktop.NativeServer" Value="false" Trim="true" Condition="'$(RunicDesktopServer)' == 'Kestrel'" />
    <!-- None: no server at all, also when a server package is referenced (a window fails with
         presentation-server-unavailable, as without one). The executable's declaration, so it applies to every build. -->
    <RuntimeHostConfigurationOption Include="Runic.Desktop.PresentationServer" Value="false" Trim="true" Condition="'$(RunicDesktopServer)' == 'None'" />
  </ItemGroup>
  <!-- The application icon of a window without IconFile on macOS outside a bundle with an icon (sdk#1207): the package
       icon (RunicPackageIcon, else icons/icon.png) beside the executable, named in runtimeconfig.json. Windows uses the
       executable's own icon resource, which Runic.Platform's targets generate (ApplicationIcon), and a bundle its
       CFBundleIconFile, so only builds that can run on macOS carry the file. RunicApplicationIconGenerationEnabled=false
       leaves it out. -->
  <PropertyGroup>
    <_RunicDesktopApplicationIcon Condition="'$(RunicApplicationIconGenerationEnabled)' != 'false' and ('$(OutputType)' == 'Exe' or '$(OutputType)' == 'WinExe') and '$(IsTestProject)' != 'true' and ('$(RuntimeIdentifier)' == '' or $(RuntimeIdentifier.StartsWith('osx')))">$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$([MSBuild]::ValueOrDefault('$(RunicPackageIcon)', 'icons/icon.png'))'))</_RunicDesktopApplicationIcon>
    <_RunicDesktopApplicationIcon Condition="'$(_RunicDesktopApplicationIcon)' != '' and !Exists('$(_RunicDesktopApplicationIcon)')"></_RunicDesktopApplicationIcon>
  </PropertyGroup>
  <ItemGroup Condition="'$(_RunicDesktopApplicationIcon)' != ''">
    <None Include="$(_RunicDesktopApplicationIcon)" Link="runic-application-icon.png" Visible="false"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <RuntimeHostConfigurationOption Include="Runic.Desktop.ApplicationIcon" Value="runic-application-icon.png" />
  </ItemGroup>
  <!-- A CS-WebUI window's Development DevTools Protocol endpoint (WebUiRemoteDebugging, D070.7) is for untrimmed
       development builds such as dotnet runic dev's: a trimmed or NativeAOT publish turns it off, so the trimmer removes
       it and its HTTP client. Only the publish: PrepareForILLink runs before ILLink and before ILC writes its options,
       never in a build, so a project that sets PublishAot or PublishTrimmed keeps the endpoint in its builds and in
       their runtimeconfig.json. -->
  <Target Name="_RunicDesktopPublishFeatureSwitches" BeforeTargets="PrepareForILLink">
    <ItemGroup>
      <RuntimeHostConfigurationOption Include="Runic.Desktop.WebUiRemoteDebugging" Value="false" Trim="true" />
    </ItemGroup>
  </Target>
  <Target Name="_RunicDesktopValidateServer" BeforeTargets="PrepareForBuild">
    <Error Code="RUNICDESK003" File="$(MSBuildProjectFullPath)" HelpLink="$(_RunicDiagnosticsHelpLinkBase)runicdesk003"
           Condition="'$(RunicDesktopServer)' != '' and '$(RunicDesktopServer)' != 'Native' and '$(RunicDesktopServer)' != 'Kestrel' and '$(RunicDesktopServer)' != 'None'"
           Text="RunicDesktopServer is '$(RunicDesktopServer)'; it must be Native, Kestrel or None." />
    <!-- Every Runic Desktop window is served; an executable without a server would fail at its first window. -->
    <Error Code="RUNICDESK004" File="$(MSBuildProjectFullPath)" HelpLink="$(_RunicDiagnosticsHelpLinkBase)runicdesk004"
           Condition="'$(RunicDesktopServer)' == '' and ('$(OutputType)' == 'Exe' or '$(OutputType)' == 'WinExe') and '$(IsTestProject)' != 'true'"
           Text="Runic Desktop has no presentation server since 0.15. Add a PackageReference to Runic.Desktop.NativeServer (the native server, without ASP.NET Core; new applications use it) or to Runic.Desktop.Kestrel (ASP.NET Core Kestrel, the server of 0.14), or set RunicDesktopServer to None if the executable opens no Runic Desktop window." />
    <Error Code="RUNICDESK004" File="$(MSBuildProjectFullPath)" HelpLink="$(_RunicDiagnosticsHelpLinkBase)runicdesk004"
           Condition="'$(RunicDesktopServer)' == 'Kestrel' and '$(_RunicDesktopKestrelReferenced)' != 'true'"
           Text="RunicDesktopServer is Kestrel, but the project does not reference Runic.Desktop.Kestrel." />
    <Error Code="RUNICDESK004" File="$(MSBuildProjectFullPath)" HelpLink="$(_RunicDiagnosticsHelpLinkBase)runicdesk004"
           Condition="'$(RunicDesktopServer)' == 'Native' and '$(_RunicDesktopNativeServerReferenced)' != 'true'"
           Text="RunicDesktopServer is Native, but the project does not reference Runic.Desktop.NativeServer." />
    <!-- None keeps neither server (Runic.Desktop.PresentationServer=false), so a referenced server package is unused. -->
    <Warning Code="RUNICDESK007" File="$(MSBuildProjectFullPath)" HelpLink="$(_RunicDiagnosticsHelpLinkBase)runicdesk007"
             Condition="'$(RunicDesktopServer)' == 'None' and ('$(_RunicDesktopKestrelReferenced)' == 'true' or '$(_RunicDesktopNativeServerReferenced)' == 'true')"
             Text="RunicDesktopServer is None, but the project references a presentation server package (Runic.Desktop.Kestrel or Runic.Desktop.NativeServer). None uses no server: the package is unused, and a Runic Desktop window would fail with presentation-server-unavailable. Remove RunicDesktopServer to use the referenced server, or remove the package." />
  </Target>
  <Target Name="RunicDesktopLinkWebView2Loader" AfterTargets="ResolvePackageAssets"
          Condition="'$(PublishAot)' == 'true' and ('$(RuntimeIdentifier)' == 'win-x64' or '$(RuntimeIdentifier)' == 'win-arm64')">
    <ItemGroup>
      <_RunicWebView2Loader Include="@(NativeCopyLocalItems)"
          Condition="'%(NativeCopyLocalItems.NuGetPackageId)' == 'Microsoft.Web.WebView2' and '%(NativeCopyLocalItems.Filename)%(NativeCopyLocalItems.Extension)' == 'WebView2Loader.dll'" />
      <!-- Resolve from the actual restored native asset, including transitive
           package consumers and nondefault NuGet cache locations. -->
      <_RunicWebView2Static Include="@(_RunicWebView2Loader->'%(RootDir)%(Directory)../../../build/native/$(RuntimeIdentifier.Substring(4))/WebView2LoaderStatic.lib')" />
      <DirectPInvoke Include="WebView2Loader" Condition="'@(_RunicWebView2Static)' != ''" />
      <NativeLibrary Include="@(_RunicWebView2Static)" />
    </ItemGroup>
    <Error Code="RUNICDESK002" File="$(MSBuildProjectFullPath)" HelpLink="$(_RunicDiagnosticsHelpLinkBase)runicdesk002"
           Condition="'@(_RunicWebView2Static)' != '' and !Exists('%(_RunicWebView2Static.Identity)')"
           Text="Runic Desktop could not find the restored WebView2 static loader: %(_RunicWebView2Static.Identity). Restore the Microsoft.Web.WebView2 native SDK assets before publishing." />
  </Target>
  <Target Name="RunicDesktopRemoveLinkedWebView2Loader" AfterTargets="ComputeFilesToPublish"
          Condition="'@(_RunicWebView2Static)' != ''">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
          Condition="'%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' == 'WebView2Loader.dll'" />
    </ItemGroup>
  </Target>
</Project>
