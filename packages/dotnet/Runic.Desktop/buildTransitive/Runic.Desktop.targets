<Project>
  <!-- The presentation server (X2): Runic.Desktop has none of its own. The project references Runic.Desktop.Kestrel
       (ASP.NET Core Kestrel) or the experimental Runic.Desktop.NativeServer, whose props set the Referenced properties.
       With both, the native server serves unless RunicDesktopServer is Kestrel. None declares an executable that opens
       no Runic Desktop window, such as a tool that only uses Runic Desktop's types. -->
  <PropertyGroup>
    <RunicDesktopServer Condition="'$(RunicDesktopServer)' == '' and '$(RunicDesktopNativeServerReferenced)' == 'true'">Native</RunicDesktopServer>
    <RunicDesktopServer Condition="'$(RunicDesktopServer)' == '' and '$(RunicDesktopKestrelReferenced)' == 'true'">Kestrel</RunicDesktopServer>
    <_RunicDesktopNativeServer Condition="'$(RunicDesktopServer)' == 'Native'">true</_RunicDesktopNativeServer>
  </PropertyGroup>
  <ItemGroup>
    <!-- A trimming feature switch: a trimmed or NativeAOT application keeps one server and drops the other. -->
    <RuntimeHostConfigurationOption Include="Runic.Desktop.NativeServer" Value="true" Trim="true" Condition="'$(RunicDesktopServer)' == 'Native'" />
    <RuntimeHostConfigurationOption Include="Runic.Desktop.NativeServer" Value="false" Trim="true" Condition="'$(RunicDesktopServer)' == 'Kestrel'" />
  </ItemGroup>
  <Target Name="RunicDesktopValidateServer" BeforeTargets="PrepareForBuild">
    <Error Code="RUNICDESK003" File="$(MSBuildProjectFullPath)" HelpLink="$(_RunicDiagnosticsHelpLinkBase)runicdesk003"
           Condition="'$(RunicDesktopServer)' != '' and '$(RunicDesktopServer)' != 'Native' and '$(RunicDesktopServer)' != 'Kestrel' and '$(RunicDesktopServer)' != 'None'"
           Text="RunicDesktopServer is '$(RunicDesktopServer)'; it must be Native, Kestrel or None." />
    <!-- Every Runic Desktop window is served; an executable without a server would fail at its first window. -->
    <Error Code="RUNICDESK004" File="$(MSBuildProjectFullPath)" HelpLink="$(_RunicDiagnosticsHelpLinkBase)runicdesk004"
           Condition="'$(RunicDesktopServer)' == '' and ('$(OutputType)' == 'Exe' or '$(OutputType)' == 'WinExe') and '$(IsTestProject)' != 'true'"
           Text="Runic Desktop has no presentation server since 0.15. Add a PackageReference to Runic.Desktop.NativeServer (the native server, without ASP.NET Core; new applications use it) or to Runic.Desktop.Kestrel (ASP.NET Core Kestrel, the server of 0.14), or set RunicDesktopServer to None if the executable opens no Runic Desktop window." />
    <Error Code="RUNICDESK004" File="$(MSBuildProjectFullPath)" HelpLink="$(_RunicDiagnosticsHelpLinkBase)runicdesk004"
           Condition="'$(RunicDesktopServer)' == 'Kestrel' and '$(RunicDesktopKestrelReferenced)' != 'true'"
           Text="RunicDesktopServer is Kestrel, but the project does not reference Runic.Desktop.Kestrel." />
    <Error Code="RUNICDESK004" File="$(MSBuildProjectFullPath)" HelpLink="$(_RunicDiagnosticsHelpLinkBase)runicdesk004"
           Condition="'$(RunicDesktopServer)' == 'Native' and '$(RunicDesktopNativeServerReferenced)' != 'true'"
           Text="RunicDesktopServer is Native, but the project does not reference Runic.Desktop.NativeServer." />
  </Target>
  <Target Name="RunicDesktopLinkWebView2Loader" AfterTargets="ResolvePackageAssets"
          Condition="'$(PublishAot)' == 'true' and ('$(RuntimeIdentifier)' == 'win-x64' or '$(RuntimeIdentifier)' == 'win-arm64')">
    <ItemGroup>
      <_RunicWebView2Loader Include="@(NativeCopyLocalItems)"
          Condition="'%(NativeCopyLocalItems.NuGetPackageId)' == 'Microsoft.Web.WebView2' and '%(NativeCopyLocalItems.Filename)%(NativeCopyLocalItems.Extension)' == 'WebView2Loader.dll'" />
      <!-- Resolve from the actual restored native asset, including transitive
           package consumers and nondefault NuGet cache locations. -->
      <_RunicWebView2Static Include="@(_RunicWebView2Loader->'%(RootDir)%(Directory)../../../build/native/$(RuntimeIdentifier.Substring(4))/WebView2LoaderStatic.lib')" />
      <DirectPInvoke Include="WebView2Loader" Condition="'@(_RunicWebView2Static)' != ''" />
      <NativeLibrary Include="@(_RunicWebView2Static)" />
    </ItemGroup>
    <Error Code="RUNICDESK002" File="$(MSBuildProjectFullPath)" HelpLink="$(_RunicDiagnosticsHelpLinkBase)runicdesk002"
           Condition="'@(_RunicWebView2Static)' != '' and !Exists('%(_RunicWebView2Static.Identity)')"
           Text="Runic Desktop could not find the restored WebView2 static loader: %(_RunicWebView2Static.Identity). Restore the Microsoft.Web.WebView2 native SDK assets before publishing." />
  </Target>
  <Target Name="RunicDesktopRemoveLinkedWebView2Loader" AfterTargets="ComputeFilesToPublish"
          Condition="'@(_RunicWebView2Static)' != ''">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
          Condition="'%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' == 'WebView2Loader.dll'" />
    </ItemGroup>
  </Target>
</Project>
