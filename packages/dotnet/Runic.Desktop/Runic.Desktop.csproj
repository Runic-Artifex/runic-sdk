<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Runic.Desktop</AssemblyName>
    <RootNamespace>Runic.Desktop</RootNamespace>
    <PackageId>Runic.Desktop</PackageId>
    <Title>Runic Desktop</Title>
    <Description>A managed .NET runtime for web-powered desktop applications.</Description>
    <PackageTags>runic-artifex;dotnet;managed;kestrel;desktop;webview</PackageTags>
    <NoWarn>$(NoWarn);CA1720</NoWarn>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" PrivateAssets="contentfiles;analyzers" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <InternalsVisibleTo Include="Runic.Desktop.Tests" />
    <None Include="$(MSBuildThisFileDirectory)..\..\README.md" Pack="true" PackagePath="" />
    <None Include="$(MSBuildThisFileDirectory)..\..\NOTICE" Pack="true" PackagePath="" />
    <None Include="$(MSBuildThisFileDirectory)..\..\eng\licenses\WebUI-LICENSE.txt" Pack="true" PackagePath="licenses/WebUI/" />
    <None Include="buildTransitive\Runic.Desktop.targets" Pack="true" PackagePath="buildTransitive\Runic.Desktop.targets" />
  </ItemGroup>

</Project>
