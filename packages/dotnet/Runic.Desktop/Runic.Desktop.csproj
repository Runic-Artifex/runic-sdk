<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../../eng/build/desktop.props" />
  <PropertyGroup>
    <AssemblyName>Runic.Desktop</AssemblyName>
    <RootNamespace>Runic.Desktop</RootNamespace>
    <PackageId>Runic.Desktop</PackageId>
    <Title>Runic Desktop</Title>
    <Description>A managed .NET runtime for web-powered desktop applications.</Description>
    <PackageTags>runic-artifex;dotnet;managed;kestrel;desktop;webview</PackageTags>
    <NoWarn>$(NoWarn);CA1720</NoWarn>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Keep the WebView2 compile surface private while allowing its build
         targets to carry the Core assembly and loader to clean consumers.
         Runic.Desktop's own transitive target removes the SDK's WPF/WinForms
         references when the application does not use them. -->
    <PackageReference Include="Microsoft.Web.WebView2" PrivateAssets="compile;contentfiles;analyzers" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <InternalsVisibleTo Include="Runic.Desktop.Tests" />
    <None Include="pack/README.md" Pack="true" PackagePath="" />
    <None Include="NOTICE" Pack="true" PackagePath="" />
    <None Include="licenses/WebUI-LICENSE.txt" Pack="true" PackagePath="licenses/WebUI/" />
    <None Include="buildTransitive\Runic.Desktop.targets" Pack="true" PackagePath="buildTransitive\Runic.Desktop.targets" />
  </ItemGroup>

</Project>
