<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../../eng/build/desktop.props" />
  <PropertyGroup>
    <AssemblyName>Runic.Desktop</AssemblyName>
    <RootNamespace>Runic.Desktop</RootNamespace>
    <PackageId>Runic.Desktop</PackageId>
    <Title>Runic Desktop</Title>
    <Description>A managed .NET runtime for web-powered desktop applications.</Description>
    <PackageTags>runic-artifex;dotnet;managed;desktop;webview</PackageTags>
    <NoWarn>$(NoWarn);CA1720</NoWarn>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <!-- Packs buildTransitive/$(PackageId).props with the diagnostics help links (eng/build/release-links.targets). -->
    <RunicPackDiagnosticsHelpLinks>true</RunicPackDiagnosticsHelpLinks>
    <RunicGenerateReleaseLinks>true</RunicGenerateReleaseLinks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Use the native loader with our AOT-compatible COM binding. The SDK's
         managed wrappers and build targets must not enter consumer builds. -->
    <PackageReference Include="Microsoft.Web.WebView2" IncludeAssets="native" />
    <!-- No ASP.NET Core (X2): the application references a server package, Runic.Desktop.Kestrel or the experimental
         Runic.Desktop.NativeServer. The server-neutral code uses the dependency injection and logging abstractions. The
         native server builds its own service provider; the container and logging implementation come with the server
         package (ASP.NET Core's shared framework, or Runic.Desktop.NativeServer's dependencies), so an application
         that only references Runic.Desktop chooses its own container, as with the Views host adapters. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Logging" PrivateAssets="all" />
    <!-- The menu model (DesktopMenu, DesktopMenuItem, DesktopShortcut) is shared with status icons (D031.2). -->
    <ProjectReference Include="../Runic.Platform/Runic.Platform.csproj" />
    <!-- The Linux global menu exports the window's bar over com.canonical.dbusmenu on the session bus (D036.11). -->
    <ProjectReference Include="../Runic.Platform.Linux.DBus/Runic.Platform.Linux.DBus.csproj" />
    <InternalsVisibleTo Include="Runic.Desktop.Tests" />
    <!-- Runic.Desktop.Kestrel implements the internal presentation server seam; packing pins the exact version. -->
    <InternalsVisibleTo Include="Runic.Desktop.Kestrel" />
    <!-- The Bridge of Runic Windows and Views runs over the internal presentation transport: capabilities, scripts in
         every session and the connection identity (D029.2). The exact-version package reference keeps the two in step. -->
    <InternalsVisibleTo Include="Runic.Application.Views.Desktop" />
    <InternalsVisibleTo Include="Runic.Application.Views.Desktop.Tests" />
    <!-- The native smokes drive pages through the transport. -->
    <InternalsVisibleTo Include="Runic.Desktop.WebViewSmoke" />
    <!-- The macOS native tests report how the event loop served the main thread (MacOsApplication). -->
    <InternalsVisibleTo Include="Runic.Platform.Runtime.Tests" />
    <InternalsVisibleTo Include="Runic.Desktop.Gtk4.Smoke" />
    <EmbeddedResource Include="Internal/WebKitGtkKeyboard.js" LogicalName="Runic.Desktop.WebKitGtkKeyboard.js" />
    <EmbeddedResource Include="Internal/MacOsWindowChrome.js" LogicalName="Runic.Desktop.MacOsWindowChrome.js" />
    <!-- The optional WPF presentation reuses our native WebView2 controller. -->
    <InternalsVisibleTo Include="Runic.Application.Views.Wpf" />
    <InternalsVisibleTo Include="Runic.Application.Views.Wpf.Tests" />
    <InternalsVisibleTo Include="Runic.Application.Views.Wpf.Windows.Tests" />
    <None Include="pack/README.md" Pack="true" PackagePath="" />
    <None Include="NOTICE" Pack="true" PackagePath="" />
    <None Include="licenses/WebUI-LICENSE.txt" Pack="true" PackagePath="licenses/WebUI/" />
    <None Include="buildTransitive\Runic.Desktop.targets" Pack="true" PackagePath="buildTransitive\Runic.Desktop.targets" />
  </ItemGroup>

</Project>
