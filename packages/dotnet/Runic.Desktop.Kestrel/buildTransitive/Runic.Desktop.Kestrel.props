<Project>
  <!-- The help links of RUNICDESK001 at this package's release tag, generated when it was packed. -->
  <Import Project="$(MSBuildThisFileDirectory)Runic.Desktop.Kestrel.HelpLinks.props" Condition="Exists('$(MSBuildThisFileDirectory)Runic.Desktop.Kestrel.HelpLinks.props')" />
  <PropertyGroup>
    <!-- Runic.Desktop's targets choose the presentation server from the server packages the project references. -->
    <RunicDesktopKestrelReferenced>true</RunicDesktopKestrelReferenced>
  </PropertyGroup>
</Project>
