<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../../eng/build/application.props" />
  <PropertyGroup>
    <TargetFramework>$(RunicToolkitDefaultTargetFramework)</TargetFramework>
    <RunicToolkitShippingProject>true</RunicToolkitShippingProject>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>Runic.Platform.Linux</PackageId>
    <Description>Owned GTK file dialogs and text clipboard for Runic applications on Linux.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Runic.Platform.Runtime/Runic.Platform.Runtime.csproj" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <Import Project="../../../eng/build/application.targets" />
</Project>
