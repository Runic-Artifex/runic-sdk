<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(RunicToolkitDefaultTargetFramework)</TargetFramework>
    <RunicToolkitShippingProject>true</RunicToolkitShippingProject>
    <AssemblyName>RunicToolkit.Desktop</AssemblyName>
    <RootNamespace>RunicToolkit.Desktop</RootNamespace>
    <PackageId>RunicToolkit.Desktop</PackageId>
    <Version>1.0.0-beta.1</Version>
    <Description>Frontend-neutral desktop capability contracts for testable RunicToolkit ViewModels.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="PUBLIC-API.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
