<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(RunicToolkitDefaultTargetFramework)</TargetFramework>
    <RunicToolkitShippingProject>true</RunicToolkitShippingProject>
    <AssemblyName>RunicToolkit.Hosting.WebUi</AssemblyName>
    <RootNamespace>RunicToolkit.Hosting.WebUi</RootNamespace>
    <PackageId>RunicToolkit.Hosting.WebUi</PackageId>
    <Description>Framework-neutral browser, root-session, and static-asset composition for RunicToolkit Hosting.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RunicToolkit.Hosting\RunicToolkit.Hosting.csproj" />
    <ProjectReference Include="..\RunicToolkit.MVVM\RunicToolkit.MVVM.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
