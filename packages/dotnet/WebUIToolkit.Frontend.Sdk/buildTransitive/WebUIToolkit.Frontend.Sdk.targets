<Project>
  <PropertyGroup>
    <WebUIToolkitFrontendOutputDirectory
      Condition="'$(WebUIToolkitFrontendOutputDirectory)' == '' and '$(WebUIToolkitFrontendNodeEnabled)' == 'true'">$(WebUIToolkitFrontendPackageDirectory)/dist</WebUIToolkitFrontendOutputDirectory>
    <WebUIToolkitFrontendViteConfiguration
      Condition="'$(WebUIToolkitFrontendViteConfiguration)' == '' and Exists('$(WebUIToolkitFrontendPackageDirectory)/vite.config.mjs')">$(WebUIToolkitFrontendPackageDirectory)/vite.config.mjs</WebUIToolkitFrontendViteConfiguration>
    <WebUIToolkitFrontendViteConfiguration
      Condition="'$(WebUIToolkitFrontendViteConfiguration)' == '' and Exists('$(WebUIToolkitFrontendPackageDirectory)/vite.config.js')">$(WebUIToolkitFrontendPackageDirectory)/vite.config.js</WebUIToolkitFrontendViteConfiguration>
    <WebUIToolkitFrontendViteConfiguration
      Condition="'$(WebUIToolkitFrontendViteConfiguration)' == '' and Exists('$(WebUIToolkitFrontendPackageDirectory)/vite.config.ts')">$(WebUIToolkitFrontendPackageDirectory)/vite.config.ts</WebUIToolkitFrontendViteConfiguration>
    <WebUIToolkitFrontendViteConfiguration
      Condition="'$(WebUIToolkitFrontendViteConfiguration)' == '' and Exists('$(WebUIToolkitFrontendPackageDirectory)/vite.config.mts')">$(WebUIToolkitFrontendPackageDirectory)/vite.config.mts</WebUIToolkitFrontendViteConfiguration>
    <WebUIToolkitFrontendViteConfiguration
      Condition="'$(WebUIToolkitFrontendViteConfiguration)' == '' and Exists('$(WebUIToolkitFrontendPackageDirectory)/vite.config.cjs')">$(WebUIToolkitFrontendPackageDirectory)/vite.config.cjs</WebUIToolkitFrontendViteConfiguration>
  </PropertyGroup>

  <Target Name="WebUIToolkitFrontendValidate"
          BeforeTargets="PrepareForBuild"
          Condition="'$(WebUIToolkitFrontendEnabled)' == 'true'">
    <Error Condition="'$(WebUIToolkitFrontendNodeEnabled)' != 'true' and
                      '$(WebUIToolkitFrontendCwhtmlEnabled)' != 'true'"
           Text="Enable at least one WebUIToolkit frontend pipeline: Node/Vite or cwhtml." />
    <Error Condition="'$(WebUIToolkitFrontendNodeEnabled)' == 'true' and
                      '$(WebUIToolkitFrontendWorkspace)' == ''"
           Text="WebUIToolkitFrontendWorkspace is required." />
    <Error Condition="'$(WebUIToolkitFrontendNodeEnabled)' == 'true' and
                      '$(WebUIToolkitFrontendPackageDirectory)' == ''"
           Text="WebUIToolkitFrontendPackageDirectory is required." />
    <Error Condition="'$(WebUIToolkitFrontendContractSource)' != '' and
                      ('$(WebUIToolkitFrontendContractCSharpOutput)' == '' or
                       '$(WebUIToolkitFrontendContractTypeScriptOutput)' == '')"
           Text="Both frontend contract output paths are required when a contract source is configured." />
  </Target>

  <Target Name="WebUIToolkitFrontendGenerateContracts"
          DependsOnTargets="WebUIToolkitFrontendValidate"
          Condition="'$(WebUIToolkitFrontendEnabled)' == 'true' and
                     '$(WebUIToolkitFrontendNodeEnabled)' == 'true' and
                     '$(WebUIToolkitFrontendContractSource)' != ''">
    <Exec Command="node &quot;$(WebUIToolkitFrontendContractTool)&quot; --source &quot;$(WebUIToolkitFrontendContractSource)&quot; --csharp &quot;$(WebUIToolkitFrontendContractCSharpOutput)&quot; --typescript &quot;$(WebUIToolkitFrontendContractTypeScriptOutput)&quot;"
          WorkingDirectory="$(WebUIToolkitFrontendWorkspaceRoot)" />
  </Target>

  <Target Name="WebUIToolkitFrontendInstall"
          DependsOnTargets="WebUIToolkitFrontendValidate"
          Condition="'$(WebUIToolkitFrontendEnabled)' == 'true' and
                     '$(WebUIToolkitFrontendNodeEnabled)' == 'true' and
                     '$(WebUIToolkitFrontendInstall)' == 'true' and
                     !Exists('$(WebUIToolkitFrontendWorkspaceRoot)/node_modules/.package-lock.json')">
    <Exec Command="npm ci"
          WorkingDirectory="$(WebUIToolkitFrontendWorkspaceRoot)" />
  </Target>

  <Target Name="WebUIToolkitFrontendBuild"
          BeforeTargets="PrepareForBuild"
          DependsOnTargets="WebUIToolkitFrontendInstall"
          Condition="'$(WebUIToolkitFrontendEnabled)' == 'true' and
                     '$(WebUIToolkitFrontendNodeEnabled)' == 'true'">
    <Exec Command="$(WebUIToolkitFrontendContractVerifyCommand)"
          WorkingDirectory="$(WebUIToolkitFrontendWorkspaceRoot)"
          Condition="'$(WebUIToolkitFrontendContractVerifyCommand)' != ''" />
    <Exec Command="npm run build --workspace $(WebUIToolkitFrontendWorkspace) $(WebUIToolkitFrontendBuildArguments)"
          WorkingDirectory="$(WebUIToolkitFrontendWorkspaceRoot)" />
    <ItemGroup>
      <Content Include="$(WebUIToolkitFrontendBridgeAsset)"
               Link="$(WebUIToolkitFrontendWebRoot)/vendor/webuitoolkit-mvvm-cswebui.mjs"
               CopyToOutputDirectory="PreserveNewest"
               CopyToPublishDirectory="PreserveNewest"
               Condition="Exists('$(WebUIToolkitFrontendBridgeAsset)')" />
    </ItemGroup>
  </Target>

  <Target Name="WebUIToolkitFrontendCopyToOutput"
          AfterTargets="Build"
          DependsOnTargets="WebUIToolkitFrontendBuild"
          Condition="'$(WebUIToolkitFrontendEnabled)' == 'true' and
                     '$(WebUIToolkitFrontendNodeEnabled)' == 'true'">
    <RemoveDir Directories="$(TargetDir)$(WebUIToolkitFrontendWebRoot)/assets;
                            $(TargetDir)$(WebUIToolkitFrontendWebRoot)/simple;
                            $(TargetDir)$(WebUIToolkitFrontendWebRoot)/advanced" />
    <ItemGroup>
      <_WebUIToolkitFrontendOutput Include="$(WebUIToolkitFrontendOutputDirectory)/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(_WebUIToolkitFrontendOutput)"
          DestinationFiles="@(_WebUIToolkitFrontendOutput->'$(TargetDir)$(WebUIToolkitFrontendWebRoot)/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="WebUIToolkitFrontendCopyToPublish"
          AfterTargets="Publish"
          DependsOnTargets="WebUIToolkitFrontendBuild"
          Condition="'$(WebUIToolkitFrontendEnabled)' == 'true' and
                     '$(WebUIToolkitFrontendNodeEnabled)' == 'true'">
    <RemoveDir Directories="$(PublishDir)$(WebUIToolkitFrontendWebRoot)/assets;
                            $(PublishDir)$(WebUIToolkitFrontendWebRoot)/simple;
                            $(PublishDir)$(WebUIToolkitFrontendWebRoot)/advanced" />
    <ItemGroup>
      <_WebUIToolkitFrontendPublish Include="$(WebUIToolkitFrontendOutputDirectory)/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(_WebUIToolkitFrontendPublish)"
          DestinationFiles="@(_WebUIToolkitFrontendPublish->'$(PublishDir)$(WebUIToolkitFrontendWebRoot)/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="WebUIToolkitFrontendCompileCwhtml"
          BeforeTargets="PrepareForBuild"
          DependsOnTargets="CompileCwhtmlTemplates"
          Condition="'$(WebUIToolkitFrontendEnabled)' == 'true' and
                     '$(WebUIToolkitFrontendCwhtmlEnabled)' == 'true'" />

  <Target Name="WebUIToolkitFrontendWatchAssets"
          DependsOnTargets="WebUIToolkitFrontendInstall"
          Condition="'$(WebUIToolkitFrontendEnabled)' == 'true' and
                     '$(WebUIToolkitFrontendNodeEnabled)' == 'true'">
    <Exec Command="npm run dev --workspace $(WebUIToolkitFrontendWorkspace)"
          WorkingDirectory="$(WebUIToolkitFrontendWorkspaceRoot)" />
  </Target>

  <Target Name="WebUIToolkitFrontendWatch"
          DependsOnTargets="WebUIToolkitFrontendValidate"
          Condition="'$(WebUIToolkitFrontendEnabled)' == 'true'">
    <Exec Command="&quot;$(DotNetHostPath)&quot; watch --project &quot;$(WebUIToolkitDevProject)&quot; run --no-launch-profile -- $(WebUIToolkitDevRunArguments)"
          Condition="'$(DotNetHostPath)' != ''" />
    <Exec Command="dotnet watch --project &quot;$(WebUIToolkitDevProject)&quot; run --no-launch-profile -- $(WebUIToolkitDevRunArguments)"
          Condition="'$(DotNetHostPath)' == ''" />
  </Target>
</Project>
