<Project>
  <PropertyGroup>
    <WebUIToolkitFrontendContractArtifact
      Condition="'$(WebUIToolkitFrontendContractArtifact)' == ''">$([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'webuitoolkit.frontend.json'))</WebUIToolkitFrontendContractArtifact>
    <WebUIToolkitFrontendContractSource
      Condition="'$(WebUIToolkitFrontendContractCSharpFirst)' == 'true'">$(WebUIToolkitFrontendContractArtifact)</WebUIToolkitFrontendContractSource>
    <!-- Package buildTransitive props are imported before consumer project properties.
         Compose commands here so project-declared workspace and contract paths are visible. -->
    <WebUIToolkitFrontendBuildCommand
      Condition="'$(WebUIToolkitFrontendBuildCommand)' == ''">npm run build --workspace $(WebUIToolkitFrontendWorkspace) $(WebUIToolkitFrontendBuildArguments)</WebUIToolkitFrontendBuildCommand>
    <WebUIToolkitFrontendDevServerKind
      Condition="'$(WebUIToolkitFrontendDevServerKind)' == '' and
                 '$(WebUIToolkitFrontendViteDevServerEnabled)' == 'true'">vite</WebUIToolkitFrontendDevServerKind>
    <WebUIToolkitFrontendContractReactArgument
      Condition="'$(WebUIToolkitFrontendContractReactOutput)' != ''"> --react &quot;$(WebUIToolkitFrontendContractReactOutput)&quot;</WebUIToolkitFrontendContractReactArgument>
    <WebUIToolkitFrontendContractVueArgument
      Condition="'$(WebUIToolkitFrontendContractVueOutput)' != ''"> --vue &quot;$(WebUIToolkitFrontendContractVueOutput)&quot;</WebUIToolkitFrontendContractVueArgument>
    <WebUIToolkitFrontendContractSvelteArgument
      Condition="'$(WebUIToolkitFrontendContractSvelteOutput)' != ''"> --svelte &quot;$(WebUIToolkitFrontendContractSvelteOutput)&quot;</WebUIToolkitFrontendContractSvelteArgument>
    <WebUIToolkitFrontendContractAngularArgument
      Condition="'$(WebUIToolkitFrontendContractAngularOutput)' != ''"> --angular &quot;$(WebUIToolkitFrontendContractAngularOutput)&quot;</WebUIToolkitFrontendContractAngularArgument>
    <WebUIToolkitFrontendContractFrameworkArguments>$(WebUIToolkitFrontendContractReactArgument)$(WebUIToolkitFrontendContractVueArgument)$(WebUIToolkitFrontendContractSvelteArgument)$(WebUIToolkitFrontendContractAngularArgument)</WebUIToolkitFrontendContractFrameworkArguments>
    <WebUIToolkitFrontendContractCSharpArgument
      Condition="'$(WebUIToolkitFrontendContractCSharpFirst)' != 'true' and
                 '$(WebUIToolkitFrontendContractCSharpOutput)' != ''"> --csharp &quot;$(WebUIToolkitFrontendContractCSharpOutput)&quot;</WebUIToolkitFrontendContractCSharpArgument>
    <WebUIToolkitFrontendContractVerifyCommand
      Condition="'$(WebUIToolkitFrontendContractVerifyCommand)' == '' and '$(WebUIToolkitFrontendContractSource)' != ''">node &quot;$(WebUIToolkitFrontendContractTool)&quot; --source &quot;$(WebUIToolkitFrontendContractSource)&quot;$(WebUIToolkitFrontendContractCSharpArgument) --typescript &quot;$(WebUIToolkitFrontendContractTypeScriptOutput)&quot;$(WebUIToolkitFrontendContractFrameworkArguments) --verify</WebUIToolkitFrontendContractVerifyCommand>
    <WebUIToolkitFrontendContractGenerateCommand
      Condition="'$(WebUIToolkitFrontendContractGenerateCommand)' == '' and '$(WebUIToolkitFrontendContractSource)' != ''">node &quot;$(WebUIToolkitFrontendContractTool)&quot; --source &quot;$(WebUIToolkitFrontendContractSource)&quot;$(WebUIToolkitFrontendContractCSharpArgument) --typescript &quot;$(WebUIToolkitFrontendContractTypeScriptOutput)&quot;$(WebUIToolkitFrontendContractFrameworkArguments)</WebUIToolkitFrontendContractGenerateCommand>
    <WebUIToolkitFrontendInstallCacheDirectory
      Condition="'$(WebUIToolkitFrontendInstallCacheDirectory)' == ''">$(WebUIToolkitFrontendWorkspaceRoot)/obj/WebUIToolkit.Frontend.Sdk/install</WebUIToolkitFrontendInstallCacheDirectory>
    <WebUIToolkitFrontendOutputDirectory
      Condition="'$(WebUIToolkitFrontendOutputDirectory)' == '' and '$(WebUIToolkitFrontendNodeEnabled)' == 'true'">$(WebUIToolkitFrontendPackageDirectory)/dist</WebUIToolkitFrontendOutputDirectory>
    <WebUIToolkitFrontendViteConfiguration
      Condition="'$(WebUIToolkitFrontendViteConfiguration)' == '' and Exists('$(WebUIToolkitFrontendPackageDirectory)/vite.config.mjs')">$(WebUIToolkitFrontendPackageDirectory)/vite.config.mjs</WebUIToolkitFrontendViteConfiguration>
    <WebUIToolkitFrontendViteConfiguration
      Condition="'$(WebUIToolkitFrontendViteConfiguration)' == '' and Exists('$(WebUIToolkitFrontendPackageDirectory)/vite.config.js')">$(WebUIToolkitFrontendPackageDirectory)/vite.config.js</WebUIToolkitFrontendViteConfiguration>
    <WebUIToolkitFrontendViteConfiguration
      Condition="'$(WebUIToolkitFrontendViteConfiguration)' == '' and Exists('$(WebUIToolkitFrontendPackageDirectory)/vite.config.ts')">$(WebUIToolkitFrontendPackageDirectory)/vite.config.ts</WebUIToolkitFrontendViteConfiguration>
    <WebUIToolkitFrontendViteConfiguration
      Condition="'$(WebUIToolkitFrontendViteConfiguration)' == '' and Exists('$(WebUIToolkitFrontendPackageDirectory)/vite.config.mts')">$(WebUIToolkitFrontendPackageDirectory)/vite.config.mts</WebUIToolkitFrontendViteConfiguration>
    <WebUIToolkitFrontendViteConfiguration
      Condition="'$(WebUIToolkitFrontendViteConfiguration)' == '' and Exists('$(WebUIToolkitFrontendPackageDirectory)/vite.config.cjs')">$(WebUIToolkitFrontendPackageDirectory)/vite.config.cjs</WebUIToolkitFrontendViteConfiguration>
    <WebUIToolkitFrontendLockFile
      Condition="'$(WebUIToolkitFrontendLockFile)' == '' and
                 '$(WebUIToolkitFrontendPackageManager)' == 'npm' and
                 Exists('$(WebUIToolkitFrontendWorkspaceRoot)/npm-shrinkwrap.json')">$(WebUIToolkitFrontendWorkspaceRoot)/npm-shrinkwrap.json</WebUIToolkitFrontendLockFile>
    <WebUIToolkitFrontendLockFile
      Condition="'$(WebUIToolkitFrontendLockFile)' == '' and
                 '$(WebUIToolkitFrontendPackageManager)' == 'npm'">$(WebUIToolkitFrontendWorkspaceRoot)/package-lock.json</WebUIToolkitFrontendLockFile>
  </PropertyGroup>

  <ItemGroup Condition="'$(WebUIToolkitFrontendEnabled)' == 'true' and
                        '$(WebUIToolkitFrontendNodeEnabled)' == 'true'">
    <Content Include="$(WebUIToolkitFrontendBridgeAsset)"
             Link="$(WebUIToolkitFrontendWebRoot)/vendor/webuitoolkit-mvvm-cswebui.mjs"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             Condition="Exists('$(WebUIToolkitFrontendBridgeAsset)')" />
  </ItemGroup>

  <Target Name="WebUIToolkitFrontendValidate"
          BeforeTargets="PrepareForBuild"
          Condition="'$(WebUIToolkitFrontendEnabled)' == 'true'">
    <Error Condition="'$(WebUIToolkitFrontendNodeEnabled)' != 'true' and
                      '$(WebUIToolkitFrontendCwhtmlEnabled)' != 'true'"
           Text="Enable at least one WebUIToolkit frontend pipeline: Node/Vite or cwhtml." />
    <Error Condition="'$(WebUIToolkitFrontendNodeEnabled)' == 'true' and
                      '$(WebUIToolkitFrontendWorkspace)' == ''"
           Text="WebUIToolkitFrontendWorkspace is required." />
    <Error Condition="'$(WebUIToolkitFrontendNodeEnabled)' == 'true' and
                      '$(WebUIToolkitFrontendPackageDirectory)' == ''"
           Text="WebUIToolkitFrontendPackageDirectory is required." />
    <Error Condition="'$(WebUIToolkitFrontendContractSource)' != '' and
                      ('$(WebUIToolkitFrontendContractTypeScriptOutput)' == '' or
                       ('$(WebUIToolkitFrontendContractCSharpFirst)' != 'true' and
                        '$(WebUIToolkitFrontendContractCSharpOutput)' == ''))"
           Text="Both frontend contract output paths are required when a contract source is configured." />
  </Target>

  <Target Name="WebUIToolkitFrontendGenerateContracts"
          DependsOnTargets="WebUIToolkitFrontendValidate"
          Condition="'$(WebUIToolkitFrontendEnabled)' == 'true' and
                     '$(WebUIToolkitFrontendNodeEnabled)' == 'true' and
                     '$(WebUIToolkitFrontendContractSource)' != '' and
                     '$(WebUIToolkitFrontendContractCSharpFirst)' != 'true'">
    <Exec Command="$(WebUIToolkitFrontendContractGenerateCommand)"
          WorkingDirectory="$(WebUIToolkitFrontendWorkspaceRoot)" />
  </Target>

  <Target Name="WebUIToolkitFrontendGenerateContractsCSharpFirst"
          AfterTargets="CoreCompile"
          Condition="'$(WebUIToolkitFrontendEnabled)' == 'true' and
                     '$(WebUIToolkitFrontendNodeEnabled)' == 'true' and
                     '$(WebUIToolkitFrontendContractCSharpFirst)' == 'true'">
    <Error Condition="!Exists('$(WebUIToolkitFrontendContractArtifact)')"
           Code="WUTFE0002"
           Text="The C# frontend contract generator did not produce '$(WebUIToolkitFrontendContractArtifact)'." />
    <Exec Command="$(WebUIToolkitFrontendContractGenerateCommand)"
          WorkingDirectory="$(WebUIToolkitFrontendWorkspaceRoot)" />
  </Target>

  <Target Name="WebUIToolkitFrontendResolveInstall"
          DependsOnTargets="WebUIToolkitFrontendValidate"
          Condition="'$(WebUIToolkitFrontendEnabled)' == 'true' and
                     '$(WebUIToolkitFrontendNodeEnabled)' == 'true' and
                     '$(WebUIToolkitFrontendInstall)' == 'true'">
    <Error Condition="'$(WebUIToolkitFrontendLockFile)' == ''"
           Text="WebUIToolkitFrontendLockFile is required for package manager '$(WebUIToolkitFrontendPackageManager)'." />
    <Error Condition="!Exists('$(WebUIToolkitFrontendLockFile)')"
           Text="The frontend lock file '$(WebUIToolkitFrontendLockFile)' does not exist. Restore or generate it, or set WebUIToolkitFrontendLockFile explicitly." />
  </Target>

  <Target Name="WebUIToolkitFrontendInstall"
          BeforeTargets="PrepareForBuild"
          DependsOnTargets="WebUIToolkitFrontendResolveInstall"
          Condition="'$(WebUIToolkitFrontendEnabled)' == 'true' and
                     '$(WebUIToolkitFrontendNodeEnabled)' == 'true' and
                     '$(WebUIToolkitFrontendInstall)' == 'true'">
    <Exec Command="node &quot;$(WebUIToolkitFrontendInstallCoordinator)&quot; &quot;$(WebUIToolkitFrontendWorkspaceRoot)&quot; &quot;$(WebUIToolkitFrontendInstallCacheDirectory)&quot; &quot;$(WebUIToolkitFrontendPackageManager)&quot; &quot;$(WebUIToolkitFrontendLockFile)&quot; &quot;$(WebUIToolkitFrontendInstallCommand)&quot;"
          WorkingDirectory="$(WebUIToolkitFrontendWorkspaceRoot)" />
  </Target>

  <Target Name="WebUIToolkitFrontendBuild"
          BeforeTargets="PrepareForBuild"
          DependsOnTargets="WebUIToolkitFrontendInstall"
          Condition="'$(WebUIToolkitFrontendEnabled)' == 'true' and
                     '$(WebUIToolkitFrontendNodeEnabled)' == 'true' and
                     '$(WebUIToolkitFrontendBuild)' == 'true' and
                     '$(WebUIToolkitFrontendContractCSharpFirst)' != 'true'">
    <Exec Command="$(WebUIToolkitFrontendContractVerifyCommand)"
          WorkingDirectory="$(WebUIToolkitFrontendWorkspaceRoot)"
          Condition="'$(WebUIToolkitFrontendContractVerifyCommand)' != ''" />
    <Exec Command="$(WebUIToolkitFrontendBuildCommand)"
          WorkingDirectory="$(WebUIToolkitFrontendWorkspaceRoot)" />
  </Target>

  <Target Name="WebUIToolkitFrontendBuildCSharpFirst"
          AfterTargets="WebUIToolkitFrontendGenerateContractsCSharpFirst"
          DependsOnTargets="WebUIToolkitFrontendInstall"
          Condition="'$(WebUIToolkitFrontendEnabled)' == 'true' and
                     '$(WebUIToolkitFrontendNodeEnabled)' == 'true' and
                     '$(WebUIToolkitFrontendBuild)' == 'true' and
                     '$(WebUIToolkitFrontendContractCSharpFirst)' == 'true'">
    <Exec Command="$(WebUIToolkitFrontendContractVerifyCommand)"
          WorkingDirectory="$(WebUIToolkitFrontendWorkspaceRoot)"
          Condition="'$(WebUIToolkitFrontendContractVerifyCommand)' != ''" />
    <Exec Command="$(WebUIToolkitFrontendBuildCommand)"
          WorkingDirectory="$(WebUIToolkitFrontendWorkspaceRoot)" />
  </Target>

  <Target Name="WebUIToolkitFrontendCopyToOutput"
          AfterTargets="Build"
          DependsOnTargets="WebUIToolkitFrontendBuild;WebUIToolkitFrontendBuildCSharpFirst"
          Condition="'$(WebUIToolkitFrontendEnabled)' == 'true' and
                     '$(WebUIToolkitFrontendNodeEnabled)' == 'true'">
    <MakeDir Directories="$(TargetDir)$(WebUIToolkitFrontendWebRoot)" />
    <RemoveDir Condition="'$(WebUIToolkitFrontendBuild)' == 'true'"
               Directories="$(TargetDir)$(WebUIToolkitFrontendWebRoot)/assets;
                            $(TargetDir)$(WebUIToolkitFrontendWebRoot)/simple;
                            $(TargetDir)$(WebUIToolkitFrontendWebRoot)/advanced" />
    <ItemGroup>
      <_WebUIToolkitFrontendOutput
        Include="$(WebUIToolkitFrontendOutputDirectory)/**/*"
        Condition="'$(WebUIToolkitFrontendBuild)' == 'true'" />
    </ItemGroup>
    <Copy SourceFiles="@(_WebUIToolkitFrontendOutput)"
          DestinationFiles="@(_WebUIToolkitFrontendOutput->'$(TargetDir)$(WebUIToolkitFrontendWebRoot)/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          Condition="'$(WebUIToolkitFrontendBuild)' == 'true'" />
  </Target>

  <Target Name="WebUIToolkitFrontendCopyToPublish"
          AfterTargets="Publish"
          DependsOnTargets="WebUIToolkitFrontendBuild;WebUIToolkitFrontendBuildCSharpFirst"
          Condition="'$(WebUIToolkitFrontendEnabled)' == 'true' and
                     '$(WebUIToolkitFrontendNodeEnabled)' == 'true'">
    <MakeDir Directories="$(PublishDir)$(WebUIToolkitFrontendWebRoot)" />
    <RemoveDir Condition="'$(WebUIToolkitFrontendBuild)' == 'true'"
               Directories="$(PublishDir)$(WebUIToolkitFrontendWebRoot)/assets;
                            $(PublishDir)$(WebUIToolkitFrontendWebRoot)/simple;
                            $(PublishDir)$(WebUIToolkitFrontendWebRoot)/advanced" />
    <ItemGroup>
      <_WebUIToolkitFrontendPublish
        Include="$(WebUIToolkitFrontendOutputDirectory)/**/*"
        Condition="'$(WebUIToolkitFrontendBuild)' == 'true'" />
    </ItemGroup>
    <Copy SourceFiles="@(_WebUIToolkitFrontendPublish)"
          DestinationFiles="@(_WebUIToolkitFrontendPublish->'$(PublishDir)$(WebUIToolkitFrontendWebRoot)/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          Condition="'$(WebUIToolkitFrontendBuild)' == 'true'" />
  </Target>

  <Target Name="WebUIToolkitFrontendCompileCwhtml"
          BeforeTargets="PrepareForBuild"
          DependsOnTargets="CompileCwhtmlTemplates"
          Condition="'$(WebUIToolkitFrontendEnabled)' == 'true' and
                     '$(WebUIToolkitFrontendCwhtmlEnabled)' == 'true'" />

  <Target Name="WebUIToolkitFrontendWatchAssets"
          DependsOnTargets="WebUIToolkitFrontendInstall"
          Condition="'$(WebUIToolkitFrontendEnabled)' == 'true' and
                     '$(WebUIToolkitFrontendNodeEnabled)' == 'true'">
    <Exec Command="npm run dev --workspace $(WebUIToolkitFrontendWorkspace)"
          WorkingDirectory="$(WebUIToolkitFrontendWorkspaceRoot)" />
  </Target>

  <Target Name="WebUIToolkitFrontendWatch"
          DependsOnTargets="WebUIToolkitFrontendValidate"
          Condition="'$(WebUIToolkitFrontendEnabled)' == 'true'">
    <Exec Command="&quot;$(DotNetHostPath)&quot; watch --project &quot;$(WebUIToolkitDevProject)&quot; run --no-launch-profile -- $(WebUIToolkitDevRunArguments)"
          Condition="'$(DotNetHostPath)' != ''" />
    <Exec Command="dotnet watch --project &quot;$(WebUIToolkitDevProject)&quot; run --no-launch-profile -- $(WebUIToolkitDevRunArguments)"
          Condition="'$(DotNetHostPath)' == ''" />
  </Target>
</Project>
