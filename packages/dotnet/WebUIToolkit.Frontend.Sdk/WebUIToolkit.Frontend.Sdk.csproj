<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(WebUIToolkitDefaultTargetFramework)</TargetFramework>
    <AssemblyName>WebUIToolkit.Frontend.Sdk</AssemblyName>
    <RootNamespace>WebUIToolkit.Frontend.Sdk</RootNamespace>
    <PackageId>WebUIToolkit.Frontend.Sdk</PackageId>
    <Description>MSBuild integration for WebUIToolkit frontend contracts, builds, manifests, and publication.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <WebUIToolkitShippingProject>true</WebUIToolkitShippingProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WebUIToolkit.Frontend.Generators\WebUIToolkit.Frontend.Generators.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Update="README.md" Pack="true" PackagePath="/" />
    <None Update="buildTransitive/WebUIToolkit.Frontend.Sdk.props"
          Pack="true"
          PackagePath="buildTransitive/WebUIToolkit.Frontend.Sdk.props" />
    <None Update="buildTransitive/WebUIToolkit.Frontend.Sdk.targets"
          Pack="true"
          PackagePath="buildTransitive/WebUIToolkit.Frontend.Sdk.targets" />
    <None Update="tools/generate-contracts.mjs"
          Pack="true"
          PackagePath="tools/generate-contracts.mjs" />
    <None Update="tools/install-frontend.mjs"
          Pack="true"
          PackagePath="tools/install-frontend.mjs" />
    <None Include="..\WebUIToolkit.Frontend.Generators\bin\$(Configuration)\$(WebUIToolkitGeneratorTargetFramework)\WebUIToolkit.Frontend.Generators.dll"
          Pack="true"
          PackagePath="analyzers\dotnet\cs\WebUIToolkit.Frontend.Generators.dll" />
    <None Include="../WebUIToolkit.Hosting.CsWebUi.Mvvm/assets/webuitoolkit-mvvm-cswebui.mjs"
          Pack="true"
          PackagePath="assets/webuitoolkit-mvvm-cswebui.mjs" />
  </ItemGroup>
</Project>
