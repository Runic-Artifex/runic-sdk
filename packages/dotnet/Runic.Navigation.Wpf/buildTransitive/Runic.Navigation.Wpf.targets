<Project>
  <!-- The navigation API is experimental (RUNICNAV001). The WPF markup compiler
       declares a named NavigationHost or NavigationDialogHost in the page's
       generated .g.cs, where the application cannot suppress the diagnostic per
       site. Suppress it in the intermediate .g.cs files only, so it is reported
       where the application's own code uses the API. See docs/experimental.md. -->
  <PropertyGroup>
    <RunicNavigationWpfTargetsImported>true</RunicNavigationWpfTargetsImported>
  </PropertyGroup>
  <Target Name="RunicNavigationWpfSuppressInGeneratedCode" BeforeTargets="CoreCompile" Condition="'$(UseWPF)' == 'true'">
    <PropertyGroup>
      <_RunicNavigationWpfIntermediate>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)'))</_RunicNavigationWpfIntermediate>
      <_RunicNavigationWpfConfig>$(_RunicNavigationWpfIntermediate)runic-navigation-wpf.globalconfig</_RunicNavigationWpfConfig>
    </PropertyGroup>
    <ItemGroup>
      <_RunicNavigationWpfGenerated Include="@(Compile->'%(FullPath)')"
          Condition="$([System.String]::Copy('%(FullPath)').StartsWith('$(_RunicNavigationWpfIntermediate)')) and ($([System.String]::Copy('%(Filename)').EndsWith('.g')) or $([System.String]::Copy('%(Filename)').EndsWith('.g.i')))" />
      <_RunicNavigationWpfConfigLine Include="is_global = true" />
      <_RunicNavigationWpfConfigLine Include="[$([System.String]::Copy('%(_RunicNavigationWpfGenerated.Identity)').Replace('\', '/'))]%0Adotnet_diagnostic.RUNICNAV001.severity = none" />
    </ItemGroup>
    <WriteLinesToFile File="$(_RunicNavigationWpfConfig)" Lines="@(_RunicNavigationWpfConfigLine)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <EditorConfigFiles Include="$(_RunicNavigationWpfConfig)" />
      <FileWrites Include="$(_RunicNavigationWpfConfig)" />
    </ItemGroup>
  </Target>
</Project>
