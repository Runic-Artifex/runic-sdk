<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../../eng/build/platform.props" />
  <PropertyGroup>
    <TargetFramework>$(RunicApplicationDefaultTargetFramework)</TargetFramework>
    <RunicApplicationShippingProject>true</RunicApplicationShippingProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Runic.Platform</AssemblyName>
    <RootNamespace>Runic.Platform</RootNamespace>
    <PackageId>Runic.Platform</PackageId>
    <Description>Host-independent native-service contracts for Runic applications.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- The privileged-action targets report RUNICPA diagnostics with links to docs/diagnostics.md at the release tag. -->
    <RunicPackDiagnosticsHelpLinks>true</RunicPackDiagnosticsHelpLinks>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="buildTransitive/Runic.Platform.targets" Pack="true" PackagePath="buildTransitive/" />
    <!-- The menu bar and status icon menus check entries with the same internal DesktopMenuRules. Both packages pin
         Runic.Platform to their own version (eng/build/package-dependencies.targets). -->
    <InternalsVisibleTo Include="Runic.Desktop" />
    <InternalsVisibleTo Include="Runic.Platform.Runtime" />
  </ItemGroup>
  <Import Project="../../../eng/build/application.targets" />
</Project>
