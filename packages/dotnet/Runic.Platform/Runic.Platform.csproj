<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../../eng/build/platform.props" />
  <PropertyGroup>
    <TargetFramework>$(RunicApplicationDefaultTargetFramework)</TargetFramework>
    <RunicApplicationShippingProject>true</RunicApplicationShippingProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Runic.Platform</AssemblyName>
    <RootNamespace>Runic.Platform</RootNamespace>
    <PackageId>Runic.Platform</PackageId>
    <Description>Host-independent native-service contracts for Runic applications.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- The privileged-action targets report RUNICPA diagnostics with links to docs/diagnostics.md at the release tag. -->
    <RunicPackDiagnosticsHelpLinks>true</RunicPackDiagnosticsHelpLinks>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="buildTransitive/Runic.Platform.targets" Pack="true" PackagePath="buildTransitive/" />
    <!-- The menu bar checks menus with the internal DesktopMenuRules, as status icons do through Runic.Platform.Runtime's
         linked copy. Runic.Desktop pins Runic.Platform to its own version (eng/build/package-dependencies.targets). -->
    <InternalsVisibleTo Include="Runic.Desktop" />
  </ItemGroup>
  <ItemGroup>
    <!-- RUNICPLAT analyzers and their code fixes ship in this package's analyzers/ folder (docs/diagnostics.md). -->
    <ProjectReference Include="../Runic.Platform.Analyzers/Runic.Platform.Analyzers.csproj" ReferenceOutputAssembly="false" PrivateAssets="all"
        UndefineProperties="RuntimeIdentifier;SelfContained;PublishAot;IlcTreatWarningsAsErrors" />
    <ProjectReference Include="../Runic.Platform.Analyzers.CodeFixes/Runic.Platform.Analyzers.CodeFixes.csproj" ReferenceOutputAssembly="false" PrivateAssets="all"
        UndefineProperties="RuntimeIdentifier;SelfContained;PublishAot;IlcTreatWarningsAsErrors" />
    <None Include="../Runic.Platform.Analyzers/bin/$(Configuration)/netstandard2.0/Runic.Platform.Analyzers.dll" Pack="true" PackagePath="analyzers/dotnet/cs/" Visible="false" />
    <None Include="../Runic.Platform.Analyzers.CodeFixes/bin/$(Configuration)/netstandard2.0/Runic.Platform.Analyzers.CodeFixes.dll" Pack="true" PackagePath="analyzers/dotnet/cs/" Visible="false" />
  </ItemGroup>
  <Import Project="../../../eng/build/application.targets" />
</Project>
