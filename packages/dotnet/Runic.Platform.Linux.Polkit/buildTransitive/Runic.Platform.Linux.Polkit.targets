<Project>
  <!--
    The Polkit policy for the RunicPrivilegedAction items (see Runic.Platform's buildTransitive targets, which
    validate them and write the PrivilegedActions class). Each build writes the policy, which is copied to the output
    and publish directories at $(RunicPolkitPolicyOutputPath)$(RunicPolkitPolicyName).policy unless
    RunicPolkitPolicyCopyEnabled is false. The metadata only the policy carries is Polkit-prefixed: PolkitAllowAny,
    PolkitAllowInactive, PolkitAllowActive, PolkitAllowGui and PolkitIconName. Packages get Runic.Platform's targets
    through the package dependency; a project in this repository imports both files.
  -->

  <PropertyGroup>
    <!-- The prefix the application is installed under, for a privileged action's Program, such as
         $(RunicApplicationInstallPrefix)/bin/my-app. The Nix builder sets it to the package's $out; other builds
         install under /usr unless they set it. MSBuild evaluates every property before the items, so the items
         in the project's body see this default. -->
    <RunicApplicationInstallPrefix Condition="'$(RunicApplicationInstallPrefix)' == ''">/usr</RunicApplicationInstallPrefix>
    <!-- Runic.Platform writes the declarations only after the policy succeeded. -->
    <RunicPrivilegedActionsDependsOn>$(RunicPrivilegedActionsDependsOn);RunicGeneratePolkitPolicy</RunicPrivilegedActionsDependsOn>
  </PropertyGroup>

  <UsingTask TaskName="RunicWritePolkitPolicy" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Actions ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <PolicyFile ParameterType="System.String" Required="true" />
      <ProjectFile ParameterType="System.String" />
      <HelpLinkBase ParameterType="System.String" />
    </ParameterGroup>
    <Task>
      <Code Type="Class" Language="cs"><![CDATA[
using System;
using System.Collections.Generic;
using System.IO;
using System.Linq;
using System.Text;
using System.Xml;
using Microsoft.Build.Framework;
using Microsoft.Build.Utilities;

// Writes the Polkit policy. RunicValidatePrivilegedActions (Runic.Platform) has already checked the IDs, programs,
// verbs, messages and arguments; this task checks what only the policy carries.
public sealed class RunicWritePolkitPolicy : Task
{
    private static readonly string[] Authorizations = { "no", "yes", "auth_self", "auth_self_keep", "auth_admin", "auth_admin_keep" };
    // Written in two parts: this source sits in a CDATA section of the targets file.
    private const string CDataEnd = "]]" + ">";

    [Required] public ITaskItem[] Actions { get; set; } = Array.Empty<ITaskItem>();
    [Required] public string PolicyFile { get; set; } = "";
    public string ProjectFile { get; set; } = "";
    public string HelpLinkBase { get; set; } = "";

    private sealed class Action
    {
        public string Id = "", Program = "", Description = "", Message = "";
        public string Verb, IconName;
        public string AllowAny = "auth_admin", AllowInactive = "auth_admin", AllowActive = "auth_admin";
        public bool AllowGui;
    }

    public override bool Execute()
    {
        var actions = Actions.Select(Read).ToList();
        if (Log.HasLoggedErrors) return false;
        Directory.CreateDirectory(Path.GetDirectoryName(PolicyFile));
        WriteIfChanged(PolicyFile, Policy(actions));
        return true;
    }

    private Action Read(ITaskItem item)
    {
        var action = new Action { Id = item.ItemSpec };
        string Get(string name) { var value = item.GetMetadata(name); return string.IsNullOrEmpty(value) ? null : value; }
        action.Program = Get("Program") ?? "";
        action.Description = Get("Description") ?? "";
        action.Message = Get("Message") ?? "";
        foreach (var name in new[] { "Program", "Description", "Message", "Verb", "PolkitIconName" })
        {
            var value = Get(name);
            if (value != null && (value.Any(char.IsControl) || value.Contains(CDataEnd) || !IsXmlText(value)))
                Error("RUNICPA013", $"Privileged action '{action.Id}' has a line break, another control character, a character XML cannot carry or '{CDataEnd}' in {name}; the policy cannot carry it.");
        }
        action.Verb = Get("Verb");
        action.IconName = Get("PolkitIconName");
        action.AllowAny = Authorization(item, action.Id, "PolkitAllowAny");
        action.AllowInactive = Authorization(item, action.Id, "PolkitAllowInactive");
        action.AllowActive = Authorization(item, action.Id, "PolkitAllowActive");
        var gui = Get("PolkitAllowGui") ?? "false";
        if (!bool.TryParse(gui, out action.AllowGui)) Error("RUNICPA010", $"Privileged action '{action.Id}' has PolkitAllowGui '{gui}'; use true or false.");
        return action;
    }

    private string Authorization(ITaskItem item, string id, string name)
    {
        var value = item.GetMetadata(name);
        if (string.IsNullOrEmpty(value)) return "auth_admin";
        if (Array.IndexOf(Authorizations, value) < 0)
            Error("RUNICPA012", $"Privileged action '{id}' has {name} '{value}'; use one of {string.Join(", ", Authorizations)}.");
        else if (value == "yes")
            Warning("RUNICPA014", $"Privileged action '{id}' has {name} 'yes', which lets every such subject run the program as root without authenticating. Grant that to specific users or groups in a site rule in /etc/polkit-1/rules.d instead.");
        else if (value.StartsWith("auth_self", StringComparison.Ordinal))
            Warning("RUNICPA014", $"Privileged action '{id}' has {name} '{value}', which accepts the user's own password, so any process running as that user can authorize the action. Use auth_admin or auth_admin_keep.");
        return value;
    }

    private static bool IsXmlText(string value)
    {
        try
        {
            XmlConvert.VerifyXmlChars(value);
            return true;
        }
        catch (XmlException) { return false; }
    }

    private static string Policy(List<Action> actions)
    {
        var settings = new XmlWriterSettings
        {
            Encoding = new UTF8Encoding(false),
            Indent = true,
            IndentChars = "  ",
            NewLineChars = "\n",
            NewLineHandling = NewLineHandling.Replace,
        };
        using (var text = new Utf8StringWriter())
        {
            using (var xml = XmlWriter.Create(text, settings))
            {
                xml.WriteStartDocument();
                xml.WriteDocType("policyconfig", "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN",
                    "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd", null);
                xml.WriteComment(" Generated by Runic.Platform.Linux.Polkit from RunicPrivilegedAction items. ");
                xml.WriteStartElement("policyconfig");
                foreach (var action in actions)
                {
                    xml.WriteStartElement("action");
                    xml.WriteAttributeString("id", action.Id);
                    Element(xml, "description", action.Description);
                    Element(xml, "message", action.Message);
                    if (action.IconName != null) Element(xml, "icon_name", action.IconName);
                    xml.WriteStartElement("defaults");
                    xml.WriteElementString("allow_any", action.AllowAny);
                    xml.WriteElementString("allow_inactive", action.AllowInactive);
                    xml.WriteElementString("allow_active", action.AllowActive);
                    xml.WriteEndElement();
                    Annotate(xml, "org.freedesktop.policykit.exec.path", action.Program);
                    if (action.Verb != null) Annotate(xml, "org.freedesktop.policykit.exec.argv1", action.Verb);
                    // pkexec keeps DISPLAY and XAUTHORITY when this annotation is present with any value.
                    if (action.AllowGui) Annotate(xml, "org.freedesktop.policykit.exec.allow_gui", "true");
                    xml.WriteEndElement();
                }
                xml.WriteEndElement();
                xml.WriteEndDocument();
            }
            return text.ToString() + "\n";
        }
    }

    private static void Annotate(XmlWriter xml, string key, string value)
    {
        xml.WriteStartElement("annotate");
        xml.WriteAttributeString("key", key);
        Text(xml, value);
        xml.WriteEndElement();
    }

    private static void Element(XmlWriter xml, string name, string value)
    {
        xml.WriteStartElement(name);
        Text(xml, value);
        xml.WriteEndElement();
    }

    // polkitd keeps only the last piece of character data that expat reports for an element, and expat reports
    // text in pieces at each entity reference. Text that needs escaping is one CDATA section instead, which expat
    // reports in one piece as long as it has no line break (Read rejects those).
    private static void Text(XmlWriter xml, string value)
    {
        if (value.IndexOfAny(new[] { '<', '>', '&' }) >= 0) xml.WriteCData(value);
        else xml.WriteString(value);
    }

    private static void WriteIfChanged(string path, string content)
    {
        if (File.Exists(path) && File.ReadAllText(path) == content) return;
        File.WriteAllText(path, content, new UTF8Encoding(false));
    }

    private void Warning(string code, string message) =>
        Log.LogWarning(null, code, null, string.IsNullOrEmpty(HelpLinkBase) ? null : HelpLinkBase + code.ToLowerInvariant(), ProjectFile, 0, 0, 0, 0, message);

    private void Error(string code, string message) =>
        Log.LogError(null, code, null, string.IsNullOrEmpty(HelpLinkBase) ? null : HelpLinkBase + code.ToLowerInvariant(), ProjectFile, 0, 0, 0, 0, message);

    private sealed class Utf8StringWriter : StringWriter
    {
        public override Encoding Encoding => new UTF8Encoding(false);
    }
}
]]></Code>
    </Task>
  </UsingTask>

  <!--
    RUNICPA108: the former names RunicPolkitPolicy and AllowAny, AllowInactive, AllowActive, AllowGui and IconName are
    no longer applied, so a project that still sets one fails once per name, and the error names its replacement. Design-time builds skip the check.
  -->
  <Target Name="_RunicPolkitReportRenamedNames" BeforeTargets="PrepareForBuild;RunicValidatePrivilegedActions"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <_RunicPolkitRenamedMetadata Include="@(RunicPrivilegedAction)" Condition="'%(RunicPrivilegedAction.AllowAny)' != ''" OldName="AllowAny" NewName="PolkitAllowAny" />
      <_RunicPolkitRenamedMetadata Include="@(RunicPrivilegedAction)" Condition="'%(RunicPrivilegedAction.AllowInactive)' != ''" OldName="AllowInactive" NewName="PolkitAllowInactive" />
      <_RunicPolkitRenamedMetadata Include="@(RunicPrivilegedAction)" Condition="'%(RunicPrivilegedAction.AllowActive)' != ''" OldName="AllowActive" NewName="PolkitAllowActive" />
      <_RunicPolkitRenamedMetadata Include="@(RunicPrivilegedAction)" Condition="'%(RunicPrivilegedAction.AllowGui)' != ''" OldName="AllowGui" NewName="PolkitAllowGui" />
      <_RunicPolkitRenamedMetadata Include="@(RunicPrivilegedAction)" Condition="'%(RunicPrivilegedAction.IconName)' != ''" OldName="IconName" NewName="PolkitIconName" />
    </ItemGroup>
    <Error Condition="'$(RunicPolkitPolicy)' != ''" ContinueOnError="ErrorAndContinue"
           Code="RUNICPA108" File="$(MSBuildProjectFullPath)" HelpLink="$(_RunicDiagnosticsHelpLinkBase)runicpa108"
           Text="The Runic build property RunicPolkitPolicy is renamed to RunicPolkitPolicyCopyEnabled. Rename it in $(MSBuildProjectFile), its imports or the command line." />
    <Error Condition="'%(_RunicPolkitRenamedMetadata.OldName)' != ''" ContinueOnError="ErrorAndContinue"
           Code="RUNICPA108" File="$(MSBuildProjectFullPath)" HelpLink="$(_RunicDiagnosticsHelpLinkBase)runicpa108"
           Text="The RunicPrivilegedAction metadata %(_RunicPolkitRenamedMetadata.OldName) on '%(_RunicPolkitRenamedMetadata.Identity)' is renamed to %(_RunicPolkitRenamedMetadata.NewName). Rename it in $(MSBuildProjectFile) or its imports." />
    <ItemGroup>
      <_RunicPolkitRenamedMetadata Remove="@(_RunicPolkitRenamedMetadata)" />
    </ItemGroup>
  </Target>

  <Target Name="RunicGeneratePolkitPolicy"
          DependsOnTargets="RunicValidatePrivilegedActions"
          BeforeTargets="AssignTargetPaths;CoreCompile"
          Condition="'@(RunicPrivilegedAction)' != ''">
    <!-- Defaults are set here, when the target runs, so they see the final project properties. -->
    <PropertyGroup>
      <RunicPolkitPolicyName Condition="'$(RunicPolkitPolicyName)' == ''">$(ApplicationId)</RunicPolkitPolicyName>
      <RunicPolkitPolicyName Condition="'$(RunicPolkitPolicyName)' == ''">$(AssemblyName)</RunicPolkitPolicyName>
      <RunicPolkitPolicyOutputPath Condition="'$(RunicPolkitPolicyOutputPath)' == ''">share/polkit-1/actions/</RunicPolkitPolicyOutputPath>
      <RunicPolkitPolicyCopyEnabled Condition="'$(RunicPolkitPolicyCopyEnabled)' == '' and ($(RuntimeIdentifier.StartsWith('win')) or $(RuntimeIdentifier.StartsWith('osx')))">false</RunicPolkitPolicyCopyEnabled>
      <RunicPolkitPolicyCopyEnabled Condition="'$(RunicPolkitPolicyCopyEnabled)' == ''">true</RunicPolkitPolicyCopyEnabled>
      <_RunicPrivilegedPolicyDirectory>$(IntermediateOutputPath)runic-privileged/</_RunicPrivilegedPolicyDirectory>
    </PropertyGroup>
    <RunicWritePolkitPolicy Actions="@(RunicPrivilegedAction)"
                            PolicyFile="$(_RunicPrivilegedPolicyDirectory)$(RunicPolkitPolicyName).policy"
                            ProjectFile="$(MSBuildProjectFullPath)"
                            HelpLinkBase="$(_RunicDiagnosticsHelpLinkBase)" />
    <ItemGroup>
      <FileWrites Include="$(_RunicPrivilegedPolicyDirectory)$(RunicPolkitPolicyName).policy" />
      <None Remove="$(_RunicPrivilegedPolicyDirectory)$(RunicPolkitPolicyName).policy" />
      <None Include="$(_RunicPrivilegedPolicyDirectory)$(RunicPolkitPolicyName).policy"
            Condition="'$(RunicPolkitPolicyCopyEnabled)' == 'true'"
            Link="$(RunicPolkitPolicyOutputPath)$(RunicPolkitPolicyName).policy"
            CopyToOutputDirectory="PreserveNewest"
            CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
