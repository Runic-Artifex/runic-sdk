<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../../eng/build/application.props" />
  <PropertyGroup>
    <TargetFramework>$(RunicApplicationDefaultTargetFramework)</TargetFramework>
    <RunicApplicationShippingProject>true</RunicApplicationShippingProject>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>Runic.Platform.Linux.Polkit</PackageId>
    <Description>Declared privileged actions for Runic applications on Linux: a generated Polkit policy and pkexec.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- The targets report RUNICPA diagnostics with links to docs/diagnostics.md at the release tag. -->
    <RunicPackDiagnosticsHelpLinks>true</RunicPackDiagnosticsHelpLinks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Runic.Platform/Runic.Platform.csproj" />
    <InternalsVisibleTo Include="Runic.Platform.Linux.Polkit.Tests" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="buildTransitive/Runic.Platform.Linux.Polkit.targets" Pack="true" PackagePath="buildTransitive/" />
  </ItemGroup>
  <Import Project="../../../eng/build/application.targets" />
</Project>
