<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(RunicToolkitDefaultTargetFramework)</TargetFramework>
    <AssemblyName>RunicToolkit.Frontend.Sdk</AssemblyName>
    <RootNamespace>RunicToolkit.Frontend.Sdk</RootNamespace>
    <PackageId>RunicToolkit.Frontend.Sdk</PackageId>
    <Description>MSBuild integration for RunicToolkit frontend contracts, builds, manifests, and publication.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RunicToolkitShippingProject>true</RunicToolkitShippingProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RunicToolkit.Frontend.Generators\RunicToolkit.Frontend.Generators.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Update="README.md" Pack="true" PackagePath="/" />
    <None Update="buildTransitive/RunicToolkit.Frontend.Sdk.props"
          Pack="true"
          PackagePath="buildTransitive/RunicToolkit.Frontend.Sdk.props" />
    <None Update="buildTransitive/RunicToolkit.Frontend.Sdk.targets"
          Pack="true"
          PackagePath="buildTransitive/RunicToolkit.Frontend.Sdk.targets" />
    <None Update="tools/generate-contracts.mjs"
          Pack="true"
          PackagePath="tools/generate-contracts.mjs" />
    <None Update="tools/install-frontend.mjs"
          Pack="true"
          PackagePath="tools/install-frontend.mjs" />
    <None Include="..\RunicToolkit.Frontend.Generators\bin\$(Configuration)\$(RunicToolkitGeneratorTargetFramework)\RunicToolkit.Frontend.Generators.dll"
          Pack="true"
          PackagePath="analyzers\dotnet\cs\RunicToolkit.Frontend.Generators.dll" />
    <None Include="../RunicToolkit.Hosting.CsWebUi.Mvvm/assets/runic-toolkit-mvvm-cswebui.mjs"
          Pack="true"
          PackagePath="assets/runic-toolkit-mvvm-cswebui.mjs" />
  </ItemGroup>
</Project>
