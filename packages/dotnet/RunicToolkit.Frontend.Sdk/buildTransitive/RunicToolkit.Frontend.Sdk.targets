<Project>
  <PropertyGroup>
    <RunicToolkitFrontendContractArtifact
      Condition="'$(RunicToolkitFrontendContractArtifact)' == ''">$([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'runic-toolkit.frontend.json'))</RunicToolkitFrontendContractArtifact>
    <RunicToolkitFrontendContractSource
      Condition="'$(RunicToolkitFrontendContractCSharpFirst)' == 'true'">$(RunicToolkitFrontendContractArtifact)</RunicToolkitFrontendContractSource>
    <!-- Package buildTransitive props are imported before consumer project properties.
         Compose commands here so project-declared workspace and contract paths are visible. -->
    <RunicToolkitFrontendBuildCommand
      Condition="'$(RunicToolkitFrontendBuildCommand)' == ''">npm run build --workspace $(RunicToolkitFrontendWorkspace) $(RunicToolkitFrontendBuildArguments)</RunicToolkitFrontendBuildCommand>
    <RunicToolkitFrontendDevServerKind
      Condition="'$(RunicToolkitFrontendDevServerKind)' == '' and
                 '$(RunicToolkitFrontendViteDevServerEnabled)' == 'true'">vite</RunicToolkitFrontendDevServerKind>
    <RunicToolkitFrontendContractReactArgument
      Condition="'$(RunicToolkitFrontendContractReactOutput)' != ''"> --react &quot;$(RunicToolkitFrontendContractReactOutput)&quot;</RunicToolkitFrontendContractReactArgument>
    <RunicToolkitFrontendContractVueArgument
      Condition="'$(RunicToolkitFrontendContractVueOutput)' != ''"> --vue &quot;$(RunicToolkitFrontendContractVueOutput)&quot;</RunicToolkitFrontendContractVueArgument>
    <RunicToolkitFrontendContractSvelteArgument
      Condition="'$(RunicToolkitFrontendContractSvelteOutput)' != ''"> --svelte &quot;$(RunicToolkitFrontendContractSvelteOutput)&quot;</RunicToolkitFrontendContractSvelteArgument>
    <RunicToolkitFrontendContractAngularArgument
      Condition="'$(RunicToolkitFrontendContractAngularOutput)' != ''"> --angular &quot;$(RunicToolkitFrontendContractAngularOutput)&quot;</RunicToolkitFrontendContractAngularArgument>
    <RunicToolkitFrontendContractFrameworkArguments>$(RunicToolkitFrontendContractReactArgument)$(RunicToolkitFrontendContractVueArgument)$(RunicToolkitFrontendContractSvelteArgument)$(RunicToolkitFrontendContractAngularArgument)</RunicToolkitFrontendContractFrameworkArguments>
    <RunicToolkitFrontendContractCSharpArgument
      Condition="'$(RunicToolkitFrontendContractCSharpFirst)' != 'true' and
                 '$(RunicToolkitFrontendContractCSharpOutput)' != ''"> --csharp &quot;$(RunicToolkitFrontendContractCSharpOutput)&quot;</RunicToolkitFrontendContractCSharpArgument>
    <RunicToolkitFrontendContractVerifyCommand
      Condition="'$(RunicToolkitFrontendContractVerifyCommand)' == '' and '$(RunicToolkitFrontendContractSource)' != ''">node &quot;$(RunicToolkitFrontendContractTool)&quot; --source &quot;$(RunicToolkitFrontendContractSource)&quot;$(RunicToolkitFrontendContractCSharpArgument) --typescript &quot;$(RunicToolkitFrontendContractTypeScriptOutput)&quot;$(RunicToolkitFrontendContractFrameworkArguments) --verify</RunicToolkitFrontendContractVerifyCommand>
    <RunicToolkitFrontendContractGenerateCommand
      Condition="'$(RunicToolkitFrontendContractGenerateCommand)' == '' and '$(RunicToolkitFrontendContractSource)' != ''">node &quot;$(RunicToolkitFrontendContractTool)&quot; --source &quot;$(RunicToolkitFrontendContractSource)&quot;$(RunicToolkitFrontendContractCSharpArgument) --typescript &quot;$(RunicToolkitFrontendContractTypeScriptOutput)&quot;$(RunicToolkitFrontendContractFrameworkArguments)</RunicToolkitFrontendContractGenerateCommand>
    <RunicToolkitFrontendInstallCacheDirectory
      Condition="'$(RunicToolkitFrontendInstallCacheDirectory)' == ''">$(RunicToolkitFrontendWorkspaceRoot)/obj/RunicToolkit.Frontend.Sdk/install</RunicToolkitFrontendInstallCacheDirectory>
    <RunicToolkitFrontendOutputDirectory
      Condition="'$(RunicToolkitFrontendOutputDirectory)' == '' and '$(RunicToolkitFrontendNodeEnabled)' == 'true'">$(RunicToolkitFrontendPackageDirectory)/dist</RunicToolkitFrontendOutputDirectory>
    <RunicToolkitFrontendViteConfiguration
      Condition="'$(RunicToolkitFrontendViteConfiguration)' == '' and Exists('$(RunicToolkitFrontendPackageDirectory)/vite.config.mjs')">$(RunicToolkitFrontendPackageDirectory)/vite.config.mjs</RunicToolkitFrontendViteConfiguration>
    <RunicToolkitFrontendViteConfiguration
      Condition="'$(RunicToolkitFrontendViteConfiguration)' == '' and Exists('$(RunicToolkitFrontendPackageDirectory)/vite.config.js')">$(RunicToolkitFrontendPackageDirectory)/vite.config.js</RunicToolkitFrontendViteConfiguration>
    <RunicToolkitFrontendViteConfiguration
      Condition="'$(RunicToolkitFrontendViteConfiguration)' == '' and Exists('$(RunicToolkitFrontendPackageDirectory)/vite.config.ts')">$(RunicToolkitFrontendPackageDirectory)/vite.config.ts</RunicToolkitFrontendViteConfiguration>
    <RunicToolkitFrontendViteConfiguration
      Condition="'$(RunicToolkitFrontendViteConfiguration)' == '' and Exists('$(RunicToolkitFrontendPackageDirectory)/vite.config.mts')">$(RunicToolkitFrontendPackageDirectory)/vite.config.mts</RunicToolkitFrontendViteConfiguration>
    <RunicToolkitFrontendViteConfiguration
      Condition="'$(RunicToolkitFrontendViteConfiguration)' == '' and Exists('$(RunicToolkitFrontendPackageDirectory)/vite.config.cjs')">$(RunicToolkitFrontendPackageDirectory)/vite.config.cjs</RunicToolkitFrontendViteConfiguration>
    <RunicToolkitFrontendLockFile
      Condition="'$(RunicToolkitFrontendLockFile)' == '' and
                 '$(RunicToolkitFrontendPackageManager)' == 'npm' and
                 Exists('$(RunicToolkitFrontendWorkspaceRoot)/npm-shrinkwrap.json')">$(RunicToolkitFrontendWorkspaceRoot)/npm-shrinkwrap.json</RunicToolkitFrontendLockFile>
    <RunicToolkitFrontendLockFile
      Condition="'$(RunicToolkitFrontendLockFile)' == '' and
                 '$(RunicToolkitFrontendPackageManager)' == 'npm'">$(RunicToolkitFrontendWorkspaceRoot)/package-lock.json</RunicToolkitFrontendLockFile>
  </PropertyGroup>

  <ItemGroup Condition="'$(RunicToolkitFrontendEnabled)' == 'true' and
                        '$(RunicToolkitFrontendNodeEnabled)' == 'true'">
    <Content Include="$(RunicToolkitFrontendBridgeAsset)"
             Link="$(RunicToolkitFrontendWebRoot)/vendor/runic-toolkit-mvvm-cswebui.mjs"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             Condition="Exists('$(RunicToolkitFrontendBridgeAsset)')" />
  </ItemGroup>

  <Target Name="RunicToolkitFrontendValidate"
          BeforeTargets="PrepareForBuild"
          Condition="'$(RunicToolkitFrontendEnabled)' == 'true'">
    <Error Condition="'$(RunicToolkitFrontendNodeEnabled)' != 'true' and
                      '$(RunicToolkitFrontendCompilerEnabled)' != 'true'"
           Text="Enable at least one Runic Toolkit frontend pipeline: Node/Vite or an external compiler integration." />
    <Error Condition="'$(RunicToolkitFrontendNodeEnabled)' == 'true' and
                      '$(RunicToolkitFrontendWorkspace)' == ''"
           Text="RunicToolkitFrontendWorkspace is required." />
    <Error Condition="'$(RunicToolkitFrontendNodeEnabled)' == 'true' and
                      '$(RunicToolkitFrontendPackageDirectory)' == ''"
           Text="RunicToolkitFrontendPackageDirectory is required." />
    <Error Condition="'$(RunicToolkitFrontendContractSource)' != '' and
                      ('$(RunicToolkitFrontendContractTypeScriptOutput)' == '' or
                       ('$(RunicToolkitFrontendContractCSharpFirst)' != 'true' and
                        '$(RunicToolkitFrontendContractCSharpOutput)' == ''))"
           Text="Both frontend contract output paths are required when a contract source is configured." />
  </Target>

  <Target Name="RunicToolkitFrontendGenerateContracts"
          DependsOnTargets="RunicToolkitFrontendValidate"
          Condition="'$(RunicToolkitFrontendEnabled)' == 'true' and
                     '$(RunicToolkitFrontendNodeEnabled)' == 'true' and
                     '$(RunicToolkitFrontendContractSource)' != '' and
                     '$(RunicToolkitFrontendContractCSharpFirst)' != 'true'">
    <Exec Command="$(RunicToolkitFrontendContractGenerateCommand)"
          WorkingDirectory="$(RunicToolkitFrontendWorkspaceRoot)" />
  </Target>

  <Target Name="RunicToolkitFrontendGenerateContractsCSharpFirst"
          AfterTargets="CoreCompile"
          Condition="'$(RunicToolkitFrontendEnabled)' == 'true' and
                     '$(RunicToolkitFrontendNodeEnabled)' == 'true' and
                     '$(RunicToolkitFrontendContractCSharpFirst)' == 'true'">
    <Error Condition="!Exists('$(RunicToolkitFrontendContractArtifact)')"
           Code="RTKFE0002"
           Text="The C# frontend contract generator did not produce '$(RunicToolkitFrontendContractArtifact)'." />
    <Exec Command="$(RunicToolkitFrontendContractGenerateCommand)"
          WorkingDirectory="$(RunicToolkitFrontendWorkspaceRoot)" />
  </Target>

  <Target Name="RunicToolkitFrontendResolveInstall"
          DependsOnTargets="RunicToolkitFrontendValidate"
          Condition="'$(RunicToolkitFrontendEnabled)' == 'true' and
                     '$(RunicToolkitFrontendNodeEnabled)' == 'true' and
                     '$(RunicToolkitFrontendInstall)' == 'true'">
    <Error Condition="'$(RunicToolkitFrontendLockFile)' == ''"
           Text="RunicToolkitFrontendLockFile is required for package manager '$(RunicToolkitFrontendPackageManager)'." />
    <Error Condition="!Exists('$(RunicToolkitFrontendLockFile)')"
           Text="The frontend lock file '$(RunicToolkitFrontendLockFile)' does not exist. Restore or generate it, or set RunicToolkitFrontendLockFile explicitly." />
  </Target>

  <Target Name="RunicToolkitFrontendInstall"
          BeforeTargets="PrepareForBuild"
          DependsOnTargets="RunicToolkitFrontendResolveInstall"
          Condition="'$(RunicToolkitFrontendEnabled)' == 'true' and
                     '$(RunicToolkitFrontendNodeEnabled)' == 'true' and
                     '$(RunicToolkitFrontendInstall)' == 'true'">
    <Exec Command="node &quot;$(RunicToolkitFrontendInstallCoordinator)&quot; &quot;$(RunicToolkitFrontendWorkspaceRoot)&quot; &quot;$(RunicToolkitFrontendInstallCacheDirectory)&quot; &quot;$(RunicToolkitFrontendPackageManager)&quot; &quot;$(RunicToolkitFrontendLockFile)&quot; &quot;$(RunicToolkitFrontendInstallCommand)&quot;"
          WorkingDirectory="$(RunicToolkitFrontendWorkspaceRoot)" />
  </Target>

  <Target Name="RunicToolkitFrontendBuild"
          BeforeTargets="PrepareForBuild"
          DependsOnTargets="RunicToolkitFrontendInstall"
          Condition="'$(RunicToolkitFrontendEnabled)' == 'true' and
                     '$(RunicToolkitFrontendNodeEnabled)' == 'true' and
                     '$(RunicToolkitFrontendBuild)' == 'true' and
                     '$(RunicToolkitFrontendContractCSharpFirst)' != 'true'">
    <Exec Command="$(RunicToolkitFrontendContractVerifyCommand)"
          WorkingDirectory="$(RunicToolkitFrontendWorkspaceRoot)"
          Condition="'$(RunicToolkitFrontendContractVerifyCommand)' != ''" />
    <Exec Command="$(RunicToolkitFrontendBuildCommand)"
          WorkingDirectory="$(RunicToolkitFrontendWorkspaceRoot)" />
  </Target>

  <Target Name="RunicToolkitFrontendBuildCSharpFirst"
          AfterTargets="RunicToolkitFrontendGenerateContractsCSharpFirst"
          DependsOnTargets="RunicToolkitFrontendInstall"
          Condition="'$(RunicToolkitFrontendEnabled)' == 'true' and
                     '$(RunicToolkitFrontendNodeEnabled)' == 'true' and
                     '$(RunicToolkitFrontendBuild)' == 'true' and
                     '$(RunicToolkitFrontendContractCSharpFirst)' == 'true'">
    <Exec Command="$(RunicToolkitFrontendContractVerifyCommand)"
          WorkingDirectory="$(RunicToolkitFrontendWorkspaceRoot)"
          Condition="'$(RunicToolkitFrontendContractVerifyCommand)' != ''" />
    <Exec Command="$(RunicToolkitFrontendBuildCommand)"
          WorkingDirectory="$(RunicToolkitFrontendWorkspaceRoot)" />
  </Target>

  <Target Name="RunicToolkitFrontendCopyToOutput"
          AfterTargets="Build"
          DependsOnTargets="RunicToolkitFrontendBuild;RunicToolkitFrontendBuildCSharpFirst"
          Condition="'$(RunicToolkitFrontendEnabled)' == 'true' and
                     '$(RunicToolkitFrontendNodeEnabled)' == 'true'">
    <MakeDir Directories="$(TargetDir)$(RunicToolkitFrontendWebRoot)" />
    <RemoveDir Condition="'$(RunicToolkitFrontendBuild)' == 'true'"
               Directories="$(TargetDir)$(RunicToolkitFrontendWebRoot)/assets;
                            $(TargetDir)$(RunicToolkitFrontendWebRoot)/simple;
                            $(TargetDir)$(RunicToolkitFrontendWebRoot)/advanced" />
    <ItemGroup>
      <_RunicToolkitFrontendOutput
        Include="$(RunicToolkitFrontendOutputDirectory)/**/*"
        Condition="'$(RunicToolkitFrontendBuild)' == 'true'" />
    </ItemGroup>
    <Copy SourceFiles="@(_RunicToolkitFrontendOutput)"
          DestinationFiles="@(_RunicToolkitFrontendOutput->'$(TargetDir)$(RunicToolkitFrontendWebRoot)/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          Condition="'$(RunicToolkitFrontendBuild)' == 'true'" />
  </Target>

  <Target Name="RunicToolkitFrontendCopyToPublish"
          AfterTargets="Publish"
          DependsOnTargets="RunicToolkitFrontendBuild;RunicToolkitFrontendBuildCSharpFirst"
          Condition="'$(RunicToolkitFrontendEnabled)' == 'true' and
                     '$(RunicToolkitFrontendNodeEnabled)' == 'true'">
    <MakeDir Directories="$(PublishDir)$(RunicToolkitFrontendWebRoot)" />
    <RemoveDir Condition="'$(RunicToolkitFrontendBuild)' == 'true'"
               Directories="$(PublishDir)$(RunicToolkitFrontendWebRoot)/assets;
                            $(PublishDir)$(RunicToolkitFrontendWebRoot)/simple;
                            $(PublishDir)$(RunicToolkitFrontendWebRoot)/advanced" />
    <ItemGroup>
      <_RunicToolkitFrontendPublish
        Include="$(RunicToolkitFrontendOutputDirectory)/**/*"
        Condition="'$(RunicToolkitFrontendBuild)' == 'true'" />
    </ItemGroup>
    <Copy SourceFiles="@(_RunicToolkitFrontendPublish)"
          DestinationFiles="@(_RunicToolkitFrontendPublish->'$(PublishDir)$(RunicToolkitFrontendWebRoot)/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          Condition="'$(RunicToolkitFrontendBuild)' == 'true'" />
  </Target>

  <Target Name="RunicToolkitFrontendWatchAssets"
          DependsOnTargets="RunicToolkitFrontendInstall"
          Condition="'$(RunicToolkitFrontendEnabled)' == 'true' and
                     '$(RunicToolkitFrontendNodeEnabled)' == 'true'">
    <Exec Command="npm run dev --workspace $(RunicToolkitFrontendWorkspace)"
          WorkingDirectory="$(RunicToolkitFrontendWorkspaceRoot)" />
  </Target>

  <Target Name="RunicToolkitFrontendWatch"
          DependsOnTargets="RunicToolkitFrontendValidate"
          Condition="'$(RunicToolkitFrontendEnabled)' == 'true'">
    <Exec Command="&quot;$(DotNetHostPath)&quot; watch --project &quot;$(RunicToolkitDevProject)&quot; run --no-launch-profile -- $(RunicToolkitDevRunArguments)"
          Condition="'$(DotNetHostPath)' != ''" />
    <Exec Command="dotnet watch --project &quot;$(RunicToolkitDevProject)&quot; run --no-launch-profile -- $(RunicToolkitDevRunArguments)"
          Condition="'$(DotNetHostPath)' == ''" />
  </Target>
</Project>
