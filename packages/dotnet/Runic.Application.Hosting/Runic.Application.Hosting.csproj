<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../../eng/build/application.props" />
  <PropertyGroup>
    <TargetFramework>$(RunicToolkitDefaultTargetFramework)</TargetFramework>
    <RunicToolkitShippingProject>true</RunicToolkitShippingProject>
    <AssemblyName>Runic.Application.Hosting</AssemblyName>
    <RootNamespace>Runic.Application.Hosting</RootNamespace>
    <PackageId>Runic.Application.Hosting</PackageId>
    <Description>Generic Host and ASP.NET Core integration for Runic.Application.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- Generate the library-owned minimal endpoints at build time so AOT-incompatible
         route handlers fail during ordinary verification builds. -->
    <EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Runic.Application\Runic.Application.csproj" />
    <ProjectReference Include="..\Runic.Application.Bridge\Runic.Application.Bridge.csproj" />
    <ProjectReference Include="..\Runic.Assets\Runic.Assets.csproj" />
    <ProjectReference Include="../Runic.Translations/Runic.Translations.csproj" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup><None Include="README.md" Pack="true" PackagePath="\" /></ItemGroup>
  <Import Project="../../../eng/build/application.targets" />
</Project>
