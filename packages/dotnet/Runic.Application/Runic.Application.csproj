<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../../eng/build/application.props" />
  <PropertyGroup>
    <TargetFramework>$(RunicToolkitDefaultTargetFramework)</TargetFramework>
    <RunicToolkitShippingProject>true</RunicToolkitShippingProject>
    <AssemblyName>Runic.Application</AssemblyName>
    <RootNamespace>Runic.Application</RootNamespace>
    <PackageId>Runic.Application</PackageId>
    <Description>Generated composition and deterministic lifecycle foundation for Runic applications.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <ProjectReference Include="..\Runic.Application.Generators\Runic.Application.Generators.csproj"
                      PrivateAssets="all"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\Runic.Application.Generators\bin\$(Configuration)\$(RunicToolkitGeneratorTargetFramework)\Runic.Application.Generators.dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs" />
  </ItemGroup>
  <Import Project="../../../eng/build/application.targets" />
</Project>
