<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../../eng/build/application.props" />
  <PropertyGroup>
    <TargetFramework>$(RunicApplicationDefaultTargetFramework)</TargetFramework>
    <RunicApplicationShippingProject>true</RunicApplicationShippingProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>Runic.Application.Views.Translations</PackageId>
    <Description>Optional English and German text for Runic's own messages (validation, field errors, dialog titles, error pages, standard menus), as a Runic Translations library catalog that follows the application's locale.</Description>
    <PackageTags>runic-artifex;application;i18n;localization;translations;dotnet;nativeaot</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- Packs runic/runic-views/ (runic.json, sources, contract.json) and buildTransitive/Runic.Application.Views.Translations.props,
         so an application overrides single messages in its runic.json:
         "overrides": [{ "catalog": "runic-views", "from": ["Runic.Application.Views.Translations", "@runic-artifex/views-translations"] }]. -->
    <RunicTranslationsPackCatalog>true</RunicTranslationsPackCatalog>
    <!-- The generated catalog classes are internal (translations/runic.json), as in Runic.Translations.CommandLine: their
         shape belongs to the Translations generator, not to Runic's public API. RunicViewsTranslations exposes what
         applications use. Packing stamps the Runic.Translations dependency [0.9.1, 0.10.0-0.0) after NuGet's pack checks. -->
    <RunicPackageValidationBaselineMissing>true</RunicPackageValidationBaselineMissing>
    <RunicPackageFirstReleaseVersion>0.17.0</RunicPackageFirstReleaseVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Runic.Translations" />
    <PackageReference Include="Runic.Translations.Hosting" />
    <PackageReference Include="Runic.Translations.Build" PrivateAssets="all" />
    <ProjectReference Include="../Runic.Application.Views/Runic.Application.Views.csproj" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <InternalsVisibleTo Include="Runic.Application.Views.Translations.Tests" />
  </ItemGroup>
  <Import Project="../../../eng/build/application.targets" />
</Project>
