<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../../eng/build/desktop.props" />
  <PropertyGroup>
    <AssemblyName>Runic.Desktop.Gtk4</AssemblyName>
    <RootNamespace>Runic.Desktop.Gtk4</RootNamespace>
    <PackageId>Runic.Desktop.Gtk4</PackageId>
    <Title>Runic Desktop GTK 4</Title>
    <Description>Explicit GTK 4 and WebKitGTK 6 embedded presentation provider for Runic Desktop.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Runic.Desktop/Runic.Desktop.csproj" />
    <PackageReference Include="GirCore.Gtk-4.0" />
    <PackageReference Include="GirCore.WebKit-6.0" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <Compile Include="../Runic.Desktop/Internal/Gtk4NativeLibraries.cs" Link="Shared/Gtk4NativeLibraries.cs" />
    <Compile Include="../Runic.Desktop/Internal/WebKitGtkKeyboard.cs" Link="Shared/WebKitGtkKeyboard.cs" />
    <Compile Include="../Runic.Desktop/Internal/WebKitGtkWebProcess.cs" Link="Shared/WebKitGtkWebProcess.cs" />
    <Compile Include="../Runic.Desktop/Internal/FileDropSupport.cs" Link="Shared/FileDropSupport.cs" />
    <Compile Include="../Runic.Desktop/Internal/GtkDragSupport.cs" Link="Shared/GtkDragSupport.cs" />
    <Compile Include="../Runic.Desktop/Internal/WebKitGtkMediaFrames.cs" Link="Shared/WebKitGtkMediaFrames.cs" />
    <Compile Include="../Runic.Desktop/Internal/WebContentRules.cs" Link="Shared/WebContentRules.cs" />
    <Compile Include="../Runic.Desktop/Internal/WebKitGtkWebContent.cs" Link="Shared/WebKitGtkWebContent.cs" />
    <Compile Include="../Runic.Desktop/Internal/WindowPlacementClamp.cs" Link="Shared/WindowPlacementClamp.cs" />
    <Compile Include="../Runic.Desktop/Internal/DesktopMonitorSource.cs" Link="Shared/DesktopMonitorSource.cs" />
    <Compile Include="../Runic.Desktop/Internal/DesktopMenuPlanner.cs" Link="Shared/DesktopMenuPlanner.cs" />
    <Compile Include="../Runic.Platform/DesktopShortcutKeys.cs" Link="Shared/DesktopShortcutKeys.cs" />
    <Compile Include="../Runic.Desktop/Internal/GtkMenus.cs" Link="Shared/GtkMenus.cs" />
    <Compile Include="../Runic.Desktop/Internal/DBusMenuServer.cs" Link="Shared/DBusMenuServer.cs" />
    <Compile Include="../Runic.Desktop/Internal/LinuxGlobalMenu.cs" Link="Shared/LinuxGlobalMenu.cs" />
    <Compile Include="../Runic.Platform/DesktopUriPolicy.cs" Link="Shared/DesktopUriPolicy.cs" />
    <Compile Include="../Runic.Platform/DesktopDragRules.cs" Link="Shared/DesktopDragRules.cs" />
    <EmbeddedResource Include="../Runic.Desktop/Internal/WebKitGtkKeyboard.js" Link="Shared/WebKitGtkKeyboard.js" LogicalName="Runic.Desktop.WebKitGtkKeyboard.js" />
  </ItemGroup>
</Project>
