<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../../eng/build/desktop.props" />
  <PropertyGroup>
    <AssemblyName>Runic.Desktop.Gtk4</AssemblyName>
    <RootNamespace>Runic.Desktop.Gtk4</RootNamespace>
    <PackageId>Runic.Desktop.Gtk4</PackageId>
    <Title>Runic Desktop GTK 4</Title>
    <Description>Explicit GTK 4 and WebKitGTK 6 embedded presentation provider for Runic Desktop.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <!-- The GTK 4 window host honours Runic Desktop's experimental runic-host/1 data store option, and shows its
         experimental side panel (RUNICDESK104). -->
    <NoWarn>$(NoWarn);RUNICDESK103;RUNICDESK104</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Runic.Desktop/Runic.Desktop.csproj" />
    <PackageReference Include="GirCore.Gtk-4.0" />
    <PackageReference Include="GirCore.WebKit-6.0" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <!-- Runic.Desktop's internal helpers come from Runic.Desktop itself (InternalsVisibleTo, exact-version pin). These
         Runic.Platform internals are visible to Runic.Desktop only, so this assembly compiles its own copies. -->
    <Compile Include="../Runic.Platform/DesktopShortcutKeys.cs" Link="Shared/DesktopShortcutKeys.cs" />
    <Compile Include="../Runic.Platform/DesktopUriPolicy.cs" Link="Shared/DesktopUriPolicy.cs" />
    <Compile Include="../Runic.Platform/DesktopDragRules.cs" Link="Shared/DesktopDragRules.cs" />
  </ItemGroup>
</Project>
