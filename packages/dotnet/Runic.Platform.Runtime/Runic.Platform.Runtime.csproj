<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../../eng/build/platform.props" />
  <PropertyGroup>
    <TargetFramework>$(RunicApplicationDefaultTargetFramework)</TargetFramework>
    <RunicApplicationShippingProject>true</RunicApplicationShippingProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>Runic.Platform.Runtime</AssemblyName>
    <RootNamespace>Runic.Platform.Runtime</RootNamespace>
    <PackageId>Runic.Platform.Runtime</PackageId>
    <Description>Single instance, requests to open files and URLs, and file transfers for Runic applications, and the contract for native platform providers.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Runic.Platform/Runic.Platform.csproj" />
    <!-- The URI launch policy of Runic.Platform; the Windows and macOS providers use this copy. -->
    <Compile Include="../Runic.Platform/DesktopUriPolicy.cs" Link="Shared/DesktopUriPolicy.cs" />
    <Compile Include="../Runic.Platform/DesktopMenuRules.cs" Link="Shared/DesktopMenuRules.cs" />
    <Compile Include="../Runic.Platform/DesktopMessageBoxRules.cs" Link="Shared/DesktopMessageBoxRules.cs" />
    <!-- The key tables and the global shortcut rules; Runic.Desktop uses Runic.Platform's copies. -->
    <Compile Include="../Runic.Platform/DesktopShortcutKeys.cs" Link="Shared/DesktopShortcutKeys.cs" />
    <Compile Include="../Runic.Platform/DesktopGlobalShortcutRules.cs" Link="Shared/DesktopGlobalShortcutRules.cs" />
    <Compile Include="../Runic.Platform/DesktopClipboardRules.cs" Link="Shared/DesktopClipboardRules.cs" />
    <Compile Include="../Runic.Platform/DesktopTaskbarRules.cs" Link="Shared/DesktopTaskbarRules.cs" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <Import Project="../../../eng/build/application.targets" />
</Project>
