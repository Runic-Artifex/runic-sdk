<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../../eng/build/application.props" />
  <PropertyGroup>
    <TargetFramework>$(RunicToolkitDefaultTargetFramework)</TargetFramework>
    <RunicToolkitShippingProject>true</RunicToolkitShippingProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Runic.Platform.Runtime</AssemblyName>
    <RootNamespace>Runic.Platform.Runtime</RootNamespace>
    <PackageId>Runic.Platform.Runtime</PackageId>
    <Description>Shared scoped lifetime, file leases, atomic writes and native provider infrastructure.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Runic.Platform/Runic.Platform.csproj" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <Import Project="../../../eng/build/application.targets" />
</Project>
