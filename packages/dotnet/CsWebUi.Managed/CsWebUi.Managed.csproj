<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>CsWebUi.Managed</AssemblyName>
    <RootNamespace>CsWebUi.Managed</RootNamespace>
    <PackageId>CsWebUi.Managed</PackageId>
    <Title>CS-WebUI Managed</Title>
    <Description>Managed-first WebUI-compatible windows, hosting, and JavaScript bindings for .NET.</Description>
    <PackageTags>runic-artifex;webui;dotnet;managed;kestrel;desktop</PackageTags>
    <NoWarn>$(NoWarn);CA1720</NoWarn>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <InternalsVisibleTo Include="CsWebUi.Managed.Tests" />
    <None Update="README.md" Pack="true" PackagePath="" />
    <None Include="$(MSBuildThisFileDirectory)..\..\NOTICE" Pack="true" PackagePath="" />
    <None Include="$(MSBuildThisFileDirectory)..\..\eng\licenses\WebUI-LICENSE.txt" Pack="true" PackagePath="licenses/WebUI/" />
  </ItemGroup>
</Project>
