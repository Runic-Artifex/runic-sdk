<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../../eng/build/platform.props" />
  <PropertyGroup>
    <TargetFramework>$(RunicApplicationDefaultTargetFramework)</TargetFramework>
    <RunicApplicationShippingProject>true</RunicApplicationShippingProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>Runic.Platform.Linux.DBus</PackageId>
    <Description>D-Bus client and service API for Runic applications on Linux: connections, typed values, proxies, exported objects, signals and properties.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- Not yet published: package validation needs a baseline release. -->
    <RunicPackageValidationBaselineMissing>true</RunicPackageValidationBaselineMissing>
    <RunicPackageFirstReleaseVersion>0.8.0-preview.5</RunicPackageFirstReleaseVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Runic.Platform/Runic.Platform.csproj" />
    <!-- The wire implementation. No Tmds.DBus type appears in this package's public API. -->
    <PackageReference Include="Tmds.DBus.Protocol" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <InternalsVisibleTo Include="Runic.Platform.Linux.DBus.Tests" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="NOTICE" Pack="true" PackagePath="" />
    <None Include="licenses/Tmds.DBus-LICENSE.txt" Pack="true" PackagePath="licenses/" />
    <None Include="buildTransitive/Runic.Platform.Linux.DBus.props" Pack="true" PackagePath="buildTransitive/" />
    <!-- The source generator ships inside this package. -->
    <!-- A publish's RuntimeIdentifier and PublishAot apply to the application, not to the netstandard2.0 generator. -->
    <ProjectReference Include="../Runic.Platform.Linux.DBus.Generator/Runic.Platform.Linux.DBus.Generator.csproj" ReferenceOutputAssembly="false" PrivateAssets="all"
        UndefineProperties="RuntimeIdentifier;SelfContained;PublishAot;IlcTreatWarningsAsErrors" />
    <None Include="../Runic.Platform.Linux.DBus.Generator/bin/$(Configuration)/netstandard2.0/Runic.Platform.Linux.DBus.Generator.dll" Pack="true" PackagePath="analyzers/dotnet/cs/" Visible="false" />
  </ItemGroup>
  <Import Project="../../../eng/build/application.targets" />
</Project>
