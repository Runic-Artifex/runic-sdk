<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../../eng/build/application.props" />
  <PropertyGroup>
    <TargetFramework>$(RunicApplicationDefaultTargetFramework)</TargetFramework>
    <RunicApplicationShippingProject>true</RunicApplicationShippingProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>Runic.Application.Views.ReactiveUI.Reactive</PackageId>
    <Description>System.Reactive-flavor ReactiveUI model-context scheduling, routing, view location, and activation for Runic Views.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- Selects the System.Reactive namespaces in the source shared with
         Runic.Application.Views.ReactiveUI. Only the scheduler adapter differs. -->
    <DefineConstants>$(DefineConstants);SYSTEM_REACTIVE</DefineConstants>
    <!-- Packs buildTransitive/$(PackageId).props with the diagnostics help links (eng/build/release-links.targets). -->
    <RunicPackDiagnosticsHelpLinks>true</RunicPackDiagnosticsHelpLinks>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="Runic.Application.Views.Generated" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="ReactiveUI.Reactive" />
    <!-- Direct references bound every package whose types the public API exposes (eng/release/README.md). -->
    <PackageReference Include="ReactiveUI.Core" />
    <PackageReference Include="ReactiveUI.Binding.Reactive" />
    <PackageReference Include="System.Reactive" />
    <ProjectReference Include="../Runic.Application.Views/Runic.Application.Views.csproj" />
    <Compile Include="../Runic.Application.Views.ReactiveUI/ReactiveCommandExecution.cs" Link="Shared/ReactiveCommandExecution.cs" />
    <Compile Include="../Runic.Application.Views.ReactiveUI/ReactiveInteractionDescriptor.cs" Link="Shared/ReactiveInteractionDescriptor.cs" />
    <Compile Include="../Runic.Application.Views.ReactiveUI/ReactivePresentation.cs" Link="Shared/ReactivePresentation.cs" />
    <Compile Include="../Runic.Application.Views.ReactiveUI/ReactiveLog.cs" Link="Shared/ReactiveLog.cs" />
    <Compile Include="../Runic.Application.Views.ReactiveUI/ReactiveBridgeExceptionExtensions.cs" Link="Shared/ReactiveBridgeExceptionExtensions.cs" />
    <Compile Include="../Runic.Application.Views.ReactiveUI/ReactiveServiceCollectionExtensions.cs" Link="Shared/ReactiveServiceCollectionExtensions.cs" />
    <Compile Include="../Runic.Application.Views.ReactiveUI/ReactiveSchedulerDiagnostics.cs" Link="Shared/ReactiveSchedulerDiagnostics.cs" />
    <Compile Include="../Runic.Application.Views.ReactiveUI/ReactiveUIBuilderExtensions.cs" Link="Shared/ReactiveUIBuilderExtensions.cs" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="buildTransitive/Runic.Application.Views.ReactiveUI.Reactive.targets" Pack="true" PackagePath="buildTransitive/" />
  </ItemGroup>
  <Import Project="../../../eng/build/application.targets" />
</Project>
