<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(RunicTranslationsGeneratorTargetFramework)</TargetFramework>
    <AssemblyName>RunicTranslations.Build</AssemblyName>
    <RootNamespace>RunicTranslations.Build</RootNamespace>
    <PackageId>RunicTranslations.Build</PackageId>
    <Description>Deterministic MSBuild integration for RunicTranslations translation artifacts.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <None Update="README.md" Pack="true" PackagePath="\" />
    <None Update="build\RunicTranslations.Build.props"
          Pack="true"
          PackagePath="build\RunicTranslations.Build.props" />
    <None Update="build\RunicTranslations.Build.targets"
          Pack="true"
          PackagePath="build\RunicTranslations.Build.targets" />
  </ItemGroup>
</Project>
