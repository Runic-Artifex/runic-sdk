<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(RunicToolkitDefaultTargetFramework)</TargetFramework>
    <RunicToolkitShippingProject>true</RunicToolkitShippingProject>
    <AssemblyName>RunicToolkit.Hosting.Build</AssemblyName>
    <RootNamespace>RunicToolkit.Hosting.Build</RootNamespace>
    <PackageId>RunicToolkit.Hosting.Build</PackageId>
    <Description>Deterministic frontend asset manifest construction for RunicToolkit hosting.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <NoWarn>$(NoWarn);NU5100</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RunicToolkit.Hosting.Abstractions\RunicToolkit.Hosting.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Microsoft.Build.Framework">
      <HintPath>$(MSBuildToolsPath)/Microsoft.Build.Framework.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Microsoft.Build.Utilities.Core">
      <HintPath>$(MSBuildToolsPath)/Microsoft.Build.Utilities.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Update="README.md" Pack="true" PackagePath="\" />
    <None Include="buildTransitive\RunicToolkit.Hosting.Build.props"
          Pack="true"
          PackagePath="buildTransitive\" />
    <None Include="buildTransitive\RunicToolkit.Hosting.Build.targets"
          Pack="true"
          PackagePath="buildTransitive\" />
    <None Include="$(TargetPath)"
          Pack="true"
          PackagePath="tasks\net10.0\$(TargetFileName)" />
    <None Include="$(TargetDir)RunicToolkit.Hosting.Abstractions.dll"
          Pack="true"
          PackagePath="tasks\net10.0\RunicToolkit.Hosting.Abstractions.dll" />
  </ItemGroup>
</Project>
