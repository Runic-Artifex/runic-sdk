<Project>
  <UsingTask TaskName="RunicToolkit.Hosting.Build.GenerateFrontendAssetManifestTask"
             AssemblyFile="$(MSBuildThisFileDirectory)..\tasks\net10.0\RunicToolkit.Hosting.Build.dll" />

  <Target Name="RunicToolkitGenerateFrontendAssetManifest"
          BeforeTargets="PrepareForBuild"
          Condition="'$(RunicToolkitGenerateFrontendAssets)' == 'true'">
    <Error Condition="'$(RunicToolkitFrontendOutputDirectory)' == ''"
           Code="RTKHOST0006"
           Text="RunicToolkitFrontendOutputDirectory must be set when frontend asset generation is enabled." />
    <Error Condition="'$(RunicToolkitFrontendEntryPoint)' == ''"
           Code="RTKHOST0006"
           Text="RunicToolkitFrontendEntryPoint must select exactly one entry point." />
    <Error Condition="'$(RunicToolkitFrontendAssetMode)' != 'Directory' and '$(RunicToolkitFrontendAssetMode)' != 'Copy' and '$(RunicToolkitFrontendAssetMode)' != 'Embed'"
           Code="RTKHOST0006"
           Text="RunicToolkitFrontendAssetMode must be Directory, Copy, or Embed." />

    <Exec Condition="'$(RunicToolkitFrontendBuildCommand)' != ''"
          Command="$(RunicToolkitFrontendBuildCommand)"
          WorkingDirectory="$(MSBuildProjectDirectory)" />

    <GenerateFrontendAssetManifestTask
        OutputDirectory="$(RunicToolkitFrontendOutputDirectory)"
        EntryPoint="$(RunicToolkitFrontendEntryPoint)"
        ManifestPath="$(RunicToolkitFrontendManifestPath)"
        VerifyOnly="$(RunicToolkitVerifyFrontendManifest)">
      <Output TaskParameter="Assets" ItemName="_RunicToolkitFrontendAsset" />
    </GenerateFrontendAssetManifestTask>

    <ItemGroup Condition="'$(RunicToolkitFrontendAssetMode)' == 'Copy'">
      <Content Include="@(_RunicToolkitFrontendAsset)"
               Link="wwwroot\%(_RunicToolkitFrontendAsset.RelativePath)"
               CopyToOutputDirectory="PreserveNewest"
               CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
    <ItemGroup Condition="'$(RunicToolkitFrontendAssetMode)' == 'Embed'">
      <EmbeddedResource Include="@(_RunicToolkitFrontendAsset)"
                        LogicalName="RunicToolkit.Frontend.%(_RunicToolkitFrontendAsset.RelativePath)" />
    </ItemGroup>
  </Target>
</Project>
