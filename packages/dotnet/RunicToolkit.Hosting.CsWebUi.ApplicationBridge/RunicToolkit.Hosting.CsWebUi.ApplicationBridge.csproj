<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(RunicToolkitDefaultTargetFramework)</TargetFramework>
    <RunicToolkitShippingProject>true</RunicToolkitShippingProject>
    <AssemblyName>RunicToolkit.Hosting.CsWebUi.ApplicationBridge</AssemblyName>
    <RootNamespace>RunicToolkit.Hosting.CsWebUi.ApplicationBridge</RootNamespace>
    <PackageId>RunicToolkit.Hosting.CsWebUi.ApplicationBridge</PackageId>
    <Version>1.0.0-beta.1</Version>
    <Description>Single-binding CS-WebUI transport for RunicToolkit Application Bridge sessions.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../RunicToolkit.ApplicationBridge/RunicToolkit.ApplicationBridge.csproj" />
    <ProjectReference Include="../RunicToolkit.Hosting.CsWebUi.App/RunicToolkit.Hosting.CsWebUi.App.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CsWebUi" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="PUBLIC-API.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
