<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(RunicToolkitDefaultTargetFramework)</TargetFramework>
    <RunicToolkitShippingProject>true</RunicToolkitShippingProject>
    <AssemblyName>RunicToolkit.Hosting.CsWebUi</AssemblyName>
    <RootNamespace>RunicToolkit.Hosting.CsWebUi</RootNamespace>
    <PackageId>RunicToolkit.Hosting.CsWebUi</PackageId>
    <Version>1.0.0-beta.1</Version>
    <Description>CsWebUi browser-host adapter for RunicToolkit Hosting.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RunicToolkit.Hosting.Abstractions\RunicToolkit.Hosting.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CsWebUi" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
