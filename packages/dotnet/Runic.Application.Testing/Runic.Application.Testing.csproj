<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../../eng/build/application.props" />
  <PropertyGroup>
    <TargetFramework>$(RunicApplicationDefaultTargetFramework)</TargetFramework>
    <RunicApplicationShippingProject>true</RunicApplicationShippingProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>Runic.Application.Testing</PackageId>
    <Description>Headless Window and View test host for Runic applications.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- The experimental runic-host/1 API links its RUNICDESK103 entry at the release tag. -->
    <RunicGenerateReleaseLinks>true</RunicGenerateReleaseLinks>
    <!-- The package uses its own experimental runic-host/1 API. -->
    <NoWarn>$(NoWarn);RUNICDESK103</NoWarn>
    <!-- ...and its experimental side panel API (sdk#864). -->
    <NoWarn>$(NoWarn);RUNICDESK104</NoWarn>
    <!-- ...and its experimental close drain API (sdk#900). -->
    <NoWarn>$(NoWarn);RUNICDESK105</NoWarn>
    <RunicApplicationFrontendGenerationEnabled>false</RunicApplicationFrontendGenerationEnabled>
    <!-- A test-only package: it reflects over the application's ViewModels in an
         untrimmed test process. -->
    <RunicTrimmable>false</RunicTrimmable>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="Runic.Application.Views.Generated" />
  </ItemGroup>
  <ItemGroup>
    <!-- The tests check internal helpers, such as the serve-only parsers, directly. -->
    <InternalsVisibleTo Include="Runic.Application.Testing.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Runic.Application.Views/Runic.Application.Views.csproj" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <!-- The test clipboard checks writes with the real clipboard's rules, as Runic.Platform.Runtime does. -->
    <Compile Include="../Runic.Platform/DesktopClipboardRules.cs" Link="Shared/DesktopClipboardRules.cs" />
    <!-- RunicTestHost speaks the Runic host protocol with the code the guest and the host share. -->
    <Compile Include="../Runic.Application.Views.Desktop/Hosting/Protocol/*.cs" Link="Shared/Hosting/%(Filename)%(Extension)" />
  </ItemGroup>
  <Import Project="../../../eng/build/application.targets" />
</Project>
