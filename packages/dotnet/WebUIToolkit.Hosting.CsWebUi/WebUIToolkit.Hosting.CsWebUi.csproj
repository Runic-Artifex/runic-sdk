<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(WebUIToolkitDefaultTargetFramework)</TargetFramework>
    <WebUIToolkitShippingProject>true</WebUIToolkitShippingProject>
    <AssemblyName>WebUIToolkit.Hosting.CsWebUi</AssemblyName>
    <RootNamespace>WebUIToolkit.Hosting.CsWebUi</RootNamespace>
    <PackageId>WebUIToolkit.Hosting.CsWebUi</PackageId>
    <Version>1.0.0-beta.1</Version>
    <Description>CsWebUi browser-host adapter for WebUIToolkit Hosting.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WebUIToolkit.Hosting.Abstractions\WebUIToolkit.Hosting.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CsWebUi" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
