<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../../eng/build/application.props" />
  <PropertyGroup>
    <TargetFramework>$(RunicToolkitDefaultTargetFramework)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <PackageId>Runic.Platform.Administration.Windows</PackageId>
    <Description>Host-independent Windows administration capabilities for Runic.</Description>

    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>

  </PropertyGroup>
  <ItemGroup><InternalsVisibleTo Include="Runic.Platform.Administration.Windows.Tests" /></ItemGroup>
  <Import Project="../../../eng/build/application.targets" />
</Project>
