<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(WebUIToolkitDefaultTargetFramework)</TargetFramework>
    <WebUIToolkitShippingProject>true</WebUIToolkitShippingProject>
    <PackageId>WebUIToolkit.DependencyNotices.Npm</PackageId>
    <Description>BCL-only deterministic npm lockfile and restored-package inventory adapter.</Description>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\WebUIToolkit.DependencyNotices.Core\WebUIToolkit.DependencyNotices.Core.csproj" />
  </ItemGroup>
</Project>
