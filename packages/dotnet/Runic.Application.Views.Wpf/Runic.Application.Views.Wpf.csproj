<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../../eng/build/application.props" />
  <PropertyGroup>
    <TargetFramework>$(RunicApplicationDefaultTargetFramework)-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RunicTrimmable>false</RunicTrimmable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RunicApplicationShippingProject>true</RunicApplicationShippingProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>Runic.Application.Views.Wpf</PackageId>
    <Description>Optional WPF child WebView presentation for existing Runic ViewModels.</Description>
    <PackageTags>runic-artifex;wpf;webview;mvvm;dotnet</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- The control carries its Bridge over Runic.Desktop's experimental presentation transport. -->
    <NoWarn>$(NoWarn);RUNICDESK101</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Runic.Application.Views.Desktop/Runic.Application.Views.Desktop.csproj" />
    <!-- RunicViewHost shares ViewHost's inherited Services property, so one provider reaches both hosts. -->
    <ProjectReference Include="../Runic.Navigation.Wpf/Runic.Navigation.Wpf.csproj" />
    <InternalsVisibleTo Include="Runic.Application.Views.Wpf.Tests" />
    <InternalsVisibleTo Include="Runic.Application.Views.Wpf.Windows.Tests" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="build/Runic.Application.Views.Wpf.props" Pack="true" PackagePath="buildTransitive/Runic.Application.Views.Wpf.props" />
  </ItemGroup>
  <Import Project="../../../eng/build/application.targets" />
</Project>
