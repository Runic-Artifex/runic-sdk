<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../../eng/build/application.props" />
  <PropertyGroup>
    <TargetFramework>$(RunicApplicationDefaultTargetFramework)</TargetFramework>
    <RunicApplicationShippingProject>true</RunicApplicationShippingProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>Runic.Navigation.ReactiveUI</PackageId>
    <Description>ReactiveUI observables, commands and interaction leave confirmation for Runic.Navigation regions and entries.</Description>
    <PackageTags>runic-artifex;navigation;reactiveui;mvvm;dotnet</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- Packs buildTransitive/$(PackageId).props with the diagnostics help links (eng/build/release-links.targets). -->
    <RunicPackDiagnosticsHelpLinks>true</RunicPackDiagnosticsHelpLinks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ReactiveUI" />
    <!-- Direct references bound every package whose types the public API exposes (eng/release/README.md). -->
    <PackageReference Include="ReactiveUI.Binding" />
    <PackageReference Include="ReactiveUI.Disposables" />
    <PackageReference Include="ReactiveUI.Primitives" />
    <ProjectReference Include="../Runic.Navigation/Runic.Navigation.csproj" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <!-- RUNICNAV002: both navigation flavors in one application. -->
    <None Include="buildTransitive/Runic.Navigation.ReactiveUI.targets" Pack="true" PackagePath="buildTransitive/Runic.Navigation.ReactiveUI.targets" />
  </ItemGroup>
  <Import Project="../../../eng/build/application.targets" />
</Project>
