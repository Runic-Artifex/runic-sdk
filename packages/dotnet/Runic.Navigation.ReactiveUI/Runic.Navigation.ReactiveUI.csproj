<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../../eng/build/application.props" />
  <PropertyGroup>
    <TargetFramework>$(RunicApplicationDefaultTargetFramework)</TargetFramework>
    <RunicApplicationShippingProject>true</RunicApplicationShippingProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>Runic.Navigation.ReactiveUI</PackageId>
    <Description>ReactiveUI observables, a back command and model-context schedulers for Runic.Navigation regions.</Description>
    <PackageTags>runic-artifex;navigation;reactiveui;mvvm;dotnet</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- First published in 0.7.0-preview.4; remove after that release (eng/release/README.md). -->
    <RunicPackageValidationBaselineMissing>true</RunicPackageValidationBaselineMissing>
    <RunicPackageFirstReleaseVersion>0.7.0-preview.4</RunicPackageFirstReleaseVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="ReactiveUI" />
    <ProjectReference Include="../Runic.Navigation/Runic.Navigation.csproj" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <Import Project="../../../eng/build/application.targets" />
</Project>
