<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(RunicToolkitDefaultTargetFramework)</TargetFramework>
    <RunicToolkitShippingProject>true</RunicToolkitShippingProject>
    <AssemblyName>RunicToolkit.Hosting</AssemblyName>
    <RootNamespace>RunicToolkit.Hosting</RootNamespace>
    <PackageId>RunicToolkit.Hosting</PackageId>
    <Description>Deterministic application lifecycle orchestration for RunicToolkit.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RunicToolkit.Hosting.Abstractions\RunicToolkit.Hosting.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
