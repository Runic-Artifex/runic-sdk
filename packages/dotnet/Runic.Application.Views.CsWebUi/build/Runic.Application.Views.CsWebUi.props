<Project>
  <PropertyGroup>
    <!-- Host adapters turn Bridge generation on in every project that
         references them, directly or transitively. -->
    <RunicApplicationHostAdapter>true</RunicApplicationHostAdapter>
    <RunicApplicationFrontendCompositionType Condition="'$(RunicApplicationFrontendCompositionType)' == ''">$(MSBuildProjectName.Replace('-', '_').Replace(' ', '_')).RunicBridgeComposition</RunicApplicationFrontendCompositionType>
  </PropertyGroup>
</Project>
