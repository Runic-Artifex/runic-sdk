<Project>
  <!-- CS-WebUI serves a page that loads webui.js and its Views client. The
       client is copied as runic-views.js, the host-neutral name a page loads on
       every host, when RunicApplicationHost is cswebui. RunicViewsResolveHost in
       Runic.Application.Views sets RunicApplicationHost to the only host
       referenced before the build. The package keeps the source as
       www/runic-cswebui.js; 0.23 no longer copies it under that name (D072.11). -->
  <PropertyGroup>
    <_RunicApplicationHostNames>$(_RunicApplicationHostNames);cswebui</_RunicApplicationHostNames>
    <!-- The Views www/ mirror runs these first and records runic-views.js, so
         it deletes a copy that no host makes any more. -->
    <_RunicApplicationHostCopyTargets>$(_RunicApplicationHostCopyTargets);RunicViewsCopyCsWebUiClient</_RunicApplicationHostCopyTargets>
    <_RunicApplicationHostPublishCopyTargets>$(_RunicApplicationHostPublishCopyTargets);RunicViewsCopyCsWebUiClientForPublish</_RunicApplicationHostPublishCopyTargets>
    <!-- RunicApplicationFrontendDelivery=Embedded stages the client with the frontend instead of copying it. -->
    <_RunicApplicationHostStageTargets>$(_RunicApplicationHostStageTargets);RunicViewsStageCsWebUiClient</_RunicApplicationHostStageTargets>
  </PropertyGroup>
  <!-- sdk#1221: a browser window's Development DevTools Protocol endpoint (CsWebUiRemoteDebugging, D070.7) is for untrimmed
       development builds such as dotnet runic dev's, as in Runic.Desktop.targets: a trimmed or NativeAOT publish turns it
       off, so the trimmer removes it and its HTTP client. Only the publish, and once when both hosts add the switch. -->
  <Target Name="_RunicCsWebUiPublishFeatureSwitches" BeforeTargets="PrepareForILLink">
    <ItemGroup Condition="'@(RuntimeHostConfigurationOption->WithMetadataValue('Identity', 'Runic.Desktop.WebUiRemoteDebugging'))' == ''">
      <RuntimeHostConfigurationOption Include="Runic.Desktop.WebUiRemoteDebugging" Value="false" Trim="true" />
    </ItemGroup>
  </Target>
  <Target Name="RunicViewsStageCsWebUiClient" Condition="'$(RunicApplicationFrontendBootstrap)' != 'true'">
    <ItemGroup>
      <_RunicViewsEmbeddedHostFile Include="$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../www/runic-cswebui.js'))" RunicFrontendPath="runic-views.js"
          Condition="'$(RunicApplicationHost)' == 'cswebui'" />
    </ItemGroup>
  </Target>
  <Target Name="RunicViewsCopyCsWebUiClient" AfterTargets="Build"
          Condition="'$(RunicApplicationFrontendBootstrap)' != 'true' and '$(_RunicApplicationFrontendEmbedded)' != 'true'">
    <!-- The web root of Runic.Application.Views (RunicApplicationFrontendWebRoot, normalized), final when the target runs. -->
    <PropertyGroup>
      <_RunicViewsHostWebRoot>$([MSBuild]::ValueOrDefault('$(_RunicApplicationFrontendWebRoot)', 'www'))</_RunicViewsHostWebRoot>
    </PropertyGroup>
    <Copy SourceFiles="$(MSBuildThisFileDirectory)../www/runic-cswebui.js"
          DestinationFiles="$(TargetDir)$(_RunicViewsHostWebRoot)/runic-views.js"
          SkipUnchangedFiles="true"
          Condition="'$(RunicApplicationHost)' == 'cswebui'" />
    <ItemGroup Condition="'$(RunicApplicationHost)' == 'cswebui'">
      <_RunicBridgeWwwFile Include="$(TargetDir)$(_RunicViewsHostWebRoot)/runic-views.js" />
    </ItemGroup>
  </Target>
  <Target Name="RunicViewsCopyCsWebUiClientForPublish" AfterTargets="Publish"
          Condition="'$(RunicApplicationFrontendBootstrap)' != 'true' and '$(_RunicApplicationFrontendEmbedded)' != 'true'">
    <!-- The web root of Runic.Application.Views (RunicApplicationFrontendWebRoot, normalized), final when the target runs. -->
    <PropertyGroup>
      <_RunicViewsHostWebRoot>$([MSBuild]::ValueOrDefault('$(_RunicApplicationFrontendWebRoot)', 'www'))</_RunicViewsHostWebRoot>
    </PropertyGroup>
    <Copy SourceFiles="$(MSBuildThisFileDirectory)../www/runic-cswebui.js"
          DestinationFiles="$(PublishDir)$(_RunicViewsHostWebRoot)/runic-views.js"
          SkipUnchangedFiles="true"
          Condition="'$(RunicApplicationHost)' == 'cswebui'" />
    <ItemGroup Condition="'$(RunicApplicationHost)' == 'cswebui'">
      <_RunicBridgePublishedWwwFile Include="$(PublishDir)$(_RunicViewsHostWebRoot)/runic-views.js" />
    </ItemGroup>
  </Target>
</Project>
