<Project>
  <!-- CS-WebUI serves a page that loads webui.js and its Views client. The
       client is copied as runic-cswebui.js and, when RunicApplicationHost is
       cswebui, as runic-views.js, the host-neutral name a page can load on
       every host. RunicViewsResolveHost in Runic.Application.Views sets
       RunicApplicationHost to the only host referenced before the build. -->
  <PropertyGroup>
    <_RunicApplicationHostNames>$(_RunicApplicationHostNames);cswebui</_RunicApplicationHostNames>
    <!-- The Views www/ mirror runs these first and records runic-views.js, so
         it deletes a copy that no host makes any more. -->
    <_RunicApplicationHostCopyTargets>$(_RunicApplicationHostCopyTargets);RunicViewsCopyCsWebUiClient</_RunicApplicationHostCopyTargets>
    <_RunicApplicationHostPublishCopyTargets>$(_RunicApplicationHostPublishCopyTargets);RunicViewsCopyCsWebUiClientForPublish</_RunicApplicationHostPublishCopyTargets>
  </PropertyGroup>
  <Target Name="RunicViewsCopyCsWebUiClient" AfterTargets="Build"
          Condition="'$(RunicApplicationFrontendBootstrap)' != 'true'">
    <Copy SourceFiles="$(MSBuildThisFileDirectory)../www/runic-cswebui.js"
          DestinationFiles="$(TargetDir)www/runic-cswebui.js"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)../www/runic-cswebui.js"
          DestinationFiles="$(TargetDir)www/runic-views.js"
          SkipUnchangedFiles="true"
          Condition="'$(RunicApplicationHost)' == 'cswebui'" />
    <ItemGroup Condition="'$(RunicApplicationHost)' == 'cswebui'">
      <_RunicBridgeWwwFile Include="$(TargetDir)www/runic-views.js" />
    </ItemGroup>
  </Target>
  <Target Name="RunicViewsCopyCsWebUiClientForPublish" AfterTargets="Publish"
          Condition="'$(RunicApplicationFrontendBootstrap)' != 'true'">
    <Copy SourceFiles="$(MSBuildThisFileDirectory)../www/runic-cswebui.js"
          DestinationFiles="$(PublishDir)www/runic-cswebui.js"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)../www/runic-cswebui.js"
          DestinationFiles="$(PublishDir)www/runic-views.js"
          SkipUnchangedFiles="true"
          Condition="'$(RunicApplicationHost)' == 'cswebui'" />
    <ItemGroup Condition="'$(RunicApplicationHost)' == 'cswebui'">
      <_RunicBridgePublishedWwwFile Include="$(PublishDir)www/runic-views.js" />
    </ItemGroup>
  </Target>
</Project>
