<Project>
  <PropertyGroup>
    <RunicAssetsEmbeddedResourceName Condition="'$(RunicAssetsEmbeddedResourceName)' == ''">Runic.Assets.StaticFiles</RunicAssetsEmbeddedResourceName>
    <RunicAssetsEntryPoint Condition="'$(RunicAssetsEntryPoint)' == ''">index.html</RunicAssetsEntryPoint>
    <!-- RunicAssetsDistExclude defaults in Runic.Assets.props, so a project can empty it. -->
    <RunicAssetsPackerPath Condition="'$(RunicAssetsPackerPath)' == '' and Exists('$(MSBuildThisFileDirectory)..\tools\net10.0\Runic.Assets.Packer.dll')">$(MSBuildThisFileDirectory)..\tools\net10.0\Runic.Assets.Packer.dll</RunicAssetsPackerPath>
    <RunicAssetsPackerPath Condition="'$(RunicAssetsPackerPath)' == ''">$(MSBuildThisFileDirectory)..\..\..\..\tools\Runic.Assets.Packer\bin\$(Configuration)\net10.0\Runic.Assets.Packer.dll</RunicAssetsPackerPath>
    <_RunicAssetsDotNetHost Condition="'$(DotNetHostPath)' != ''">$(DotNetHostPath)</_RunicAssetsDotNetHost>
    <_RunicAssetsDotNetHost Condition="'$(_RunicAssetsDotNetHost)' == ''">dotnet</_RunicAssetsDotNetHost>
  </PropertyGroup>

  <ItemGroup Condition="'$(RunicAssetsDist)' != ''">
    <_RunicAssetsDistInput Include="$(RunicAssetsDist)\**\*" />
  </ItemGroup>

  <Target Name="RunicAssetsPackFileSystem"
          Condition="'$(RunicAssetsDist)' != '' and '$(DesignTimeBuild)' != 'true'"
          Inputs="$(MSBuildProjectFullPath);$(MSBuildThisFileFullPath);$(RunicAssetsPackerPath);@(_RunicAssetsDistInput)"
          Outputs="$(IntermediateOutputPath)runic-assets\$(MSBuildProjectName).runic-assets">
    <PropertyGroup>
      <_RunicAssetsGeneratedArchive>$(IntermediateOutputPath)runic-assets\$(MSBuildProjectName).runic-assets</_RunicAssetsGeneratedArchive>
      <!--
        A trailing backslash before the closing quote would escape it on the Windows command line.
        Ending with "\." keeps the same directory, including drive roots, without a backslash-quote.
      -->
      <_RunicAssetsDistArgument>$([MSBuild]::EnsureTrailingSlash('$(RunicAssetsDist)')).</_RunicAssetsDistArgument>
      <!-- RunicAssetsDefaultExcludes=false packs .git directories and .env* files too. -->
      <_RunicAssetsPackerOptions>--trusted-generated-output</_RunicAssetsPackerOptions>
      <_RunicAssetsPackerOptions Condition="'$(RunicAssetsDefaultExcludes)' == 'false'">$(_RunicAssetsPackerOptions) --no-default-excludes</_RunicAssetsPackerOptions>
    </PropertyGroup>

    <Error Code="RAS2001" File="$(MSBuildProjectFullPath)" HelpLink="$(_RunicDiagnosticsHelpLinkBase)ras2001"
           Condition="'$(RunicAssetsEmbeddedArchive)' != ''"
           Text="Set either RunicAssetsDist or RunicAssetsEmbeddedArchive, not both." />
    <Error Code="RAS2002" File="$(MSBuildProjectFullPath)" HelpLink="$(_RunicDiagnosticsHelpLinkBase)ras2002"
           Condition="!Exists('$(RunicAssetsDist)')"
           Text="The RunicAssetsDist directory '$(RunicAssetsDist)' does not exist. Build the web UI before compiling this project." />
    <Error Code="RAS2003" File="$(MSBuildProjectFullPath)" HelpLink="$(_RunicDiagnosticsHelpLinkBase)ras2003"
           Condition="!Exists('$(RunicAssetsPackerPath)')"
           Text="The Runic Assets packer '$(RunicAssetsPackerPath)' does not exist. Restore the project again; the Runic.Assets package may be incomplete." />

    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(_RunicAssetsGeneratedArchive)'))" />
    <Exec Command="&quot;$(_RunicAssetsDotNetHost)&quot; &quot;$(RunicAssetsPackerPath)&quot; &quot;$(_RunicAssetsDistArgument)&quot; &quot;$(_RunicAssetsGeneratedArchive)&quot; --entry-point &quot;$(RunicAssetsEntryPoint)&quot; $(_RunicAssetsPackerOptions)"
          Condition="'$(RunicAssetsDistExclude)' == ''" IgnoreExitCode="true">
      <Output TaskParameter="ExitCode" PropertyName="_RunicAssetsPackerExitCode" />
    </Exec>
    <Exec Command="&quot;$(_RunicAssetsDotNetHost)&quot; &quot;$(RunicAssetsPackerPath)&quot; &quot;$(_RunicAssetsDistArgument)&quot; &quot;$(_RunicAssetsGeneratedArchive)&quot; --entry-point &quot;$(RunicAssetsEntryPoint)&quot; --exclude &quot;$(RunicAssetsDistExclude)&quot; $(_RunicAssetsPackerOptions)"
          Condition="'$(RunicAssetsDistExclude)' != ''" IgnoreExitCode="true">
      <Output TaskParameter="ExitCode" PropertyName="_RunicAssetsPackerExitCode" />
    </Exec>
    <!-- The packer writes warning RAS1005 in MSBuild's canonical form, so Exec reports it and NoWarn silences it.
         It reports its RAS1xxx error above; this names the build step instead of MSB3073. -->
    <Error Code="RAS2005" File="$(MSBuildProjectFullPath)" HelpLink="$(_RunicDiagnosticsHelpLinkBase)ras2005"
           Condition="'$(_RunicAssetsPackerExitCode)' != '' and '$(_RunicAssetsPackerExitCode)' != '0'"
           Text="The Runic Assets packer could not pack '$(RunicAssetsDist)' and exited with code $(_RunicAssetsPackerExitCode). Its error is above." />
  </Target>

  <Target Name="RunicAssetsEmbedFileSystem"
          BeforeTargets="SplitResourcesByCulture"
          DependsOnTargets="RunicAssetsPackFileSystem"
          Condition="('$(RunicAssetsDist)' != '' or '$(RunicAssetsEmbeddedArchive)' != '') and '$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_RunicAssetsGeneratedArchive>$(IntermediateOutputPath)runic-assets\$(MSBuildProjectName).runic-assets</_RunicAssetsGeneratedArchive>
    </PropertyGroup>

    <Error Code="RAS2001" File="$(MSBuildProjectFullPath)" HelpLink="$(_RunicDiagnosticsHelpLinkBase)ras2001"
           Condition="'$(RunicAssetsDist)' != '' and '$(RunicAssetsEmbeddedArchive)' != ''"
           Text="Set either RunicAssetsDist or RunicAssetsEmbeddedArchive, not both." />
    <Error Code="RAS2004" File="$(MSBuildProjectFullPath)" HelpLink="$(_RunicDiagnosticsHelpLinkBase)ras2004"
           Condition="'$(RunicAssetsEmbeddedArchive)' != '' and !Exists('$(RunicAssetsEmbeddedArchive)')"
           Text="The RunicAssetsEmbeddedArchive file '$(RunicAssetsEmbeddedArchive)' does not exist." />

    <ItemGroup>
      <EmbeddedResource Include="$(_RunicAssetsGeneratedArchive)"
                        Condition="'$(RunicAssetsDist)' != ''">
        <LogicalName>$(RunicAssetsEmbeddedResourceName)</LogicalName>
      </EmbeddedResource>
      <EmbeddedResource Include="$(RunicAssetsEmbeddedArchive)"
                        Condition="'$(RunicAssetsEmbeddedArchive)' != ''">
        <LogicalName>$(RunicAssetsEmbeddedResourceName)</LogicalName>
      </EmbeddedResource>
    </ItemGroup>
  </Target>
</Project>
