<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../../eng/build/assets.props" />
  <PropertyGroup>
    <TargetFramework>$(RunicAssetsDefaultTargetFramework)</TargetFramework>
    <RunicAssetsShippingProject>true</RunicAssetsShippingProject>
    <AssemblyName>Runic.Assets</AssemblyName>
    <RootNamespace>Runic.Assets</RootNamespace>
    <PackageId>Runic.Assets</PackageId>
    <Description>Framework-neutral deterministic asset manifests, sources, and archives; mutable directory development is Linux-only.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <!-- RunicReleaseLinks.ExperimentalUrlFormat for [Experimental] help links. -->
    <RunicGenerateReleaseLinks>true</RunicGenerateReleaseLinks>
    <!-- Its own namespace: Runic.Assets.Packer sees this assembly's internals and has its own RunicReleaseLinks. -->
    <RunicReleaseLinksNamespace>Runic.Assets.Internal</RunicReleaseLinksNamespace>
    <!-- The development-directory family (RUNICASSETS001) is experimental for consumers, not inside the package. -->
    <NoWarn>$(NoWarn);RUNICASSETS001</NoWarn>
    <!-- Packs the diagnostics help links (eng/build/release-links.targets) as buildTransitive/Runic.Assets.HelpLinks.props,
         which buildTransitive/Runic.Assets.props imports. -->
    <RunicPackDiagnosticsHelpLinks>true</RunicPackDiagnosticsHelpLinks>
    <RunicDiagnosticsHelpLinksPropsName>Runic.Assets.HelpLinks.props</RunicDiagnosticsHelpLinksPropsName>
  </PropertyGroup>

  <ItemGroup>
    <None Update="README.md" Pack="true" PackagePath="\" />
    <None Include="buildTransitive/Runic.Assets.props" Pack="true" PackagePath="buildTransitive/" />
    <None Include="buildTransitive/Runic.Assets.targets" Pack="true" PackagePath="buildTransitive/" />
    <None Include="../../../tools/Runic.Assets.Packer/bin/$(Configuration)/net10.0/Runic.Assets.Packer.dll"
          Pack="true"
          PackagePath="tools/net10.0/" />
    <None Include="bin/$(Configuration)/net10.0/Runic.Assets.dll"
          Pack="true"
          PackagePath="tools/net10.0/" />
    <None Include="../../../tools/Runic.Assets.Packer/bin/$(Configuration)/net10.0/Runic.CommandLine.dll"
          Pack="true"
          PackagePath="tools/net10.0/" />
    <None Include="../../../tools/Runic.Assets.Packer/bin/$(Configuration)/net10.0/Runic.CommandLine.Spectre.dll"
          Pack="true"
          PackagePath="tools/net10.0/" />
    <None Include="../../../tools/Runic.Assets.Packer/bin/$(Configuration)/net10.0/Spectre.Console.dll"
          Pack="true"
          PackagePath="tools/net10.0/" />
    <None Include="../../../tools/Runic.Assets.Packer/bin/$(Configuration)/net10.0/Spectre.Console.Ansi.dll"
          Pack="true"
          PackagePath="tools/net10.0/" />
    <None Include="../../../tools/Runic.Assets.Packer/bin/$(Configuration)/net10.0/Runic.Assets.Packer.deps.json"
          Pack="true"
          PackagePath="tools/net10.0/" />
    <None Include="../../../tools/Runic.Assets.Packer/bin/$(Configuration)/net10.0/Runic.Assets.Packer.runtimeconfig.json"
          Pack="true"
          PackagePath="tools/net10.0/" />
  </ItemGroup>

  <Target Name="BuildRunicAssetsPackerForPackage" BeforeTargets="GenerateNuspec" Condition="'$(NoBuild)' != 'true'">
    <MSBuild Projects="../../../tools/Runic.Assets.Packer/Runic.Assets.Packer.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration);RunicAssetsBuildMode=$(RunicAssetsBuildMode)" />
  </Target>
  <Import Project="../../../eng/build/assets.targets" />
</Project>
