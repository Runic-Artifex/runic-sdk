<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(RunicToolkitDefaultTargetFramework)</TargetFramework>
    <AssemblyName>RunicToolkit.MVVM.ReactiveUI</AssemblyName>
    <RootNamespace>RunicToolkit.MVVM.ReactiveUI</RootNamespace>
    <PackageId>RunicToolkit.MVVM.ReactiveUI</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>Reflection-free ReactiveUI adapters for RunicToolkit MVVM.</Description>
    <RunicToolkitShippingProject>true</RunicToolkitShippingProject>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RunicToolkit.MVVM\RunicToolkit.MVVM.csproj" />
    <PackageReference Include="ReactiveUI"
                      Version="[22.3.1,24.0.0)"
                      PrivateAssets="contentfiles" />
  </ItemGroup>

  <ItemGroup>
    <None Update="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
