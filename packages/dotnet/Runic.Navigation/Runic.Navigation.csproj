<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../../eng/build/application.props" />
  <PropertyGroup>
    <TargetFramework>$(RunicApplicationDefaultTargetFramework)</TargetFramework>
    <RunicApplicationShippingProject>true</RunicApplicationShippingProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- ExperimentalAttribute.UrlFormat links RUNICNAV001 to its catalog entry at the release tag. -->
    <RunicGenerateReleaseLinks>true</RunicGenerateReleaseLinks>
    <RunicExperimentalDiagnosticId>RUNICNAV001</RunicExperimentalDiagnosticId>
    <PackageId>Runic.Navigation</PackageId>
    <Description>Typed, host-neutral navigation regions with guards, results and content ownership, and the model context that serializes ViewModel changes.</Description>
    <PackageTags>runic-artifex;navigation;mvvm;wpf;dotnet;nativeaot</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- Not yet published: no validation baseline until the first release. Remove both
         properties once RunicPackageValidationBaselineVersion reaches it (eng/release/README.md). -->
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <InternalsVisibleTo Include="Runic.Navigation.Tests" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <Import Project="../../../eng/build/application.targets" />
</Project>
