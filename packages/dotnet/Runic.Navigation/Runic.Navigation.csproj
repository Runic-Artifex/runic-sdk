<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../../eng/build/application.props" />
  <PropertyGroup>
    <TargetFramework>$(RunicApplicationDefaultTargetFramework)</TargetFramework>
    <RunicApplicationShippingProject>true</RunicApplicationShippingProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>Runic.Navigation</PackageId>
    <Description>Typed, host-neutral navigation regions with guards, results and content ownership, and the model context that serializes ViewModel changes.</Description>
    <PackageTags>runic-artifex;navigation;mvvm;wpf;dotnet;nativeaot</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <InternalsVisibleTo Include="Runic.Navigation.Tests" />
    <!-- The ReactiveUI adapters' main-thread scheduler follows a model turn's async flow (RunicModelContext.Flowing,
         #473). They reference this package through Runic.Application.Views, with the exact version of the release. -->
    <InternalsVisibleTo Include="Runic.Application.Views.ReactiveUI" />
    <InternalsVisibleTo Include="Runic.Application.Views.ReactiveUI.Reactive" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <Import Project="../../../eng/build/application.targets" />
</Project>
