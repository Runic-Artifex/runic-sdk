<Project>
  <!-- This file is imported from source during development and from
       buildTransitive when consumed as a package. -->

  <!-- Every build property of these targets starts with RunicApplicationFrontend.
       The RunicBridge* and RunicViewsWindowProject names of 0.7.0-preview.6 and
       earlier still apply in this preview and report RUNICBRIDGE017 with the new
       name; the next preview removes them. An old name wins over the new one,
       whose default a host adapter's props may already have set. -->
  <PropertyGroup>
    <RunicApplicationFrontendDirectory Condition="'$(RunicBridgeFrontendDir)' != ''">$(RunicBridgeFrontendDir)</RunicApplicationFrontendDirectory>
    <RunicApplicationFrontendGeneratedDirectory Condition="'$(RunicBridgeTypescriptDir)' != ''">$(RunicBridgeTypescriptDir)</RunicApplicationFrontendGeneratedDirectory>
    <RunicApplicationFrontendPackageManager Condition="'$(RunicBridgeFrontendPackageManager)' != ''">$(RunicBridgeFrontendPackageManager)</RunicApplicationFrontendPackageManager>
    <RunicApplicationFrontendBuildCommand Condition="'$(RunicBridgeFrontendBuildCommand)' != ''">$(RunicBridgeFrontendBuildCommand)</RunicApplicationFrontendBuildCommand>
    <RunicApplicationFrontendInstallCommand Condition="'$(RunicBridgeFrontendInstallCommand)' != ''">$(RunicBridgeFrontendInstallCommand)</RunicApplicationFrontendInstallCommand>
    <RunicApplicationFrontendInstallEnabled Condition="'$(RunicBridgeInstallFrontend)' != ''">$(RunicBridgeInstallFrontend)</RunicApplicationFrontendInstallEnabled>
    <RunicApplicationFrontendBuildEnabled Condition="'$(RunicBridgeBuildFrontend)' != ''">$(RunicBridgeBuildFrontend)</RunicApplicationFrontendBuildEnabled>
    <RunicApplicationFrontendCopyEnabled Condition="'$(RunicBridgeCopyFrontend)' != ''">$(RunicBridgeCopyFrontend)</RunicApplicationFrontendCopyEnabled>
    <RunicApplicationFrontendGenerationEnabled Condition="'$(RunicBridgeBuildEnabled)' != ''">$(RunicBridgeBuildEnabled)</RunicApplicationFrontendGenerationEnabled>
    <RunicApplicationFrontendCompositionType Condition="'$(RunicBridgeCompositionType)' != ''">$(RunicBridgeCompositionType)</RunicApplicationFrontendCompositionType>
    <RunicApplicationFrontendModelAssembly Condition="'$(RunicBridgeModelAssembly)' != ''">$(RunicBridgeModelAssembly)</RunicApplicationFrontendModelAssembly>
    <RunicApplicationFrontendReactiveUiFlavor Condition="'$(RunicBridgeReactiveUiFlavor)' != ''">$(RunicBridgeReactiveUiFlavor)</RunicApplicationFrontendReactiveUiFlavor>
    <RunicApplicationFrontendDocumentationEnabled Condition="'$(RunicBridgeDocumentation)' != ''">$(RunicBridgeDocumentation)</RunicApplicationFrontendDocumentationEnabled>
    <RunicApplicationFrontendWindowProject Condition="'$(RunicViewsWindowProject)' != ''">$(RunicViewsWindowProject)</RunicApplicationFrontendWindowProject>
  </PropertyGroup>
  <ItemGroup>
    <RunicApplicationFrontendInput Include="@(RunicBridgeFrontendInput)" />
    <_RunicApplicationFrontendRenamedName Include="RunicBridgeFrontendDir" NewName="RunicApplicationFrontendDirectory" Kind="property" Condition="'$(RunicBridgeFrontendDir)' != ''" />
    <_RunicApplicationFrontendRenamedName Include="RunicBridgeTypescriptDir" NewName="RunicApplicationFrontendGeneratedDirectory" Kind="property" Condition="'$(RunicBridgeTypescriptDir)' != ''" />
    <_RunicApplicationFrontendRenamedName Include="RunicBridgeFrontendPackageManager" NewName="RunicApplicationFrontendPackageManager" Kind="property" Condition="'$(RunicBridgeFrontendPackageManager)' != ''" />
    <_RunicApplicationFrontendRenamedName Include="RunicBridgeFrontendBuildCommand" NewName="RunicApplicationFrontendBuildCommand" Kind="property" Condition="'$(RunicBridgeFrontendBuildCommand)' != ''" />
    <_RunicApplicationFrontendRenamedName Include="RunicBridgeFrontendInstallCommand" NewName="RunicApplicationFrontendInstallCommand" Kind="property" Condition="'$(RunicBridgeFrontendInstallCommand)' != ''" />
    <_RunicApplicationFrontendRenamedName Include="RunicBridgeInstallFrontend" NewName="RunicApplicationFrontendInstallEnabled" Kind="property" Condition="'$(RunicBridgeInstallFrontend)' != ''" />
    <_RunicApplicationFrontendRenamedName Include="RunicBridgeBuildFrontend" NewName="RunicApplicationFrontendBuildEnabled" Kind="property" Condition="'$(RunicBridgeBuildFrontend)' != ''" />
    <_RunicApplicationFrontendRenamedName Include="RunicBridgeCopyFrontend" NewName="RunicApplicationFrontendCopyEnabled" Kind="property" Condition="'$(RunicBridgeCopyFrontend)' != ''" />
    <_RunicApplicationFrontendRenamedName Include="RunicBridgeBuildEnabled" NewName="RunicApplicationFrontendGenerationEnabled" Kind="property" Condition="'$(RunicBridgeBuildEnabled)' != ''" />
    <_RunicApplicationFrontendRenamedName Include="RunicBridgeCompositionType" NewName="RunicApplicationFrontendCompositionType" Kind="property" Condition="'$(RunicBridgeCompositionType)' != ''" />
    <_RunicApplicationFrontendRenamedName Include="RunicBridgeModelAssembly" NewName="RunicApplicationFrontendModelAssembly" Kind="property" Condition="'$(RunicBridgeModelAssembly)' != ''" />
    <_RunicApplicationFrontendRenamedName Include="RunicBridgeReactiveUiFlavor" NewName="RunicApplicationFrontendReactiveUiFlavor" Kind="property" Condition="'$(RunicBridgeReactiveUiFlavor)' != ''" />
    <_RunicApplicationFrontendRenamedName Include="RunicBridgeDocumentation" NewName="RunicApplicationFrontendDocumentationEnabled" Kind="property" Condition="'$(RunicBridgeDocumentation)' != ''" />
    <_RunicApplicationFrontendRenamedName Include="RunicViewsWindowProject" NewName="RunicApplicationFrontendWindowProject" Kind="property" Condition="'$(RunicViewsWindowProject)' != ''" />
    <_RunicApplicationFrontendRenamedName Include="RunicBridgeFrontendInput" NewName="RunicApplicationFrontendInput" Kind="item" Condition="'@(RunicBridgeFrontendInput)' != ''" />
  </ItemGroup>
  <PropertyGroup>
    <_RunicBridgeGeneratedDir>$(MSBuildProjectDirectory)/obj/$(Configuration)/$(TargetFramework)/runic-bridge/</_RunicBridgeGeneratedDir>
    <_RunicBridgeNoViewsMarker>RunicBridge.NoViews.marker</_RunicBridgeNoViewsMarker>
    <RunicApplicationFrontendDirectory Condition="'$(RunicApplicationFrontendDirectory)' == ''">$(MSBuildProjectDirectory)/Frontend</RunicApplicationFrontendDirectory>
    <RunicApplicationFrontendGeneratedDirectory Condition="'$(RunicApplicationFrontendGeneratedDirectory)' == ''">$(RunicApplicationFrontendDirectory)/src/generated</RunicApplicationFrontendGeneratedDirectory>
    <!-- WPF compiles a temporary copy of the project (<name>_<random>_wpftmp)
         to resolve local types in XAML. The copy imports these targets too,
         but must not generate or bootstrap again: it compiles the code that
         the real project generated before the copy was created. -->
    <_RunicBridgeMarkupTemporary Condition="'$(_TargetAssemblyProjectName)' != '' or $(MSBuildProjectName.EndsWith('_wpftmp'))">true</_RunicBridgeMarkupTemporary>
    <!-- Output lines that report an error or warning in the canonical
         "origin: error CODE: text" form, as the generator, tsc and vue-tsc do. -->
    <_RunicBridgeCanonicalDiagnostic>(^|:)\s*(error|warning)\s+[A-Za-z]+\d+\s*:</_RunicBridgeCanonicalDiagnostic>
  </PropertyGroup>

  <!-- The generator and the frontend commands run with IgnoreExitCode, so a
       failure is not repeated as MSB3073 ("The command exited with code 1").
       This task logs their canonical errors and warnings with their codes and
       locations, and logs the summary error only when the command failed
       without reporting one. It is compiled only when a command failed or
       reported a diagnostic. -->
  <UsingTask TaskName="RunicBridgeReportCommandResult" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Lines ParameterType="Microsoft.Build.Framework.ITaskItem[]" />
      <ExitCode ParameterType="System.Int32" Required="true" />
      <WorkingDirectory ParameterType="System.String" />
      <FailureCode ParameterType="System.String" Required="true" />
      <FailureFile ParameterType="System.String" />
      <FailureText ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Code Type="Method" Language="cs"><![CDATA[
        public override bool Execute()
        {
          var diagnostic = new Regex(@"^\s*(?:(?<origin>.*?)\s*:\s*)?(?<kind>error|warning)\s+(?<code>[A-Za-z]+\d+)\s*:\s*(?<text>.*)$");
          var location = new Regex(@"^(?<file>.*?)\s*\((?<line>\d+)(?:[,-](?<column>\d+))?[^)]*\)$");
          bool reportedError = false;
          foreach (var item in Lines ?? new Microsoft.Build.Framework.ITaskItem[0])
          {
            Match match = diagnostic.Match(item.ItemSpec);
            if (!match.Success) continue;
            // A diagnostic without an origin, such as the generator's, belongs to the project.
            string file = match.Groups["origin"].Value.Trim();
            int line = 0, column = 0;
            Match at = location.Match(file);
            if (at.Success)
            {
              file = at.Groups["file"].Value;
              line = int.Parse(at.Groups["line"].Value);
              if (at.Groups["column"].Success) column = int.Parse(at.Groups["column"].Value);
            }
            if (file.Length > 0 && !string.IsNullOrEmpty(WorkingDirectory) && file.IndexOfAny(Path.GetInvalidPathChars()) < 0 && !Path.IsPathRooted(file))
            {
              file = Path.GetFullPath(Path.Combine(WorkingDirectory, file));
            }
            if (file.Length == 0) file = FailureFile ?? "";
            if (match.Groups["kind"].Value == "error")
            {
              reportedError = true;
              Log.LogError(null, match.Groups["code"].Value, null, file, line, column, 0, 0, match.Groups["text"].Value);
            }
            else
            {
              Log.LogWarning(null, match.Groups["code"].Value, null, file, line, column, 0, 0, match.Groups["text"].Value);
            }
          }
          if (ExitCode != 0 && !reportedError)
          {
            Log.LogError(null, FailureCode, null, FailureFile, 0, 0, 0, 0, FailureText);
          }
          return !Log.HasLoggedErrors;
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <!-- The frontend package manager follows package.json "packageManager",
       then the committed lock file, then npm. It selects the default build
       and install commands; set either command explicitly to override it. -->
  <PropertyGroup Condition="'$(RunicApplicationFrontendPackageManager)' == '' and Exists('$(RunicApplicationFrontendDirectory)/package.json')">
    <RunicApplicationFrontendPackageManager>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(RunicApplicationFrontendDirectory)/package.json')), '(?&lt;="packageManager"\s*:\s*")(npm|pnpm|bun)(?=@)'))</RunicApplicationFrontendPackageManager>
  </PropertyGroup>
  <PropertyGroup>
    <_RunicBridgeDefaultFrontendBuild Condition="'$(RunicApplicationFrontendBuildCommand)' == ''">true</_RunicBridgeDefaultFrontendBuild>
    <RunicApplicationFrontendPackageManager Condition="'$(RunicApplicationFrontendPackageManager)' == '' and Exists('$(RunicApplicationFrontendDirectory)/pnpm-lock.yaml')">pnpm</RunicApplicationFrontendPackageManager>
    <RunicApplicationFrontendPackageManager Condition="'$(RunicApplicationFrontendPackageManager)' == '' and Exists('$(RunicApplicationFrontendDirectory)/bun.lock')">bun</RunicApplicationFrontendPackageManager>
    <RunicApplicationFrontendPackageManager Condition="'$(RunicApplicationFrontendPackageManager)' == ''">npm</RunicApplicationFrontendPackageManager>
    <RunicApplicationFrontendBuildCommand Condition="'$(RunicApplicationFrontendBuildCommand)' == '' and '$(RunicApplicationFrontendPackageManager)' == 'pnpm'">pnpm run build</RunicApplicationFrontendBuildCommand>
    <RunicApplicationFrontendBuildCommand Condition="'$(RunicApplicationFrontendBuildCommand)' == '' and '$(RunicApplicationFrontendPackageManager)' == 'bun'">bun run --bun build</RunicApplicationFrontendBuildCommand>
    <RunicApplicationFrontendBuildCommand Condition="'$(RunicApplicationFrontendBuildCommand)' == ''">npm run build</RunicApplicationFrontendBuildCommand>
    <!-- A project may still set its own command after importing these targets. -->
    <_RunicBridgeDefaultFrontendBuildCommand Condition="'$(_RunicBridgeDefaultFrontendBuild)' == 'true'">$(RunicApplicationFrontendBuildCommand)</_RunicBridgeDefaultFrontendBuildCommand>
    <RunicApplicationFrontendInstallCommand Condition="'$(RunicApplicationFrontendInstallCommand)' == '' and '$(RunicApplicationFrontendPackageManager)' == 'pnpm'">pnpm install --frozen-lockfile --ignore-scripts</RunicApplicationFrontendInstallCommand>
    <RunicApplicationFrontendInstallCommand Condition="'$(RunicApplicationFrontendInstallCommand)' == '' and '$(RunicApplicationFrontendPackageManager)' == 'bun'">bun install --frozen-lockfile --ignore-scripts</RunicApplicationFrontendInstallCommand>
    <RunicApplicationFrontendInstallCommand Condition="'$(RunicApplicationFrontendInstallCommand)' == '' and Exists('$(RunicApplicationFrontendDirectory)/package-lock.json')">npm ci --ignore-scripts</RunicApplicationFrontendInstallCommand>
    <RunicApplicationFrontendInstallCommand Condition="'$(RunicApplicationFrontendInstallCommand)' == ''">npm install --ignore-scripts</RunicApplicationFrontendInstallCommand>
  </PropertyGroup>

  <PropertyGroup>
    <_RunicBridgeFrontendStamp>$(MSBuildProjectDirectory)/obj/$(Configuration)/$(TargetFramework)/runic-bridge-frontend.stamp</_RunicBridgeFrontendStamp>
    <!-- One install serves every configuration and target framework, and
         dotnet clean keeps it. -->
    <_RunicBridgeFrontendInstallStamp>$(MSBuildProjectDirectory)/obj/runic-bridge-frontend-install.stamp</_RunicBridgeFrontendInstallStamp>
    <_RunicBridgeCodegenProject>$(MSBuildThisFileDirectory)../../../../tools/Runic.Application.Views.Codegen/Runic.Application.Views.Codegen.csproj</_RunicBridgeCodegenProject>
    <_RunicBridgeCodegenDll Condition="Exists('$(_RunicBridgeCodegenProject)')">$(MSBuildThisFileDirectory)../../../../tools/Runic.Application.Views.Codegen/bin/$(Configuration)/net10.0/BridgeCodegen.dll</_RunicBridgeCodegenDll>
    <_RunicBridgeCodegenDll Condition="!Exists('$(_RunicBridgeCodegenProject)')">$(MSBuildThisFileDirectory)../tools/net10.0/BridgeCodegen.dll</_RunicBridgeCodegenDll>
    <_RunicBridgeAotArgument Condition="'$(PublishAot)' == 'true'">--aot</_RunicBridgeAotArgument>
    <_RunicBridgeCompositionArgument Condition="'$(RunicApplicationFrontendCompositionType)' != ''">--di-composition &quot;$(RunicApplicationFrontendCompositionType)&quot;</_RunicBridgeCompositionArgument>
  </PropertyGroup>

  <!-- Include the source tool in the restore graph so a first IDE build can
       compile it without a separate manual restore. It is not an app reference. -->
  <ItemGroup Condition="Exists('$(_RunicBridgeCodegenProject)') and '$(RunicApplicationFrontendBootstrap)' != 'true'">
    <ProjectReference Include="$(_RunicBridgeCodegenProject)" ReferenceOutputAssembly="false"
                      GlobalPropertiesToRemove="PublishAot;RuntimeIdentifier;SelfContained" />
  </ItemGroup>

  <!-- The bootstrap pass sets its own output paths. Referenced projects (a
       model project beside a WPF application, for example) keep the
       properties of the real build, so they are not compiled again into the
       bootstrap directories. -->
  <ItemGroup Condition="'$(RunicApplicationFrontendBootstrap)' == 'true'">
    <ProjectReference Update="@(ProjectReference)"
                      GlobalPropertiesToRemove="%(GlobalPropertiesToRemove);RunicApplicationFrontendBootstrap;RunicBridgeBootstrap;RunAnalyzers;RunCodeAnalysis;CopyLocalLockFileAssemblies;OutputPath;IntermediateOutputPath" />
  </ItemGroup>

  <!-- RUNICBRIDGE017 once per renamed property or item that the project still sets.
       The bootstrap pass and WPF's temporary markup project see the same
       properties, so only the real build reports it. -->
  <Target Name="RunicViewsReportRenamedProperties" BeforeTargets="PrepareForBuild"
          Condition="'@(_RunicApplicationFrontendRenamedName)' != '' and '$(DesignTimeBuild)' != 'true' and '$(RunicApplicationFrontendBootstrap)' != 'true' and '$(_RunicBridgeMarkupTemporary)' != 'true'">
    <Warning Code="RUNICBRIDGE017" File="$(MSBuildProjectFullPath)" HelpLink="$(RunicDiagnosticsHelpLinkBase)runicbridge017"
             Text="The Runic build %(_RunicApplicationFrontendRenamedName.Kind) %(_RunicApplicationFrontendRenamedName.Identity) is renamed to %(_RunicApplicationFrontendRenamedName.NewName). Rename it in $(MSBuildProjectFile), its imports or the command line; the old name still works in this preview and is removed in the next one." />
  </Target>

  <!-- Generation turns on for a project that references Runic.Application.Views
       directly, or that references a host adapter directly or transitively:
       each adapter's props set RunicApplicationHostAdapter=true. -->
  <Target Name="RunicViewsDetectBridgeUse" BeforeTargets="PrepareForBuild">
    <ItemGroup>
      <_RunicBridgeDirectPackage Include="@(PackageReference)"
        Condition="'%(PackageReference.Identity)' == 'Runic.Application.Views'" />
    </ItemGroup>
    <!-- A test project (IsTestProject, which Microsoft.NET.Test.Sdk and TUnit
         set) that references a Runic application uses that application's
         generated Bridges. Unless it declares a Window or View itself or
         visibly expects output, generation stays off there, without
         RUNICBRIDGE006 or RUNICBRIDGE015 and without a bootstrap build. Other
         projects keep the diagnostics. -->
    <PropertyGroup>
      <_RunicBridgeTestProject Condition="'$(IsTestProject)' == 'true' and '$(RunicApplicationFrontendGenerationEnabled)' == '' and '$(RunicApplicationFrontendModelAssembly)' == '' and '@(RunicApplicationFrontendInput)' == '' and !Exists('$(RunicApplicationFrontendDirectory)/package.json')">true</_RunicBridgeTestProject>
    </PropertyGroup>
    <ItemGroup Condition="'$(_RunicBridgeTestProject)' == 'true'">
      <_RunicBridgeTestViewSource Include="@(Compile)"
        Condition="Exists('%(Compile.FullPath)') and $([System.Text.RegularExpressions.Regex]::IsMatch($([System.IO.File]::ReadAllText('%(Compile.FullPath)')), ':\s*(global::)?(Runic\.Application\.Views\.)?Runic(Window|View)\s*&lt;'))" />
    </ItemGroup>
    <PropertyGroup Condition="'$(_RunicBridgeTestProject)' == 'true' and '@(_RunicBridgeTestViewSource)' == ''">
      <RunicApplicationFrontendGenerationEnabled>false</RunicApplicationFrontendGenerationEnabled>
    </PropertyGroup>
    <!-- Generation that this file turns on by default is optional: a project
         that declares no Window or View (for example one that only uses the
         navigator) builds without bridge output. A project that sets
         RunicApplicationFrontendGenerationEnabled=true, or visibly expects output (a frontend
         package.json, RunicApplicationFrontendInput items, a composition type or a
         model assembly), still gets RUNICBRIDGE006 when it has no Window.
         A WPF application may keep its web Views in a referenced model
         project, so there the adapter's default composition type alone does
         not require them. -->
    <PropertyGroup>
      <_RunicBridgeOptional Condition="'$(RunicApplicationFrontendGenerationEnabled)' == '' and ('$(RunicApplicationFrontendCompositionType)' == '' or '$(UseWPF)' == 'true') and '$(RunicApplicationFrontendModelAssembly)' == '' and '@(RunicApplicationFrontendInput)' == '' and !Exists('$(RunicApplicationFrontendDirectory)/package.json')">true</_RunicBridgeOptional>
      <_RunicBridgeDefaultedOff Condition="'$(RunicApplicationFrontendGenerationEnabled)' == ''">true</_RunicBridgeDefaultedOff>
      <RunicApplicationFrontendGenerationEnabled Condition="'$(RunicApplicationFrontendGenerationEnabled)' == '' and Exists('$(_RunicBridgeCodegenProject)')">true</RunicApplicationFrontendGenerationEnabled>
      <RunicApplicationFrontendGenerationEnabled Condition="'$(RunicApplicationFrontendGenerationEnabled)' == '' and ('@(_RunicBridgeDirectPackage)' != '' or '$(RunicApplicationHostAdapter)' == 'true')">true</RunicApplicationFrontendGenerationEnabled>
      <RunicApplicationFrontendGenerationEnabled Condition="'$(RunicApplicationFrontendGenerationEnabled)' == ''">false</RunicApplicationFrontendGenerationEnabled>
      <_RunicBridgeDefaultedOff Condition="'$(RunicApplicationFrontendGenerationEnabled)' != 'false'"></_RunicBridgeDefaultedOff>
    </PropertyGroup>
  </Target>

  <!-- Without generation, a declared Window or View gets no bridge,
       AddRunicViews() or TypeScript client, and the first sign would be a
       CS1061 at the call. When generation is off only by default (no host
       adapter and no direct Runic.Application.Views reference), look for a class
       deriving from RunicWindow<T> or RunicView<T> and say so once. -->
  <Target Name="RunicViewsCheckDisabledGeneration" BeforeTargets="CoreCompile"
          DependsOnTargets="RunicViewsDetectBridgeUse"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(RunicApplicationFrontendBootstrap)' != 'true' and '$(_RunicBridgeMarkupTemporary)' != 'true'">
    <ItemGroup Condition="'$(_RunicBridgeDefaultedOff)' == 'true'">
      <_RunicBridgeViewSource Include="@(Compile)"
        Condition="Exists('%(Compile.FullPath)') and $([System.Text.RegularExpressions.Regex]::IsMatch($([System.IO.File]::ReadAllText('%(Compile.FullPath)')), ':\s*(global::)?(Runic\.Application\.Views\.)?Runic(Window|View)\s*&lt;'))" />
    </ItemGroup>
    <Warning Code="RUNICBRIDGE015" Condition="'@(_RunicBridgeViewSource)' != ''"
             File="$(MSBuildProjectFullPath)" HelpLink="$(RunicDiagnosticsHelpLinkBase)runicbridge015"
             Text="$(AssemblyName) declares a Runic Window or View (@(_RunicBridgeViewSource->'%(Filename)%(Extension)', ', ')), but Bridge generation is off because the project references no host adapter (Runic.Application.Views.Desktop, Runic.Application.Views.CsWebUi or Runic.Application.Views.Wpf) and not Runic.Application.Views directly. No bridge, AddRunicViews() or TypeScript client is generated. Set RunicApplicationFrontendGenerationEnabled=true to generate them here, or false when another project generates them." />
  </Target>

  <Target Name="RunicViewsDesignTimeComposition" BeforeTargets="CoreCompile"
          DependsOnTargets="RunicViewsDetectBridgeUse"
          Condition="'$(RunicApplicationFrontendGenerationEnabled)' == 'true' and '$(DesignTimeBuild)' == 'true' and '$(RunicApplicationFrontendBootstrap)' != 'true'">
    <MSBuild Projects="$(_RunicBridgeCodegenProject)" Targets="Build"
             Properties="Configuration=$(Configuration);TargetFramework=net10.0;RuntimeIdentifier=;PublishAot=false;SelfContained=false"
             Condition="Exists('$(_RunicBridgeCodegenProject)') and '$(RunicApplicationFrontendCompositionType)' != ''" />
    <MakeDir Directories="$(_RunicBridgeGeneratedDir)" />
    <Exec Command="dotnet &quot;$(_RunicBridgeCodegenDll)&quot; --composition-stub &quot;$(RunicApplicationFrontendCompositionType)&quot; &quot;$(_RunicBridgeGeneratedDir)RunicBridgeComposition.DesignTime.g.cs&quot;"
          Condition="'$(RunicApplicationFrontendCompositionType)' != ''" />
    <ItemGroup>
      <Compile Include="$(_RunicBridgeGeneratedDir)*.Bridge.g.cs;$(_RunicBridgeGeneratedDir)*.View.g.cs" />
      <Compile Include="$(_RunicBridgeGeneratedDir)RunicBridgeComposition.DesignTime.g.cs"
               Condition="'$(RunicApplicationFrontendCompositionType)' != ''" />
    </ItemGroup>
  </Target>

  <!-- The bootstrap pass compiles the application before its Bridges exist.
       An empty composition lets Program.cs call AddRunicViews() or
       AddRunicBridges() in that pass, so a starter needs no bootstrap-only
       OutputType or Compile changes. -->
  <Target Name="RunicViewsBootstrapComposition" BeforeTargets="CoreCompile;GenerateTemporaryTargetAssembly"
          Condition="'$(RunicApplicationFrontendBootstrap)' == 'true' and '$(RunicApplicationFrontendCompositionType)' != '' and '$(_RunicBridgeMarkupTemporary)' != 'true'">
    <PropertyGroup>
      <_RunicBridgeBootstrapComposition>$(IntermediateOutputPath)RunicBridgeComposition.Bootstrap.g.cs</_RunicBridgeBootstrapComposition>
    </PropertyGroup>
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <Exec Command="dotnet &quot;$(_RunicBridgeCodegenDll)&quot; --composition-stub &quot;$(RunicApplicationFrontendCompositionType)&quot; &quot;$(_RunicBridgeBootstrapComposition)&quot;" />
    <ItemGroup>
      <Compile Include="$(_RunicBridgeBootstrapComposition)" />
    </ItemGroup>
  </Target>

  <!-- The generator copies XML documentation comments into the generated
       TypeScript. When the project does not already write a documentation
       file, the bootstrap pass writes one beside the inspected assembly with
       the documentation warnings suppressed, so the real build is unchanged.
       Set RunicApplicationFrontendDocumentationEnabled=false to skip it. -->
  <Target Name="RunicViewsBootstrapDocumentation" BeforeTargets="CoreCompile"
          Condition="'$(RunicApplicationFrontendBootstrap)' == 'true' and '$(_RunicBridgeMarkupTemporary)' != 'true' and '$(RunicApplicationFrontendDocumentationEnabled)' != 'false' and '@(DocFileItem)' == ''">
    <PropertyGroup>
      <NoWarn>$(NoWarn);CS1570;CS1571;CS1572;CS1573;CS1574;CS1580;CS1581;CS1584;CS1587;CS1589;CS1590;CS1591;CS1592;CS1658;CS1710;CS1711;CS1712;CS1723;CS1734;CS1735</NoWarn>
    </PropertyGroup>
    <MakeDir Directories="$(OutDir)" />
    <ItemGroup>
      <DocFileItem Include="$(OutDir)$(AssemblyName).xml" />
      <FileWrites Include="$(OutDir)$(AssemblyName).xml" />
    </ItemGroup>
  </Target>

  <!-- A deterministic build (ContinuousIntegrationBuild, or
       DeterministicSourcePaths) maps source paths in the PDB, for example to
       /_/. The generator reads source through the PDB to recover the comments
       of MVVM partial properties, so pass it the same map as the compiler to
       resolve them back to local files. -->
  <Target Name="RunicViewsBridgePathMap" DependsOnTargets="InitializeSourceRootMappedPaths"
          Condition="'$(SourceRootMappedPathsFeatureSupported)' == 'true'">
    <ItemGroup>
      <_RunicBridgeMappedSourceRoot Include="@(SourceRoot)" Condition="'%(SourceRoot.NestedRoot)' == '' and '%(SourceRoot.MappedPath)' != '' and '%(SourceRoot.MappedPath)' != '%(SourceRoot.Identity)'">
        <EscapedKey>$([MSBuild]::ValueOrDefault('%(Identity)', '').Replace(',', ',,').Replace('=', '=='))</EscapedKey>
        <EscapedValue>$([MSBuild]::ValueOrDefault('%(MappedPath)', '').Replace(',', ',,').Replace('=', '=='))</EscapedValue>
      </_RunicBridgeMappedSourceRoot>
    </ItemGroup>
    <PropertyGroup>
      <_RunicBridgePathMap>@(_RunicBridgeMappedSourceRoot->'%(EscapedKey)=%(EscapedValue)', ',')</_RunicBridgePathMap>
      <_RunicBridgePathMap Condition="'$(PathMap)' != ''">$(_RunicBridgePathMap),$(PathMap)</_RunicBridgePathMap>
      <_RunicBridgePathMapArgument Condition="'$(_RunicBridgePathMap)' != ''">--path-map &quot;$(_RunicBridgePathMap)&quot;</_RunicBridgePathMapArgument>
    </PropertyGroup>
  </Target>

  <!-- In a WPF project this runs before the temporary markup assembly, so
       that assembly can compile the generated code (see
       RunicViewsMarkupTemporaryCompile). -->
  <Target Name="RunicViewsGenerateBridge" BeforeTargets="CoreCompile;GenerateTemporaryTargetAssembly"
          DependsOnTargets="RunicViewsDetectBridgeUse;ResolveProjectReferences;RunicViewsBridgePathMap"
          Condition="'$(RunicApplicationFrontendGenerationEnabled)' == 'true' and '$(DesignTimeBuild)' != 'true' and '$(RunicApplicationFrontendBootstrap)' != 'true' and '$(_RunicBridgeMarkupTemporary)' != 'true'">
    <MSBuild Projects="$(_RunicBridgeCodegenProject)" Targets="Build"
             Properties="Configuration=$(Configuration);TargetFramework=net10.0;RuntimeIdentifier=;PublishAot=false;SelfContained=false"
             Condition="Exists('$(_RunicBridgeCodegenProject)')" />
    <!-- In a one-project starter, first compile the ordinary C# source so MVVM
         source generators have finished before Bridge inspection. Analyzers
         are off in this pass: it only feeds the generator, the real build runs
         them, and the bootstrap's XML documentation file would otherwise
         surface documentation-dependent analyzer warnings. Source generators
         still run. -->
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="Build"
             Properties="RunicApplicationFrontendBootstrap=true;RunicBridgeBootstrap=true;RunAnalyzers=false;RunCodeAnalysis=false;Configuration=$(Configuration);TargetFramework=$(TargetFramework);RuntimeIdentifier=;PublishAot=false;SelfContained=false;CopyLocalLockFileAssemblies=true;OutputPath=$(MSBuildProjectDirectory)/obj/runic-bridge/bootstrap/bin/$(Configuration)/$(TargetFramework)/;IntermediateOutputPath=$(MSBuildProjectDirectory)/obj/runic-bridge/bootstrap/obj/$(Configuration)/$(TargetFramework)/"
             Condition="'$(RunicApplicationFrontendModelAssembly)' == ''" />
    <PropertyGroup>
      <_RunicBridgeInputAssembly Condition="'$(RunicApplicationFrontendModelAssembly)' == ''">$(MSBuildProjectDirectory)/obj/runic-bridge/bootstrap/bin/$(Configuration)/$(TargetFramework)/$(AssemblyName).dll</_RunicBridgeInputAssembly>
      <_RunicBridgeInputAssembly Condition="'$(RunicApplicationFrontendModelAssembly)' != ''">$(RunicApplicationFrontendModelAssembly)</_RunicBridgeInputAssembly>
    </PropertyGroup>
    <Error Condition="!Exists('$(_RunicBridgeCodegenDll)')"
           Text="Runic Bridge code generator was not found at $(_RunicBridgeCodegenDll)." />
    <PropertyGroup>
      <_RunicBridgeOptionalArgument Condition="'$(_RunicBridgeOptional)' == 'true'">--optional</_RunicBridgeOptionalArgument>
      <_RunicBridgeSkipped>false</_RunicBridgeSkipped>
      <_RunicBridgeReactiveUiFlavorArgument Condition="'$(RunicApplicationFrontendReactiveUiFlavor)' != ''">--reactiveui-flavor &quot;$(RunicApplicationFrontendReactiveUiFlavor)&quot;</_RunicBridgeReactiveUiFlavorArgument>
    </PropertyGroup>
    <Delete Files="$(_RunicBridgeGeneratedDir)$(_RunicBridgeNoViewsMarker)" />
    <!-- The generator reports its diagnostics in canonical form. They are
         logged once with their codes (see RunicBridgeReportCommandResult);
         a failure that reported none is RUNICBRIDGE001. -->
    <Exec Command="dotnet &quot;$(_RunicBridgeCodegenDll)&quot; --generate &quot;$(_RunicBridgeInputAssembly)&quot; &quot;$(_RunicBridgeGeneratedDir)&quot; &quot;$(RunicApplicationFrontendGeneratedDirectory)&quot; $(_RunicBridgeAotArgument) $(_RunicBridgeCompositionArgument) $(_RunicBridgeReactiveUiFlavorArgument) $(_RunicBridgeOptionalArgument) $(_RunicBridgePathMapArgument)"
          ConsoleToMSBuild="true" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" PropertyName="_RunicBridgeCodegenExitCode" />
      <Output TaskParameter="ConsoleOutput" ItemName="_RunicBridgeCodegenOutputLine" />
    </Exec>
    <PropertyGroup>
      <_RunicBridgeCodegenDiagnostics Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(_RunicBridgeCodegenOutputLine.Identity)', '$(_RunicBridgeCanonicalDiagnostic)'))">true</_RunicBridgeCodegenDiagnostics>
    </PropertyGroup>
    <RunicBridgeReportCommandResult Condition="'$(_RunicBridgeCodegenExitCode)' != '0' or '$(_RunicBridgeCodegenDiagnostics)' == 'true'"
        Lines="@(_RunicBridgeCodegenOutputLine)" ExitCode="$(_RunicBridgeCodegenExitCode)"
        FailureCode="RUNICBRIDGE001" FailureFile="$(MSBuildProjectFullPath)"
        FailureText="The Runic Bridge generator exited with code $(_RunicBridgeCodegenExitCode) without reporting an error while inspecting $(_RunicBridgeInputAssembly). Its output is above." />
    <PropertyGroup>
      <_RunicBridgeSkipped Condition="Exists('$(_RunicBridgeGeneratedDir)$(_RunicBridgeNoViewsMarker)')">true</_RunicBridgeSkipped>
    </PropertyGroup>
    <Message Importance="normal" Condition="'$(_RunicBridgeSkipped)' == 'true'"
             Text="Runic Bridge: $(AssemblyName) declares no Runic Window or View, so no bridge code or frontend build is generated. Set RunicApplicationFrontendGenerationEnabled=true to require them, or false to skip the bootstrap build entirely." />
    <ItemGroup Condition="'$(_RunicBridgeSkipped)' == 'true'">
      <FileWrites Include="$(_RunicBridgeGeneratedDir)$(_RunicBridgeNoViewsMarker)" />
    </ItemGroup>
    <ItemGroup>
      <Compile Include="$(_RunicBridgeGeneratedDir)*.Bridge.g.cs;$(_RunicBridgeGeneratedDir)*.View.g.cs" />
      <Compile Include="$(_RunicBridgeGeneratedDir)RunicBridgeComposition.g.cs" Condition="'$(RunicApplicationFrontendCompositionType)' != '' and '$(_RunicBridgeSkipped)' != 'true'" />
    </ItemGroup>
  </Target>

  <!-- WPF's temporary markup project is a copy of the project file, so it
       sees none of the Compile items added above. Compile the code that the
       real project (or its bootstrap pass) has just generated, so that
       code-behind calling AddRunicViews() or a generated View member
       resolves in that assembly too. -->
  <Target Name="RunicViewsMarkupTemporaryCompile" BeforeTargets="CoreCompile"
          DependsOnTargets="RunicViewsDetectBridgeUse"
          Condition="'$(_RunicBridgeMarkupTemporary)' == 'true' and '$(RunicApplicationFrontendGenerationEnabled)' != 'false' and '$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_RunicBridgeBootstrapComposition>$(IntermediateOutputPath)RunicBridgeComposition.Bootstrap.g.cs</_RunicBridgeBootstrapComposition>
    </PropertyGroup>
    <ItemGroup Condition="'$(RunicApplicationFrontendBootstrap)' == 'true' and '$(RunicApplicationFrontendCompositionType)' != ''">
      <Compile Include="$(_RunicBridgeBootstrapComposition)" Condition="Exists('$(_RunicBridgeBootstrapComposition)')" />
    </ItemGroup>
    <ItemGroup Condition="'$(RunicApplicationFrontendBootstrap)' != 'true' and !Exists('$(_RunicBridgeGeneratedDir)$(_RunicBridgeNoViewsMarker)')">
      <Compile Include="$(_RunicBridgeGeneratedDir)*.Bridge.g.cs;$(_RunicBridgeGeneratedDir)*.View.g.cs" />
      <Compile Include="$(_RunicBridgeGeneratedDir)RunicBridgeComposition.g.cs"
               Condition="'$(RunicApplicationFrontendCompositionType)' != '' and Exists('$(_RunicBridgeGeneratedDir)RunicBridgeComposition.g.cs')" />
    </ItemGroup>
  </Target>

  <!-- The frontend build runs only when one of its inputs is newer than the
       stamp: files under the frontend directory (excluding node_modules and
       build output), the generated TypeScript, and this project file. The
       generator rewrites TypeScript only when its content changes, so a
       C#-only edit does not rebuild the frontend. Add inputs outside the
       frontend directory (for example workspace packages) as
       RunicApplicationFrontendInput items, or set RunicApplicationFrontendBuildEnabled=false
       when another tool owns the frontend build. A missing frontend is
       RUNICBRIDGE014 rather than a failed command. -->
  <Target Name="RunicViewsCollectFrontendInputs" AfterTargets="RunicViewsGenerateBridge"
          Condition="'$(RunicApplicationFrontendGenerationEnabled)' == 'true' and '$(_RunicBridgeSkipped)' != 'true' and '$(DesignTimeBuild)' != 'true' and '$(RunicApplicationFrontendBootstrap)' != 'true' and '$(_RunicBridgeMarkupTemporary)' != 'true' and '$(RunicApplicationFrontendBuildEnabled)' != 'false'">
    <Error Code="RUNICBRIDGE014" File="$(MSBuildProjectFullPath)" HelpLink="$(RunicDiagnosticsHelpLinkBase)runicbridge014"
           Condition="!Exists('$(RunicApplicationFrontendDirectory)') or ('$(RunicApplicationFrontendBuildCommand)' == '$(_RunicBridgeDefaultFrontendBuildCommand)' and !Exists('$(RunicApplicationFrontendDirectory)/package.json'))"
           Text="$(AssemblyName) declares Runic Views, but the frontend directory $([System.IO.Path]::GetFullPath('$(RunicApplicationFrontendDirectory)')) has no package.json to build the generated client in $([System.IO.Path]::GetFullPath('$(RunicApplicationFrontendGeneratedDirectory)')). Create the frontend there, set RunicApplicationFrontendDirectory to your frontend package directory, or set RunicApplicationFrontendBuildEnabled=false when another tool builds it." />
    <!-- A target that ran before generation may still add the old item name;
         items the project declared were reported before the build. -->
    <ItemGroup>
      <_RunicBridgeDeclaredInputRename Include="@(_RunicApplicationFrontendRenamedName)" Condition="'%(Identity)' == 'RunicBridgeFrontendInput'" />
    </ItemGroup>
    <Warning Code="RUNICBRIDGE017" Condition="'@(RunicBridgeFrontendInput)' != '' and '@(_RunicBridgeDeclaredInputRename)' == ''"
             File="$(MSBuildProjectFullPath)" HelpLink="$(RunicDiagnosticsHelpLinkBase)runicbridge017"
             Text="The RunicBridgeFrontendInput item is renamed to RunicApplicationFrontendInput. Rename it in $(MSBuildProjectFile) or its imports; the old name still works in this preview and is removed in the next one." />
    <ItemGroup>
      <RunicApplicationFrontendInput Include="@(RunicBridgeFrontendInput)" Exclude="@(RunicApplicationFrontendInput)" />
      <RunicApplicationFrontendInput Include="$(RunicApplicationFrontendDirectory)/**/*"
          Exclude="$(RunicApplicationFrontendDirectory)/node_modules/**;$(RunicApplicationFrontendDirectory)/dist/**;$(RunicApplicationFrontendDirectory)/build/**;$(RunicApplicationFrontendDirectory)/bin/**;$(RunicApplicationFrontendDirectory)/obj/**;$(RunicApplicationFrontendDirectory)/.*/**" />
      <RunicApplicationFrontendInput Include="$(RunicApplicationFrontendGeneratedDirectory)/*.ts;$(MSBuildProjectFullPath)" />
      <!-- Registered on every build so IncrementalClean keeps the stamp
           when the frontend target is skipped as up to date. -->
      <FileWrites Include="$(_RunicBridgeFrontendStamp)" />
    </ItemGroup>
  </Target>

  <!-- A fresh clone or generated project has no node_modules yet, and a pull
       can change the declared packages. Install with the selected package
       manager when package.json or a lock file is newer than the install
       stamp, or when declared packages have no node_modules, so plain
       dotnet build and dotnet run work. A package.json without dependencies
       needs no node_modules. Set RunicApplicationFrontendInstallEnabled=false when a
       workspace install owns it. -->
  <Target Name="RunicViewsCollectFrontendInstallInputs" BeforeTargets="RunicViewsInstallFrontend"
          Condition="'$(RunicApplicationFrontendInstallEnabled)' != 'false' and Exists('$(RunicApplicationFrontendDirectory)/package.json')">
    <PropertyGroup>
      <_RunicBridgeFrontendHasDependencies>false</_RunicBridgeFrontendHasDependencies>
      <_RunicBridgeFrontendHasDependencies Condition="$([System.Text.RegularExpressions.Regex]::IsMatch($([System.IO.File]::ReadAllText('$(RunicApplicationFrontendDirectory)/package.json')), '&quot;(dependencies|devDependencies|optionalDependencies)&quot;\s*:\s*\{\s*&quot;'))">true</_RunicBridgeFrontendHasDependencies>
    </PropertyGroup>
    <ItemGroup>
      <_RunicBridgeFrontendInstallInput Include="$(RunicApplicationFrontendDirectory)/package.json" />
      <_RunicBridgeFrontendInstallInput Include="$(RunicApplicationFrontendDirectory)/%(_RunicBridgeFrontendLockFile.Identity)"
          Condition="Exists('$(RunicApplicationFrontendDirectory)/%(_RunicBridgeFrontendLockFile.Identity)')" />
    </ItemGroup>
    <!-- Deleted node_modules installs again even though its inputs are older. -->
    <Delete Files="$(_RunicBridgeFrontendInstallStamp)"
            Condition="'$(_RunicBridgeFrontendHasDependencies)' == 'true' and !Exists('$(RunicApplicationFrontendDirectory)/node_modules')" />
  </Target>

  <ItemGroup>
    <_RunicBridgeFrontendLockFile Include="package-lock.json;npm-shrinkwrap.json;pnpm-lock.yaml;bun.lock;bun.lockb" />
  </ItemGroup>

  <Target Name="RunicViewsInstallFrontend" BeforeTargets="RunicViewsBuildFrontend"
          Inputs="@(_RunicBridgeFrontendInstallInput)" Outputs="$(_RunicBridgeFrontendInstallStamp)"
          Condition="'$(RunicApplicationFrontendGenerationEnabled)' == 'true' and '$(_RunicBridgeSkipped)' != 'true' and '$(DesignTimeBuild)' != 'true' and '$(RunicApplicationFrontendBootstrap)' != 'true' and '$(_RunicBridgeMarkupTemporary)' != 'true' and '$(RunicApplicationFrontendBuildEnabled)' != 'false' and '$(RunicApplicationFrontendInstallEnabled)' != 'false' and Exists('$(RunicApplicationFrontendDirectory)/package.json')">
    <Message Importance="high"
             Text="Installing frontend dependencies in $(RunicApplicationFrontendDirectory) with $(RunicApplicationFrontendPackageManager). Set RunicApplicationFrontendInstallEnabled=false to install them yourself." />
    <Exec Command="$(RunicApplicationFrontendInstallCommand)" WorkingDirectory="$(RunicApplicationFrontendDirectory)"
          ConsoleToMSBuild="true" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" PropertyName="_RunicBridgeFrontendInstallExitCode" />
      <Output TaskParameter="ConsoleOutput" ItemName="_RunicBridgeFrontendInstallOutputLine" />
    </Exec>
    <PropertyGroup>
      <_RunicBridgeFrontendInstallDiagnostics Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(_RunicBridgeFrontendInstallOutputLine.Identity)', '$(_RunicBridgeCanonicalDiagnostic)'))">true</_RunicBridgeFrontendInstallDiagnostics>
    </PropertyGroup>
    <RunicBridgeReportCommandResult Condition="'$(_RunicBridgeFrontendInstallExitCode)' != '0' or '$(_RunicBridgeFrontendInstallDiagnostics)' == 'true'"
        Lines="@(_RunicBridgeFrontendInstallOutputLine)" ExitCode="$(_RunicBridgeFrontendInstallExitCode)"
        WorkingDirectory="$(RunicApplicationFrontendDirectory)"
        FailureCode="RUNICBRIDGE016" FailureFile="$(MSBuildProjectFullPath)"
        FailureText="The frontend install '$(RunicApplicationFrontendInstallCommand)' in $([System.IO.Path]::GetFullPath('$(RunicApplicationFrontendDirectory)')) exited with code $(_RunicBridgeFrontendInstallExitCode). Its output is above. Run 'dotnet runic doctor' to check the package manager and lock file." />
    <Error Code="RUNICBRIDGE016" File="$(MSBuildProjectFullPath)" HelpLink="$(RunicDiagnosticsHelpLinkBase)runicbridge016"
           Condition="'$(_RunicBridgeFrontendInstallExitCode)' == '0' and '$(_RunicBridgeFrontendHasDependencies)' == 'true' and !Exists('$(RunicApplicationFrontendDirectory)/node_modules')"
           Text="'$(RunicApplicationFrontendInstallCommand)' did not create $(RunicApplicationFrontendDirectory)/node_modules. Install the frontend dependencies with $(RunicApplicationFrontendPackageManager), or run 'dotnet runic doctor' to check the package manager and lock file." />
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(_RunicBridgeFrontendInstallStamp)'))" />
    <Touch Files="$(_RunicBridgeFrontendInstallStamp)" AlwaysCreate="true" />
  </Target>

  <Target Name="RunicViewsBuildFrontend" AfterTargets="RunicViewsCollectFrontendInputs"
          Inputs="@(RunicApplicationFrontendInput)" Outputs="$(_RunicBridgeFrontendStamp)"
          Condition="'$(RunicApplicationFrontendGenerationEnabled)' == 'true' and '$(_RunicBridgeSkipped)' != 'true' and '$(DesignTimeBuild)' != 'true' and '$(RunicApplicationFrontendBootstrap)' != 'true' and '$(_RunicBridgeMarkupTemporary)' != 'true' and '$(RunicApplicationFrontendBuildEnabled)' != 'false'">
    <!-- Compiler errors in canonical form (tsc, vue-tsc) are logged with
         their codes and locations; any other failure, such as a Vite error,
         gets one RUNICBRIDGE016 instead of MSB3073. -->
    <Exec Command="$(RunicApplicationFrontendBuildCommand)" WorkingDirectory="$(RunicApplicationFrontendDirectory)"
          ConsoleToMSBuild="true" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" PropertyName="_RunicBridgeFrontendBuildExitCode" />
      <Output TaskParameter="ConsoleOutput" ItemName="_RunicBridgeFrontendBuildOutputLine" />
    </Exec>
    <PropertyGroup>
      <_RunicBridgeFrontendBuildDiagnostics Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(_RunicBridgeFrontendBuildOutputLine.Identity)', '$(_RunicBridgeCanonicalDiagnostic)'))">true</_RunicBridgeFrontendBuildDiagnostics>
    </PropertyGroup>
    <RunicBridgeReportCommandResult Condition="'$(_RunicBridgeFrontendBuildExitCode)' != '0' or '$(_RunicBridgeFrontendBuildDiagnostics)' == 'true'"
        Lines="@(_RunicBridgeFrontendBuildOutputLine)" ExitCode="$(_RunicBridgeFrontendBuildExitCode)"
        WorkingDirectory="$(RunicApplicationFrontendDirectory)"
        FailureCode="RUNICBRIDGE016" FailureFile="$(MSBuildProjectFullPath)"
        FailureText="The frontend build '$(RunicApplicationFrontendBuildCommand)' in $([System.IO.Path]::GetFullPath('$(RunicApplicationFrontendDirectory)')) exited with code $(_RunicBridgeFrontendBuildExitCode). Its output is above." />
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(_RunicBridgeFrontendStamp)'))"
             Condition="'$(_RunicBridgeFrontendBuildExitCode)' == '0'" />
    <Touch Files="$(_RunicBridgeFrontendStamp)" AlwaysCreate="true"
           Condition="'$(_RunicBridgeFrontendBuildExitCode)' == '0'" />
  </Target>

  <!-- Views can live in a referenced model project, for example beside a WPF
       application. The model project builds its frontend, and an application
       that references it, directly or through other projects, copies that
       frontend to its own www/ too. The application's own frontend, if any,
       is copied afterwards and wins. -->
  <Target Name="RunicViewsCollectReferencedFrontends"
          DependsOnTargets="AssignProjectConfiguration;_SplitProjectReferencesByFileExistence;_GetProjectReferenceTargetFrameworkProperties"
          Condition="'$(RunicApplicationFrontendBootstrap)' != 'true' and '$(_RunicBridgeMarkupTemporary)' != 'true'">
    <MSBuild Projects="@(_MSBuildProjectReferenceExistent)" Targets="RunicViewsGetFrontendFiles"
             BuildInParallel="$(BuildInParallel)" SkipNonexistentTargets="true"
             Properties="%(_MSBuildProjectReferenceExistent.SetConfiguration); %(_MSBuildProjectReferenceExistent.SetPlatform); %(_MSBuildProjectReferenceExistent.SetTargetFramework)"
             RemoveProperties="%(_MSBuildProjectReferenceExistent.GlobalPropertiesToRemove)"
             Condition="'@(_MSBuildProjectReferenceExistent)' != ''">
      <Output TaskParameter="TargetOutputs" ItemName="_RunicBridgeReferencedFrontendFile" />
    </MSBuild>
  </Target>

  <!-- Returns this project's built frontend after those of its references. -->
  <Target Name="RunicViewsGetFrontendFiles" DependsOnTargets="RunicViewsDetectBridgeUse;RunicViewsCollectReferencedFrontends"
          Returns="@(_RunicBridgeReferencedFrontendFile);@(_RunicBridgeOwnFrontendFile)">
    <ItemGroup Condition="'$(RunicApplicationFrontendGenerationEnabled)' == 'true' and '$(_RunicBridgeSkipped)' != 'true' and '$(RunicApplicationFrontendBootstrap)' != 'true'">
      <_RunicBridgeFrontendDistFile Include="$(RunicApplicationFrontendDirectory)/dist/**/*" />
      <_RunicBridgeOwnFrontendFile Include="@(_RunicBridgeFrontendDistFile->'%(FullPath)')"
        RunicFrontendPath="%(_RunicBridgeFrontendDistFile.RecursiveDir)%(_RunicBridgeFrontendDistFile.Filename)%(_RunicBridgeFrontendDistFile.Extension)" />
    </ItemGroup>
  </Target>

  <Target Name="RunicViewsCopyReferencedFrontends" AfterTargets="Build"
          DependsOnTargets="RunicViewsCollectReferencedFrontends"
          Condition="'$(OutputType)' != 'Library' and '$(RunicApplicationFrontendBootstrap)' != 'true' and '$(RunicApplicationFrontendCopyEnabled)' != 'false'">
    <Copy SourceFiles="@(_RunicBridgeReferencedFrontendFile)"
          DestinationFiles="@(_RunicBridgeReferencedFrontendFile->'$(TargetDir)www/%(RunicFrontendPath)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="RunicViewsCopyReferencedFrontendsForPublish" AfterTargets="Publish"
          DependsOnTargets="RunicViewsCollectReferencedFrontends"
          Condition="'$(OutputType)' != 'Library' and '$(RunicApplicationFrontendBootstrap)' != 'true'">
    <Copy SourceFiles="@(_RunicBridgeReferencedFrontendFile)"
          DestinationFiles="@(_RunicBridgeReferencedFrontendFile->'$(PublishDir)www/%(RunicFrontendPath)')"
          SkipUnchangedFiles="true" />
  </Target>

  <!-- RunicApplicationFrontendCopyEnabled=false keeps a development document that
       dotnet runic dev wrote into www/ from being replaced by dist/. -->
  <Target Name="RunicViewsCopyFrontend" AfterTargets="Build"
          DependsOnTargets="RunicViewsDetectBridgeUse"
          Condition="'$(RunicApplicationFrontendGenerationEnabled)' == 'true' and '$(_RunicBridgeSkipped)' != 'true' and '$(RunicApplicationFrontendBootstrap)' != 'true' and '$(RunicApplicationFrontendCopyEnabled)' != 'false'">
    <ItemGroup>
      <_RunicBridgeFrontendFile Include="$(RunicApplicationFrontendDirectory)/dist/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(_RunicBridgeFrontendFile)"
          DestinationFiles="@(_RunicBridgeFrontendFile->'$(TargetDir)www/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="RunicViewsCopyFrontendForPublish" AfterTargets="Publish"
          DependsOnTargets="RunicViewsDetectBridgeUse"
          Condition="'$(RunicApplicationFrontendGenerationEnabled)' == 'true' and '$(_RunicBridgeSkipped)' != 'true' and '$(RunicApplicationFrontendBootstrap)' != 'true'">
    <ItemGroup>
      <_RunicBridgePublishedFrontendFile Include="$(RunicApplicationFrontendDirectory)/dist/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(_RunicBridgePublishedFrontendFile)"
          DestinationFiles="@(_RunicBridgePublishedFrontendFile->'$(PublishDir)www/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
