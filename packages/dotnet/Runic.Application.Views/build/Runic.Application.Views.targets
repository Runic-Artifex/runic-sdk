<Project>
  <!-- This file is imported from source during development and from
       buildTransitive when consumed as a package. -->

  <!-- Every build property of these targets starts with RunicApplicationFrontend.
       The RunicBridge* and RunicViewsWindowProject names of 0.7.0-preview.6 and
       earlier, and the runic-app template's RunicApplicationId and
       RunicApplicationName of 0.8, are no longer applied: a project that still
       sets one fails with RUNICBRIDGE017, which names the new property. -->
  <ItemGroup>
    <_RunicApplicationFrontendRenamedName Include="RunicBridgeFrontendDir" NewName="RunicApplicationFrontendDirectory" Kind="property" Condition="'$(RunicBridgeFrontendDir)' != ''" />
    <_RunicApplicationFrontendRenamedName Include="RunicBridgeTypescriptDir" NewName="RunicApplicationFrontendGeneratedDirectory" Kind="property" Condition="'$(RunicBridgeTypescriptDir)' != ''" />
    <_RunicApplicationFrontendRenamedName Include="RunicBridgeFrontendPackageManager" NewName="RunicApplicationFrontendPackageManager" Kind="property" Condition="'$(RunicBridgeFrontendPackageManager)' != ''" />
    <_RunicApplicationFrontendRenamedName Include="RunicBridgeFrontendBuildCommand" NewName="RunicApplicationFrontendBuildCommand" Kind="property" Condition="'$(RunicBridgeFrontendBuildCommand)' != ''" />
    <_RunicApplicationFrontendRenamedName Include="RunicBridgeFrontendInstallCommand" NewName="RunicApplicationFrontendInstallCommand" Kind="property" Condition="'$(RunicBridgeFrontendInstallCommand)' != ''" />
    <_RunicApplicationFrontendRenamedName Include="RunicBridgeInstallFrontend" NewName="RunicApplicationFrontendInstallEnabled" Kind="property" Condition="'$(RunicBridgeInstallFrontend)' != ''" />
    <_RunicApplicationFrontendRenamedName Include="RunicBridgeBuildFrontend" NewName="RunicApplicationFrontendBuildEnabled" Kind="property" Condition="'$(RunicBridgeBuildFrontend)' != ''" />
    <_RunicApplicationFrontendRenamedName Include="RunicBridgeCopyFrontend" NewName="RunicApplicationFrontendCopyEnabled" Kind="property" Condition="'$(RunicBridgeCopyFrontend)' != ''" />
    <_RunicApplicationFrontendRenamedName Include="RunicBridgeBuildEnabled" NewName="RunicApplicationFrontendGenerationEnabled" Kind="property" Condition="'$(RunicBridgeBuildEnabled)' != ''" />
    <_RunicApplicationFrontendRenamedName Include="RunicBridgeCompositionType" NewName="RunicApplicationFrontendCompositionType" Kind="property" Condition="'$(RunicBridgeCompositionType)' != ''" />
    <_RunicApplicationFrontendRenamedName Include="RunicBridgeModelAssembly" NewName="RunicApplicationFrontendModelAssembly" Kind="property" Condition="'$(RunicBridgeModelAssembly)' != ''" />
    <_RunicApplicationFrontendRenamedName Include="RunicBridgeDocumentation" NewName="RunicApplicationFrontendDocumentationEnabled" Kind="property" Condition="'$(RunicBridgeDocumentation)' != ''" />
    <_RunicApplicationFrontendRenamedName Include="RunicViewsWindowProject" NewName="RunicApplicationFrontendWindowProject" Kind="property" Condition="'$(RunicViewsWindowProject)' != ''" />
    <_RunicApplicationFrontendRenamedName Include="RunicBridgeFrontendInput" NewName="RunicApplicationFrontendInput" Kind="item" Condition="'@(RunicBridgeFrontendInput)' != ''" />
    <!-- The application's identity is MSBuild's ApplicationId and ApplicationTitle, which Runic.Platform.MacOS and
         Runic.Platform.Linux.Polkit read too. A project that keeps its own RunicApplicationId next to ApplicationId
         is left alone. -->
    <_RunicApplicationFrontendRenamedName Include="RunicApplicationId" NewName="ApplicationId" Kind="property" Condition="'$(RunicApplicationId)' != '' and '$(ApplicationId)' == ''" />
    <_RunicApplicationFrontendRenamedName Include="RunicApplicationName" NewName="ApplicationTitle" Kind="property" Condition="'$(RunicApplicationName)' != '' and '$(ApplicationTitle)' == ''" />
    <!-- Removed properties whose value the build now infers. The ReactiveUI flavor of the generated code is the
         flavor of the Runic ReactiveUI adapter the project references (see _RunicViewsReactiveUiFlavor). -->
    <_RunicApplicationFrontendRemovedName Include="RunicApplicationFrontendReactiveUiFlavor" Reason="The ReactiveUI flavor is now inferred from the referenced Runic ReactiveUI adapter" Condition="'$(RunicApplicationFrontendReactiveUiFlavor)' != ''" />
    <_RunicApplicationFrontendRemovedName Include="RunicBridgeReactiveUiFlavor" Reason="The ReactiveUI flavor is now inferred from the referenced Runic ReactiveUI adapter" Condition="'$(RunicBridgeReactiveUiFlavor)' != ''" />
  </ItemGroup>
  <PropertyGroup>
    <_RunicBridgeNoViewsMarker>RunicBridge.NoViews.marker</_RunicBridgeNoViewsMarker>
    <RunicApplicationFrontendDirectory Condition="'$(RunicApplicationFrontendDirectory)' == ''">$(MSBuildProjectDirectory)/Frontend</RunicApplicationFrontendDirectory>
    <RunicApplicationFrontendGeneratedDirectory Condition="'$(RunicApplicationFrontendGeneratedDirectory)' == ''">$(RunicApplicationFrontendDirectory)/src/generated</RunicApplicationFrontendGeneratedDirectory>
    <!-- The frontend build's output, which build and publish copy, and dotnet runic dev serves from too. A relative
         path is relative to the frontend directory. -->
    <RunicApplicationFrontendOutputDirectory Condition="'$(RunicApplicationFrontendOutputDirectory)' == ''">dist</RunicApplicationFrontendOutputDirectory>
    <_RunicApplicationFrontendOutputPath>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(RunicApplicationFrontendDirectory)', '$(RunicApplicationFrontendOutputDirectory)'))</_RunicApplicationFrontendOutputPath>
    <!-- The directory below the build and publish output that the application serves. The hosts find it through the
         Runic.Application.FrontendWebRoot runtime option when it is not www. -->
    <RunicApplicationFrontendWebRoot Condition="'$(RunicApplicationFrontendWebRoot)' == ''">www</RunicApplicationFrontendWebRoot>
    <_RunicApplicationFrontendWebRoot>$(RunicApplicationFrontendWebRoot.Replace('\', '/').Trim('/'))</_RunicApplicationFrontendWebRoot>
    <!-- A frontend inside the project folder would otherwise add its installed
         packages and build output to the default None, Content and Page items,
         which IDEs list and evaluation walks. Items are evaluated after all
         properties, so the SDK's default globs see this exclude. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);$(RunicApplicationFrontendDirectory)/node_modules/**;$(RunicApplicationFrontendDirectory)/dist/**;$(_RunicApplicationFrontendOutputPath)**</DefaultItemExcludes>
    <!-- WPF compiles a temporary copy of the project (<name>_<random>_wpftmp)
         to resolve local types in XAML. The copy imports these targets too,
         but must not generate or bootstrap again: it compiles the code that
         the real project generated before the copy was created. -->
    <_RunicBridgeMarkupTemporary Condition="'$(_TargetAssemblyProjectName)' != '' or $(MSBuildProjectName.EndsWith('_wpftmp'))">true</_RunicBridgeMarkupTemporary>
    <!-- Output lines that report an error or warning in the canonical
         "origin: error CODE: text" form, as the generator, tsc and vue-tsc do. -->
    <_RunicBridgeCanonicalDiagnostic>(^|:)\s*(error|warning)\s+[A-Za-z]+\d+\s*:</_RunicBridgeCanonicalDiagnostic>
  </PropertyGroup>
  <!-- A project that references a host adapter gets <RootNamespace>.RunicViewsComposition by default. The
       namespace is RootNamespace (the project name unless the project sets another) made a valid C# namespace:
       a character other than a letter, digit, underscore or dot becomes an underscore, and a segment that starts
       with a digit or is a C# keyword gets an underscore prefix. The project body has set RootNamespace by now. -->
  <PropertyGroup Condition="'$(RunicApplicationFrontendCompositionType)' == '' and '$(_RunicApplicationHostAdapter)' == 'true'">
    <_RunicApplicationFrontendCompositionNamespace>$(RootNamespace)</_RunicApplicationFrontendCompositionNamespace>
    <_RunicApplicationFrontendCompositionNamespace Condition="'$(_RunicApplicationFrontendCompositionNamespace)' == ''">$(MSBuildProjectName)</_RunicApplicationFrontendCompositionNamespace>
    <_RunicApplicationFrontendCompositionNamespace>$([System.Text.RegularExpressions.Regex]::Replace('$(_RunicApplicationFrontendCompositionNamespace)', '[^\p{L}\p{Nd}_.]', '_'))</_RunicApplicationFrontendCompositionNamespace>
    <_RunicApplicationFrontendCompositionNamespace>$([System.Text.RegularExpressions.Regex]::Replace('$(_RunicApplicationFrontendCompositionNamespace)', '\.\.+', '.').Trim('.'))</_RunicApplicationFrontendCompositionNamespace>
    <_RunicApplicationFrontendCompositionNamespace>$([System.Text.RegularExpressions.Regex]::Replace('$(_RunicApplicationFrontendCompositionNamespace)', '(^|\.)(?=\p{Nd}|(?:abstract|as|base|bool|break|byte|case|catch|char|checked|class|const|continue|decimal|default|delegate|do|double|else|enum|event|explicit|extern|false|finally|fixed|float|for|foreach|goto|if|implicit|in|int|interface|internal|is|lock|long|namespace|new|null|object|operator|out|override|params|private|protected|public|readonly|ref|return|sbyte|sealed|short|sizeof|stackalloc|static|string|struct|switch|this|throw|true|try|typeof|uint|ulong|unchecked|unsafe|ushort|using|virtual|void|volatile|while)(?:\.|$))', '$1_'))</_RunicApplicationFrontendCompositionNamespace>
    <_RunicApplicationFrontendCompositionNamespace Condition="'$(_RunicApplicationFrontendCompositionNamespace)' == ''">_</_RunicApplicationFrontendCompositionNamespace>
    <RunicApplicationFrontendCompositionType>$(_RunicApplicationFrontendCompositionNamespace).RunicViewsComposition</RunicApplicationFrontendCompositionType>
  </PropertyGroup>
  <!-- The hosts serve www/ next to the application; another web root reaches them through the runtime
       configuration (RunicWindowOptions.ContentRoot and RunicViewHost.ContentRoot still win). -->
  <ItemGroup Condition="'$(_RunicApplicationFrontendWebRoot)' != 'www'">
    <RuntimeHostConfigurationOption Include="Runic.Application.FrontendWebRoot" Value="$(_RunicApplicationFrontendWebRoot)" Trim="true" />
  </ItemGroup>

  <!-- The generator and the frontend commands run with IgnoreExitCode, so a
       failure is not repeated as MSB3073 ("The command exited with code 1").
       This task logs their canonical errors and warnings with their codes and
       locations, and those of a failed svelte-check with their locations. It
       logs the summary error only when the command failed without reporting
       one. It is compiled only when a command failed or
       reported a diagnostic. -->
  <UsingTask TaskName="RunicViewsReportCommandResult" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Lines ParameterType="Microsoft.Build.Framework.ITaskItem[]" />
      <ExitCode ParameterType="System.Int32" Required="true" />
      <WorkingDirectory ParameterType="System.String" />
      <FailureCode ParameterType="System.String" Required="true" />
      <FailureFile ParameterType="System.String" />
      <FailureText ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Code Type="Method" Language="cs"><![CDATA[
        public override bool Execute()
        {
          var diagnostic = new Regex(@"^\s*(?:(?<origin>.*?)\s*:\s*)?(?<kind>error|warning)\s+(?<code>[A-Za-z]+\d+)\s*:\s*(?<text>.*)$");
          var location = new Regex(@"^(?<file>.*?)\s*\((?<line>\d+)(?:[,-](?<column>\d+))?[^)]*\)$");
          // svelte-check reports in neither form. Its default output names the
          // absolute file as "file:line:column" on one line and the message as
          // "Error: text" or "Warn: text" on the next; --output machine prints
          // '<time> ERROR "file" line:column "text"'. Both are logged when the
          // command failed, so a check that only warns still builds.
          var ansi = new Regex(@"\x1B\[[0-9;]*m");
          var svelteLocation = new Regex(@"^(?<file>.+?):(?<line>\d+):(?<column>\d+)$");
          var svelteMessage = new Regex(@"^(?<kind>Error|Warn):\s*(?<text>.*)$");
          // Off Windows, MSBuild turns every backslash in an output line into a
          // slash, so an escaped quote in its JSON strings arrives as /".
          var svelteMachine = new Regex(@"^\d+\s+(?<kind>ERROR|WARNING)\s+(?<file>""(?:[^""\\]|\\.|/"")*"")\s+(?<line>\d+):(?<column>\d+)\s+(?<text>""(?:[^""\\]|\\.|/"")*"")\s*$");
          var lines = new System.Collections.Generic.List<string>();
          foreach (var item in Lines ?? new Microsoft.Build.Framework.ITaskItem[0]) lines.Add(ansi.Replace(item.ItemSpec, ""));
          bool reportedError = false;
          for (int index = 0; index < lines.Count; index++)
          {
            if (ExitCode != 0 && TryReportSvelteCheck(lines, index, svelteLocation, svelteMessage, svelteMachine, ref reportedError)) continue;
            Match match = diagnostic.Match(lines[index]);
            if (!match.Success) continue;
            // A diagnostic without an origin, such as the generator's, belongs to the project.
            string file = match.Groups["origin"].Value.Trim();
            int line = 0, column = 0;
            Match at = location.Match(file);
            if (at.Success)
            {
              file = at.Groups["file"].Value;
              line = int.Parse(at.Groups["line"].Value);
              if (at.Groups["column"].Success) column = int.Parse(at.Groups["column"].Value);
            }
            file = Resolve(file);
            if (match.Groups["kind"].Value == "error")
            {
              reportedError = true;
              Log.LogError(null, match.Groups["code"].Value, null, file, line, column, 0, 0, match.Groups["text"].Value);
            }
            else
            {
              Log.LogWarning(null, match.Groups["code"].Value, null, file, line, column, 0, 0, match.Groups["text"].Value);
            }
          }
          if (ExitCode != 0 && !reportedError)
          {
            Log.LogError(null, FailureCode, null, FailureFile, 0, 0, 0, 0, FailureText);
          }
          return !Log.HasLoggedErrors;
        }

        // A relative file belongs to the command's working directory; no file belongs to the project.
        private string Resolve(string file)
        {
          if (file.Length > 0 && file.IndexOfAny(Path.GetInvalidPathChars()) < 0)
          {
            if (!Path.IsPathRooted(file) && !string.IsNullOrEmpty(WorkingDirectory)) file = Path.GetFullPath(Path.Combine(WorkingDirectory, file));
            else if (Path.IsPathRooted(file)) file = Path.GetFullPath(file);
          }
          return file.Length == 0 ? FailureFile ?? "" : file;
        }

        private bool TryReportSvelteCheck(System.Collections.Generic.List<string> lines, int index,
          Regex location, Regex message, Regex machine, ref bool reportedError)
        {
          string kind, file, text;
          int line, column;
          Match match = machine.Match(lines[index]);
          if (match.Success)
          {
            kind = match.Groups["kind"].Value == "ERROR" ? "error" : "warning";
            file = DecodeJsonString(match.Groups["file"].Value);
            text = DecodeJsonString(match.Groups["text"].Value);
          }
          else
          {
            match = location.Match(lines[index].Trim());
            if (!match.Success || index + 1 >= lines.Count || !Path.IsPathRooted(match.Groups["file"].Value)) return false;
            Match next = message.Match(lines[index + 1].Trim());
            if (!next.Success) return false;
            kind = next.Groups["kind"].Value == "Error" ? "error" : "warning";
            file = match.Groups["file"].Value;
            text = next.Groups["text"].Value;
          }
          line = int.Parse(match.Groups["line"].Value);
          column = int.Parse(match.Groups["column"].Value);
          file = Resolve(file);
          // svelte-check prints no diagnostic code; the message is enough to link the location.
          if (kind == "error")
          {
            reportedError = true;
            Log.LogError(null, null, null, file, line, column, 0, 0, text);
          }
          else
          {
            Log.LogWarning(null, null, null, file, line, column, 0, 0, text);
          }
          return true;
        }

        // Decodes a JSON string. A slash before a quote is an escaped quote, and
        // one before n and an indent is a line break, as MSBuild left them.
        private static string DecodeJsonString(string quoted)
        {
          var text = new System.Text.StringBuilder();
          int end = quoted.Length - 1;
          for (int i = 1; i < end; i++)
          {
            char c = quoted[i];
            if (c == '/' && i + 1 < end && (quoted[i + 1] == '"' || (quoted[i + 1] == 'n' && i + 2 < end && quoted[i + 2] == ' ')))
            {
              text.Append(quoted[++i] == 'n' ? '\n' : '"');
              continue;
            }
            if (c != '\\' || i + 1 >= end) { text.Append(c); continue; }
            char escaped = quoted[++i];
            switch (escaped)
            {
              case 'n': text.Append('\n'); break;
              case 'r': text.Append('\r'); break;
              case 't': text.Append('\t'); break;
              case 'b': text.Append('\b'); break;
              case 'f': text.Append('\f'); break;
              case 'u' when i + 4 < end:
                text.Append((char)Convert.ToInt32(quoted.Substring(i + 1, 4), 16));
                i += 4;
                break;
              default: text.Append(escaped); break;
            }
          }
          return text.ToString();
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <!-- The frontend package manager follows package.json "packageManager",
       then the committed lock file, then npm. It selects the default build
       and install commands; set either command explicitly to override it. -->
  <PropertyGroup Condition="'$(RunicApplicationFrontendPackageManager)' == '' and Exists('$(RunicApplicationFrontendDirectory)/package.json')">
    <RunicApplicationFrontendPackageManager>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(RunicApplicationFrontendDirectory)/package.json')), '(?&lt;="packageManager"\s*:\s*")(npm|pnpm|bun)(?=@)'))</RunicApplicationFrontendPackageManager>
  </PropertyGroup>
  <PropertyGroup>
    <_RunicBridgeDefaultFrontendBuild Condition="'$(RunicApplicationFrontendBuildCommand)' == ''">true</_RunicBridgeDefaultFrontendBuild>
    <RunicApplicationFrontendPackageManager Condition="'$(RunicApplicationFrontendPackageManager)' == '' and Exists('$(RunicApplicationFrontendDirectory)/pnpm-lock.yaml')">pnpm</RunicApplicationFrontendPackageManager>
    <RunicApplicationFrontendPackageManager Condition="'$(RunicApplicationFrontendPackageManager)' == '' and Exists('$(RunicApplicationFrontendDirectory)/bun.lock')">bun</RunicApplicationFrontendPackageManager>
    <RunicApplicationFrontendPackageManager Condition="'$(RunicApplicationFrontendPackageManager)' == ''">npm</RunicApplicationFrontendPackageManager>
    <RunicApplicationFrontendBuildCommand Condition="'$(RunicApplicationFrontendBuildCommand)' == '' and '$(RunicApplicationFrontendPackageManager)' == 'pnpm'">pnpm run build</RunicApplicationFrontendBuildCommand>
    <RunicApplicationFrontendBuildCommand Condition="'$(RunicApplicationFrontendBuildCommand)' == '' and '$(RunicApplicationFrontendPackageManager)' == 'bun'">bun run --bun build</RunicApplicationFrontendBuildCommand>
    <RunicApplicationFrontendBuildCommand Condition="'$(RunicApplicationFrontendBuildCommand)' == ''">npm run build</RunicApplicationFrontendBuildCommand>
    <!-- A project may still set its own command after importing these targets. -->
    <_RunicBridgeDefaultFrontendBuildCommand Condition="'$(_RunicBridgeDefaultFrontendBuild)' == 'true'">$(RunicApplicationFrontendBuildCommand)</_RunicBridgeDefaultFrontendBuildCommand>
    <RunicApplicationFrontendInstallCommand Condition="'$(RunicApplicationFrontendInstallCommand)' == '' and '$(RunicApplicationFrontendPackageManager)' == 'pnpm'">pnpm install --frozen-lockfile --ignore-scripts</RunicApplicationFrontendInstallCommand>
    <RunicApplicationFrontendInstallCommand Condition="'$(RunicApplicationFrontendInstallCommand)' == '' and '$(RunicApplicationFrontendPackageManager)' == 'bun'">bun install --frozen-lockfile --ignore-scripts</RunicApplicationFrontendInstallCommand>
    <RunicApplicationFrontendInstallCommand Condition="'$(RunicApplicationFrontendInstallCommand)' == '' and Exists('$(RunicApplicationFrontendDirectory)/package-lock.json')">npm ci --ignore-scripts</RunicApplicationFrontendInstallCommand>
    <RunicApplicationFrontendInstallCommand Condition="'$(RunicApplicationFrontendInstallCommand)' == ''">npm install --ignore-scripts</RunicApplicationFrontendInstallCommand>
  </PropertyGroup>

  <PropertyGroup>
    <_RunicBridgeCodegenProject>$(MSBuildThisFileDirectory)../../../../tools/Runic.Application.Views.Codegen/Runic.Application.Views.Codegen.csproj</_RunicBridgeCodegenProject>
    <_RunicBridgeCodegenDll Condition="Exists('$(_RunicBridgeCodegenProject)')">$(MSBuildThisFileDirectory)../../../../tools/Runic.Application.Views.Codegen/bin/$(Configuration)/net10.0/BridgeCodegen.dll</_RunicBridgeCodegenDll>
    <_RunicBridgeCodegenDll Condition="!Exists('$(_RunicBridgeCodegenProject)')">$(MSBuildThisFileDirectory)../tools/net10.0/BridgeCodegen.dll</_RunicBridgeCodegenDll>
    <_RunicBridgeAotArgument Condition="'$(PublishAot)' == 'true'">--aot</_RunicBridgeAotArgument>
    <_RunicBridgeCompositionArgument Condition="'$(RunicApplicationFrontendCompositionType)' != ''">--di-composition &quot;$(RunicApplicationFrontendCompositionType)&quot;</_RunicBridgeCompositionArgument>
  </PropertyGroup>

  <!-- Include the source tool in the restore graph so a first IDE build can
       compile it without a separate manual restore. It is not an app reference. -->
  <ItemGroup Condition="Exists('$(_RunicBridgeCodegenProject)') and '$(RunicApplicationFrontendBootstrap)' != 'true'">
    <ProjectReference Include="$(_RunicBridgeCodegenProject)" ReferenceOutputAssembly="false"
                      GlobalPropertiesToRemove="PublishAot;RuntimeIdentifier;SelfContained" />
  </ItemGroup>

  <!-- The bootstrap pass sets its own output paths. Referenced projects (a
       model project beside a WPF application, for example) keep the
       properties of the real build, so they are not compiled again into the
       bootstrap directories. -->
  <ItemGroup Condition="'$(RunicApplicationFrontendBootstrap)' == 'true'">
    <ProjectReference Update="@(ProjectReference)"
                      GlobalPropertiesToRemove="%(GlobalPropertiesToRemove);RunicApplicationFrontendBootstrap;RunAnalyzers;RunCodeAnalysis;CopyLocalLockFileAssemblies;OutputPath;IntermediateOutputPath" />
  </ItemGroup>

  <!-- RUNICBRIDGE017 fails the build once per renamed property or item that the project still sets.
       The bootstrap pass and WPF's temporary markup project see the same
       properties, so only the real build reports it. -->
  <!-- The files these targets keep between builds live in the project's
       intermediate directories, so UseArtifactsOutput and a custom
       BaseIntermediateOutputPath or IntermediateOutputPath move them too.
       The paths are set when a target needs them: IntermediateOutputPath,
       with its runtime identifier, is final only after the SDK's targets,
       which a project may import after these.
       - The generated Bridge code is compiled with the project, so it lives
         in IntermediateOutputPath, per configuration, target framework and
         runtime identifier.
       - The bootstrap pass builds without a runtime identifier, below
         BaseIntermediateOutputPath.
       - The frontend's dist/ serves every runtime identifier, so its build
         stamp and the list of files that build left in dist/ are per
         configuration and target framework below BaseIntermediateOutputPath.
         The hash of the build state that last built dist/ is shared by all
         of them: a build whose state differs from the one that built dist/
         rebuilds, as does a missing file. One install serves every
         configuration and target framework, and dotnet clean keeps it.
       WPF's temporary markup project (see RunicViewsMarkupTemporaryCompile)
       gets another IntermediateOutputPath: off Windows, WPF does not remove
       the target framework before passing it on, so the copy appends it
       again. The real project therefore records its generated directory
       below BaseIntermediateOutputPath, which WPF passes unchanged. -->
  <Target Name="_RunicViewsIntermediatePaths">
    <PropertyGroup>
      <_RunicBridgeBaseIntermediateDirectory>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$([MSBuild]::ValueOrDefault('$(BaseIntermediateOutputPath)', 'obj'))'))</_RunicBridgeBaseIntermediateDirectory>
      <_RunicBridgeConfigurationIntermediateDirectory>$([MSBuild]::NormalizeDirectory('$(_RunicBridgeBaseIntermediateDirectory)', '$(Configuration)', '$(TargetFramework)'))</_RunicBridgeConfigurationIntermediateDirectory>
      <_RunicBridgeIntermediateDirectory Condition="'$(IntermediateOutputPath)' != ''">$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)'))</_RunicBridgeIntermediateDirectory>
      <_RunicBridgeIntermediateDirectory Condition="'$(IntermediateOutputPath)' == ''">$(_RunicBridgeConfigurationIntermediateDirectory)</_RunicBridgeIntermediateDirectory>
      <_RunicBridgeGeneratedDir>$(_RunicBridgeIntermediateDirectory)runic-bridge/</_RunicBridgeGeneratedDir>
      <_RunicBridgeBootstrapOutputPath>$(_RunicBridgeBaseIntermediateDirectory)runic-bridge/bootstrap/bin/$(Configuration)/$(TargetFramework)/</_RunicBridgeBootstrapOutputPath>
      <_RunicBridgeBootstrapIntermediateOutputPath>$(_RunicBridgeBaseIntermediateDirectory)runic-bridge/bootstrap/obj/$(Configuration)/$(TargetFramework)/</_RunicBridgeBootstrapIntermediateOutputPath>
      <_RunicBridgeFrontendStamp>$(_RunicBridgeConfigurationIntermediateDirectory)runic-bridge-frontend.stamp</_RunicBridgeFrontendStamp>
      <_RunicBridgeFrontendOutputsFile>$(_RunicBridgeConfigurationIntermediateDirectory)runic-bridge-frontend.outputs</_RunicBridgeFrontendOutputsFile>
      <_RunicBridgeFrontendStateFile>$(_RunicBridgeBaseIntermediateDirectory)runic-bridge-frontend.state</_RunicBridgeFrontendStateFile>
      <_RunicBridgeFrontendInstallStamp>$(_RunicBridgeBaseIntermediateDirectory)runic-bridge-frontend-install.stamp</_RunicBridgeFrontendInstallStamp>
      <_RunicBridgeGeneratedDirRecord>$(_RunicBridgeBaseIntermediateDirectory)runic-bridge/$(AssemblyName)-$(Configuration)-$(TargetFramework)-$(RuntimeIdentifier).generated-directory</_RunicBridgeGeneratedDirRecord>
      <_RunicBridgeGeneratedDir Condition="'$(_RunicBridgeMarkupTemporary)' == 'true' and Exists('$(_RunicBridgeGeneratedDirRecord)')">$([System.IO.File]::ReadAllText('$(_RunicBridgeGeneratedDirRecord)').Trim())</_RunicBridgeGeneratedDir>
    </PropertyGroup>
  </Target>

  <Target Name="RunicViewsReportRenamedProperties" BeforeTargets="PrepareForBuild"
          Condition="('@(_RunicApplicationFrontendRenamedName)' != '' or '@(_RunicApplicationFrontendRemovedName)' != '') and '$(DesignTimeBuild)' != 'true' and '$(RunicApplicationFrontendBootstrap)' != 'true' and '$(_RunicBridgeMarkupTemporary)' != 'true'">
    <!-- ErrorAndContinue reports every old name, not only the first. -->
    <Error Code="RUNICBRIDGE017" File="$(MSBuildProjectFullPath)" HelpLink="$(_RunicDiagnosticsHelpLinkBase)runicbridge017" ContinueOnError="ErrorAndContinue"
           Condition="'@(_RunicApplicationFrontendRenamedName)' != ''"
           Text="The Runic build %(_RunicApplicationFrontendRenamedName.Kind) %(_RunicApplicationFrontendRenamedName.Identity) is renamed to %(_RunicApplicationFrontendRenamedName.NewName). The old name no longer applies; rename it in $(MSBuildProjectFile), its imports or the command line." />
    <Error Code="RUNICBRIDGE017" File="$(MSBuildProjectFullPath)" HelpLink="$(_RunicDiagnosticsHelpLinkBase)runicbridge017" ContinueOnError="ErrorAndContinue"
           Condition="'@(_RunicApplicationFrontendRemovedName)' != ''"
           Text="The Runic build property %(_RunicApplicationFrontendRemovedName.Identity) is removed. %(_RunicApplicationFrontendRemovedName.Reason); remove the property from $(MSBuildProjectFile), its imports or the command line." />
  </Target>

  <!-- Generation turns on for a project that references Runic.Application.Views
       directly, or that references a host adapter directly or transitively:
       each adapter's props set _RunicApplicationHostAdapter=true. -->
  <Target Name="RunicViewsDetectBridgeUse" BeforeTargets="PrepareForBuild">
    <ItemGroup>
      <_RunicBridgeDirectPackage Include="@(PackageReference)"
        Condition="'%(PackageReference.Identity)' == 'Runic.Application.Views'" />
    </ItemGroup>
    <!-- A test project (IsTestProject, which Microsoft.NET.Test.Sdk and TUnit
         set) that references a Runic application uses that application's
         generated Bridges. Unless it declares a Window or View itself or
         visibly expects output, generation stays off there, without
         RUNICBRIDGE006 or RUNICBRIDGE015 and without a bootstrap build. Other
         projects keep the diagnostics. -->
    <PropertyGroup>
      <_RunicBridgeTestProject Condition="'$(IsTestProject)' == 'true' and '$(RunicApplicationFrontendGenerationEnabled)' == '' and '$(RunicApplicationFrontendModelAssembly)' == '' and '@(RunicApplicationFrontendInput)' == '' and !Exists('$(RunicApplicationFrontendDirectory)/package.json')">true</_RunicBridgeTestProject>
    </PropertyGroup>
    <ItemGroup Condition="'$(_RunicBridgeTestProject)' == 'true'">
      <_RunicBridgeTestViewSource Include="@(Compile)"
        Condition="Exists('%(Compile.FullPath)') and $([System.Text.RegularExpressions.Regex]::IsMatch($([System.IO.File]::ReadAllText('%(Compile.FullPath)')), ':\s*(global::)?(Runic\.Application\.Views\.)?Runic(Window|View)\s*&lt;'))" />
    </ItemGroup>
    <PropertyGroup Condition="'$(_RunicBridgeTestProject)' == 'true' and '@(_RunicBridgeTestViewSource)' == ''">
      <RunicApplicationFrontendGenerationEnabled>false</RunicApplicationFrontendGenerationEnabled>
    </PropertyGroup>
    <!-- Generation that this file turns on by default is optional: a project
         that declares no Window or View (for example one that only uses the
         navigator) builds without bridge output. A project that sets
         RunicApplicationFrontendGenerationEnabled=true, or visibly expects output (a frontend
         package.json, RunicApplicationFrontendInput items, a composition type or a
         model assembly), still gets RUNICBRIDGE006 when it has no Window.
         A WPF application may keep its web Views in a referenced model
         project, so there the adapter's default composition type alone does
         not require them. -->
    <PropertyGroup>
      <_RunicBridgeOptional Condition="'$(RunicApplicationFrontendGenerationEnabled)' == '' and ('$(RunicApplicationFrontendCompositionType)' == '' or '$(UseWPF)' == 'true') and '$(RunicApplicationFrontendModelAssembly)' == '' and '@(RunicApplicationFrontendInput)' == '' and !Exists('$(RunicApplicationFrontendDirectory)/package.json')">true</_RunicBridgeOptional>
      <_RunicBridgeDefaultedOff Condition="'$(RunicApplicationFrontendGenerationEnabled)' == ''">true</_RunicBridgeDefaultedOff>
      <RunicApplicationFrontendGenerationEnabled Condition="'$(RunicApplicationFrontendGenerationEnabled)' == '' and Exists('$(_RunicBridgeCodegenProject)')">true</RunicApplicationFrontendGenerationEnabled>
      <RunicApplicationFrontendGenerationEnabled Condition="'$(RunicApplicationFrontendGenerationEnabled)' == '' and ('@(_RunicBridgeDirectPackage)' != '' or '$(_RunicApplicationHostAdapter)' == 'true')">true</RunicApplicationFrontendGenerationEnabled>
      <RunicApplicationFrontendGenerationEnabled Condition="'$(RunicApplicationFrontendGenerationEnabled)' == ''">false</RunicApplicationFrontendGenerationEnabled>
      <_RunicBridgeDefaultedOff Condition="'$(RunicApplicationFrontendGenerationEnabled)' != 'false'"></_RunicBridgeDefaultedOff>
    </PropertyGroup>
  </Target>

  <!-- Without generation, a declared Window or View gets no bridge,
       AddRunicViews() or TypeScript client, and the first sign would be a
       CS1061 at the call. When generation is off only by default (no host
       adapter and no direct Runic.Application.Views reference), look for a class
       deriving from RunicWindow<T> or RunicView<T> and say so once. -->
  <Target Name="RunicViewsCheckDisabledGeneration" BeforeTargets="CoreCompile"
          DependsOnTargets="RunicViewsDetectBridgeUse"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(RunicApplicationFrontendBootstrap)' != 'true' and '$(_RunicBridgeMarkupTemporary)' != 'true'">
    <ItemGroup Condition="'$(_RunicBridgeDefaultedOff)' == 'true'">
      <_RunicBridgeViewSource Include="@(Compile)"
        Condition="Exists('%(Compile.FullPath)') and $([System.Text.RegularExpressions.Regex]::IsMatch($([System.IO.File]::ReadAllText('%(Compile.FullPath)')), ':\s*(global::)?(Runic\.Application\.Views\.)?Runic(Window|View)\s*&lt;'))" />
    </ItemGroup>
    <Warning Code="RUNICBRIDGE015" Condition="'@(_RunicBridgeViewSource)' != ''"
             File="$(MSBuildProjectFullPath)" HelpLink="$(_RunicDiagnosticsHelpLinkBase)runicbridge015"
             Text="$(AssemblyName) declares a Runic Window or View (@(_RunicBridgeViewSource->'%(Filename)%(Extension)', ', ')), but Bridge generation is off because the project references no host adapter (Runic.Application.Views.Desktop, Runic.Application.Views.CsWebUi or Runic.Application.Views.Wpf) and not Runic.Application.Views directly. No bridge, AddRunicViews() or TypeScript client is generated. Set RunicApplicationFrontendGenerationEnabled=true to generate them here, or false when another project generates them." />
  </Target>

  <Target Name="RunicViewsDesignTimeComposition" BeforeTargets="CoreCompile"
          DependsOnTargets="_RunicViewsIntermediatePaths;RunicViewsDetectBridgeUse;ResolveAssemblyReferences"
          Condition="'$(RunicApplicationFrontendGenerationEnabled)' == 'true' and '$(DesignTimeBuild)' == 'true' and '$(RunicApplicationFrontendBootstrap)' != 'true'">
    <MSBuild Projects="$(_RunicBridgeCodegenProject)" Targets="Build"
             Properties="Configuration=$(Configuration);TargetFramework=net10.0;RuntimeIdentifier=;PublishAot=false;SelfContained=false"
             Condition="Exists('$(_RunicBridgeCodegenProject)') and '$(RunicApplicationFrontendCompositionType)' != ''" />
    <MakeDir Directories="$(_RunicBridgeGeneratedDir)" />
    <WriteLinesToFile File="$(_RunicBridgeGeneratedDir)RunicBridgeComposition.References.txt" Lines="@(ReferencePath)" Overwrite="true" WriteOnlyWhenDifferent="true"
                      Condition="'$(RunicApplicationFrontendCompositionType)' != ''" />
    <Exec Command="dotnet &quot;$(_RunicBridgeCodegenDll)&quot; --composition-stub &quot;$(RunicApplicationFrontendCompositionType)&quot; &quot;$(_RunicBridgeGeneratedDir)RunicBridgeComposition.DesignTime.g.cs&quot; --references &quot;$(_RunicBridgeGeneratedDir)RunicBridgeComposition.References.txt&quot;"
          StandardOutputImportance="normal"
          Condition="'$(RunicApplicationFrontendCompositionType)' != ''" />
    <ItemGroup>
      <Compile Include="$(_RunicBridgeGeneratedDir)*.Bridge.g.cs;$(_RunicBridgeGeneratedDir)*.View.g.cs" />
      <Compile Include="$(_RunicBridgeGeneratedDir)RunicBridgeComposition.DesignTime.g.cs"
               Condition="'$(RunicApplicationFrontendCompositionType)' != '' and Exists('$(_RunicBridgeGeneratedDir)RunicBridgeComposition.DesignTime.g.cs')" />
    </ItemGroup>
  </Target>

  <!-- The bootstrap pass compiles the application before its Bridges exist.
       An empty composition lets Program.cs call AddRunicViews() or
       AddRunicBridges() in that pass, so a starter needs no bootstrap-only
       OutputType or Compile changes. When a reference already declares the
       composition type, as a model project of a 0.7.0-preview.6 WPF app named
       after the application does, calls bind to that type and no stub is
       written (it would make them ambiguous, CS0121). -->
  <Target Name="RunicViewsBootstrapComposition" BeforeTargets="CoreCompile;GenerateTemporaryTargetAssembly"
          DependsOnTargets="ResolveAssemblyReferences"
          Condition="'$(RunicApplicationFrontendBootstrap)' == 'true' and '$(RunicApplicationFrontendCompositionType)' != '' and '$(_RunicBridgeMarkupTemporary)' != 'true'">
    <PropertyGroup>
      <_RunicBridgeBootstrapComposition>$(IntermediateOutputPath)RunicBridgeComposition.Bootstrap.g.cs</_RunicBridgeBootstrapComposition>
      <_RunicBridgeBootstrapReferences>$(IntermediateOutputPath)RunicBridgeComposition.References.txt</_RunicBridgeBootstrapReferences>
    </PropertyGroup>
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <WriteLinesToFile File="$(_RunicBridgeBootstrapReferences)" Lines="@(ReferencePath)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <Exec Command="dotnet &quot;$(_RunicBridgeCodegenDll)&quot; --composition-stub &quot;$(RunicApplicationFrontendCompositionType)&quot; &quot;$(_RunicBridgeBootstrapComposition)&quot; --references &quot;$(_RunicBridgeBootstrapReferences)&quot;"
          StandardOutputImportance="normal" />
    <ItemGroup>
      <Compile Include="$(_RunicBridgeBootstrapComposition)" Condition="Exists('$(_RunicBridgeBootstrapComposition)')" />
    </ItemGroup>
  </Target>

  <!-- The generator copies XML documentation comments into the generated
       TypeScript. When the project does not already write a documentation
       file, the bootstrap pass writes one beside the inspected assembly with
       the documentation warnings suppressed, so the real build is unchanged.
       Set RunicApplicationFrontendDocumentationEnabled=false to skip it. -->
  <Target Name="RunicViewsBootstrapDocumentation" BeforeTargets="CoreCompile"
          Condition="'$(RunicApplicationFrontendBootstrap)' == 'true' and '$(_RunicBridgeMarkupTemporary)' != 'true' and '$(RunicApplicationFrontendDocumentationEnabled)' != 'false' and '@(DocFileItem)' == ''">
    <PropertyGroup>
      <NoWarn>$(NoWarn);CS1570;CS1571;CS1572;CS1573;CS1574;CS1580;CS1581;CS1584;CS1587;CS1589;CS1590;CS1591;CS1592;CS1658;CS1710;CS1711;CS1712;CS1723;CS1734;CS1735</NoWarn>
    </PropertyGroup>
    <MakeDir Directories="$(OutDir)" />
    <ItemGroup>
      <DocFileItem Include="$(OutDir)$(AssemblyName).xml" />
      <FileWrites Include="$(OutDir)$(AssemblyName).xml" />
    </ItemGroup>
  </Target>

  <!-- A deterministic build (ContinuousIntegrationBuild, or
       DeterministicSourcePaths) maps source paths in the PDB, for example to
       /_/. The generator reads source through the PDB to recover the comments
       of MVVM partial properties, so pass it the same map as the compiler to
       resolve them back to local files. -->
  <Target Name="RunicViewsBridgePathMap" DependsOnTargets="InitializeSourceRootMappedPaths"
          Condition="'$(SourceRootMappedPathsFeatureSupported)' == 'true'">
    <ItemGroup>
      <_RunicBridgeMappedSourceRoot Include="@(SourceRoot)" Condition="'%(SourceRoot.NestedRoot)' == '' and '%(SourceRoot.MappedPath)' != '' and '%(SourceRoot.MappedPath)' != '%(SourceRoot.Identity)'">
        <EscapedKey>$([MSBuild]::ValueOrDefault('%(Identity)', '').Replace(',', ',,').Replace('=', '=='))</EscapedKey>
        <EscapedValue>$([MSBuild]::ValueOrDefault('%(MappedPath)', '').Replace(',', ',,').Replace('=', '=='))</EscapedValue>
      </_RunicBridgeMappedSourceRoot>
    </ItemGroup>
    <PropertyGroup>
      <_RunicBridgePathMap>@(_RunicBridgeMappedSourceRoot->'%(EscapedKey)=%(EscapedValue)', ',')</_RunicBridgePathMap>
      <_RunicBridgePathMap Condition="'$(PathMap)' != ''">$(_RunicBridgePathMap),$(PathMap)</_RunicBridgePathMap>
      <_RunicBridgePathMapArgument Condition="'$(_RunicBridgePathMap)' != ''">--path-map &quot;$(_RunicBridgePathMap)&quot;</_RunicBridgePathMapArgument>
    </PropertyGroup>
  </Target>

  <!-- In a WPF project this runs before the temporary markup assembly, so
       that assembly can compile the generated code (see
       RunicViewsMarkupTemporaryCompile).

       With NoBuild=true (a publish with the no-build option), NativeAOT still
       schedules CoreCompile, which is then up to date. The build that came
       before generated the code, so this target neither builds the generator
       nor runs the bootstrap pass or the generator (Build would fail with
       NETSDK1085); it only adds the generated sources to Compile, and reports
       RUNICBRIDGE022 when they are missing. -->
  <Target Name="RunicViewsGenerateBridge" BeforeTargets="CoreCompile;GenerateTemporaryTargetAssembly"
          DependsOnTargets="_RunicViewsIntermediatePaths;RunicViewsDetectBridgeUse;ResolveProjectReferences;RunicViewsBridgePathMap"
          Condition="'$(RunicApplicationFrontendGenerationEnabled)' == 'true' and '$(DesignTimeBuild)' != 'true' and '$(RunicApplicationFrontendBootstrap)' != 'true' and '$(_RunicBridgeMarkupTemporary)' != 'true'">
    <PropertyGroup>
      <_RunicBridgeReuseGenerated>false</_RunicBridgeReuseGenerated>
      <_RunicBridgeReuseGenerated Condition="'$(NoBuild)' == 'true'">true</_RunicBridgeReuseGenerated>
    </PropertyGroup>
    <MSBuild Projects="$(_RunicBridgeCodegenProject)" Targets="Build"
             Properties="Configuration=$(Configuration);TargetFramework=net10.0;RuntimeIdentifier=;PublishAot=false;SelfContained=false"
             Condition="Exists('$(_RunicBridgeCodegenProject)') and '$(_RunicBridgeReuseGenerated)' != 'true'" />
    <!-- In a one-project starter, first compile the ordinary C# source so MVVM
         source generators have finished before Bridge inspection. Analyzers
         are off in this pass: it only feeds the generator, the real build runs
         them, and the bootstrap's XML documentation file would otherwise
         surface documentation-dependent analyzer warnings. Source generators
         still run. -->
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="Build"
             Properties="RunicApplicationFrontendBootstrap=true;RunAnalyzers=false;RunCodeAnalysis=false;Configuration=$(Configuration);TargetFramework=$(TargetFramework);RuntimeIdentifier=;PublishAot=false;SelfContained=false;CopyLocalLockFileAssemblies=true;OutputPath=$(_RunicBridgeBootstrapOutputPath);IntermediateOutputPath=$(_RunicBridgeBootstrapIntermediateOutputPath)"
             Condition="'$(RunicApplicationFrontendModelAssembly)' == '' and '$(_RunicBridgeReuseGenerated)' != 'true'" />
    <PropertyGroup>
      <_RunicBridgeInputAssembly Condition="'$(RunicApplicationFrontendModelAssembly)' == ''">$(_RunicBridgeBootstrapOutputPath)$(AssemblyName).dll</_RunicBridgeInputAssembly>
      <_RunicBridgeInputAssembly Condition="'$(RunicApplicationFrontendModelAssembly)' != ''">$(RunicApplicationFrontendModelAssembly)</_RunicBridgeInputAssembly>
    </PropertyGroup>
    <Error Code="RUNICBRIDGE001" File="$(MSBuildProjectFullPath)" HelpLink="$(_RunicDiagnosticsHelpLinkBase)runicbridge001"
           Condition="!Exists('$(_RunicBridgeCodegenDll)') and '$(_RunicBridgeReuseGenerated)' != 'true'"
           Text="The Runic Bridge code generator was not found at $(_RunicBridgeCodegenDll). Restore the project again; the Runic.Application.Views package may be incomplete." />
    <PropertyGroup>
      <_RunicBridgeOptionalArgument Condition="'$(_RunicBridgeOptional)' == 'true'">--optional</_RunicBridgeOptionalArgument>
      <_RunicBridgeSkipped>false</_RunicBridgeSkipped>
    </PropertyGroup>
    <!-- The generated code calls the command helpers of the Runic ReactiveUI adapter that this project compiles
         against, so that adapter's flavor is the generator's. Package, transitive package and project references
         all resolve to ReferencePath, which ResolveReferences has filled before CoreCompile and before WPF's
         markup passes. Without the System.Reactive adapter the generator uses its default (primitives). -->
    <ItemGroup>
      <_RunicBridgeReactiveUiReactiveAdapter Include="@(ReferencePath)" Condition="'%(Filename)' == 'Runic.Application.Views.ReactiveUI.Reactive'" />
    </ItemGroup>
    <PropertyGroup>
      <_RunicBridgeReactiveUiFlavor>primitives</_RunicBridgeReactiveUiFlavor>
      <_RunicBridgeReactiveUiFlavor Condition="'@(_RunicBridgeReactiveUiReactiveAdapter)' != ''">reactive</_RunicBridgeReactiveUiFlavor>
      <_RunicBridgeReactiveUiFlavorArgument>--reactiveui-flavor $(_RunicBridgeReactiveUiFlavor)</_RunicBridgeReactiveUiFlavorArgument>
    </PropertyGroup>
    <!-- The shared frameworks the application uses, directly or through a
         package (Runic.Desktop references Microsoft.AspNetCore.App). The
         generator runs on Microsoft.NETCore.App and loads the application's
         assemblies from these frameworks; it never loads
         Microsoft.WindowsDesktop.App, whose types it skips on every OS. -->
    <ItemGroup>
      <_RunicBridgeSharedFramework Include="@(FrameworkReference->Distinct())" Exclude="Microsoft.NETCore.App" />
    </ItemGroup>
    <PropertyGroup>
      <_RunicBridgeFrameworkArgument>@(_RunicBridgeSharedFramework->'--framework &quot;%(Identity)&quot;', ' ')</_RunicBridgeFrameworkArgument>
    </PropertyGroup>
    <Delete Files="$(_RunicBridgeGeneratedDir)$(_RunicBridgeNoViewsMarker)" Condition="'$(_RunicBridgeReuseGenerated)' != 'true'" />
    <!-- The generator reports its diagnostics in canonical form. They are
         logged once with their codes (see RunicViewsReportCommandResult);
         a failure that reported none is RUNICBRIDGE024, an internal error. -->
    <Exec Command="dotnet &quot;$(_RunicBridgeCodegenDll)&quot; --generate &quot;$(_RunicBridgeInputAssembly)&quot; &quot;$(_RunicBridgeGeneratedDir)&quot; &quot;$(RunicApplicationFrontendGeneratedDirectory)&quot; $(_RunicBridgeAotArgument) $(_RunicBridgeCompositionArgument) $(_RunicBridgeReactiveUiFlavorArgument) $(_RunicBridgeOptionalArgument) $(_RunicBridgePathMapArgument) $(_RunicBridgeFrameworkArgument)"
          ConsoleToMSBuild="true" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true"
          Condition="'$(_RunicBridgeReuseGenerated)' != 'true'">
      <Output TaskParameter="ExitCode" PropertyName="_RunicBridgeCodegenExitCode" />
      <Output TaskParameter="ConsoleOutput" ItemName="_RunicBridgeCodegenOutputLine" />
    </Exec>
    <PropertyGroup>
      <_RunicBridgeCodegenDiagnostics Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(_RunicBridgeCodegenOutputLine.Identity)', '$(_RunicBridgeCanonicalDiagnostic)'))">true</_RunicBridgeCodegenDiagnostics>
    </PropertyGroup>
    <RunicViewsReportCommandResult Condition="'$(_RunicBridgeReuseGenerated)' != 'true' and ('$(_RunicBridgeCodegenExitCode)' != '0' or '$(_RunicBridgeCodegenDiagnostics)' == 'true')"
        Lines="@(_RunicBridgeCodegenOutputLine)" ExitCode="$(_RunicBridgeCodegenExitCode)"
        FailureCode="RUNICBRIDGE024" FailureFile="$(MSBuildProjectFullPath)"
        FailureText="The Runic Bridge generator exited with code $(_RunicBridgeCodegenExitCode) without reporting an error while inspecting $(_RunicBridgeInputAssembly), an internal generator error. Its output is above; include it when you report the problem." />
    <PropertyGroup>
      <_RunicBridgeSkipped Condition="Exists('$(_RunicBridgeGeneratedDir)$(_RunicBridgeNoViewsMarker)')">true</_RunicBridgeSkipped>
    </PropertyGroup>
    <ItemGroup Condition="'$(_RunicBridgeReuseGenerated)' == 'true' and '$(_RunicBridgeSkipped)' != 'true'">
      <_RunicBridgeGeneratedSource Include="$(_RunicBridgeGeneratedDir)*.Bridge.g.cs;$(_RunicBridgeGeneratedDir)*.View.g.cs" />
    </ItemGroup>
    <Error Code="RUNICBRIDGE022" File="$(MSBuildProjectFullPath)" HelpLink="$(_RunicDiagnosticsHelpLinkBase)runicbridge022"
           Condition="'$(_RunicBridgeReuseGenerated)' == 'true' and '$(_RunicBridgeSkipped)' != 'true' and ('@(_RunicBridgeGeneratedSource)' == '' or ('$(RunicApplicationFrontendCompositionType)' != '' and !Exists('$(_RunicBridgeGeneratedDir)RunicBridgeComposition.g.cs')))"
           Text="$(AssemblyName) is built with NoBuild=true, as by dotnet publish --no-build, but $([System.IO.Path]::GetFullPath('$(_RunicBridgeGeneratedDir)')) has no Runic Bridge code from an earlier build, and NoBuild does not run the generator. Build the project with the same Configuration, TargetFramework, RuntimeIdentifier and PublishAot first, or publish without --no-build." />
    <Message Importance="normal" Condition="'$(_RunicBridgeSkipped)' == 'true'"
             Text="Runic Bridge: $(AssemblyName) declares no Runic Window or View, so no bridge code or frontend build is generated. Set RunicApplicationFrontendGenerationEnabled=true to require them, or false to skip the bootstrap build entirely." />
    <ItemGroup Condition="'$(_RunicBridgeSkipped)' == 'true'">
      <FileWrites Include="$(_RunicBridgeGeneratedDir)$(_RunicBridgeNoViewsMarker)" />
    </ItemGroup>
    <!-- The bootstrap pass found the composition type in a reference (see
         RunicViewsBootstrapComposition). A second composition of that name
         here would make AddRunicViews() ambiguous. -->
    <PropertyGroup>
      <_RunicBridgeCompositionDeclaredByMarker>$(_RunicBridgeBootstrapIntermediateOutputPath)RunicBridgeComposition.DeclaredBy.txt</_RunicBridgeCompositionDeclaredByMarker>
      <_RunicBridgeCompositionDeclaredBy Condition="'$(RunicApplicationFrontendModelAssembly)' == '' and Exists('$(_RunicBridgeCompositionDeclaredByMarker)')">$([System.IO.File]::ReadAllText('$(_RunicBridgeCompositionDeclaredByMarker)').Trim())</_RunicBridgeCompositionDeclaredBy>
    </PropertyGroup>
    <Error Code="RUNICBRIDGE018" File="$(MSBuildProjectFullPath)" HelpLink="$(_RunicDiagnosticsHelpLinkBase)runicbridge018"
           Condition="'$(RunicApplicationFrontendCompositionType)' != '' and '$(_RunicBridgeSkipped)' != 'true' and '$(_RunicBridgeCompositionDeclaredBy)' != ''"
           Text="$(AssemblyName) declares Runic Views and generates the composition $(RunicApplicationFrontendCompositionType), but the referenced assembly $(_RunicBridgeCompositionDeclaredBy) already declares that type, so AddRunicViews() would be ambiguous. Set RunicApplicationFrontendCompositionType to another type name in $(MSBuildProjectFile) or in the project that builds $(_RunicBridgeCompositionDeclaredBy)." />
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(_RunicBridgeGeneratedDirRecord)'))" Condition="'$(UseWPF)' == 'true'" />
    <WriteLinesToFile File="$(_RunicBridgeGeneratedDirRecord)" Lines="$(_RunicBridgeGeneratedDir)" Overwrite="true" WriteOnlyWhenDifferent="true"
                      Condition="'$(UseWPF)' == 'true'" />
    <ItemGroup>
      <Compile Include="$(_RunicBridgeGeneratedDir)*.Bridge.g.cs;$(_RunicBridgeGeneratedDir)*.View.g.cs" />
      <Compile Include="$(_RunicBridgeGeneratedDir)RunicBridgeComposition.g.cs" Condition="'$(RunicApplicationFrontendCompositionType)' != '' and '$(_RunicBridgeSkipped)' != 'true'" />
    </ItemGroup>
  </Target>

  <!-- WPF's temporary markup project is a copy of the project file, so it
       sees none of the Compile items added above. Compile the code that the
       real project (or its bootstrap pass) has just generated, so that
       code-behind calling AddRunicViews() or a generated View member
       resolves in that assembly too. -->
  <Target Name="RunicViewsMarkupTemporaryCompile" BeforeTargets="CoreCompile"
          DependsOnTargets="_RunicViewsIntermediatePaths;RunicViewsDetectBridgeUse"
          Condition="'$(_RunicBridgeMarkupTemporary)' == 'true' and '$(RunicApplicationFrontendGenerationEnabled)' != 'false' and '$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_RunicBridgeBootstrapComposition>$(IntermediateOutputPath)RunicBridgeComposition.Bootstrap.g.cs</_RunicBridgeBootstrapComposition>
    </PropertyGroup>
    <ItemGroup Condition="'$(RunicApplicationFrontendBootstrap)' == 'true' and '$(RunicApplicationFrontendCompositionType)' != ''">
      <Compile Include="$(_RunicBridgeBootstrapComposition)" Condition="Exists('$(_RunicBridgeBootstrapComposition)')" />
    </ItemGroup>
    <ItemGroup Condition="'$(RunicApplicationFrontendBootstrap)' != 'true' and !Exists('$(_RunicBridgeGeneratedDir)$(_RunicBridgeNoViewsMarker)')">
      <Compile Include="$(_RunicBridgeGeneratedDir)*.Bridge.g.cs;$(_RunicBridgeGeneratedDir)*.View.g.cs" />
      <Compile Include="$(_RunicBridgeGeneratedDir)RunicBridgeComposition.g.cs"
               Condition="'$(RunicApplicationFrontendCompositionType)' != '' and Exists('$(_RunicBridgeGeneratedDir)RunicBridgeComposition.g.cs')" />
    </ItemGroup>
  </Target>

  <!-- RunicApplicationHost names the host the application runs on. Each host
       adapter's targets add their name (desktop or cswebui) to
       _RunicApplicationHostNames and copy their Views client to
       www/runic-views.js when RunicApplicationHost names them, or when they
       are the only host referenced, so a page that loads runic-views.js runs
       on every host from one build. A project that references several hosts
       chooses one with RunicApplicationHost (RUNICBRIDGE019 otherwise). The
       frontend build receives the host as RUNIC_APPLICATION_HOST, and a
       change rebuilds the frontend. -->
  <Target Name="RunicViewsResolveHost" BeforeTargets="PrepareForBuild;Publish"
          Condition="'$(RunicApplicationFrontendBootstrap)' != 'true' and '$(_RunicBridgeMarkupTemporary)' != 'true'">
    <ItemGroup>
      <_RunicApplicationHostNameEntry Include="$(_RunicApplicationHostNames)" />
      <_RunicApplicationHostName Include="@(_RunicApplicationHostNameEntry->Distinct())" />
      <_RunicApplicationHostRequestedName Include="@(_RunicApplicationHostName)" Condition="'%(Identity)' == '$(RunicApplicationHost)'" />
    </ItemGroup>
    <PropertyGroup>
      <_RunicApplicationHostRequested>$(RunicApplicationHost)</_RunicApplicationHostRequested>
      <RunicApplicationHost Condition="'$(RunicApplicationHost)' == '' and '@(_RunicApplicationHostName->Count())' == '1'">@(_RunicApplicationHostName)</RunicApplicationHost>
      <_RunicApplicationHostApplication Condition="'$(DesignTimeBuild)' != 'true' and '$(OutputType)' != 'Library' and '$(IsTestProject)' != 'true'">true</_RunicApplicationHostApplication>
      <_RunicApplicationHostAmbiguous Condition="'$(_RunicApplicationHostApplication)' == 'true' and '$(_RunicApplicationHostRequested)' == '' and '@(_RunicApplicationHostName->Count())' != '0' and '@(_RunicApplicationHostName->Count())' != '1'">true</_RunicApplicationHostAmbiguous>
      <_RunicApplicationHostNamesText>@(_RunicApplicationHostName, ', ')</_RunicApplicationHostNamesText>
    </PropertyGroup>
    <!-- Several hosts without a choice warn only when a copied page loads
         runic-views.js (RunicViewsMirrorFrontend): a page that loads a host's
         own client chooses its host at run time. -->
    <Warning Code="RUNICBRIDGE019" File="$(MSBuildProjectFullPath)" HelpLink="$(_RunicDiagnosticsHelpLinkBase)runicbridge019"
             Condition="'$(_RunicApplicationHostApplication)' == 'true' and '$(_RunicApplicationHostRequested)' != '' and '@(_RunicApplicationHostRequestedName)' == '' and '@(_RunicApplicationHostName)' != ''"
             Text="RunicApplicationHost is '$(_RunicApplicationHostRequested)', but $(AssemblyName) references no such Runic host, so the build copies no www/runic-views.js. Set it to one of the referenced hosts: @(_RunicApplicationHostName, ', ')." />
  </Target>

  <!-- The frontend build runs when one of its inputs is newer than the stamp,
       when a file it left in dist/ is missing, or when its build state differs
       from the one that last built dist/. Inputs are the files under the
       frontend directory (excluding node_modules and build output; .env files
       are inputs), the generated TypeScript and this project file. The build
       state is a hash of the build command, RunicApplicationHost, NODE_ENV and
       the variables that RunicApplicationFrontendBuildEnvironment items name.
       The generator rewrites TypeScript only when its content changes, so a
       C#-only edit does not rebuild the frontend.

       RunicApplicationFrontendInput is the extension point for inputs outside
       the frontend directory, such as a monorepo's shared components that the
       frontend imports through a Vite alias:
         <RunicApplicationFrontendInput Include="../ui/lib/**/*" />
       Set RunicApplicationFrontendBuildEnabled=false when another tool owns
       the frontend build. A missing frontend is RUNICBRIDGE014 rather than a
       failed command. -->
  <Target Name="RunicViewsCollectFrontendInputs" AfterTargets="RunicViewsGenerateBridge"
          DependsOnTargets="_RunicViewsIntermediatePaths;RunicViewsResolveHost"
          Condition="'$(RunicApplicationFrontendGenerationEnabled)' == 'true' and '$(_RunicBridgeSkipped)' != 'true' and '$(DesignTimeBuild)' != 'true' and '$(RunicApplicationFrontendBootstrap)' != 'true' and '$(_RunicBridgeMarkupTemporary)' != 'true' and '$(RunicApplicationFrontendBuildEnabled)' != 'false'">
    <Error Code="RUNICBRIDGE014" File="$(MSBuildProjectFullPath)" HelpLink="$(_RunicDiagnosticsHelpLinkBase)runicbridge014"
           Condition="!Exists('$(RunicApplicationFrontendDirectory)') or ('$(RunicApplicationFrontendBuildCommand)' == '$(_RunicBridgeDefaultFrontendBuildCommand)' and !Exists('$(RunicApplicationFrontendDirectory)/package.json'))"
           Text="$(AssemblyName) declares Runic Views, but the frontend directory $([System.IO.Path]::GetFullPath('$(RunicApplicationFrontendDirectory)')) has no package.json to build the generated client in $([System.IO.Path]::GetFullPath('$(RunicApplicationFrontendGeneratedDirectory)')). Create the frontend there, set RunicApplicationFrontendDirectory to your frontend package directory, or set RunicApplicationFrontendBuildEnabled=false when another tool builds it." />
    <!-- A target that ran before generation may still add the old item name;
         items the project declared were reported before the build. -->
    <ItemGroup>
      <_RunicBridgeDeclaredInputRename Include="@(_RunicApplicationFrontendRenamedName)" Condition="'%(Identity)' == 'RunicBridgeFrontendInput'" />
    </ItemGroup>
    <Error Code="RUNICBRIDGE017" Condition="'@(RunicBridgeFrontendInput)' != '' and '@(_RunicBridgeDeclaredInputRename)' == ''"
           File="$(MSBuildProjectFullPath)" HelpLink="$(_RunicDiagnosticsHelpLinkBase)runicbridge017"
           Text="The RunicBridgeFrontendInput item is renamed to RunicApplicationFrontendInput. The old name no longer applies; rename it in $(MSBuildProjectFile) or its imports." />
    <ItemGroup>
      <RunicApplicationFrontendInput Include="$(RunicApplicationFrontendDirectory)/**/*"
          Exclude="$(RunicApplicationFrontendDirectory)/node_modules/**;$(RunicApplicationFrontendDirectory)/dist/**;$(_RunicApplicationFrontendOutputPath)**;$(RunicApplicationFrontendDirectory)/build/**;$(RunicApplicationFrontendDirectory)/bin/**;$(RunicApplicationFrontendDirectory)/obj/**;$(RunicApplicationFrontendDirectory)/.*/**" />
      <RunicApplicationFrontendInput Include="$(RunicApplicationFrontendGeneratedDirectory)/*.ts;$(MSBuildProjectFullPath)" />
      <!-- Registered on every build so IncrementalClean keeps them when the
           frontend target is skipped as up to date. -->
      <FileWrites Include="$(_RunicBridgeFrontendStamp);$(_RunicBridgeFrontendOutputsFile)" />
      <_RunicBridgeFrontendEnvironmentName Include="NODE_ENV;@(RunicApplicationFrontendBuildEnvironment)" />
      <_RunicBridgeFrontendEnvironment Include="@(_RunicBridgeFrontendEnvironmentName->Distinct())">
        <Value>$([System.Environment]::GetEnvironmentVariable('%(Identity)'))</Value>
      </_RunicBridgeFrontendEnvironment>
    </ItemGroup>
    <!-- The build state is hashed in memory; neither the values nor the
         environment are written to obj/. A stamp whose state differs from the
         one that last built dist/ (for example from another configuration)
         is stale. -->
    <PropertyGroup>
      <_RunicBridgeFrontendBuildStateText>command=$(RunicApplicationFrontendBuildCommand)|host=$(RunicApplicationHost)|@(_RunicBridgeFrontendEnvironment->'%(Identity)=%(Value)', '|')</_RunicBridgeFrontendBuildStateText>
      <_RunicBridgeFrontendBuildState>$([MSBuild]::StableStringHash($(_RunicBridgeFrontendBuildStateText)))</_RunicBridgeFrontendBuildState>
      <_RunicBridgeFrontendBuildStateText></_RunicBridgeFrontendBuildStateText>
      <_RunicBridgeFrontendBuiltState Condition="Exists('$(_RunicBridgeFrontendStateFile)')">$([System.IO.File]::ReadAllText('$(_RunicBridgeFrontendStateFile)').Trim())</_RunicBridgeFrontendBuiltState>
    </PropertyGroup>
    <Delete Files="$(_RunicBridgeFrontendStamp)"
        Condition="Exists('$(_RunicBridgeFrontendStamp)') and '$(_RunicBridgeFrontendBuiltState)' != '$(_RunicBridgeFrontendBuildState)'" />
    <!-- A deleted dist/, or a file the last build left there, rebuilds even
         though the stamp is newer than every input. So does a stamp without
         the list, as an earlier version wrote. -->
    <ReadLinesFromFile File="$(_RunicBridgeFrontendOutputsFile)" Condition="Exists('$(_RunicBridgeFrontendOutputsFile)')">
      <Output TaskParameter="Lines" ItemName="_RunicBridgeFrontendRecordedOutput" />
    </ReadLinesFromFile>
    <ItemGroup>
      <_RunicBridgeFrontendMissingOutput Include="@(_RunicBridgeFrontendRecordedOutput)"
          Condition="!Exists('%(Identity)')" />
    </ItemGroup>
    <Delete Files="$(_RunicBridgeFrontendStamp)"
        Condition="Exists('$(_RunicBridgeFrontendStamp)') and (!Exists('$(_RunicBridgeFrontendOutputsFile)') or '@(_RunicBridgeFrontendMissingOutput)' != '')" />
  </Target>

  <!-- A fresh clone or generated project has no node_modules yet, and a pull
       can change the declared packages. Install with the selected package
       manager when package.json or a lock file is newer than the install
       stamp, or when declared packages have no node_modules, so plain
       dotnet build and dotnet run work. A package.json without dependencies
       needs no node_modules. Set RunicApplicationFrontendInstallEnabled=false when a
       workspace install owns it. -->
  <Target Name="RunicViewsCollectFrontendInstallInputs" BeforeTargets="RunicViewsInstallFrontend"
          DependsOnTargets="_RunicViewsIntermediatePaths"
          Condition="'$(RunicApplicationFrontendInstallEnabled)' != 'false' and '$(RunicApplicationFrontendNodeModulesDirectory)' == '' and Exists('$(RunicApplicationFrontendDirectory)/package.json')">
    <PropertyGroup>
      <_RunicBridgeFrontendHasDependencies>false</_RunicBridgeFrontendHasDependencies>
      <_RunicBridgeFrontendHasDependencies Condition="$([System.Text.RegularExpressions.Regex]::IsMatch($([System.IO.File]::ReadAllText('$(RunicApplicationFrontendDirectory)/package.json')), '&quot;(dependencies|devDependencies|optionalDependencies)&quot;\s*:\s*\{\s*&quot;'))">true</_RunicBridgeFrontendHasDependencies>
    </PropertyGroup>
    <ItemGroup>
      <_RunicBridgeFrontendInstallInput Include="$(RunicApplicationFrontendDirectory)/package.json" />
      <_RunicBridgeFrontendInstallInput Include="$(RunicApplicationFrontendDirectory)/%(_RunicBridgeFrontendLockFile.Identity)"
          Condition="Exists('$(RunicApplicationFrontendDirectory)/%(_RunicBridgeFrontendLockFile.Identity)')" />
    </ItemGroup>
    <!-- Deleted node_modules installs again even though its inputs are older. -->
    <Delete Files="$(_RunicBridgeFrontendInstallStamp)"
            Condition="'$(_RunicBridgeFrontendHasDependencies)' == 'true' and !Exists('$(RunicApplicationFrontendDirectory)/node_modules')" />
  </Target>

  <ItemGroup>
    <_RunicBridgeFrontendLockFile Include="package-lock.json;npm-shrinkwrap.json;pnpm-lock.yaml;bun.lock;bun.lockb" />
  </ItemGroup>

  <!-- RunicApplicationFrontendNodeModulesDirectory names a node_modules that
       something else installed, such as a Nix derivation built offline from the
       lock file. The install does not run, and the frontend's node_modules
       becomes a symbolic link (a junction on Windows) to that directory. An
       earlier link is replaced; a node_modules that is not a link is
       RUNICBRIDGE021 rather than replaced. -->
  <UsingTask TaskName="RunicViewsLinkNodeModules" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Link ParameterType="System.String" Required="true" />
      <Target ParameterType="System.String" Required="true" />
      <ProjectFile ParameterType="System.String" />
      <HelpLink ParameterType="System.String" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.Diagnostics" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Runtime.InteropServices" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        // Compiled for netstandard2.0, as MSBuild on .NET Framework does: there is no symbolic link API.
        string target = Path.GetFullPath(Target).TrimEnd('/', '\\');
        string link = Path.GetFullPath(Link).TrimEnd('/', '\\');
        if (!Directory.Exists(target))
        {
          Log.LogError(null, "RUNICBRIDGE021", HelpLink, ProjectFile, 0, 0, 0, 0,
            "RunicApplicationFrontendNodeModulesDirectory is " + target + ", which is not a directory. Install the frontend dependencies there, or unset the property to install them with the frontend's package manager.");
          return false;
        }
        if (Directory.Exists(link) || File.Exists(link))
        {
          if ((File.GetAttributes(link) & FileAttributes.ReparsePoint) == 0)
          {
            Log.LogError(null, "RUNICBRIDGE021", HelpLink, ProjectFile, 0, 0, 0, 0,
              link + " exists and is not a symbolic link, so it cannot point to RunicApplicationFrontendNodeModulesDirectory (" + target + "). Remove it, or unset the property to use it.");
            return false;
          }
          // Remove the link only, never the directory it points to.
          if (Directory.Exists(link)) Directory.Delete(link, false); else File.Delete(link);
        }
        bool windows = RuntimeInformation.IsOSPlatform(OSPlatform.Windows);
        var start = new ProcessStartInfo(windows ? "cmd.exe" : "ln")
        {
          Arguments = windows ? "/c mklink /J \"" + link + "\" \"" + target + "\"" : "-s \"" + target + "\" \"" + link + "\"",
          UseShellExecute = false,
          RedirectStandardError = true,
          RedirectStandardOutput = true,
        };
        using (var process = Process.Start(start))
        {
          process.StandardOutput.ReadToEnd();
          string error = process.StandardError.ReadToEnd();
          process.WaitForExit();
          if (process.ExitCode != 0)
          {
            Log.LogError(null, "RUNICBRIDGE021", HelpLink, ProjectFile, 0, 0, 0, 0,
              "Could not link " + link + " to " + target + ": " + error.Trim());
            return false;
          }
        }
        Log.LogMessage(MessageImportance.Normal, "Linked " + link + " to " + target + ".");
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="RunicViewsLinkFrontendNodeModules" BeforeTargets="RunicViewsBuildFrontend"
          Condition="'$(RunicApplicationFrontendNodeModulesDirectory)' != '' and '$(RunicApplicationFrontendGenerationEnabled)' == 'true' and '$(_RunicBridgeSkipped)' != 'true' and '$(DesignTimeBuild)' != 'true' and '$(RunicApplicationFrontendBootstrap)' != 'true' and '$(_RunicBridgeMarkupTemporary)' != 'true' and '$(RunicApplicationFrontendBuildEnabled)' != 'false' and Exists('$(RunicApplicationFrontendDirectory)/package.json')">
    <RunicViewsLinkNodeModules Link="$(RunicApplicationFrontendDirectory)/node_modules"
                                Target="$(RunicApplicationFrontendNodeModulesDirectory)"
                                ProjectFile="$(MSBuildProjectFullPath)"
                                HelpLink="$(_RunicDiagnosticsHelpLinkBase)runicbridge021" />
  </Target>

  <Target Name="RunicViewsInstallFrontend" BeforeTargets="RunicViewsBuildFrontend" DependsOnTargets="_RunicViewsIntermediatePaths"
          Inputs="@(_RunicBridgeFrontendInstallInput)" Outputs="$(_RunicBridgeFrontendInstallStamp)"
          Condition="'$(RunicApplicationFrontendGenerationEnabled)' == 'true' and '$(_RunicBridgeSkipped)' != 'true' and '$(DesignTimeBuild)' != 'true' and '$(RunicApplicationFrontendBootstrap)' != 'true' and '$(_RunicBridgeMarkupTemporary)' != 'true' and '$(RunicApplicationFrontendBuildEnabled)' != 'false' and '$(RunicApplicationFrontendInstallEnabled)' != 'false' and '$(RunicApplicationFrontendNodeModulesDirectory)' == '' and Exists('$(RunicApplicationFrontendDirectory)/package.json')">
    <Message Importance="high"
             Text="Installing frontend dependencies in $(RunicApplicationFrontendDirectory) with $(RunicApplicationFrontendPackageManager). Set RunicApplicationFrontendInstallEnabled=false to install them yourself." />
    <Exec Command="$(RunicApplicationFrontendInstallCommand)" WorkingDirectory="$(RunicApplicationFrontendDirectory)"
          ConsoleToMSBuild="true" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" PropertyName="_RunicBridgeFrontendInstallExitCode" />
      <Output TaskParameter="ConsoleOutput" ItemName="_RunicBridgeFrontendInstallOutputLine" />
    </Exec>
    <PropertyGroup>
      <_RunicBridgeFrontendInstallDiagnostics Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(_RunicBridgeFrontendInstallOutputLine.Identity)', '$(_RunicBridgeCanonicalDiagnostic)'))">true</_RunicBridgeFrontendInstallDiagnostics>
    </PropertyGroup>
    <RunicViewsReportCommandResult Condition="'$(_RunicBridgeFrontendInstallExitCode)' != '0' or '$(_RunicBridgeFrontendInstallDiagnostics)' == 'true'"
        Lines="@(_RunicBridgeFrontendInstallOutputLine)" ExitCode="$(_RunicBridgeFrontendInstallExitCode)"
        WorkingDirectory="$(RunicApplicationFrontendDirectory)"
        FailureCode="RUNICBRIDGE016" FailureFile="$(MSBuildProjectFullPath)"
        FailureText="The frontend install '$(RunicApplicationFrontendInstallCommand)' in $([System.IO.Path]::GetFullPath('$(RunicApplicationFrontendDirectory)')) exited with code $(_RunicBridgeFrontendInstallExitCode). Its output is above. Run 'dotnet runic doctor' to check the package manager and lock file." />
    <Error Code="RUNICBRIDGE016" File="$(MSBuildProjectFullPath)" HelpLink="$(_RunicDiagnosticsHelpLinkBase)runicbridge016"
           Condition="'$(_RunicBridgeFrontendInstallExitCode)' == '0' and '$(_RunicBridgeFrontendHasDependencies)' == 'true' and !Exists('$(RunicApplicationFrontendDirectory)/node_modules')"
           Text="'$(RunicApplicationFrontendInstallCommand)' did not create $(RunicApplicationFrontendDirectory)/node_modules. Install the frontend dependencies with $(RunicApplicationFrontendPackageManager), or run 'dotnet runic doctor' to check the package manager and lock file." />
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(_RunicBridgeFrontendInstallStamp)'))" />
    <Touch Files="$(_RunicBridgeFrontendInstallStamp)" AlwaysCreate="true" />
  </Target>

  <Target Name="RunicViewsBuildFrontend" AfterTargets="RunicViewsCollectFrontendInputs" DependsOnTargets="_RunicViewsIntermediatePaths"
          Inputs="@(RunicApplicationFrontendInput)" Outputs="$(_RunicBridgeFrontendStamp)"
          Condition="'$(RunicApplicationFrontendGenerationEnabled)' == 'true' and '$(_RunicBridgeSkipped)' != 'true' and '$(DesignTimeBuild)' != 'true' and '$(RunicApplicationFrontendBootstrap)' != 'true' and '$(_RunicBridgeMarkupTemporary)' != 'true' and '$(RunicApplicationFrontendBuildEnabled)' != 'false'">
    <!-- Compiler errors in canonical form (tsc, vue-tsc) are logged with
         their codes and locations, and svelte-check errors with their
         locations; any other failure, such as a Vite error,
         gets one RUNICBRIDGE016 instead of MSB3073. -->
    <Exec Command="$(RunicApplicationFrontendBuildCommand)" WorkingDirectory="$(RunicApplicationFrontendDirectory)"
          EnvironmentVariables="RUNIC_APPLICATION_HOST=$(RunicApplicationHost)"
          ConsoleToMSBuild="true" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" PropertyName="_RunicBridgeFrontendBuildExitCode" />
      <Output TaskParameter="ConsoleOutput" ItemName="_RunicBridgeFrontendBuildOutputLine" />
    </Exec>
    <PropertyGroup>
      <_RunicBridgeFrontendBuildDiagnostics Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(_RunicBridgeFrontendBuildOutputLine.Identity)', '$(_RunicBridgeCanonicalDiagnostic)'))">true</_RunicBridgeFrontendBuildDiagnostics>
    </PropertyGroup>
    <RunicViewsReportCommandResult Condition="'$(_RunicBridgeFrontendBuildExitCode)' != '0' or '$(_RunicBridgeFrontendBuildDiagnostics)' == 'true'"
        Lines="@(_RunicBridgeFrontendBuildOutputLine)" ExitCode="$(_RunicBridgeFrontendBuildExitCode)"
        WorkingDirectory="$(RunicApplicationFrontendDirectory)"
        FailureCode="RUNICBRIDGE016" FailureFile="$(MSBuildProjectFullPath)"
        FailureText="The frontend build '$(RunicApplicationFrontendBuildCommand)' in $([System.IO.Path]::GetFullPath('$(RunicApplicationFrontendDirectory)')) exited with code $(_RunicBridgeFrontendBuildExitCode). Its output is above." />
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(_RunicBridgeFrontendStamp)'))"
             Condition="'$(_RunicBridgeFrontendBuildExitCode)' == '0'" />
    <ItemGroup Condition="'$(_RunicBridgeFrontendBuildExitCode)' == '0'">
      <_RunicBridgeFrontendBuiltFile Include="$(_RunicApplicationFrontendOutputPath)**/*" />
    </ItemGroup>
    <!-- An empty list still marks the stamp as current; a build that writes
         nothing to the output directory checks no files. -->
    <WriteLinesToFile File="$(_RunicBridgeFrontendOutputsFile)" Overwrite="true"
        Lines="@(_RunicBridgeFrontendBuiltFile->'%(FullPath)')"
        Condition="'$(_RunicBridgeFrontendBuildExitCode)' == '0'" />
    <WriteLinesToFile File="$(_RunicBridgeFrontendStateFile)" Lines="$(_RunicBridgeFrontendBuildState)" Overwrite="true"
        Condition="'$(_RunicBridgeFrontendBuildExitCode)' == '0'" />
    <Touch Files="$(_RunicBridgeFrontendOutputsFile);$(_RunicBridgeFrontendStamp)" AlwaysCreate="true"
           Condition="'$(_RunicBridgeFrontendBuildExitCode)' == '0'" />
  </Target>

  <!-- Views can live in a referenced model project, for example beside a WPF
       application. The model project builds its frontend, and an application
       that references it, directly or through other projects, copies that
       frontend to its own www/ too. The application's own frontend, if any,
       is copied afterwards and wins. -->
  <Target Name="RunicViewsCollectReferencedFrontends"
          DependsOnTargets="AssignProjectConfiguration;_SplitProjectReferencesByFileExistence;_GetProjectReferenceTargetFrameworkProperties"
          Condition="'$(RunicApplicationFrontendBootstrap)' != 'true' and '$(_RunicBridgeMarkupTemporary)' != 'true'">
    <MSBuild Projects="@(_MSBuildProjectReferenceExistent)" Targets="RunicViewsGetFrontendFiles"
             BuildInParallel="$(BuildInParallel)" SkipNonexistentTargets="true"
             Properties="%(_MSBuildProjectReferenceExistent.SetConfiguration); %(_MSBuildProjectReferenceExistent.SetPlatform); %(_MSBuildProjectReferenceExistent.SetTargetFramework)"
             RemoveProperties="%(_MSBuildProjectReferenceExistent.GlobalPropertiesToRemove)"
             Condition="'@(_MSBuildProjectReferenceExistent)' != ''">
      <Output TaskParameter="TargetOutputs" ItemName="_RunicBridgeReferencedFrontendFile" />
    </MSBuild>
  </Target>

  <!-- Returns this project's built frontend after those of its references. -->
  <Target Name="RunicViewsGetFrontendFiles" DependsOnTargets="RunicViewsDetectBridgeUse;RunicViewsCollectReferencedFrontends"
          Returns="@(_RunicBridgeReferencedFrontendFile);@(_RunicBridgeOwnFrontendFile)">
    <ItemGroup Condition="'$(RunicApplicationFrontendGenerationEnabled)' == 'true' and '$(_RunicBridgeSkipped)' != 'true' and '$(RunicApplicationFrontendBootstrap)' != 'true'">
      <_RunicBridgeFrontendDistFile Include="$(_RunicApplicationFrontendOutputPath)**/*" />
      <_RunicBridgeOwnFrontendFile Include="@(_RunicBridgeFrontendDistFile->'%(FullPath)')"
        RunicFrontendPath="%(_RunicBridgeFrontendDistFile.RecursiveDir)%(_RunicBridgeFrontendDistFile.Filename)%(_RunicBridgeFrontendDistFile.Extension)" />
    </ItemGroup>
  </Target>

  <Target Name="RunicViewsCopyReferencedFrontends" AfterTargets="Build"
          DependsOnTargets="RunicViewsCollectReferencedFrontends"
          Condition="'$(OutputType)' != 'Library' and '$(RunicApplicationFrontendBootstrap)' != 'true' and '$(RunicApplicationFrontendCopyEnabled)' != 'false'">
    <ItemGroup>
      <_RunicBridgeWwwFile Include="@(_RunicBridgeReferencedFrontendFile->'$(TargetDir)$(_RunicApplicationFrontendWebRoot)/%(RunicFrontendPath)')" />
    </ItemGroup>
    <Copy SourceFiles="@(_RunicBridgeReferencedFrontendFile)"
          DestinationFiles="@(_RunicBridgeReferencedFrontendFile->'$(TargetDir)$(_RunicApplicationFrontendWebRoot)/%(RunicFrontendPath)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="RunicViewsCopyReferencedFrontendsForPublish" AfterTargets="Publish"
          DependsOnTargets="RunicViewsCollectReferencedFrontends"
          Condition="'$(OutputType)' != 'Library' and '$(RunicApplicationFrontendBootstrap)' != 'true'">
    <ItemGroup>
      <_RunicBridgePublishedWwwFile Include="@(_RunicBridgeReferencedFrontendFile->'$(PublishDir)$(_RunicApplicationFrontendWebRoot)/%(RunicFrontendPath)')" />
    </ItemGroup>
    <Copy SourceFiles="@(_RunicBridgeReferencedFrontendFile)"
          DestinationFiles="@(_RunicBridgeReferencedFrontendFile->'$(PublishDir)$(_RunicApplicationFrontendWebRoot)/%(RunicFrontendPath)')"
          SkipUnchangedFiles="true" />
  </Target>

  <!-- RunicApplicationFrontendCopyEnabled=false keeps a development document that
       dotnet runic dev wrote into www/ from being replaced by dist/. -->
  <Target Name="RunicViewsCopyFrontend" AfterTargets="Build"
          DependsOnTargets="RunicViewsDetectBridgeUse"
          Condition="'$(RunicApplicationFrontendGenerationEnabled)' == 'true' and '$(_RunicBridgeSkipped)' != 'true' and '$(RunicApplicationFrontendBootstrap)' != 'true' and '$(RunicApplicationFrontendCopyEnabled)' != 'false'">
    <ItemGroup>
      <_RunicBridgeFrontendFile Include="$(_RunicApplicationFrontendOutputPath)**/*" />
      <_RunicBridgeWwwFile Include="@(_RunicBridgeFrontendFile->'$(TargetDir)$(_RunicApplicationFrontendWebRoot)/%(RecursiveDir)%(Filename)%(Extension)')" />
    </ItemGroup>
    <Copy SourceFiles="@(_RunicBridgeFrontendFile)"
          DestinationFiles="@(_RunicBridgeFrontendFile->'$(TargetDir)$(_RunicApplicationFrontendWebRoot)/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="RunicViewsCopyFrontendForPublish" AfterTargets="Publish"
          DependsOnTargets="RunicViewsDetectBridgeUse"
          Condition="'$(RunicApplicationFrontendGenerationEnabled)' == 'true' and '$(_RunicBridgeSkipped)' != 'true' and '$(RunicApplicationFrontendBootstrap)' != 'true'">
    <ItemGroup>
      <_RunicBridgePublishedFrontendFile Include="$(_RunicApplicationFrontendOutputPath)**/*" />
      <_RunicBridgePublishedWwwFile Include="@(_RunicBridgePublishedFrontendFile->'$(PublishDir)$(_RunicApplicationFrontendWebRoot)/%(RecursiveDir)%(Filename)%(Extension)')" />
    </ItemGroup>
    <Copy SourceFiles="@(_RunicBridgePublishedFrontendFile)"
          DestinationFiles="@(_RunicBridgePublishedFrontendFile->'$(PublishDir)$(_RunicApplicationFrontendWebRoot)/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <!-- www/ mirrors the copied frontends: a file that an earlier copy wrote
       and that no frontend has any more, such as an asset with an old hash,
       is deleted. Each copy records the files it wrote in obj/; nothing else
       in www/ is touched, so the host client scripts, a dev document and
       files the application adds itself stay. These run after the copies
       above, which are declared first. The records live in the intermediate
       directory of the output they describe, so a build for another runtime
       identifier keeps its own, and only files below the current www/ are
       deleted. -->
  <Target Name="RunicViewsWwwManifestDirectory" DependsOnTargets="_RunicViewsIntermediatePaths">
    <PropertyGroup>
      <_RunicBridgeWwwManifestDirectory>$(_RunicBridgeIntermediateDirectory)</_RunicBridgeWwwManifestDirectory>
    </PropertyGroup>
  </Target>

  <Target Name="RunicViewsMirrorFrontend" AfterTargets="Build" DependsOnTargets="RunicViewsWwwManifestDirectory;$(_RunicApplicationHostCopyTargets)"
          Condition="'$(RunicApplicationFrontendBootstrap)' != 'true' and '$(_RunicBridgeMarkupTemporary)' != 'true' and '$(RunicApplicationFrontendCopyEnabled)' != 'false' and '$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_RunicBridgeWwwRoot>$([MSBuild]::EnsureTrailingSlash('$([System.IO.Path]::GetFullPath('$(TargetDir)$(_RunicApplicationFrontendWebRoot)'))'))</_RunicBridgeWwwRoot>
      <_RunicBridgeWwwManifest>$(_RunicBridgeWwwManifestDirectory)runic-frontend-www.files</_RunicBridgeWwwManifest>
    </PropertyGroup>
    <!-- A page that loads runic-views.js needs a chosen host (RUNICBRIDGE019). -->
    <ItemGroup Condition="'$(_RunicApplicationHostAmbiguous)' == 'true'">
      <_RunicBridgeHostNeutralPage Include="@(_RunicBridgeWwwFile->'%(FullPath)')"
          Condition="'%(Extension)' == '.html' and Exists('%(FullPath)') and $([System.Text.RegularExpressions.Regex]::IsMatch($([System.IO.File]::ReadAllText('%(FullPath)')), '(^|[^\w.-])runic-views\.js'))" />
    </ItemGroup>
    <Warning Code="RUNICBRIDGE019" File="$(MSBuildProjectFullPath)" HelpLink="$(_RunicDiagnosticsHelpLinkBase)runicbridge019"
             Condition="'@(_RunicBridgeHostNeutralPage)' != ''"
             Text="$(AssemblyName) references more than one Runic host ($(_RunicApplicationHostNamesText)), and its page @(_RunicBridgeHostNeutralPage->'%(Filename)%(Extension)', ', ') loads runic-views.js, but the build copies no www/runic-views.js, so the page gets no Bridge. Set RunicApplicationHost in $(MSBuildProjectFile) or on the command line (-p:RunicApplicationHost=...) to the host the application runs on." />
    <!-- Each record line is "<last write time>|<path>". A recorded file is
         deleted only when its time is unchanged, so a file that someone else
         wrote there since (an operator's config.json, for example) stays. -->
    <ReadLinesFromFile File="$(_RunicBridgeWwwManifest)" Condition="Exists('$(_RunicBridgeWwwManifest)')">
      <Output TaskParameter="Lines" ItemName="_RunicBridgePreviousWwwLine" />
    </ReadLinesFromFile>
    <ItemGroup>
      <_RunicBridgePreviousWwwRecord Include="@(_RunicBridgePreviousWwwLine)" Condition="$([System.String]::Copy('%(Identity)').Contains('|'))">
        <RecordedPath>$([System.String]::Copy('%(Identity)').Substring($([MSBuild]::Add($([System.String]::Copy('%(Identity)').IndexOf('|')), 1))))</RecordedPath>
        <RecordedTime>$([System.String]::Copy('%(Identity)').Substring(0, $([System.String]::Copy('%(Identity)').IndexOf('|'))))</RecordedTime>
      </_RunicBridgePreviousWwwRecord>
      <_RunicBridgePreviousWwwFile Include="@(_RunicBridgePreviousWwwRecord->'%(RecordedPath)')" />
      <_RunicBridgeCurrentWwwFile Include="@(_RunicBridgeWwwFile->'%(FullPath)')" />
      <_RunicBridgeOwnedWwwFile Include="@(_RunicBridgePreviousWwwFile->'%(FullPath)')"
          Condition="$([System.String]::Copy('%(FullPath)').StartsWith('$(_RunicBridgeWwwRoot)'))" />
      <_RunicBridgeStaleWwwCandidate Include="@(_RunicBridgeOwnedWwwFile)" Exclude="@(_RunicBridgeCurrentWwwFile)" />
      <_RunicBridgeStaleWwwFile Include="@(_RunicBridgeStaleWwwCandidate)"
          Condition="'%(ModifiedTime)' == '%(RecordedTime)'" />
    </ItemGroup>
    <Delete Files="@(_RunicBridgeStaleWwwFile)" />
    <MakeDir Directories="$(_RunicBridgeWwwManifestDirectory)" />
    <WriteLinesToFile File="$(_RunicBridgeWwwManifest)" Lines="@(_RunicBridgeCurrentWwwFile->'%(ModifiedTime)|%(FullPath)')"
        Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>

  <Target Name="RunicViewsMirrorFrontendForPublish" AfterTargets="Publish" DependsOnTargets="RunicViewsWwwManifestDirectory;$(_RunicApplicationHostPublishCopyTargets)"
          Condition="'$(RunicApplicationFrontendBootstrap)' != 'true' and '$(_RunicBridgeMarkupTemporary)' != 'true'">
    <PropertyGroup>
      <_RunicBridgePublishedWwwRoot>$([MSBuild]::EnsureTrailingSlash('$([System.IO.Path]::GetFullPath('$(PublishDir)$(_RunicApplicationFrontendWebRoot)'))'))</_RunicBridgePublishedWwwRoot>
      <_RunicBridgePublishedWwwManifest>$(_RunicBridgeWwwManifestDirectory)runic-frontend-publish.files</_RunicBridgePublishedWwwManifest>
    </PropertyGroup>
    <!-- Each record line is "<last write time>|<path>". A recorded file is
         deleted only when its time is unchanged, so a file that someone else
         wrote there since (an operator's config.json, for example) stays. -->
    <ReadLinesFromFile File="$(_RunicBridgePublishedWwwManifest)" Condition="Exists('$(_RunicBridgePublishedWwwManifest)')">
      <Output TaskParameter="Lines" ItemName="_RunicBridgePreviousPublishedWwwLine" />
    </ReadLinesFromFile>
    <ItemGroup>
      <_RunicBridgePreviousPublishedWwwRecord Include="@(_RunicBridgePreviousPublishedWwwLine)" Condition="$([System.String]::Copy('%(Identity)').Contains('|'))">
        <RecordedPath>$([System.String]::Copy('%(Identity)').Substring($([MSBuild]::Add($([System.String]::Copy('%(Identity)').IndexOf('|')), 1))))</RecordedPath>
        <RecordedTime>$([System.String]::Copy('%(Identity)').Substring(0, $([System.String]::Copy('%(Identity)').IndexOf('|'))))</RecordedTime>
      </_RunicBridgePreviousPublishedWwwRecord>
      <_RunicBridgePreviousPublishedWwwFile Include="@(_RunicBridgePreviousPublishedWwwRecord->'%(RecordedPath)')" />
      <_RunicBridgeCurrentPublishedWwwFile Include="@(_RunicBridgePublishedWwwFile->'%(FullPath)')" />
      <_RunicBridgeOwnedPublishedWwwFile Include="@(_RunicBridgePreviousPublishedWwwFile->'%(FullPath)')"
          Condition="$([System.String]::Copy('%(FullPath)').StartsWith('$(_RunicBridgePublishedWwwRoot)'))" />
      <_RunicBridgeStalePublishedWwwCandidate Include="@(_RunicBridgeOwnedPublishedWwwFile)" Exclude="@(_RunicBridgeCurrentPublishedWwwFile)" />
      <_RunicBridgeStalePublishedWwwFile Include="@(_RunicBridgeStalePublishedWwwCandidate)"
          Condition="'%(ModifiedTime)' == '%(RecordedTime)'" />
    </ItemGroup>
    <Delete Files="@(_RunicBridgeStalePublishedWwwFile)" />
    <MakeDir Directories="$(_RunicBridgeWwwManifestDirectory)" />
    <WriteLinesToFile File="$(_RunicBridgePublishedWwwManifest)" Lines="@(_RunicBridgeCurrentPublishedWwwFile->'%(ModifiedTime)|%(FullPath)')"
        Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>
</Project>
