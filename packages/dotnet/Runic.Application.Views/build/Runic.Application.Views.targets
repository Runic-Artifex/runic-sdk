<Project>
  <!-- This file is imported from source during development and from
       buildTransitive when consumed as a package. -->

  <!-- D070, SDK-1: every project of a Runic application (the window project, which references a Views host, and the
       libraries and tests that reference Runic Views) declares the RunicApplication project capability. Visual Studio
       reads it as SolutionHasProjectCapability:RunicApplication to load Runic DevKit only in solutions with one. -->
  <ItemGroup>
    <ProjectCapability Include="RunicApplication" />
  </ItemGroup>

  <!-- D066.35: the RUNICBRIDGE warnings fail a build that treats warnings as errors, as the compiler's do. The
       analyzer's warnings are compiler warnings; the generator's own (logged by RunicViewsReportCommandResult) and
       these targets' are MSBuild warnings, which TreatWarningsAsErrors does not reach. With it, MSBuild turns them into
       errors (MSBuildWarningsAsErrors), except those named in WarningsNotAsErrors or NoWarn (NoWarn already makes them
       messages). WarningsAsErrors is included, as Microsoft.Common.CurrentVersion.targets includes it only when
       MSBuildWarningsAsErrors is empty. The list is every RUNICBRIDGE warning of docs/runicbridge-diagnostics.json
       (eng/diagnostics.test.mjs checks it). -->
  <PropertyGroup Condition="'$(TreatWarningsAsErrors)' == 'true'">
    <_RunicBridgeWarningsKept>;$([System.Text.RegularExpressions.Regex]::Replace('$(WarningsNotAsErrors);$(NoWarn)', '[\s,;]+', ';').ToUpperInvariant());</_RunicBridgeWarningsKept>
    <_RunicBridgeWarningsAsErrors></_RunicBridgeWarningsAsErrors>
    <_RunicBridgeWarningsAsErrors Condition="!$(_RunicBridgeWarningsKept.Contains(';RUNICBRIDGE013;'))">$(_RunicBridgeWarningsAsErrors);RUNICBRIDGE013</_RunicBridgeWarningsAsErrors>
    <_RunicBridgeWarningsAsErrors Condition="!$(_RunicBridgeWarningsKept.Contains(';RUNICBRIDGE015;'))">$(_RunicBridgeWarningsAsErrors);RUNICBRIDGE015</_RunicBridgeWarningsAsErrors>
    <_RunicBridgeWarningsAsErrors Condition="!$(_RunicBridgeWarningsKept.Contains(';RUNICBRIDGE019;'))">$(_RunicBridgeWarningsAsErrors);RUNICBRIDGE019</_RunicBridgeWarningsAsErrors>
    <_RunicBridgeWarningsAsErrors Condition="!$(_RunicBridgeWarningsKept.Contains(';RUNICBRIDGE020;'))">$(_RunicBridgeWarningsAsErrors);RUNICBRIDGE020</_RunicBridgeWarningsAsErrors>
    <_RunicBridgeWarningsAsErrors Condition="!$(_RunicBridgeWarningsKept.Contains(';RUNICBRIDGE028;'))">$(_RunicBridgeWarningsAsErrors);RUNICBRIDGE028</_RunicBridgeWarningsAsErrors>
    <_RunicBridgeWarningsAsErrors Condition="!$(_RunicBridgeWarningsKept.Contains(';RUNICBRIDGE029;'))">$(_RunicBridgeWarningsAsErrors);RUNICBRIDGE029</_RunicBridgeWarningsAsErrors>
    <_RunicBridgeWarningsAsErrors Condition="!$(_RunicBridgeWarningsKept.Contains(';RUNICBRIDGE030;'))">$(_RunicBridgeWarningsAsErrors);RUNICBRIDGE030</_RunicBridgeWarningsAsErrors>
    <_RunicBridgeWarningsAsErrors Condition="!$(_RunicBridgeWarningsKept.Contains(';RUNICBRIDGE031;'))">$(_RunicBridgeWarningsAsErrors);RUNICBRIDGE031</_RunicBridgeWarningsAsErrors>
    <_RunicBridgeWarningsAsErrors Condition="!$(_RunicBridgeWarningsKept.Contains(';RUNICBRIDGE032;'))">$(_RunicBridgeWarningsAsErrors);RUNICBRIDGE032</_RunicBridgeWarningsAsErrors>
    <_RunicBridgeWarningsAsErrors Condition="!$(_RunicBridgeWarningsKept.Contains(';RUNICBRIDGE033;'))">$(_RunicBridgeWarningsAsErrors);RUNICBRIDGE033</_RunicBridgeWarningsAsErrors>
    <_RunicBridgeWarningsAsErrors Condition="!$(_RunicBridgeWarningsKept.Contains(';RUNICBRIDGE034;'))">$(_RunicBridgeWarningsAsErrors);RUNICBRIDGE034</_RunicBridgeWarningsAsErrors>
    <_RunicBridgeWarningsAsErrors Condition="!$(_RunicBridgeWarningsKept.Contains(';RUNICBRIDGE039;'))">$(_RunicBridgeWarningsAsErrors);RUNICBRIDGE039</_RunicBridgeWarningsAsErrors>
    <_RunicBridgeWarningsAsErrors Condition="!$(_RunicBridgeWarningsKept.Contains(';RUNICBRIDGE053;'))">$(_RunicBridgeWarningsAsErrors);RUNICBRIDGE053</_RunicBridgeWarningsAsErrors>
    <_RunicBridgeWarningsAsErrors Condition="!$(_RunicBridgeWarningsKept.Contains(';RUNICBRIDGE072;'))">$(_RunicBridgeWarningsAsErrors);RUNICBRIDGE072</_RunicBridgeWarningsAsErrors>
    <_RunicBridgeWarningsAsErrors Condition="!$(_RunicBridgeWarningsKept.Contains(';RUNICBRIDGE075;'))">$(_RunicBridgeWarningsAsErrors);RUNICBRIDGE075</_RunicBridgeWarningsAsErrors>
    <_RunicBridgeWarningsAsErrors Condition="!$(_RunicBridgeWarningsKept.Contains(';RUNICBRIDGE076;'))">$(_RunicBridgeWarningsAsErrors);RUNICBRIDGE076</_RunicBridgeWarningsAsErrors>
    <_RunicBridgeWarningsAsErrors Condition="!$(_RunicBridgeWarningsKept.Contains(';RUNICBRIDGE078;'))">$(_RunicBridgeWarningsAsErrors);RUNICBRIDGE078</_RunicBridgeWarningsAsErrors>
    <_RunicBridgeWarningsAsErrors Condition="!$(_RunicBridgeWarningsKept.Contains(';RUNICBRIDGE083;'))">$(_RunicBridgeWarningsAsErrors);RUNICBRIDGE083</_RunicBridgeWarningsAsErrors>
    <_RunicBridgeWarningsAsErrors Condition="!$(_RunicBridgeWarningsKept.Contains(';RUNICBRIDGE089;'))">$(_RunicBridgeWarningsAsErrors);RUNICBRIDGE089</_RunicBridgeWarningsAsErrors>
    <_RunicBridgeWarningsAsErrors Condition="!$(_RunicBridgeWarningsKept.Contains(';RUNICBRIDGE091;'))">$(_RunicBridgeWarningsAsErrors);RUNICBRIDGE091</_RunicBridgeWarningsAsErrors>
    <MSBuildWarningsAsErrors Condition="'$(_RunicBridgeWarningsAsErrors)' != ''">$(MSBuildWarningsAsErrors);$(WarningsAsErrors)$(_RunicBridgeWarningsAsErrors)</MSBuildWarningsAsErrors>
  </PropertyGroup>

  <!-- Every build property of these targets starts with RunicApplicationFrontend.
       The RunicBridge* and RunicViewsWindowProject names of 0.7.0-preview.6 and
       earlier, and the runic-app template's RunicApplicationId and
       RunicApplicationName of 0.8, are no longer applied: a project that still
       sets one fails with RUNICBRIDGE017, which names the new property. The
       old-name guards (D079.11) list them in Runic.Sdk.RenamedNames.targets,
       generated from rename/old-names.json, which Runic.Desktop ships too. -->
  <Import Project="$(MSBuildThisFileDirectory)Runic.Sdk.RenamedNames.targets" Condition="'$(_RunicSdkRenamedNamesImported)' != 'true'" />
  <ItemGroup>
    <!-- Removed properties whose value the build now infers. The ReactiveUI flavor of the generated code is the
         flavor of the Runic ReactiveUI adapter the project references (see _RunicViewsReactiveUiFlavor). -->
    <_RunicApplicationFrontendRemovedName Include="RunicApplicationFrontendReactiveUiFlavor" Reason="The ReactiveUI flavor is now inferred from the referenced Runic ReactiveUI adapter" Condition="'$(RunicApplicationFrontendReactiveUiFlavor)' != ''" />
    <_RunicApplicationFrontendRemovedName Include="RunicBridgeReactiveUiFlavor" Reason="The ReactiveUI flavor is now inferred from the referenced Runic ReactiveUI adapter" Condition="'$(RunicBridgeReactiveUiFlavor)' != ''" />
  </ItemGroup>
  <PropertyGroup>
    <_RunicBridgeNoViewsMarker>RunicBridge.NoViews.marker</_RunicBridgeNoViewsMarker>
    <RunicApplicationFrontendDirectory Condition="'$(RunicApplicationFrontendDirectory)' == ''">$(MSBuildProjectDirectory)/Frontend</RunicApplicationFrontendDirectory>
    <RunicApplicationFrontendGeneratedDirectory Condition="'$(RunicApplicationFrontendGeneratedDirectory)' == ''">$(RunicApplicationFrontendDirectory)/src/generated</RunicApplicationFrontendGeneratedDirectory>
    <!-- #1318: a client library (RunicApplicationFrontendClientLibrary=true) generates its Views' TypeScript as a module
         that other applications' frontends import (runic-clients.ts and runic-mocks.ts in the generated directory,
         normally a frontend package's folder). It requires its Views, and it neither builds nor copies a frontend
         unless the project sets these properties itself; RunicViewsGetFrontendFiles never returns its own output, so
         an application that references it does not copy the package to its www/. -->
    <RunicApplicationFrontendBuildEnabled Condition="'$(RunicApplicationFrontendClientLibrary)' == 'true' and '$(RunicApplicationFrontendBuildEnabled)' == ''">false</RunicApplicationFrontendBuildEnabled>
    <RunicApplicationFrontendCopyEnabled Condition="'$(RunicApplicationFrontendClientLibrary)' == 'true' and '$(RunicApplicationFrontendCopyEnabled)' == ''">false</RunicApplicationFrontendCopyEnabled>
    <!-- The frontend build's output, which build and publish copy, and dotnet runic dev serves from too. A relative
         path is relative to the frontend directory. -->
    <RunicApplicationFrontendOutputDirectory Condition="'$(RunicApplicationFrontendOutputDirectory)' == ''">dist</RunicApplicationFrontendOutputDirectory>
    <_RunicApplicationFrontendOutputPath>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(RunicApplicationFrontendDirectory)', '$(RunicApplicationFrontendOutputDirectory)'))</_RunicApplicationFrontendOutputPath>
    <!-- The directory below the build and publish output that the application serves. The hosts find it through the
         Runic.Application.FrontendWebRoot runtime option when it is not www. -->
    <RunicApplicationFrontendWebRoot Condition="'$(RunicApplicationFrontendWebRoot)' == ''">www</RunicApplicationFrontendWebRoot>
    <_RunicApplicationFrontendWebRoot>$(RunicApplicationFrontendWebRoot.Replace('\', '/').Trim('/'))</_RunicApplicationFrontendWebRoot>
    <!-- Files copies the frontend to the web root (www/); Embedded packs it into the assembly with Runic.Assets
         (RunicViewsResolveFrontendDelivery). Closed: Files or Embedded, compared without case; another value is
         RUNICBRIDGE030 and builds as Files. -->
    <RunicApplicationFrontendDelivery Condition="'$(RunicApplicationFrontendDelivery)' == ''">Files</RunicApplicationFrontendDelivery>
    <!-- Runic.Assets packs the staged web root just before CoreCompile, after RunicViewsStageEmbeddedFrontend. -->
    <_RunicAssetsStageDistTargets>$(_RunicAssetsStageDistTargets);RunicViewsStageEmbeddedFrontend</_RunicAssetsStageDistTargets>
    <!-- The targets that write and collect the frontend output before it is staged. -->
    <_RunicViewsEmbeddedFrontendBuildTargets Condition="'$(_RunicViewsEmbeddedFrontendBuildTargets)' == ''">RunicViewsGenerateBridge;RunicViewsCollectFrontendInputs;RunicViewsBuildFrontend;RunicViewsCollectReferencedFrontends</_RunicViewsEmbeddedFrontendBuildTargets>
    <!-- A frontend inside the project folder would otherwise add its installed
         packages and build output to the default None, Content and Page items,
         which IDEs list and evaluation walks. Items are evaluated after all
         properties, so the SDK's default globs see this exclude. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);$(RunicApplicationFrontendDirectory)/node_modules/**;$(RunicApplicationFrontendDirectory)/dist/**;$(_RunicApplicationFrontendOutputPath)**</DefaultItemExcludes>
    <!-- WPF compiles a temporary copy of the project (<name>_<random>_wpftmp)
         to resolve local types in XAML. The copy imports these targets too,
         but must not generate or bootstrap again: it compiles the code that
         the real project generated before the copy was created. -->
    <_RunicBridgeMarkupTemporary Condition="'$(_TargetAssemblyProjectName)' != '' or $(MSBuildProjectName.EndsWith('_wpftmp'))">true</_RunicBridgeMarkupTemporary>
    <!-- Output lines that report an error or warning in the canonical
         "origin: error CODE: text" form, as the generator, tsc and vue-tsc do. -->
    <_RunicBridgeCanonicalDiagnostic>(^|:)\s*(error|warning)\s+[A-Za-z]+\d+\s*:</_RunicBridgeCanonicalDiagnostic>
  </PropertyGroup>

  <!-- WIN-01: Visual Studio's fast up-to-date check skips MSBuild when no item it knows changed, so without these items
       F5 after a frontend-only edit, or after dotnet runic dev left its development pages in www/, ran the old page.
       Each Set is compared on its own (a frontend edit does not rewrite the assembly):
       - RunicFrontend: the frontend directory's files (package.json and the lock file among them) without its installed
         packages, build output and generated client, and RunicApplicationFrontendInput, against runic-frontend-current.stamp,
         which RunicViewsFrontendCurrent writes after a build that left the frontend current: one that built it or found
         it up to date, or one that skipped it because a dev session serves it. RunicViewsBuildFrontend's own stamp is not
         an output here: dev's builds invalidate it, so it is missing for as long as dev runs (#1121).
       - RunicDevSession: obj/runic/dev-stopped, which dev touches when it stops, against the stamp that
         RunicViewsWwwRestored writes once a build has copied the frontend to www/ again.
       - RunicWebRoot: www/index.html alone, so that a deleted page builds again. It has no inputs, because the copy keeps
         dist/'s file times.
       Visual Studio evaluates these items when it loads the project, not when dev starts or stops, so they must not
       depend on whether dev runs; dev's marker (obj/runic/dev-frontend), which dev renews every 5 seconds, is no input.
       The check needs every input to exist, so the build creates dev-stopped, with an old time, when it is missing.
       Only Visual Studio reads these items, so another build does not walk the frontend directory to evaluate them;
       the glob's excludes keep evaluation out of node_modules. -->
  <!-- ItemGroup conditions, unlike properties here, see the properties that the SDK sets after this import (OutputType). -->
  <ItemGroup Condition="'$(BuildingInsideVisualStudio)' == 'true' and '$(RunicApplicationFrontendBootstrap)' != 'true' and '$(_RunicBridgeMarkupTemporary)' != 'true' and '$(RunicApplicationFrontendGenerationEnabled)' != 'false' and '$(RunicApplicationFrontendBuildEnabled)' != 'false' and Exists('$(RunicApplicationFrontendDirectory)/package.json')">
    <UpToDateCheckInput Include="$(RunicApplicationFrontendDirectory)/**/*" Set="RunicFrontend"
        Exclude="$(RunicApplicationFrontendDirectory)/node_modules/**;$(RunicApplicationFrontendDirectory)/dist/**;$(_RunicApplicationFrontendOutputPath)**;$(RunicApplicationFrontendDirectory)/build/**;$(RunicApplicationFrontendDirectory)/bin/**;$(RunicApplicationFrontendDirectory)/obj/**;$(RunicApplicationFrontendDirectory)/.*/**;$(RunicApplicationFrontendGeneratedDirectory)/**" />
    <UpToDateCheckInput Include="@(RunicApplicationFrontendInput->Exists())" Set="RunicFrontend" />
    <!-- Item values see every property; the intermediate paths are those of _RunicViewsIntermediatePaths. -->
    <UpToDateCheckBuilt Include="$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$([MSBuild]::ValueOrDefault('$(BaseIntermediateOutputPath)', 'obj'))', '$(Configuration)', '$(TargetFramework)', 'runic-frontend-current.stamp'))" Set="RunicFrontend" />
    <UpToDateCheckBuilt Include="$(TargetDir)$(_RunicApplicationFrontendWebRoot)/index.html" Set="RunicWebRoot"
        Condition="'$(OutputType)' != 'Library' and '$(IsTestProject)' != 'true' and '$(RunicApplicationFrontendDevSessionEnabled)' != 'false' and '$(RunicApplicationFrontendCopyEnabled)' != 'false' and '$(RunicApplicationFrontendDelivery.Trim())' != 'Embedded' and Exists('$(TargetDir)$(_RunicApplicationFrontendWebRoot)/index.html')" />
  </ItemGroup>
  <ItemGroup Condition="'$(BuildingInsideVisualStudio)' == 'true' and '$(RunicApplicationFrontendBootstrap)' != 'true' and '$(_RunicBridgeMarkupTemporary)' != 'true' and '$(OutputType)' != 'Library' and '$(IsTestProject)' != 'true' and '$(RunicApplicationFrontendDevSessionEnabled)' != 'false' and '$(RunicApplicationFrontendCopyEnabled)' != 'false' and '$(RunicApplicationFrontendDelivery.Trim())' != 'Embedded'">
    <UpToDateCheckInput Include="$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$([MSBuild]::ValueOrDefault('$(BaseIntermediateOutputPath)', 'obj'))', 'runic', 'dev-stopped'))" Set="RunicDevSession" />
    <UpToDateCheckBuilt Include="$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$([MSBuild]::ValueOrDefault('$(IntermediateOutputPath)', '$([MSBuild]::ValueOrDefault('$(BaseIntermediateOutputPath)', 'obj'))/$(Configuration)/$(TargetFramework)'))', 'runic-www.stamp'))" Set="RunicDevSession" />
  </ItemGroup>
  <!-- A project that references a host adapter gets <RootNamespace>.RunicViewsComposition by default. The
       namespace is RootNamespace (the project name unless the project sets another) made a valid C# namespace:
       a character other than a letter, digit, underscore or dot becomes an underscore, and a segment that starts
       with a digit or is a C# keyword gets an underscore prefix. The project body has set RootNamespace by now. -->
  <PropertyGroup Condition="'$(RunicApplicationFrontendCompositionType)' == '' and '$(_RunicApplicationHostAdapter)' == 'true'">
    <_RunicApplicationFrontendCompositionNamespace>$(RootNamespace)</_RunicApplicationFrontendCompositionNamespace>
    <_RunicApplicationFrontendCompositionNamespace Condition="'$(_RunicApplicationFrontendCompositionNamespace)' == ''">$(MSBuildProjectName)</_RunicApplicationFrontendCompositionNamespace>
    <_RunicApplicationFrontendCompositionNamespace>$([System.Text.RegularExpressions.Regex]::Replace('$(_RunicApplicationFrontendCompositionNamespace)', '[^\p{L}\p{Nd}_.]', '_'))</_RunicApplicationFrontendCompositionNamespace>
    <_RunicApplicationFrontendCompositionNamespace>$([System.Text.RegularExpressions.Regex]::Replace('$(_RunicApplicationFrontendCompositionNamespace)', '\.\.+', '.').Trim('.'))</_RunicApplicationFrontendCompositionNamespace>
    <_RunicApplicationFrontendCompositionNamespace>$([System.Text.RegularExpressions.Regex]::Replace('$(_RunicApplicationFrontendCompositionNamespace)', '(^|\.)(?=\p{Nd}|(?:abstract|as|base|bool|break|byte|case|catch|char|checked|class|const|continue|decimal|default|delegate|do|double|else|enum|event|explicit|extern|false|finally|fixed|float|for|foreach|goto|if|implicit|in|int|interface|internal|is|lock|long|namespace|new|null|object|operator|out|override|params|private|protected|public|readonly|ref|return|sbyte|sealed|short|sizeof|stackalloc|static|string|struct|switch|this|throw|true|try|typeof|uint|ulong|unchecked|unsafe|ushort|using|virtual|void|volatile|while)(?:\.|$))', '$1_'))</_RunicApplicationFrontendCompositionNamespace>
    <_RunicApplicationFrontendCompositionNamespace Condition="'$(_RunicApplicationFrontendCompositionNamespace)' == ''">_</_RunicApplicationFrontendCompositionNamespace>
    <RunicApplicationFrontendCompositionType>$(_RunicApplicationFrontendCompositionNamespace).RunicViewsComposition</RunicApplicationFrontendCompositionType>
  </PropertyGroup>
  <!-- The hosts serve www/ next to the application; another web root reaches them through the runtime
       configuration (RunicWindowOptions.ContentRoot and RunicViewHost.ContentRoot still win). -->
  <ItemGroup Condition="'$(_RunicApplicationFrontendWebRoot)' != 'www'">
    <RuntimeHostConfigurationOption Include="Runic.Application.FrontendWebRoot" Value="$(_RunicApplicationFrontendWebRoot)" Trim="true" />
  </ItemGroup>
  <!-- dotnet runic dev's development server fallback (#1085, #1086) is for untrimmed development builds only: a trimmed
       or NativeAOT publish turns it off, so the trimmer removes it and its HTTP client. Only the publish: PrepareForILLink
       runs before ILLink and before ILC writes its options, never in a build, so a project that sets PublishAot or
       PublishTrimmed keeps the fallback in its builds and in their runtimeconfig.json. -->
  <!-- Development-only views and members ([RunicDevelopmentOnly], D072.12/D072.13): RunicDevelopmentOnlyViews=auto (the
       default) leaves them out of trimmed and NativeAOT publishes, here for the same reason, so that the trimmer removes
       their Bridges and members; true keeps them in every publish. Builds, dotnet run and untrimmed publishes keep them. -->
  <!-- RunicDevelopmentOnlyViews and RunicBridgeBlobs take auto (the default, also when empty) or true, compared without
       case as every MSBuild condition does. Another value, such as false or a typo, is RUNICBRIDGE075 in every build and
       pass that reads them, and the build goes on as auto (API-30 of the 0.23 API review): false cannot keep
       either out of an untrimmed publish. Not in the bootstrap pass, which repeats the project's properties. -->
  <Target Name="RunicViewsCheckAutoProperties" BeforeTargets="PrepareForBuild"
          Condition="'$(RunicApplicationFrontendBootstrap)' != 'true' and '$(DesignTimeBuild)' != 'true'">
    <Warning Code="RUNICBRIDGE075" File="$(MSBuildProjectFullPath)" HelpLink="$(_RunicDiagnosticsHelpLinkBase)runicbridge075"
             Condition="'$(RunicDevelopmentOnlyViews)' != '' and '$(RunicDevelopmentOnlyViews)' != 'auto' and '$(RunicDevelopmentOnlyViews)' != 'true'"
             Text="RunicDevelopmentOnlyViews is '$(RunicDevelopmentOnlyViews)', which is neither auto nor true, so the build uses auto: trimmed and NativeAOT publishes leave development-only views and members out, and builds and untrimmed publishes keep them. Set true to keep them in every publish, or remove the property." />
    <Warning Code="RUNICBRIDGE075" File="$(MSBuildProjectFullPath)" HelpLink="$(_RunicDiagnosticsHelpLinkBase)runicbridge075"
             Condition="'$(RunicBridgeBlobs)' != '' and '$(RunicBridgeBlobs)' != 'auto' and '$(RunicBridgeBlobs)' != 'true'"
             Text="RunicBridgeBlobs is '$(RunicBridgeBlobs)', which is neither auto nor true, so the build uses auto: a trimmed or NativeAOT publish leaves Bridge blobs and uploads out when no assembly's Bridges use them. Set true to keep them in every publish, or remove the property." />
  </Target>
  <!-- #1318: each RunicApplicationFrontendClientModule maps a referenced client library's assembly (Include, its simple
       name) to the module specifier of its generated runic-clients.ts (Specifier), which this application's generated
       modules import instead of generating copies. A missing or blank Specifier, a relative one, which every
       generated module would resolve from its own folder, and an assembly mapped twice are RUNICBRIDGE082; the
       generator reports the rest (RUNICBRIDGE079 to 081 and 083). -->
  <Target Name="RunicViewsCheckClientModules" BeforeTargets="PrepareForBuild"
          Condition="'@(RunicApplicationFrontendClientModule)' != '' and '$(RunicApplicationFrontendBootstrap)' != 'true' and '$(DesignTimeBuild)' != 'true' and '$(_RunicBridgeMarkupTemporary)' != 'true'">
    <ItemGroup>
      <_RunicClientModule Include="@(RunicApplicationFrontendClientModule)" TrimmedSpecifier="$([System.String]::Copy('%(RunicApplicationFrontendClientModule.Specifier)').Trim())" />
      <_RunicClientModuleRelative Include="@(_RunicClientModule)"
                                  Condition="'%(TrimmedSpecifier)' == '.' or '%(TrimmedSpecifier)' == '..' or $([System.String]::Copy('%(TrimmedSpecifier)').StartsWith('./')) or $([System.String]::Copy('%(TrimmedSpecifier)').StartsWith('../')) or $([System.String]::Copy('%(TrimmedSpecifier)').StartsWith('.\')) or $([System.String]::Copy('%(TrimmedSpecifier)').StartsWith('..\'))" />
      <!-- Batched by Include, so the count is that of the items with the same assembly. -->
      <_RunicClientModuleDuplicate Include="%(RunicApplicationFrontendClientModule.Identity)" Condition="'@(RunicApplicationFrontendClientModule->Count())' &gt; 1" />
    </ItemGroup>
    <Error Code="RUNICBRIDGE082" File="$(MSBuildProjectFullPath)" HelpLink="$(_RunicDiagnosticsHelpLinkBase)runicbridge082" ContinueOnError="ErrorAndContinue"
           Condition="'%(_RunicClientModule.TrimmedSpecifier)' == ''"
           Text="The RunicApplicationFrontendClientModule %(_RunicClientModule.Identity) has no Specifier. Set it to the module specifier of the library's generated runic-clients.ts, as the frontend imports it, such as Specifier=&quot;@acme/shared-ui/generated&quot;." />
    <Error Code="RUNICBRIDGE082" File="$(MSBuildProjectFullPath)" HelpLink="$(_RunicDiagnosticsHelpLinkBase)runicbridge082" ContinueOnError="ErrorAndContinue"
           Condition="'@(_RunicClientModuleRelative)' != ''"
           Text="The RunicApplicationFrontendClientModule %(_RunicClientModuleRelative.Identity) has the relative Specifier '%(_RunicClientModuleRelative.TrimmedSpecifier)', which every generated module would resolve from its own folder. Use a package specifier, such as @acme/shared-ui/generated, or a tsconfig paths alias." />
    <Error Code="RUNICBRIDGE082" File="$(MSBuildProjectFullPath)" HelpLink="$(_RunicDiagnosticsHelpLinkBase)runicbridge082" ContinueOnError="ErrorAndContinue"
           Condition="'@(_RunicClientModuleDuplicate)' != ''"
           Text="The assembly %(_RunicClientModuleDuplicate.Identity) has more than one RunicApplicationFrontendClientModule. Keep one item per assembly." />
  </Target>
  <Target Name="_RunicViewsPublishFeatureSwitches" BeforeTargets="PrepareForILLink">
    <ItemGroup>
      <RuntimeHostConfigurationOption Include="Runic.Application.DevelopmentServerForwarding" Value="false" Trim="true" />
      <RuntimeHostConfigurationOption Include="Runic.Application.Views.DevelopmentOnlyViews" Value="false" Trim="true"
                                      Condition="'$(RunicDevelopmentOnlyViews)' != 'true'" />
    </ItemGroup>
  </Target>
  <!-- Bridge blobs and uploads (blobs/1, runic-sdk#1193): the generated codecs of a member that holds a RunicBlob or
       takes a RunicUpload mark their assembly with the assembly metadata Runic.Application.Views.Blobs=true. A trimmed
       or NativeAOT publish in which no assembly of the application has it, and none names RunicBlob or RunicUpload in its
       metadata (one whose Bridges a generator before 0.23 wrote, or a ViewModel that uses them), turns blobs/1 off, so
       the trimmer removes the Window's blob store and the hosts' blob endpoints. RunicBridgeBlobs=true keeps them. Only
       the publish, as above: builds and dotnet run keep blobs/1. -->
  <UsingTask TaskName="RunicViewsFindBlobUse" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Assemblies ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <UsedBy ParameterType="System.String" Output="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Code Type="Method" Language="cs"><![CDATA[
        // The serialized custom attribute blob of [assembly: AssemblyMetadata("Runic.Application.Views.Blobs", "true")]
        // (ECMA-335 II.23.3): the prolog, then each argument as a length-prefixed UTF-8 string, then no named arguments.
        // The blob heap holds it as it is, so the bytes find it without loading the assembly. An assembly without it that
        // references RunicBlob or RunicUpload has the type's name, NUL-terminated, in its string heap: the end of a longer
        // name may hold it (compilers share suffixes), so the name is searched without a leading NUL, and a longer name
        // that ends in it only keeps blobs/1. Runic.Application.Views defines both.
        public override bool Execute()
        {
          var names = new[] { System.Text.Encoding.UTF8.GetBytes("RunicBlob\0"), System.Text.Encoding.UTF8.GetBytes("RunicUpload\0") };
          var key = System.Text.Encoding.UTF8.GetBytes("Runic.Application.Views.Blobs");
          var value = System.Text.Encoding.UTF8.GetBytes("true");
          var pattern = new byte[2 + 1 + key.Length + 1 + value.Length + 2];
          pattern[0] = 1;
          pattern[2] = (byte)key.Length;
          key.CopyTo(pattern, 3);
          pattern[3 + key.Length] = (byte)value.Length;
          value.CopyTo(pattern, 4 + key.Length);
          foreach (var item in Assemblies)
          {
            var path = item.GetMetadata("FullPath");
            if (!File.Exists(path)) continue;
            var bytes = File.ReadAllBytes(path);
            var named = !string.Equals(Path.GetFileName(path), "Runic.Application.Views.dll", StringComparison.OrdinalIgnoreCase)
              && (Contains(bytes, names[0]) || Contains(bytes, names[1]));
            if (!named && !Contains(bytes, pattern)) continue;
            UsedBy = Path.GetFileNameWithoutExtension(path);
            return true;
          }
          return true;
        }

        // Without spans: the task also compiles against .NET Framework's MSBuild.
        private static bool Contains(byte[] bytes, byte[] pattern)
        {
          for (var start = Array.IndexOf(bytes, pattern[0]); start >= 0 && start <= bytes.Length - pattern.Length;
               start = Array.IndexOf(bytes, pattern[0], start + 1))
          {
            var index = 1;
            while (index < pattern.Length && bytes[start + index] == pattern[index]) index++;
            if (index == pattern.Length) return true;
          }
          return false;
        }
      ]]></Code>
    </Task>
  </UsingTask>
  <Target Name="_RunicViewsPublishBlobsFeatureSwitch" BeforeTargets="PrepareForILLink" Condition="'$(RunicBridgeBlobs)' != 'true'">
    <ItemGroup>
      <_RunicViewsBlobCandidate Include="@(IntermediateAssembly)" />
      <_RunicViewsBlobCandidate Include="@(ReferencePath)" Condition="'%(ReferencePath.FrameworkReferenceName)' == ''" />
      <!-- The implementation of a project or package reference: a reference assembly leaves internal members out. -->
      <_RunicViewsBlobCandidate Include="@(ReferenceCopyLocalPaths)" Condition="'%(ReferenceCopyLocalPaths.Extension)' == '.dll'" />
    </ItemGroup>
    <RunicViewsFindBlobUse Assemblies="@(_RunicViewsBlobCandidate)">
      <Output TaskParameter="UsedBy" PropertyName="_RunicViewsBlobsUsedBy" />
    </RunicViewsFindBlobUse>
    <Message Importance="low" Condition="'$(_RunicViewsBlobsUsedBy)' != ''" Text="Runic Bridge: $(_RunicViewsBlobsUsedBy) uses blobs or uploads, so blobs/1 stays in the publish." />
    <ItemGroup Condition="'$(_RunicViewsBlobsUsedBy)' == ''">
      <RuntimeHostConfigurationOption Include="Runic.Application.Views.Blobs" Value="false" Trim="true" />
    </ItemGroup>
  </Target>

  <!-- The generator and the frontend commands run with IgnoreExitCode, so a
       failure is not repeated as MSB3073 ("The command exited with code 1").
       This task logs their canonical errors and warnings with their codes and
       locations, and those of a failed svelte-check with their locations. It
       logs the summary error only when the command failed without reporting
       one. It is compiled only when a command failed or
       reported a diagnostic. -->
  <UsingTask TaskName="RunicViewsReportCommandResult" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Lines ParameterType="Microsoft.Build.Framework.ITaskItem[]" />
      <ExitCode ParameterType="System.Int32" Required="true" />
      <WorkingDirectory ParameterType="System.String" />
      <FailureCode ParameterType="System.String" Required="true" />
      <FailureFile ParameterType="System.String" />
      <FailureText ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Code Type="Method" Language="cs"><![CDATA[
        public override bool Execute()
        {
          var diagnostic = new Regex(@"^\s*(?:(?<origin>.*?)\s*:\s*)?(?<kind>error|warning)\s+(?<code>[A-Za-z]+\d+)\s*:\s*(?<text>.*)$");
          var location = new Regex(@"^(?<file>.*?)\s*\((?<line>\d+)(?:[,-](?<column>\d+))?[^)]*\)$");
          // svelte-check reports in neither form. Its default output names the
          // absolute file as "file:line:column" on one line and the message as
          // "Error: text" or "Warn: text" on the next; --output machine prints
          // '<time> ERROR "file" line:column "text"'. Both are logged when the
          // command failed, so a check that only warns still builds.
          var ansi = new Regex(@"\x1B\[[0-9;]*m");
          var svelteLocation = new Regex(@"^(?<file>.+?):(?<line>\d+):(?<column>\d+)$");
          var svelteMessage = new Regex(@"^(?<kind>Error|Warn):\s*(?<text>.*)$");
          // Off Windows, MSBuild turns every backslash in an output line into a
          // slash, so an escaped quote in its JSON strings arrives as /".
          var svelteMachine = new Regex(@"^\d+\s+(?<kind>ERROR|WARNING)\s+(?<file>""(?:[^""\\]|\\.|/"")*"")\s+(?<line>\d+):(?<column>\d+)\s+(?<text>""(?:[^""\\]|\\.|/"")*"")\s*$");
          var lines = new System.Collections.Generic.List<string>();
          foreach (var item in Lines ?? new Microsoft.Build.Framework.ITaskItem[0]) lines.Add(ansi.Replace(item.ItemSpec, ""));
          bool reportedError = false;
          for (int index = 0; index < lines.Count; index++)
          {
            if (ExitCode != 0 && TryReportSvelteCheck(lines, index, svelteLocation, svelteMessage, svelteMachine, ref reportedError)) continue;
            Match match = diagnostic.Match(lines[index]);
            if (!match.Success) continue;
            // A diagnostic without an origin, such as the generator's, belongs to the project.
            string file = match.Groups["origin"].Value.Trim();
            int line = 0, column = 0;
            Match at = location.Match(file);
            if (at.Success)
            {
              file = at.Groups["file"].Value;
              line = int.Parse(at.Groups["line"].Value);
              if (at.Groups["column"].Success) column = int.Parse(at.Groups["column"].Value);
            }
            file = Resolve(file);
            if (match.Groups["kind"].Value == "error")
            {
              reportedError = true;
              Log.LogError(null, match.Groups["code"].Value, null, file, line, column, 0, 0, match.Groups["text"].Value);
            }
            else
            {
              Log.LogWarning(null, match.Groups["code"].Value, null, file, line, column, 0, 0, match.Groups["text"].Value);
            }
          }
          if (ExitCode != 0 && !reportedError)
          {
            Log.LogError(null, FailureCode, null, FailureFile, 0, 0, 0, 0, FailureText);
          }
          return !Log.HasLoggedErrors;
        }

        // A relative file belongs to the command's working directory; no file belongs to the project.
        private string Resolve(string file)
        {
          if (file.Length > 0 && file.IndexOfAny(Path.GetInvalidPathChars()) < 0)
          {
            if (!Path.IsPathRooted(file) && !string.IsNullOrEmpty(WorkingDirectory)) file = Path.GetFullPath(Path.Combine(WorkingDirectory, file));
            else if (Path.IsPathRooted(file)) file = Path.GetFullPath(file);
          }
          return file.Length == 0 ? FailureFile ?? "" : file;
        }

        private bool TryReportSvelteCheck(System.Collections.Generic.List<string> lines, int index,
          Regex location, Regex message, Regex machine, ref bool reportedError)
        {
          string kind, file, text;
          int line, column;
          Match match = machine.Match(lines[index]);
          if (match.Success)
          {
            kind = match.Groups["kind"].Value == "ERROR" ? "error" : "warning";
            file = DecodeJsonString(match.Groups["file"].Value);
            text = DecodeJsonString(match.Groups["text"].Value);
          }
          else
          {
            match = location.Match(lines[index].Trim());
            if (!match.Success || index + 1 >= lines.Count || !Path.IsPathRooted(match.Groups["file"].Value)) return false;
            Match next = message.Match(lines[index + 1].Trim());
            if (!next.Success) return false;
            kind = next.Groups["kind"].Value == "Error" ? "error" : "warning";
            file = match.Groups["file"].Value;
            text = next.Groups["text"].Value;
          }
          line = int.Parse(match.Groups["line"].Value);
          column = int.Parse(match.Groups["column"].Value);
          file = Resolve(file);
          // svelte-check prints no diagnostic code; the message is enough to link the location.
          if (kind == "error")
          {
            reportedError = true;
            Log.LogError(null, null, null, file, line, column, 0, 0, text);
          }
          else
          {
            Log.LogWarning(null, null, null, file, line, column, 0, 0, text);
          }
          return true;
        }

        // Decodes a JSON string. A slash before a quote is an escaped quote, and
        // one before n and an indent is a line break, as MSBuild left them.
        private static string DecodeJsonString(string quoted)
        {
          var text = new System.Text.StringBuilder();
          int end = quoted.Length - 1;
          for (int i = 1; i < end; i++)
          {
            char c = quoted[i];
            if (c == '/' && i + 1 < end && (quoted[i + 1] == '"' || (quoted[i + 1] == 'n' && i + 2 < end && quoted[i + 2] == ' ')))
            {
              text.Append(quoted[++i] == 'n' ? '\n' : '"');
              continue;
            }
            if (c != '\\' || i + 1 >= end) { text.Append(c); continue; }
            char escaped = quoted[++i];
            switch (escaped)
            {
              case 'n': text.Append('\n'); break;
              case 'r': text.Append('\r'); break;
              case 't': text.Append('\t'); break;
              case 'b': text.Append('\b'); break;
              case 'f': text.Append('\f'); break;
              case 'u' when i + 4 < end:
                text.Append((char)Convert.ToInt32(quoted.Substring(i + 1, 4), 16));
                i += 4;
                break;
              default: text.Append(escaped); break;
            }
          }
          return text.ToString();
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <!-- devtools-library-dx M1: the frontend's JavaScript workspace. A frontend without a lock file of its own below a
       folder that declares a workspace (package.json "workspaces", or pnpm-workspace.yaml) installs at that workspace
       root, once for all its members, with the root's package manager and lock file: the nearest such folder above the
       frontend, or RunicApplicationFrontendWorkspaceRoot (a folder, or none when the frontend is its own root).
       Evaluation cannot expand the workspace's globs, so RunicViewsResolveFrontendWorkspace checks that the frontend is
       a member before the install (RUNICBRIDGE087). The build looks for a workspace only when it installs the frontend
       or the root is set: with RunicApplicationFrontendInstallEnabled=false whoever installs owns the workspace, and the
       frontend folder alone selects the package manager, as before. -->
  <!-- RunicApplicationFrontendInstallMode: Auto (the default) installs when the install's hash says so, Always on every
       build, and Never leaves the install to you. Compared without case; another value is RUNICBRIDGE091 and builds as
       Auto. RunicApplicationFrontendInstallEnabled=false, the older switch, is Never when the mode is not set; the mode
       wins when both are set, also over a global InstallEnabled; these targets read the mode. Whenever the default install runs, it is the locked one (npm ci, or pnpm's and Bun's
       frozen lock file), without install scripts. -->
  <PropertyGroup>
    <_RunicFrontendInstallMode>$(RunicApplicationFrontendInstallMode.Trim())</_RunicFrontendInstallMode>
    <_RunicFrontendInstallModeInvalid Condition="'$(_RunicFrontendInstallMode)' != '' and '$(_RunicFrontendInstallMode)' != 'Auto' and '$(_RunicFrontendInstallMode)' != 'Always' and '$(_RunicFrontendInstallMode)' != 'Never'">true</_RunicFrontendInstallModeInvalid>
    <_RunicFrontendInstallMode Condition="'$(_RunicFrontendInstallModeInvalid)' == 'true'">Auto</_RunicFrontendInstallMode>
    <_RunicFrontendInstallMode Condition="'$(_RunicFrontendInstallMode)' == '' and '$(RunicApplicationFrontendInstallEnabled)' == 'false'">Never</_RunicFrontendInstallMode>
    <_RunicFrontendInstallMode Condition="'$(_RunicFrontendInstallMode)' == ''">Auto</_RunicFrontendInstallMode>
    <_RunicFrontendInstallAlways Condition="'$(_RunicFrontendInstallMode)' == 'Always'">true</_RunicFrontendInstallAlways>
    <_RunicFrontendInstallAlways Condition="'$(_RunicFrontendInstallAlways)' == ''">false</_RunicFrontendInstallAlways>
    <RunicApplicationFrontendInstallEnabled Condition="'$(_RunicFrontendInstallMode)' == 'Never'">false</RunicApplicationFrontendInstallEnabled>
    <RunicApplicationFrontendInstallEnabled Condition="'$(_RunicFrontendInstallMode)' != 'Never'">true</RunicApplicationFrontendInstallEnabled>
  </PropertyGroup>
  <PropertyGroup Condition="Exists('$(RunicApplicationFrontendDirectory)/package.json')">
    <_RunicFrontendFullDirectory>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(RunicApplicationFrontendDirectory)').TrimEnd('/').TrimEnd('\'))</_RunicFrontendFullDirectory>
    <_RunicFrontendWorkspaceRoot>$(_RunicFrontendFullDirectory)</_RunicFrontendWorkspaceRoot>
    <_RunicFrontendOwnLock Condition="Exists('$(_RunicFrontendFullDirectory)/bun.lock') or Exists('$(_RunicFrontendFullDirectory)/bun.lockb') or Exists('$(_RunicFrontendFullDirectory)/package-lock.json') or Exists('$(_RunicFrontendFullDirectory)/npm-shrinkwrap.json') or Exists('$(_RunicFrontendFullDirectory)/pnpm-lock.yaml')">true</_RunicFrontendOwnLock>
    <_RunicFrontendSearchWorkspace Condition="'$(RunicApplicationFrontendWorkspaceRoot)' == '' and '$(_RunicFrontendOwnLock)' != 'true' and '$(_RunicFrontendInstallMode)' != 'Never' and '$(RunicApplicationFrontendNodeModulesDirectory)' == ''">true</_RunicFrontendSearchWorkspace>
  </PropertyGroup>
  <PropertyGroup Condition="'$(_RunicFrontendSearchWorkspace)' == 'true'">
    <_RunicFrontendParentDirectory>$([System.IO.Path]::GetDirectoryName('$(_RunicFrontendFullDirectory)'))</_RunicFrontendParentDirectory>
    <!-- The nearest package.json above with "workspaces", passing up to three without, such as a library folder's. -->
    <_RunicFrontendManifestAbove>$([MSBuild]::GetDirectoryNameOfFileAbove('$(_RunicFrontendParentDirectory)', 'package.json'))</_RunicFrontendManifestAbove>
    <_RunicFrontendManifestWorkspace Condition="'$(_RunicFrontendManifestAbove)' != '' and $([System.Text.RegularExpressions.Regex]::IsMatch($([System.IO.File]::ReadAllText('$(_RunicFrontendManifestAbove)/package.json')), '&quot;workspaces&quot;\s*:'))">true</_RunicFrontendManifestWorkspace>
    <_RunicFrontendManifestNext Condition="'$(_RunicFrontendManifestAbove)' != '' and '$(_RunicFrontendManifestWorkspace)' != 'true'">$([System.IO.Path]::GetDirectoryName('$(_RunicFrontendManifestAbove)'))</_RunicFrontendManifestNext>
    <_RunicFrontendManifestAbove Condition="'$(_RunicFrontendManifestAbove)' != '' and '$(_RunicFrontendManifestWorkspace)' != 'true' and '$(_RunicFrontendManifestNext)' != ''">$([MSBuild]::GetDirectoryNameOfFileAbove('$(_RunicFrontendManifestNext)', 'package.json'))</_RunicFrontendManifestAbove>
    <_RunicFrontendManifestWorkspace Condition="'$(_RunicFrontendManifestAbove)' != '' and $([System.Text.RegularExpressions.Regex]::IsMatch($([System.IO.File]::ReadAllText('$(_RunicFrontendManifestAbove)/package.json')), '&quot;workspaces&quot;\s*:'))">true</_RunicFrontendManifestWorkspace>
    <_RunicFrontendManifestNext Condition="'$(_RunicFrontendManifestAbove)' != '' and '$(_RunicFrontendManifestWorkspace)' != 'true'">$([System.IO.Path]::GetDirectoryName('$(_RunicFrontendManifestAbove)'))</_RunicFrontendManifestNext>
    <_RunicFrontendManifestAbove Condition="'$(_RunicFrontendManifestAbove)' != '' and '$(_RunicFrontendManifestWorkspace)' != 'true' and '$(_RunicFrontendManifestNext)' != ''">$([MSBuild]::GetDirectoryNameOfFileAbove('$(_RunicFrontendManifestNext)', 'package.json'))</_RunicFrontendManifestAbove>
    <_RunicFrontendManifestWorkspace Condition="'$(_RunicFrontendManifestAbove)' != '' and $([System.Text.RegularExpressions.Regex]::IsMatch($([System.IO.File]::ReadAllText('$(_RunicFrontendManifestAbove)/package.json')), '&quot;workspaces&quot;\s*:'))">true</_RunicFrontendManifestWorkspace>
    <_RunicFrontendManifestNext Condition="'$(_RunicFrontendManifestAbove)' != '' and '$(_RunicFrontendManifestWorkspace)' != 'true'">$([System.IO.Path]::GetDirectoryName('$(_RunicFrontendManifestAbove)'))</_RunicFrontendManifestNext>
    <_RunicFrontendManifestAbove Condition="'$(_RunicFrontendManifestAbove)' != '' and '$(_RunicFrontendManifestWorkspace)' != 'true' and '$(_RunicFrontendManifestNext)' != ''">$([MSBuild]::GetDirectoryNameOfFileAbove('$(_RunicFrontendManifestNext)', 'package.json'))</_RunicFrontendManifestAbove>
    <_RunicFrontendManifestWorkspace Condition="'$(_RunicFrontendManifestAbove)' != '' and $([System.Text.RegularExpressions.Regex]::IsMatch($([System.IO.File]::ReadAllText('$(_RunicFrontendManifestAbove)/package.json')), '&quot;workspaces&quot;\s*:'))">true</_RunicFrontendManifestWorkspace>
    <_RunicFrontendManifestAbove Condition="'$(_RunicFrontendManifestWorkspace)' != 'true'"></_RunicFrontendManifestAbove>
    <_RunicFrontendPnpmWorkspaceAbove>$([MSBuild]::GetDirectoryNameOfFileAbove('$(_RunicFrontendParentDirectory)', 'pnpm-workspace.yaml'))</_RunicFrontendPnpmWorkspaceAbove>
    <_RunicFrontendWorkspaceRoot Condition="'$(_RunicFrontendManifestAbove)' != ''">$(_RunicFrontendManifestAbove.TrimEnd('/').TrimEnd('\'))</_RunicFrontendWorkspaceRoot>
    <_RunicFrontendWorkspaceRoot Condition="'$(_RunicFrontendPnpmWorkspaceAbove)' != '' and ('$(_RunicFrontendManifestAbove)' == '' or $(_RunicFrontendPnpmWorkspaceAbove.Length) &gt; $(_RunicFrontendManifestAbove.Length))">$(_RunicFrontendPnpmWorkspaceAbove.TrimEnd('/').TrimEnd('\'))</_RunicFrontendWorkspaceRoot>
  </PropertyGroup>
  <PropertyGroup Condition="Exists('$(RunicApplicationFrontendDirectory)/package.json') and '$(RunicApplicationFrontendWorkspaceRoot)' != '' and '$(RunicApplicationFrontendWorkspaceRoot)' != 'none'">
    <_RunicFrontendWorkspaceRoot>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(RunicApplicationFrontendWorkspaceRoot)').TrimEnd('/').TrimEnd('\'))</_RunicFrontendWorkspaceRoot>
  </PropertyGroup>
  <PropertyGroup>
    <_RunicFrontendInWorkspace Condition="'$(_RunicFrontendWorkspaceRoot)' != '' and '$(_RunicFrontendWorkspaceRoot)' != '$(_RunicFrontendFullDirectory)'">true</_RunicFrontendInWorkspace>
    <!-- Where the install runs and the lock file must be: the workspace root, or the frontend directory. -->
    <_RunicFrontendInstallDirectory>$(RunicApplicationFrontendDirectory)</_RunicFrontendInstallDirectory>
    <_RunicFrontendInstallDirectory Condition="'$(_RunicFrontendInWorkspace)' == 'true'">$(_RunicFrontendWorkspaceRoot)</_RunicFrontendInstallDirectory>
  </PropertyGroup>

  <!-- The frontend package manager is RunicApplicationFrontendPackageManager, else the workspace root's package.json
       "packageManager", then the root's lock file, else the frontend's own package.json "packageManager", then its
       committed lock file, then npm. A member that declares another manager than its workspace's is RUNICBRIDGE089.
       It selects the default build and install commands; set either command explicitly to override it.
       _RunicFrontendPackageManagerSource says where it came from, for RUNICBRIDGE090. -->
  <PropertyGroup Condition="Exists('$(RunicApplicationFrontendDirectory)/package.json')">
    <_RunicFrontendPackageManagerExplicit Condition="'$(RunicApplicationFrontendPackageManager)' != ''">true</_RunicFrontendPackageManagerExplicit>
    <_RunicFrontendPackageManagerSource Condition="'$(RunicApplicationFrontendPackageManager)' != ''">RunicApplicationFrontendPackageManager</_RunicFrontendPackageManagerSource>
    <_RunicFrontendMemberPackageManager>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(RunicApplicationFrontendDirectory)/package.json')), '(?&lt;="packageManager"\s*:\s*")(npm|pnpm|bun)(?=@)'))</_RunicFrontendMemberPackageManager>
  </PropertyGroup>
  <PropertyGroup Condition="'$(_RunicFrontendInWorkspace)' == 'true' and '$(RunicApplicationFrontendPackageManager)' == ''">
    <_RunicFrontendRootPackageManager Condition="Exists('$(_RunicFrontendWorkspaceRoot)/package.json')">$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(_RunicFrontendWorkspaceRoot)/package.json')), '(?&lt;="packageManager"\s*:\s*")(npm|pnpm|bun)(?=@)'))</_RunicFrontendRootPackageManager>
    <_RunicFrontendPackageManagerSource Condition="'$(_RunicFrontendRootPackageManager)' != ''">packageManager in $(_RunicFrontendWorkspaceRoot)/package.json</_RunicFrontendPackageManagerSource>
    <_RunicFrontendPackageManagerSource Condition="'$(_RunicFrontendRootPackageManager)' == '' and Exists('$(_RunicFrontendWorkspaceRoot)/pnpm-lock.yaml')">$(_RunicFrontendWorkspaceRoot)/pnpm-lock.yaml</_RunicFrontendPackageManagerSource>
    <_RunicFrontendRootPackageManager Condition="'$(_RunicFrontendRootPackageManager)' == '' and Exists('$(_RunicFrontendWorkspaceRoot)/pnpm-lock.yaml')">pnpm</_RunicFrontendRootPackageManager>
    <_RunicFrontendPackageManagerSource Condition="'$(_RunicFrontendRootPackageManager)' == '' and Exists('$(_RunicFrontendWorkspaceRoot)/bun.lock')">$(_RunicFrontendWorkspaceRoot)/bun.lock</_RunicFrontendPackageManagerSource>
    <_RunicFrontendPackageManagerSource Condition="'$(_RunicFrontendRootPackageManager)' == '' and !Exists('$(_RunicFrontendWorkspaceRoot)/bun.lock') and Exists('$(_RunicFrontendWorkspaceRoot)/bun.lockb')">$(_RunicFrontendWorkspaceRoot)/bun.lockb</_RunicFrontendPackageManagerSource>
    <_RunicFrontendRootPackageManager Condition="'$(_RunicFrontendRootPackageManager)' == '' and (Exists('$(_RunicFrontendWorkspaceRoot)/bun.lock') or Exists('$(_RunicFrontendWorkspaceRoot)/bun.lockb'))">bun</_RunicFrontendRootPackageManager>
    <_RunicFrontendPackageManagerSource Condition="'$(_RunicFrontendRootPackageManager)' == '' and (Exists('$(_RunicFrontendWorkspaceRoot)/package-lock.json') or Exists('$(_RunicFrontendWorkspaceRoot)/npm-shrinkwrap.json'))">the npm lock file in $(_RunicFrontendWorkspaceRoot)</_RunicFrontendPackageManagerSource>
    <_RunicFrontendRootPackageManager Condition="'$(_RunicFrontendRootPackageManager)' == '' and (Exists('$(_RunicFrontendWorkspaceRoot)/package-lock.json') or Exists('$(_RunicFrontendWorkspaceRoot)/npm-shrinkwrap.json'))">npm</_RunicFrontendRootPackageManager>
    <_RunicFrontendPackageManagerSource Condition="'$(_RunicFrontendRootPackageManager)' == '' and Exists('$(_RunicFrontendWorkspaceRoot)/pnpm-workspace.yaml')">$(_RunicFrontendWorkspaceRoot)/pnpm-workspace.yaml</_RunicFrontendPackageManagerSource>
    <_RunicFrontendRootPackageManager Condition="'$(_RunicFrontendRootPackageManager)' == '' and Exists('$(_RunicFrontendWorkspaceRoot)/pnpm-workspace.yaml')">pnpm</_RunicFrontendRootPackageManager>
    <RunicApplicationFrontendPackageManager>$(_RunicFrontendRootPackageManager)</RunicApplicationFrontendPackageManager>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RunicApplicationFrontendPackageManager)' == '' and '$(_RunicFrontendMemberPackageManager)' != ''">
    <RunicApplicationFrontendPackageManager>$(_RunicFrontendMemberPackageManager)</RunicApplicationFrontendPackageManager>
    <_RunicFrontendPackageManagerSource>packageManager in $(_RunicFrontendFullDirectory)/package.json</_RunicFrontendPackageManagerSource>
  </PropertyGroup>
  <PropertyGroup>
    <_RunicBridgeDefaultFrontendBuild Condition="'$(RunicApplicationFrontendBuildCommand)' == ''">true</_RunicBridgeDefaultFrontendBuild>
    <_RunicFrontendPackageManagerSource Condition="'$(RunicApplicationFrontendPackageManager)' == '' and Exists('$(RunicApplicationFrontendDirectory)/pnpm-lock.yaml')">$(RunicApplicationFrontendDirectory)/pnpm-lock.yaml</_RunicFrontendPackageManagerSource>
    <RunicApplicationFrontendPackageManager Condition="'$(RunicApplicationFrontendPackageManager)' == '' and Exists('$(RunicApplicationFrontendDirectory)/pnpm-lock.yaml')">pnpm</RunicApplicationFrontendPackageManager>
    <_RunicFrontendPackageManagerSource Condition="'$(RunicApplicationFrontendPackageManager)' == '' and (Exists('$(RunicApplicationFrontendDirectory)/bun.lock') or Exists('$(RunicApplicationFrontendDirectory)/bun.lockb'))">the Bun lock file in $(RunicApplicationFrontendDirectory)</_RunicFrontendPackageManagerSource>
    <RunicApplicationFrontendPackageManager Condition="'$(RunicApplicationFrontendPackageManager)' == '' and (Exists('$(RunicApplicationFrontendDirectory)/bun.lock') or Exists('$(RunicApplicationFrontendDirectory)/bun.lockb'))">bun</RunicApplicationFrontendPackageManager>
    <_RunicFrontendPackageManagerSource Condition="'$(RunicApplicationFrontendPackageManager)' == ''">the default, as nothing declares a package manager</_RunicFrontendPackageManagerSource>
    <RunicApplicationFrontendPackageManager Condition="'$(RunicApplicationFrontendPackageManager)' == ''">npm</RunicApplicationFrontendPackageManager>
    <RunicApplicationFrontendBuildCommand Condition="'$(RunicApplicationFrontendBuildCommand)' == '' and '$(RunicApplicationFrontendPackageManager)' == 'pnpm'">pnpm run build</RunicApplicationFrontendBuildCommand>
    <RunicApplicationFrontendBuildCommand Condition="'$(RunicApplicationFrontendBuildCommand)' == '' and '$(RunicApplicationFrontendPackageManager)' == 'bun'">bun run --bun build</RunicApplicationFrontendBuildCommand>
    <RunicApplicationFrontendBuildCommand Condition="'$(RunicApplicationFrontendBuildCommand)' == ''">npm run build</RunicApplicationFrontendBuildCommand>
    <!-- A project may still set its own command after importing these targets. -->
    <_RunicBridgeDefaultFrontendBuildCommand Condition="'$(_RunicBridgeDefaultFrontendBuild)' == 'true'">$(RunicApplicationFrontendBuildCommand)</_RunicBridgeDefaultFrontendBuildCommand>
    <!-- The default install is locked: without the package manager's lock file in the install directory (the workspace
         root in a workspace) it is RUNICBRIDGE026, unless RunicApplicationFrontendAllowUnlockedInstall=true allows
         resolving the declared ranges afresh. -->
    <_RunicBridgeDefaultFrontendInstall Condition="'$(RunicApplicationFrontendInstallCommand)' == ''">true</_RunicBridgeDefaultFrontendInstall>
    <_RunicBridgeFrontendLocked Condition="'$(RunicApplicationFrontendPackageManager)' == 'pnpm' and Exists('$(_RunicFrontendInstallDirectory)/pnpm-lock.yaml')">true</_RunicBridgeFrontendLocked>
    <_RunicBridgeFrontendLocked Condition="'$(RunicApplicationFrontendPackageManager)' == 'bun' and (Exists('$(_RunicFrontendInstallDirectory)/bun.lock') or Exists('$(_RunicFrontendInstallDirectory)/bun.lockb'))">true</_RunicBridgeFrontendLocked>
    <_RunicBridgeFrontendLocked Condition="'$(RunicApplicationFrontendPackageManager)' == 'npm' and (Exists('$(_RunicFrontendInstallDirectory)/package-lock.json') or Exists('$(_RunicFrontendInstallDirectory)/npm-shrinkwrap.json'))">true</_RunicBridgeFrontendLocked>
    <_RunicBridgeFrontendUnlockedInstall Condition="'$(_RunicBridgeFrontendLocked)' != 'true' and '$(RunicApplicationFrontendAllowUnlockedInstall)' == 'true'">true</_RunicBridgeFrontendUnlockedInstall>
    <RunicApplicationFrontendInstallCommand Condition="'$(RunicApplicationFrontendInstallCommand)' == '' and '$(RunicApplicationFrontendPackageManager)' == 'pnpm' and '$(_RunicBridgeFrontendUnlockedInstall)' == 'true'">pnpm install --ignore-scripts</RunicApplicationFrontendInstallCommand>
    <RunicApplicationFrontendInstallCommand Condition="'$(RunicApplicationFrontendInstallCommand)' == '' and '$(RunicApplicationFrontendPackageManager)' == 'pnpm'">pnpm install --frozen-lockfile --ignore-scripts</RunicApplicationFrontendInstallCommand>
    <RunicApplicationFrontendInstallCommand Condition="'$(RunicApplicationFrontendInstallCommand)' == '' and '$(RunicApplicationFrontendPackageManager)' == 'bun' and '$(_RunicBridgeFrontendUnlockedInstall)' == 'true'">bun install --ignore-scripts</RunicApplicationFrontendInstallCommand>
    <RunicApplicationFrontendInstallCommand Condition="'$(RunicApplicationFrontendInstallCommand)' == '' and '$(RunicApplicationFrontendPackageManager)' == 'bun'">bun install --frozen-lockfile --ignore-scripts</RunicApplicationFrontendInstallCommand>
    <RunicApplicationFrontendInstallCommand Condition="'$(RunicApplicationFrontendInstallCommand)' == '' and '$(_RunicBridgeFrontendUnlockedInstall)' == 'true'">npm install --ignore-scripts</RunicApplicationFrontendInstallCommand>
    <RunicApplicationFrontendInstallCommand Condition="'$(RunicApplicationFrontendInstallCommand)' == ''">npm ci --ignore-scripts</RunicApplicationFrontendInstallCommand>
    <_RunicBridgeFrontendLockFileName Condition="'$(RunicApplicationFrontendPackageManager)' == 'pnpm'">pnpm-lock.yaml</_RunicBridgeFrontendLockFileName>
    <_RunicBridgeFrontendLockFileName Condition="'$(RunicApplicationFrontendPackageManager)' == 'bun'">bun.lock</_RunicBridgeFrontendLockFileName>
    <_RunicBridgeFrontendLockFileName Condition="'$(_RunicBridgeFrontendLockFileName)' == ''">package-lock.json</_RunicBridgeFrontendLockFileName>
  </PropertyGroup>

  <PropertyGroup>
    <_RunicBridgeCodegenProject>$(MSBuildThisFileDirectory)../../../../tools/Runic.Application.Views.Codegen/Runic.Application.Views.Codegen.csproj</_RunicBridgeCodegenProject>
    <_RunicBridgeCodegenDll Condition="Exists('$(_RunicBridgeCodegenProject)')">$(MSBuildThisFileDirectory)../../../../tools/Runic.Application.Views.Codegen/bin/$(Configuration)/net10.0/BridgeCodegen.dll</_RunicBridgeCodegenDll>
    <_RunicBridgeCodegenDll Condition="!Exists('$(_RunicBridgeCodegenProject)')">$(MSBuildThisFileDirectory)../tools/net10.0/BridgeCodegen.dll</_RunicBridgeCodegenDll>
    <!-- The TypeScript emitter (R7 G6): the launcher beside these targets, and the copy of @runic-artifex/views/codegen
         that the package bundles (in the repository, the one that the generator's build bundles beside it). -->
    <_RunicViewsCodegenLauncher>$(MSBuildThisFileDirectory)runic-views-codegen.mjs</_RunicViewsCodegenLauncher>
    <!-- The workspace resolver (rax.frontend-graph/1): beside these targets in the package, and in the repository the
         source that @runic-artifex/views exports as ./frontend-graph, so both are one file of one version. -->
    <_RunicViewsFrontendGraphScript Condition="Exists('$(MSBuildThisFileDirectory)runic-frontend-graph.mjs')">$(MSBuildThisFileDirectory)runic-frontend-graph.mjs</_RunicViewsFrontendGraphScript>
    <_RunicViewsFrontendGraphScript Condition="'$(_RunicViewsFrontendGraphScript)' == ''">$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)../../../web/views/frontend-graph/runic-frontend-graph.mjs'))</_RunicViewsFrontendGraphScript>
    <_RunicViewsBundledEmitter Condition="Exists('$(_RunicBridgeCodegenProject)')">$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)../../../../tools/Runic.Application.Views.Codegen/bin/$(Configuration)/net10.0/codegen/index.js'))</_RunicViewsBundledEmitter>
    <_RunicViewsBundledEmitter Condition="!Exists('$(_RunicBridgeCodegenProject)')">$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)../tools/codegen/index.js'))</_RunicViewsBundledEmitter>
    <_RunicBridgeAotArgument Condition="'$(PublishAot)' == 'true'">--aot</_RunicBridgeAotArgument>
    <_RunicBridgeCompositionArgument Condition="'$(RunicApplicationFrontendCompositionType)' != ''">--di-composition &quot;$(RunicApplicationFrontendCompositionType)&quot;</_RunicBridgeCompositionArgument>
  </PropertyGroup>

  <!-- Include the source tool in the restore graph so a first IDE build can
       compile it without a separate manual restore. It is not an app reference: the build runs it from its own
       output, and Private="false" keeps its apphost, deps.json and runtimeconfig.json (which ReferenceOutputAssembly
       does not cover for an executable) out of the application's build and publish output, as for a package
       consumer (FD5, D072.19). -->
  <ItemGroup Condition="Exists('$(_RunicBridgeCodegenProject)') and '$(RunicApplicationFrontendBootstrap)' != 'true'">
    <ProjectReference Include="$(_RunicBridgeCodegenProject)" ReferenceOutputAssembly="false" Private="false"
                      GlobalPropertiesToRemove="PublishAot;PublishTrimmed;PublishReadyToRun;PublishSingleFile;IncludeNativeLibrariesForSelfExtract;RuntimeIdentifier;SelfContained" />
  </ItemGroup>

  <!-- The RUNICBRIDGE shape analyzers (Runic.Application.Views.Analyzers) report the rules that need only the source
       while you type, where the generator, a build step that design-time builds skip, reports them only after a build.
       They read whether this project generates its own Bridges, as the generator's conditions below do. In a build the
       generator runs first and stops at these errors, so each is reported once. From source, the analyzer projects are
       referenced as analyzers; from the package, NuGet adds them to a project that references Runic.Application.Views
       directly, and RunicViewsAddAnalyzers to one that gets it through a host adapter, whose dependency excludes
       analyzers. -->
  <PropertyGroup>
    <_RunicViewsAnalyzersProject>$(MSBuildThisFileDirectory)../../Runic.Application.Views.Analyzers/Runic.Application.Views.Analyzers.csproj</_RunicViewsAnalyzersProject>
    <_RunicViewsAnalyzerCodeFixesProject>$(MSBuildThisFileDirectory)../../Runic.Application.Views.Analyzers.CodeFixes/Runic.Application.Views.Analyzers.CodeFixes.csproj</_RunicViewsAnalyzerCodeFixesProject>
    <_RunicViewsPackagedAnalyzers>$(MSBuildThisFileDirectory)../analyzers/dotnet/cs/</_RunicViewsPackagedAnalyzers>
  </PropertyGroup>
  <ItemGroup>
    <CompilerVisibleProperty Include="RunicApplicationFrontendGenerationEnabled" />
    <CompilerVisibleProperty Include="RunicApplicationFrontendModelAssembly" />
    <CompilerVisibleProperty Include="_RunicApplicationFrontendClientModules" />
  </ItemGroup>
  <!-- #1318: the assemblies that RunicApplicationFrontendClientModule maps, whose Views the generator adds to this
       application's (ClientModules.Discover), so that the analyzers treat their ViewModels as content as it does. Set in
       a target, because the items are evaluated after the properties. -->
  <Target Name="_RunicViewsAnalyzerClientModules" BeforeTargets="GenerateMSBuildEditorConfigFileCore"
          Condition="'@(RunicApplicationFrontendClientModule)' != ''">
    <PropertyGroup>
      <_RunicApplicationFrontendClientModules>@(RunicApplicationFrontendClientModule->'%(Identity)', ';')</_RunicApplicationFrontendClientModules>
    </PropertyGroup>
  </Target>
  <ItemGroup Condition="Exists('$(_RunicViewsAnalyzersProject)') and '$(RunicApplicationFrontendBootstrap)' != 'true'">
    <ProjectReference Include="$(_RunicViewsAnalyzersProject);$(_RunicViewsAnalyzerCodeFixesProject)" ReferenceOutputAssembly="false" OutputItemType="Analyzer"
                      GlobalPropertiesToRemove="PublishAot;PublishTrimmed;PublishReadyToRun;PublishSingleFile;IncludeNativeLibrariesForSelfExtract;RuntimeIdentifier;SelfContained" />
  </ItemGroup>
  <Target Name="RunicViewsAddAnalyzers" AfterTargets="ResolveLockFileAnalyzers"
          Condition="!Exists('$(_RunicViewsAnalyzersProject)') and Exists('$(_RunicViewsPackagedAnalyzers)Runic.Application.Views.Analyzers.dll')">
    <ItemGroup>
      <Analyzer Remove="@(Analyzer)" Condition="'%(Filename)' == 'Runic.Application.Views.Analyzers' or '%(Filename)' == 'Runic.Application.Views.Analyzers.CodeFixes'" />
      <Analyzer Include="$([System.IO.Path]::GetFullPath('$(_RunicViewsPackagedAnalyzers)Runic.Application.Views.Analyzers.dll'))" />
      <Analyzer Include="$([System.IO.Path]::GetFullPath('$(_RunicViewsPackagedAnalyzers)Runic.Application.Views.Analyzers.CodeFixes.dll'))" />
    </ItemGroup>
  </Target>

  <!-- The bootstrap pass sets its own output paths. Referenced projects (a
       model project beside a WPF application, for example) keep the
       properties of the real build, so they are not compiled again into the
       bootstrap directories. The SDK adds a project's transitive references
       (from project.assets.json) to ProjectReference during the build, in
       IncludeTransitiveProjectReferences, so the update above evaluation
       misses them; the target after it covers them. Without it every
       transitive reference was compiled again with the bootstrap's output
       paths, all into one IntermediateOutputPath, in parallel (#1003). -->
  <PropertyGroup>
    <_RunicBridgeBootstrapReferencePropertiesToRemove>RunicApplicationFrontendBootstrap;RunAnalyzers;RunCodeAnalysis;CopyLocalLockFileAssemblies;OutputPath;IntermediateOutputPath</_RunicBridgeBootstrapReferencePropertiesToRemove>
  </PropertyGroup>
  <ItemGroup Condition="'$(RunicApplicationFrontendBootstrap)' == 'true'">
    <ProjectReference Update="@(ProjectReference)"
                      GlobalPropertiesToRemove="%(GlobalPropertiesToRemove);$(_RunicBridgeBootstrapReferencePropertiesToRemove)" />
  </ItemGroup>
  <Target Name="_RunicViewsBootstrapTransitiveReferences" AfterTargets="IncludeTransitiveProjectReferences"
          Condition="'$(RunicApplicationFrontendBootstrap)' == 'true'">
    <ItemGroup>
      <ProjectReference Condition="!$([System.String]::Copy(';%(ProjectReference.GlobalPropertiesToRemove);').Contains(';RunicApplicationFrontendBootstrap;'))">
        <GlobalPropertiesToRemove>%(ProjectReference.GlobalPropertiesToRemove);$(_RunicBridgeBootstrapReferencePropertiesToRemove)</GlobalPropertiesToRemove>
      </ProjectReference>
    </ItemGroup>
  </Target>

  <!-- RUNICBRIDGE017 fails the build once per renamed property or item that the project still sets.
       The bootstrap pass and WPF's temporary markup project see the same
       properties, so only the real build reports it. -->
  <!-- The files these targets keep between builds live in the project's
       intermediate directories, so UseArtifactsOutput and a custom
       BaseIntermediateOutputPath or IntermediateOutputPath move them too.
       The paths are set when a target needs them: IntermediateOutputPath,
       with its runtime identifier, is final only after the SDK's targets,
       which a project may import after these.
       - The generated Bridge code is compiled with the project, so it lives
         in IntermediateOutputPath, per configuration, target framework and
         runtime identifier.
       - The bootstrap pass builds without a runtime identifier, below
         BaseIntermediateOutputPath.
       - The frontend's dist/ serves every runtime identifier, so its build
         stamp and the list of files that build left in dist/ are per
         configuration and target framework below BaseIntermediateOutputPath.
         The hash of the build state that last built dist/ is shared by all
         of them: a build whose state differs from the one that built dist/
         rebuilds, as does a missing file. One install serves every
         configuration and target framework, and dotnet clean keeps it.
       WPF's temporary markup project (see RunicViewsMarkupTemporaryCompile)
       gets another IntermediateOutputPath: off Windows, WPF does not remove
       the target framework before passing it on, so the copy appends it
       again. The real project therefore records its generated directory
       below BaseIntermediateOutputPath, which WPF passes unchanged. -->
  <Target Name="_RunicViewsIntermediatePaths">
    <PropertyGroup>
      <_RunicBridgeBaseIntermediateDirectory>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$([MSBuild]::ValueOrDefault('$(BaseIntermediateOutputPath)', 'obj'))'))</_RunicBridgeBaseIntermediateDirectory>
      <_RunicBridgeConfigurationIntermediateDirectory>$([MSBuild]::NormalizeDirectory('$(_RunicBridgeBaseIntermediateDirectory)', '$(Configuration)', '$(TargetFramework)'))</_RunicBridgeConfigurationIntermediateDirectory>
      <_RunicBridgeIntermediateDirectory Condition="'$(IntermediateOutputPath)' != ''">$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)'))</_RunicBridgeIntermediateDirectory>
      <_RunicBridgeIntermediateDirectory Condition="'$(IntermediateOutputPath)' == ''">$(_RunicBridgeConfigurationIntermediateDirectory)</_RunicBridgeIntermediateDirectory>
      <_RunicBridgeGeneratedDir>$(_RunicBridgeIntermediateDirectory)runic-bridge/</_RunicBridgeGeneratedDir>
      <_RunicBridgeBootstrapOutputPath>$(_RunicBridgeBaseIntermediateDirectory)runic-bridge/bootstrap/bin/$(Configuration)/$(TargetFramework)/</_RunicBridgeBootstrapOutputPath>
      <_RunicBridgeBootstrapIntermediateOutputPath>$(_RunicBridgeBaseIntermediateDirectory)runic-bridge/bootstrap/obj/$(Configuration)/$(TargetFramework)/</_RunicBridgeBootstrapIntermediateOutputPath>
      <_RunicBridgeFrontendStamp>$(_RunicBridgeConfigurationIntermediateDirectory)runic-bridge-frontend.stamp</_RunicBridgeFrontendStamp>
      <_RunicBridgeFrontendOutputsFile>$(_RunicBridgeConfigurationIntermediateDirectory)runic-bridge-frontend.outputs</_RunicBridgeFrontendOutputsFile>
      <_RunicBridgeFrontendStateFile>$(_RunicBridgeBaseIntermediateDirectory)runic-bridge-frontend.state</_RunicBridgeFrontendStateFile>
      <_RunicBridgeFrontendInstallStamp>$(_RunicBridgeBaseIntermediateDirectory)runic-bridge-frontend-install.stamp</_RunicBridgeFrontendInstallStamp>
      <_RunicBridgeGeneratedDirRecord>$(_RunicBridgeBaseIntermediateDirectory)runic-bridge/$(AssemblyName)-$(Configuration)-$(TargetFramework)-$(RuntimeIdentifier).generated-directory</_RunicBridgeGeneratedDirRecord>
      <_RunicBridgeGeneratedDir Condition="'$(_RunicBridgeMarkupTemporary)' == 'true' and Exists('$(_RunicBridgeGeneratedDirRecord)')">$([System.IO.File]::ReadAllText('$(_RunicBridgeGeneratedDirRecord)').Trim())</_RunicBridgeGeneratedDir>
    </PropertyGroup>
  </Target>

  <!-- While `dotnet runic dev` serves the frontend, a build of the same output that dev did not start, such as an IDE's
       build before F5 while dev runs without its Window, keeps the session's frontend: dev writes obj/runic/dev-frontend (one
       line, the web root it serves) and renews it every 5 seconds, so a marker older than 30 seconds, from a dev that
       was killed, is ignored. The build then skips the production frontend build (the development server or watcher
       owns the frontend), and with a development server (obj/runic/dev-pages) it does not copy dist/ over the
       development pages in www/ and puts those pages back after the build, also after a clean. Generated TypeScript
       is still written. Publish is never affected; RunicApplicationFrontendDevSessionEnabled=false turns this off.
       Declared before the other targets that run before PrepareForBuild, so RunicViewsResolveFrontendDelivery and
       the frontend targets see the result. -->
  <Target Name="RunicViewsDetectDevSession" BeforeTargets="PrepareForBuild" DependsOnTargets="_RunicViewsIntermediatePaths"
          Condition="'$(RunicApplicationFrontendDevSessionEnabled)' != 'false' and '$(_IsPublishing)' != 'true' and '$(DesignTimeBuild)' != 'true' and '$(RunicApplicationFrontendBootstrap)' != 'true' and '$(_RunicBridgeMarkupTemporary)' != 'true' and '$(OutputType)' != 'Library'">
    <PropertyGroup>
      <_RunicDevSessionDirectory>$(_RunicBridgeBaseIntermediateDirectory)runic/</_RunicDevSessionDirectory>
      <_RunicDevSessionMarker>$(_RunicDevSessionDirectory)dev-frontend</_RunicDevSessionMarker>
      <_RunicDevSessionPages>$(_RunicDevSessionDirectory)dev-pages/</_RunicDevSessionPages>
      <_RunicDevSessionWebRoot>$([System.IO.Path]::GetFullPath('$(TargetDir)$(_RunicApplicationFrontendWebRoot)'))</_RunicDevSessionWebRoot>
      <_RunicDevSessionMarkerAge Condition="Exists('$(_RunicDevSessionMarker)')">$([System.DateTime]::Now.Subtract($([System.IO.File]::GetLastWriteTime('$(_RunicDevSessionMarker)'))).TotalSeconds)</_RunicDevSessionMarkerAge>
      <_RunicDevSessionMarkerWebRoot Condition="'$(_RunicDevSessionMarkerAge)' != '' and $(_RunicDevSessionMarkerAge) &lt; 30">$([System.IO.File]::ReadAllText('$(_RunicDevSessionMarker)').Trim())</_RunicDevSessionMarkerWebRoot>
      <!-- Only for the output dev serves: another configuration, framework or runtime identifier builds as usual.
           MSBuild compares without case, as Windows and macOS paths do. -->
      <_RunicDevSessionLive Condition="'$(_RunicDevSessionMarkerWebRoot)' != '' and '$(_RunicDevSessionMarkerWebRoot)' == '$(_RunicDevSessionWebRoot)'">true</_RunicDevSessionLive>
      <_RunicDevSessionPagesKept Condition="'$(_RunicDevSessionLive)' == 'true' and Exists('$(_RunicDevSessionPages)')">true</_RunicDevSessionPagesKept>
      <RunicApplicationFrontendBuildEnabled Condition="'$(_RunicDevSessionLive)' == 'true'">false</RunicApplicationFrontendBuildEnabled>
      <RunicApplicationFrontendCopyEnabled Condition="'$(_RunicDevSessionPagesKept)' == 'true'">false</RunicApplicationFrontendCopyEnabled>
    </PropertyGroup>
    <Message Importance="high" Condition="'$(_RunicDevSessionPagesKept)' == 'true'"
             Text="$(MSBuildProjectName): dotnet runic dev serves the frontend; the build keeps its development pages in $(_RunicDevSessionWebRoot) and skips the frontend build." />
    <Message Importance="high" Condition="'$(_RunicDevSessionLive)' == 'true' and '$(_RunicDevSessionPagesKept)' != 'true'"
             Text="$(MSBuildProjectName): dotnet runic dev watches the frontend; the build copies its output and skips the frontend build." />
  </Target>

  <Target Name="RunicViewsRestoreDevSessionPages" AfterTargets="Build" Condition="'$(_RunicDevSessionPagesKept)' == 'true'">
    <ItemGroup>
      <_RunicDevSessionPage Include="$(_RunicDevSessionPages)**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(_RunicDevSessionPage)"
          DestinationFiles="@(_RunicDevSessionPage->'$(_RunicDevSessionWebRoot)/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <!-- An application uses one ReactiveUI flavor. The resolved references show the Runic adapters that arrive
       directly, through packages or through other projects, so a mix fails here whatever brought it. -->
  <Target Name="RunicViewsRejectMixedReactiveUiFlavors" AfterTargets="ResolveAssemblyReferences"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(RunicApplicationFrontendBootstrap)' != 'true' and '$(_RunicBridgeMarkupTemporary)' != 'true'">
    <ItemGroup>
      <_RunicReactiveUiAdapterReference Include="@(ReferencePath->'%(Filename)')" />
      <_RunicViewsReactiveUiPrimitives Include="@(_RunicReactiveUiAdapterReference)" Condition="'%(Identity)' == 'Runic.Application.Views.ReactiveUI'" />
      <_RunicViewsReactiveUiReactive Include="@(_RunicReactiveUiAdapterReference)" Condition="'%(Identity)' == 'Runic.Application.Views.ReactiveUI.Reactive'" />
      <_RunicNavigationReactiveUiPrimitives Include="@(_RunicReactiveUiAdapterReference)" Condition="'%(Identity)' == 'Runic.Navigation.ReactiveUI'" />
      <_RunicNavigationReactiveUiReactive Include="@(_RunicReactiveUiAdapterReference)" Condition="'%(Identity)' == 'Runic.Navigation.ReactiveUI.Reactive'" />
    </ItemGroup>
    <Error Code="RUNICBRIDGE023" File="$(MSBuildProjectFullPath)" HelpLink="$(_RunicDiagnosticsHelpLinkBase)runicbridge023" ContinueOnError="ErrorAndContinue"
           Condition="'@(_RunicViewsReactiveUiReactive)' != '' and '@(_RunicViewsReactiveUiPrimitives)' != ''"
           Text="$(MSBuildProjectName) references both Runic.Application.Views.ReactiveUI.Reactive, which uses ReactiveUI's System.Reactive flavor, and Runic.Application.Views.ReactiveUI, directly or through another package or project. Select one ReactiveUI flavor for the application." />
    <Error Code="RUNICBRIDGE023" File="$(MSBuildProjectFullPath)" HelpLink="$(_RunicDiagnosticsHelpLinkBase)runicbridge023" ContinueOnError="ErrorAndContinue"
           Condition="'@(_RunicViewsReactiveUiReactive)' != '' and '@(_RunicNavigationReactiveUiPrimitives)' != ''"
           Text="$(MSBuildProjectName) references Runic.Application.Views.ReactiveUI.Reactive, which uses ReactiveUI's System.Reactive flavor, with Runic.Navigation.ReactiveUI, directly or through another package or project. Reference Runic.Navigation.ReactiveUI.Reactive instead and select one ReactiveUI flavor for the application." />
    <Error Code="RUNICBRIDGE023" File="$(MSBuildProjectFullPath)" HelpLink="$(_RunicDiagnosticsHelpLinkBase)runicbridge023" ContinueOnError="ErrorAndContinue"
           Condition="'@(_RunicViewsReactiveUiPrimitives)' != '' and '@(_RunicNavigationReactiveUiReactive)' != ''"
           Text="$(MSBuildProjectName) references Runic.Application.Views.ReactiveUI, which uses ReactiveUI.Primitives, with Runic.Navigation.ReactiveUI.Reactive, directly or through another package or project. Reference Runic.Navigation.ReactiveUI instead and select one ReactiveUI flavor for the application." />
  </Target>

  <!-- RunicSdkReportRenamedNames (Runic.Sdk.RenamedNames.targets) reports the renamed names first. -->
  <Target Name="RunicViewsReportRenamedProperties" BeforeTargets="PrepareForBuild" DependsOnTargets="RunicSdkReportRenamedNames"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(RunicApplicationFrontendBootstrap)' != 'true' and '$(_RunicBridgeMarkupTemporary)' != 'true'">
    <!-- ErrorAndContinue reports every old name, not only the first. -->
    <Error Code="RUNICBRIDGE017" File="$(MSBuildProjectFullPath)" HelpLink="$(_RunicDiagnosticsHelpLinkBase)runicbridge017" ContinueOnError="ErrorAndContinue"
           Condition="'@(_RunicApplicationFrontendRemovedName)' != ''"
           Text="The Runic build property %(_RunicApplicationFrontendRemovedName.Identity) is removed. %(_RunicApplicationFrontendRemovedName.Reason); remove the property from $(MSBuildProjectFile), its imports or the command line." />
  </Target>

  <!-- RUNICBRIDGE029: a RunicApplicationFrontendPackageManager other than npm, pnpm or bun (compared without case,
       as the conditions above do) selects the npm commands and lock file. It is reported only where that matters:
       for a frontend with a package.json that the build installs or builds with a default command. -->
  <Target Name="RunicViewsCheckFrontendPackageManager" BeforeTargets="PrepareForBuild"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(RunicApplicationFrontendBootstrap)' != 'true' and '$(_RunicBridgeMarkupTemporary)' != 'true'">
    <Warning Code="RUNICBRIDGE091" File="$(MSBuildProjectFullPath)" HelpLink="$(_RunicDiagnosticsHelpLinkBase)runicbridge091"
             Condition="'$(_RunicFrontendInstallModeInvalid)' == 'true'"
             Text="RunicApplicationFrontendInstallMode is '$(RunicApplicationFrontendInstallMode)', which is not Auto, Always or Never, so the build uses Auto: it installs the frontend dependencies when the lock file, a package.json or the package manager changed, or node_modules is incomplete. Set Auto, Always or Never, or remove the property." />
    <Warning Code="RUNICBRIDGE029" File="$(MSBuildProjectFullPath)" HelpLink="$(_RunicDiagnosticsHelpLinkBase)runicbridge029"
             Condition="'$(RunicApplicationFrontendPackageManager)' != '' and '$(RunicApplicationFrontendPackageManager)' != 'npm' and '$(RunicApplicationFrontendPackageManager)' != 'pnpm' and '$(RunicApplicationFrontendPackageManager)' != 'bun' and '$(RunicApplicationFrontendBuildEnabled)' != 'false' and Exists('$(RunicApplicationFrontendDirectory)/package.json') and (('$(_RunicBridgeDefaultFrontendInstall)' == 'true' and '$(_RunicFrontendInstallMode)' != 'Never' and '$(RunicApplicationFrontendNodeModulesDirectory)' == '') or '$(RunicApplicationFrontendBuildCommand)' == '$(_RunicBridgeDefaultFrontendBuildCommand)')"
             Text="RunicApplicationFrontendPackageManager is '$(RunicApplicationFrontendPackageManager)', which is not npm, pnpm or bun, so the default frontend install and build commands use npm. Set it to npm, pnpm or bun, or remove it to follow package.json or the lock file. Another package manager needs RunicApplicationFrontendInstallCommand and RunicApplicationFrontendBuildCommand." />
  </Target>

  <!-- RUNICBRIDGE033: the toolchain is older than the floor of this release, the versions that `dotnet runic doctor`
       requires (tools/dotnet-runic/metadata/runic.compatibility-set.json; eng/support.test.mjs keeps them equal). The
       .NET SDK is checked here, for free; Bun in RunicViewsBuildFrontend, which runs it anyway. -->
  <PropertyGroup>
    <_RunicMinimumDotNetSdkVersion>10.0.404</_RunicMinimumDotNetSdkVersion>
    <_RunicMinimumBunVersion>1.4.4</_RunicMinimumBunVersion>
  </PropertyGroup>
  <Target Name="RunicViewsCheckDotNetSdkVersion" BeforeTargets="PrepareForBuild"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(RunicApplicationFrontendBootstrap)' != 'true' and '$(_RunicBridgeMarkupTemporary)' != 'true' and '$(NETCoreSdkVersion)' != ''">
    <Warning Code="RUNICBRIDGE033" File="$(MSBuildProjectFullPath)" HelpLink="$(_RunicDiagnosticsHelpLinkBase)runicbridge033"
             Condition="$([MSBuild]::VersionLessThan('$(NETCoreSdkVersion)', '$(_RunicMinimumDotNetSdkVersion)'))"
             Text=".NET SDK $(NETCoreSdkVersion) is older than $(_RunicMinimumDotNetSdkVersion), the oldest SDK that this Runic release supports; 'dotnet runic doctor' rejects it. Install .NET SDK $(_RunicMinimumDotNetSdkVersion) or a newer 10.0 release, and rebuild self-contained and NativeAOT packages, which embed its runtime." />
  </Target>

  <!-- Generation turns on for a project that references Runic.Application.Views
       directly, or that references a host adapter directly or transitively:
       each adapter's props set _RunicApplicationHostAdapter=true. -->
  <Target Name="RunicViewsDetectBridgeUse" BeforeTargets="PrepareForBuild">
    <ItemGroup>
      <_RunicBridgeDirectPackage Include="@(PackageReference)"
        Condition="'%(PackageReference.Identity)' == 'Runic.Application.Views'" />
    </ItemGroup>
    <!-- A test project that references a Runic application uses that
         application's generated Bridges. A test project is one with
         IsTestProject (which Microsoft.NET.Test.Sdk and TUnit set), or one that
         references Runic.Application.Testing directly, such as a console
         test runner. Unless it declares a Window or View itself or visibly
         expects output, generation stays off there, without RUNICBRIDGE006 or
         RUNICBRIDGE015 and without a bootstrap build. Other projects keep the
         diagnostics. -->
    <ItemGroup>
      <_RunicBridgeTestingReference Include="@(PackageReference)"
        Condition="'%(PackageReference.Identity)' == 'Runic.Application.Testing'" />
      <_RunicBridgeTestingReference Include="@(ProjectReference)"
        Condition="'%(ProjectReference.Filename)' == 'Runic.Application.Testing'" />
    </ItemGroup>
    <PropertyGroup>
      <_RunicBridgeTestProject Condition="('$(IsTestProject)' == 'true' or '@(_RunicBridgeTestingReference)' != '') and '$(RunicApplicationFrontendGenerationEnabled)' == '' and '$(RunicApplicationFrontendModelAssembly)' == '' and '@(RunicApplicationFrontendInput)' == '' and !Exists('$(RunicApplicationFrontendDirectory)/package.json')">true</_RunicBridgeTestProject>
    </PropertyGroup>
    <ItemGroup Condition="'$(_RunicBridgeTestProject)' == 'true'">
      <_RunicBridgeTestViewSource Include="@(Compile)"
        Condition="Exists('%(Compile.FullPath)') and $([System.Text.RegularExpressions.Regex]::IsMatch($([System.IO.File]::ReadAllText('%(Compile.FullPath)')), ':\s*(global::)?(Runic\.Application\.Views\.)?Runic(Window|View)\s*&lt;'))" />
    </ItemGroup>
    <PropertyGroup Condition="'$(_RunicBridgeTestProject)' == 'true' and '@(_RunicBridgeTestViewSource)' == ''">
      <RunicApplicationFrontendGenerationEnabled>false</RunicApplicationFrontendGenerationEnabled>
    </PropertyGroup>
    <!-- Generation that this file turns on by default is optional: a project
         that declares no Window or View (for example one that only uses the
         navigator) builds without bridge output. A project that sets
         RunicApplicationFrontendGenerationEnabled=true, or visibly expects output (a frontend
         package.json, RunicApplicationFrontendInput items, a composition type or a
         model assembly), still gets RUNICBRIDGE006 when it has no Window.
         A WPF application may keep its web Views in a referenced model
         project, so there the adapter's default composition type alone does
         not require them. -->
    <PropertyGroup>
      <_RunicBridgeOptional Condition="'$(RunicApplicationFrontendGenerationEnabled)' == '' and '$(RunicApplicationFrontendClientLibrary)' != 'true' and ('$(RunicApplicationFrontendCompositionType)' == '' or '$(UseWPF)' == 'true') and '$(RunicApplicationFrontendModelAssembly)' == '' and '@(RunicApplicationFrontendInput)' == '' and !Exists('$(RunicApplicationFrontendDirectory)/package.json')">true</_RunicBridgeOptional>
      <_RunicBridgeDefaultedOff Condition="'$(RunicApplicationFrontendGenerationEnabled)' == ''">true</_RunicBridgeDefaultedOff>
      <RunicApplicationFrontendGenerationEnabled Condition="'$(RunicApplicationFrontendGenerationEnabled)' == '' and Exists('$(_RunicBridgeCodegenProject)')">true</RunicApplicationFrontendGenerationEnabled>
      <RunicApplicationFrontendGenerationEnabled Condition="'$(RunicApplicationFrontendGenerationEnabled)' == '' and ('@(_RunicBridgeDirectPackage)' != '' or '$(_RunicApplicationHostAdapter)' == 'true')">true</RunicApplicationFrontendGenerationEnabled>
      <RunicApplicationFrontendGenerationEnabled Condition="'$(RunicApplicationFrontendGenerationEnabled)' == ''">false</RunicApplicationFrontendGenerationEnabled>
      <_RunicBridgeDefaultedOff Condition="'$(RunicApplicationFrontendGenerationEnabled)' != 'false'"></_RunicBridgeDefaultedOff>
    </PropertyGroup>
  </Target>

  <!-- Without generation, a declared Window or View gets no bridge,
       AddRunicViews() or TypeScript client, and the first sign would be a
       CS1061 at the call. When generation is off only by default (no host
       adapter and no direct Runic.Application.Views reference), look for a class
       deriving from RunicWindow<T> or RunicView<T> and say so once. -->
  <Target Name="RunicViewsCheckDisabledGeneration" BeforeTargets="CoreCompile"
          DependsOnTargets="RunicViewsDetectBridgeUse"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(RunicApplicationFrontendBootstrap)' != 'true' and '$(_RunicBridgeMarkupTemporary)' != 'true'">
    <ItemGroup Condition="'$(_RunicBridgeDefaultedOff)' == 'true'">
      <_RunicBridgeViewSource Include="@(Compile)"
        Condition="Exists('%(Compile.FullPath)') and $([System.Text.RegularExpressions.Regex]::IsMatch($([System.IO.File]::ReadAllText('%(Compile.FullPath)')), ':\s*(global::)?(Runic\.Application\.Views\.)?Runic(Window|View)\s*&lt;'))" />
    </ItemGroup>
    <Warning Code="RUNICBRIDGE015" Condition="'@(_RunicBridgeViewSource)' != ''"
             File="$(MSBuildProjectFullPath)" HelpLink="$(_RunicDiagnosticsHelpLinkBase)runicbridge015"
             Text="$(AssemblyName) declares a Runic Window or View (@(_RunicBridgeViewSource->'%(Filename)%(Extension)', ', ')), but Bridge generation is off because the project references no host adapter (Runic.Application.Views.Desktop, Runic.Application.Views.CsWebUi or Runic.Application.Views.Wpf) and not Runic.Application.Views directly. No bridge, AddRunicViews() or TypeScript client is generated. Set RunicApplicationFrontendGenerationEnabled=true to generate them here, or false when another project generates them." />
  </Target>

  <Target Name="RunicViewsDesignTimeComposition" BeforeTargets="CoreCompile"
          DependsOnTargets="_RunicViewsIntermediatePaths;RunicViewsDetectBridgeUse;ResolveAssemblyReferences"
          Condition="'$(RunicApplicationFrontendGenerationEnabled)' == 'true' and '$(DesignTimeBuild)' == 'true' and '$(RunicApplicationFrontendBootstrap)' != 'true'">
    <MSBuild Projects="$(_RunicBridgeCodegenProject)" Targets="Build"
             Properties="Configuration=$(Configuration);TargetFramework=net10.0;RuntimeIdentifier=;PublishAot=false;PublishTrimmed=false;PublishReadyToRun=false;PublishSingleFile=false;IncludeNativeLibrariesForSelfExtract=false;SelfContained=false"
             Condition="Exists('$(_RunicBridgeCodegenProject)') and '$(RunicApplicationFrontendCompositionType)' != ''" />
    <MakeDir Directories="$(_RunicBridgeGeneratedDir)" />
    <WriteLinesToFile File="$(_RunicBridgeGeneratedDir)RunicBridgeComposition.References.txt" Lines="@(ReferencePath)" Overwrite="true" WriteOnlyWhenDifferent="true"
                      Condition="'$(RunicApplicationFrontendCompositionType)' != ''" />
    <Exec Command="dotnet &quot;$(_RunicBridgeCodegenDll)&quot; --composition-stub &quot;$(RunicApplicationFrontendCompositionType)&quot; &quot;$(_RunicBridgeGeneratedDir)RunicBridgeComposition.DesignTime.g.cs&quot; --references &quot;$(_RunicBridgeGeneratedDir)RunicBridgeComposition.References.txt&quot;"
          StandardOutputImportance="normal"
          Condition="'$(RunicApplicationFrontendCompositionType)' != ''" />
    <ItemGroup>
      <Compile Include="$(_RunicBridgeGeneratedDir)*.Bridge.g.cs;$(_RunicBridgeGeneratedDir)*.View.g.cs" />
      <Compile Include="$(_RunicBridgeGeneratedDir)RunicBridgeComposition.DesignTime.g.cs"
               Condition="'$(RunicApplicationFrontendCompositionType)' != '' and Exists('$(_RunicBridgeGeneratedDir)RunicBridgeComposition.DesignTime.g.cs')" />
    </ItemGroup>
  </Target>

  <!-- The bootstrap pass compiles the application before its Bridges exist.
       An empty composition lets Program.cs call AddRunicViews() or
       AddRunicBridges() in that pass, so a starter needs no bootstrap-only
       OutputType or Compile changes. When a reference already declares the
       composition type, as a model project of a 0.7.0-preview.6 WPF app named
       after the application does, calls bind to that type and no stub is
       written (it would make them ambiguous, CS0121). -->
  <Target Name="RunicViewsBootstrapComposition" BeforeTargets="CoreCompile;GenerateTemporaryTargetAssembly"
          DependsOnTargets="_RunicViewsBootstrapCompositionStub"
          Condition="'$(RunicApplicationFrontendBootstrap)' == 'true' and '$(RunicApplicationFrontendCompositionType)' != '' and '$(_RunicBridgeMarkupTemporary)' != 'true'">
    <ItemGroup>
      <Compile Include="$(_RunicBridgeBootstrapComposition)" Condition="Exists('$(_RunicBridgeBootstrapComposition)')" />
    </ItemGroup>
  </Target>

  <!-- The stub depends only on the composition type, the generator and the referenced assemblies, so the generator
       writes it only when one of them changed: an incremental build starts the generator once (for the Bridges), not
       twice (S1). A stub or DeclaredBy marker that is missing writes it again. -->
  <Target Name="_RunicViewsBootstrapCompositionInputs" DependsOnTargets="ResolveAssemblyReferences">
    <PropertyGroup>
      <_RunicBridgeBootstrapComposition>$(IntermediateOutputPath)RunicBridgeComposition.Bootstrap.g.cs</_RunicBridgeBootstrapComposition>
      <_RunicBridgeBootstrapReferences>$(IntermediateOutputPath)RunicBridgeComposition.References.txt</_RunicBridgeBootstrapReferences>
      <_RunicBridgeBootstrapCompositionState>$(IntermediateOutputPath)RunicBridgeComposition.Bootstrap.state</_RunicBridgeBootstrapCompositionState>
      <_RunicBridgeBootstrapCompositionStamp>$(IntermediateOutputPath)RunicBridgeComposition.Bootstrap.stamp</_RunicBridgeBootstrapCompositionStamp>
    </PropertyGroup>
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <WriteLinesToFile File="$(_RunicBridgeBootstrapReferences)" Lines="@(ReferencePath)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <WriteLinesToFile File="$(_RunicBridgeBootstrapCompositionState)" Lines="$(RunicApplicationFrontendCompositionType);$(_RunicBridgeCodegenDll)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <Delete Files="$(_RunicBridgeBootstrapCompositionStamp)"
            Condition="!Exists('$(_RunicBridgeBootstrapComposition)') and !Exists('$(IntermediateOutputPath)RunicBridgeComposition.DeclaredBy.txt')" />
  </Target>

  <Target Name="_RunicViewsBootstrapCompositionStub" DependsOnTargets="_RunicViewsBootstrapCompositionInputs"
          Inputs="@(ReferencePath);$(_RunicBridgeBootstrapReferences);$(_RunicBridgeBootstrapCompositionState);$(_RunicBridgeCodegenDll)"
          Outputs="$(_RunicBridgeBootstrapCompositionStamp)">
    <Exec Command="dotnet &quot;$(_RunicBridgeCodegenDll)&quot; --composition-stub &quot;$(RunicApplicationFrontendCompositionType)&quot; &quot;$(_RunicBridgeBootstrapComposition)&quot; --references &quot;$(_RunicBridgeBootstrapReferences)&quot;"
          StandardOutputImportance="normal" />
    <Touch Files="$(_RunicBridgeBootstrapCompositionStamp)" AlwaysCreate="true" />
  </Target>

  <!-- The generator copies XML documentation comments into the generated
       TypeScript. When the project does not already write a documentation
       file, the bootstrap pass writes one beside the inspected assembly with
       the documentation warnings suppressed, so the real build is unchanged.
       Set RunicApplicationFrontendDocumentationEnabled=false to skip it. -->
  <Target Name="RunicViewsBootstrapDocumentation" BeforeTargets="CoreCompile"
          Condition="'$(RunicApplicationFrontendBootstrap)' == 'true' and '$(_RunicBridgeMarkupTemporary)' != 'true' and '$(RunicApplicationFrontendDocumentationEnabled)' != 'false' and '@(DocFileItem)' == ''">
    <PropertyGroup>
      <NoWarn>$(NoWarn);CS1570;CS1571;CS1572;CS1573;CS1574;CS1580;CS1581;CS1584;CS1587;CS1589;CS1590;CS1591;CS1592;CS1658;CS1710;CS1711;CS1712;CS1723;CS1734;CS1735</NoWarn>
    </PropertyGroup>
    <MakeDir Directories="$(OutDir)" />
    <ItemGroup>
      <DocFileItem Include="$(OutDir)$(AssemblyName).xml" />
      <FileWrites Include="$(OutDir)$(AssemblyName).xml" />
    </ItemGroup>
  </Target>

  <!-- A deterministic build (ContinuousIntegrationBuild, or
       DeterministicSourcePaths) maps source paths in the PDB, for example to
       /_/. The generator reads source through the PDB to recover the comments
       of MVVM partial properties, so pass it the same map as the compiler to
       resolve them back to local files. -->
  <Target Name="RunicViewsBridgePathMap" DependsOnTargets="InitializeSourceRootMappedPaths"
          Condition="'$(SourceRootMappedPathsFeatureSupported)' == 'true'">
    <ItemGroup>
      <_RunicBridgeMappedSourceRoot Include="@(SourceRoot)" Condition="'%(SourceRoot.NestedRoot)' == '' and '%(SourceRoot.MappedPath)' != '' and '%(SourceRoot.MappedPath)' != '%(SourceRoot.Identity)'">
        <EscapedKey>$([MSBuild]::ValueOrDefault('%(Identity)', '').Replace(',', ',,').Replace('=', '=='))</EscapedKey>
        <EscapedValue>$([MSBuild]::ValueOrDefault('%(MappedPath)', '').Replace(',', ',,').Replace('=', '=='))</EscapedValue>
      </_RunicBridgeMappedSourceRoot>
    </ItemGroup>
    <PropertyGroup>
      <_RunicBridgePathMap>@(_RunicBridgeMappedSourceRoot->'%(EscapedKey)=%(EscapedValue)', ',')</_RunicBridgePathMap>
      <_RunicBridgePathMap Condition="'$(PathMap)' != ''">$(_RunicBridgePathMap),$(PathMap)</_RunicBridgePathMap>
      <_RunicBridgePathMapArgument Condition="'$(_RunicBridgePathMap)' != ''">--path-map &quot;$(_RunicBridgePathMap)&quot;</_RunicBridgePathMapArgument>
    </PropertyGroup>
  </Target>

  <!-- In a WPF project this runs before the temporary markup assembly, so
       that assembly can compile the generated code (see
       RunicViewsMarkupTemporaryCompile).

       With NoBuild=true (a publish with the no-build option), NativeAOT still
       schedules CoreCompile, which is then up to date. The build that came
       before generated the code, so this target neither builds the generator
       nor runs the bootstrap pass or the generator (Build would fail with
       NETSDK1085); it only adds the generated sources to Compile, and reports
       RUNICBRIDGE022 when they are missing. -->
  <Target Name="RunicViewsGenerateBridge" BeforeTargets="CoreCompile;GenerateTemporaryTargetAssembly"
          DependsOnTargets="_RunicViewsIntermediatePaths;RunicViewsDetectBridgeUse;ResolveProjectReferences;RunicViewsBridgePathMap"
          Condition="'$(RunicApplicationFrontendGenerationEnabled)' == 'true' and '$(DesignTimeBuild)' != 'true' and '$(RunicApplicationFrontendBootstrap)' != 'true' and '$(_RunicBridgeMarkupTemporary)' != 'true'">
    <PropertyGroup>
      <_RunicBridgeReuseGenerated>false</_RunicBridgeReuseGenerated>
      <_RunicBridgeReuseGenerated Condition="'$(NoBuild)' == 'true'">true</_RunicBridgeReuseGenerated>
    </PropertyGroup>
    <MSBuild Projects="$(_RunicBridgeCodegenProject)" Targets="Build"
             Properties="Configuration=$(Configuration);TargetFramework=net10.0;RuntimeIdentifier=;PublishAot=false;PublishTrimmed=false;PublishReadyToRun=false;PublishSingleFile=false;IncludeNativeLibrariesForSelfExtract=false;SelfContained=false"
             Condition="Exists('$(_RunicBridgeCodegenProject)') and '$(_RunicBridgeReuseGenerated)' != 'true'" />
    <!-- In a one-project starter, first compile the ordinary C# source so MVVM
         source generators have finished before Bridge inspection. Analyzers
         are off in this pass: it only feeds the generator, the real build runs
         them, and the bootstrap's XML documentation file would otherwise
         surface documentation-dependent analyzer warnings. Source generators
         still run. -->
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="Build"
             Properties="RunicApplicationFrontendBootstrap=true;RunAnalyzers=false;RunCodeAnalysis=false;Configuration=$(Configuration);TargetFramework=$(TargetFramework);RuntimeIdentifier=;PublishAot=false;PublishTrimmed=false;PublishReadyToRun=false;PublishSingleFile=false;IncludeNativeLibrariesForSelfExtract=false;SelfContained=false;CopyLocalLockFileAssemblies=true;OutputPath=$(_RunicBridgeBootstrapOutputPath);IntermediateOutputPath=$(_RunicBridgeBootstrapIntermediateOutputPath)"
             Condition="'$(RunicApplicationFrontendModelAssembly)' == '' and '$(_RunicBridgeReuseGenerated)' != 'true'" />
    <PropertyGroup>
      <_RunicBridgeInputAssembly Condition="'$(RunicApplicationFrontendModelAssembly)' == ''">$(_RunicBridgeBootstrapOutputPath)$(AssemblyName).dll</_RunicBridgeInputAssembly>
      <_RunicBridgeInputAssembly Condition="'$(RunicApplicationFrontendModelAssembly)' != ''">$(RunicApplicationFrontendModelAssembly)</_RunicBridgeInputAssembly>
    </PropertyGroup>
    <Error Code="RUNICBRIDGE001" File="$(MSBuildProjectFullPath)" HelpLink="$(_RunicDiagnosticsHelpLinkBase)runicbridge001"
           Condition="!Exists('$(_RunicBridgeCodegenDll)') and '$(_RunicBridgeReuseGenerated)' != 'true'"
           Text="The Runic Bridge code generator was not found at $(_RunicBridgeCodegenDll). Restore the project again; the Runic.Application.Views package may be incomplete." />
    <PropertyGroup>
      <_RunicBridgeOptionalArgument Condition="'$(_RunicBridgeOptional)' == 'true'">--optional</_RunicBridgeOptionalArgument>
      <_RunicBridgeClientLibraryArgument Condition="'$(RunicApplicationFrontendClientLibrary)' == 'true'">--client-library</_RunicBridgeClientLibraryArgument>
      <_RunicBridgeSkipped>false</_RunicBridgeSkipped>
    </PropertyGroup>
    <!-- #1318: the client libraries whose generated TypeScript this application imports (RunicViewsCheckClientModules). -->
    <ItemGroup>
      <_RunicBridgeClientModule Include="@(RunicApplicationFrontendClientModule)" TrimmedSpecifier="$([System.String]::Copy('%(RunicApplicationFrontendClientModule.Specifier)').Trim())" />
    </ItemGroup>
    <PropertyGroup>
      <_RunicBridgeClientModuleArguments>@(_RunicBridgeClientModule->'--client-module &quot;%(Identity)=%(TrimmedSpecifier)&quot;', ' ')</_RunicBridgeClientModuleArguments>
    </PropertyGroup>
    <!-- The generated code calls the command helpers of the Runic ReactiveUI adapter that this project compiles
         against, so that adapter's flavor is the generator's. Package, transitive package and project references
         all resolve to ReferencePath, which ResolveReferences has filled before CoreCompile and before WPF's
         markup passes. Without either adapter the generator reports a ReactiveUI command or interaction as
         RUNICBRIDGE025. -->
    <ItemGroup>
      <_RunicBridgeReactiveUiReactiveAdapter Include="@(ReferencePath)" Condition="'%(Filename)' == 'Runic.Application.Views.ReactiveUI.Reactive'" />
      <_RunicBridgeReactiveUiPrimitivesAdapter Include="@(ReferencePath)" Condition="'%(Filename)' == 'Runic.Application.Views.ReactiveUI'" />
    </ItemGroup>
    <PropertyGroup>
      <_RunicBridgeReactiveUiFlavor>none</_RunicBridgeReactiveUiFlavor>
      <_RunicBridgeReactiveUiFlavor Condition="'@(_RunicBridgeReactiveUiPrimitivesAdapter)' != ''">primitives</_RunicBridgeReactiveUiFlavor>
      <_RunicBridgeReactiveUiFlavor Condition="'@(_RunicBridgeReactiveUiReactiveAdapter)' != ''">reactive</_RunicBridgeReactiveUiFlavor>
      <_RunicBridgeReactiveUiFlavorArgument>--reactiveui-flavor $(_RunicBridgeReactiveUiFlavor)</_RunicBridgeReactiveUiFlavorArgument>
    </PropertyGroup>
    <!-- The shared frameworks the application uses, directly or through a
         package (Runic.Desktop.Kestrel references Microsoft.AspNetCore.App). The
         generator runs on Microsoft.NETCore.App and loads the application's
         assemblies from these frameworks; it never loads
         Microsoft.WindowsDesktop.App, whose types it skips on every OS. -->
    <ItemGroup>
      <_RunicBridgeSharedFramework Include="@(FrameworkReference->Distinct())" Exclude="Microsoft.NETCore.App" />
    </ItemGroup>
    <PropertyGroup>
      <_RunicBridgeFrameworkArgument>@(_RunicBridgeSharedFramework->'--framework &quot;%(Identity)&quot;', ' ')</_RunicBridgeFrameworkArgument>
    </PropertyGroup>
    <!-- The warnings that the RUNICBRIDGE analyzer reports (BridgeDiagnosticCodes.AnalyzerWarnings): when this compile
         runs it on the project's own source, the generator leaves them to it, so each is reported once, by the
         compiler, and #pragma warning disable, .editorconfig severities, NoWarn and TreatWarningsAsErrors apply as to
         any compiler warning. The generator keeps them when analyzers are off: RunAnalyzers, RunAnalyzersDuringBuild, or
         an implicitly triggered Visual Studio build, the conditions of Roslyn's _ComputeSkipAnalyzers (which runs
         just before CoreCompile, after this target), and for a model assembly
         (RunicApplicationFrontendModelAssembly), whose source the analyzer does not see, and when an error stops the
         build before the compiler. -->
    <ItemGroup>
      <_RunicBridgeShapeAnalyzer Include="@(Analyzer)" Condition="'%(Filename)' == 'Runic.Application.Views.Analyzers'" />
    </ItemGroup>
    <PropertyGroup>
      <_RunicBridgeAnalyzersSkipped>false</_RunicBridgeAnalyzersSkipped>
      <_RunicBridgeAnalyzersSkipped Condition="'$(RunAnalyzers)' == 'false' or ('$(RunAnalyzers)' == '' and '$(RunAnalyzersDuringBuild)' == 'false')">true</_RunicBridgeAnalyzersSkipped>
      <_RunicBridgeAnalyzersSkipped Condition="'$(IsImplicitlyTriggeredBuild)' == 'true' and '$(UsingMicrosoftNETSdk)' == 'true' and '$(OptimizeImplicitlyTriggeredBuild)' != 'false' and ('$(TreatWarningsAsErrors)' != 'true' or '$(OptimizeImplicitlyTriggeredBuild)' == 'true')">true</_RunicBridgeAnalyzersSkipped>
      <_RunicBridgeAnalyzerWarningsArgument></_RunicBridgeAnalyzerWarningsArgument>
      <_RunicBridgeAnalyzerWarningsArgument Condition="'@(_RunicBridgeShapeAnalyzer)' != '' and '$(_RunicBridgeAnalyzersSkipped)' != 'true' and '$(RunicApplicationFrontendModelAssembly)' == ''">--analyzer-warnings</_RunicBridgeAnalyzerWarningsArgument>
    </PropertyGroup>
    <Delete Files="$(_RunicBridgeGeneratedDir)$(_RunicBridgeNoViewsMarker)" Condition="'$(_RunicBridgeReuseGenerated)' != 'true'" />
    <!-- The generator reports its diagnostics in canonical form. They are
         logged once with their codes (see RunicViewsReportCommandResult);
         a failure that reported none is RUNICBRIDGE024, an internal error. -->
    <Exec Command="dotnet &quot;$(_RunicBridgeCodegenDll)&quot; --generate &quot;$(_RunicBridgeInputAssembly)&quot; &quot;$(_RunicBridgeGeneratedDir)&quot; $(_RunicBridgeAotArgument) $(_RunicBridgeCompositionArgument) $(_RunicBridgeReactiveUiFlavorArgument) $(_RunicBridgeOptionalArgument) $(_RunicBridgeClientLibraryArgument) $(_RunicBridgeClientModuleArguments) $(_RunicBridgeAnalyzerWarningsArgument) $(_RunicBridgePathMapArgument) $(_RunicBridgeFrameworkArgument)"
          ConsoleToMSBuild="true" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true"
          Condition="'$(_RunicBridgeReuseGenerated)' != 'true'">
      <Output TaskParameter="ExitCode" PropertyName="_RunicBridgeCodegenExitCode" />
      <Output TaskParameter="ConsoleOutput" ItemName="_RunicBridgeCodegenOutputLine" />
    </Exec>
    <PropertyGroup>
      <_RunicBridgeCodegenDiagnostics Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(_RunicBridgeCodegenOutputLine.Identity)', '$(_RunicBridgeCanonicalDiagnostic)'))">true</_RunicBridgeCodegenDiagnostics>
    </PropertyGroup>
    <RunicViewsReportCommandResult Condition="'$(_RunicBridgeReuseGenerated)' != 'true' and ('$(_RunicBridgeCodegenExitCode)' != '0' or '$(_RunicBridgeCodegenDiagnostics)' == 'true')"
        Lines="@(_RunicBridgeCodegenOutputLine)" ExitCode="$(_RunicBridgeCodegenExitCode)"
        FailureCode="RUNICBRIDGE024" FailureFile="$(MSBuildProjectFullPath)"
        FailureText="The Runic Bridge generator exited with code $(_RunicBridgeCodegenExitCode) without reporting an error while inspecting $(_RunicBridgeInputAssembly), an internal generator error. Its output is above; include it when you report the problem." />
    <PropertyGroup>
      <_RunicBridgeSkipped Condition="Exists('$(_RunicBridgeGeneratedDir)$(_RunicBridgeNoViewsMarker)')">true</_RunicBridgeSkipped>
    </PropertyGroup>
    <ItemGroup Condition="'$(_RunicBridgeReuseGenerated)' == 'true' and '$(_RunicBridgeSkipped)' != 'true'">
      <_RunicBridgeGeneratedSource Include="$(_RunicBridgeGeneratedDir)*.Bridge.g.cs;$(_RunicBridgeGeneratedDir)*.View.g.cs" />
    </ItemGroup>
    <Error Code="RUNICBRIDGE022" File="$(MSBuildProjectFullPath)" HelpLink="$(_RunicDiagnosticsHelpLinkBase)runicbridge022"
           Condition="'$(_RunicBridgeReuseGenerated)' == 'true' and '$(_RunicBridgeSkipped)' != 'true' and ('@(_RunicBridgeGeneratedSource)' == '' or ('$(RunicApplicationFrontendCompositionType)' != '' and !Exists('$(_RunicBridgeGeneratedDir)RunicBridgeComposition.g.cs')))"
           Text="$(AssemblyName) is built with NoBuild=true, as by dotnet publish --no-build, but $([System.IO.Path]::GetFullPath('$(_RunicBridgeGeneratedDir)')) has no Runic Bridge code from an earlier build, and NoBuild does not run the generator. Build the project with the same Configuration, TargetFramework, RuntimeIdentifier and PublishAot first, or publish without --no-build." />
    <Message Importance="normal" Condition="'$(_RunicBridgeSkipped)' == 'true'"
             Text="Runic Bridge: $(AssemblyName) declares no Runic Window or View, so no bridge code or frontend build is generated. Set RunicApplicationFrontendGenerationEnabled=true to require them, or false to skip the bootstrap build entirely." />
    <ItemGroup Condition="'$(_RunicBridgeSkipped)' == 'true'">
      <FileWrites Include="$(_RunicBridgeGeneratedDir)$(_RunicBridgeNoViewsMarker)" />
    </ItemGroup>
    <!-- The bootstrap pass found the composition type in a reference (see
         RunicViewsBootstrapComposition). A second composition of that name
         here would make AddRunicViews() ambiguous. -->
    <PropertyGroup>
      <_RunicBridgeCompositionDeclaredByMarker>$(_RunicBridgeBootstrapIntermediateOutputPath)RunicBridgeComposition.DeclaredBy.txt</_RunicBridgeCompositionDeclaredByMarker>
      <_RunicBridgeCompositionDeclaredBy Condition="'$(RunicApplicationFrontendModelAssembly)' == '' and Exists('$(_RunicBridgeCompositionDeclaredByMarker)')">$([System.IO.File]::ReadAllText('$(_RunicBridgeCompositionDeclaredByMarker)').Trim())</_RunicBridgeCompositionDeclaredBy>
    </PropertyGroup>
    <Error Code="RUNICBRIDGE018" File="$(MSBuildProjectFullPath)" HelpLink="$(_RunicDiagnosticsHelpLinkBase)runicbridge018"
           Condition="'$(RunicApplicationFrontendCompositionType)' != '' and '$(_RunicBridgeSkipped)' != 'true' and '$(_RunicBridgeCompositionDeclaredBy)' != ''"
           Text="$(AssemblyName) declares Runic Views and generates the composition $(RunicApplicationFrontendCompositionType), but the referenced assembly $(_RunicBridgeCompositionDeclaredBy) already declares that type, so AddRunicViews() would be ambiguous. Set RunicApplicationFrontendCompositionType to another type name in $(MSBuildProjectFile) or in the project that builds $(_RunicBridgeCompositionDeclaredBy)." />
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(_RunicBridgeGeneratedDirRecord)'))" Condition="'$(UseWPF)' == 'true'" />
    <WriteLinesToFile File="$(_RunicBridgeGeneratedDirRecord)" Lines="$(_RunicBridgeGeneratedDir)" Overwrite="true" WriteOnlyWhenDifferent="true"
                      Condition="'$(UseWPF)' == 'true'" />
    <ItemGroup>
      <Compile Include="$(_RunicBridgeGeneratedDir)*.Bridge.g.cs;$(_RunicBridgeGeneratedDir)*.View.g.cs" />
      <Compile Include="$(_RunicBridgeGeneratedDir)RunicBridgeComposition.g.cs" Condition="'$(RunicApplicationFrontendCompositionType)' != '' and '$(_RunicBridgeSkipped)' != 'true'" />
      <!-- The library-mode marker, [assembly: AssemblyMetadata("Runic.Application.Views.ClientLibrary", "1")]. -->
      <Compile Include="$(_RunicBridgeGeneratedDir)RunicClientLibrary.g.cs" Condition="'$(RunicApplicationFrontendClientLibrary)' == 'true' and '$(_RunicBridgeSkipped)' != 'true'" />
    </ItemGroup>
  </Target>

  <!-- R7 G6 (D080.5): the TypeScript clients. After the generator has written the contract IR
       (obj/<configuration>/<framework>/runic-bridge/contract.ir.json), Node.js or Bun runs the Views TypeScript emitter,
       @runic-artifex/views/codegen, through runic-views-codegen.mjs. The emitter is the frontend's when it has
       @runic-artifex/views installed, resolved from RunicApplicationFrontendDirectory like an import, so the clients
       match the runtime they import; so the frontend is installed first (RunicViewsInstallFrontend). Otherwise it is the
       copy bundled with this package, version-locked to the generator: without a frontend (no package.json there), as
       for a library or a test project, when the frontend's package.json declares no @runic-artifex/views, and when the
       build does not build the frontend (RunicApplicationFrontendBuildEnabled=false). A frontend that declares it without
       having it installed is RUNICBRIDGE084.

       The runtime is RunicApplicationFrontendCodegenRuntime when set (a command or path, such as node or bun), else the
       first of node and bun on PATH, bun first when the frontend's package manager is bun. Neither is RUNICBRIDGE084.

       The emitter runs when the IR, the emitter, the frontend's package.json or lock file, or the generation settings
       changed, or when a client it wrote is missing or was changed since (runic-bridge/typescript.outputs records each
       file's SHA-256). It rewrites only the files whose content changed, so a C#-only edit does not rebuild the frontend,
       and removes the generated files it no longer writes. Its errors (RUNICBRIDGE004, 036, 071) are reported at the C#
       member that the IR's sources locate. Without Views, the clients it wrote are removed. -->
  <Target Name="RunicViewsGenerateClients" AfterTargets="RunicViewsGenerateBridge"
          DependsOnTargets="_RunicViewsClientsPaths;_RunicViewsRemoveClients;_RunicViewsEmitClients"
          Condition="'$(RunicApplicationFrontendGenerationEnabled)' == 'true' and '$(DesignTimeBuild)' != 'true' and '$(RunicApplicationFrontendBootstrap)' != 'true' and '$(_RunicBridgeMarkupTemporary)' != 'true' and '$(_RunicBridgeReuseGenerated)' != 'true'" />

  <Target Name="_RunicViewsClientsPaths" DependsOnTargets="_RunicViewsIntermediatePaths">
    <PropertyGroup>
      <_RunicViewsClientsDirectory>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(RunicApplicationFrontendGeneratedDirectory)').TrimEnd('/').TrimEnd('\'))</_RunicViewsClientsDirectory>
      <_RunicViewsFrontendDirectory>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(RunicApplicationFrontendDirectory)').TrimEnd('/').TrimEnd('\'))</_RunicViewsFrontendDirectory>
      <_RunicViewsContractIr>$(_RunicBridgeGeneratedDir)contract.ir.json</_RunicViewsContractIr>
      <_RunicViewsClientsOutputs>$(_RunicBridgeGeneratedDir)typescript.outputs</_RunicViewsClientsOutputs>
      <_RunicViewsClientsEmitter>$(_RunicBridgeGeneratedDir)typescript.emitter</_RunicViewsClientsEmitter>
      <_RunicViewsClientsState>$(_RunicBridgeGeneratedDir)typescript.state</_RunicViewsClientsState>
      <_RunicViewsClientsStamp>$(_RunicBridgeGeneratedDir)typescript.stamp</_RunicViewsClientsStamp>
    </PropertyGroup>
    <ItemGroup>
      <!-- Registered on every build so IncrementalClean keeps them when the emitter is up to date. -->
      <FileWrites Include="$(_RunicViewsClientsOutputs);$(_RunicViewsClientsEmitter);$(_RunicViewsClientsState);$(_RunicViewsClientsStamp)" />
    </ItemGroup>
  </Target>

  <!-- The files the emitter wrote, with the SHA-256 it wrote them with, and the ones missing or changed since. -->
  <Target Name="_RunicViewsRecordedClients" DependsOnTargets="_RunicViewsClientsPaths">
    <ReadLinesFromFile File="$(_RunicViewsClientsOutputs)" Condition="Exists('$(_RunicViewsClientsOutputs)')">
      <Output TaskParameter="Lines" ItemName="_RunicViewsClientsRecord" />
    </ReadLinesFromFile>
    <ItemGroup Condition="'@(_RunicViewsClientsRecord)' != ''">
      <_RunicViewsClientsWritten Include="$([System.String]::Copy('%(_RunicViewsClientsRecord.Identity)').Substring(65))"
          RecordedHash="$([System.String]::Copy('%(_RunicViewsClientsRecord.Identity)').Substring(0, 64))" />
    </ItemGroup>
    <ItemGroup>
      <_RunicViewsClientsMissing Include="@(_RunicViewsClientsWritten)" Condition="!Exists('%(Identity)')" />
      <_RunicViewsClientsPresent Include="@(_RunicViewsClientsWritten)" Condition="Exists('%(Identity)')" />
    </ItemGroup>
    <!-- GetFileHash's default algorithm is the launcher's, SHA-256. -->
    <GetFileHash Files="@(_RunicViewsClientsPresent)" HashEncoding="hex" Condition="'@(_RunicViewsClientsPresent)' != ''">
      <Output TaskParameter="Items" ItemName="_RunicViewsClientsHashed" />
    </GetFileHash>
    <ItemGroup>
      <!-- MSBuild compares strings without case, so the hex digits' case does not matter. -->
      <_RunicViewsClientsChanged Include="@(_RunicViewsClientsHashed)" Condition="'%(FileHash)' != '%(RecordedHash)'" />
      <_RunicViewsClientsUnchanged Include="@(_RunicViewsClientsHashed)" Condition="'%(FileHash)' == '%(RecordedHash)'" />
    </ItemGroup>
  </Target>

  <!-- A project without Views (the generator's no-Views marker) removes the clients the emitter wrote before, unless
       they were changed since. -->
  <Target Name="_RunicViewsRemoveClients" DependsOnTargets="_RunicViewsRecordedClients" Condition="'$(_RunicBridgeSkipped)' == 'true'">
    <Delete Files="@(_RunicViewsClientsUnchanged);$(_RunicViewsClientsOutputs);$(_RunicViewsClientsEmitter);$(_RunicViewsClientsStamp)" />
  </Target>

  <Target Name="_RunicViewsClientsInputs" DependsOnTargets="_RunicViewsRecordedClients;RunicViewsInstallFrontend;RunicViewsLinkFrontendNodeModules"
          Condition="'$(_RunicBridgeSkipped)' != 'true'">
    <PropertyGroup>
      <_RunicViewsFrontendUnbuiltArgument Condition="'$(RunicApplicationFrontendBuildEnabled)' == 'false'">--frontend-unbuilt</_RunicViewsFrontendUnbuiltArgument>
      <_RunicViewsUsedEmitter Condition="Exists('$(_RunicViewsClientsEmitter)')">$([System.IO.File]::ReadAllText('$(_RunicViewsClientsEmitter)').Trim())</_RunicViewsUsedEmitter>
    </PropertyGroup>
    <!-- What the clients depend on besides the IR and the emitter; a change regenerates them. -->
    <WriteLinesToFile File="$(_RunicViewsClientsState)" Overwrite="true" WriteOnlyWhenDifferent="true"
        Lines="out=$(_RunicViewsClientsDirectory);frontend=$(_RunicViewsFrontendDirectory);unbuilt=$(_RunicViewsFrontendUnbuiltArgument);runtime=$(RunicApplicationFrontendCodegenRuntime);launcher=$(_RunicViewsCodegenLauncher);bundled=$(_RunicViewsBundledEmitter)" />
    <ItemGroup>
      <_RunicViewsClientsInput Include="$(_RunicViewsContractIr);$(_RunicViewsClientsState);$(_RunicViewsCodegenLauncher)" />
      <_RunicViewsClientsInput Include="$(_RunicViewsUsedEmitter)" Condition="'$(_RunicViewsUsedEmitter)' != '' and Exists('$(_RunicViewsUsedEmitter)')" />
      <_RunicViewsClientsInput Include="$(_RunicViewsFrontendDirectory)/package.json" Condition="Exists('$(_RunicViewsFrontendDirectory)/package.json')" />
      <_RunicViewsClientsInput Include="$(_RunicViewsFrontendDirectory)/%(_RunicBridgeFrontendLockFile.Identity)"
          Condition="Exists('$(_RunicViewsFrontendDirectory)/%(_RunicBridgeFrontendLockFile.Identity)')" />
    </ItemGroup>
    <Delete Files="$(_RunicViewsClientsStamp)"
        Condition="Exists('$(_RunicViewsClientsStamp)') and (!Exists('$(_RunicViewsClientsOutputs)') or '@(_RunicViewsClientsMissing)' != '' or '@(_RunicViewsClientsChanged)' != '')" />
  </Target>

  <!-- Runs when the generator wrote the IR: it writes one, or the no-Views marker, after every successful run. -->
  <Target Name="_RunicViewsEmitClients" DependsOnTargets="_RunicViewsClientsInputs"
          Inputs="@(_RunicViewsClientsInput)" Outputs="$(_RunicViewsClientsStamp)"
          Condition="'$(_RunicBridgeSkipped)' != 'true' and Exists('$(_RunicViewsContractIr)')">
    <PropertyGroup>
      <_RunicViewsCodegenFirst>node</_RunicViewsCodegenFirst>
      <_RunicViewsCodegenSecond>bun</_RunicViewsCodegenSecond>
      <_RunicViewsCodegenFirst Condition="'$(RunicApplicationFrontendPackageManager)' == 'bun'">bun</_RunicViewsCodegenFirst>
      <_RunicViewsCodegenSecond Condition="'$(RunicApplicationFrontendPackageManager)' == 'bun'">node</_RunicViewsCodegenSecond>
      <_RunicViewsCodegenFirst Condition="'$(RunicApplicationFrontendCodegenRuntime)' != ''">$(RunicApplicationFrontendCodegenRuntime)</_RunicViewsCodegenFirst>
      <_RunicViewsCodegenSecond Condition="'$(RunicApplicationFrontendCodegenRuntime)' != ''"></_RunicViewsCodegenSecond>
      <_RunicViewsCodegenRuntime></_RunicViewsCodegenRuntime>
    </PropertyGroup>
    <Exec Command="&quot;$(_RunicViewsCodegenFirst)&quot; --version" EchoOff="true" StandardOutputImportance="low" StandardErrorImportance="low"
          IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" PropertyName="_RunicViewsCodegenFirstExitCode" />
    </Exec>
    <Exec Command="&quot;$(_RunicViewsCodegenSecond)&quot; --version" EchoOff="true" StandardOutputImportance="low" StandardErrorImportance="low"
          IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true"
          Condition="'$(_RunicViewsCodegenFirstExitCode)' != '0' and '$(_RunicViewsCodegenSecond)' != ''">
      <Output TaskParameter="ExitCode" PropertyName="_RunicViewsCodegenSecondExitCode" />
    </Exec>
    <PropertyGroup>
      <_RunicViewsCodegenRuntime Condition="'$(_RunicViewsCodegenFirstExitCode)' == '0'">$(_RunicViewsCodegenFirst)</_RunicViewsCodegenRuntime>
      <_RunicViewsCodegenRuntime Condition="'$(_RunicViewsCodegenRuntime)' == '' and '$(_RunicViewsCodegenSecondExitCode)' == '0'">$(_RunicViewsCodegenSecond)</_RunicViewsCodegenRuntime>
    </PropertyGroup>
    <Error Code="RUNICBRIDGE084" File="$(MSBuildProjectFullPath)" HelpLink="$(_RunicDiagnosticsHelpLinkBase)runicbridge084"
           Condition="'$(_RunicViewsCodegenRuntime)' == '' and '$(RunicApplicationFrontendCodegenRuntime)' != ''"
           Text="RunicApplicationFrontendCodegenRuntime is '$(RunicApplicationFrontendCodegenRuntime)', which does not run ('$(RunicApplicationFrontendCodegenRuntime) --version' failed). $(AssemblyName) declares Runic Views, and Node.js or Bun runs the TypeScript emitter that generates their clients. Set it to a Node.js or Bun executable, or remove it to use node or bun from PATH." />
    <Error Code="RUNICBRIDGE084" File="$(MSBuildProjectFullPath)" HelpLink="$(_RunicDiagnosticsHelpLinkBase)runicbridge084"
           Condition="'$(_RunicViewsCodegenRuntime)' == '' and '$(RunicApplicationFrontendCodegenRuntime)' == ''"
           Text="$(AssemblyName) declares Runic Views, whose TypeScript clients the Views emitter (@runic-artifex/views/codegen) generates with Node.js or Bun, but neither node nor bun is on PATH. Install Node.js or Bun, set RunicApplicationFrontendCodegenRuntime to one of them, or set RunicApplicationFrontendGenerationEnabled=false when another project generates the Bridges." />
    <PropertyGroup>
      <_RunicViewsSymbolsArgument Condition="Exists('$(_RunicBridgeGeneratedDir)client-symbols.json')">--symbols &quot;$(_RunicBridgeGeneratedDir)client-symbols.json&quot;</_RunicViewsSymbolsArgument>
    </PropertyGroup>
    <Exec Command="&quot;$(_RunicViewsCodegenRuntime)&quot; &quot;$(_RunicViewsCodegenLauncher)&quot; --ir &quot;$(_RunicViewsContractIr)&quot; --out &quot;$(_RunicViewsClientsDirectory)&quot; --outputs &quot;$(_RunicViewsClientsOutputs)&quot; --used-emitter &quot;$(_RunicViewsClientsEmitter)&quot; --frontend &quot;$(_RunicViewsFrontendDirectory)&quot; $(_RunicViewsFrontendUnbuiltArgument) --bundled &quot;$(_RunicViewsBundledEmitter)&quot; $(_RunicViewsSymbolsArgument) --help-link-base &quot;$(_RunicDiagnosticsHelpLinkBase)&quot;"
          ConsoleToMSBuild="true" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true" StandardOutputImportance="normal">
      <Output TaskParameter="ExitCode" PropertyName="_RunicViewsEmitterExitCode" />
      <Output TaskParameter="ConsoleOutput" ItemName="_RunicViewsEmitterOutputLine" />
    </Exec>
    <PropertyGroup>
      <_RunicViewsEmitterDiagnostics Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(_RunicViewsEmitterOutputLine.Identity)', '$(_RunicBridgeCanonicalDiagnostic)'))">true</_RunicViewsEmitterDiagnostics>
    </PropertyGroup>
    <RunicViewsReportCommandResult Condition="'$(_RunicViewsEmitterExitCode)' != '0' or '$(_RunicViewsEmitterDiagnostics)' == 'true'"
        Lines="@(_RunicViewsEmitterOutputLine)" ExitCode="$(_RunicViewsEmitterExitCode)"
        FailureCode="RUNICBRIDGE024" FailureFile="$(MSBuildProjectFullPath)"
        FailureText="The Runic Views TypeScript emitter exited with code $(_RunicViewsEmitterExitCode) without reporting an error while generating the clients of $(AssemblyName), an internal error. Its output is above; include it when you report the problem." />
    <!-- The launcher records what it wrote; a run that exits without the record wrote no clients. -->
    <Error Code="RUNICBRIDGE024" File="$(MSBuildProjectFullPath)" HelpLink="$(_RunicDiagnosticsHelpLinkBase)runicbridge024"
           Condition="'$(_RunicViewsEmitterExitCode)' == '0' and !Exists('$(_RunicViewsClientsOutputs)')"
           Text="The Runic Views TypeScript emitter exited without writing the clients of $(AssemblyName) or its record $(_RunicViewsClientsOutputs), an internal error. Its output is above; include it when you report the problem." />
    <Touch Files="$(_RunicViewsClientsStamp)" AlwaysCreate="true" Condition="'$(_RunicViewsEmitterExitCode)' == '0'" />
  </Target>

  <!-- WPF's temporary markup project is a copy of the project file, so it
       sees none of the Compile items added above. Compile the code that the
       real project (or its bootstrap pass) has just generated, so that
       code-behind calling AddRunicViews() or a generated View member
       resolves in that assembly too. -->
  <Target Name="RunicViewsMarkupTemporaryCompile" BeforeTargets="CoreCompile"
          DependsOnTargets="_RunicViewsIntermediatePaths;RunicViewsDetectBridgeUse"
          Condition="'$(_RunicBridgeMarkupTemporary)' == 'true' and '$(RunicApplicationFrontendGenerationEnabled)' != 'false' and '$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_RunicBridgeBootstrapComposition>$(IntermediateOutputPath)RunicBridgeComposition.Bootstrap.g.cs</_RunicBridgeBootstrapComposition>
    </PropertyGroup>
    <ItemGroup Condition="'$(RunicApplicationFrontendBootstrap)' == 'true' and '$(RunicApplicationFrontendCompositionType)' != ''">
      <Compile Include="$(_RunicBridgeBootstrapComposition)" Condition="Exists('$(_RunicBridgeBootstrapComposition)')" />
    </ItemGroup>
    <ItemGroup Condition="'$(RunicApplicationFrontendBootstrap)' != 'true' and !Exists('$(_RunicBridgeGeneratedDir)$(_RunicBridgeNoViewsMarker)')">
      <Compile Include="$(_RunicBridgeGeneratedDir)*.Bridge.g.cs;$(_RunicBridgeGeneratedDir)*.View.g.cs" />
      <Compile Include="$(_RunicBridgeGeneratedDir)RunicBridgeComposition.g.cs"
               Condition="'$(RunicApplicationFrontendCompositionType)' != '' and Exists('$(_RunicBridgeGeneratedDir)RunicBridgeComposition.g.cs')" />
    </ItemGroup>
  </Target>

  <!-- RunicApplicationHost names the host the application runs on. Each host
       adapter's targets add their name (desktop or cswebui) to
       _RunicApplicationHostNames and copy their Views client to
       www/runic-views.js when RunicApplicationHost names them, or when they
       are the only host referenced, so a page that loads runic-views.js runs
       on every host from one build. A project that references several hosts
       chooses one with RunicApplicationHost (RUNICBRIDGE019 otherwise). The
       frontend build receives the host as RUNIC_APPLICATION_HOST, and a
       change rebuilds the frontend. -->
  <Target Name="RunicViewsResolveHost" BeforeTargets="PrepareForBuild;Publish"
          Condition="'$(RunicApplicationFrontendBootstrap)' != 'true' and '$(_RunicBridgeMarkupTemporary)' != 'true'">
    <ItemGroup>
      <_RunicApplicationHostNameEntry Include="$(_RunicApplicationHostNames)" />
      <_RunicApplicationHostName Include="@(_RunicApplicationHostNameEntry->Distinct())" />
      <_RunicApplicationHostRequestedName Include="@(_RunicApplicationHostName)" Condition="'%(Identity)' == '$(RunicApplicationHost)'" />
    </ItemGroup>
    <PropertyGroup>
      <_RunicApplicationHostRequested>$(RunicApplicationHost)</_RunicApplicationHostRequested>
      <RunicApplicationHost Condition="'$(RunicApplicationHost)' == '' and '@(_RunicApplicationHostName->Count())' == '1'">@(_RunicApplicationHostName)</RunicApplicationHost>
      <_RunicApplicationHostApplication Condition="'$(DesignTimeBuild)' != 'true' and '$(OutputType)' != 'Library' and '$(IsTestProject)' != 'true'">true</_RunicApplicationHostApplication>
      <_RunicApplicationHostAmbiguous Condition="'$(_RunicApplicationHostApplication)' == 'true' and '$(_RunicApplicationHostRequested)' == '' and '@(_RunicApplicationHostName->Count())' != '0' and '@(_RunicApplicationHostName->Count())' != '1'">true</_RunicApplicationHostAmbiguous>
      <_RunicApplicationHostNamesText>@(_RunicApplicationHostName, ', ')</_RunicApplicationHostNamesText>
    </PropertyGroup>
    <!-- Several hosts without a choice warn only when a copied page loads
         runic-views.js (RunicViewsMirrorFrontend): a page that loads a host's
         own client chooses its host at run time. -->
    <Warning Code="RUNICBRIDGE019" File="$(MSBuildProjectFullPath)" HelpLink="$(_RunicDiagnosticsHelpLinkBase)runicbridge019"
             Condition="'$(_RunicApplicationHostApplication)' == 'true' and '$(_RunicApplicationHostRequested)' != '' and '@(_RunicApplicationHostRequestedName)' == '' and '@(_RunicApplicationHostName)' != ''"
             Text="RunicApplicationHost is '$(_RunicApplicationHostRequested)', but $(AssemblyName) references no such Runic host, so the build copies no www/runic-views.js. Set it to one of the referenced hosts: @(_RunicApplicationHostName, ', ')." />
  </Target>

  <!-- I-027: RunicApplicationFrontendDelivery=Embedded composes the tree that Files copies to www/ (the frontends of
       referenced projects, this project's frontend output and the host's Views client) in
       $(IntermediateOutputPath)runic-www/ and lets Runic.Assets pack it into the assembly as RunicAssetsDist, with
       the Runic.Application.FrontendArchive runtime option naming the resource; the build and publish output get
       no www/. It needs one Runic host that serves the archive: Runic Desktop or, since 0.15, CS-WebUI (#726).
       RUNICBRIDGE030 reports an unknown value, no single such host, and a project that sets RunicAssetsDist or
       RunicAssetsEmbeddedArchive itself; the build then continues as Files. A build that does not copy the
       frontend (RunicApplicationFrontendCopyEnabled=false, as dotnet runic dev's development server sets it) is
       Files too. -->
  <Target Name="RunicViewsResolveFrontendDelivery" BeforeTargets="PrepareForBuild;Publish" DependsOnTargets="RunicViewsResolveHost"
          Condition="'$(RunicApplicationFrontendBootstrap)' != 'true' and '$(_RunicBridgeMarkupTemporary)' != 'true' and '$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_RunicApplicationFrontendDeliveryValue>$(RunicApplicationFrontendDelivery.Trim())</_RunicApplicationFrontendDeliveryValue>
      <_RunicApplicationFrontendEmbeddedRequested Condition="'$(_RunicApplicationFrontendDeliveryValue)' == 'Embedded' and '$(OutputType)' != 'Library'">true</_RunicApplicationFrontendEmbeddedRequested>
      <_RunicApplicationFrontendDeliveryProblem Condition="'$(_RunicApplicationFrontendDeliveryValue)' != 'Files' and '$(_RunicApplicationFrontendDeliveryValue)' != 'Embedded'">RunicApplicationFrontendDelivery is '$(RunicApplicationFrontendDelivery)', which is not Files or Embedded</_RunicApplicationFrontendDeliveryProblem>
      <_RunicApplicationFrontendDeliveryProblem Condition="'$(_RunicApplicationFrontendEmbeddedRequested)' == 'true' and '$(_RunicApplicationFrontendDeliveryProblem)' == '' and '$(RunicApplicationHost)' != 'desktop' and '$(RunicApplicationHost)' != 'cswebui'">RunicApplicationFrontendDelivery is Embedded, but $(AssemblyName) runs on neither the Runic Desktop host (Runic.Application.Views.Desktop) nor the CS-WebUI host (Runic.Application.Views.CsWebUi); set RunicApplicationHost to desktop or cswebui when it references several hosts</_RunicApplicationFrontendDeliveryProblem>
      <_RunicApplicationFrontendDeliveryProblem Condition="'$(_RunicApplicationFrontendEmbeddedRequested)' == 'true' and '$(_RunicApplicationFrontendDeliveryProblem)' == '' and ('$(RunicAssetsDist)' != '' or '$(RunicAssetsEmbeddedArchive)' != '')">RunicApplicationFrontendDelivery is Embedded, but $(MSBuildProjectFile) sets RunicAssetsDist or RunicAssetsEmbeddedArchive itself</_RunicApplicationFrontendDeliveryProblem>
      <_RunicApplicationFrontendEmbedded Condition="'$(_RunicApplicationFrontendEmbeddedRequested)' == 'true' and '$(_RunicApplicationFrontendDeliveryProblem)' == '' and '$(RunicApplicationFrontendCopyEnabled)' != 'false'">true</_RunicApplicationFrontendEmbedded>
    </PropertyGroup>
    <Warning Code="RUNICBRIDGE030" File="$(MSBuildProjectFullPath)" HelpLink="$(_RunicDiagnosticsHelpLinkBase)runicbridge030"
             Condition="'$(_RunicApplicationFrontendDeliveryProblem)' != ''"
             Text="$(_RunicApplicationFrontendDeliveryProblem), so the build copies the frontend to $(_RunicApplicationFrontendWebRoot)/ (Files). Use Embedded only with the Runic Desktop or CS-WebUI host and without RunicAssetsDist or RunicAssetsEmbeddedArchive in the project." />
    <PropertyGroup Condition="'$(_RunicApplicationFrontendEmbedded)' == 'true'">
      <_RunicApplicationFrontendEmbeddedRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'runic-www'))</_RunicApplicationFrontendEmbeddedRoot>
      <RunicAssetsDist>$(_RunicApplicationFrontendEmbeddedRoot)</RunicAssetsDist>
      <_RunicAssetsDistStaged>true</_RunicAssetsDistStaged>
    </PropertyGroup>
    <ItemGroup Condition="'$(_RunicApplicationFrontendEmbedded)' == 'true'">
      <RuntimeHostConfigurationOption Include="Runic.Application.FrontendArchive" Value="$(RunicAssetsEmbeddedResourceName)" />
    </ItemGroup>
  </Target>

  <!-- Composes the embedded tree after the frontend build, as the www/ copies below would: the frontends of
       referenced projects, then this project's output, then the host's Views client. The directory is owned by the
       build, so files that no frontend has any more are deleted. -->
  <Target Name="RunicViewsStageEmbeddedFrontend"
          DependsOnTargets="RunicViewsResolveFrontendDelivery;$(_RunicViewsEmbeddedFrontendBuildTargets);$(_RunicApplicationHostStageTargets)"
          Condition="'$(_RunicApplicationFrontendEmbedded)' == 'true'">
    <ItemGroup>
      <_RunicViewsEmbeddedFile Include="@(_RunicBridgeReferencedFrontendFile)" />
      <_RunicViewsEmbeddedOwnFile Include="$(_RunicApplicationFrontendOutputPath)**/*"
          Condition="'$(RunicApplicationFrontendGenerationEnabled)' == 'true' and '$(_RunicBridgeSkipped)' != 'true'" />
      <_RunicViewsEmbeddedFile Include="@(_RunicViewsEmbeddedOwnFile->'%(FullPath)')"
          RunicFrontendPath="%(_RunicViewsEmbeddedOwnFile.RecursiveDir)%(_RunicViewsEmbeddedOwnFile.Filename)%(_RunicViewsEmbeddedOwnFile.Extension)" />
      <_RunicViewsEmbeddedFile Include="@(_RunicViewsEmbeddedHostFile)" />
      <_RunicViewsEmbeddedDestination Include="@(_RunicViewsEmbeddedFile->'$(_RunicApplicationFrontendEmbeddedRoot)%(RunicFrontendPath)')" />
      <_RunicViewsEmbeddedExisting Include="$(_RunicApplicationFrontendEmbeddedRoot)**/*" />
      <_RunicViewsEmbeddedStale Include="@(_RunicViewsEmbeddedExisting->'%(FullPath)')" Exclude="@(_RunicViewsEmbeddedDestination->'%(FullPath)')" />
    </ItemGroup>
    <Delete Files="@(_RunicViewsEmbeddedStale)" />
    <MakeDir Directories="$(_RunicApplicationFrontendEmbeddedRoot)" />
    <Copy SourceFiles="@(_RunicViewsEmbeddedFile)" DestinationFiles="@(_RunicViewsEmbeddedDestination)" SkipUnchangedFiles="true" />
  </Target>

  <!-- Runic Translations' ESM for a page that imports the generated files itself instead of through the Translations
       Vite plugin: a Bun-bundled or Angular page, or the runic-app template's translations option. With
       RunicApplicationFrontendTranslations=true and Runic.Translations.Build's RunicTranslationsEmitEsm=true, the build
       mirrors the catalog's ESM folder into RunicApplicationFrontendTranslationsDirectory (by default .runic/translations
       in the frontend directory) before the frontend builds: it copies the files that changed and deletes the ones the
       catalog no longer has, such as the module of a removed or renamed message. The folder is the one that holds the
       web-module manifest among @(RunicTranslationsGeneratedFile), so a renamed catalog or a later ESM version
       ({catalog}.esm-v<N>) needs no change here. The mirrored files are frontend inputs, so a changed catalog rebuilds
       the page.

       No ESM to mirror is RUNICBRIDGE037, and so is a directory that holds other files: the mirror would delete them.
       After a catalog with errors (the Translations tool's exit code 2) the mirror waits: CoreCompile reports those
       errors. -->
  <Target Name="RunicViewsMirrorFrontendTranslations"
          AfterTargets="RunicTranslationsCollectTranslationArtifacts" BeforeTargets="RunicViewsGenerateBridge"
          Condition="'$(RunicApplicationFrontendTranslations)' == 'true' and '$(DesignTimeBuild)' != 'true' and '$(RunicApplicationFrontendBootstrap)' != 'true' and '$(_RunicBridgeMarkupTemporary)' != 'true'">
    <PropertyGroup>
      <RunicApplicationFrontendTranslationsDirectory Condition="'$(RunicApplicationFrontendTranslationsDirectory)' == ''">$(RunicApplicationFrontendDirectory)/.runic/translations</RunicApplicationFrontendTranslationsDirectory>
      <_RunicFrontendTranslationsRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(RunicApplicationFrontendTranslationsDirectory)'))</_RunicFrontendTranslationsRoot>
    </PropertyGroup>
    <ItemGroup>
      <_RunicFrontendTranslationsManifest Include="@(RunicTranslationsGeneratedFile)"
          Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(RunicTranslationsGeneratedFile.Filename)%(RunicTranslationsGeneratedFile.Extension)', '^web-module-manifest-v[0-9]+\.json$'))" />
    </ItemGroup>
    <PropertyGroup>
      <_RunicFrontendTranslationsWaits Condition="'@(_RunicFrontendTranslationsManifest)' == '' and '$(_TranslationsToolExitCode)' == '2'">true</_RunicFrontendTranslationsWaits>
      <_RunicFrontendTranslationsSource Condition="'@(_RunicFrontendTranslationsManifest->Count())' == '1'">@(_RunicFrontendTranslationsManifest->'%(RootDir)%(Directory)')</_RunicFrontendTranslationsSource>
    </PropertyGroup>
    <Error Code="RUNICBRIDGE037" File="$(MSBuildProjectFullPath)" HelpLink="$(_RunicDiagnosticsHelpLinkBase)runicbridge037"
           Condition="'@(_RunicFrontendTranslationsManifest)' == '' and '$(_RunicFrontendTranslationsWaits)' != 'true'"
           Text="RunicApplicationFrontendTranslations is true, but the build wrote no Runic Translations ESM to copy to $(_RunicFrontendTranslationsRoot), so the page would import a missing or older catalog. Reference Runic.Translations.Build, declare one RunicTranslationProject and set RunicTranslationsEmitEsm=true; or remove RunicApplicationFrontendTranslations when the Translations Vite plugin serves the catalog." />
    <Error Code="RUNICBRIDGE037" File="$(MSBuildProjectFullPath)" HelpLink="$(_RunicDiagnosticsHelpLinkBase)runicbridge037"
           Condition="'@(_RunicFrontendTranslationsManifest->Count())' &gt; '1'"
           Text="RunicApplicationFrontendTranslations copies one catalog's ESM, but the Runic Translations build wrote several: @(_RunicFrontendTranslationsManifest->'%(RootDir)%(Directory)', ', ')." />
    <ItemGroup Condition="'$(_RunicFrontendTranslationsSource)' != ''">
      <_RunicFrontendTranslationsFile Include="@(RunicTranslationsGeneratedFile->'%(FullPath)')"
          Condition="$([System.String]::Copy('%(RunicTranslationsGeneratedFile.FullPath)').StartsWith('$(_RunicFrontendTranslationsSource)'))" />
      <_RunicFrontendTranslationsFile Update="@(_RunicFrontendTranslationsFile)">
        <_RunicDestination>$([System.IO.Path]::GetFullPath('$(_RunicFrontendTranslationsRoot)$([MSBuild]::MakeRelative('$(_RunicFrontendTranslationsSource)', '%(FullPath)'))'))</_RunicDestination>
      </_RunicFrontendTranslationsFile>
      <_RunicFrontendTranslationsExisting Include="$(_RunicFrontendTranslationsRoot)**/*" />
      <_RunicFrontendTranslationsMirrored Include="$(_RunicFrontendTranslationsRoot)web-module-manifest-v*.json" />
      <_RunicFrontendTranslationsStale Include="@(_RunicFrontendTranslationsExisting->'%(FullPath)')" />
      <_RunicFrontendTranslationsStale Remove="@(_RunicFrontendTranslationsFile->'%(_RunicDestination)')" />
    </ItemGroup>
    <Error Code="RUNICBRIDGE037" File="$(MSBuildProjectFullPath)" HelpLink="$(_RunicDiagnosticsHelpLinkBase)runicbridge037"
           Condition="'$(_RunicFrontendTranslationsSource)' != '' and '@(_RunicFrontendTranslationsExisting)' != '' and '@(_RunicFrontendTranslationsMirrored)' == ''"
           Text="RunicApplicationFrontendTranslationsDirectory $(_RunicFrontendTranslationsRoot) holds files but no Runic Translations ESM. The build keeps that directory equal to the catalog's ESM and would delete them; point RunicApplicationFrontendTranslationsDirectory at a directory of its own." />
    <Delete Files="@(_RunicFrontendTranslationsStale)" Condition="'$(_RunicFrontendTranslationsSource)' != ''" />
    <Copy SourceFiles="@(_RunicFrontendTranslationsFile)" DestinationFiles="@(_RunicFrontendTranslationsFile->'%(_RunicDestination)')"
          SkipUnchangedFiles="true" Condition="'$(_RunicFrontendTranslationsSource)' != ''" />
    <ItemGroup Condition="'$(_RunicFrontendTranslationsSource)' != ''">
      <!-- .runic/ is a dot directory, which the frontend inputs leave out. -->
      <RunicApplicationFrontendInput Include="@(_RunicFrontendTranslationsFile->'%(_RunicDestination)')" />
    </ItemGroup>
  </Target>

  <!-- The frontend build runs when one of its inputs is newer than the stamp,
       when a file it left in dist/ is missing, or when its build state differs
       from the one that last built dist/. Inputs are the files under the
       frontend directory (excluding node_modules and build output; .env files
       are inputs), the generated TypeScript and this project file. The build
       state is a hash of the build command, RunicApplicationHost, NODE_ENV and
       the variables that RunicApplicationFrontendBuildEnvironment items name.
       An optimized build (Release, dotnet publish) runs the frontend build
       with NODE_ENV=production unless the environment sets NODE_ENV, so a
       bundler that follows NODE_ENV, such as Bun's (Bun.build, bun build),
       bundles the production build of @runic-artifex/views and of React; a
       Debug build leaves NODE_ENV unset and gets the development build.
       The emitter rewrites TypeScript only when its content changes, so a
       C#-only edit does not rebuild the frontend (RunicViewsGenerateClients).

       RunicApplicationFrontendInput is the extension point for inputs outside
       the frontend directory, such as a monorepo's shared components that the
       frontend imports through a Vite alias:
         <RunicApplicationFrontendInput Include="../ui/lib/**/*" />
       Set RunicApplicationFrontendBuildEnabled=false when another tool owns
       the frontend build. A missing frontend is RUNICBRIDGE014 rather than a
       failed command. -->
  <Target Name="RunicViewsCollectFrontendInputs" AfterTargets="RunicViewsGenerateBridge"
          DependsOnTargets="_RunicViewsIntermediatePaths;RunicViewsResolveHost;RunicViewsGenerateClients"
          Condition="'$(RunicApplicationFrontendGenerationEnabled)' == 'true' and '$(_RunicBridgeSkipped)' != 'true' and '$(DesignTimeBuild)' != 'true' and '$(RunicApplicationFrontendBootstrap)' != 'true' and '$(_RunicBridgeMarkupTemporary)' != 'true' and '$(RunicApplicationFrontendBuildEnabled)' != 'false'">
    <Error Code="RUNICBRIDGE014" File="$(MSBuildProjectFullPath)" HelpLink="$(_RunicDiagnosticsHelpLinkBase)runicbridge014"
           Condition="!Exists('$(RunicApplicationFrontendDirectory)') or ('$(RunicApplicationFrontendBuildCommand)' == '$(_RunicBridgeDefaultFrontendBuildCommand)' and !Exists('$(RunicApplicationFrontendDirectory)/package.json'))"
           Text="$(AssemblyName) declares Runic Views, but the frontend directory $([System.IO.Path]::GetFullPath('$(RunicApplicationFrontendDirectory)')) has no package.json to build the generated client in $([System.IO.Path]::GetFullPath('$(RunicApplicationFrontendGeneratedDirectory)')). Create the frontend there, set RunicApplicationFrontendDirectory to your frontend package directory, or set RunicApplicationFrontendBuildEnabled=false when another tool builds it." />
    <!-- A target that ran before generation may still add the old item name;
         items the project declared were reported before the build. -->
    <ItemGroup>
      <_RunicBridgeDeclaredInputRename Include="@(_RunicSdkRenamedName)" Condition="'%(Identity)' == 'RunicBridgeFrontendInput'" />
    </ItemGroup>
    <Error Code="RUNICBRIDGE017" Condition="'@(RunicBridgeFrontendInput)' != '' and '@(_RunicBridgeDeclaredInputRename)' == ''"
           File="$(MSBuildProjectFullPath)" HelpLink="$(_RunicDiagnosticsHelpLinkBase)runicbridge017"
           Text="The RunicBridgeFrontendInput item is renamed to RunicApplicationFrontendInput. The old name no longer applies; rename it in $(MSBuildProjectFile) or its imports." />
    <ItemGroup>
      <RunicApplicationFrontendInput Include="$(RunicApplicationFrontendDirectory)/**/*"
          Exclude="$(RunicApplicationFrontendDirectory)/node_modules/**;$(RunicApplicationFrontendDirectory)/dist/**;$(_RunicApplicationFrontendOutputPath)**;$(RunicApplicationFrontendDirectory)/build/**;$(RunicApplicationFrontendDirectory)/bin/**;$(RunicApplicationFrontendDirectory)/obj/**;$(RunicApplicationFrontendDirectory)/.*/**" />
      <RunicApplicationFrontendInput Include="$(RunicApplicationFrontendGeneratedDirectory)/*.ts;$(MSBuildProjectFullPath)" />
      <!-- The install's stamp changes only when the install installed something else, which the page bundles. -->
      <RunicApplicationFrontendInput Include="$(_RunicBridgeFrontendInstallStamp)" Condition="Exists('$(_RunicBridgeFrontendInstallStamp)')" />
      <!-- Registered on every build so IncrementalClean keeps them when the
           frontend target is skipped as up to date. -->
      <FileWrites Include="$(_RunicBridgeFrontendStamp);$(_RunicBridgeFrontendOutputsFile)" />
      <_RunicBridgeFrontendEnvironmentName Include="NODE_ENV;@(RunicApplicationFrontendBuildEnvironment)" />
      <_RunicBridgeFrontendEnvironment Include="@(_RunicBridgeFrontendEnvironmentName->Distinct())">
        <Value>$([System.Environment]::GetEnvironmentVariable('%(Identity)'))</Value>
      </_RunicBridgeFrontendEnvironment>
    </ItemGroup>
    <!-- NODE_ENV=production for an optimized build without NODE_ENV in the environment (see above); the build state
         tracks the value the frontend build receives, so switching between Debug and Release rebuilds dist/. -->
    <PropertyGroup>
      <_RunicBridgeFrontendNodeEnvironment Condition="'$(Optimize)' == 'true' and '$([System.Environment]::GetEnvironmentVariable(`NODE_ENV`))' == ''">production</_RunicBridgeFrontendNodeEnvironment>
      <_RunicBridgeFrontendExecEnvironment>RUNIC_APPLICATION_HOST=$(RunicApplicationHost)</_RunicBridgeFrontendExecEnvironment>
      <_RunicBridgeFrontendExecEnvironment Condition="'$(_RunicBridgeFrontendNodeEnvironment)' != ''">$(_RunicBridgeFrontendExecEnvironment);NODE_ENV=$(_RunicBridgeFrontendNodeEnvironment)</_RunicBridgeFrontendExecEnvironment>
    </PropertyGroup>
    <ItemGroup Condition="'$(_RunicBridgeFrontendNodeEnvironment)' != ''">
      <_RunicBridgeFrontendEnvironment Condition="'%(Identity)' == 'NODE_ENV'">
        <Value>$(_RunicBridgeFrontendNodeEnvironment)</Value>
      </_RunicBridgeFrontendEnvironment>
    </ItemGroup>
    <!-- The build state is hashed in memory; neither the values nor the
         environment are written to obj/. A stamp whose state differs from the
         one that last built dist/ (for example from another configuration)
         is stale. -->
    <PropertyGroup>
      <_RunicBridgeFrontendBuildStateText>command=$(RunicApplicationFrontendBuildCommand)|host=$(RunicApplicationHost)|@(_RunicBridgeFrontendEnvironment->'%(Identity)=%(Value)', '|')</_RunicBridgeFrontendBuildStateText>
      <_RunicBridgeFrontendBuildState>$([MSBuild]::StableStringHash($(_RunicBridgeFrontendBuildStateText)))</_RunicBridgeFrontendBuildState>
      <_RunicBridgeFrontendBuildStateText></_RunicBridgeFrontendBuildStateText>
      <_RunicBridgeFrontendBuiltState Condition="Exists('$(_RunicBridgeFrontendStateFile)')">$([System.IO.File]::ReadAllText('$(_RunicBridgeFrontendStateFile)').Trim())</_RunicBridgeFrontendBuiltState>
    </PropertyGroup>
    <Delete Files="$(_RunicBridgeFrontendStamp)"
        Condition="Exists('$(_RunicBridgeFrontendStamp)') and '$(_RunicBridgeFrontendBuiltState)' != '$(_RunicBridgeFrontendBuildState)'" />
    <!-- A deleted dist/, or a file the last build left there, rebuilds even
         though the stamp is newer than every input. So does a stamp without
         the list, as an earlier version wrote. -->
    <ReadLinesFromFile File="$(_RunicBridgeFrontendOutputsFile)" Condition="Exists('$(_RunicBridgeFrontendOutputsFile)')">
      <Output TaskParameter="Lines" ItemName="_RunicBridgeFrontendRecordedOutput" />
    </ReadLinesFromFile>
    <ItemGroup>
      <_RunicBridgeFrontendMissingOutput Include="@(_RunicBridgeFrontendRecordedOutput)"
          Condition="!Exists('%(Identity)')" />
    </ItemGroup>
    <Delete Files="$(_RunicBridgeFrontendStamp)"
        Condition="Exists('$(_RunicBridgeFrontendStamp)') and (!Exists('$(_RunicBridgeFrontendOutputsFile)') or '@(_RunicBridgeFrontendMissingOutput)' != '')" />
  </Target>

  <!-- devtools-library-dx M1: the frontend install, once per install directory (the workspace root, or the frontend
       directory). The task hashes the install command and HashInputs (the lock file and the workspace's package.json
       files) and skips the command when <install directory>/node_modules/.runic-install holds that hash, or, for a
       frontend without dependencies, when StampFile does. A library and an application of one workspace may build in
       parallel, so the check and the install run under a lock file in the temporary folder keyed by the install
       directory: the second build waits and then finds the install current. The hash also covers the package manager's
       executable (found on PATH, not run), and the manager's own record in node_modules must exist, so a no-change build
       runs no process, and an upgraded manager or a half-written node_modules installs again. Always installs on every
       build. ProbeCommand (the manager's version) runs
       first, only when the install runs: a manager that does not run is ProbeFailed (RUNICBRIDGE090), and its output
       is ProbeOutput (RUNICBRIDGE033 for an old Bun). The command runs in the shell, as Exec runs it, and its output is
       logged as Exec logs it and returned in Lines for RunicViewsReportCommandResult. -->
  <UsingTask TaskName="RunicViewsInstallFrontendOnce" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <Task>
      <Code Type="Class" Language="cs"><![CDATA[
using System;
using System.Collections.Generic;
using System.Diagnostics;
using System.IO;
using System.Runtime.InteropServices;
using System.Security.Cryptography;
using System.Text;
using System.Threading;
using Microsoft.Build.Framework;
using Microsoft.Build.Utilities;

public class RunicViewsInstallFrontendOnce : Task, ICancelableTask
{
  [Required] public string Command { get; set; }
  [Required] public string WorkingDirectory { get; set; }
  public ITaskItem[] HashInputs { get; set; }
  public string StampFile { get; set; }
  public bool RequiresNodeModules { get; set; }
  public string ProbeCommand { get; set; }
  public string Message { get; set; }
  // The package manager's command name: its executable on PATH (path, size and time, read without running it) is part
  // of the hash, so that an upgraded manager installs again.
  public string PackageManager { get; set; }
  // The manager's own record in node_modules (npm's .package-lock.json, pnpm's .modules.yaml), which a complete
  // install writes: without it node_modules is not current.
  public string NodeModulesRecord { get; set; }
  // InstallMode Always: install on every build.
  public bool Always { get; set; }
  [Output] public int ExitCode { get; set; }
  [Output] public bool Installed { get; set; }
  [Output] public bool ProbeFailed { get; set; }
  [Output] public string ProbeOutput { get; set; }
  [Output] public ITaskItem[] Lines { get; set; }

  private volatile bool canceled;
  private Process running;

  public void Cancel()
  {
    canceled = true;
    try { Process process = running; if (process != null && !process.HasExited) process.Kill(); } catch { }
  }

  public override bool Execute()
  {
    Lines = new ITaskItem[0];
    string directory = Path.GetFullPath(WorkingDirectory);
    string modules = Path.Combine(directory, "node_modules");
    string marker = Path.Combine(modules, ".runic-install");
    string hash = Hash();
    using (FileStream gate = Acquire(directory))
    {
      if (gate == null) return false;
      bool recorded = string.IsNullOrEmpty(NodeModulesRecord) || File.Exists(Path.Combine(modules, NodeModulesRecord));
      if (!Always && ((Directory.Exists(modules) && recorded && Read(marker) == hash) || (!RequiresNodeModules && Read(StampFile) == hash)))
      {
        Log.LogMessage(MessageImportance.Low, "The frontend install in " + directory + " is current.");
        return true;
      }
      if (!string.IsNullOrEmpty(ProbeCommand))
      {
        var probe = new List<string>();
        int probeExit = Run(ProbeCommand, directory, probe, false);
        ProbeOutput = probe.Count > 0 ? probe[0].Trim() : "";
        if (probeExit != 0) { ProbeFailed = true; ExitCode = probeExit; return !canceled; }
      }
      if (!string.IsNullOrEmpty(Message)) Log.LogMessage(MessageImportance.High, Message);
      // An install that stops halfway leaves no record that it is current.
      try { if (File.Exists(marker)) File.Delete(marker); } catch (IOException) { } catch (UnauthorizedAccessException) { }
      var lines = new List<string>();
      ExitCode = Run(Command, directory, lines, true);
      Installed = true;
      var items = new List<ITaskItem>();
      foreach (string line in lines) if (line.Trim().Length > 0) items.Add(new TaskItem(line.Replace("%", "%25").Replace(";", "%3B").Replace("@", "%40").Replace("$", "%24").Replace("'", "%27")));
      Lines = items.ToArray();
      if (canceled) return false;
      if (ExitCode == 0)
      {
        if (Directory.Exists(modules)) File.WriteAllText(marker, hash);
        // The stamp is an input of the frontend build: it changes only when what the install installed changed.
        if (!string.IsNullOrEmpty(StampFile) && Read(StampFile) != hash)
        {
          Directory.CreateDirectory(Path.GetDirectoryName(Path.GetFullPath(StampFile)));
          File.WriteAllText(StampFile, hash);
        }
      }
      return true;
    }
  }

  private static string Read(string file)
  {
    try { return string.IsNullOrEmpty(file) || !File.Exists(file) ? null : File.ReadAllText(file).Trim(); } catch { return null; }
  }

  private string Hash()
  {
    var paths = new List<string>();
    foreach (ITaskItem item in HashInputs ?? new ITaskItem[0]) paths.Add(Path.GetFullPath(item.ItemSpec));
    paths.Sort(StringComparer.Ordinal);
    using (SHA256 sha = SHA256.Create())
    {
      var text = new StringBuilder("runic-install/1\n").Append(Command).Append('\n').Append(Identity(PackageManager)).Append('\n');
      string previous = null;
      foreach (string path in paths)
      {
        if (path == previous) continue;
        previous = path;
        text.Append(path).Append('\n');
        text.Append(File.Exists(path) ? Hex(sha.ComputeHash(File.ReadAllBytes(path))) : "missing").Append('\n');
      }
      return Hex(sha.ComputeHash(Encoding.UTF8.GetBytes(text.ToString())));
    }
  }

  // The first executable of that name on PATH, as the shell finds it, with its size and time.
  private static string Identity(string command)
  {
    if (string.IsNullOrEmpty(command)) return "";
    bool windows = RuntimeInformation.IsOSPlatform(OSPlatform.Windows);
    string[] extensions = windows ? (Environment.GetEnvironmentVariable("PATHEXT") ?? ".COM;.EXE;.BAT;.CMD").Split(';') : new[] { "" };
    foreach (string folder in (Environment.GetEnvironmentVariable("PATH") ?? "").Split(Path.PathSeparator))
    {
      if (folder.Length == 0) continue;
      foreach (string extension in extensions)
      {
        string candidate;
        try { candidate = Path.Combine(folder.Trim('"'), command + extension); } catch (ArgumentException) { continue; }
        if (!File.Exists(candidate)) continue;
        var file = new FileInfo(candidate);
        return candidate + "|" + file.Length + "|" + file.LastWriteTimeUtc.Ticks;
      }
    }
    return command + "|missing";
  }

  private static string Hex(byte[] bytes)
  {
    var text = new StringBuilder(bytes.Length * 2);
    foreach (byte value in bytes) text.Append(value.ToString("x2"));
    return text.ToString();
  }

  // One lock file per install directory, outside it: npm ci deletes node_modules, and Windows cannot delete an open file.
  private FileStream Acquire(string directory)
  {
    string key = RuntimeInformation.IsOSPlatform(OSPlatform.Linux) ? directory : directory.ToLowerInvariant();
    string name;
    using (SHA256 sha = SHA256.Create()) name = "runic-install-" + Hex(sha.ComputeHash(Encoding.UTF8.GetBytes(key))).Substring(0, 24) + ".lock";
    string path = Path.Combine(Path.GetTempPath(), name);
    bool reported = false;
    DateTime deadline = DateTime.UtcNow.AddMinutes(30);
    while (!canceled)
    {
      try { return new FileStream(path, FileMode.OpenOrCreate, FileAccess.ReadWrite, FileShare.None); }
      catch (IOException)
      {
        if (DateTime.UtcNow > deadline)
        {
          Log.LogError("Waited 30 minutes for another build's frontend install in " + directory + " (lock file " + path + ").");
          return null;
        }
        if (!reported) Log.LogMessage(MessageImportance.High, "Waiting for another build's frontend install in " + directory + ".");
        reported = true;
        Thread.Sleep(200);
      }
    }
    return null;
  }

  // As Exec runs a command: /bin/sh off Windows, cmd.exe on Windows.
  private int Run(string command, string directory, List<string> lines, bool log)
  {
    bool windows = RuntimeInformation.IsOSPlatform(OSPlatform.Windows);
    // Off Windows the command goes to /bin/sh in a file, as Exec does, so that no quoting of the shell is lost.
    string script = null;
    if (!windows)
    {
      script = Path.Combine(Path.GetTempPath(), "runic-install-" + Guid.NewGuid().ToString("N") + ".sh");
      File.WriteAllText(script, command + "\n");
    }
    var start = new ProcessStartInfo(windows ? "cmd.exe" : "/bin/sh")
    {
      Arguments = windows ? "/d /s /c \"" + command + "\"" : "\"" + script + "\"",
      WorkingDirectory = directory,
      UseShellExecute = false,
      RedirectStandardOutput = true,
      RedirectStandardError = true,
      CreateNoWindow = true,
    };
    var pending = new Queue<string>();
    DataReceivedEventHandler collect = (sender, e) => { if (e.Data != null) lock (pending) pending.Enqueue(e.Data); };
    using (var process = new Process { StartInfo = start })
    {
      process.OutputDataReceived += collect;
      process.ErrorDataReceived += collect;
      try { process.Start(); }
      catch (Exception error) { lines.Add(error.Message); Delete(script); return windows ? 9009 : 127; }
      running = process;
      process.BeginOutputReadLine();
      process.BeginErrorReadLine();
      while (true)
      {
        bool exited = process.WaitForExit(100);
        if (exited) process.WaitForExit();
        lock (pending)
        {
          while (pending.Count > 0)
          {
            string line = pending.Dequeue();
            lines.Add(line);
            if (log) Log.LogMessage(MessageImportance.High, line);
          }
        }
        if (exited) break;
      }
      running = null;
      Delete(script);
      return process.ExitCode;
    }
  }

  private static void Delete(string file)
  {
    try { if (file != null) File.Delete(file); } catch { }
  }
}
      ]]></Code>
    </Task>
  </UsingTask>

  <!-- A fresh clone or generated project has no node_modules yet, and a pull can change the declared packages, so the
       build installs the frontend's dependencies with its package manager, and plain dotnet build and dotnet run work.
       In a JavaScript workspace (M1, see _RunicFrontendWorkspaceRoot) the install runs once at the workspace root for
       every member. RunicViewsInstallFrontendOnce runs it when the install command, the lock file or a package.json of
       the workspace changed, or when node_modules is gone; a package.json without dependencies needs no node_modules.
       Set RunicApplicationFrontendInstallEnabled=false when something else installs the dependencies. -->
  <Target Name="_RunicViewsFrontendWorkspacePaths" DependsOnTargets="_RunicViewsIntermediatePaths">
    <PropertyGroup>
      <_RunicFrontendWorkspaceFile>$(_RunicBridgeBaseIntermediateDirectory)runic/frontend-workspace.txt</_RunicFrontendWorkspaceFile>
      <_RunicFrontendGraphFile>$(_RunicBridgeBaseIntermediateDirectory)runic/frontend-graph.json</_RunicFrontendGraphFile>
      <!-- The resolver runs on the frontend's runtime: Bun for a Bun workspace, else Node.js. -->
      <_RunicFrontendScriptRuntime>node</_RunicFrontendScriptRuntime>
      <_RunicFrontendScriptRuntime Condition="'$(RunicApplicationFrontendPackageManager)' == 'bun'">bun</_RunicFrontendScriptRuntime>
      <_RunicFrontendScriptRuntime Condition="'$(RunicApplicationFrontendCodegenRuntime)' != ''">$(RunicApplicationFrontendCodegenRuntime)</_RunicFrontendScriptRuntime>
    </PropertyGroup>
    <ItemGroup>
      <_RunicFrontendWorkspaceInput Include="$(_RunicFrontendWorkspaceRoot)/package.json;$(_RunicFrontendWorkspaceRoot)/pnpm-workspace.yaml;$(_RunicFrontendFullDirectory)/package.json"
          Condition="Exists('%(Identity)')" />
      <_RunicFrontendWorkspaceInput Include="$(_RunicViewsFrontendGraphScript);$(MSBuildThisFileFullPath)" />
      <FileWrites Include="$(_RunicFrontendWorkspaceFile);$(_RunicFrontendGraphFile)" />
    </ItemGroup>
  </Target>

  <!-- RUNICBRIDGE087: the workspace root above the frontend must list it, or its install is not the workspace's. The
       resolver (runic-frontend-graph.mjs, rax.frontend-graph/1) expands the workspace's globs, writes the graph to
       obj/runic/frontend-graph.json and the facts the build needs to obj/runic/frontend-workspace.txt. It runs again
       only when a package.json of the root or the frontend, pnpm-workspace.yaml or the script changed. -->
  <Target Name="RunicViewsResolveFrontendWorkspace" DependsOnTargets="_RunicViewsFrontendWorkspacePaths"
          Inputs="@(_RunicFrontendWorkspaceInput)" Outputs="$(_RunicFrontendWorkspaceFile)"
          Condition="'$(_RunicFrontendInWorkspace)' == 'true'">
    <Exec Command="&quot;$(_RunicFrontendScriptRuntime)&quot; &quot;$(_RunicViewsFrontendGraphScript)&quot; --frontend &quot;$(_RunicFrontendFullDirectory)&quot; --root &quot;$(_RunicFrontendWorkspaceRoot)&quot; --package-manager $(RunicApplicationFrontendPackageManager) --out &quot;$(_RunicFrontendGraphFile)&quot; --msbuild &quot;$(_RunicFrontendWorkspaceFile)&quot;"
          ConsoleToMSBuild="true" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ExitCode" PropertyName="_RunicFrontendGraphExitCode" />
      <Output TaskParameter="ConsoleOutput" ItemName="_RunicFrontendGraphOutputLine" />
    </Exec>
    <PropertyGroup>
      <_RunicFrontendRuntimeMissing Condition="'$(_RunicFrontendGraphExitCode)' == '127' or '$(_RunicFrontendGraphExitCode)' == '9009'">true</_RunicFrontendRuntimeMissing>
      <_RunicFrontendRuntimeName Condition="'$(_RunicFrontendScriptRuntime)' == 'bun'">Bun $(_RunicMinimumBunVersion) or later</_RunicFrontendRuntimeName>
      <_RunicFrontendRuntimeName Condition="'$(_RunicFrontendRuntimeName)' == ''">Node.js</_RunicFrontendRuntimeName>
    </PropertyGroup>
    <Error Code="RUNICBRIDGE090" File="$(MSBuildProjectFullPath)" HelpLink="$(_RunicDiagnosticsHelpLinkBase)runicbridge090"
           Condition="'$(_RunicFrontendRuntimeMissing)' == 'true'"
           Text="The frontend workspace $(_RunicFrontendWorkspaceRoot) uses $(RunicApplicationFrontendPackageManager) ($(_RunicFrontendPackageManagerSource)), and the build runs '$(_RunicFrontendScriptRuntime)' to resolve it, but '$(_RunicFrontendScriptRuntime)' did not run: it is not on PATH. Install $(_RunicFrontendRuntimeName), or set RunicApplicationFrontendPackageManager or RunicApplicationFrontendCodegenRuntime." />
    <RunicViewsReportCommandResult Condition="'$(_RunicFrontendGraphExitCode)' != '0' and '$(_RunicFrontendRuntimeMissing)' != 'true'"
        Lines="@(_RunicFrontendGraphOutputLine)" ExitCode="$(_RunicFrontendGraphExitCode)"
        FailureCode="RUNICBRIDGE024" FailureFile="$(MSBuildProjectFullPath)"
        FailureText="The frontend workspace resolver exited with code $(_RunicFrontendGraphExitCode) while resolving the workspace of $(_RunicFrontendFullDirectory), an internal error. Its output is above; include it when you report the problem." />
  </Target>

  <Target Name="_RunicViewsReadFrontendWorkspace" DependsOnTargets="RunicViewsResolveFrontendWorkspace"
          Condition="'$(_RunicFrontendInWorkspace)' == 'true'">
    <ReadLinesFromFile File="$(_RunicFrontendWorkspaceFile)" Condition="Exists('$(_RunicFrontendWorkspaceFile)')">
      <Output TaskParameter="Lines" ItemName="_RunicFrontendWorkspaceLine" />
    </ReadLinesFromFile>
    <ItemGroup>
      <_RunicFrontendWorkspaceManifest Include="$([System.String]::Copy('%(_RunicFrontendWorkspaceLine.Identity)').Substring(9))"
          Condition="$([System.String]::Copy('%(_RunicFrontendWorkspaceLine.Identity)').StartsWith('manifest='))" />
      <_RunicFrontendWorkspaceNonMember Include="@(_RunicFrontendWorkspaceLine)" Condition="'%(Identity)' == 'member=false'" />
    </ItemGroup>
    <PropertyGroup>
      <_RunicFrontendWorkspaceMembersFile Condition="Exists('$(_RunicFrontendWorkspaceRoot)/pnpm-workspace.yaml') and !$([System.Text.RegularExpressions.Regex]::IsMatch($([System.IO.File]::ReadAllText('$(_RunicFrontendWorkspaceRoot)/package.json')), '&quot;workspaces&quot;\s*:'))">$(_RunicFrontendWorkspaceRoot)/pnpm-workspace.yaml's packages</_RunicFrontendWorkspaceMembersFile>
      <_RunicFrontendWorkspaceMembersFile Condition="'$(_RunicFrontendWorkspaceMembersFile)' == ''">the workspaces of $(_RunicFrontendWorkspaceRoot)/package.json</_RunicFrontendWorkspaceMembersFile>
    </PropertyGroup>
    <!-- RUNICBRIDGE089: a workspace member that declares another package manager than its workspace's. The build uses
         the workspace's: the member's own declaration would install with a manager that cannot read the root lock. -->
    <Warning Code="RUNICBRIDGE089" File="$(MSBuildProjectFullPath)" HelpLink="$(_RunicDiagnosticsHelpLinkBase)runicbridge089"
             Condition="'$(_RunicFrontendInWorkspace)' == 'true' and '$(_RunicFrontendPackageManagerExplicit)' != 'true' and '$(_RunicFrontendMemberPackageManager)' != '' and '$(_RunicFrontendMemberPackageManager)' != '$(RunicApplicationFrontendPackageManager)'"
             Text="$(_RunicFrontendFullDirectory)/package.json declares $(_RunicFrontendMemberPackageManager) (packageManager), but its workspace $(_RunicFrontendWorkspaceRoot) uses $(RunicApplicationFrontendPackageManager) ($(_RunicFrontendPackageManagerSource)), so the build installs and builds it with $(RunicApplicationFrontendPackageManager). Remove the member's packageManager or make it match the workspace's." />
    <Error Code="RUNICBRIDGE087" File="$(MSBuildProjectFullPath)" HelpLink="$(_RunicDiagnosticsHelpLinkBase)runicbridge087"
           Condition="'@(_RunicFrontendWorkspaceNonMember)' != ''"
           Text="The frontend $(_RunicFrontendFullDirectory) is below the $(RunicApplicationFrontendPackageManager) workspace at $(_RunicFrontendWorkspaceRoot), but $(_RunicFrontendWorkspaceMembersFile) do not include it, so the workspace's install would not install it. Add it to the workspace, or set RunicApplicationFrontendWorkspaceRoot=none to install it on its own with its own lock file." />
  </Target>

  <!-- The install's own condition: BeforeTargets runs this even when the install does not run. -->
  <Target Name="RunicViewsCollectFrontendInstallInputs" BeforeTargets="RunicViewsInstallFrontend"
          DependsOnTargets="_RunicViewsIntermediatePaths;_RunicViewsReadFrontendWorkspace"
          Condition="'$(RunicApplicationFrontendGenerationEnabled)' == 'true' and '$(_RunicBridgeSkipped)' != 'true' and '$(DesignTimeBuild)' != 'true' and '$(RunicApplicationFrontendBootstrap)' != 'true' and '$(_RunicBridgeMarkupTemporary)' != 'true' and '$(RunicApplicationFrontendBuildEnabled)' != 'false' and '$(_RunicFrontendInstallMode)' != 'Never' and '$(RunicApplicationFrontendNodeModulesDirectory)' == '' and Exists('$(RunicApplicationFrontendDirectory)/package.json')">
    <PropertyGroup>
      <_RunicBridgeFrontendHasDependencies>false</_RunicBridgeFrontendHasDependencies>
      <_RunicBridgeFrontendHasDependencies Condition="$([System.Text.RegularExpressions.Regex]::IsMatch($([System.IO.File]::ReadAllText('$(RunicApplicationFrontendDirectory)/package.json')), '&quot;(dependencies|devDependencies|optionalDependencies)&quot;\s*:\s*\{\s*&quot;'))">true</_RunicBridgeFrontendHasDependencies>
      <_RunicBridgeFrontendHasDependencies Condition="'$(_RunicFrontendInWorkspace)' == 'true' and Exists('$(_RunicFrontendWorkspaceRoot)/package.json') and $([System.Text.RegularExpressions.Regex]::IsMatch($([System.IO.File]::ReadAllText('$(_RunicFrontendWorkspaceRoot)/package.json')), '&quot;(dependencies|devDependencies|optionalDependencies)&quot;\s*:\s*\{\s*&quot;'))">true</_RunicBridgeFrontendHasDependencies>
      <_RunicFrontendInstallFullDirectory>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(_RunicFrontendInstallDirectory)').TrimEnd('/').TrimEnd('\'))</_RunicFrontendInstallFullDirectory>
      <!-- The manager's version runs before a default install (RUNICBRIDGE090, and RUNICBRIDGE033 for Bun). -->
      <_RunicFrontendInstallManager Condition="'$(_RunicBridgeDefaultFrontendInstall)' == 'true' and ('$(RunicApplicationFrontendPackageManager)' == 'npm' or '$(RunicApplicationFrontendPackageManager)' == 'pnpm' or '$(RunicApplicationFrontendPackageManager)' == 'bun')">$(RunicApplicationFrontendPackageManager.ToLowerInvariant())</_RunicFrontendInstallManager>
      <_RunicFrontendProbeCommand Condition="'$(_RunicFrontendInstallManager)' != ''">$(_RunicFrontendInstallManager) --version</_RunicFrontendProbeCommand>
      <_RunicFrontendNodeModulesRecord Condition="'$(_RunicFrontendInstallManager)' == 'npm'">.package-lock.json</_RunicFrontendNodeModulesRecord>
      <_RunicFrontendNodeModulesRecord Condition="'$(_RunicFrontendInstallManager)' == 'pnpm'">.modules.yaml</_RunicFrontendNodeModulesRecord>
    </PropertyGroup>
    <ItemGroup>
      <_RunicBridgeFrontendInstallInput Include="$(RunicApplicationFrontendDirectory)/package.json;@(_RunicFrontendWorkspaceManifest)" />
      <_RunicBridgeFrontendInstallInput Include="$(_RunicFrontendInstallDirectory)/%(_RunicBridgeFrontendLockFile.Identity)"
          Condition="Exists('$(_RunicFrontendInstallDirectory)/%(_RunicBridgeFrontendLockFile.Identity)')" />
      <_RunicBridgeFrontendInstallInput Include="$(_RunicFrontendWorkspaceRoot)/pnpm-workspace.yaml"
          Condition="'$(_RunicFrontendInWorkspace)' == 'true' and Exists('$(_RunicFrontendWorkspaceRoot)/pnpm-workspace.yaml')" />
      <FileWrites Include="$(_RunicBridgeFrontendInstallStamp)" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <_RunicBridgeFrontendLockFile Include="package-lock.json;npm-shrinkwrap.json;pnpm-lock.yaml;bun.lock;bun.lockb" />
  </ItemGroup>

  <!-- RunicApplicationFrontendNodeModulesDirectory names a node_modules that
       something else installed, such as a Nix derivation built offline from the
       lock file. The install does not run, and the frontend's node_modules
       becomes a symbolic link (a junction on Windows) to that directory. An
       earlier link is replaced; a node_modules that is not a link is
       RUNICBRIDGE021 rather than replaced. -->
  <UsingTask TaskName="RunicViewsLinkNodeModules" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Link ParameterType="System.String" Required="true" />
      <Target ParameterType="System.String" Required="true" />
      <ProjectFile ParameterType="System.String" />
      <HelpLink ParameterType="System.String" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.Diagnostics" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Runtime.InteropServices" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        // Compiled for netstandard2.0, as MSBuild on .NET Framework does: there is no symbolic link API.
        string target = Path.GetFullPath(Target).TrimEnd('/', '\\');
        string link = Path.GetFullPath(Link).TrimEnd('/', '\\');
        if (!Directory.Exists(target))
        {
          Log.LogError(null, "RUNICBRIDGE021", HelpLink, ProjectFile, 0, 0, 0, 0,
            "RunicApplicationFrontendNodeModulesDirectory is " + target + ", which is not a directory. Install the frontend dependencies there, or unset the property to install them with the frontend's package manager.");
          return false;
        }
        if (Directory.Exists(link) || File.Exists(link))
        {
          if ((File.GetAttributes(link) & FileAttributes.ReparsePoint) == 0)
          {
            Log.LogError(null, "RUNICBRIDGE021", HelpLink, ProjectFile, 0, 0, 0, 0,
              link + " exists and is not a symbolic link, so it cannot point to RunicApplicationFrontendNodeModulesDirectory (" + target + "). Remove it, or unset the property to use it.");
            return false;
          }
          // Remove the link only, never the directory it points to.
          if (Directory.Exists(link)) Directory.Delete(link, false); else File.Delete(link);
        }
        bool windows = RuntimeInformation.IsOSPlatform(OSPlatform.Windows);
        var start = new ProcessStartInfo(windows ? "cmd.exe" : "ln")
        {
          Arguments = windows ? "/c mklink /J \"" + link + "\" \"" + target + "\"" : "-s \"" + target + "\" \"" + link + "\"",
          UseShellExecute = false,
          RedirectStandardError = true,
          RedirectStandardOutput = true,
        };
        using (var process = Process.Start(start))
        {
          process.StandardOutput.ReadToEnd();
          string error = process.StandardError.ReadToEnd();
          process.WaitForExit();
          if (process.ExitCode != 0)
          {
            Log.LogError(null, "RUNICBRIDGE021", HelpLink, ProjectFile, 0, 0, 0, 0,
              "Could not link " + link + " to " + target + ": " + error.Trim());
            return false;
          }
        }
        Log.LogMessage(MessageImportance.Normal, "Linked " + link + " to " + target + ".");
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="RunicViewsLinkFrontendNodeModules" BeforeTargets="RunicViewsBuildFrontend"
          Condition="'$(RunicApplicationFrontendNodeModulesDirectory)' != '' and '$(RunicApplicationFrontendGenerationEnabled)' == 'true' and '$(_RunicBridgeSkipped)' != 'true' and '$(DesignTimeBuild)' != 'true' and '$(RunicApplicationFrontendBootstrap)' != 'true' and '$(_RunicBridgeMarkupTemporary)' != 'true' and '$(RunicApplicationFrontendBuildEnabled)' != 'false' and Exists('$(RunicApplicationFrontendDirectory)/package.json')">
    <RunicViewsLinkNodeModules Link="$(RunicApplicationFrontendDirectory)/node_modules"
                                Target="$(RunicApplicationFrontendNodeModulesDirectory)"
                                ProjectFile="$(MSBuildProjectFullPath)"
                                HelpLink="$(_RunicDiagnosticsHelpLinkBase)runicbridge021" />
  </Target>

  <Target Name="RunicViewsInstallFrontend" BeforeTargets="RunicViewsBuildFrontend" DependsOnTargets="_RunicViewsIntermediatePaths"
          Condition="'$(RunicApplicationFrontendGenerationEnabled)' == 'true' and '$(_RunicBridgeSkipped)' != 'true' and '$(DesignTimeBuild)' != 'true' and '$(RunicApplicationFrontendBootstrap)' != 'true' and '$(_RunicBridgeMarkupTemporary)' != 'true' and '$(RunicApplicationFrontendBuildEnabled)' != 'false' and '$(_RunicFrontendInstallMode)' != 'Never' and '$(RunicApplicationFrontendNodeModulesDirectory)' == '' and Exists('$(RunicApplicationFrontendDirectory)/package.json')">
    <!-- An install without a lock file resolves the declared version ranges afresh on every machine and build,
         so a newly published version, malicious or not, runs in the frontend build. -->
    <Error Code="RUNICBRIDGE026" File="$(MSBuildProjectFullPath)" HelpLink="$(_RunicDiagnosticsHelpLinkBase)runicbridge026"
           Condition="'$(_RunicFrontendInWorkspace)' != 'true' and '$(_RunicBridgeDefaultFrontendInstall)' == 'true' and '$(_RunicBridgeFrontendLocked)' != 'true' and '$(_RunicBridgeFrontendUnlockedInstall)' != 'true' and '$(_RunicBridgeFrontendHasDependencies)' == 'true'"
           Text="$([System.IO.Path]::GetFullPath('$(RunicApplicationFrontendDirectory)')) declares dependencies but has no $(_RunicBridgeFrontendLockFileName), so the frontend install would not be locked. Create the lock file with '$(RunicApplicationFrontendPackageManager) install' and commit it, or set RunicApplicationFrontendAllowUnlockedInstall=true to install without one." />
    <Error Code="RUNICBRIDGE026" File="$(MSBuildProjectFullPath)" HelpLink="$(_RunicDiagnosticsHelpLinkBase)runicbridge026"
           Condition="'$(_RunicFrontendInWorkspace)' == 'true' and '$(_RunicBridgeDefaultFrontendInstall)' == 'true' and '$(_RunicBridgeFrontendLocked)' != 'true' and '$(_RunicBridgeFrontendUnlockedInstall)' != 'true'"
           Text="The frontend $(_RunicFrontendFullDirectory) is a member of the $(RunicApplicationFrontendPackageManager) workspace at $(_RunicFrontendWorkspaceRoot), which has no $(_RunicBridgeFrontendLockFileName), so the workspace install would not be locked. Run '$(RunicApplicationFrontendPackageManager) install' in $(_RunicFrontendWorkspaceRoot) and commit $(_RunicBridgeFrontendLockFileName), or set RunicApplicationFrontendAllowUnlockedInstall=true to install without one." />
    <PropertyGroup>
      <_RunicFrontendInstallMessage>Installing frontend dependencies in $(RunicApplicationFrontendDirectory) with $(RunicApplicationFrontendPackageManager). Set RunicApplicationFrontendInstallEnabled=false to install them yourself.</_RunicFrontendInstallMessage>
      <_RunicFrontendInstallMessage Condition="'$(_RunicFrontendInWorkspace)' == 'true'">Installing the frontend workspace $(_RunicFrontendWorkspaceRoot) with $(RunicApplicationFrontendPackageManager), for $(_RunicFrontendFullDirectory). Set RunicApplicationFrontendInstallEnabled=false to install it yourself.</_RunicFrontendInstallMessage>
    </PropertyGroup>
    <RunicViewsInstallFrontendOnce Command="$(RunicApplicationFrontendInstallCommand)" WorkingDirectory="$(_RunicFrontendInstallFullDirectory)"
        HashInputs="@(_RunicBridgeFrontendInstallInput)" StampFile="$(_RunicBridgeFrontendInstallStamp)"
        RequiresNodeModules="$(_RunicBridgeFrontendHasDependencies)" ProbeCommand="$(_RunicFrontendProbeCommand)"
        PackageManager="$(_RunicFrontendInstallManager)" NodeModulesRecord="$(_RunicFrontendNodeModulesRecord)"
        Always="$(_RunicFrontendInstallAlways)"
        Message="$(_RunicFrontendInstallMessage)">
      <Output TaskParameter="ExitCode" PropertyName="_RunicBridgeFrontendInstallExitCode" />
      <Output TaskParameter="Installed" PropertyName="_RunicBridgeFrontendInstalled" />
      <Output TaskParameter="ProbeFailed" PropertyName="_RunicFrontendProbeFailed" />
      <Output TaskParameter="ProbeOutput" PropertyName="_RunicFrontendProbeOutput" />
      <Output TaskParameter="Lines" ItemName="_RunicBridgeFrontendInstallOutputLine" />
    </RunicViewsInstallFrontendOnce>
    <PropertyGroup>
      <_RunicFrontendPackageManagerName Condition="'$(RunicApplicationFrontendPackageManager)' == 'bun'">Bun $(_RunicMinimumBunVersion) or later</_RunicFrontendPackageManagerName>
      <_RunicFrontendPackageManagerName Condition="'$(RunicApplicationFrontendPackageManager)' == 'pnpm'">pnpm</_RunicFrontendPackageManagerName>
      <_RunicFrontendPackageManagerName Condition="'$(_RunicFrontendPackageManagerName)' == ''">Node.js, which includes npm</_RunicFrontendPackageManagerName>
      <_RunicFrontendInstallScope>frontend $(_RunicFrontendFullDirectory)</_RunicFrontendInstallScope>
      <_RunicFrontendInstallScope Condition="'$(_RunicFrontendInWorkspace)' == 'true'">frontend workspace $(_RunicFrontendWorkspaceRoot)</_RunicFrontendInstallScope>
      <_RunicBunVersion Condition="'$(RunicApplicationFrontendPackageManager)' == 'bun' and '$(_RunicFrontendProbeFailed)' != 'true' and '$(_RunicFrontendProbeOutput)' != ''">$([System.Text.RegularExpressions.Regex]::Match('$(_RunicFrontendProbeOutput)', '^\d+\.\d+\.\d+'))</_RunicBunVersion>
      <_RunicFrontendPackageManagerProbed Condition="'$(_RunicFrontendProbeOutput)' != '' or '$(_RunicFrontendProbeFailed)' == 'true'">true</_RunicFrontendPackageManagerProbed>
    </PropertyGroup>
    <!-- F7: a missing manager fails before the install, naming where it was declared, instead of exit code 127. -->
    <Error Code="RUNICBRIDGE090" File="$(MSBuildProjectFullPath)" HelpLink="$(_RunicDiagnosticsHelpLinkBase)runicbridge090"
           Condition="'$(_RunicFrontendProbeFailed)' == 'true'"
           Text="The $(_RunicFrontendInstallScope) uses $(RunicApplicationFrontendPackageManager) ($(_RunicFrontendPackageManagerSource)), but '$(_RunicFrontendProbeCommand)' failed with exit code $(_RunicBridgeFrontendInstallExitCode): $(RunicApplicationFrontendPackageManager) is not on PATH or does not run. Install $(_RunicFrontendPackageManagerName), or set RunicApplicationFrontendPackageManager." />
    <Warning Code="RUNICBRIDGE033" File="$(MSBuildProjectFullPath)" HelpLink="$(_RunicDiagnosticsHelpLinkBase)runicbridge033"
             Condition="'$(_RunicBunVersion)' != '' and $([MSBuild]::VersionLessThan('$(_RunicBunVersion)', '$(_RunicMinimumBunVersion)'))"
             Text="Bun $(_RunicBunVersion) is older than $(_RunicMinimumBunVersion), the oldest Bun that this Runic release supports; 'dotnet runic doctor' rejects it. Install Bun $(_RunicMinimumBunVersion) or a newer 1.x release." />
    <PropertyGroup>
      <_RunicBridgeFrontendInstallDiagnostics Condition="'$(_RunicBridgeFrontendInstalled)' == 'true' and $([System.Text.RegularExpressions.Regex]::IsMatch('%(_RunicBridgeFrontendInstallOutputLine.Identity)', '$(_RunicBridgeCanonicalDiagnostic)'))">true</_RunicBridgeFrontendInstallDiagnostics>
    </PropertyGroup>
    <RunicViewsReportCommandResult Condition="'$(_RunicBridgeFrontendInstalled)' == 'true' and ('$(_RunicBridgeFrontendInstallExitCode)' != '0' or '$(_RunicBridgeFrontendInstallDiagnostics)' == 'true')"
        Lines="@(_RunicBridgeFrontendInstallOutputLine)" ExitCode="$(_RunicBridgeFrontendInstallExitCode)"
        WorkingDirectory="$(_RunicFrontendInstallFullDirectory)"
        FailureCode="RUNICBRIDGE016" FailureFile="$(MSBuildProjectFullPath)"
        FailureText="The frontend install '$(RunicApplicationFrontendInstallCommand)' in $(_RunicFrontendInstallFullDirectory) exited with code $(_RunicBridgeFrontendInstallExitCode). Its output is above. Run 'dotnet runic doctor' to check the package manager and lock file." />
    <!-- npm installs a workspace's packages into the root's node_modules only, so the check is at the install directory. -->
    <Error Code="RUNICBRIDGE016" File="$(MSBuildProjectFullPath)" HelpLink="$(_RunicDiagnosticsHelpLinkBase)runicbridge016"
           Condition="'$(_RunicBridgeFrontendInstalled)' == 'true' and '$(_RunicBridgeFrontendInstallExitCode)' == '0' and '$(_RunicBridgeFrontendHasDependencies)' == 'true' and !Exists('$(_RunicFrontendInstallFullDirectory)/node_modules')"
           Text="'$(RunicApplicationFrontendInstallCommand)' did not create $(_RunicFrontendInstallDirectory)/node_modules. Install the frontend dependencies with $(RunicApplicationFrontendPackageManager), or run 'dotnet runic doctor' to check the package manager and lock file." />
  </Target>

  <Target Name="RunicViewsBuildFrontend" AfterTargets="RunicViewsCollectFrontendInputs" DependsOnTargets="_RunicViewsIntermediatePaths"
          Inputs="@(RunicApplicationFrontendInput)" Outputs="$(_RunicBridgeFrontendStamp)"
          Condition="'$(RunicApplicationFrontendGenerationEnabled)' == 'true' and '$(_RunicBridgeSkipped)' != 'true' and '$(DesignTimeBuild)' != 'true' and '$(RunicApplicationFrontendBootstrap)' != 'true' and '$(_RunicBridgeMarkupTemporary)' != 'true' and '$(RunicApplicationFrontendBuildEnabled)' != 'false'">
    <!-- Compiler errors in canonical form (tsc, vue-tsc) are logged with
         their codes and locations, and svelte-check errors with their
         locations; any other failure, such as a Vite error,
         gets one RUNICBRIDGE016 instead of MSB3073. -->
    <Exec Command="bun --version" WorkingDirectory="$(RunicApplicationFrontendDirectory)" Condition="'$(RunicApplicationFrontendPackageManager)' == 'bun' and '$(_RunicFrontendPackageManagerProbed)' != 'true'"
          EchoOff="true" StandardOutputImportance="low" StandardErrorImportance="low"
          ConsoleToMSBuild="true" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" PropertyName="_RunicBunVersionExitCode" />
      <Output TaskParameter="ConsoleOutput" PropertyName="_RunicBunVersionOutput" />
    </Exec>
    <PropertyGroup Condition="'$(_RunicBunVersionExitCode)' == '0'">
      <_RunicBunVersion>$([System.Text.RegularExpressions.Regex]::Match('$(_RunicBunVersionOutput)', '^\d+\.\d+\.\d+'))</_RunicBunVersion>
    </PropertyGroup>
    <Warning Code="RUNICBRIDGE033" File="$(MSBuildProjectFullPath)" HelpLink="$(_RunicDiagnosticsHelpLinkBase)runicbridge033"
             Condition="'$(_RunicBunVersion)' != '' and $([MSBuild]::VersionLessThan('$(_RunicBunVersion)', '$(_RunicMinimumBunVersion)'))"
             Text="Bun $(_RunicBunVersion) is older than $(_RunicMinimumBunVersion), the oldest Bun that this Runic release supports; 'dotnet runic doctor' rejects it. Install Bun $(_RunicMinimumBunVersion) or a newer 1.x release." />
    <Exec Command="$(RunicApplicationFrontendBuildCommand)" WorkingDirectory="$(RunicApplicationFrontendDirectory)"
          EnvironmentVariables="$(_RunicBridgeFrontendExecEnvironment)"
          ConsoleToMSBuild="true" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" PropertyName="_RunicBridgeFrontendBuildExitCode" />
      <Output TaskParameter="ConsoleOutput" ItemName="_RunicBridgeFrontendBuildOutputLine" />
    </Exec>
    <PropertyGroup>
      <_RunicBridgeFrontendBuildDiagnostics Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(_RunicBridgeFrontendBuildOutputLine.Identity)', '$(_RunicBridgeCanonicalDiagnostic)'))">true</_RunicBridgeFrontendBuildDiagnostics>
    </PropertyGroup>
    <!-- F7: the shell's "command not found" (127, or 9009 from cmd.exe) is a missing package manager only when the
         manager itself does not run; a build script's own missing tool exits with 127 too. -->
    <Exec Command="$(RunicApplicationFrontendPackageManager) --version" WorkingDirectory="$(RunicApplicationFrontendDirectory)"
          Condition="('$(_RunicBridgeFrontendBuildExitCode)' == '127' or '$(_RunicBridgeFrontendBuildExitCode)' == '9009') and '$(RunicApplicationFrontendBuildCommand)' == '$(_RunicBridgeDefaultFrontendBuildCommand)'"
          EchoOff="true" StandardOutputImportance="low" StandardErrorImportance="low" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" PropertyName="_RunicFrontendBuildManagerExitCode" />
    </Exec>
    <PropertyGroup>
      <_RunicFrontendBuildManagerMissing Condition="'$(_RunicFrontendBuildManagerExitCode)' != '' and '$(_RunicFrontendBuildManagerExitCode)' != '0'">true</_RunicFrontendBuildManagerMissing>
      <_RunicFrontendPackageManagerName Condition="'$(RunicApplicationFrontendPackageManager)' == 'bun'">Bun $(_RunicMinimumBunVersion) or later</_RunicFrontendPackageManagerName>
      <_RunicFrontendPackageManagerName Condition="'$(RunicApplicationFrontendPackageManager)' == 'pnpm'">pnpm</_RunicFrontendPackageManagerName>
      <_RunicFrontendPackageManagerName Condition="'$(_RunicFrontendPackageManagerName)' == ''">Node.js, which includes npm</_RunicFrontendPackageManagerName>
    </PropertyGroup>
    <Error Code="RUNICBRIDGE090" File="$(MSBuildProjectFullPath)" HelpLink="$(_RunicDiagnosticsHelpLinkBase)runicbridge090"
           Condition="'$(_RunicFrontendBuildManagerMissing)' == 'true'"
           Text="The frontend $([System.IO.Path]::GetFullPath('$(RunicApplicationFrontendDirectory)')) uses $(RunicApplicationFrontendPackageManager) ($(_RunicFrontendPackageManagerSource)), but '$(RunicApplicationFrontendPackageManager) --version' failed: $(RunicApplicationFrontendPackageManager) is not on PATH or does not run, so the frontend build '$(RunicApplicationFrontendBuildCommand)' could not run. Install $(_RunicFrontendPackageManagerName), or set RunicApplicationFrontendPackageManager." />
    <RunicViewsReportCommandResult Condition="'$(_RunicFrontendBuildManagerMissing)' != 'true' and ('$(_RunicBridgeFrontendBuildExitCode)' != '0' or '$(_RunicBridgeFrontendBuildDiagnostics)' == 'true')"
        Lines="@(_RunicBridgeFrontendBuildOutputLine)" ExitCode="$(_RunicBridgeFrontendBuildExitCode)"
        WorkingDirectory="$(RunicApplicationFrontendDirectory)"
        FailureCode="RUNICBRIDGE016" FailureFile="$(MSBuildProjectFullPath)"
        FailureText="The frontend build '$(RunicApplicationFrontendBuildCommand)' in $([System.IO.Path]::GetFullPath('$(RunicApplicationFrontendDirectory)')) exited with code $(_RunicBridgeFrontendBuildExitCode). Its output is above." />
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(_RunicBridgeFrontendStamp)'))"
             Condition="'$(_RunicBridgeFrontendBuildExitCode)' == '0'" />
    <ItemGroup Condition="'$(_RunicBridgeFrontendBuildExitCode)' == '0'">
      <_RunicBridgeFrontendBuiltFile Include="$(_RunicApplicationFrontendOutputPath)**/*" />
    </ItemGroup>
    <!-- An empty list still marks the stamp as current; a build that writes
         nothing to the output directory checks no files. -->
    <WriteLinesToFile File="$(_RunicBridgeFrontendOutputsFile)" Overwrite="true"
        Lines="@(_RunicBridgeFrontendBuiltFile->'%(FullPath)')"
        Condition="'$(_RunicBridgeFrontendBuildExitCode)' == '0'" />
    <WriteLinesToFile File="$(_RunicBridgeFrontendStateFile)" Lines="$(_RunicBridgeFrontendBuildState)" Overwrite="true"
        Condition="'$(_RunicBridgeFrontendBuildExitCode)' == '0'" />
    <Touch Files="$(_RunicBridgeFrontendOutputsFile);$(_RunicBridgeFrontendStamp)" AlwaysCreate="true"
           Condition="'$(_RunicBridgeFrontendBuildExitCode)' == '0'" />
  </Target>

  <!-- Views can live in a referenced model project, for example beside a WPF
       application. The model project builds its frontend, and an application
       that references it, directly or through other projects, copies that
       frontend to its own www/ too. The application's own frontend, if any,
       is copied afterwards and wins. -->
  <Target Name="RunicViewsCollectReferencedFrontends"
          DependsOnTargets="AssignProjectConfiguration;_SplitProjectReferencesByFileExistence;_GetProjectReferenceTargetFrameworkProperties"
          Condition="'$(RunicApplicationFrontendBootstrap)' != 'true' and '$(_RunicBridgeMarkupTemporary)' != 'true'">
    <MSBuild Projects="@(_MSBuildProjectReferenceExistent)" Targets="RunicViewsGetFrontendFiles"
             BuildInParallel="$(BuildInParallel)" SkipNonexistentTargets="true"
             Properties="%(_MSBuildProjectReferenceExistent.SetConfiguration); %(_MSBuildProjectReferenceExistent.SetPlatform); %(_MSBuildProjectReferenceExistent.SetTargetFramework)"
             RemoveProperties="%(_MSBuildProjectReferenceExistent.GlobalPropertiesToRemove)"
             Condition="'@(_MSBuildProjectReferenceExistent)' != ''">
      <Output TaskParameter="TargetOutputs" ItemName="_RunicBridgeReferencedFrontendFile" />
    </MSBuild>
  </Target>

  <!-- Returns this project's built frontend after those of its references. A client library's frontend is a package
       that applications import, not a page, so it returns only its references' frontends. -->
  <Target Name="RunicViewsGetFrontendFiles" DependsOnTargets="RunicViewsDetectBridgeUse;RunicViewsCollectReferencedFrontends"
          Returns="@(_RunicBridgeReferencedFrontendFile);@(_RunicBridgeOwnFrontendFile)">
    <ItemGroup Condition="'$(RunicApplicationFrontendGenerationEnabled)' == 'true' and '$(_RunicBridgeSkipped)' != 'true' and '$(RunicApplicationFrontendBootstrap)' != 'true' and '$(RunicApplicationFrontendClientLibrary)' != 'true'">
      <_RunicBridgeFrontendDistFile Include="$(_RunicApplicationFrontendOutputPath)**/*" />
      <_RunicBridgeOwnFrontendFile Include="@(_RunicBridgeFrontendDistFile->'%(FullPath)')"
        RunicFrontendPath="%(_RunicBridgeFrontendDistFile.RecursiveDir)%(_RunicBridgeFrontendDistFile.Filename)%(_RunicBridgeFrontendDistFile.Extension)" />
    </ItemGroup>
  </Target>

  <Target Name="RunicViewsCopyReferencedFrontends" AfterTargets="Build"
          DependsOnTargets="RunicViewsCollectReferencedFrontends"
          Condition="'$(OutputType)' != 'Library' and '$(RunicApplicationFrontendBootstrap)' != 'true' and '$(RunicApplicationFrontendCopyEnabled)' != 'false' and '$(_RunicApplicationFrontendEmbedded)' != 'true'">
    <ItemGroup>
      <_RunicBridgeWwwFile Include="@(_RunicBridgeReferencedFrontendFile->'$(TargetDir)$(_RunicApplicationFrontendWebRoot)/%(RunicFrontendPath)')" />
    </ItemGroup>
    <Copy SourceFiles="@(_RunicBridgeReferencedFrontendFile)"
          DestinationFiles="@(_RunicBridgeReferencedFrontendFile->'$(TargetDir)$(_RunicApplicationFrontendWebRoot)/%(RunicFrontendPath)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="RunicViewsCopyReferencedFrontendsForPublish" AfterTargets="Publish"
          DependsOnTargets="RunicViewsCollectReferencedFrontends"
          Condition="'$(OutputType)' != 'Library' and '$(RunicApplicationFrontendBootstrap)' != 'true' and '$(_RunicApplicationFrontendEmbedded)' != 'true'">
    <ItemGroup>
      <_RunicBridgePublishedWwwFile Include="@(_RunicBridgeReferencedFrontendFile->'$(PublishDir)$(_RunicApplicationFrontendWebRoot)/%(RunicFrontendPath)')" />
    </ItemGroup>
    <Copy SourceFiles="@(_RunicBridgeReferencedFrontendFile)"
          DestinationFiles="@(_RunicBridgeReferencedFrontendFile->'$(PublishDir)$(_RunicApplicationFrontendWebRoot)/%(RunicFrontendPath)')"
          SkipUnchangedFiles="true" />
  </Target>

  <!-- RunicApplicationFrontendCopyEnabled=false keeps a development document that
       dotnet runic dev wrote into www/ from being replaced by dist/. -->
  <Target Name="RunicViewsCopyFrontend" AfterTargets="Build"
          DependsOnTargets="RunicViewsDetectBridgeUse"
          Condition="'$(RunicApplicationFrontendGenerationEnabled)' == 'true' and '$(_RunicBridgeSkipped)' != 'true' and '$(RunicApplicationFrontendBootstrap)' != 'true' and '$(RunicApplicationFrontendCopyEnabled)' != 'false' and '$(_RunicApplicationFrontendEmbedded)' != 'true'">
    <ItemGroup>
      <_RunicBridgeFrontendFile Include="$(_RunicApplicationFrontendOutputPath)**/*" />
      <_RunicBridgeWwwFile Include="@(_RunicBridgeFrontendFile->'$(TargetDir)$(_RunicApplicationFrontendWebRoot)/%(RecursiveDir)%(Filename)%(Extension)')" />
    </ItemGroup>
    <Copy SourceFiles="@(_RunicBridgeFrontendFile)"
          DestinationFiles="@(_RunicBridgeFrontendFile->'$(TargetDir)$(_RunicApplicationFrontendWebRoot)/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <!-- Publish copies even when a dev session turned the build's copy off; a client library's copy stays off unless the
       project turns it on. -->
  <Target Name="RunicViewsCopyFrontendForPublish" AfterTargets="Publish"
          DependsOnTargets="RunicViewsDetectBridgeUse"
          Condition="'$(RunicApplicationFrontendGenerationEnabled)' == 'true' and '$(_RunicBridgeSkipped)' != 'true' and '$(RunicApplicationFrontendBootstrap)' != 'true' and '$(_RunicApplicationFrontendEmbedded)' != 'true' and ('$(RunicApplicationFrontendClientLibrary)' != 'true' or '$(RunicApplicationFrontendCopyEnabled)' != 'false')">
    <ItemGroup>
      <_RunicBridgePublishedFrontendFile Include="$(_RunicApplicationFrontendOutputPath)**/*" />
      <_RunicBridgePublishedWwwFile Include="@(_RunicBridgePublishedFrontendFile->'$(PublishDir)$(_RunicApplicationFrontendWebRoot)/%(RecursiveDir)%(Filename)%(Extension)')" />
    </ItemGroup>
    <Copy SourceFiles="@(_RunicBridgePublishedFrontendFile)"
          DestinationFiles="@(_RunicBridgePublishedFrontendFile->'$(PublishDir)$(_RunicApplicationFrontendWebRoot)/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <!-- www/ mirrors the copied frontends: a file that an earlier copy wrote
       and that no frontend has any more, such as an asset with an old hash,
       is deleted. Each copy records the files it wrote in obj/; nothing else
       in www/ is touched, so the host client scripts, a dev document and
       files the application adds itself stay. These run after the copies
       above, which are declared first. The records live in the intermediate
       directory of the output they describe, so a build for another runtime
       identifier keeps its own, and only files below the current www/ are
       deleted. -->
  <Target Name="RunicViewsWwwManifestDirectory" DependsOnTargets="_RunicViewsIntermediatePaths">
    <PropertyGroup>
      <_RunicBridgeWwwManifestDirectory>$(_RunicBridgeIntermediateDirectory)</_RunicBridgeWwwManifestDirectory>
    </PropertyGroup>
  </Target>

  <Target Name="RunicViewsMirrorFrontend" AfterTargets="Build" DependsOnTargets="RunicViewsWwwManifestDirectory;$(_RunicApplicationHostCopyTargets)"
          Condition="'$(RunicApplicationFrontendBootstrap)' != 'true' and '$(_RunicBridgeMarkupTemporary)' != 'true' and '$(RunicApplicationFrontendCopyEnabled)' != 'false' and '$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_RunicBridgeWwwRoot>$([MSBuild]::EnsureTrailingSlash('$([System.IO.Path]::GetFullPath('$(TargetDir)$(_RunicApplicationFrontendWebRoot)'))'))</_RunicBridgeWwwRoot>
      <_RunicBridgeWwwManifest>$(_RunicBridgeWwwManifestDirectory)runic-frontend-www.files</_RunicBridgeWwwManifest>
    </PropertyGroup>
    <!-- A page that loads runic-views.js needs a chosen host (RUNICBRIDGE019). -->
    <ItemGroup Condition="'$(_RunicApplicationHostAmbiguous)' == 'true'">
      <_RunicBridgeHostNeutralPage Include="@(_RunicBridgeWwwFile->'%(FullPath)')"
          Condition="'%(Extension)' == '.html' and Exists('%(FullPath)') and $([System.Text.RegularExpressions.Regex]::IsMatch($([System.IO.File]::ReadAllText('%(FullPath)')), '(^|[^\w.-])runic-views\.js'))" />
    </ItemGroup>
    <Warning Code="RUNICBRIDGE019" File="$(MSBuildProjectFullPath)" HelpLink="$(_RunicDiagnosticsHelpLinkBase)runicbridge019"
             Condition="'@(_RunicBridgeHostNeutralPage)' != ''"
             Text="$(AssemblyName) references more than one Runic host ($(_RunicApplicationHostNamesText)), and its page @(_RunicBridgeHostNeutralPage->'%(Filename)%(Extension)', ', ') loads runic-views.js, but the build copies no www/runic-views.js, so the page gets no Bridge. Set RunicApplicationHost in $(MSBuildProjectFile) or on the command line (-p:RunicApplicationHost=...) to the host the application runs on." />
    <!-- 0.23 removed the host-named copies of the client (D072.11): a page that still loads one by that name, which
         its frontend does not supply itself, gets a 404 and no Bridge. -->
    <ItemGroup>
      <_RunicBridgeFrontendFileName Include="@(_RunicBridgeWwwFile->'%(Filename)%(Extension)')" />
      <_RunicBridgeOwnDesktopClient Include="@(_RunicBridgeFrontendFileName)" Condition="'%(Identity)' == 'runic-desktop-views.js'" />
      <_RunicBridgeOwnCsWebUiClient Include="@(_RunicBridgeFrontendFileName)" Condition="'%(Identity)' == 'runic-cswebui.js'" />
    </ItemGroup>
    <PropertyGroup>
      <_RunicBridgeHostNamedPattern></_RunicBridgeHostNamedPattern>
      <_RunicBridgeHostNamedPattern Condition="'@(_RunicBridgeOwnDesktopClient)' == ''">desktop-views</_RunicBridgeHostNamedPattern>
      <_RunicBridgeHostNamedPattern Condition="'@(_RunicBridgeOwnCsWebUiClient)' == ''">$(_RunicBridgeHostNamedPattern)|cswebui</_RunicBridgeHostNamedPattern>
      <_RunicBridgeHostNamedPattern>$(_RunicBridgeHostNamedPattern.Trim('|'))</_RunicBridgeHostNamedPattern>
    </PropertyGroup>
    <ItemGroup Condition="'$(_RunicBridgeHostNamedPattern)' != ''">
      <_RunicBridgeHostNamedPage Include="@(_RunicBridgeWwwFile->'%(FullPath)')"
          Condition="'%(Extension)' == '.html' and Exists('%(FullPath)') and $([System.Text.RegularExpressions.Regex]::IsMatch($([System.IO.File]::ReadAllText('%(FullPath)')), '(^|[^\w.-])runic-($(_RunicBridgeHostNamedPattern))\.js'))" />
    </ItemGroup>
    <Warning Code="RUNICBRIDGE019" File="$(MSBuildProjectFullPath)" HelpLink="$(_RunicDiagnosticsHelpLinkBase)runicbridge019"
             Condition="'@(_RunicBridgeHostNamedPage)' != ''"
             Text="The page @(_RunicBridgeHostNamedPage->'%(Filename)%(Extension)', ', ') of $(AssemblyName) loads runic-desktop-views.js or runic-cswebui.js, which Runic 0.23 no longer copies to www/, so the page gets no Bridge. Load runic-views.js instead (&lt;script src=&quot;runic-views.js&quot;&gt;&lt;/script&gt; after webui.js)." />
    <!-- Each record line is "<last write time>|<path>". A recorded file is
         deleted only when its time is unchanged, so a file that someone else
         wrote there since (an operator's config.json, for example) stays. -->
    <ReadLinesFromFile File="$(_RunicBridgeWwwManifest)" Condition="Exists('$(_RunicBridgeWwwManifest)')">
      <Output TaskParameter="Lines" ItemName="_RunicBridgePreviousWwwLine" />
    </ReadLinesFromFile>
    <ItemGroup>
      <_RunicBridgePreviousWwwRecord Include="@(_RunicBridgePreviousWwwLine)" Condition="$([System.String]::Copy('%(Identity)').Contains('|'))">
        <RecordedPath>$([System.String]::Copy('%(Identity)').Substring($([MSBuild]::Add($([System.String]::Copy('%(Identity)').IndexOf('|')), 1))))</RecordedPath>
        <RecordedTime>$([System.String]::Copy('%(Identity)').Substring(0, $([System.String]::Copy('%(Identity)').IndexOf('|'))))</RecordedTime>
      </_RunicBridgePreviousWwwRecord>
      <_RunicBridgePreviousWwwFile Include="@(_RunicBridgePreviousWwwRecord->'%(RecordedPath)')" />
      <_RunicBridgeCurrentWwwFile Include="@(_RunicBridgeWwwFile->'%(FullPath)')" />
      <_RunicBridgeOwnedWwwFile Include="@(_RunicBridgePreviousWwwFile->'%(FullPath)')"
          Condition="$([System.String]::Copy('%(FullPath)').StartsWith('$(_RunicBridgeWwwRoot)'))" />
      <_RunicBridgeStaleWwwCandidate Include="@(_RunicBridgeOwnedWwwFile)" Exclude="@(_RunicBridgeCurrentWwwFile)" />
      <_RunicBridgeStaleWwwFile Include="@(_RunicBridgeStaleWwwCandidate)"
          Condition="'%(ModifiedTime)' == '%(RecordedTime)'" />
    </ItemGroup>
    <Delete Files="@(_RunicBridgeStaleWwwFile)" />
    <MakeDir Directories="$(_RunicBridgeWwwManifestDirectory)" />
    <WriteLinesToFile File="$(_RunicBridgeWwwManifest)" Lines="@(_RunicBridgeCurrentWwwFile->'%(ModifiedTime)|%(FullPath)')"
        Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>

  <!-- The outputs of the RunicDevSession up-to-date set (see UpToDateCheckInput above): a build that copied the frontend
       to www/, so that no development page of dotnet runic dev is left there, writes runic-www.stamp, which Visual
       Studio compares with obj/runic/dev-stopped. A build that keeps a live session's pages writes none. A missing
       dev-stopped is created with an old time, as the check requires every input to exist and an input written during
       the build would leave the project out of date. Declared after RunicViewsMirrorFrontend, so it runs after it. -->
  <Target Name="RunicViewsWwwRestored" AfterTargets="Build" DependsOnTargets="_RunicViewsIntermediatePaths"
          Condition="'$(OutputType)' != 'Library' and '$(IsTestProject)' != 'true' and '$(RunicApplicationFrontendBootstrap)' != 'true' and '$(_RunicBridgeMarkupTemporary)' != 'true' and '$(RunicApplicationFrontendCopyEnabled)' != 'false' and '$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_RunicViewsDevStoppedStamp>$(_RunicBridgeBaseIntermediateDirectory)runic/dev-stopped</_RunicViewsDevStoppedStamp>
      <_RunicViewsWwwStamp>$(_RunicBridgeIntermediateDirectory)runic-www.stamp</_RunicViewsWwwStamp>
    </PropertyGroup>
    <MakeDir Directories="$(_RunicBridgeBaseIntermediateDirectory)runic" Condition="!Exists('$(_RunicViewsDevStoppedStamp)')" />
    <Touch Files="$(_RunicViewsDevStoppedStamp)" AlwaysCreate="true" Time="2000-01-01T00:00:00Z" Condition="!Exists('$(_RunicViewsDevStoppedStamp)')" />
    <MakeDir Directories="$(_RunicBridgeIntermediateDirectory)" />
    <Touch Files="$(_RunicViewsWwwStamp)" AlwaysCreate="true" />
  </Target>

  <!-- The output of the RunicFrontend up-to-date set (see UpToDateCheckInput above): a build after which the frontend
       is current writes runic-frontend-current.stamp. That is a build that built the frontend or found it up to date
       (RunicViewsBuildFrontend's stamp exists), or one that skipped it because a dev session serves the frontend: then a
       frontend edit is dev's to serve, and the next F5 needs no build until dev stops (dev-stopped, RunicDevSession). -->
  <Target Name="RunicViewsFrontendCurrent" AfterTargets="Build" DependsOnTargets="_RunicViewsIntermediatePaths"
          Condition="'$(RunicApplicationFrontendBootstrap)' != 'true' and '$(_RunicBridgeMarkupTemporary)' != 'true' and '$(RunicApplicationFrontendGenerationEnabled)' != 'false' and '$(DesignTimeBuild)' != 'true'">
    <MakeDir Directories="$(_RunicBridgeConfigurationIntermediateDirectory)"
        Condition="Exists('$(_RunicBridgeFrontendStamp)') or '$(_RunicDevSessionLive)' == 'true'" />
    <Touch Files="$(_RunicBridgeConfigurationIntermediateDirectory)runic-frontend-current.stamp" AlwaysCreate="true"
        Condition="Exists('$(_RunicBridgeFrontendStamp)') or '$(_RunicDevSessionLive)' == 'true'" />
  </Target>

  <Target Name="RunicViewsMirrorFrontendForPublish" AfterTargets="Publish" DependsOnTargets="RunicViewsWwwManifestDirectory;$(_RunicApplicationHostPublishCopyTargets)"
          Condition="'$(RunicApplicationFrontendBootstrap)' != 'true' and '$(_RunicBridgeMarkupTemporary)' != 'true'">
    <PropertyGroup>
      <_RunicBridgePublishedWwwRoot>$([MSBuild]::EnsureTrailingSlash('$([System.IO.Path]::GetFullPath('$(PublishDir)$(_RunicApplicationFrontendWebRoot)'))'))</_RunicBridgePublishedWwwRoot>
      <_RunicBridgePublishedWwwManifest>$(_RunicBridgeWwwManifestDirectory)runic-frontend-publish.files</_RunicBridgePublishedWwwManifest>
    </PropertyGroup>
    <!-- Each record line is "<last write time>|<path>". A recorded file is
         deleted only when its time is unchanged, so a file that someone else
         wrote there since (an operator's config.json, for example) stays. -->
    <ReadLinesFromFile File="$(_RunicBridgePublishedWwwManifest)" Condition="Exists('$(_RunicBridgePublishedWwwManifest)')">
      <Output TaskParameter="Lines" ItemName="_RunicBridgePreviousPublishedWwwLine" />
    </ReadLinesFromFile>
    <ItemGroup>
      <_RunicBridgePreviousPublishedWwwRecord Include="@(_RunicBridgePreviousPublishedWwwLine)" Condition="$([System.String]::Copy('%(Identity)').Contains('|'))">
        <RecordedPath>$([System.String]::Copy('%(Identity)').Substring($([MSBuild]::Add($([System.String]::Copy('%(Identity)').IndexOf('|')), 1))))</RecordedPath>
        <RecordedTime>$([System.String]::Copy('%(Identity)').Substring(0, $([System.String]::Copy('%(Identity)').IndexOf('|'))))</RecordedTime>
      </_RunicBridgePreviousPublishedWwwRecord>
      <_RunicBridgePreviousPublishedWwwFile Include="@(_RunicBridgePreviousPublishedWwwRecord->'%(RecordedPath)')" />
      <_RunicBridgeCurrentPublishedWwwFile Include="@(_RunicBridgePublishedWwwFile->'%(FullPath)')" />
      <_RunicBridgeOwnedPublishedWwwFile Include="@(_RunicBridgePreviousPublishedWwwFile->'%(FullPath)')"
          Condition="$([System.String]::Copy('%(FullPath)').StartsWith('$(_RunicBridgePublishedWwwRoot)'))" />
      <_RunicBridgeStalePublishedWwwCandidate Include="@(_RunicBridgeOwnedPublishedWwwFile)" Exclude="@(_RunicBridgeCurrentPublishedWwwFile)" />
      <_RunicBridgeStalePublishedWwwFile Include="@(_RunicBridgeStalePublishedWwwCandidate)"
          Condition="'%(ModifiedTime)' == '%(RecordedTime)'" />
    </ItemGroup>
    <Delete Files="@(_RunicBridgeStalePublishedWwwFile)" />
    <MakeDir Directories="$(_RunicBridgeWwwManifestDirectory)" />
    <WriteLinesToFile File="$(_RunicBridgePublishedWwwManifest)" Lines="@(_RunicBridgeCurrentPublishedWwwFile->'%(ModifiedTime)|%(FullPath)')"
        Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>
</Project>
