<Project>
  <!-- This file is imported from source during development and from
       buildTransitive when consumed as a package. -->
  <PropertyGroup>
    <RunicBridgeGeneratedDir>$(MSBuildProjectDirectory)/obj/$(Configuration)/$(TargetFramework)/runic-bridge/</RunicBridgeGeneratedDir>
    <RunicBridgeNoViewsMarker>RunicBridge.NoViews.marker</RunicBridgeNoViewsMarker>
    <RunicBridgeFrontendDir Condition="'$(RunicBridgeFrontendDir)' == ''">$(MSBuildProjectDirectory)/Frontend</RunicBridgeFrontendDir>
    <RunicBridgeTypescriptDir Condition="'$(RunicBridgeTypescriptDir)' == ''">$(RunicBridgeFrontendDir)/src/generated</RunicBridgeTypescriptDir>
    <!-- WPF compiles a temporary copy of the project (<name>_<random>_wpftmp)
         to resolve local types in XAML. The copy imports these targets too,
         but must not generate or bootstrap again: it compiles the code that
         the real project generated before the copy was created. -->
    <_RunicBridgeMarkupTemporary Condition="'$(_TargetAssemblyProjectName)' != '' or $(MSBuildProjectName.EndsWith('_wpftmp'))">true</_RunicBridgeMarkupTemporary>
    <!-- Output lines that report an error or warning in the canonical
         "origin: error CODE: text" form, as the generator, tsc and vue-tsc do. -->
    <_RunicBridgeCanonicalDiagnostic>(^|:)\s*(error|warning)\s+[A-Za-z]+\d+\s*:</_RunicBridgeCanonicalDiagnostic>
  </PropertyGroup>

  <!-- The generator and the frontend commands run with IgnoreExitCode, so a
       failure is not repeated as MSB3073 ("The command exited with code 1").
       This task logs their canonical errors and warnings with their codes and
       locations, and logs the summary error only when the command failed
       without reporting one. It is compiled only when a command failed or
       reported a diagnostic. -->
  <UsingTask TaskName="RunicBridgeReportCommandResult" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Lines ParameterType="Microsoft.Build.Framework.ITaskItem[]" />
      <ExitCode ParameterType="System.Int32" Required="true" />
      <WorkingDirectory ParameterType="System.String" />
      <FailureCode ParameterType="System.String" Required="true" />
      <FailureFile ParameterType="System.String" />
      <FailureText ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Code Type="Method" Language="cs"><![CDATA[
        public override bool Execute()
        {
          var diagnostic = new Regex(@"^\s*(?:(?<origin>.*?)\s*:\s*)?(?<kind>error|warning)\s+(?<code>[A-Za-z]+\d+)\s*:\s*(?<text>.*)$");
          var location = new Regex(@"^(?<file>.*?)\s*\((?<line>\d+)(?:[,-](?<column>\d+))?[^)]*\)$");
          bool reportedError = false;
          foreach (var item in Lines ?? new Microsoft.Build.Framework.ITaskItem[0])
          {
            Match match = diagnostic.Match(item.ItemSpec);
            if (!match.Success) continue;
            // A diagnostic without an origin, such as the generator's, belongs to the project.
            string file = match.Groups["origin"].Value.Trim();
            int line = 0, column = 0;
            Match at = location.Match(file);
            if (at.Success)
            {
              file = at.Groups["file"].Value;
              line = int.Parse(at.Groups["line"].Value);
              if (at.Groups["column"].Success) column = int.Parse(at.Groups["column"].Value);
            }
            if (file.Length > 0 && !string.IsNullOrEmpty(WorkingDirectory) && file.IndexOfAny(Path.GetInvalidPathChars()) < 0 && !Path.IsPathRooted(file))
            {
              file = Path.GetFullPath(Path.Combine(WorkingDirectory, file));
            }
            if (file.Length == 0) file = FailureFile ?? "";
            if (match.Groups["kind"].Value == "error")
            {
              reportedError = true;
              Log.LogError(null, match.Groups["code"].Value, null, file, line, column, 0, 0, match.Groups["text"].Value);
            }
            else
            {
              Log.LogWarning(null, match.Groups["code"].Value, null, file, line, column, 0, 0, match.Groups["text"].Value);
            }
          }
          if (ExitCode != 0 && !reportedError)
          {
            Log.LogError(null, FailureCode, null, FailureFile, 0, 0, 0, 0, FailureText);
          }
          return !Log.HasLoggedErrors;
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <!-- The frontend package manager follows package.json "packageManager",
       then the committed lock file, then npm. It selects the default build
       and install commands; set either command explicitly to override it. -->
  <PropertyGroup Condition="'$(RunicBridgeFrontendPackageManager)' == '' and Exists('$(RunicBridgeFrontendDir)/package.json')">
    <RunicBridgeFrontendPackageManager>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(RunicBridgeFrontendDir)/package.json')), '(?&lt;="packageManager"\s*:\s*")(npm|pnpm|bun)(?=@)'))</RunicBridgeFrontendPackageManager>
  </PropertyGroup>
  <PropertyGroup>
    <_RunicBridgeDefaultFrontendBuild Condition="'$(RunicBridgeFrontendBuildCommand)' == ''">true</_RunicBridgeDefaultFrontendBuild>
    <RunicBridgeFrontendPackageManager Condition="'$(RunicBridgeFrontendPackageManager)' == '' and Exists('$(RunicBridgeFrontendDir)/pnpm-lock.yaml')">pnpm</RunicBridgeFrontendPackageManager>
    <RunicBridgeFrontendPackageManager Condition="'$(RunicBridgeFrontendPackageManager)' == '' and Exists('$(RunicBridgeFrontendDir)/bun.lock')">bun</RunicBridgeFrontendPackageManager>
    <RunicBridgeFrontendPackageManager Condition="'$(RunicBridgeFrontendPackageManager)' == ''">npm</RunicBridgeFrontendPackageManager>
    <RunicBridgeFrontendBuildCommand Condition="'$(RunicBridgeFrontendBuildCommand)' == '' and '$(RunicBridgeFrontendPackageManager)' == 'pnpm'">pnpm run build</RunicBridgeFrontendBuildCommand>
    <RunicBridgeFrontendBuildCommand Condition="'$(RunicBridgeFrontendBuildCommand)' == '' and '$(RunicBridgeFrontendPackageManager)' == 'bun'">bun run --bun build</RunicBridgeFrontendBuildCommand>
    <RunicBridgeFrontendBuildCommand Condition="'$(RunicBridgeFrontendBuildCommand)' == ''">npm run build</RunicBridgeFrontendBuildCommand>
    <!-- A project may still set its own command after importing these targets. -->
    <_RunicBridgeDefaultFrontendBuildCommand Condition="'$(_RunicBridgeDefaultFrontendBuild)' == 'true'">$(RunicBridgeFrontendBuildCommand)</_RunicBridgeDefaultFrontendBuildCommand>
    <RunicBridgeFrontendInstallCommand Condition="'$(RunicBridgeFrontendInstallCommand)' == '' and '$(RunicBridgeFrontendPackageManager)' == 'pnpm'">pnpm install --frozen-lockfile --ignore-scripts</RunicBridgeFrontendInstallCommand>
    <RunicBridgeFrontendInstallCommand Condition="'$(RunicBridgeFrontendInstallCommand)' == '' and '$(RunicBridgeFrontendPackageManager)' == 'bun'">bun install --frozen-lockfile --ignore-scripts</RunicBridgeFrontendInstallCommand>
    <RunicBridgeFrontendInstallCommand Condition="'$(RunicBridgeFrontendInstallCommand)' == '' and Exists('$(RunicBridgeFrontendDir)/package-lock.json')">npm ci --ignore-scripts</RunicBridgeFrontendInstallCommand>
    <RunicBridgeFrontendInstallCommand Condition="'$(RunicBridgeFrontendInstallCommand)' == ''">npm install --ignore-scripts</RunicBridgeFrontendInstallCommand>
  </PropertyGroup>

  <PropertyGroup>
    <RunicBridgeFrontendStamp>$(MSBuildProjectDirectory)/obj/$(Configuration)/$(TargetFramework)/runic-bridge-frontend.stamp</RunicBridgeFrontendStamp>
    <!-- One install serves every configuration and target framework, and
         dotnet clean keeps it. -->
    <RunicBridgeFrontendInstallStamp>$(MSBuildProjectDirectory)/obj/runic-bridge-frontend-install.stamp</RunicBridgeFrontendInstallStamp>
    <RunicBridgeCodegenProject>$(MSBuildThisFileDirectory)../../../../tools/Runic.Application.Views.Codegen/Runic.Application.Views.Codegen.csproj</RunicBridgeCodegenProject>
    <RunicBridgeCodegenDll Condition="Exists('$(RunicBridgeCodegenProject)')">$(MSBuildThisFileDirectory)../../../../tools/Runic.Application.Views.Codegen/bin/$(Configuration)/net10.0/BridgeCodegen.dll</RunicBridgeCodegenDll>
    <RunicBridgeCodegenDll Condition="!Exists('$(RunicBridgeCodegenProject)')">$(MSBuildThisFileDirectory)../tools/net10.0/BridgeCodegen.dll</RunicBridgeCodegenDll>
    <RunicBridgeAotArgument Condition="'$(PublishAot)' == 'true'">--aot</RunicBridgeAotArgument>
    <RunicBridgeCompositionArgument Condition="'$(RunicBridgeCompositionType)' != ''">--di-composition &quot;$(RunicBridgeCompositionType)&quot;</RunicBridgeCompositionArgument>
  </PropertyGroup>

  <!-- Include the source tool in the restore graph so a first IDE build can
       compile it without a separate manual restore. It is not an app reference. -->
  <ItemGroup Condition="Exists('$(RunicBridgeCodegenProject)') and '$(RunicBridgeBootstrap)' != 'true'">
    <ProjectReference Include="$(RunicBridgeCodegenProject)" ReferenceOutputAssembly="false"
                      GlobalPropertiesToRemove="PublishAot;RuntimeIdentifier;SelfContained" />
  </ItemGroup>

  <!-- The bootstrap pass sets its own output paths. Referenced projects (a
       model project beside a WPF application, for example) keep the
       properties of the real build, so they are not compiled again into the
       bootstrap directories. -->
  <ItemGroup Condition="'$(RunicBridgeBootstrap)' == 'true'">
    <ProjectReference Update="@(ProjectReference)"
                      GlobalPropertiesToRemove="%(GlobalPropertiesToRemove);RunicBridgeBootstrap;RunAnalyzers;RunCodeAnalysis;CopyLocalLockFileAssemblies;OutputPath;IntermediateOutputPath" />
  </ItemGroup>

  <!-- Generation turns on for a project that references Runic.Application
       directly, or that references a host adapter directly or transitively:
       each adapter's props set RunicApplicationHostAdapter=true. -->
  <Target Name="RunicViewsDetectBridgeUse" BeforeTargets="PrepareForBuild">
    <ItemGroup>
      <_RunicBridgeDirectPackage Include="@(PackageReference)"
        Condition="'%(PackageReference.Identity)' == 'Runic.Application'" />
    </ItemGroup>
    <!-- Generation that this file turns on by default is optional: a project
         that declares no Window or View (for example one that only uses the
         navigator) builds without bridge output. A project that sets
         RunicBridgeBuildEnabled=true, or visibly expects output (a frontend
         package.json, RunicBridgeFrontendInput items, a composition type or a
         model assembly), still gets RUNICBRIDGE006 when it has no Window.
         A WPF application may keep its web Views in a referenced model
         project, so there the adapter's default composition type alone does
         not require them. -->
    <PropertyGroup>
      <_RunicBridgeOptional Condition="'$(RunicBridgeBuildEnabled)' == '' and ('$(RunicBridgeCompositionType)' == '' or '$(UseWPF)' == 'true') and '$(RunicBridgeModelAssembly)' == '' and '@(RunicBridgeFrontendInput)' == '' and !Exists('$(RunicBridgeFrontendDir)/package.json')">true</_RunicBridgeOptional>
      <_RunicBridgeDefaultedOff Condition="'$(RunicBridgeBuildEnabled)' == ''">true</_RunicBridgeDefaultedOff>
      <RunicBridgeBuildEnabled Condition="'$(RunicBridgeBuildEnabled)' == '' and Exists('$(RunicBridgeCodegenProject)')">true</RunicBridgeBuildEnabled>
      <RunicBridgeBuildEnabled Condition="'$(RunicBridgeBuildEnabled)' == '' and ('@(_RunicBridgeDirectPackage)' != '' or '$(RunicApplicationHostAdapter)' == 'true')">true</RunicBridgeBuildEnabled>
      <RunicBridgeBuildEnabled Condition="'$(RunicBridgeBuildEnabled)' == ''">false</RunicBridgeBuildEnabled>
      <_RunicBridgeDefaultedOff Condition="'$(RunicBridgeBuildEnabled)' != 'false'"></_RunicBridgeDefaultedOff>
    </PropertyGroup>
  </Target>

  <!-- Without generation, a declared Window or View gets no bridge,
       AddRunicViews() or TypeScript client, and the first sign would be a
       CS1061 at the call. When generation is off only by default (no host
       adapter and no direct Runic.Application reference), look for a class
       deriving from RunicWindow<T> or RunicView<T> and say so once. -->
  <Target Name="RunicViewsCheckDisabledGeneration" BeforeTargets="CoreCompile"
          DependsOnTargets="RunicViewsDetectBridgeUse"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(RunicBridgeBootstrap)' != 'true' and '$(_RunicBridgeMarkupTemporary)' != 'true'">
    <ItemGroup Condition="'$(_RunicBridgeDefaultedOff)' == 'true'">
      <_RunicBridgeViewSource Include="@(Compile)"
        Condition="Exists('%(Compile.FullPath)') and $([System.Text.RegularExpressions.Regex]::IsMatch($([System.IO.File]::ReadAllText('%(Compile.FullPath)')), ':\s*(global::)?(Runic\.Application\.Views\.)?Runic(Window|View)\s*&lt;'))" />
    </ItemGroup>
    <Warning Code="RUNICBRIDGE015" Condition="'@(_RunicBridgeViewSource)' != ''"
             File="$(MSBuildProjectFullPath)" HelpLink="$(RunicDiagnosticsHelpLinkBase)runicbridge015"
             Text="$(AssemblyName) declares a Runic Window or View (@(_RunicBridgeViewSource->'%(Filename)%(Extension)', ', ')), but Bridge generation is off because the project references no host adapter (Runic.Application.Desktop, Runic.Application.CsWebUi or Runic.Application.Wpf) and not Runic.Application directly. No bridge, AddRunicViews() or TypeScript client is generated. Set RunicBridgeBuildEnabled=true to generate them here, or false when another project generates them." />
  </Target>

  <Target Name="RunicViewsDesignTimeComposition" BeforeTargets="CoreCompile"
          DependsOnTargets="RunicViewsDetectBridgeUse"
          Condition="'$(RunicBridgeBuildEnabled)' == 'true' and '$(DesignTimeBuild)' == 'true' and '$(RunicBridgeBootstrap)' != 'true'">
    <MSBuild Projects="$(RunicBridgeCodegenProject)" Targets="Build"
             Properties="Configuration=$(Configuration);TargetFramework=net10.0;RuntimeIdentifier=;PublishAot=false;SelfContained=false"
             Condition="Exists('$(RunicBridgeCodegenProject)') and '$(RunicBridgeCompositionType)' != ''" />
    <MakeDir Directories="$(RunicBridgeGeneratedDir)" />
    <Exec Command="dotnet &quot;$(RunicBridgeCodegenDll)&quot; --composition-stub &quot;$(RunicBridgeCompositionType)&quot; &quot;$(RunicBridgeGeneratedDir)RunicBridgeComposition.DesignTime.g.cs&quot;"
          Condition="'$(RunicBridgeCompositionType)' != ''" />
    <ItemGroup>
      <Compile Include="$(RunicBridgeGeneratedDir)*.Bridge.g.cs;$(RunicBridgeGeneratedDir)*.View.g.cs" />
      <Compile Include="$(RunicBridgeGeneratedDir)RunicBridgeComposition.DesignTime.g.cs"
               Condition="'$(RunicBridgeCompositionType)' != ''" />
    </ItemGroup>
  </Target>

  <!-- The bootstrap pass compiles the application before its Bridges exist.
       An empty composition lets Program.cs call AddRunicViews() or
       AddRunicBridges() in that pass, so a starter needs no bootstrap-only
       OutputType or Compile changes. -->
  <Target Name="RunicViewsBootstrapComposition" BeforeTargets="CoreCompile;GenerateTemporaryTargetAssembly"
          Condition="'$(RunicBridgeBootstrap)' == 'true' and '$(RunicBridgeCompositionType)' != '' and '$(_RunicBridgeMarkupTemporary)' != 'true'">
    <PropertyGroup>
      <_RunicBridgeBootstrapComposition>$(IntermediateOutputPath)RunicBridgeComposition.Bootstrap.g.cs</_RunicBridgeBootstrapComposition>
    </PropertyGroup>
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <Exec Command="dotnet &quot;$(RunicBridgeCodegenDll)&quot; --composition-stub &quot;$(RunicBridgeCompositionType)&quot; &quot;$(_RunicBridgeBootstrapComposition)&quot;" />
    <ItemGroup>
      <Compile Include="$(_RunicBridgeBootstrapComposition)" />
    </ItemGroup>
  </Target>

  <!-- The generator copies XML documentation comments into the generated
       TypeScript. When the project does not already write a documentation
       file, the bootstrap pass writes one beside the inspected assembly with
       the documentation warnings suppressed, so the real build is unchanged.
       Set RunicBridgeDocumentation=false to skip it. -->
  <Target Name="RunicViewsBootstrapDocumentation" BeforeTargets="CoreCompile"
          Condition="'$(RunicBridgeBootstrap)' == 'true' and '$(_RunicBridgeMarkupTemporary)' != 'true' and '$(RunicBridgeDocumentation)' != 'false' and '@(DocFileItem)' == ''">
    <PropertyGroup>
      <NoWarn>$(NoWarn);CS1570;CS1571;CS1572;CS1573;CS1574;CS1580;CS1581;CS1584;CS1587;CS1589;CS1590;CS1591;CS1592;CS1658;CS1710;CS1711;CS1712;CS1723;CS1734;CS1735</NoWarn>
    </PropertyGroup>
    <MakeDir Directories="$(OutDir)" />
    <ItemGroup>
      <DocFileItem Include="$(OutDir)$(AssemblyName).xml" />
      <FileWrites Include="$(OutDir)$(AssemblyName).xml" />
    </ItemGroup>
  </Target>

  <!-- In a WPF project this runs before the temporary markup assembly, so
       that assembly can compile the generated code (see
       RunicViewsMarkupTemporaryCompile). -->
  <Target Name="RunicViewsGenerateBridge" BeforeTargets="CoreCompile;GenerateTemporaryTargetAssembly"
          DependsOnTargets="RunicViewsDetectBridgeUse;ResolveProjectReferences"
          Condition="'$(RunicBridgeBuildEnabled)' == 'true' and '$(DesignTimeBuild)' != 'true' and '$(RunicBridgeBootstrap)' != 'true' and '$(_RunicBridgeMarkupTemporary)' != 'true'">
    <MSBuild Projects="$(RunicBridgeCodegenProject)" Targets="Build"
             Properties="Configuration=$(Configuration);TargetFramework=net10.0;RuntimeIdentifier=;PublishAot=false;SelfContained=false"
             Condition="Exists('$(RunicBridgeCodegenProject)')" />
    <!-- In a one-project starter, first compile the ordinary C# source so MVVM
         source generators have finished before Bridge inspection. Analyzers
         are off in this pass: it only feeds the generator, the real build runs
         them, and the bootstrap's XML documentation file would otherwise
         surface documentation-dependent analyzer warnings. Source generators
         still run. -->
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="Build"
             Properties="RunicBridgeBootstrap=true;RunAnalyzers=false;RunCodeAnalysis=false;Configuration=$(Configuration);TargetFramework=$(TargetFramework);RuntimeIdentifier=;PublishAot=false;SelfContained=false;CopyLocalLockFileAssemblies=true;OutputPath=$(MSBuildProjectDirectory)/obj/runic-bridge/bootstrap/bin/$(Configuration)/$(TargetFramework)/;IntermediateOutputPath=$(MSBuildProjectDirectory)/obj/runic-bridge/bootstrap/obj/$(Configuration)/$(TargetFramework)/"
             Condition="'$(RunicBridgeModelAssembly)' == ''" />
    <PropertyGroup>
      <RunicBridgeInputAssembly Condition="'$(RunicBridgeModelAssembly)' == ''">$(MSBuildProjectDirectory)/obj/runic-bridge/bootstrap/bin/$(Configuration)/$(TargetFramework)/$(AssemblyName).dll</RunicBridgeInputAssembly>
      <RunicBridgeInputAssembly Condition="'$(RunicBridgeModelAssembly)' != ''">$(RunicBridgeModelAssembly)</RunicBridgeInputAssembly>
    </PropertyGroup>
    <Error Condition="!Exists('$(RunicBridgeCodegenDll)')"
           Text="Runic Bridge code generator was not found at $(RunicBridgeCodegenDll)." />
    <PropertyGroup>
      <RunicBridgeOptionalArgument Condition="'$(_RunicBridgeOptional)' == 'true'">--optional</RunicBridgeOptionalArgument>
      <_RunicBridgeSkipped>false</_RunicBridgeSkipped>
      <RunicBridgeReactiveUiFlavorArgument Condition="'$(RunicBridgeReactiveUiFlavor)' != ''">--reactiveui-flavor &quot;$(RunicBridgeReactiveUiFlavor)&quot;</RunicBridgeReactiveUiFlavorArgument>
    </PropertyGroup>
    <Delete Files="$(RunicBridgeGeneratedDir)$(RunicBridgeNoViewsMarker)" />
    <!-- The generator reports its diagnostics in canonical form. They are
         logged once with their codes (see RunicBridgeReportCommandResult);
         a failure that reported none is RUNICBRIDGE001. -->
    <Exec Command="dotnet &quot;$(RunicBridgeCodegenDll)&quot; --generate &quot;$(RunicBridgeInputAssembly)&quot; &quot;$(RunicBridgeGeneratedDir)&quot; &quot;$(RunicBridgeTypescriptDir)&quot; $(RunicBridgeAotArgument) $(RunicBridgeCompositionArgument) $(RunicBridgeReactiveUiFlavorArgument) $(RunicBridgeOptionalArgument)"
          ConsoleToMSBuild="true" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" PropertyName="_RunicBridgeCodegenExitCode" />
      <Output TaskParameter="ConsoleOutput" ItemName="_RunicBridgeCodegenOutputLine" />
    </Exec>
    <PropertyGroup>
      <_RunicBridgeCodegenDiagnostics Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(_RunicBridgeCodegenOutputLine.Identity)', '$(_RunicBridgeCanonicalDiagnostic)'))">true</_RunicBridgeCodegenDiagnostics>
    </PropertyGroup>
    <RunicBridgeReportCommandResult Condition="'$(_RunicBridgeCodegenExitCode)' != '0' or '$(_RunicBridgeCodegenDiagnostics)' == 'true'"
        Lines="@(_RunicBridgeCodegenOutputLine)" ExitCode="$(_RunicBridgeCodegenExitCode)"
        FailureCode="RUNICBRIDGE001" FailureFile="$(MSBuildProjectFullPath)"
        FailureText="The Runic Bridge generator exited with code $(_RunicBridgeCodegenExitCode) without reporting an error while inspecting $(RunicBridgeInputAssembly). Its output is above." />
    <PropertyGroup>
      <_RunicBridgeSkipped Condition="Exists('$(RunicBridgeGeneratedDir)$(RunicBridgeNoViewsMarker)')">true</_RunicBridgeSkipped>
    </PropertyGroup>
    <Message Importance="normal" Condition="'$(_RunicBridgeSkipped)' == 'true'"
             Text="Runic Bridge: $(AssemblyName) declares no Runic Window or View, so no bridge code or frontend build is generated. Set RunicBridgeBuildEnabled=true to require them, or false to skip the bootstrap build entirely." />
    <ItemGroup Condition="'$(_RunicBridgeSkipped)' == 'true'">
      <FileWrites Include="$(RunicBridgeGeneratedDir)$(RunicBridgeNoViewsMarker)" />
    </ItemGroup>
    <ItemGroup>
      <Compile Include="$(RunicBridgeGeneratedDir)*.Bridge.g.cs;$(RunicBridgeGeneratedDir)*.View.g.cs" />
      <Compile Include="$(RunicBridgeGeneratedDir)RunicBridgeComposition.g.cs" Condition="'$(RunicBridgeCompositionType)' != '' and '$(_RunicBridgeSkipped)' != 'true'" />
    </ItemGroup>
  </Target>

  <!-- WPF's temporary markup project is a copy of the project file, so it
       sees none of the Compile items added above. Compile the code that the
       real project (or its bootstrap pass) has just generated, so that
       code-behind calling AddRunicViews() or a generated View member
       resolves in that assembly too. -->
  <Target Name="RunicViewsMarkupTemporaryCompile" BeforeTargets="CoreCompile"
          DependsOnTargets="RunicViewsDetectBridgeUse"
          Condition="'$(_RunicBridgeMarkupTemporary)' == 'true' and '$(RunicBridgeBuildEnabled)' != 'false' and '$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_RunicBridgeBootstrapComposition>$(IntermediateOutputPath)RunicBridgeComposition.Bootstrap.g.cs</_RunicBridgeBootstrapComposition>
    </PropertyGroup>
    <ItemGroup Condition="'$(RunicBridgeBootstrap)' == 'true' and '$(RunicBridgeCompositionType)' != ''">
      <Compile Include="$(_RunicBridgeBootstrapComposition)" Condition="Exists('$(_RunicBridgeBootstrapComposition)')" />
    </ItemGroup>
    <ItemGroup Condition="'$(RunicBridgeBootstrap)' != 'true' and !Exists('$(RunicBridgeGeneratedDir)$(RunicBridgeNoViewsMarker)')">
      <Compile Include="$(RunicBridgeGeneratedDir)*.Bridge.g.cs;$(RunicBridgeGeneratedDir)*.View.g.cs" />
      <Compile Include="$(RunicBridgeGeneratedDir)RunicBridgeComposition.g.cs"
               Condition="'$(RunicBridgeCompositionType)' != '' and Exists('$(RunicBridgeGeneratedDir)RunicBridgeComposition.g.cs')" />
    </ItemGroup>
  </Target>

  <!-- The frontend build runs only when one of its inputs is newer than the
       stamp: files under the frontend directory (excluding node_modules and
       build output), the generated TypeScript, and this project file. The
       generator rewrites TypeScript only when its content changes, so a
       C#-only edit does not rebuild the frontend. Add inputs outside the
       frontend directory (for example workspace packages) as
       RunicBridgeFrontendInput items, or set RunicBridgeBuildFrontend=false
       when another tool owns the frontend build. A missing frontend is
       RUNICBRIDGE014 rather than a failed command. -->
  <Target Name="RunicViewsCollectFrontendInputs" AfterTargets="RunicViewsGenerateBridge"
          Condition="'$(RunicBridgeBuildEnabled)' == 'true' and '$(_RunicBridgeSkipped)' != 'true' and '$(DesignTimeBuild)' != 'true' and '$(RunicBridgeBootstrap)' != 'true' and '$(_RunicBridgeMarkupTemporary)' != 'true' and '$(RunicBridgeBuildFrontend)' != 'false'">
    <Error Code="RUNICBRIDGE014" File="$(MSBuildProjectFullPath)" HelpLink="$(RunicDiagnosticsHelpLinkBase)runicbridge014"
           Condition="!Exists('$(RunicBridgeFrontendDir)') or ('$(RunicBridgeFrontendBuildCommand)' == '$(_RunicBridgeDefaultFrontendBuildCommand)' and !Exists('$(RunicBridgeFrontendDir)/package.json'))"
           Text="$(AssemblyName) declares Runic Views, but the frontend directory $([System.IO.Path]::GetFullPath('$(RunicBridgeFrontendDir)')) has no package.json to build the generated client in $([System.IO.Path]::GetFullPath('$(RunicBridgeTypescriptDir)')). Create the frontend there, set RunicBridgeFrontendDir to your frontend package directory, or set RunicBridgeBuildFrontend=false when another tool builds it." />
    <ItemGroup>
      <RunicBridgeFrontendInput Include="$(RunicBridgeFrontendDir)/**/*"
          Exclude="$(RunicBridgeFrontendDir)/node_modules/**;$(RunicBridgeFrontendDir)/dist/**;$(RunicBridgeFrontendDir)/build/**;$(RunicBridgeFrontendDir)/bin/**;$(RunicBridgeFrontendDir)/obj/**;$(RunicBridgeFrontendDir)/.*/**" />
      <RunicBridgeFrontendInput Include="$(RunicBridgeTypescriptDir)/*.ts;$(MSBuildProjectFullPath)" />
      <!-- Registered on every build so IncrementalClean keeps the stamp
           when the frontend target is skipped as up to date. -->
      <FileWrites Include="$(RunicBridgeFrontendStamp)" />
    </ItemGroup>
  </Target>

  <!-- A fresh clone or generated project has no node_modules yet, and a pull
       can change the declared packages. Install with the selected package
       manager when package.json or a lock file is newer than the install
       stamp, or when declared packages have no node_modules, so plain
       dotnet build and dotnet run work. A package.json without dependencies
       needs no node_modules. Set RunicBridgeInstallFrontend=false when a
       workspace install owns it. -->
  <Target Name="RunicViewsCollectFrontendInstallInputs" BeforeTargets="RunicViewsInstallFrontend"
          Condition="'$(RunicBridgeInstallFrontend)' != 'false' and Exists('$(RunicBridgeFrontendDir)/package.json')">
    <PropertyGroup>
      <_RunicBridgeFrontendHasDependencies>false</_RunicBridgeFrontendHasDependencies>
      <_RunicBridgeFrontendHasDependencies Condition="$([System.Text.RegularExpressions.Regex]::IsMatch($([System.IO.File]::ReadAllText('$(RunicBridgeFrontendDir)/package.json')), '&quot;(dependencies|devDependencies|optionalDependencies)&quot;\s*:\s*\{\s*&quot;'))">true</_RunicBridgeFrontendHasDependencies>
    </PropertyGroup>
    <ItemGroup>
      <_RunicBridgeFrontendInstallInput Include="$(RunicBridgeFrontendDir)/package.json" />
      <_RunicBridgeFrontendInstallInput Include="$(RunicBridgeFrontendDir)/%(_RunicBridgeFrontendLockFile.Identity)"
          Condition="Exists('$(RunicBridgeFrontendDir)/%(_RunicBridgeFrontendLockFile.Identity)')" />
    </ItemGroup>
    <!-- Deleted node_modules installs again even though its inputs are older. -->
    <Delete Files="$(RunicBridgeFrontendInstallStamp)"
            Condition="'$(_RunicBridgeFrontendHasDependencies)' == 'true' and !Exists('$(RunicBridgeFrontendDir)/node_modules')" />
  </Target>

  <ItemGroup>
    <_RunicBridgeFrontendLockFile Include="package-lock.json;npm-shrinkwrap.json;pnpm-lock.yaml;bun.lock;bun.lockb" />
  </ItemGroup>

  <Target Name="RunicViewsInstallFrontend" BeforeTargets="RunicViewsBuildFrontend"
          Inputs="@(_RunicBridgeFrontendInstallInput)" Outputs="$(RunicBridgeFrontendInstallStamp)"
          Condition="'$(RunicBridgeBuildEnabled)' == 'true' and '$(_RunicBridgeSkipped)' != 'true' and '$(DesignTimeBuild)' != 'true' and '$(RunicBridgeBootstrap)' != 'true' and '$(_RunicBridgeMarkupTemporary)' != 'true' and '$(RunicBridgeBuildFrontend)' != 'false' and '$(RunicBridgeInstallFrontend)' != 'false' and Exists('$(RunicBridgeFrontendDir)/package.json')">
    <Message Importance="high"
             Text="Installing frontend dependencies in $(RunicBridgeFrontendDir) with $(RunicBridgeFrontendPackageManager). Set RunicBridgeInstallFrontend=false to install them yourself." />
    <Exec Command="$(RunicBridgeFrontendInstallCommand)" WorkingDirectory="$(RunicBridgeFrontendDir)"
          ConsoleToMSBuild="true" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" PropertyName="_RunicBridgeFrontendInstallExitCode" />
      <Output TaskParameter="ConsoleOutput" ItemName="_RunicBridgeFrontendInstallOutputLine" />
    </Exec>
    <PropertyGroup>
      <_RunicBridgeFrontendInstallDiagnostics Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(_RunicBridgeFrontendInstallOutputLine.Identity)', '$(_RunicBridgeCanonicalDiagnostic)'))">true</_RunicBridgeFrontendInstallDiagnostics>
    </PropertyGroup>
    <RunicBridgeReportCommandResult Condition="'$(_RunicBridgeFrontendInstallExitCode)' != '0' or '$(_RunicBridgeFrontendInstallDiagnostics)' == 'true'"
        Lines="@(_RunicBridgeFrontendInstallOutputLine)" ExitCode="$(_RunicBridgeFrontendInstallExitCode)"
        WorkingDirectory="$(RunicBridgeFrontendDir)"
        FailureCode="RUNICBRIDGE016" FailureFile="$(MSBuildProjectFullPath)"
        FailureText="The frontend install '$(RunicBridgeFrontendInstallCommand)' in $([System.IO.Path]::GetFullPath('$(RunicBridgeFrontendDir)')) exited with code $(_RunicBridgeFrontendInstallExitCode). Its output is above. Run 'dotnet runic doctor' to check the package manager and lock file." />
    <Error Code="RUNICBRIDGE016" File="$(MSBuildProjectFullPath)"
           Condition="'$(_RunicBridgeFrontendInstallExitCode)' == '0' and '$(_RunicBridgeFrontendHasDependencies)' == 'true' and !Exists('$(RunicBridgeFrontendDir)/node_modules')"
           Text="'$(RunicBridgeFrontendInstallCommand)' did not create $(RunicBridgeFrontendDir)/node_modules. Install the frontend dependencies with $(RunicBridgeFrontendPackageManager), or run 'dotnet runic doctor' to check the package manager and lock file." />
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(RunicBridgeFrontendInstallStamp)'))" />
    <Touch Files="$(RunicBridgeFrontendInstallStamp)" AlwaysCreate="true" />
  </Target>

  <Target Name="RunicViewsBuildFrontend" AfterTargets="RunicViewsCollectFrontendInputs"
          Inputs="@(RunicBridgeFrontendInput)" Outputs="$(RunicBridgeFrontendStamp)"
          Condition="'$(RunicBridgeBuildEnabled)' == 'true' and '$(_RunicBridgeSkipped)' != 'true' and '$(DesignTimeBuild)' != 'true' and '$(RunicBridgeBootstrap)' != 'true' and '$(_RunicBridgeMarkupTemporary)' != 'true' and '$(RunicBridgeBuildFrontend)' != 'false'">
    <!-- Compiler errors in canonical form (tsc, vue-tsc) are logged with
         their codes and locations; any other failure, such as a Vite error,
         gets one RUNICBRIDGE016 instead of MSB3073. -->
    <Exec Command="$(RunicBridgeFrontendBuildCommand)" WorkingDirectory="$(RunicBridgeFrontendDir)"
          ConsoleToMSBuild="true" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" PropertyName="_RunicBridgeFrontendBuildExitCode" />
      <Output TaskParameter="ConsoleOutput" ItemName="_RunicBridgeFrontendBuildOutputLine" />
    </Exec>
    <PropertyGroup>
      <_RunicBridgeFrontendBuildDiagnostics Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(_RunicBridgeFrontendBuildOutputLine.Identity)', '$(_RunicBridgeCanonicalDiagnostic)'))">true</_RunicBridgeFrontendBuildDiagnostics>
    </PropertyGroup>
    <RunicBridgeReportCommandResult Condition="'$(_RunicBridgeFrontendBuildExitCode)' != '0' or '$(_RunicBridgeFrontendBuildDiagnostics)' == 'true'"
        Lines="@(_RunicBridgeFrontendBuildOutputLine)" ExitCode="$(_RunicBridgeFrontendBuildExitCode)"
        WorkingDirectory="$(RunicBridgeFrontendDir)"
        FailureCode="RUNICBRIDGE016" FailureFile="$(MSBuildProjectFullPath)"
        FailureText="The frontend build '$(RunicBridgeFrontendBuildCommand)' in $([System.IO.Path]::GetFullPath('$(RunicBridgeFrontendDir)')) exited with code $(_RunicBridgeFrontendBuildExitCode). Its output is above." />
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(RunicBridgeFrontendStamp)'))"
             Condition="'$(_RunicBridgeFrontendBuildExitCode)' == '0'" />
    <Touch Files="$(RunicBridgeFrontendStamp)" AlwaysCreate="true"
           Condition="'$(_RunicBridgeFrontendBuildExitCode)' == '0'" />
  </Target>

  <!-- Views can live in a referenced model project, for example beside a WPF
       application. The model project builds its frontend, and an application
       that references it, directly or through other projects, copies that
       frontend to its own www/ too. The application's own frontend, if any,
       is copied afterwards and wins. -->
  <Target Name="RunicViewsCollectReferencedFrontends"
          DependsOnTargets="AssignProjectConfiguration;_SplitProjectReferencesByFileExistence;_GetProjectReferenceTargetFrameworkProperties"
          Condition="'$(RunicBridgeBootstrap)' != 'true' and '$(_RunicBridgeMarkupTemporary)' != 'true'">
    <MSBuild Projects="@(_MSBuildProjectReferenceExistent)" Targets="RunicViewsGetFrontendFiles"
             BuildInParallel="$(BuildInParallel)" SkipNonexistentTargets="true"
             Properties="%(_MSBuildProjectReferenceExistent.SetConfiguration); %(_MSBuildProjectReferenceExistent.SetPlatform); %(_MSBuildProjectReferenceExistent.SetTargetFramework)"
             RemoveProperties="%(_MSBuildProjectReferenceExistent.GlobalPropertiesToRemove)"
             Condition="'@(_MSBuildProjectReferenceExistent)' != ''">
      <Output TaskParameter="TargetOutputs" ItemName="_RunicBridgeReferencedFrontendFile" />
    </MSBuild>
  </Target>

  <!-- Returns this project's built frontend after those of its references. -->
  <Target Name="RunicViewsGetFrontendFiles" DependsOnTargets="RunicViewsDetectBridgeUse;RunicViewsCollectReferencedFrontends"
          Returns="@(_RunicBridgeReferencedFrontendFile);@(_RunicBridgeOwnFrontendFile)">
    <ItemGroup Condition="'$(RunicBridgeBuildEnabled)' == 'true' and '$(_RunicBridgeSkipped)' != 'true' and '$(RunicBridgeBootstrap)' != 'true'">
      <_RunicBridgeFrontendDistFile Include="$(RunicBridgeFrontendDir)/dist/**/*" />
      <_RunicBridgeOwnFrontendFile Include="@(_RunicBridgeFrontendDistFile->'%(FullPath)')"
        RunicBridgeFrontendPath="%(_RunicBridgeFrontendDistFile.RecursiveDir)%(_RunicBridgeFrontendDistFile.Filename)%(_RunicBridgeFrontendDistFile.Extension)" />
    </ItemGroup>
  </Target>

  <Target Name="RunicViewsCopyReferencedFrontends" AfterTargets="Build"
          DependsOnTargets="RunicViewsCollectReferencedFrontends"
          Condition="'$(OutputType)' != 'Library' and '$(RunicBridgeBootstrap)' != 'true' and '$(RunicBridgeCopyFrontend)' != 'false'">
    <Copy SourceFiles="@(_RunicBridgeReferencedFrontendFile)"
          DestinationFiles="@(_RunicBridgeReferencedFrontendFile->'$(TargetDir)www/%(RunicBridgeFrontendPath)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="RunicViewsCopyReferencedFrontendsForPublish" AfterTargets="Publish"
          DependsOnTargets="RunicViewsCollectReferencedFrontends"
          Condition="'$(OutputType)' != 'Library' and '$(RunicBridgeBootstrap)' != 'true'">
    <Copy SourceFiles="@(_RunicBridgeReferencedFrontendFile)"
          DestinationFiles="@(_RunicBridgeReferencedFrontendFile->'$(PublishDir)www/%(RunicBridgeFrontendPath)')"
          SkipUnchangedFiles="true" />
  </Target>

  <!-- RunicBridgeCopyFrontend=false keeps a development document that
       dotnet runic dev wrote into www/ from being replaced by dist/. -->
  <Target Name="RunicViewsCopyFrontend" AfterTargets="Build"
          DependsOnTargets="RunicViewsDetectBridgeUse"
          Condition="'$(RunicBridgeBuildEnabled)' == 'true' and '$(_RunicBridgeSkipped)' != 'true' and '$(RunicBridgeBootstrap)' != 'true' and '$(RunicBridgeCopyFrontend)' != 'false'">
    <ItemGroup>
      <RunicBridgeFrontendFile Include="$(RunicBridgeFrontendDir)/dist/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(RunicBridgeFrontendFile)"
          DestinationFiles="@(RunicBridgeFrontendFile->'$(TargetDir)www/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="RunicViewsCopyFrontendForPublish" AfterTargets="Publish"
          DependsOnTargets="RunicViewsDetectBridgeUse"
          Condition="'$(RunicBridgeBuildEnabled)' == 'true' and '$(_RunicBridgeSkipped)' != 'true' and '$(RunicBridgeBootstrap)' != 'true'">
    <ItemGroup>
      <RunicBridgePublishedFrontendFile Include="$(RunicBridgeFrontendDir)/dist/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(RunicBridgePublishedFrontendFile)"
          DestinationFiles="@(RunicBridgePublishedFrontendFile->'$(PublishDir)www/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
