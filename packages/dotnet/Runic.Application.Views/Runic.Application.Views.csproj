<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../../eng/build/application.props" />
  <PropertyGroup>
    <TargetFramework>$(RunicApplicationDefaultTargetFramework)</TargetFramework>
    <RunicApplicationShippingProject>true</RunicApplicationShippingProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- DirectoryIdentity reads stat and GetFileInformationByHandle through LibraryImport. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PackageId>Runic.Application.Views</PackageId>
    <Description>Host-neutral Window and View runtime with generated typed TypeScript clients.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- Published enum members name wire value kinds (String, Int32, Single). -->
    <NoWarn>$(NoWarn);CA1720</NoWarn>
    <!-- buildTransitive/Runic.Application.Views.props: help links for diagnostics of the build targets. -->
    <RunicPackDiagnosticsHelpLinks>true</RunicPackDiagnosticsHelpLinks>
  </PropertyGroup>
  <ItemGroup>
    <!-- The host adapters serve their reserved menu bar route on the window's Views dispatcher (BridgeDispatcher) and
         share its reply envelopes; packing pins the exact version (eng/build/README.md). -->
    <InternalsVisibleTo Include="Runic.Application.Views.Desktop" />
    <InternalsVisibleTo Include="Runic.Application.Views.CsWebUi" />
    <InternalsVisibleTo Include="Runic.Application.Views.Desktop.Tests" />
    <!-- Until the producer speaks protocol 4 (P4), these tests and benchmarks reach the protocol-3 routes and states
         through the dispatcher's legacy routes. -->
    <InternalsVisibleTo Include="Runic.Application.Views.Wpf.Windows.Tests" />
    <InternalsVisibleTo Include="Runic.Application.Views.Benchmarks" />
    <InternalsVisibleTo Include="NotesViewFirst" />
    <InternalsVisibleTo Include="DynamicDataExample" />
    <InternalsVisibleTo Include="DynamicDataProof" />
    <InternalsVisibleTo Include="ReactiveUi25AotProof" />
  </ItemGroup>
  <ItemGroup>
    <!-- The generated-code support API (Generated/) is used throughout the runtime. -->
    <Using Include="Runic.Application.Views.Generated" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <ProjectReference Include="../Runic.Navigation/Runic.Navigation.csproj" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Update="build/Runic.Application.Views.targets" Pack="true" PackagePath="buildTransitive/Runic.Application.Views.targets" />
    <None Include="../../../tools/Runic.Application.Views.Codegen/bin/$(Configuration)/net10.0/*.dll"
          Pack="true" PackagePath="tools/net10.0/" />
    <None Include="../../../tools/Runic.Application.Views.Codegen/bin/$(Configuration)/net10.0/BridgeCodegen.deps.json"
          Pack="true" PackagePath="tools/net10.0/" />
    <None Include="../../../tools/Runic.Application.Views.Codegen/bin/$(Configuration)/net10.0/BridgeCodegen.runtimeconfig.json"
          Pack="true" PackagePath="tools/net10.0/" />
  </ItemGroup>
  <Target Name="RunicViewsCheckPackInputs" BeforeTargets="GenerateNuspec">
    <Error Condition="!Exists('$(MSBuildThisFileDirectory)../../../tools/Runic.Application.Views.Codegen/bin/$(Configuration)/net10.0/BridgeCodegen.dll')"
           Text="Build BridgeCodegen for $(Configuration) before packing Runic.Application.Views." />
  </Target>
  <Import Project="../../../eng/build/application.targets" />
</Project>
