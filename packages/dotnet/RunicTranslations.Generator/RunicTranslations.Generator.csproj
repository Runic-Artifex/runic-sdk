<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(RunicTranslationsGeneratorTargetFramework)</TargetFramework>
    <AssemblyName>RunicTranslations.Generator</AssemblyName>
    <RootNamespace>RunicTranslations.Generator</RootNamespace>
    <Description>Incremental C# source generator for Runic Translations.</Description>
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <DevelopmentDependency>true</DevelopmentDependency>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NuspecFile>RunicTranslations.Generator.nuspec</NuspecFile>
    <CentralPackageVersionOverrideEnabled>true</CentralPackageVersionOverrideEnabled>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <!-- The repository deliberately requires a .NET 10 compiler host for every artifact. -->
    <NoWarn>$(NoWarn);RS1041</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" VersionOverride="4.14.0" PrivateAssets="all" />
    <ProjectReference Include="..\RunicTranslations.Compiler\RunicTranslations.Compiler.csproj" PrivateAssets="all" />
  </ItemGroup>

  <Target Name="SetTranslationsGeneratorNuspecProperties" BeforeTargets="GenerateNuspec">
    <PropertyGroup>
      <NuspecProperties>configuration=$(Configuration);packageVersion=$(PackageVersion);repositoryCommit=$(SourceRevisionId)</NuspecProperties>
    </PropertyGroup>
  </Target>
</Project>
