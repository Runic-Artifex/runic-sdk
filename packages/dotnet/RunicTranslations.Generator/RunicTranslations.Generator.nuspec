<?xml version="1.0"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>RunicTranslations.Generator</id>
    <version>$packageVersion$</version>
    <authors>RunicArtifex</authors>
    <description>Incremental C# source generator for Runic Translations.</description>
    <license type="expression">MIT</license>
    <icon>icon.png</icon>
    <readme>README.md</readme>
    <projectUrl>https://github.com/Runic-Artifex/runic-translations</projectUrl>
    <tags>runic-artifex i18n localization resources dotnet nativeaot source-generator</tags>
    <repository type="git" url="https://github.com/Runic-Artifex/runic-translations" commit="$repositoryCommit$" />
    <developmentDependency>true</developmentDependency>
    <dependencies>
      <dependency id="RunicTranslations" version="[$packageVersion$]" exclude="Build,Analyzers" />
    </dependencies>
  </metadata>
  <files>
    <file src="bin\$configuration$\net10.0\RunicTranslations.Generator.dll" target="analyzers/dotnet/cs" />
    <file src="bin\$configuration$\net10.0\RunicTranslations.Compiler.dll" target="analyzers/dotnet/cs" />
    <file src="README.md" target="" />
    <file src="..\..\..\THIRD-PARTY-NOTICES.md" target="" />
    <file src="..\..\..\eng\cldr\LICENSE" target="licenses/LICENSE" />
    <file src="..\..\..\.github\assets\brand\icon.png" target="" />
  </files>
</package>
