<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(RunicToolkitDefaultTargetFramework)</TargetFramework>
    <RunicToolkitShippingProject>true</RunicToolkitShippingProject>
    <AssemblyName>RunicToolkit.MVVM</AssemblyName>
    <RootNamespace>RunicToolkit.MVVM</RootNamespace>
    <PackageId>RunicToolkit.MVVM</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>Native-AOT-friendly protocol, session, and runtime contracts for RunicToolkit MVVM integrations.</Description>
  </PropertyGroup>
  <ItemGroup>
    <None Update="README.md" Pack="true" PackagePath="/" />
    <None Update="PUBLIC-API.md" Pack="true" PackagePath="docs/" />
  </ItemGroup>
</Project>
