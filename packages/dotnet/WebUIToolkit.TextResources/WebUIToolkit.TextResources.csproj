<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(WebUIToolkitCompatibilityTargetFramework)</TargetFramework>
    <AssemblyName>WebUIToolkit.TextResources</AssemblyName>
    <RootNamespace>WebUIToolkit.TextResources</RootNamespace>
    <WebUIToolkitShippingProject>true</WebUIToolkitShippingProject>
    <Description>Runtime contracts for compiled WebUIToolkit text resources.</Description>
    <!-- These identifiers are fixed by the portable v1 source/runtime contract. -->
    <NoWarn>$(NoWarn);CA1716;CA1720</NoWarn>
  </PropertyGroup>
</Project>
