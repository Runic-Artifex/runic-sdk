  <ItemGroup>
    <ProjectReference Include="../Runic.Application.Platform/Runic.Application.Platform.csproj" />
    <ProjectReference Include="../Runic.Desktop/Runic.Desktop.csproj" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <Import Project="../../../eng/build/application.targets" />
</Project>
