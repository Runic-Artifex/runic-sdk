<Project>
  <!-- Experimental (X1): docs/experimental.md#RUNICDESK102. -->
  <!-- Runic.Desktop's targets choose the server (RunicDesktopServer, Native by default with this package) and write the
       Runic.Desktop.NativeServer runtime switch. -->
  <PropertyGroup>
    <_RunicDesktopNativeServerNoWarn>;$([System.String]::Copy('$(NoWarn)').Replace(',', ';').Replace(' ', ';'));</_RunicDesktopNativeServerNoWarn>
    <!-- The package's static libraries; the repository's own consumers point this at artifacts/native/runic-server. -->
    <RunicDesktopNativeServerStaticRoot Condition="'$(RunicDesktopNativeServerStaticRoot)' == ''">$(MSBuildThisFileDirectory)../build/native/</RunicDesktopNativeServerStaticRoot>
  </PropertyGroup>
  <Target Name="RunicDesktopValidateNativeServer" BeforeTargets="PrepareForBuild">
    <!-- Like an [Experimental] API, the experimental server is an error until the project suppresses its ID. -->
    <Error Code="RUNICDESK102" File="$(MSBuildProjectFullPath)" HelpLink="$(_RunicDiagnosticsHelpLinkBase)runicdesk102"
           Condition="'$(_RunicDesktopNativeServer)' == 'true' and !$(_RunicDesktopNativeServerNoWarn.Contains(';RUNICDESK102;'))"
           Text="The native Desktop server (Runic.Desktop.NativeServer) is experimental and may change or be removed in a minor release. Add RUNICDESK102 to NoWarn to use it, or reference Runic.Desktop.Kestrel instead." />
  </Target>
  <!-- NativeAOT links the static library: one executable, no librunic_server next to it. -->
  <Target Name="RunicDesktopLinkNativeServer" AfterTargets="ResolvePackageAssets"
          Condition="'$(_RunicDesktopNativeServer)' == 'true' and '$(PublishAot)' == 'true' and '$(RuntimeIdentifier)' != ''">
    <PropertyGroup>
      <_RunicDesktopNativeServerStatic Condition="!$(RuntimeIdentifier.StartsWith('win-'))">$(RunicDesktopNativeServerStaticRoot)$(RuntimeIdentifier)/librunic_server.a</_RunicDesktopNativeServerStatic>
      <_RunicDesktopNativeServerStatic Condition="$(RuntimeIdentifier.StartsWith('win-'))">$(RunicDesktopNativeServerStaticRoot)$(RuntimeIdentifier)/runic_server.lib</_RunicDesktopNativeServerStatic>
    </PropertyGroup>
    <ItemGroup Condition="Exists('$(_RunicDesktopNativeServerStatic)')">
      <DirectPInvoke Include="runic_server" />
      <NativeLibrary Include="$(_RunicDesktopNativeServerStatic)" />
      <!-- Rust's standard library on Windows. -->
      <NativeLibrary Include="ntdll.lib;ws2_32.lib;userenv.lib;bcrypt.lib" Condition="$(RuntimeIdentifier.StartsWith('win-'))" />
    </ItemGroup>
  </Target>
  <Target Name="RunicDesktopRemoveLinkedNativeServer" AfterTargets="ComputeFilesToPublish"
          Condition="'$(_RunicDesktopNativeServer)' == 'true' and '$(PublishAot)' == 'true' and '$(_RunicDesktopNativeServerStatic)' != '' and Exists('$(_RunicDesktopNativeServerStatic)')">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
          Condition="'%(ResolvedFileToPublish.Filename)' == 'librunic_server' or '%(ResolvedFileToPublish.Filename)' == 'runic_server'" />
    </ItemGroup>
  </Target>
</Project>
