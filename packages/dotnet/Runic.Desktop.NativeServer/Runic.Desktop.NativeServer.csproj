<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../../eng/build/desktop.props" />
  <!-- The native Desktop server (X1), the server of new applications since 0.15 (D053.24, D053.26): the native libraries
       of native/runic-server and the build targets that select them. The managed binding lives in Runic.Desktop
       (Internal/NativeServer), behind the Runic.Desktop.NativeServer feature switch, so this package carries no
       assembly of its own. Released with the SDK (eng/workspace.json), with Runic.Desktop.NativeServer.Static.<rid>. -->
  <PropertyGroup>
    <PackageId>Runic.Desktop.NativeServer</PackageId>
    <Title>Runic Desktop native server</Title>
    <Description>Serves Runic Desktop surfaces from a native Rust (axum) HTTP and WebSocket server instead of ASP.NET Core Kestrel.</Description>
    <PackageTags>runic-artifex;desktop;webview;rust;axum</PackageTags>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <!-- The shipping policy of eng/build/desktop.props; the package has no assembly. -->
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <IncludeSymbols>false</IncludeSymbols>
    <!-- NU5128: no lib/ folder by design; the native assets and buildTransitive targets are the package. -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <!-- Packs the diagnostics help links (eng/build/release-links.targets) as
         buildTransitive/Runic.Desktop.NativeServer.HelpLinks.props, which buildTransitive/Runic.Desktop.NativeServer.props imports. -->
    <RunicPackDiagnosticsHelpLinks>true</RunicPackDiagnosticsHelpLinks>
    <RunicDiagnosticsHelpLinksPropsName>Runic.Desktop.NativeServer.HelpLinks.props</RunicDiagnosticsHelpLinksPropsName>
    <!-- eng/native/build-runic-server.sh writes one directory per runtime identifier here. -->
    <RunicNativeServerArtifacts Condition="'$(RunicNativeServerArtifacts)' == ''">$(MSBuildThisFileDirectory)../../../artifacts/native/runic-server/</RunicNativeServerArtifacts>
    <!-- The supported runtime identifiers: one shared library each here, and one static package each. -->
    <RunicNativeServerRuntimes>linux-x64;linux-arm64;linux-musl-x64;linux-musl-arm64;win-x64;win-arm64;osx-arm64</RunicNativeServerRuntimes>
    <!-- A release pack must carry every supported runtime identifier. -->
    <RunicNativeServerRequireAllRuntimes Condition="'$(RunicNativeServerRequireAllRuntimes)' == '' and '$(RUNIC_NATIVE_SERVER_REQUIRE_ALL_RUNTIMES)' == 'true'">true</RunicNativeServerRequireAllRuntimes>
    <RunicNativeServerRequireAllRuntimes Condition="'$(RunicNativeServerRequireAllRuntimes)' == ''">false</RunicNativeServerRequireAllRuntimes>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Runic.Desktop/Runic.Desktop.csproj" />
    <!-- The native server's service provider and logging (Runic.Desktop compiles against them privately). -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <None Include="buildTransitive/Runic.Desktop.NativeServer.props;buildTransitive/Runic.Desktop.NativeServer.targets" Pack="true" PackagePath="buildTransitive/" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="../../../native/THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <!-- The shared libraries of every runtime identifier; the static libraries, ≈19 MiB each, are in one
       Runic.Desktop.NativeServer.Static.<rid> package per runtime identifier, which runtime.json makes NuGet restore
       only for a runtime-specific restore of that identifier (NativeAOT always is one). -->
  <Target Name="RunicNativeServerPackNativeAssets" BeforeTargets="_GetPackageFiles">
    <ItemGroup>
      <_RunicNativeServerRuntime Include="$(RunicNativeServerRuntimes)" />
      <_RunicNativeServerShared Include="$(RunicNativeServerArtifacts)%(_RunicNativeServerRuntime.Identity)/librunic_server.so;$(RunicNativeServerArtifacts)%(_RunicNativeServerRuntime.Identity)/librunic_server.dylib;$(RunicNativeServerArtifacts)%(_RunicNativeServerRuntime.Identity)/runic_server.dll"
          Runtime="%(_RunicNativeServerRuntime.Identity)" />
      <_RunicNativeServerShared Remove="@(_RunicNativeServerShared)" Condition="!Exists('%(Identity)')" />
      <None Include="@(_RunicNativeServerShared)" Pack="true" PackagePath="runtimes/%(_RunicNativeServerShared.Runtime)/native/" />
      <_RunicNativeServerPacked Include="@(_RunicNativeServerShared->'%(Runtime)')" />
      <_RunicNativeServerMissing Include="@(_RunicNativeServerRuntime)" Exclude="@(_RunicNativeServerPacked)" />
    </ItemGroup>
    <PropertyGroup>
      <_RunicNativeServerRuntimeGraph>$(IntermediateOutputPath)runic-native-server/runtime.json</_RunicNativeServerRuntimeGraph>
      <_RunicNativeServerRuntimeGraphText>{
  "runtimes": {
@(_RunicNativeServerRuntime->'    "%(Identity)": { "$(PackageId)": { "$(PackageId).Static.%(Identity)": "$(PackageVersion)" } }', ',%0A')
  }
}</_RunicNativeServerRuntimeGraphText>
    </PropertyGroup>
    <Error Condition="'@(_RunicNativeServerShared)' == ''"
           Text="No native server library was built under $(RunicNativeServerArtifacts). Run eng/native/build-runic-server.sh first." />
    <Error Condition="'$(RunicNativeServerRequireAllRuntimes)' == 'true' and '@(_RunicNativeServerMissing)' != ''"
           Text="The native server library is missing for @(_RunicNativeServerMissing)." />
    <MakeDir Directories="$(IntermediateOutputPath)runic-native-server" />
    <WriteLinesToFile File="$(_RunicNativeServerRuntimeGraph)" Lines="$(_RunicNativeServerRuntimeGraphText)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <None Include="$(_RunicNativeServerRuntimeGraph)" Pack="true" PackagePath="" />
      <FileWrites Include="$(_RunicNativeServerRuntimeGraph)" />
    </ItemGroup>
    <Message Importance="high" Text="Runic.Desktop.NativeServer packs the native server for @(_RunicNativeServerPacked->Distinct())." />
  </Target>
</Project>
