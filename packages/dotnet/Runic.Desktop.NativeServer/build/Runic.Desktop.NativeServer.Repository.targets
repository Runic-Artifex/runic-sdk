<Project>
  <!-- This repository's own Desktop executables (tests, examples, benchmarks) built with -p:RunicDesktopServer=Native
       reference Runic.Desktop as a project, so they get the package's targets here and the library that
       eng/native/build-runic-server.sh wrote under artifacts/native/runic-server/<rid>/ (or the directory a Nix build
       passes as RunicDesktopNativeServerLibraryDirectory). Not packed. -->
  <PropertyGroup>
    <RunicDesktopNativeServerReferenced>true</RunicDesktopNativeServerReferenced>
    <_RunicDesktopNativeServerRepositoryRuntime>$(RuntimeIdentifier)</_RunicDesktopNativeServerRepositoryRuntime>
    <_RunicDesktopNativeServerRepositoryRuntime Condition="'$(_RunicDesktopNativeServerRepositoryRuntime)' == ''">$(NETCoreSdkRuntimeIdentifier)</_RunicDesktopNativeServerRepositoryRuntime>
    <RunicDesktopNativeServerLibraryDirectory Condition="'$(RunicDesktopNativeServerLibraryDirectory)' == ''">$(MSBuildThisFileDirectory)../../../../artifacts/native/runic-server/$(_RunicDesktopNativeServerRepositoryRuntime)/</RunicDesktopNativeServerLibraryDirectory>
  </PropertyGroup>
  <Import Project="../buildTransitive/Runic.Desktop.NativeServer.targets" />
  <ItemGroup>
    <!-- The package's dependencies: the native server's service provider and logging. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Condition="'@(PackageReference->WithMetadataValue('Identity', 'Microsoft.Extensions.DependencyInjection'))' == ''" />
    <PackageReference Include="Microsoft.Extensions.Logging" Condition="'@(PackageReference->WithMetadataValue('Identity', 'Microsoft.Extensions.Logging'))' == ''" />
  </ItemGroup>
  <Target Name="RunicDesktopRequireRepositoryNativeServer" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(_RunicDesktopNativeServerOverride)$(_RunicDesktopNativeServerSharedName)')"
           Text="RunicDesktopServer=Native needs the native server for $(_RunicDesktopNativeServerRepositoryRuntime) in $(RunicDesktopNativeServerLibraryDirectory). Run eng/native/build-runic-server.sh $(_RunicDesktopNativeServerRepositoryRuntime) first." />
  </Target>
</Project>
