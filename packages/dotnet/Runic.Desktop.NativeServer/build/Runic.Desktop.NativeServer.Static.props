<Project>
  <!-- The static library of native/runic-server for one runtime identifier, which a NativeAOT publish links into the
       executable. Each packages/dotnet/Runic.Desktop.NativeServer.Static/<rid>/*.csproj sets _RunicNativeServerRuntime and imports
       this file. Runic.Desktop.NativeServer's runtime.json makes NuGet restore the package for a runtime-specific
       restore of <rid>; its targets take the library from here and keep it out of the output. -->
  <PropertyGroup>
    <PackageId>Runic.Desktop.NativeServer.Static.$(_RunicNativeServerRuntime)</PackageId>
    <Title>Runic Desktop native server, static library for $(_RunicNativeServerRuntime)</Title>
    <Description>The static library of the native Runic Desktop server for NativeAOT on $(_RunicNativeServerRuntime). Referenced by Runic.Desktop.NativeServer; do not reference it directly.</Description>
    <PackageTags>runic-artifex;desktop;rust;axum;nativeaot</PackageTags>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <IncludeSymbols>false</IncludeSymbols>
    <!-- NU5128: no lib/ folder by design. NU5127: the native asset is for one runtime identifier only. -->
    <NoWarn>$(NoWarn);NU5128;NU5127</NoWarn>
    <_RunicNativeServerArtifacts Condition="'$(_RunicNativeServerArtifacts)' == ''">$(MSBuildThisFileDirectory)../../../../artifacts/native/runic-server/</_RunicNativeServerArtifacts>
    <_RunicNativeServerStaticName Condition="$(_RunicNativeServerRuntime.StartsWith('win-'))">runic_server.lib</_RunicNativeServerStaticName>
    <_RunicNativeServerStaticName Condition="'$(_RunicNativeServerStaticName)' == ''">librunic_server.a</_RunicNativeServerStaticName>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)static/README.md" Pack="true" PackagePath="/" />
    <None Include="$(MSBuildThisFileDirectory)../../../../native/THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" />
    <None Include="$(_RunicNativeServerArtifacts)$(_RunicNativeServerRuntime)/$(_RunicNativeServerStaticName)"
          Pack="true" PackagePath="runtimes/$(_RunicNativeServerRuntime)/native/" Condition="Exists('$(_RunicNativeServerArtifacts)$(_RunicNativeServerRuntime)/$(_RunicNativeServerStaticName)')" />
  </ItemGroup>
  <Target Name="_RunicNativeServerRequireStaticLibrary" BeforeTargets="_GetPackageFiles">
    <Error Condition="!Exists('$(_RunicNativeServerArtifacts)$(_RunicNativeServerRuntime)/$(_RunicNativeServerStaticName)')"
           Text="No static native server library for $(_RunicNativeServerRuntime) under $(_RunicNativeServerArtifacts). Run eng/native/build-runic-server.sh $(_RunicNativeServerRuntime) first." />
  </Target>
</Project>
