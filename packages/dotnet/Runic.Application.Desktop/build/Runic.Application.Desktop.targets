<Project>
  <Target Name="RunicViewsCopyDesktopClient" AfterTargets="Build"
          Condition="'$(RunicBridgeBootstrap)' != 'true'">
    <Copy SourceFiles="$(MSBuildThisFileDirectory)../www/runic-desktop-views.js"
          DestinationFiles="$(TargetDir)www/runic-desktop-views.js"
          SkipUnchangedFiles="true" />
  </Target>
  <Target Name="RunicViewsCopyDesktopClientForPublish" AfterTargets="Publish"
          Condition="'$(RunicBridgeBootstrap)' != 'true'">
    <Copy SourceFiles="$(MSBuildThisFileDirectory)../www/runic-desktop-views.js"
          DestinationFiles="$(PublishDir)www/runic-desktop-views.js"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
