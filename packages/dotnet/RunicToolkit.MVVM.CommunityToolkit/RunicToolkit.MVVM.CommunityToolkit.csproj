<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(RunicToolkitDefaultTargetFramework)</TargetFramework>
    <AssemblyName>RunicToolkit.MVVM.CommunityToolkit</AssemblyName>
    <RootNamespace>RunicToolkit.MVVM.CommunityToolkit</RootNamespace>
    <PackageId>RunicToolkit.MVVM.CommunityToolkit</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>Reflection-free CommunityToolkit.Mvvm adapters for RunicToolkit MVVM.</Description>
    <RunicToolkitShippingProject>true</RunicToolkitShippingProject>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RunicToolkit.MVVM\RunicToolkit.MVVM.csproj" />
    <PackageReference Include="CommunityToolkit.Mvvm"
                      Version="[8.4.2]"
                      PrivateAssets="contentfiles" />
  </ItemGroup>

  <ItemGroup>
    <None Update="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
