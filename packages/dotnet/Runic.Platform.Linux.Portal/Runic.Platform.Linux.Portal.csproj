<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../../eng/build/application.props" />
  <PropertyGroup>
    <TargetFramework>$(RunicToolkitDefaultTargetFramework)</TargetFramework>
    <RunicToolkitShippingProject>true</RunicToolkitShippingProject>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>Runic.Platform.Linux.Portal</PackageId>
    <Description>Direct XDG desktop portal file dialogs and URI opening for Runic applications.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Runic.Platform.Runtime/Runic.Platform.Runtime.csproj" />
    <PackageReference Include="Tmds.DBus.Protocol" />
    <PackageReference Include="Tmds.DBus.Generator" PrivateAssets="all" />
    <AdditionalFiles Include="Protocol/*.xml" Namespace="Runic.Platform.Linux.Portal.Protocol" DBusGeneratorMode="Proxy" />
    <None Remove="Protocol/*.xml;Protocol/COPYING;Protocol/upstream.json" />
    <None Include="Protocol/*.xml;Protocol/COPYING;Protocol/upstream.json" Pack="true" PackagePath="protocol/" />
    <InternalsVisibleTo Include="Runic.Platform.Linux.Portal.Tests" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <Import Project="../../../eng/build/application.targets" />
</Project>
