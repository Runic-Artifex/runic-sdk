<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../../eng/build/platform.props" />
  <PropertyGroup>
    <TargetFramework>$(RunicApplicationDefaultTargetFramework)</TargetFramework>
    <RunicApplicationShippingProject>true</RunicApplicationShippingProject>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>Runic.Platform.Linux.Portal</PackageId>
    <Description>The Linux provider of the Runic.Platform services, built on XDG desktop portals, D-Bus services and freedesktop.org specifications.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Runic.Platform.Runtime/Runic.Platform.Runtime.csproj" />
    <!-- The IDesktopApplications argument checks, shared with DesktopApplications.Unavailable without a public type. -->
    <Compile Include="../Runic.Platform/DesktopApplicationNames.cs" Link="Shared/DesktopApplicationNames.cs" />
    <PackageReference Include="Tmds.DBus.Protocol" />
    <PackageReference Include="Tmds.DBus.Generator" PrivateAssets="all" />
    <AdditionalFiles Include="Protocol/*.xml" Namespace="Runic.Platform.Linux.Portal.Protocol" DBusGeneratorMode="Proxy" />
    <!-- UDisks2 proxies from the public D-Bus API's generator; Tmds.DBus.Generator leaves this file alone. The public
         D-Bus client also activates desktop applications (org.freedesktop.Application). -->
    <ProjectReference Include="../Runic.Platform.Linux.DBus/Runic.Platform.Linux.DBus.csproj" />
    <ProjectReference Include="../Runic.Platform.Linux.DBus.Generator/Runic.Platform.Linux.DBus.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all"
        UndefineProperties="RuntimeIdentifier;SelfContained;PublishAot;IlcTreatWarningsAsErrors" />
    <AdditionalFiles Include="UDisks/org.freedesktop.UDisks2.xml" RunicDBusMode="Proxy" RunicDBusNamespace="Runic.Platform.Linux.Portal.UDisks" GenerateDBusTypes="false" />
    <AdditionalFiles Include="Thumbnails/org.freedesktop.thumbnails.Thumbnailer1.xml" RunicDBusMode="Proxy" RunicDBusNamespace="Runic.Platform.Linux.Portal.Thumbnails" GenerateDBusTypes="false" />
    <None Remove="Protocol/*.xml;Protocol/COPYING;Protocol/upstream.json;UDisks/*.xml;Thumbnails/*.xml" />
    <None Include="Protocol/*.xml;Protocol/COPYING;Protocol/upstream.json" Pack="true" PackagePath="protocol/" />
    <InternalsVisibleTo Include="Runic.Platform.Linux.Portal.Tests" />
    <!-- Shipping packages pin each other exactly; GTK 3 shares document-portal classification. -->
    <InternalsVisibleTo Include="Runic.Platform.Linux" />
    <!-- Runic's hosts create the window services (dialogs, file handoff, window inhibition) for each window. -->
    <InternalsVisibleTo Include="Runic.Application.Views.Desktop" />
    <InternalsVisibleTo Include="Runic.Desktop.Gtk4.Smoke" />
    <InternalsVisibleTo Include="Runic.Platform.Runtime.Tests" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <Import Project="../Runic.Platform.Linux.DBus/buildTransitive/Runic.Platform.Linux.DBus.props" />
  <Import Project="../../../eng/build/application.targets" />
</Project>
