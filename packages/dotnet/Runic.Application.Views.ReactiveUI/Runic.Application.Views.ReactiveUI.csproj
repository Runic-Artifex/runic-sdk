<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../../eng/build/application.props" />
  <PropertyGroup>
    <TargetFramework>$(RunicToolkitDefaultTargetFramework)</TargetFramework>
    <RunicToolkitShippingProject>true</RunicToolkitShippingProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>Runic.Application.ReactiveUI</PackageId>
    <Description>ReactiveUI routing, view location, and activation for Runic Views.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="ReactiveUI" />
    <ProjectReference Include="../Runic.Application.Views/Runic.Application.Views.csproj" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <Import Project="../../../eng/build/application.targets" />
</Project>
