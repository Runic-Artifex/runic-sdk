<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../../eng/build/application.props" />
  <PropertyGroup>
    <TargetFramework>$(RunicApplicationDefaultTargetFramework)</TargetFramework>
    <RunicApplicationShippingProject>true</RunicApplicationShippingProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>Runic.Application.Views.ReactiveUI</PackageId>
    <Description>ReactiveUI 26 (Primitives flavor) model-context scheduling, routing, view location, and activation for Runic Views.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="ReactiveUI" />
    <!-- Direct references bound every package whose types the public API exposes (eng/release/README.md). -->
    <PackageReference Include="ReactiveUI.Core" />
    <PackageReference Include="ReactiveUI.Binding" />
    <PackageReference Include="ReactiveUI.Primitives" />
    <InternalsVisibleTo Include="Runic.Application.Testing.Tests" />
    <ProjectReference Include="../Runic.Application.Views/Runic.Application.Views.csproj" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <Import Project="../../../eng/build/application.targets" />
</Project>
