<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(WebUIToolkitDefaultTargetFramework)</TargetFramework>
    <AssemblyName>WebUIToolkit.MVVM.CommunityToolkit</AssemblyName>
    <RootNamespace>WebUIToolkit.MVVM.CommunityToolkit</RootNamespace>
    <PackageId>WebUIToolkit.MVVM.CommunityToolkit</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>Reflection-free CommunityToolkit.Mvvm adapters for WebUIToolkit MVVM.</Description>
    <WebUIToolkitShippingProject>true</WebUIToolkitShippingProject>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WebUIToolkit.MVVM\WebUIToolkit.MVVM.csproj" />
    <PackageReference Include="CommunityToolkit.Mvvm"
                      Version="[8.4.2]"
                      PrivateAssets="contentfiles" />
  </ItemGroup>

  <ItemGroup>
    <None Update="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
