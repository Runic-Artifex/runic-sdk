<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../../eng/build/application.props" />
  <PropertyGroup>
    <TargetFramework>$(RunicApplicationDefaultTargetFramework)</TargetFramework>
    <RunicApplicationShippingProject>true</RunicApplicationShippingProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>Runic.Navigation.ReactiveUI.Reactive</PackageId>
    <Description>System.Reactive-flavor observables, commands and interaction leave confirmation for Runic.Navigation regions and entries.</Description>
    <PackageTags>runic-artifex;navigation;reactiveui;system-reactive;mvvm;dotnet</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- First published in 0.7.0-preview.4; remove after that release (eng/release/README.md). -->
    <!-- Selects the System.Reactive namespaces in the source shared with
         Runic.Navigation.ReactiveUI. Only the scheduler adapter differs. -->
    <DefineConstants>$(DefineConstants);SYSTEM_REACTIVE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ReactiveUI.Reactive" />
    <!-- Direct references bound every package whose types the public API exposes (eng/release/README.md). -->
    <PackageReference Include="ReactiveUI.Binding.Reactive" />
    <PackageReference Include="ReactiveUI.Primitives.Reactive" />
    <PackageReference Include="System.Reactive" />
    <ProjectReference Include="../Runic.Navigation/Runic.Navigation.csproj" />
    <Compile Include="../Runic.Navigation.ReactiveUI/ReactiveNavigation.cs" Link="Shared/ReactiveNavigation.cs" />
    <Compile Include="../Runic.Navigation.ReactiveUI/ReactiveNavigationEntry.cs" Link="Shared/ReactiveNavigationEntry.cs" />
    <Compile Include="../Runic.Navigation.ReactiveUI/ReactiveLeaveConfirmation.cs" Link="Shared/ReactiveLeaveConfirmation.cs" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <Import Project="../../../eng/build/application.targets" />
</Project>
