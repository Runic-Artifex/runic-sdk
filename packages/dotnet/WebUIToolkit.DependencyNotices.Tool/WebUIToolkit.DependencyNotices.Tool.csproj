<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(WebUIToolkitDefaultTargetFramework)</TargetFramework>
    <WebUIToolkitShippingProject>true</WebUIToolkitShippingProject>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>dependency-notices</ToolCommandName>
    <PackageId>WebUIToolkit.DependencyNotices.Tool</PackageId>
    <Description>Deterministic command-line tool for dependency notice workflows.</Description>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../WebUIToolkit.DependencyNotices.Core/WebUIToolkit.DependencyNotices.Core.csproj" />
    <ProjectReference Include="../WebUIToolkit.DependencyNotices.Engine/WebUIToolkit.DependencyNotices.Engine.csproj" />
    <ProjectReference Include="../WebUIToolkit.DependencyNotices.Acquisition/WebUIToolkit.DependencyNotices.Acquisition.csproj" />
    <ProjectReference Include="../WebUIToolkit.DependencyNotices.Npm/WebUIToolkit.DependencyNotices.Npm.csproj" />
    <ProjectReference Include="../WebUIToolkit.DependencyNotices.NuGet/WebUIToolkit.DependencyNotices.NuGet.csproj" />
    <ProjectReference Include="../WebUIToolkit.DependencyNotices.Policy/WebUIToolkit.DependencyNotices.Policy.csproj" />
    <ProjectReference Include="../WebUIToolkit.DependencyNotices.Rendering/WebUIToolkit.DependencyNotices.Rendering.csproj" />
    <ProjectReference Include="../WebUIToolkit.DependencyNotices.Sbom/WebUIToolkit.DependencyNotices.Sbom.csproj" />
  </ItemGroup>
</Project>
