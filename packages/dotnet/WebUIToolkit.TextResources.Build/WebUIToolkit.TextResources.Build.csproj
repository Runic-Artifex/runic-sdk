<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(WebUIToolkitGeneratorTargetFramework)</TargetFramework>
    <AssemblyName>WebUIToolkit.TextResources.Build</AssemblyName>
    <RootNamespace>WebUIToolkit.TextResources.Build</RootNamespace>
    <PackageId>WebUIToolkit.TextResources.Build</PackageId>
    <Description>Deterministic MSBuild integration for WebUIToolkit text-resource artifacts.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <None Update="README.md" Pack="true" PackagePath="\" />
    <None Update="build\WebUIToolkit.TextResources.Build.props"
          Pack="true"
          PackagePath="build\WebUIToolkit.TextResources.Build.props" />
    <None Update="build\WebUIToolkit.TextResources.Build.targets"
          Pack="true"
          PackagePath="build\WebUIToolkit.TextResources.Build.targets" />
  </ItemGroup>
</Project>
