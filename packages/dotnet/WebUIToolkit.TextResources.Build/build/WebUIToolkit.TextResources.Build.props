<Project>
  <PropertyGroup>
    <!-- Artifact generation is opt-in. Mapping declared inputs to AdditionalFiles is always enabled. -->
    <TextResourcesGenerateOnBuild Condition="'$(TextResourcesGenerateOnBuild)' == ''">false</TextResourcesGenerateOnBuild>
    <TextResourcesEmitJson Condition="'$(TextResourcesEmitJson)' == ''">false</TextResourcesEmitJson>
    <TextResourcesEmitTypeScript Condition="'$(TextResourcesEmitTypeScript)' == ''">false</TextResourcesEmitTypeScript>
    <TextResourcesEmitTemplateManifest Condition="'$(TextResourcesEmitTemplateManifest)' == ''">false</TextResourcesEmitTemplateManifest>

    <!-- Keep the launcher replaceable for local tools, pinned tool manifests, and package tests. -->
    <TextResourcesToolCommand Condition="'$(TextResourcesToolCommand)' == ''">dotnet tool run dotnet-textresources</TextResourcesToolCommand>
    <TextResourcesToolAdditionalArguments Condition="'$(TextResourcesToolAdditionalArguments)' == ''"></TextResourcesToolAdditionalArguments>

    <WebUIToolkitTextResourcesBuildPropsImported>true</WebUIToolkitTextResourcesBuildPropsImported>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)\.config\dotnet-tools.json')">
    <TextResourcesToolInput Include="$(MSBuildProjectDirectory)\.config\dotnet-tools.json" />
  </ItemGroup>
</Project>
