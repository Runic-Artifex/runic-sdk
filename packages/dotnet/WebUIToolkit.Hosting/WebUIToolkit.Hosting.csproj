<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(WebUIToolkitDefaultTargetFramework)</TargetFramework>
    <WebUIToolkitShippingProject>true</WebUIToolkitShippingProject>
    <AssemblyName>WebUIToolkit.Hosting</AssemblyName>
    <RootNamespace>WebUIToolkit.Hosting</RootNamespace>
    <PackageId>WebUIToolkit.Hosting</PackageId>
    <Description>Deterministic application lifecycle orchestration for WebUIToolkit.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WebUIToolkit.Hosting.Abstractions\WebUIToolkit.Hosting.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
