<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(WebUIToolkitGeneratorTargetFramework)</TargetFramework>
    <AssemblyName>WebUIToolkit.TextResources.Generator</AssemblyName>
    <RootNamespace>WebUIToolkit.TextResources.Generator</RootNamespace>
    <Description>Incremental C# source generator for WebUIToolkit text resources.</Description>
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <DevelopmentDependency>true</DevelopmentDependency>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NuspecFile>WebUIToolkit.TextResources.Generator.nuspec</NuspecFile>
    <CentralPackageVersionOverrideEnabled>true</CentralPackageVersionOverrideEnabled>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <!-- The repository deliberately requires a .NET 10 compiler host for every artifact. -->
    <NoWarn>$(NoWarn);RS1041</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" VersionOverride="4.14.0" PrivateAssets="all" />
    <ProjectReference Include="..\WebUIToolkit.TextResources.Compiler\WebUIToolkit.TextResources.Compiler.csproj" PrivateAssets="all" />
  </ItemGroup>

  <Target Name="SetTextResourcesGeneratorNuspecProperties" BeforeTargets="GenerateNuspec">
    <PropertyGroup>
      <NuspecProperties>configuration=$(Configuration);packageVersion=$(PackageVersion)</NuspecProperties>
    </PropertyGroup>
  </Target>
</Project>
