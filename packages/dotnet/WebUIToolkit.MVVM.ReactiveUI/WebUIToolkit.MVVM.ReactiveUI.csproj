<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(WebUIToolkitDefaultTargetFramework)</TargetFramework>
    <AssemblyName>WebUIToolkit.MVVM.ReactiveUI</AssemblyName>
    <RootNamespace>WebUIToolkit.MVVM.ReactiveUI</RootNamespace>
    <PackageId>WebUIToolkit.MVVM.ReactiveUI</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>Reflection-free ReactiveUI adapters for WebUIToolkit MVVM.</Description>
    <WebUIToolkitShippingProject>true</WebUIToolkitShippingProject>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WebUIToolkit.MVVM\WebUIToolkit.MVVM.csproj" />
    <PackageReference Include="ReactiveUI"
                      Version="[22.3.1,24.0.0)"
                      PrivateAssets="contentfiles" />
  </ItemGroup>

  <ItemGroup>
    <None Update="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
