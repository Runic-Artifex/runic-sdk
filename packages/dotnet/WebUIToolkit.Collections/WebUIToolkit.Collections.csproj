<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(WebUIToolkitDefaultTargetFramework)</TargetFramework>
    <WebUIToolkitShippingProject>true</WebUIToolkitShippingProject>
    <AssemblyName>WebUIToolkit.Collections</AssemblyName>
    <RootNamespace>WebUIToolkit.Collections</RootNamespace>
    <PackageId>WebUIToolkit.Collections</PackageId>
