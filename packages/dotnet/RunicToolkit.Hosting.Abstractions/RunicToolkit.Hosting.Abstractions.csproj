<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(RunicToolkitDefaultTargetFramework)</TargetFramework>
    <RunicToolkitShippingProject>true</RunicToolkitShippingProject>
    <AssemblyName>RunicToolkit.Hosting.Abstractions</AssemblyName>
    <RootNamespace>RunicToolkit.Hosting</RootNamespace>
    <PackageId>RunicToolkit.Hosting.Abstractions</PackageId>
    <Description>Dependency-neutral application hosting contracts for RunicToolkit.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RunicToolkit.Desktop\RunicToolkit.Desktop.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
