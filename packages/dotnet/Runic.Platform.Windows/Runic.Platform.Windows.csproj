<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../../eng/build/platform.props" />
  <PropertyGroup>
    <TargetFramework>$(RunicApplicationDefaultTargetFramework)</TargetFramework>
    <RunicApplicationShippingProject>true</RunicApplicationShippingProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <PackageId>Runic.Platform.Windows</PackageId>
    <Description>Explicit Windows native file dialog and text clipboard provider for Runic.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
    <ProjectReference Include="../Runic.Platform.Runtime/Runic.Platform.Runtime.csproj" />
    <InternalsVisibleTo Include="Runic.Platform.Windows.Tests" />
    <InternalsVisibleTo Include="Runic.Platform.Runtime.Tests" />
    <!-- PlatformServices selects the status icon and window presentation without widening this package's API. -->
    <InternalsVisibleTo Include="Runic.Application.Views.Desktop" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="docs/**/*.md" Pack="true" PackagePath="docs/" />
  </ItemGroup>
  <Import Project="../../../eng/build/application.targets" />
</Project>
