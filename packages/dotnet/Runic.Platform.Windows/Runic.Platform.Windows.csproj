<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../../eng/build/platform.props" />
  <PropertyGroup>
    <TargetFramework>$(RunicApplicationDefaultTargetFramework)</TargetFramework>
    <RunicApplicationShippingProject>true</RunicApplicationShippingProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <PackageId>Runic.Platform.Windows</PackageId>
    <Description>The Windows provider of the Runic.Platform services: desktop services, status icon, and the window services of Runic hosts.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
    <ProjectReference Include="../Runic.Platform.Runtime/Runic.Platform.Runtime.csproj" />
    <!-- The argument checks of IDesktopApplications, shared with Runic.Platform so every platform rejects the same calls. -->
    <Compile Include="../Runic.Platform/DesktopApplicationNames.cs" Link="Shared/DesktopApplicationNames.cs" />
    <InternalsVisibleTo Include="Runic.Platform.Windows.Tests" />
    <InternalsVisibleTo Include="Runic.Platform.Runtime.Tests" />
    <!-- The packaging job's probe reports which activation the package delivered (WindowsActivation). -->
    <InternalsVisibleTo Include="Runic.Packaging.Probe" />
    <!-- DesktopPlatformServices creates each window's services and presentation, which are not public API. -->
    <InternalsVisibleTo Include="Runic.Application.Views.Desktop" />
    <!-- The window services (dialogs, clipboard, file handoff) are internal; the native smoke drives the dialogs directly. -->
    <InternalsVisibleTo Include="Runic.Desktop.WebViewSmoke" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="docs/**/*.md" Pack="true" PackagePath="docs/" />
  </ItemGroup>
  <Import Project="../../../eng/build/application.targets" />
</Project>
