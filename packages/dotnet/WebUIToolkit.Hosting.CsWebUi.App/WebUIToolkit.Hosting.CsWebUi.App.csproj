<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(WebUIToolkitDefaultTargetFramework)</TargetFramework>
    <WebUIToolkitShippingProject>true</WebUIToolkitShippingProject>
    <AssemblyName>WebUIToolkit.Hosting.CsWebUi.App</AssemblyName>
    <RootNamespace>WebUIToolkit.Hosting.CsWebUi</RootNamespace>
    <PackageId>WebUIToolkit.Hosting.CsWebUi.App</PackageId>
    <Version>1.0.0-beta.1</Version>
    <Description>High-level WebUiApp composition for native CsWebUi frontends.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WebUIToolkit.Desktop\WebUIToolkit.Desktop.csproj" />
    <ProjectReference Include="..\WebUIToolkit.Hosting\WebUIToolkit.Hosting.csproj" />
    <ProjectReference Include="..\WebUIToolkit.Hosting.CsWebUi\WebUIToolkit.Hosting.CsWebUi.csproj" />
    <ProjectReference Include="..\WebUIToolkit.Hosting.GenericHost\WebUIToolkit.Hosting.GenericHost.csproj" />
    <ProjectReference Include="..\WebUIToolkit.Hosting.WebUi\WebUIToolkit.Hosting.WebUi.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="PUBLIC-API.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
