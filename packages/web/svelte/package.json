{
  "name": "@runic-artifex/svelte",
  "version": "0.1.0-preview.0",
  "description": "Svelte 5 integration for the Runic Toolkit Application Bridge",
  "license": "MIT",
  "type": "module",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "svelte-package -i src -o dist",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "npm run build && vitest run",
    "pack:check": "npm pack --dry-run"
  },
  "peerDependencies": {
    "@runic-artifex/application-bridge": ">=0.1.0-preview <1",
    "svelte": ">=5.7.0 <6"
  },
  "peerDependenciesMeta": {
    "@runic-artifex/application-bridge": {
      "optional": true
    }
  },
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Runic-Artifex/runic-svelte.git",
    "directory": "packages/svelte"
  }
}
