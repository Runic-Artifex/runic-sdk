{
  "name": "@runic-artifex/svelte",
  "version": "1.0.0-preview.1",
  "description": "Svelte 5 integration for the Runic Toolkit Application Bridge",
  "homepage": "https://github.com/Runic-Artifex/runic-svelte#readme",
  "bugs": {
    "url": "https://github.com/Runic-Artifex/runic-svelte/issues"
  },
  "keywords": [
    "runic-artifex",
    "runic-toolkit",
    "application-bridge",
    "svelte",
    "svelte-5"
  ],
  "license": "MIT",
  "type": "module",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./translations": {
      "types": "./dist/translations/index.d.ts",
      "svelte": "./dist/translations/index.js",
      "import": "./dist/translations/index.js"
    },
    "./translations/testing": {
      "types": "./dist/translations/testing.d.ts",
      "import": "./dist/translations/testing.js"
    },
    "./bridge": {
      "types": "./dist/bridge.svelte.d.ts",
      "svelte": "./dist/bridge.svelte.js",
      "import": "./dist/bridge.svelte.js"
    },
    "./hosted": {
      "types": "./dist/hosted.svelte.d.ts",
      "svelte": "./dist/hosted.svelte.js",
      "import": "./dist/hosted.svelte.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "svelte-package -i src -o dist",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "npm run build && vitest run",
    "pack:check": "npm pack --dry-run"
  },
  "peerDependencies": {
    "@runic-artifex/application-bridge": ">=1.0.0-preview.1 <2",
    "@runic-artifex/vite-plugin-runic": ">=1.0.0-preview.1 <2",
    "effect": ">=3.22.1 <4",
    "svelte": ">=5.46.4 <6"
  },
  "peerDependenciesMeta": {
    "@runic-artifex/application-bridge": {
      "optional": true
    },
    "@runic-artifex/vite-plugin-runic": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Runic-Artifex/runic-svelte.git",
    "directory": "packages/svelte"
  }
}
