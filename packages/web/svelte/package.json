{
  "name": "@runic-artifex/svelte",
  "version": "0.4.0-preview.1",
  "description": "Svelte 5 localization and inline content helpers for Runic",
  "homepage": "https://github.com/Runic-Artifex/runic-sdk/tree/main/packages/web/svelte#readme",
  "bugs": {
    "url": "https://github.com/Runic-Artifex/runic-sdk/issues"
  },
  "keywords": [
    "runic-artifex",
    "translations",
    "svelte",
    "svelte-5"
  ],
  "license": "MIT",
  "type": "module",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./translations": {
      "types": "./dist/translations/index.d.ts",
      "svelte": "./dist/translations/index.js",
      "import": "./dist/translations/index.js"
    },
    "./translations/testing": {
      "types": "./dist/translations/testing.d.ts",
      "import": "./dist/translations/testing.js"
    },
    "./inline": {
      "types": "./dist/inline/index.d.ts",
      "svelte": "./dist/inline/index.js",
      "import": "./dist/inline/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "svelte-package -i src -o dist",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "bun run --bun build && vitest run test/locale.svelte.test.ts test/locale-hydration.svelte.test.ts test/localization-stress.test.ts && node test/verify-inline-ssr.mjs",
    "pack:check": "bun pm pack --dry-run",
    "test:inline-browser": "node test/verify-inline-ssr.mjs && node test/verify-inline-hydration.mjs"
  },
  "peerDependencies": {
    "svelte": ">=5.46.4 <6"
  },
  "publishConfig": {
    "access": "public",
    "tag": "preview"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Runic-Artifex/runic-sdk.git",
    "directory": "packages/web/svelte"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/package": "2.5.8",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@types/node": "24.13.3",
    "happy-dom": "^20.14.0",
    "svelte": "5.57.0",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vitest": "5.0.0",
    "vite": "8.2.2"
  }
}
