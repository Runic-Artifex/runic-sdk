{
  "name": "@runic-artifex/svelte",
  "version": "1.0.0-preview.1",
  "description": "Svelte 5 integration for the Runic Toolkit Application Bridge",
  "homepage": "https://github.com/Runic-Artifex/runic-sdk/tree/main/packages/web/svelte#readme",
  "bugs": {
    "url": "https://github.com/Runic-Artifex/runic-sdk/issues"
  },
  "keywords": [
    "runic-artifex",
    "runic-toolkit",
    "application-bridge",
    "svelte",
    "svelte-5"
  ],
  "license": "MIT",
  "type": "module",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./translations": {
      "types": "./dist/translations/index.d.ts",
      "svelte": "./dist/translations/index.js",
      "import": "./dist/translations/index.js"
    },
    "./translations/testing": {
      "types": "./dist/translations/testing.d.ts",
      "import": "./dist/translations/testing.js"
    },
    "./bridge": {
      "types": "./dist/bridge.svelte.d.ts",
      "svelte": "./dist/bridge.svelte.js",
      "import": "./dist/bridge.svelte.js"
    },
    "./hosted": {
      "types": "./dist/hosted.svelte.d.ts",
      "svelte": "./dist/hosted.svelte.js",
      "import": "./dist/hosted.svelte.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "svelte-package -i src -o dist",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "bun run build && vitest run",
    "pack:check": "bun pm pack --dry-run"
  },
  "peerDependencies": {
    "@runic-artifex/application-bridge": ">=1.0.0-preview.1 <2",
    "@runic-artifex/vite-plugin-runic": ">=1.0.0-preview.1 <2",
    "effect": ">=3.22.1 <4",
    "svelte": ">=5.46.4 <6"
  },
  "peerDependenciesMeta": {
    "@runic-artifex/application-bridge": {
      "optional": true
    },
    "@runic-artifex/vite-plugin-runic": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Runic-Artifex/runic-sdk.git",
    "directory": "packages/web/svelte"
  },
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "devDependencies": {
    "@runic-artifex/application-bridge": "workspace:*",
    "@runic-artifex/vite-plugin-runic": "workspace:*",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.70.2",
    "@sveltejs/package": "2.5.8",
    "@sveltejs/vite-plugin-svelte": "7.2.0",
    "@types/node": "24.10.12",
    "effect": "3.22.1",
    "happy-dom": "^20.11.2",
    "svelte": "5.56.8",
    "svelte-check": "4.7.5",
    "typescript": "5.9.3",
    "vitest": "4.1.10",
    "vite": "8.2.1"
  }
}
