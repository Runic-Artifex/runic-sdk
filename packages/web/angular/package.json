{
  "name": "@runic-artifex/angular",
  "version": "0.15.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "default": "./dist/esm/index.js"
    },
    "./forms": {
      "types": "./dist/esm/forms/index.d.ts",
      "import": "./dist/esm/forms/index.js",
      "default": "./dist/esm/forms/index.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@angular/core": ">=22.0.0 <23",
    "@angular/forms": ">=22.0.0 <23",
    "@runic-artifex/views": "0.15.0"
  },
  "peerDependenciesMeta": {
    "@angular/forms": {
      "optional": true
    }
  },
  "description": "Angular outlet and signals for Runic Views",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Runic-Artifex/runic-sdk.git",
    "directory": "packages/web/angular"
  },
  "homepage": "https://github.com/Runic-Artifex/runic-sdk/tree/main/packages/web/angular#readme",
  "bugs": {
    "url": "https://github.com/Runic-Artifex/runic-sdk/issues"
  },
  "publishConfig": {
    "access": "public",
    "tag": "preview"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "packageManager": "bun@1.4.4",
  "sideEffects": false,
  "main": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "scripts": {
    "build": "ngc -p tsconfig.json",
    "check": "ngc -p tsconfig.json --noEmit",
    "test": "bun run --bun build && tsc -p tsconfig.test.json && vitest run",
    "pack:check": "bun pm pack --dry-run"
  },
  "devDependencies": {
    "@runic-artifex/views": "workspace:*",
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/compiler-cli": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "esbuild": "0.28.2",
    "happy-dom": "21.0.4",
    "playwright-core": "1.63.0",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
