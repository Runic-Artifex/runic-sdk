{
  "name": "@runic-artifex/vue",
  "version": "0.13.0",
  "description": "Vue composables for generated Runic Views clients",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "bun -e \"import('node:fs').then(({rmSync}) => rmSync('dist', { recursive: true, force: true }))\"",
    "build": "bun run --bun clean && tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "bun run --bun build && tsc -p tsconfig.json --noEmit && vitest run",
    "pack:check": "bun pm pack --dry-run"
  },
  "peerDependencies": {
    "vue": ">=3.5.30 <4",
    "@runic-artifex/views": "0.13.0"
  },
  "devDependencies": {
    "@runic-artifex/views": "workspace:*",
    "esbuild": "0.28.2",
    "happy-dom": "21.0.4",
    "playwright-core": "1.63.0",
    "typescript": "6.0.3",
    "vitest": "5.0.3",
    "vue": "3.5.43"
  },
  "publishConfig": {
    "access": "public",
    "tag": "preview"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Runic-Artifex/runic-sdk.git",
    "directory": "packages/web/vue"
  },
  "homepage": "https://github.com/Runic-Artifex/runic-sdk/tree/main/packages/web/vue#readme",
  "bugs": {
    "url": "https://github.com/Runic-Artifex/runic-sdk/issues"
  },
  "keywords": [
    "runic-artifex",
    "runic",
    "views",
    "vue"
  ]
}
