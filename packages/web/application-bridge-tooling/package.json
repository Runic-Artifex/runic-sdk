{
  "name": "@runic-artifex/application-bridge-tooling",
  "version": "1.0.0-preview.1",
  "description": "Compiler and development tooling for Runic Application Bridge contracts.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Runic-Artifex/runic-toolkit.git",
    "directory": "web/packages/application-bridge-tooling"
  },
  "homepage": "https://github.com/Runic-Artifex/runic-toolkit/tree/main/web/packages/application-bridge-tooling",
  "bugs": {
    "url": "https://github.com/Runic-Artifex/runic-toolkit/issues"
  },
  "keywords": ["runic-artifex", "application-bridge", "effect", "compiler", "code-generation"],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "runic-bridge": "./dist/esm/cli.js"
  },
  "files": ["dist", "README.md"],
  "engines": {
    "node": ">=24.18.0"
  },
  "scripts": {
    "clean": "node --input-type=module --eval \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\"",
    "build": "npm run clean && tsc --project tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "esbuild": "0.28.1"
  },
  "peerDependencies": {
    "@runic-artifex/application-bridge": "1.0.0-preview.1",
    "effect": "3.22.1"
  },
  "devDependencies": {
    "@runic-artifex/application-bridge": "workspace:*",
    "@types/node": "24.10.12",
    "effect": "3.22.1",
    "typescript": "7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
