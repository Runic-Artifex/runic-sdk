{
  "name": "@runic-artifex/application-bridge-tooling",
  "version": "0.3.0-preview.1",
  "description": "Compiler and development tooling for Runic Application Bridge contracts.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Runic-Artifex/runic-sdk.git",
    "directory": "packages/web/application-bridge-tooling"
  },
  "homepage": "https://github.com/Runic-Artifex/runic-sdk/tree/main/packages/web/application-bridge-tooling#readme",
  "bugs": {
    "url": "https://github.com/Runic-Artifex/runic-sdk/issues"
  },
  "keywords": [
    "runic-artifex",
    "application-bridge",
    "effect",
    "compiler",
    "code-generation"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "runic-bridge": "./dist/esm/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "clean": "bun --input-type=module --eval \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\"",
    "build": "bun run --bun clean && tsc --project tsconfig.json && bun -e \"require('node:fs').chmodSync('dist/esm/cli.js', 0o755)\"",
    "test": "bun run --bun build && bun test --timeout 120000 test/*.test.mjs",
    "prepack": "bun run --bun build"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-rc.112",
    "esbuild": "0.28.2"
  },
  "peerDependencies": {
    "@runic-artifex/application-bridge": "0.3.0-preview.1",
    "effect": "4.0.0-rc.112"
  },
  "devDependencies": {
    "@runic-artifex/application-bridge": "workspace:*",
    "@types/node": "24.13.3",
    "effect": "4.0.0-rc.112",
    "typescript": "7.0.2"
  },
  "publishConfig": {
    "access": "public",
    "tag": "preview"
  },
  "packageManager": "bun@1.4.2"
}
