{
  "name": "@runic-artifex/desktop",
  "version": "1.0.0-preview.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Runic-Artifex/runic-sdk.git",
    "directory": "packages/web/desktop"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "Effect-native browser transport for Runic Desktop presentation hosts.",
  "homepage": "https://github.com/Runic-Artifex/runic-sdk/tree/main/packages/web/desktop#readme",
  "bugs": {
    "url": "https://github.com/Runic-Artifex/runic-sdk/issues"
  },
  "keywords": [
    "runic-artifex",
    "desktop",
    "effect",
    "typescript",
    "webview"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/esm/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "default": "./dist/esm/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "clean": "bun --input-type=module --eval \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\"",
    "build": "bun run --bun clean && tsc --project tsconfig.json",
    "test": "bun run --bun build && bun test --timeout 120000 ./test",
    "prepack": "bun run --bun build"
  },
  "dependencies": {
    "effect": "3.22.1"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.4.0"
}
