{
  "name": "@runic-artifex/sveltekit",
  "version": "1.0.0-preview.1",
  "description": "SvelteKit integration for Runic Toolkit applications",
  "homepage": "https://github.com/Runic-Artifex/runic-sdk/tree/main/packages/web/sveltekit#readme",
  "bugs": {
    "url": "https://github.com/Runic-Artifex/runic-sdk/issues"
  },
  "keywords": [
    "runic-artifex",
    "runic-toolkit",
    "svelte",
    "sveltekit",
    "vite",
    "adapter"
  ],
  "license": "MIT",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./page-options": {
      "types": "./dist/page-options.d.ts",
      "import": "./dist/page-options.js"
    },
    "./translations": {
      "types": "./dist/translations/index.d.ts",
      "import": "./dist/translations/index.js"
    },
    "./translations/navigation": {
      "types": "./dist/translations/navigation.d.ts",
      "svelte": "./dist/translations/navigation.js",
      "import": "./dist/translations/navigation.js"
    },
    "./hosted": {
      "types": "./dist/hosted/index.d.ts",
      "import": "./dist/hosted/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "bun run --bun build && vitest run",
    "pack:check": "bun pm pack --dry-run"
  },
  "peerDependencies": {
    "@runic-artifex/svelte": ">=1.0.0-preview.1 <2",
    "@runic-artifex/vite-plugin-runic": ">=1.0.0-preview.1 <2",
    "@sveltejs/adapter-static": ">=3 <4",
    "@sveltejs/kit": ">=2.53.0 <3",
    "@sveltejs/vite-plugin-svelte": ">=7 <8",
    "svelte": ">=5.46.4 <6",
    "vite": ">=8 <9"
  },
  "peerDependenciesMeta": {
    "@runic-artifex/svelte": {
      "optional": true
    },
    "@runic-artifex/vite-plugin-runic": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Runic-Artifex/runic-sdk.git",
    "directory": "packages/web/sveltekit"
  },
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "dependencies": {
    "@types/cookie": "0.6.0"
  },
  "devDependencies": {
    "@runic-artifex/application-bridge": "workspace:*",
    "@runic-artifex/svelte": "workspace:*",
    "@runic-artifex/vite-plugin-runic": "workspace:*",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.70.2",
    "@sveltejs/package": "2.5.8",
    "@sveltejs/vite-plugin-svelte": "7.2.0",
    "@types/node": "24.10.12",
    "effect": "3.22.1",
    "happy-dom": "^20.11.2",
    "svelte": "5.56.8",
    "svelte-check": "4.7.5",
    "typescript": "5.9.3",
    "vitest": "4.1.10",
    "vite": "8.2.1"
  }
}
