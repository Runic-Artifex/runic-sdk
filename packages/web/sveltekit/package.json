{
  "name": "@runic-artifex/sveltekit",
  "version": "0.7.0-preview.5",
  "description": "SvelteKit adapter for Runic Desktop applications",
  "homepage": "https://github.com/Runic-Artifex/runic-sdk/tree/main/packages/web/sveltekit#readme",
  "bugs": {
    "url": "https://github.com/Runic-Artifex/runic-sdk/issues"
  },
  "keywords": [
    "runic-artifex",
    "svelte",
    "sveltekit",
    "vite",
    "adapter"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./page-options": {
      "types": "./dist/page-options.d.ts",
      "import": "./dist/page-options.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "bun -e \"import('node:fs').then(({rmSync}) => rmSync('dist', { recursive: true, force: true }))\"",
    "build": "bun run --bun clean && tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "bun run --bun build && vitest run test/adapter.test.ts test/spa-reference-app.test.ts",
    "pack:check": "bun pm pack --dry-run"
  },
  "peerDependencies": {
    "@sveltejs/adapter-static": ">=4 <5",
    "@sveltejs/kit": ">=3 <4",
    "@sveltejs/vite-plugin-svelte": ">=7 <8",
    "svelte": ">=5.57.1 <6",
    "vite": ">=8.0.12 <9"
  },
  "publishConfig": {
    "access": "public",
    "tag": "preview"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Runic-Artifex/runic-sdk.git",
    "directory": "packages/web/sveltekit"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "4.0.0",
    "@sveltejs/kit": "3.0.0",
    "@sveltejs/package": "3.0.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "24.19.1",
    "happy-dom": "^20.14.5",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vitest": "5.0.3",
    "vite": "8.3.2"
  }
}
