{
  "name": "@runic-artifex/vite-plugin-runic",
  "version": "1.0.0-preview.1",
  "description": "Vite 8 development and DevTools integration for Runic applications",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "files": [
    "dist",
    "virtual.d.ts",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./virtual": "./virtual.d.ts"
  },
  "scripts": {
    "clean": "bun -e \"import('node:fs').then(({rmSync}) => rmSync('dist', { recursive: true, force: true }))\"",
    "build": "bun run --bun clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun run --bun build && bun test --timeout 120000 test/*.test.mjs",
    "verify": "bun run --bun typecheck && bun run --bun test && bun pm pack --dry-run",
    "pack:preview": "bun pm pack"
  },
  "peerDependencies": {
    "@runic-artifex/application-bridge-tooling": "1.0.0-preview.1",
    "@vitejs/devtools": "^0.4.12",
    "vite": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "@runic-artifex/application-bridge-tooling": {
      "optional": true
    },
    "@vitejs/devtools": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "24.10.12",
    "@vitejs/devtools": "0.4.12",
    "@vitejs/devtools-kit": "0.4.12",
    "typescript": "5.9.3",
    "vite": "8.2.1",
    "@runic-artifex/application-bridge-tooling": "workspace:*"
  },
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Runic-Artifex/runic-sdk.git",
    "directory": "packages/web/vite-plugin-runic"
  },
  "homepage": "https://github.com/Runic-Artifex/runic-sdk/tree/main/packages/web/vite-plugin-runic#readme",
  "bugs": {
    "url": "https://github.com/Runic-Artifex/runic-sdk/issues"
  },
  "keywords": [
    "runic-artifex",
    "runic",
    "vite",
    "vite-plugin",
    "devtools"
  ]
}
