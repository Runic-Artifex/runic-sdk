      "import": "./dist/ViewOutlet.svelte"
    },
    "./view-registry": {
      "types": "./dist/view-registry.d.ts",
      "import": "./dist/view-registry.js"
    }
  },
  "peerDependencies": {
    "svelte": ">=5.46.4 <6"
  },
  "description": "Svelte 5 outlet for Runic Views",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Runic-Artifex/runic-sdk.git",
    "directory": "packages/web/views-svelte"
  },
  "homepage": "https://github.com/Runic-Artifex/runic-sdk/tree/main/packages/web/views-svelte#readme",
