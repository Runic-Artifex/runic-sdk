{
  "name": "@runic-artifex/views",
  "version": "0.7.0-preview.1",
  "description": "Shared browser runtime for generated Runic Views clients",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./generated": {
      "types": "./dist/generated.d.ts",
      "import": "./dist/generated.js"
    },
    "./generated/wire": {
      "types": "./dist/wire.d.ts",
      "import": "./dist/wire.js"
    },
    "./mock": {
      "types": "./dist/mock.d.ts",
      "import": "./dist/mock.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "bun -e \"import('node:fs').then(({rmSync}) => rmSync('dist', { recursive: true, force: true }))\"",
    "build": "bun run --bun clean && tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "bun run --bun build && bun test --timeout 60000 test/*.test.ts",
    "pack:check": "bun pm pack --dry-run",
    "size": "bun run --bun build && node scripts/bundle-size.mjs"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "publishConfig": {
    "access": "public",
    "tag": "preview"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Runic-Artifex/runic-sdk.git",
    "directory": "packages/web/views"
  },
  "homepage": "https://github.com/Runic-Artifex/runic-sdk/tree/main/packages/web/views#readme",
  "bugs": {
    "url": "https://github.com/Runic-Artifex/runic-sdk/issues"
  },
  "keywords": [
    "runic-artifex",
    "runic",
    "views",
    "mvvm"
  ]
}
