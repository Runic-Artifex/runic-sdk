{
  "name": "@runic-artifex/vite-plugin-runic-translations",
  "version": "1.0.0-preview.1",
  "description": "Vite integration for compiling Runic Translations catalogs into application resources",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "bun build.mjs",
    "test": "bun run --bun build && bun test --timeout 120000 test/*.test.js"
  },
  "peerDependencies": {
    "vite": ">=6 <9"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Runic-Artifex/runic-sdk.git",
    "directory": "packages/web/vite-plugin-runic-translations"
  },
  "homepage": "https://github.com/Runic-Artifex/runic-sdk/tree/main/packages/web/vite-plugin-runic-translations#readme",
  "bugs": {
    "url": "https://github.com/Runic-Artifex/runic-sdk/issues"
  },
  "keywords": [
    "runic-artifex",
    "localization",
    "i18n",
    "translations",
    "vite",
    "sveltekit",
    "esm",
    "tree-shaking",
    "hmr"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  }
}
