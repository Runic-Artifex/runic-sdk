{
  "name": "@runic-artifex/mvvm-conformance",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Runic-Artifex/runic-toolkit.git",
    "directory": "web/packages/conformance"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "description": "Runtime-neutral conformance runner for the runic.toolkit.mvvm/1 TypeScript SDK.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/esm/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "browser": "./dist/esm/index.js",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "default": "./dist/esm/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=24.18.0"
  },
  "scripts": {
    "clean": "node --input-type=module --eval \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true, maxRetries: 5, retryDelay: 100 });\"",
    "build": "npm run clean && npm run build:esm",
    "build:esm": "tsc --project tsconfig.json",
    "test": "npm run build && node --test --experimental-strip-types \"test/**/*.test.ts\" \"test/**/*.test.mjs\"",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@runic-artifex/mvvm": "0.1.0"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  }
}
