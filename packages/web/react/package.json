{
  "name": "@runic-artifex/react",
  "version": "0.7.0-preview.7",
  "description": "React hooks for generated Runic Views clients",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "bun -e \"import('node:fs').then(({rmSync}) => rmSync('dist', { recursive: true, force: true }))\"",
    "build": "bun run --bun clean && tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "bun run --bun build && tsc -p tsconfig.json --noEmit && vitest run",
    "pack:check": "bun pm pack --dry-run"
  },
  "peerDependencies": {
    "react": ">=18.3.0 <20",
    "@runic-artifex/views": "0.7.0-preview.7"
  },
  "devDependencies": {
    "@runic-artifex/views": "workspace:*",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "happy-dom": "20.14.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "publishConfig": {
    "access": "public",
    "tag": "preview"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Runic-Artifex/runic-sdk.git",
    "directory": "packages/web/react"
  },
  "homepage": "https://github.com/Runic-Artifex/runic-sdk/tree/main/packages/web/react#readme",
  "bugs": {
    "url": "https://github.com/Runic-Artifex/runic-sdk/issues"
  },
  "keywords": [
    "runic-artifex",
    "runic",
    "views",
    "react"
  ]
}
