<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RunicBridgeRegisterGlobally>false</RunicBridgeRegisterGlobally>
    <RunicBridgeCompositionType>FirstWindowDesktop.RunicBridgeComposition</RunicBridgeCompositionType>
    <RunicBridgeFrontendBuildCommand>bun run --bun build</RunicBridgeFrontendBuildCommand>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RunicBridgeBootstrap)' == 'true'">
    <OutputType>Library</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ReactiveUI" />
    <ProjectReference Include="../../packages/dotnet/Runic.Application.Desktop/Runic.Application.Desktop.csproj" />
    <ProjectReference Include="../../packages/dotnet/Runic.Application.Views.ReactiveUI/Runic.Application.Views.ReactiveUI.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(RunicBridgeBootstrap)' == 'true'">
    <Compile Remove="Program.cs" />
  </ItemGroup>
  <Import Project="../../packages/dotnet/Runic.Application.Views/build/Runic.Application.Views.targets" />
  <Import Project="../../packages/dotnet/Runic.Application.Desktop/build/Runic.Application.Desktop.targets" />
</Project>
