<Project Sdk="Microsoft.NET.Sdk">
  <!-- Drives the ReactiveUI variant on a real WPF dispatcher with off-screen windows, with the harness of ../Tests.
       Windows only: CI runs it in the WPF job; other platforms only build it.
       A TUnit test application on Microsoft.Testing.Platform: run it with dotnet run or the built executable. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>Runic.Navigation.Examples.Notes.Tests</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <DefineConstants>$(DefineConstants);REACTIVEUI</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="TUnit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../NotesNavigation.ReactiveUI/NotesNavigation.ReactiveUI.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../Tests/AssemblyInfo.cs" Link="AssemblyInfo.cs" />
    <Compile Include="../Tests/Scene.cs" Link="Scene.cs" />
    <Compile Include="../Tests/WpfDispatcherExecutor.cs" Link="WpfDispatcherExecutor.cs" />
  </ItemGroup>
</Project>
