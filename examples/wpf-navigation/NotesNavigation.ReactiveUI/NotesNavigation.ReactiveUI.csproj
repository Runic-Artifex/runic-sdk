<Project Sdk="Microsoft.NET.Sdk">
  <!-- The ReactiveUI variant of ../NotesNavigation: the same app with ReactiveUI ViewModels and the
       Runic.Navigation.ReactiveUI adapter. Files that don't depend on the MVVM library are linked from
       ../NotesNavigation rather than copied. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Builds on Linux and macOS too; it runs on Windows only. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>Runic.Navigation.Examples.Notes</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="ReactiveUI.WPF" />
  </ItemGroup>
  <!-- In your own project: <PackageReference Include="Runic.Navigation.Wpf" /> and
       <PackageReference Include="Runic.Navigation.ReactiveUI" />. -->
  <ItemGroup>
    <ProjectReference Include="../../../packages/dotnet/Runic.Navigation.Wpf/Runic.Navigation.Wpf.csproj" />
    <ProjectReference Include="../../../packages/dotnet/Runic.Navigation.ReactiveUI/Runic.Navigation.ReactiveUI.csproj" />
  </ItemGroup>
  <!-- Shared with ../NotesNavigation unchanged: the domain, the shell, and the Views that only bind. -->
  <ItemGroup>
    <Compile Include="../NotesNavigation/Domain/Notes.cs" Link="Domain/Notes.cs" />
    <Compile Include="../NotesNavigation/Shell/AppRegions.cs" Link="Shell/AppRegions.cs" />
    <Page Include="../NotesNavigation/Shell/MainWindow.xaml" Link="Shell/MainWindow.xaml" />
    <Compile Include="../NotesNavigation/Shell/MainWindow.xaml.cs" Link="Shell/MainWindow.xaml.cs" DependentUpon="MainWindow.xaml" />
    <Page Include="../NotesNavigation/Dialogs/ConfirmView.xaml" Link="Dialogs/ConfirmView.xaml" />
    <Compile Include="../NotesNavigation/Dialogs/ConfirmView.xaml.cs" Link="Dialogs/ConfirmView.xaml.cs" DependentUpon="ConfirmView.xaml" />
    <Page Include="../NotesNavigation/Settings/*.xaml" LinkBase="Settings" />
    <Compile Include="../NotesNavigation/Settings/*.xaml.cs" LinkBase="Settings" />
  </ItemGroup>
</Project>
