<Window x:Class="Runic.Navigation.Examples.Notes.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:rn="https://runic-artifex.eu/xaml/navigation"
        Title="Runic" Width="640" Height="420">
  <DockPanel>
    <!-- BrowseBack can't execute while a Back is in flight, so a double click pops once. -->
    <Button DockPanel.Dock="Top" Content="Back" Command="NavigationCommands.BrowseBack" CommandTarget="{Binding ElementName=Host}" /> <!-- [S4] -->
    <!-- Shows each entry of the Dialog region in its own window, owned by this one, sized to content; Escape dismisses. -->
    <rn:NavigationDialogHost Region="{Binding Dialog}" /> <!-- [S2] -->
    <rn:NavigationHost x:Name="Host" Region="{Binding Main}" />
  </DockPanel>
</Window>
