<rxui:ReactiveUserControl x:Class="Comparison.CrissCrossApp.S3.SettingsView"
                          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                          xmlns:rxui="http://reactiveui.net"
                          xmlns:local="clr-namespace:Comparison.CrissCrossApp.S3"
                          x:TypeArguments="local:SettingsViewModel"
                          DataContext="{Binding ViewModel, RelativeSource={RelativeSource Self}}">
  <TabControl ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}" DisplayMemberPath="DisplayName">
    <TabControl.ContentTemplate>
      <DataTemplate>
        <rxui:ViewModelViewHost ViewModel="{Binding}" />
      </DataTemplate>
    </TabControl.ContentTemplate>
  </TabControl>
</rxui:ReactiveUserControl>
