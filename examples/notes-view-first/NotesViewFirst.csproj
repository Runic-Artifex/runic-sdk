<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RunicBridgeFrontendBuildCommand>bun run --bun build</RunicBridgeFrontendBuildCommand>
    <RunicBridgeCompositionType>NotesWindowViews.RunicBridgeComposition</RunicBridgeCompositionType>
    <!-- Typed navigation is experimental. -->
    <NoWarn>$(NoWarn);RUNICNAV001</NoWarn>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RunicBridgeBootstrap)' == 'true'">
    <OutputType>Library</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="ReactiveUI" />
    <PackageReference Include="Splat" />
    <ProjectReference Include="../../packages/dotnet/Runic.Application.Views.CsWebUi/Runic.Application.Views.CsWebUi.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The example's unit tests are their own project. -->
    <Compile Remove="Tests/**" />
    <None Remove="Tests/**" />
  </ItemGroup>
  <ItemGroup Condition="'$(RunicBridgeBootstrap)' == 'true'">
    <Compile Remove="Program.cs" />
    <Compile Remove="NotesApplication.cs" />
    <Compile Remove="ViewLifetimeCheck.cs" />
  </ItemGroup>
  <Import Project="../../packages/dotnet/Runic.Application.Views/build/Runic.Application.Views.targets" />
</Project>
