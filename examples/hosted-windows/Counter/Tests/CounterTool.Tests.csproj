<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- A TUnit test application on Microsoft.Testing.Platform: run it with dotnet run or the built executable. -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RunicImportDesktopTargets>true</RunicImportDesktopTargets>
    <!-- RunicTestHost plays the host of the experimental hosted mode (docs/experimental.md). -->
    <NoWarn>$(NoWarn);RUNICDESK103</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="TUnit" />
  </ItemGroup>
  <ItemGroup>
    <!-- In your own application, reference the Runic.Application.Testing package instead. -->
    <ProjectReference Include="../../../../packages/dotnet/Runic.Desktop.Kestrel/Runic.Desktop.Kestrel.csproj" />
    <ProjectReference Include="../CounterTool.csproj" />
    <ProjectReference Include="../../../../packages/dotnet/Runic.Application.Testing/Runic.Application.Testing.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The counter's own build output, with its page in www, which the tests start as the guest. -->
    <AssemblyMetadata Include="CounterTool" Value="$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../bin/$(Configuration)/$(TargetFramework)/CounterTool.dll'))" />
  </ItemGroup>
</Project>
