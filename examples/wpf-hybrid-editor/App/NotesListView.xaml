<UserControl x:Class="HybridNotes.Wpf.NotesListView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <TextBlock FontSize="22" Text="Notes" Margin="0,0,0,12" />
    <ListBox x:Name="Notes" ItemsSource="{Binding Notes}" DisplayMemberPath="Title" Height="180" />
    <Button Content="Open note" HorizontalAlignment="Left" Margin="0,12,0,0"
      Command="{Binding OpenCommand}" CommandParameter="{Binding SelectedItem, ElementName=Notes}" />
  </StackPanel>
</UserControl>
