<UserControl x:Class="HybridNotes.Wpf.ConfirmView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel Margin="24">
    <TextBlock Text="{Binding Message}" Margin="0,0,0,16" />
    <StackPanel Orientation="Horizontal">
      <Button Content="Discard" Command="{Binding YesCommand}" MinWidth="100" Margin="0,0,8,0" />
      <Button Content="Keep editing" Command="{Binding NoCommand}" MinWidth="100" />
    </StackPanel>
  </StackPanel>
</UserControl>
