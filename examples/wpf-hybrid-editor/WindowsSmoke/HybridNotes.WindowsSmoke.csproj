<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);RUNICNAV001;RUNICWPF001</NoWarn>
    <RunicImportDesktopTargets>true</RunicImportDesktopTargets>
    <!-- The web View is declared and generated in the model project. -->
    <RunicBridgeBuildEnabled>false</RunicBridgeBuildEnabled>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../App/HybridNotes.Wpf.csproj" />
  </ItemGroup>
  <Import Project="../../../packages/dotnet/Runic.Application.Desktop/build/Runic.Application.Desktop.targets" />
  <!-- Package consumers receive the Views targets through buildTransitive.
       They copy the model project's built frontend to www/. -->
  <Import Project="../../../packages/dotnet/Runic.Application.Views/build/Runic.Application.Views.targets" />
</Project>
