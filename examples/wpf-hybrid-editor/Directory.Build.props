<Project>
  <!-- The repository's build settings, as examples/Directory.Build.props imports them. Outside this repository, drop
       this line. -->
  <Import Project="../../Directory.Build.props" />
  <!-- The WPF projects target net10.0-windows. The .NET SDK builds them on Linux and macOS only with
       EnableWindowsTargeting, which must be set before the restore, so it lives here rather than in a package.
       They still run only on Windows. Copy this line into your application's Directory.Build.props. -->
  <PropertyGroup>
    <EnableWindowsTargeting Condition="'$(EnableWindowsTargeting)' == '' and !$([MSBuild]::IsOSPlatform('Windows'))">true</EnableWindowsTargeting>
  </PropertyGroup>
</Project>
