<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- A TUnit test application on Microsoft.Testing.Platform: run it with dotnet run or the built executable. -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);RUNICNAV001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="TUnit" />
    <ProjectReference Include="../Model/HybridNotes.Model.csproj" />
    <ProjectReference Include="../../../packages/dotnet/Runic.Application.Testing/Runic.Application.Testing.csproj" />
  </ItemGroup>
</Project>
