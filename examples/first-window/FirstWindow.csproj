<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>
  <!-- Inside the SDK repository the example builds the packages from source.
       A copied-out project replaces these lines with
       <PackageReference Include="Runic.Application.CsWebUi" Version="..." />. -->
  <Import Project="../../packages/dotnet/Runic.Application.Views.CsWebUi/build/Runic.Application.CsWebUi.props" />
  <ItemGroup>
    <ProjectReference Include="../../packages/dotnet/Runic.Application.Views.CsWebUi/Runic.Application.Views.CsWebUi.csproj" />
  </ItemGroup>
  <Import Project="../../packages/dotnet/Runic.Application.Views/build/Runic.Application.Views.targets" />
  <Import Project="../../packages/dotnet/Runic.Application.Views.CsWebUi/build/Runic.Application.Views.CsWebUi.targets" />
</Project>
