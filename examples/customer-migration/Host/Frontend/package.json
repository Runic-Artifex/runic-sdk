{
  "name": "@runic-artifex/customer-migration",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "dev": "vite",
    "contract:generate": "runic-bridge generate --authority csharp --project ../CustomerDesktop.csproj",
    "contract:check": "runic-bridge check --authority csharp --project ../CustomerDesktop.csproj",
    "test": "node --test src/*.test.ts",
    "test:browser": "node browser.test.mjs && node lifecycle.test.mjs",
    "test:dev": "node dev.test.mjs",
    "test:lifecycle": "node lifecycle.test.mjs",
    "browser:install": "playwright-core install chromium"
  },
  "dependencies": {
    "@runic-artifex/application-bridge": "workspace:*",
    "@runic-artifex/desktop": "workspace:*",
    "effect": "3.22.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@runic-artifex/application-bridge-tooling": "workspace:*",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "typescript": "5.9.3",
    "vite": "8.2.1",
    "playwright-core": "1.62.1",
    "@runic-artifex/vite-plugin-runic": "workspace:*"
  }
}
