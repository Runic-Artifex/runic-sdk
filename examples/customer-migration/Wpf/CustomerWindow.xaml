<Window x:Class="CustomerMigration.Wpf.CustomerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Customers · CommunityToolkit baseline" Width="900" Height="620">
<Window.Resources><Style TargetType="TextBox"><Setter Property="Margin" Value="0,5,0,15"/><Setter Property="Padding" Value="8"/><Style.Triggers><DataTrigger Binding="{Binding SaveCommand.IsRunning}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger><Trigger Property="Validation.HasError" Value="True"><Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}"/></Trigger></Style.Triggers></Style></Window.Resources>
<Grid Margin="25"><Grid.ColumnDefinitions><ColumnDefinition Width="270"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<StackPanel Margin="0,0,25,0"><TextBlock Text="Find a customer"/><TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"/><ItemsControl ItemsSource="{Binding FilteredCustomers}"><ItemsControl.ItemTemplate><DataTemplate><Button HorizontalContentAlignment="Left" Padding="12" Margin="0,0,0,8" Tag="{Binding Id}" Click="SelectCustomer"><StackPanel><TextBlock Text="{Binding Name}" FontWeight="Bold"/><TextBlock Text="{Binding Company}"/></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
<StackPanel Grid.Column="1"><TextBlock Text="Customer details" FontSize="26" Margin="0,0,0,22"/><TextBlock Text="Full name"/><TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/><TextBlock Text="Email address"/><TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/><TextBlock Text="Company"/><TextBox Text="{Binding Company, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/><Button Content="Import contact JSON" Click="ImportContact" HorizontalAlignment="Left" Padding="12,6"/><TextBlock Text="{Binding Status}" Margin="0,22,0,12"/><ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress}" Height="8"/><StackPanel Orientation="Horizontal" Margin="0,20,0,0"><Button Content="Save customer" Command="{Binding SaveCommand}" Padding="15,8"/><Button Content="Cancel save" Command="{Binding SaveCancelCommand}" Padding="15,8" Margin="10,0,0,0"/></StackPanel></StackPanel>
</Grid></Window>
