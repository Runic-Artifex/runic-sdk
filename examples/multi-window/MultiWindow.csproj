<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RunicImportDesktopTargets>true</RunicImportDesktopTargets>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RunicApplicationFrontendCompositionType>MultiWindow.RunicViewsComposition</RunicApplicationFrontendCompositionType>
    <RunicApplicationFrontendBuildCommand>bun run --bun build</RunicApplicationFrontendBuildCommand>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RunicApplicationFrontendBootstrap)' == 'true'">
    <OutputType>Library</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="ReactiveUI" />
    <!-- Runic Translations: one catalog, Frontend/translations/runic.json, for the page and C#. The build generates
         ProjectText (messages, References factories, ProjectTextCatalog.Registration) and the page's ESM. -->
    <PackageReference Include="Runic.Translations" />
    <PackageReference Include="Runic.Translations.Build" PrivateAssets="all" />
    <RunicTranslationProject Include="Frontend/translations/runic.json" />
    <!-- The presentation server; -p:RunicDesktopServer=Native builds the application on the experimental native server
         without ASP.NET Core. -->
    <ProjectReference Include="../../packages/dotnet/Runic.Desktop.Kestrel/Runic.Desktop.Kestrel.csproj" Condition="'$(RunicDesktopServer)' != 'Native'" />
    <ProjectReference Include="../../packages/dotnet/Runic.Application.Views.Desktop/Runic.Application.Views.Desktop.csproj" />
    <ProjectReference Include="../../packages/dotnet/Runic.Application.Views.ReactiveUI/Runic.Application.Views.ReactiveUI.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The example's tests are their own project. -->
    <Compile Remove="Tests/**" />
    <None Remove="Tests/**" />
  </ItemGroup>
  <ItemGroup Condition="'$(RunicApplicationFrontendBootstrap)' == 'true'">
    <Compile Remove="Program.cs" />
  </ItemGroup>
  <PropertyGroup Condition="'$(RunicApplicationFrontendBootstrap)' != 'true'">
    <!-- The catalog's ESM for the page, beside the C# API, which a source generator writes. The ESM comes from the
         dotnet-runic-translations tool of the repository's .config/dotnet-tools.json. The Bun bundler of
         Frontend/build.mjs imports it from Frontend/.runic/translations, which RunicApplicationFrontendTranslations keeps
         equal to it before the frontend builds. -->
    <RunicTranslationsEmitEsm>true</RunicTranslationsEmitEsm>
    <RunicApplicationFrontendTranslations>true</RunicApplicationFrontendTranslations>
  </PropertyGroup>
  <!-- An application runs `dotnet tool restore` once after cloning; the example does it in its build, before the
       repository's web packages restore the same manifest, so the repository's build needs no extra step. -->
  <Target Name="RestoreTranslationsTool" AfterTargets="PrepareForBuild"
          Condition="'$(RunicTranslationsEmitEsm)' == 'true'"
          Inputs="../../.config/dotnet-tools.json" Outputs="$(IntermediateOutputPath)translations-tool.stamp">
    <Exec Command="dotnet tool restore" WorkingDirectory="$(MSBuildProjectDirectory)" StandardOutputImportance="low" />
    <Touch Files="$(IntermediateOutputPath)translations-tool.stamp" AlwaysCreate="true" />
  </Target>
  <Import Project="../../packages/dotnet/Runic.Application.Views/build/Runic.Application.Views.targets" />
  <Import Project="../../packages/dotnet/Runic.Application.Views.Desktop/build/Runic.Application.Views.Desktop.targets" />
</Project>
