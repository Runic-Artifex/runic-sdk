<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RunicImportDesktopTargets>true</RunicImportDesktopTargets>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RunicApplicationFrontendCompositionType>WidgetTool.RunicViewsComposition</RunicApplicationFrontendCompositionType>
    <!-- vite build: the page and, with the component target, Frontend/dist/_runic_component (vite.config.ts). -->
    <RunicApplicationFrontendBuildCommand>bun run --bun build</RunicApplicationFrontendBuildCommand>
    <!-- Hosted mode and components are experimental (docs/experimental.md). -->
    <NoWarn>$(NoWarn);RUNICDESK103</NoWarn>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RunicApplicationFrontendBootstrap)' == 'true'">
    <OutputType>Library</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="ReactiveUI" />
    <ProjectReference Include="../../../packages/dotnet/Runic.Desktop.Kestrel/Runic.Desktop.Kestrel.csproj" />
    <ProjectReference Include="../../../packages/dotnet/Runic.Application.Views.Desktop/Runic.Application.Views.Desktop.csproj" />
    <ProjectReference Include="../../../packages/dotnet/Runic.Application.Views.ReactiveUI/Runic.Application.Views.ReactiveUI.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(RunicApplicationFrontendBootstrap)' == 'true'">
    <Compile Remove="Program.cs" />
  </ItemGroup>
  <Import Project="../../../packages/dotnet/Runic.Application.Views/build/Runic.Application.Views.targets" />
  <Import Project="../../../packages/dotnet/Runic.Application.Views.Desktop/build/Runic.Application.Views.Desktop.targets" />
</Project>
