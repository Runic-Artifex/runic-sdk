<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RunicHost Condition="'$(RunicHost)' == ''">desktop</RunicHost>
    <DefineConstants Condition="'$(RunicHost)' == 'cswebui'">$(DefineConstants);RUNIC_CSWEBUI</DefineConstants>
    <RunicNativeProvider Condition="'$(RunicNativeProvider)' == '' and $([MSBuild]::IsOSPlatform('Linux'))">Linux</RunicNativeProvider>
    <RunicNativeProvider Condition="'$(RunicNativeProvider)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">Windows</RunicNativeProvider>
    <RunicNativeProvider Condition="'$(RunicNativeProvider)' == '' and $([MSBuild]::IsOSPlatform('OSX'))">MacOS</RunicNativeProvider>
    <DefineConstants Condition="'$(RunicHost)' == 'desktop' and '$(RunicNativeProvider)' != 'None'">$(DefineConstants);RUNIC_PLATFORM_$(RunicNativeProvider)</DefineConstants>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RunicApplicationBridgeGenerate>false</RunicApplicationBridgeGenerate>
    <RunicApplicationBridgeAuthority>csharp</RunicApplicationBridgeAuthority>
    <RunicToolkitFrontendDevServerKind>vite</RunicToolkitFrontendDevServerKind>
    <RunicToolkitFrontendViteDevServerEntry>/src/main.tsx</RunicToolkitFrontendViteDevServerEntry>
    <RunicAssetsDist Condition="'$(RunicBridgeInspect)' != 'true'">$(MSBuildProjectDirectory)/Frontend/dist</RunicAssetsDist>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../packages/dotnet/Runic.Application.Platform/Runic.Application.Platform.csproj" />
    <ProjectReference Condition="'$(RunicHost)' == 'desktop'" Include="../../../packages/dotnet/Runic.Application.Platform.Desktop/Runic.Application.Platform.Desktop.csproj" />
    <ProjectReference Condition="'$(RunicHost)' == 'desktop' and '$(RunicNativeProvider)' != 'None'" Include="../../../packages/dotnet/Runic.Platform.$(RunicNativeProvider)/Runic.Platform.$(RunicNativeProvider).csproj" />
    <ProjectReference Condition="'$(RunicHost)' == 'cswebui'" Include="../../../packages/dotnet/Runic.Application.CsWebUi/Runic.Application.CsWebUi.csproj" />
    <ProjectReference Include="../After/DocumentApplication.csproj" />
    <ProjectReference Include="../../../packages/dotnet/Runic.Application/Runic.Application.csproj" />
    <ProjectReference Condition="'$(RunicHost)' == 'desktop'" Include="../../../packages/dotnet/Runic.Application.Desktop/Runic.Application.Desktop.csproj" />
    <ProjectReference Condition="'$(RunicHost)' == 'desktop'" Include="../../../packages/dotnet/Runic.Assets.Desktop/Runic.Assets.Desktop.csproj" />
    <ProjectReference Include="../../../packages/dotnet/Runic.Application.Generators/Runic.Application.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../../packages/dotnet/Runic.Application.Bridge.Generators/Runic.Application.Bridge.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../../tools/Runic.Assets.Packer/Runic.Assets.Packer.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Import Project="../../../packages/dotnet/Runic.Application.Bridge/buildTransitive/Runic.Application.Bridge.targets" />
  <Target Name="ValidateRunicHost" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(RunicHost)' != 'desktop' and '$(RunicHost)' != 'cswebui'" Text="RunicHost must be desktop or cswebui." />
  </Target>
  <Target Name="DocumentFrontend" BeforeTargets="RunicAssetsPackFileSystem;CoreCompile" Condition="'$(RunicBridgeInspect)' != 'true' and '$(DesignTimeBuild)' != 'true'">
    <Exec WorkingDirectory="Frontend" Command="bun run --bun contract:generate" EnvironmentVariables="RunicHost=$(RunicHost);RunicNativeProvider=$(RunicNativeProvider)" />
    <Exec WorkingDirectory="Frontend" Command="bun run --bun build" EnvironmentVariables="VITE_RUNIC_HOST=$(RunicHost)" />
  </Target>
  <Import Project="../../../packages/dotnet/Runic.Assets/buildTransitive/Runic.Assets.targets" />
</Project>
