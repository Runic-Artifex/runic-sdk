<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RunicApplicationFrontendBuildCommand>bun run --bun build</RunicApplicationFrontendBuildCommand>
    <RunicApplicationFrontendCompositionType>NotesReactiveViews.RunicBridgeComposition</RunicApplicationFrontendCompositionType>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RunicApplicationFrontendBootstrap)' == 'true'">
    <OutputType>Library</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="ReactiveUI" />
    <ProjectReference Include="../../packages/dotnet/Runic.Application.Views.ReactiveUI/Runic.Application.Views.ReactiveUI.csproj" />
    <ProjectReference Include="../../packages/dotnet/Runic.Navigation.ReactiveUI/Runic.Navigation.ReactiveUI.csproj" />
    <ProjectReference Include="../../packages/dotnet/Runic.Application.Views.CsWebUi/Runic.Application.Views.CsWebUi.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="notes-ide-frontend.mjs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="angular-source-map-proxy.mjs" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="'$(RunicApplicationFrontendBootstrap)' == 'true'">
    <Compile Remove="Program.cs" />
    <Compile Remove="NotesApplication.cs" />
  </ItemGroup>
  <Import Project="../../packages/dotnet/Runic.Application.Views/build/Runic.Application.Views.targets" />
</Project>
