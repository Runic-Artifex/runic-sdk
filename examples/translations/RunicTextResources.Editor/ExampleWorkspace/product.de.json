{
  "schemaVersion": 2,
  "catalog": "customer-product",
  "locale": "de",
  "layer": "base",
  "resources": {
    "Common": {
      "Save": "Speichern",
      "Cancel": "Abbrechen"
    },
    "Dashboard": {
      "Welcome": {
        "$value": "Willkommen zurück, {name}",
        "$description": "Begrüßung auf der Startseite",
        "$tags": ["dashboard", "customer-facing"],
        "$placeholders": {
          "name": { "type": "string" }
        }
      }
    },
    "Files": {
      "Selected": {
        "$value": {
          "inputs": {
            "count": { "type": "int64" }
          },
          "selectors": [
            { "name": "quantity", "input": "count", "function": "plural" }
          ],
          "variants": [
            { "match": { "quantity": "one" }, "value": "Eine Datei ausgewählt" },
            { "match": { "quantity": "*" }, "value": "{count} Dateien ausgewählt" }
          ]
        },
        "$description": "Auswahlzähler in der Dateiliste"
      }
    }
  }
}
