<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <AdministrationPackageVersion Condition="'$(AdministrationPackageVersion)' == ''">0.2.0-administration.local.2</AdministrationPackageVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Runic.Platform.Administration.Windows" Version="$(AdministrationPackageVersion)" />
  </ItemGroup>
</Project>
