<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="TUnit" />
    <PackageReference Include="Runic.Application.Testing" />
  </ItemGroup>
  <ItemGroup>
    <!-- The tests need the application's assembly, not its built frontend. -->
    <ProjectReference Include="../../src/Acme.App/Acme.App.csproj" AdditionalProperties="RunicApplicationFrontendBuildEnabled=false" />
  </ItemGroup>
</Project>
