          "doc": "A back request found no retained entry."
        },
        {
          "wire": "NotCurrent",
          "value": "5",
          "doc": "The expected current entry is not current."
        },
        {
          "wire": "EntryNotFound",
          "value": "6",
          "doc": "The back-to target is not in the region."
        },
        {
          "wire": "Busy",
          "value": "7",
          "doc": "The region admits requests with `RejectWhileBusy` and was busy: an earlier request had not completed."
        }
      ]
