        }
      ]
    },
    "Runic.Navigation.NavigationOutcomeKind": {
      "kind": "enum",
      "name": {
        "source": "Runic.Navigation.NavigationOutcomeKind",
        "base": "NavigationOutcomeKind",
        "qualifiers": [
