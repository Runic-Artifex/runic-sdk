          "value": "0",
          "doc": "A departure guard returned `false`."
        },
        {
          "wire": "Cancelled",
          "value": "1",
          "doc": "The caller's token was cancelled before the commit."
        },
        {
          "wire": "Closed",
          "value": "2",
          "doc": "The navigator or the region is closed."
        },
        {
          "wire": "Reentrant",
          "value": "3",
