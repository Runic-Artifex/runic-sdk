      "doc": "How the arrival hooks of a committed transition ended (`Arrival`).",
      "cases": [
        {
          "wire": "None",
          "value": "0",
          "doc": "No entry the commit made current has an arrival hook."
        },
        {
          "wire": "Completed",
          "value": "1",
          "doc": "Every arrival hook returned."
        },
        {
          "wire": "Failed",
          "value": "2",
          "doc": "An arrival hook threw; the commit stands."
        },
        {
          "wire": "Cancelled",
          "value": "3",
          "doc": "An arrival hook was cancelled, because its entry stopped being current or retired, or the navigator closed, or it was never started for that reason."
        }
      ]
