{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WebUIToolkit Dependency Notices policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "defaultDecision", "licenses", "missingEvidence", "orExpressions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "defaultDecision": { "enum": ["allow", "deny", "review"] },
    "licenses": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allow", "deny", "review"],
      "properties": {
        "allow": { "$ref": "#/$defs/expressions" },
        "deny": { "$ref": "#/$defs/expressions" },
        "review": { "$ref": "#/$defs/expressions" },
        "obligations": {
          "type": "object",
          "additionalProperties": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "missingEvidence": { "enum": ["warning", "error"] },
    "orExpressions": { "enum": ["allow", "require-explicit-selection"] },
    "overrides": { "type": "array", "items": { "$ref": "#/$defs/override" } }
  },
  "$defs": {
    "expressions": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "override": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "purl", "set", "reason", "approvedBy", "createdOn", "expiresAfter"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "purl": { "type": "string", "pattern": "^pkg:" },
        "set": {
          "type": "object",
          "additionalProperties": false,
          "required": ["licenseExpression", "licenseEvidenceSha256"],
          "properties": {
            "licenseExpression": { "type": "string", "minLength": 1 },
            "licenseEvidenceSha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "reason": { "type": "string", "minLength": 1 },
        "approvedBy": { "type": "string", "minLength": 1 },
        "createdOn": { "type": "string", "format": "date" },
        "expiresAfter": { "type": "string", "minLength": 1 }
      }
    }
  }
}
