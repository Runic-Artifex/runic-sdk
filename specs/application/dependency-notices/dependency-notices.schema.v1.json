{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WebUIToolkit Dependency Notices configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "manualComponents"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "manualComponents": {
      "type": "array",
      "items": { "$ref": "#/$defs/manualComponent" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "sha256", "path", "origin"],
      "properties": {
        "kind": { "enum": ["license", "notice", "attribution", "authors", "modification"] },
        "sha256": { "$ref": "#/$defs/sha256" },
        "path": { "type": "string", "minLength": 1 },
        "mediaType": { "type": "string", "minLength": 1 },
        "origin": { "type": "string", "minLength": 1 }
      }
    },
    "manualComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["purl", "displayName", "revision", "licenseExpression", "evidence"],
      "properties": {
        "purl": { "type": "string", "pattern": "^pkg:" },
        "displayName": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 },
        "licenseExpression": { "type": "string", "minLength": 1 },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } },
        "modified": { "type": "boolean", "default": false },
        "modificationNotice": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "required": ["modified"], "properties": { "modified": { "const": true } } },
          "then": { "required": ["modificationNotice"] }
        }
      ]
    }
  }
}
