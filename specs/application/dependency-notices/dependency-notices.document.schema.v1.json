{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WebUIToolkit generated dependency notice document",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "artifactName", "dependencies", "diagnostics"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "artifactName": { "type": "string", "minLength": 1 },
    "artifactVersion": { "type": ["string", "null"] },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["packageUrl", "name", "version", "ecosystem", "scope", "isDirect", "observedLicenseExpression", "effectiveLicenseExpression", "assets", "decisions", "isModified"],
        "properties": {
          "packageUrl": { "type": "string", "pattern": "^pkg:" },
          "name": { "type": "string" },
          "version": { "type": "string" },
          "ecosystem": { "enum": ["generic", "nuget", "npm"] },
          "scope": { "enum": ["runtime", "development", "optional", "peer", "bundled", "unknown"] },
          "isDirect": { "type": "boolean" },
          "observedLicenseExpression": { "type": "string" },
          "effectiveLicenseExpression": { "type": "string" },
          "selectedLicenseExpression": { "type": ["string", "null"] },
          "assets": { "type": "array", "items": { "$ref": "#/$defs/asset" } },
          "decisions": { "type": "array", "items": { "$ref": "#/$defs/decision" } },
          "isModified": { "type": "boolean" },
          "modificationNotice": { "type": ["string", "null"] }
        }
      }
    },
    "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } }
  },
  "$defs": {
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "sha256", "mediaType", "origin", "isOverride"],
      "properties": {
        "kind": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "mediaType": { "type": "string" },
        "origin": { "type": "string" },
        "isOverride": { "type": "boolean" }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "outcome", "rule"],
      "properties": {
        "subject": { "type": "string" },
        "outcome": { "enum": ["allow", "deny", "review"] },
        "rule": { "type": "string" }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "message"],
      "properties": {
        "code": { "pattern": "^WUTNOTICE[1-7][0-9]{3}$" },
        "severity": { "enum": ["info", "warning", "error"] },
        "message": { "type": "string" },
        "packageUrl": { "type": ["string", "null"] },
        "source": { "type": ["string", "null"] },
        "offset": { "type": ["integer", "null"], "minimum": 0 },
        "remediation": { "type": ["string", "null"] }
      }
    }
  }
}
