{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WebUIToolkit MVVM protocol v1 common definitions",
  "$defs": {
    "version": {
      "const": 1
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "contract": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$",
      "description": "maxLength is an early code-point check; runtimes additionally enforce the normative 128 UTF-8 byte limit."
    },
    "capabilityToken": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "capabilityName": {
      "enum": [
        "cancellation",
        "collections",
        "commandResults",
        "patches",
        "validation"
      ]
    },
    "capabilitySet": {
      "description": "The complete closed set of v1 capability subsets in normative ordinal serialization order.",
      "enum": [
        [],
        ["cancellation"],
        ["collections"],
        ["commandResults"],
        ["patches"],
        ["validation"],
        ["cancellation", "collections"],
        ["cancellation", "commandResults"],
        ["cancellation", "patches"],
        ["cancellation", "validation"],
        ["collections", "commandResults"],
        ["collections", "patches"],
        ["collections", "validation"],
        ["commandResults", "patches"],
        ["commandResults", "validation"],
        ["patches", "validation"],
        ["cancellation", "collections", "commandResults"],
        ["cancellation", "collections", "patches"],
        ["cancellation", "collections", "validation"],
        ["cancellation", "commandResults", "patches"],
        ["cancellation", "commandResults", "validation"],
        ["cancellation", "patches", "validation"],
        ["collections", "commandResults", "patches"],
        ["collections", "commandResults", "validation"],
        ["collections", "patches", "validation"],
        ["commandResults", "patches", "validation"],
        ["cancellation", "collections", "commandResults", "patches"],
        ["cancellation", "collections", "commandResults", "validation"],
        ["cancellation", "collections", "patches", "validation"],
        ["cancellation", "commandResults", "patches", "validation"],
        ["collections", "commandResults", "patches", "validation"],
        ["cancellation", "collections", "commandResults", "patches", "validation"]
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "member": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "sanitizedMessage": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$",
      "description": "The runtime also enforces 256 UTF-8 bytes and the semantic sanitization rules in protocol-v1.md."
    },
    "faultCode": {
      "enum": [
        "protocol.unsupported",
        "request.invalid",
        "member.unknown",
        "revision.stale",
        "limit.exceeded",
        "request.cancelled",
        "request.timeout",
        "session.closed"
      ]
    },
    "jsonScalar": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        {
          "type": "string",
          "maxLength": 65536,
          "description": "The runtime additionally enforces the normative 65,536 UTF-8 byte limit."
        }
      ]
    },
    "jsonValue": {
      "oneOf": [
        {
          "$ref": "#/$defs/jsonScalar"
        },
        {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "$ref": "#/$defs/jsonValue"
          }
        },
        {
          "type": "object",
          "maxProperties": 4096,
          "propertyNames": {
            "minLength": 1,
            "maxLength": 128,
            "description": "The runtime additionally enforces 128 UTF-8 bytes per JSON object property name."
          },
          "additionalProperties": {
            "$ref": "#/$defs/jsonValue"
          }
        }
      ]
    },
    "snapshotState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "members"],
      "properties": {
        "revision": {
          "$ref": "#/$defs/revision"
        },
        "members": {
          "type": "array",
          "maxItems": 4096,
          "uniqueItems": true,
          "description": "Canonical output is sorted by ascending member ID, then by the fixed property, collection, command, validation type order. uniqueItems is an early exact-duplicate check; the runtime additionally rejects duplicate (type, member) pairs, which JSON Schema cannot express for arbitrary integer member IDs.",
          "items": {
            "$ref": "#/$defs/snapshotMember"
          }
        }
      }
    },
    "snapshotMember": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "member", "value"],
          "properties": {
            "type": { "const": "property" },
            "member": { "$ref": "#/$defs/member" },
            "value": { "$ref": "#/$defs/jsonValue" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "member", "items"],
          "properties": {
            "type": { "const": "collection" },
            "member": { "$ref": "#/$defs/member" },
            "items": {
              "type": "array",
              "maxItems": 10000,
              "items": { "$ref": "#/$defs/jsonValue" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "member", "canExecute", "isExecuting"],
          "properties": {
            "type": { "const": "command" },
            "member": { "$ref": "#/$defs/member" },
            "canExecute": { "type": "boolean" },
            "isExecuting": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "member", "errors"],
          "properties": {
            "type": { "const": "validation" },
            "member": { "$ref": "#/$defs/member" },
            "errors": {
              "type": "array",
              "maxItems": 32,
              "items": { "$ref": "#/$defs/sanitizedMessage" }
            }
          }
        }
      ]
    },
    "patchChange": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "member", "value"],
          "properties": {
            "type": { "const": "property" },
            "member": { "$ref": "#/$defs/member" },
            "value": { "$ref": "#/$defs/jsonValue" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "member", "operation", "index", "items"],
          "properties": {
            "type": { "const": "collection" },
            "member": { "$ref": "#/$defs/member" },
            "operation": { "enum": ["insert", "remove", "replace", "reset"] },
            "index": { "type": "integer", "minimum": 0, "maximum": 9999 },
            "items": {
              "type": "array",
              "maxItems": 10000,
              "items": { "$ref": "#/$defs/jsonValue" }
            }
          },
          "allOf": [
            {
              "if": {
                "properties": { "operation": { "const": "reset" } },
                "required": ["operation"]
              },
              "then": {
                "properties": { "index": { "const": 0 } }
              }
            },
            {
              "if": {
                "properties": {
                  "operation": { "enum": ["insert", "remove", "replace"] }
                },
                "required": ["operation"]
              },
              "then": {
                "properties": {
                  "items": { "minItems": 1 }
                }
              }
            }
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "member", "from", "to", "count"],
          "properties": {
            "type": { "const": "collectionMove" },
            "member": { "$ref": "#/$defs/member" },
            "from": { "type": "integer", "minimum": 0, "maximum": 9999 },
            "to": { "type": "integer", "minimum": 0, "maximum": 9999 },
            "count": { "type": "integer", "minimum": 1, "maximum": 10000 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "member", "canExecute", "isExecuting"],
          "properties": {
            "type": { "const": "command" },
            "member": { "$ref": "#/$defs/member" },
            "canExecute": { "type": "boolean" },
            "isExecuting": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "member", "errors"],
          "properties": {
            "type": { "const": "validation" },
            "member": { "$ref": "#/$defs/member" },
            "errors": {
              "type": "array",
              "maxItems": 32,
              "items": { "$ref": "#/$defs/sanitizedMessage" }
            }
          }
        }
      ]
    }
  }
}
