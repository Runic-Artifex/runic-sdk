{
  "format": "runic.views.scenario/1",
  "id": "state-changes.member-sets-with-collection-changes.v1",
  "contract": {"id":"runic.views","version":4},
  "set": "state-changes",
  "roles": ["producer","client"],
  "description": "Adding a row also changes members that never announce a change (count, summary, availability). They are set changes in the same frame.",
  "view": "notes",
  "ids": {
    "c1": {"kind":"connection"},
    "hello-c1": {"kind":"request"},
    "session": {"kind":"wire","value":"s-1"},
    "open-notes": {"kind":"call"},
    "open-notes-request": {"kind":"request"},
    "presentation": {"kind":"wire","value":"p-1"},
    "final-read": {"kind":"request"}
  },
  "arrange": {"model":{}},
  "steps": [
    {"connect":"c1"},
    {
      "send": {
        "kind": "hello",
        "protocol": 4,
        "session": {"$id":"session"},
        "client": {"name":{"$any":"string","default":"conformance-client"},"version":{"$any":"string","default":"1.0.0"}},
        "features": {"$any":"array","default":["text-splice/1"]}
      },
      "id": "hello-c1"
    },
    {
      "receive": {
        "ok": true,
        "protocol": 4,
        "implementation": {"name":{"$any":"string","default":"conformance-producer"},"version":{"$any":"string","default":"1.0.0"}},
        "features": {"$any":"array","default":["text-splice/1"]}
      },
      "replyTo": "hello-c1"
    },
    {"call":{"id":"open-notes","op":"open","route":"notes"}},
    {"send":{"kind":"open","route":"notes","presentation":{"$id":"presentation"}},"id":"open-notes-request"},
    {
      "receive": {
        "ok": true,
        "revision": 0,
        "state": {
          "title": "",
          "note": "",
          "priority": "Normal",
          "due": null,
          "elapsed": "PT0S",
          "rows": [],
          "count": 0,
          "summary": "rows: 0",
          "detail": {"kind":"detail","id":"0123456789abcdef0123456789abcdef"},
          "canClear": false,
          "canTouch": true,
          "canSave": true,
          "canConfirmClear": false,
          "isSlowImportExecuting": false,
          "isConfirmClearExecuting": false
        },
        "fields": {"note":{"version":0}},
        "presentation": "ok"
      },
      "replyTo": "open-notes-request"
    },
    {"mutate":[{"op":"insert","index":0,"item":{"id":1,"label":"one"}}]},
    {
      "receive": {
        "kind": "frame",
        "route": "notes",
        "baseRevision": 0,
        "revision": 1,
        "changes": [
          {"field":"rows","kind":"add","index":0,"oldIndex":-1,"keys":["1"],"items":[{"id":1,"label":"one"}]},
          {"field":"count","kind":"set","value":1},
          {"field":"summary","kind":"set","value":"rows: 1"},
          {"field":"canClear","kind":"set","value":true},
          {"field":"canConfirmClear","kind":"set","value":true}
        ]
      }
    },
    {
      "expect": {
        "state": {
          "route": "notes",
          "value": {
            "title": "",
            "note": "",
            "priority": "Normal",
            "due": null,
            "elapsed": "PT0S",
            "rows": [{"id":1,"label":"one"}],
            "count": 1,
            "summary": "rows: 1",
            "detail": {"kind":"detail","id":"0123456789abcdef0123456789abcdef"},
            "canClear": true,
            "canTouch": true,
            "canSave": true,
            "canConfirmClear": true,
            "isSlowImportExecuting": false,
            "isConfirmClearExecuting": false
          }
        }
      }
    },
    {"send":{"kind":"snapshot","route":"notes"},"id":"final-read","role":"producer"},
    {
      "receive": {
        "ok": true,
        "revision": 1,
        "state": {
          "title": "",
          "note": "",
          "priority": "Normal",
          "due": null,
          "elapsed": "PT0S",
          "rows": [{"id":1,"label":"one"}],
          "count": 1,
          "summary": "rows: 1",
          "detail": {"kind":"detail","id":"0123456789abcdef0123456789abcdef"},
          "canClear": true,
          "canTouch": true,
          "canSave": true,
          "canConfirmClear": true,
          "isSlowImportExecuting": false,
          "isConfirmClearExecuting": false
        },
        "fields": {"note":{"version":0}}
      },
      "replyTo": "final-read",
      "role": "producer"
    }
  ]
}
