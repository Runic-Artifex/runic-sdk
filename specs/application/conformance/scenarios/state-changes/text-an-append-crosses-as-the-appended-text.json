{
  "format": "runic.views.scenario/1",
  "id": "state-changes.text-an-append-crosses-as-the-appended-text.v1",
  "contract": {"id":"runic.views","version":4},
  "set": "state-changes",
  "roles": ["producer","client"],
  "description": "An append-only text field publishes a text change: drop trim UTF-16 code units from the start of the length code units the client has, then append text. Case: an append crosses as the appended text.",
  "source": "specs/application/fixtures/text-deltas/text.json#an append crosses as the appended text",
  "view": "log",
  "ids": {
    "c1": {"kind":"connection"},
    "hello-c1": {"kind":"request"},
    "session": {"kind":"wire","value":"s-1"},
    "open-log": {"kind":"call"},
    "open-log-request": {"kind":"request"},
    "presentation": {"kind":"wire","value":"p-1"},
    "final-read": {"kind":"request"}
  },
  "arrange": {"model":{"log":"one","title":"log"}},
  "steps": [
    {"connect":"c1"},
    {
      "send": {
        "kind": "hello",
        "protocol": 4,
        "session": {"$id":"session"},
        "client": {"name":{"$any":"string","default":"conformance-client"},"version":{"$any":"string","default":"1.0.0"}}
      },
      "id": "hello-c1"
    },
    {
      "receive": {
        "ok": true,
        "protocol": 4,
        "implementation": {"name":{"$any":"string","default":"conformance-producer"},"version":{"$any":"string","default":"1.0.0"}}
      },
      "replyTo": "hello-c1"
    },
    {"call":{"id":"open-log","op":"open","route":"log"}},
    {"send":{"kind":"open","route":"log","presentation":{"$id":"presentation"}},"id":"open-log-request"},
    {
      "receive": {"ok":true,"revision":0,"state":{"log":"one","title":"log"},"presentation":"ok"},
      "replyTo": "open-log-request"
    },
    {"mutate":[{"op":"append","member":"log","text":"\ntwo"}],"units":"each"},
    {
      "receive": {
        "kind": "frame",
        "route": "log",
        "baseRevision": 0,
        "revision": 1,
        "changes": [{"field":"log","kind":"text","length":3,"trim":0,"text":"\ntwo"}]
      }
    },
    {"send":{"kind":"snapshot","route":"log"},"id":"final-read","role":"producer"},
    {
      "receive": {"ok":true,"revision":1,"state":{"log":"one\ntwo","title":"log"}},
      "replyTo": "final-read",
      "role": "producer"
    },
    {"expect":{"state":{"route":"log","value":{"log":"one\ntwo","title":"log"}}}}
  ]
}
