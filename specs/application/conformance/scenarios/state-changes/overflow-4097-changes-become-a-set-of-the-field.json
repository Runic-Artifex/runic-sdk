{
  "format": "runic.views.scenario/1",
  "id": "state-changes.overflow-4097-changes-become-a-set-of-the-field.v1",
  "contract": {"id":"runic.views","version":4},
  "set": "state-changes",
  "roles": ["producer","client"],
  "description": "A frame carries at most 4,096 changes. A unit with more replaces the indexed changes of the collection with one set.",
  "source": "specs/application/fixtures/collection-deltas/overflow.json#4097 changes fall back to a snapshot",
  "view": "list",
  "ids": {
    "c1": {"kind":"connection"},
    "hello-c1": {"kind":"request"},
    "session": {"kind":"wire","value":"s-1"},
    "open-list": {"kind":"call"},
    "open-list-request": {"kind":"request"},
    "presentation": {"kind":"wire","value":"p-1"},
    "final-read": {"kind":"request"}
  },
  "arrange": {"model":{"rows":[],"title":"rows"}},
  "steps": [
    {"connect":"c1"},
    {
      "send": {
        "kind": "hello",
        "protocol": 4,
        "session": {"$id":"session"},
        "client": {"name":{"$any":"string","default":"conformance-client"},"version":{"$any":"string","default":"1.0.0"}}
      },
      "id": "hello-c1"
    },
    {
      "receive": {
        "ok": true,
        "protocol": 4,
        "implementation": {"name":{"$any":"string","default":"conformance-producer"},"version":{"$any":"string","default":"1.0.0"}}
      },
      "replyTo": "hello-c1"
    },
    {"call":{"id":"open-list","op":"open","route":"list"}},
    {"send":{"kind":"open","route":"list","presentation":{"$id":"presentation"}},"id":"open-list-request"},
    {
      "receive": {"ok":true,"revision":0,"state":{"rows":[],"title":"rows"},"presentation":"ok"},
      "replyTo": "open-list-request"
    },
    {"mutate":[{"op":"appendRows","start":0,"count":4097}]},
    {
      "receive": {
        "kind": "frame",
        "route": "list",
        "baseRevision": 0,
        "revision": 4097,
        "changes": [{"field":"rows","kind":"set","value":[{"$rows":[0,4097]}]}]
      }
    },
    {"send":{"kind":"snapshot","route":"list"},"id":"final-read","role":"producer"},
    {
      "receive": {"ok":true,"revision":4097,"state":{"rows":[{"$rows":[0,4097]}],"title":"rows"}},
      "replyTo": "final-read",
      "role": "producer"
    },
    {"expect":{"state":{"route":"list","value":{"rows":[{"$rows":[0,4097]}],"title":"rows"}}}}
  ]
}
