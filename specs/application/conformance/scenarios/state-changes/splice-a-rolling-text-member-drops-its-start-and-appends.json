    {"receive":{"kind":"frame","route":"log","baseRevision":0,"revision":1,"changes":[{"field":"title","kind":"splice","length":96,"index":0,"delete":16,"text":""},{"field":"title","kind":"splice","length":80,"index":80,"delete":0,"text":"line 13\nline 14\n"}]}},
