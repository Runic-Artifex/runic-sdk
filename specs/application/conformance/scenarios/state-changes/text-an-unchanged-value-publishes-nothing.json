{
  "format": "runic.views.scenario/1",
  "id": "state-changes.text-an-unchanged-value-publishes-nothing.v1",
  "contract": {"id":"runic.views","version":4},
  "set": "state-changes",
  "roles": ["producer","client"],
  "description": "Members are compared at publication: assigning the same value publishes nothing.",
  "source": "specs/application/fixtures/text-deltas/text.json#a notification without a change is a full state",
  "view": "log",
  "ids": {
    "c1": {"kind":"connection"},
    "hello-c1": {"kind":"request"},
    "session": {"kind":"wire","value":"s-1"},
    "open-log": {"kind":"call"},
    "open-log-request": {"kind":"request"},
    "presentation": {"kind":"wire","value":"p-1"},
    "final-read": {"kind":"request"}
  },
  "arrange": {"model":{"log":"a","title":"log"}},
  "steps": [
    {"connect":"c1"},
    {
      "send": {
        "kind": "hello",
        "protocol": 4,
        "session": {"$id":"session"},
        "client": {"name":{"$any":"string","default":"conformance-client"},"version":{"$any":"string","default":"1.0.0"}}
      },
      "id": "hello-c1"
    },
    {
      "receive": {
        "ok": true,
        "protocol": 4,
        "implementation": {"name":{"$any":"string","default":"conformance-producer"},"version":{"$any":"string","default":"1.0.0"}}
      },
      "replyTo": "hello-c1"
    },
    {"call":{"id":"open-log","op":"open","route":"log"}},
    {"send":{"kind":"open","route":"log","presentation":{"$id":"presentation"}},"id":"open-log-request"},
    {
      "receive": {"ok":true,"revision":0,"state":{"log":"a","title":"log"},"presentation":"ok"},
      "replyTo": "open-log-request"
    },
    {"mutate":[{"op":"assign","member":"log","value":"a"}],"units":"each"},
    {"send":{"kind":"snapshot","route":"log"},"id":"final-read","role":"producer"},
    {"receive":{"ok":true,"revision":0,"state":{"log":"a","title":"log"}},"replyTo":"final-read","role":"producer"},
    {"expect":{"state":{"route":"log","value":{"log":"a","title":"log"}}}}
  ]
}
