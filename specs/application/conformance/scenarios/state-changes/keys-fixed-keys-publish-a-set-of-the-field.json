{
  "format": "runic.views.scenario/1",
  "id": "state-changes.keys-fixed-keys-publish-a-set-of-the-field.v1",
  "contract": {"id":"runic.views","version":4},
  "set": "state-changes",
  "roles": ["producer","client"],
  "description": "While keys are invalid nothing but a failure notice is published. The first publication with valid keys is a frame on the last published revision with a set of the field.",
  "source": "specs/application/fixtures/collection-deltas/keys.json#fixed keys publish a full state",
  "view": "list",
  "requires": ["held-delivery"],
  "ids": {
    "c1": {"kind":"connection"},
    "hello-c1": {"kind":"request"},
    "session": {"kind":"wire","value":"s-1"},
    "open-list": {"kind":"call"},
    "open-list-request": {"kind":"request"},
    "presentation": {"kind":"wire","value":"p-1"},
    "final-read": {"kind":"request"}
  },
  "arrange": {"model":{"rows":[{"id":1,"label":"one"}],"title":"rows"}},
  "steps": [
    {"connect":"c1"},
    {
      "send": {
        "kind": "hello",
        "protocol": 4,
        "session": {"$id":"session"},
        "client": {"name":{"$any":"string","default":"conformance-client"},"version":{"$any":"string","default":"1.0.0"}},
        "features": {"$any":"array","default":["text-splice/1"]}
      },
      "id": "hello-c1"
    },
    {
      "receive": {
        "ok": true,
        "protocol": 4,
        "implementation": {"name":{"$any":"string","default":"conformance-producer"},"version":{"$any":"string","default":"1.0.0"}},
        "features": {"$any":"array","default":["text-splice/1"]}
      },
      "replyTo": "hello-c1"
    },
    {"call":{"id":"open-list","op":"open","route":"list"}},
    {"send":{"kind":"open","route":"list","presentation":{"$id":"presentation"}},"id":"open-list-request"},
    {
      "receive": {"ok":true,"revision":0,"state":{"rows":[{"id":1,"label":"one"}],"title":"rows"},"presentation":"ok"},
      "replyTo": "open-list-request"
    },
    {"delivery":"hold"},
    {"mutate":[{"op":"insert","index":0,"item":{"id":1,"label":"again"}},{"op":"removeAt","index":0}],"units":"each"},
    {"delivery":"release"},
    {
      "receive": {
        "kind": "failure",
        "route": "list",
        "revision": 1,
        "error": {
          "kind": "failed",
          "message": {
            "$any": "string",
            "default": "CollectionDeltaViewModel.rows: rows 0 and 1 have the same key. [RunicCollection] keys must be nonempty and unique within the collection."
          }
        }
      }
    },
    {
      "receive": {
        "kind": "frame",
        "route": "list",
        "baseRevision": 0,
        "revision": 2,
        "changes": [{"field":"rows","kind":"set","value":[{"id":1,"label":"one"}]}]
      }
    },
    {"send":{"kind":"snapshot","route":"list"},"id":"final-read","role":"producer"},
    {
      "receive": {"ok":true,"revision":2,"state":{"rows":[{"id":1,"label":"one"}],"title":"rows"}},
      "replyTo": "final-read",
      "role": "producer"
    },
    {"expect":{"state":{"route":"list","value":{"rows":[{"id":1,"label":"one"}],"title":"rows"}}}}
  ]
}
