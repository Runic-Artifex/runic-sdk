{
  "format": "runic.views.scenario/1",
  "id": "state-changes.checked-field-version-counts-each-change.v1",
  "contract": {"id":"runic.views","version":4},
  "set": "state-changes",
  "roles": ["producer"],
  "description": "A checked field's version counts the field's changes, not revisions: it starts at 0 and takes 1 more for each change the model announces, also of an equal value, and for each write the producer applies. Two announced changes in one unit publish one set with the version 2 more (state-changes.md, \"Members\").",
  "view": "notes",
  "ids": {
    "c1": {"kind":"connection"},
    "hello-c1": {"kind":"request"},
    "session": {"kind":"wire","value":"s-1"},
    "open-notes-request": {"kind":"request"},
    "presentation": {"kind":"wire","value":"p-1"},
    "final-read": {"kind":"request"},
    "write-request": {"kind":"request"},
    "writeRequest": {"kind":"wire","value":"w-1"}
  },
  "arrange": {"model":{}},
  "steps": [
    {"connect":"c1"},
    {
      "send": {
        "kind": "hello",
        "protocol": 4,
        "session": {"$id":"session"},
        "client": {"name":{"$any":"string","default":"conformance-client"},"version":{"$any":"string","default":"1.0.0"}},
        "features": {"$any":"array","default":["text-splice/1"]}
      },
      "id": "hello-c1"
    },
    {
      "receive": {
        "ok": true,
        "protocol": 4,
        "implementation": {
          "name": {"$any":"string","default":"conformance-producer"},
          "version": {"$any":"string","default":"1.0.0"}
        },
        "features": {"$any":"array","default":["text-splice/1"]}
      },
      "replyTo": "hello-c1"
    },
    {"send":{"kind":"open","route":"notes","presentation":{"$id":"presentation"}},"id":"open-notes-request"},
    {
      "receive": {
        "ok": true,
        "revision": 0,
        "state": {
          "title": "",
          "note": "",
          "priority": "Normal",
          "due": null,
          "elapsed": "PT0S",
          "rows": [],
          "count": 0,
          "summary": "rows: 0",
          "detail": {"kind":"detail","id":"0123456789abcdef0123456789abcdef"},
          "canClear": false,
          "canTouch": true,
          "canSave": true,
          "canConfirmClear": false,
          "isSlowImportExecuting": false,
          "isConfirmClearExecuting": false
        },
        "fields": {"note":{"version":0}},
        "presentation": "ok"
      },
      "replyTo": "open-notes-request"
    },
    {
      "mutate": [{"op":"assign","member":"note","value":"x"},{"op":"assign","member":"note","value":"y"}],
      "note": "Two announced changes in one unit."
    },
    {
      "receive": {
        "kind": "frame",
        "route": "notes",
        "baseRevision": 0,
        "revision": 1,
        "changes": [{"field":"note","kind":"set","value":"y","version":2}]
      }
    },
    {"mutate":[{"op":"assign","member":"note","value":"y"}],"note":"An announced change to an equal value."},
    {
      "receive": {
        "kind": "frame",
        "route": "notes",
        "baseRevision": 1,
        "revision": 2,
        "changes": [{"field":"note","kind":"set","value":"y","version":3}]
      }
    },
    {
      "send": {
        "kind": "write",
        "route": "notes",
        "member": "note",
        "requestId": {"$id":"writeRequest"},
        "expectedVersion": 3,
        "expectedValue": "y",
        "value": "z"
      },
      "id": "write-request"
    },
    {
      "receive": {
        "kind": "frame",
        "route": "notes",
        "baseRevision": 2,
        "revision": 3,
        "changes": [{"field":"note","kind":"set","value":"z","version":4}]
      }
    },
    {
      "receive": {"ok":true,"revision":3,"receipt":{"kind":"applied","snapshot":{"value":"z","version":4}}},
      "replyTo": "write-request"
    },
    {"send":{"kind":"snapshot","route":"notes"},"id":"final-read"},
    {
      "receive": {
        "ok": true,
        "revision": 3,
        "state": {
          "title": "",
          "note": "z",
          "priority": "Normal",
          "due": null,
          "elapsed": "PT0S",
          "rows": [],
          "count": 0,
          "summary": "rows: 0",
          "detail": {"kind":"detail","id":"0123456789abcdef0123456789abcdef"},
          "canClear": false,
          "canTouch": true,
          "canSave": true,
          "canConfirmClear": false,
          "isSlowImportExecuting": false,
          "isConfirmClearExecuting": false
        },
        "fields": {"note":{"version":4}}
      },
      "replyTo": "final-read"
    }
  ]
}
