{
  "format": "runic.views.scenario/1",
  "id": "state-changes.set-resets-collection.v1",
  "contract": {"id":"runic.views","version":4},
  "set": "state-changes",
  "roles": ["producer","client"],
  "description": "A reset of a keyed collection is a set of the field, with the derived members, instead of a full state.",
  "view": "notes",
  "ids": {
    "c1": {"kind":"connection"},
    "hello-c1": {"kind":"request"},
    "session": {"kind":"wire","value":"s-1"},
    "open-notes": {"kind":"call"},
    "open-notes-request": {"kind":"request"},
    "presentation": {"kind":"wire","value":"p-1"}
  },
  "arrange": {"model":{"rows":[{"id":1,"label":"one"},{"id":2,"label":"two"}]}},
  "steps": [
    {"connect":"c1"},
    {
      "send": {
        "kind": "hello",
        "protocol": 4,
        "session": {"$id":"session"},
        "client": {"name":{"$any":"string","default":"conformance-client"},"version":{"$any":"string","default":"1.0.0"}},
        "features": {"$any":"array","default":["text-splice/1"]}
      },
      "id": "hello-c1"
    },
    {
      "receive": {
        "ok": true,
        "protocol": 4,
        "implementation": {"name":{"$any":"string","default":"conformance-producer"},"version":{"$any":"string","default":"1.0.0"}},
        "features": {"$any":"array","default":["text-splice/1"]}
      },
      "replyTo": "hello-c1"
    },
    {"call":{"id":"open-notes","op":"open","route":"notes"}},
    {"send":{"kind":"open","route":"notes","presentation":{"$id":"presentation"}},"id":"open-notes-request"},
    {
      "receive": {
        "ok": true,
        "revision": 0,
        "state": {
          "title": "",
          "note": "",
          "priority": "Normal",
          "due": null,
          "elapsed": "PT0S",
          "rows": [{"id":1,"label":"one"},{"id":2,"label":"two"}],
          "count": 2,
          "summary": "rows: 2",
          "detail": {"kind":"detail","id":"0123456789abcdef0123456789abcdef"},
          "canClear": true,
          "canTouch": true,
          "canSave": true,
          "canConfirmClear": true,
          "isSlowImportExecuting": false,
          "isConfirmClearExecuting": false
        },
        "fields": {"note":{"version":0}},
        "presentation": "ok"
      },
      "replyTo": "open-notes-request"
    },
    {"mutate":[{"op":"reset","items":[]}]},
    {
      "receive": {
        "kind": "frame",
        "route": "notes",
        "baseRevision": 0,
        "revision": 1,
        "changes": [
          {"field":"rows","kind":"set","value":[]},
          {"field":"count","kind":"set","value":0},
          {"field":"summary","kind":"set","value":"rows: 0"},
          {"field":"canClear","kind":"set","value":false},
          {"field":"canConfirmClear","kind":"set","value":false}
        ]
      }
    },
    {
      "expect": {
        "state": {
          "route": "notes",
          "value": {
            "title": "",
            "note": "",
            "priority": "Normal",
            "due": null,
            "elapsed": "PT0S",
            "rows": [],
            "count": 0,
            "summary": "rows: 0",
            "detail": {"kind":"detail","id":"0123456789abcdef0123456789abcdef"},
            "canClear": false,
            "canTouch": true,
            "canSave": true,
            "canConfirmClear": false,
            "isSlowImportExecuting": false,
            "isConfirmClearExecuting": false
          }
        }
      }
    }
  ]
}
