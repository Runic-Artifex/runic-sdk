{
  "format": "runic.views.scenario/1",
  "id": "state-changes.one-unit-that-changes-two-routes.v1",
  "contract": {"id":"runic.views","version":4},
  "set": "state-changes",
  "roles": ["producer"],
  "description": "One publication unit that changes two routes publishes one frame on each route, and each frame takes its own revision of the window's counter (state-changes.md, \"Publication units\"). The order of the two frames is the producer's.",
  "view": "notes",
  "ids": {
    "c1": {"kind":"connection"},
    "hello-c1": {"kind":"request"},
    "session": {"kind":"wire","value":"s-1"},
    "open-notes-request": {"kind":"request"},
    "presentation": {"kind":"wire","value":"p-1"},
    "open-detail-request": {"kind":"request"},
    "detailPresentation": {"kind":"wire","value":"p-detail"},
    "final-notes": {"kind":"request"},
    "final-detail": {"kind":"request"}
  },
  "arrange": {"model":{}},
  "steps": [
    {"connect":"c1"},
    {
      "send": {
        "kind": "hello",
        "protocol": 4,
        "session": {"$id":"session"},
        "client": {
          "name": {"$any":"string","default":"conformance-client"},
          "version": {"$any":"string","default":"1.0.0"}
        },
        "features": {"$any":"array","default":["text-splice/1"]}
      },
      "id": "hello-c1"
    },
    {
      "receive": {
        "ok": true,
        "protocol": 4,
        "implementation": {
          "name": {"$any":"string","default":"conformance-producer"},
          "version": {"$any":"string","default":"1.0.0"}
        },
        "features": {"$any":"array","default":["text-splice/1"]}
      },
      "replyTo": "hello-c1"
    },
    {"send":{"kind":"open","route":"notes","presentation":{"$id":"presentation"}},"id":"open-notes-request"},
    {
      "receive": {
        "ok": true,
        "revision": 0,
        "state": {
          "title": "",
          "note": "",
          "priority": "Normal",
          "due": null,
          "elapsed": "PT0S",
          "rows": [],
          "count": 0,
          "summary": "rows: 0",
          "detail": {"kind":"detail","id":"0123456789abcdef0123456789abcdef"},
          "canClear": false,
          "canTouch": true,
          "canSave": true,
          "canConfirmClear": false,
          "isSlowImportExecuting": false,
          "isConfirmClearExecuting": false
        },
        "fields": {"note":{"version":0}},
        "presentation": "ok"
      },
      "replyTo": "open-notes-request"
    },
    {
      "send": {
        "kind": "open",
        "route": "content0123456789abcdef0123456789abcdef",
        "presentation": {"$id":"detailPresentation"}
      },
      "id": "open-detail-request"
    },
    {
      "receive": {"ok":true,"revision":0,"state":{"lastAction":"","canDismiss":true},"presentation":"ok"},
      "replyTo": "open-detail-request"
    },
    {
      "mutate": [
        {"op":"assign","member":"title","value":"a"},
        {"op":"assign","view":"detail","member":"lastAction","value":"b"}
      ],
      "note": "One mutate step is one unit: it changes the notes route and the detail route."
    },
    {
      "receive": {
        "kind": "frame",
        "route": "notes",
        "baseRevision": 0,
        "revision": 1,
        "changes": [{"field":"title","kind":"set","value":"a"}]
      },
      "unordered": true
    },
    {
      "receive": {
        "kind": "frame",
        "route": "content0123456789abcdef0123456789abcdef",
        "baseRevision": 0,
        "revision": 2,
        "changes": [{"field":"lastAction","kind":"set","value":"b"}]
      },
      "unordered": true
    },
    {"send":{"kind":"snapshot","route":"notes"},"id":"final-notes"},
    {
      "receive": {
        "ok": true,
        "revision": 1,
        "state": {
          "title": "a",
          "note": "",
          "priority": "Normal",
          "due": null,
          "elapsed": "PT0S",
          "rows": [],
          "count": 0,
          "summary": "rows: 0",
          "detail": {"kind":"detail","id":"0123456789abcdef0123456789abcdef"},
          "canClear": false,
          "canTouch": true,
          "canSave": true,
          "canConfirmClear": false,
          "isSlowImportExecuting": false,
          "isConfirmClearExecuting": false
        },
        "fields": {"note":{"version":0}}
      },
      "replyTo": "final-notes"
    },
    {"send":{"kind":"snapshot","route":"content0123456789abcdef0123456789abcdef"},"id":"final-detail"},
    {"receive":{"ok":true,"revision":2,"state":{"lastAction":"b","canDismiss":true}},"replyTo":"final-detail"}
  ]
}
