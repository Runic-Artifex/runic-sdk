{
  "format": "runic.views.scenario/1",
  "id": "state-changes.keys-a-replacement-row-with-another-row-s-key.v1",
  "contract": {"id":"runic.views","version":4},
  "set": "state-changes",
  "roles": ["producer","client"],
  "description": "Invalid keys. The producer never publishes a state or frame whose collection has a null row or a missing, empty or duplicate key. A change publishes a failure notice instead, and nothing else until the keys are valid again; a snapshot read fails with state-withheld. Case: a replacement row with another row's key.",
  "source": "specs/application/fixtures/collection-deltas/keys.json#a replacement row with another row's key",
  "view": "list",
  "ids": {
    "c1": {"kind":"connection"},
    "hello-c1": {"kind":"request"},
    "session": {"kind":"wire","value":"s-1"},
    "open-list": {"kind":"call"},
    "open-list-request": {"kind":"request"},
    "presentation": {"kind":"wire","value":"p-1"},
    "final-read": {"kind":"request"}
  },
  "arrange": {"model":{"rows":[{"id":1,"label":"one"},{"id":2,"label":"two"}],"title":"rows"}},
  "steps": [
    {"connect":"c1"},
    {
      "send": {
        "kind": "hello",
        "protocol": 4,
        "session": {"$id":"session"},
        "client": {"name":{"$any":"string","default":"conformance-client"},"version":{"$any":"string","default":"1.0.0"}}
      },
      "id": "hello-c1"
    },
    {
      "receive": {
        "ok": true,
        "protocol": 4,
        "implementation": {"name":{"$any":"string","default":"conformance-producer"},"version":{"$any":"string","default":"1.0.0"}}
      },
      "replyTo": "hello-c1"
    },
    {"call":{"id":"open-list","op":"open","route":"list"}},
    {"send":{"kind":"open","route":"list","presentation":{"$id":"presentation"}},"id":"open-list-request"},
    {
      "receive": {
        "ok": true,
        "revision": 0,
        "state": {"rows":[{"id":1,"label":"one"},{"id":2,"label":"two"}],"title":"rows"},
        "presentation": "ok"
      },
      "replyTo": "open-list-request"
    },
    {"mutate":[{"op":"replaceAt","index":1,"item":{"id":1,"label":"again"}}],"units":"each"},
    {
      "receive": {
        "kind": "failure",
        "route": "list",
        "revision": 1,
        "error": {
          "kind": "failed",
          "message": {
            "$any": "string",
            "default": "CollectionDeltaViewModel.rows: rows 0 and 1 have the same key. [RunicCollection] keys must be nonempty and unique within the collection."
          }
        }
      }
    },
    {"send":{"kind":"snapshot","route":"list"},"id":"final-read","role":"producer"},
    {
      "receive": {
        "ok": false,
        "error": {
          "kind": "failed",
          "reason": "state-withheld",
          "message": {
            "$any": "string",
            "default": "CollectionDeltaViewModel.rows: rows 0 and 1 have the same key. [RunicCollection] keys must be nonempty and unique within the collection."
          }
        }
      },
      "replyTo": "final-read",
      "role": "producer"
    },
    {
      "expect": {"state":{"route":"list","value":{"rows":[{"id":1,"label":"one"},{"id":2,"label":"two"}],"title":"rows"}}}
    },
    {"expect":{"diagnostics":["failed"]}}
  ]
}
