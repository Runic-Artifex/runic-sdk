{
  "format": "runic.views.scenario/1",
  "id": "state-changes.splice-a-short-text-member-stays-a-set.v1",
  "contract": {"id":"runic.views","version":4},
  "set": "state-changes",
  "roles": ["producer","client"],
  "description": "A splice that keeps fewer than 64 code units of the old value is published as a set.",
  "view": "log",
  "requires": ["text-splice/1"],
  "ids": {
    "c1": {"kind":"connection"},
    "hello-c1": {"kind":"request"},
    "session": {"kind":"wire","value":"s-1"},
    "open-log": {"kind":"call"},
    "open-log-request": {"kind":"request"},
    "final-read": {"kind":"request"},
    "presentation": {"kind":"wire","value":"p-1"}
  },
  "arrange": {"model":{"title":"A short title"}},
  "steps": [
    {"connect":"c1"},
    {"send":{"kind":"hello","protocol":4,"session":{"$id":"session"},"client":{"name":{"$any":"string","default":"conformance-client"},"version":{"$any":"string","default":"1.0.0"}},"features":{"$any":"array","default":["text-splice/1"]}},"id":"hello-c1"},
    {"receive":{"ok":true,"protocol":4,"implementation":{"name":{"$any":"string","default":"conformance-producer"},"version":{"$any":"string","default":"1.0.0"}},"features":{"$any":"array","default":["text-splice/1"]}},"replyTo":"hello-c1"},
    {"call":{"id":"open-log","op":"open","route":"log"}},
    {"send":{"kind":"open","route":"log","presentation":{"$id":"presentation"}},"id":"open-log-request"},
    {"receive":{"ok":true,"revision":0,"state":{"log":"","title":"A short title"},"presentation":"ok"},"replyTo":"open-log-request"},
    {"mutate":[{"op":"assign","member":"title","value":"A short title!"}]},
    {"receive":{"kind":"frame","route":"log","baseRevision":0,"revision":1,"changes":[{"field":"title","kind":"set","value":"A short title!"}]}},
    {"send":{"kind":"snapshot","route":"log"},"id":"final-read","role":"producer"},
    {"receive":{"ok":true,"revision":1,"state":{"log":"","title":"A short title!"}},"replyTo":"final-read","role":"producer"},
    {"expect":{"state":{"route":"log","value":{"log":"","title":"A short title!"}}}}
  ]
}
