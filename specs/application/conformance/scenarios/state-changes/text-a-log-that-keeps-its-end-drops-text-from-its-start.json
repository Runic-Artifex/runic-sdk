{
  "format": "runic.views.scenario/1",
  "id": "state-changes.text-a-log-that-keeps-its-end-drops-text-from-its-start.v1",
  "contract": {"id":"runic.views","version":4},
  "set": "state-changes",
  "roles": ["producer","client"],
  "description": "An append-only text field publishes a text change: drop trim UTF-16 code units from the start of the length code units the client has, then append text. Case: a log that keeps its end drops text from its start.",
  "source": "specs/application/fixtures/text-deltas/text.json#a log that keeps its end drops text from its start",
  "view": "log",
  "ids": {
    "c1": {"kind":"connection"},
    "hello-c1": {"kind":"request"},
    "session": {"kind":"wire","value":"s-1"},
    "open-log": {"kind":"call"},
    "open-log-request": {"kind":"request"},
    "presentation": {"kind":"wire","value":"p-1"},
    "final-read": {"kind":"request"}
  },
  "arrange": {"model":{"log":"abcdef","title":"log"}},
  "steps": [
    {"connect":"c1"},
    {
      "send": {
        "kind": "hello",
        "protocol": 4,
        "session": {"$id":"session"},
        "client": {"name":{"$any":"string","default":"conformance-client"},"version":{"$any":"string","default":"1.0.0"}},
        "features": {"$any":"array","default":["text-splice/1"]}
      },
      "id": "hello-c1"
    },
    {
      "receive": {
        "ok": true,
        "protocol": 4,
        "implementation": {"name":{"$any":"string","default":"conformance-producer"},"version":{"$any":"string","default":"1.0.0"}},
        "features": {"$any":"array","default":["text-splice/1"]}
      },
      "replyTo": "hello-c1"
    },
    {"call":{"id":"open-log","op":"open","route":"log"}},
    {"send":{"kind":"open","route":"log","presentation":{"$id":"presentation"}},"id":"open-log-request"},
    {
      "receive": {"ok":true,"revision":0,"state":{"log":"abcdef","title":"log"},"presentation":"ok"},
      "replyTo": "open-log-request"
    },
    {"mutate":[{"op":"assign","member":"log","value":"cdefgh"}],"units":"each"},
    {
      "receive": {
        "kind": "frame",
        "route": "log",
        "baseRevision": 0,
        "revision": 1,
        "changes": [{"field":"log","kind":"text","length":6,"trim":2,"text":"gh"}]
      }
    },
    {"send":{"kind":"snapshot","route":"log"},"id":"final-read","role":"producer"},
    {"receive":{"ok":true,"revision":1,"state":{"log":"cdefgh","title":"log"}},"replyTo":"final-read","role":"producer"},
    {"expect":{"state":{"route":"log","value":{"log":"cdefgh","title":"log"}}}}
  ]
}
