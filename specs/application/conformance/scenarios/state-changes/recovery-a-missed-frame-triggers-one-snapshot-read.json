{
  "format": "runic.views.scenario/1",
  "id": "state-changes.recovery-a-missed-frame-triggers-one-snapshot-read.v1",
  "contract": {"id":"runic.views","version":4},
  "set": "state-changes",
  "roles": ["producer","client"],
  "description": "Recovery paths. A route retains at most 64 undelivered pushes or 1 MiB of them before a recovery state supersedes them; a client that misses a frame reads one snapshot, applies frames that arrive during the read after it, and retries a failed read. Case: a missed frame triggers one snapshot read.",
  "source": "specs/application/fixtures/collection-deltas/recovery.json#a missed frame triggers one snapshot read",
  "view": "list",
  "ids": {
    "c1": {"kind":"connection"},
    "hello-c1": {"kind":"request"},
    "session": {"kind":"wire","value":"s-1"},
    "open-list": {"kind":"call"},
    "open-list-request": {"kind":"request"},
    "presentation": {"kind":"wire","value":"p-1"},
    "recovery-1": {"kind":"request"},
    "final-read": {"kind":"request"}
  },
  "arrange": {"model":{"rows":[{"id":1,"label":"one"}],"title":"rows"}},
  "steps": [
    {"connect":"c1"},
    {
      "send": {
        "kind": "hello",
        "protocol": 4,
        "session": {"$id":"session"},
        "client": {"name":{"$any":"string","default":"conformance-client"},"version":{"$any":"string","default":"1.0.0"}}
      },
      "id": "hello-c1"
    },
    {
      "receive": {
        "ok": true,
        "protocol": 4,
        "implementation": {"name":{"$any":"string","default":"conformance-producer"},"version":{"$any":"string","default":"1.0.0"}}
      },
      "replyTo": "hello-c1"
    },
    {"call":{"id":"open-list","op":"open","route":"list"}},
    {"send":{"kind":"open","route":"list","presentation":{"$id":"presentation"}},"id":"open-list-request"},
    {
      "receive": {"ok":true,"revision":0,"state":{"rows":[{"id":1,"label":"one"}],"title":"rows"},"presentation":"ok"},
      "replyTo": "open-list-request"
    },
    {"mutate":[{"op":"insert","index":1,"item":{"id":2,"label":"two"}}]},
    {"mutate":[{"op":"insert","index":2,"item":{"id":3,"label":"three"}}]},
    {"mutate":[{"op":"removeAt","index":0}]},
    {
      "receive": {
        "kind": "frame",
        "route": "list",
        "baseRevision": 0,
        "revision": 1,
        "changes": [{"field":"rows","kind":"add","index":1,"oldIndex":-1,"keys":["2"],"items":[{"id":2,"label":"two"}]}]
      }
    },
    {
      "receive": {
        "kind": "frame",
        "route": "list",
        "baseRevision": 1,
        "revision": 2,
        "changes": [{"field":"rows","kind":"add","index":2,"oldIndex":-1,"keys":["3"],"items":[{"id":3,"label":"three"}]}]
      },
      "drop": true
    },
    {
      "receive": {
        "kind": "frame",
        "route": "list",
        "baseRevision": 2,
        "revision": 3,
        "changes": [{"field":"rows","kind":"remove","index":0,"oldIndex":0,"keys":["1"],"items":[]}]
      }
    },
    {"send":{"kind":"snapshot","route":"list"},"id":"recovery-1"},
    {
      "receive": {"ok":true,"revision":3,"state":{"rows":[{"id":2,"label":"two"},{"id":3,"label":"three"}],"title":"rows"}},
      "replyTo": "recovery-1"
    },
    {"send":{"kind":"snapshot","route":"list"},"id":"final-read","role":"producer"},
    {
      "receive": {"ok":true,"revision":3,"state":{"rows":[{"id":2,"label":"two"},{"id":3,"label":"three"}],"title":"rows"}},
      "replyTo": "final-read",
      "role": "producer"
    },
    {
      "expect": {"state":{"route":"list","value":{"rows":[{"id":2,"label":"two"},{"id":3,"label":"three"}],"title":"rows"}}}
    }
  ]
}
