{
  "format": "runic.views.scenario/1",
  "id": "state-changes.add-append.v1",
  "contract": {"id":"runic.views","version":4},
  "set": "state-changes",
  "roles": ["producer","client"],
  "description": "An add inserts new rows at index. keys are the keys of the new rows; oldIndex is -1. Case: append.",
  "source": "specs/application/fixtures/collection-deltas/add.json#append",
  "view": "list",
  "ids": {
    "c1": {"kind":"connection"},
    "hello-c1": {"kind":"request"},
    "session": {"kind":"wire","value":"s-1"},
    "open-list": {"kind":"call"},
    "open-list-request": {"kind":"request"},
    "presentation": {"kind":"wire","value":"p-1"},
    "final-read": {"kind":"request"}
  },
  "arrange": {"model":{"rows":[{"id":1,"label":"one"},{"id":2,"label":"two"}],"title":"rows"}},
  "steps": [
    {"connect":"c1"},
    {
      "send": {
        "kind": "hello",
        "protocol": 4,
        "session": {"$id":"session"},
        "client": {"name":{"$any":"string","default":"conformance-client"},"version":{"$any":"string","default":"1.0.0"}}
      },
      "id": "hello-c1"
    },
    {
      "receive": {
        "ok": true,
        "protocol": 4,
        "implementation": {"name":{"$any":"string","default":"conformance-producer"},"version":{"$any":"string","default":"1.0.0"}}
      },
      "replyTo": "hello-c1"
    },
    {"call":{"id":"open-list","op":"open","route":"list"}},
    {"send":{"kind":"open","route":"list","presentation":{"$id":"presentation"}},"id":"open-list-request"},
    {
      "receive": {
        "ok": true,
        "revision": 0,
        "state": {"rows":[{"id":1,"label":"one"},{"id":2,"label":"two"}],"title":"rows"},
        "presentation": "ok"
      },
      "replyTo": "open-list-request"
    },
    {"mutate":[{"op":"insert","index":2,"item":{"id":3,"label":"three"}}]},
    {
      "receive": {
        "kind": "frame",
        "route": "list",
        "baseRevision": 0,
        "revision": 1,
        "changes": [{"field":"rows","kind":"add","index":2,"oldIndex":-1,"keys":["3"],"items":[{"id":3,"label":"three"}]}]
      }
    },
    {"send":{"kind":"snapshot","route":"list"},"id":"final-read","role":"producer"},
    {
      "receive": {
        "ok": true,
        "revision": 1,
        "state": {"rows":[{"id":1,"label":"one"},{"id":2,"label":"two"},{"id":3,"label":"three"}],"title":"rows"}
      },
      "replyTo": "final-read",
      "role": "producer"
    },
    {
      "expect": {
        "state": {
          "route": "list",
          "value": {"rows":[{"id":1,"label":"one"},{"id":2,"label":"two"},{"id":3,"label":"three"}],"title":"rows"}
        }
      }
    }
  ]
}
