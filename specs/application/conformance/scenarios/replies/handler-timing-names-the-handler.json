{
  "format": "runic.views.scenario/1",
  "id": "replies.handler-timing-names-the-handler.v1",
  "contract": {"id":"runic.views","version":4},
  "set": "replies",
  "roles": ["producer"],
  "requires": ["handler-timing/1"],
  "description": "On a connection that uses handler-timing/1, the reply to a command or setter with timing: true carries handler, the handler's name and duration; one without timing, and a can, carry none.",
  "view": "notes",
  "ids": {
    "c1": {"kind":"connection"},
    "hello-c1": {"kind":"request"},
    "open-notes": {"kind":"request"},
    "timed": {"kind":"request"},
    "untimed": {"kind":"request"},
    "set-timed": {"kind":"request"},
    "can-timed": {"kind":"request"},
    "session": {"kind":"wire","value":"s-1"},
    "presentation": {"kind":"wire","value":"p-1"}
  },
  "arrange": {"model":{}},
  "steps": [
    {"connect":"c1"},
    {"send":{"kind":"hello","protocol":4,"session":{"$id":"session"},"client":{"name":{"$any":"string","default":"conformance-client"},"version":{"$any":"string","default":"1.0.0"}},"features":{"$any":"array","default":["text-splice/1","handler-timing/1"]}},"id":"hello-c1"},
    {"receive":{"ok":true,"protocol":4,"implementation":{"name":{"$any":"string","default":"conformance-producer"},"version":{"$any":"string","default":"1.0.0"}},"features":{"$any":"array","default":["text-splice/1","handler-timing/1"]}},"replyTo":"hello-c1"},
    {"send":{"kind":"open","route":"notes","presentation":{"$id":"presentation"}},"id":"open-notes"},
    {"receive":{"ok":true,"revision":0,"state":{"title":"","note":"","priority":"Normal","due":null,"elapsed":"PT0S","rows":[],"count":0,"summary":"rows: 0","detail":{"kind":"detail","id":"0123456789abcdef0123456789abcdef"},"canClear":false,"canTouch":true,"canSave":true,"canConfirmClear":false,"isSlowImportExecuting":false,"isConfirmClearExecuting":false},"fields":{"note":{"version":0}},"presentation":"ok"},"replyTo":"open-notes"},
    {"send":{"kind":"command","route":"notes","member":"addRow","input":"a","timing":true},"id":"timed"},
    {"receive":{"kind":"frame","route":"notes","baseRevision":0,"revision":1,"changes":[{"field":"rows","kind":"add","index":0,"oldIndex":-1,"keys":["1"],"items":[{"id":1,"label":"a"}]},{"field":"count","kind":"set","value":1},{"field":"summary","kind":"set","value":"rows: 1"},{"field":"canClear","kind":"set","value":true},{"field":"canConfirmClear","kind":"set","value":true}]}},
    {"receive":{"ok":true,"revision":1,"handler":{"name":{"$any":"string","default":"NotesViewModel.AddRow"},"duration":{"$any":"number","default":1}}},"replyTo":"timed"},
    {"send":{"kind":"command","route":"notes","member":"addRow","input":"b"},"id":"untimed"},
    {"receive":{"kind":"frame","route":"notes","baseRevision":1,"revision":2,"changes":[{"field":"rows","kind":"add","index":1,"oldIndex":-1,"keys":["2"],"items":[{"id":2,"label":"b"}]},{"field":"count","kind":"set","value":2},{"field":"summary","kind":"set","value":"rows: 2"}]}},
    {"receive":{"ok":true,"revision":2},"replyTo":"untimed"},
    {"send":{"kind":"set","route":"notes","member":"title","edit":1,"value":"x","timing":true},"id":"set-timed"},
    {"receive":{"kind":"frame","route":"notes","baseRevision":2,"revision":3,"changes":[{"field":"title","kind":"set","value":"x"}]}},
    {"receive":{"ok":true,"revision":3,"handler":{"name":{"$any":"string","default":"NotesViewModel.Title"},"duration":{"$any":"number","default":1}}},"replyTo":"set-timed"},
    {"send":{"kind":"can","route":"notes","member":"addRow","input":"c","timing":true},"id":"can-timed"},
    {"receive":{"ok":true,"value":true},"replyTo":"can-timed"}
  ]
}
