{
  "format": "runic.views.scenario/1",
  "id": "replies.an-asynchronous-command-replies-when-it-ends.v1",
  "contract": {"id":"runic.views","version":4},
  "set": "replies",
  "roles": ["producer"],
  "description": "An asynchronous command invoked with command, not as an operation, keeps its request open while it runs; it replies when it ends, with the revision of the frame of its end, which carries its effects and its execution member. The command ends inside the finish mutation's unit, so the frame and the reply may arrive in either order.",
  "view": "notes",
  "ids": {
    "c1": {"kind":"connection"},
    "hello-c1": {"kind":"request"},
    "open-notes": {"kind":"request"},
    "command-request": {"kind":"request"},
    "session": {"kind":"wire","value":"s-1"},
    "presentation": {"kind":"wire","value":"p-1"}
  },
  "arrange": {"model":{}},
  "steps": [
    {"connect":"c1"},
    {"send":{"kind":"hello","protocol":4,"session":{"$id":"session"},"client":{"name":{"$any":"string","default":"conformance-client"},"version":{"$any":"string","default":"1.0.0"}},"features":["text-splice/1"]},"id":"hello-c1"},
    {"receive":{"ok":true,"protocol":4,"implementation":{"name":{"$any":"string","default":"conformance-producer"},"version":{"$any":"string","default":"1.0.0"}},"features":{"$any":"array","default":["text-splice/1"]}},"replyTo":"hello-c1"},
    {"send":{"kind":"open","route":"notes","presentation":{"$id":"presentation"}},"id":"open-notes"},
    {"receive":{"ok":true,"revision":0,"state":{"title":"","note":"","priority":"Normal","due":null,"elapsed":"PT0S","rows":[],"count":0,"summary":"rows: 0","detail":{"kind":"detail","id":"0123456789abcdef0123456789abcdef"},"canClear":false,"canTouch":true,"canSave":true,"canConfirmClear":false,"isSlowImportExecuting":false,"isConfirmClearExecuting":false},"fields":{"note":{"version":0}},"presentation":"ok"},"replyTo":"open-notes"},
    {"send":{"kind":"command","route":"notes","member":"slowImport","input":{"source":"a","limit":2}},"id":"command-request"},
    {"receive":{"kind":"frame","route":"notes","baseRevision":0,"revision":1,"changes":[{"field":"isSlowImportExecuting","kind":"set","value":true}]}},
    {"mutate":[{"op":"finish","member":"slowImport","rows":["x","y"]}]},
    {"receive":{"kind":"frame","route":"notes","baseRevision":1,"revision":2,"changes":[{"field":"rows","kind":"add","index":0,"oldIndex":-1,"keys":["1","2"],"items":[{"id":1,"label":"x"},{"id":2,"label":"y"}]},{"field":"count","kind":"set","value":2},{"field":"summary","kind":"set","value":"rows: 2"},{"field":"canClear","kind":"set","value":true},{"field":"canConfirmClear","kind":"set","value":true},{"field":"isSlowImportExecuting","kind":"set","value":false}]},"unordered":true},
    {"receive":{"ok":true,"revision":2},"replyTo":"command-request","unordered":true}
  ]
}
