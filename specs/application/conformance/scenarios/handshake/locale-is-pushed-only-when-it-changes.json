{
  "format": "runic.views.scenario/1",
  "id": "handshake.locale-is-pushed-only-when-it-changes.v1",
  "contract": {"id":"runic.views","version":4},
  "set": "handshake",
  "roles": ["producer"],
  "requires": ["translation-text/1"],
  "description": "Setting the locale the window already has pushes nothing; a tag is pushed as the application gives it, without changing its case.",
  "view": "list",
  "ids": {
    "c1": {"kind":"connection"},
    "hello-c1": {"kind":"request"},
    "session": {"kind":"wire","value":"s-1"}
  },
  "arrange": {"model":{}},
  "steps": [
    {"connect":"c1"},
    {"send":{"kind":"hello","protocol":4,"session":{"$id":"session"},"client":{"name":{"$any":"string","default":"conformance-client"},"version":{"$any":"string","default":"1.0.0"}},"features":{"$any":"array","default":["text-splice/1","translation-text/1"]}},"id":"hello-c1"},
    {"receive":{"ok":true,"protocol":4,"implementation":{"name":{"$any":"string","default":"conformance-producer"},"version":{"$any":"string","default":"1.0.0"}},"features":{"$any":"array","default":["text-splice/1","translation-text/1"]}},"replyTo":"hello-c1"},
    {"setLocale":"de"},
    {"receive":{"kind":"locale","locale":"de"}},
    {"setLocale":"de","note":"The same locale: no push."},
    {"setLocale":"de-ch"},
    {"receive":{"kind":"locale","locale":"de-ch"}}
  ]
}
