{
  "format": "runic.views.scenario/1",
  "id": "handshake.second-hello.v1",
  "contract": {"id":"runic.views","version":4},
  "set": "handshake",
  "roles": ["producer"],
  "description": "A second hello on a connection is rejected with invalid-request.",
  "view": "notes",
  "ids": {
    "c1": {"kind":"connection"},
    "hello-c1": {"kind":"request"},
    "session": {"kind":"wire","value":"s-1"},
    "again": {"kind":"request"},
    "session2": {"kind":"wire","value":"s-2"}
  },
  "arrange": {"model":{}},
  "steps": [
    {"connect":"c1"},
    {
      "send": {
        "kind": "hello",
        "protocol": 4,
        "session": {"$id":"session"},
        "client": {"name":{"$any":"string","default":"conformance-client"},"version":{"$any":"string","default":"1.0.0"}}
      },
      "id": "hello-c1"
    },
    {
      "receive": {
        "ok": true,
        "protocol": 4,
        "implementation": {"name":{"$any":"string","default":"conformance-producer"},"version":{"$any":"string","default":"1.0.0"}}
      },
      "replyTo": "hello-c1"
    },
    {
      "send": {
        "kind": "hello",
        "protocol": 4,
        "session": {"$id":"session2"},
        "client": {"name":"conformance-client","version":"1.0.0"}
      },
      "id": "again"
    },
    {
      "receive": {
        "ok": false,
        "error": {"kind":"rejected","reason":"invalid-request","message":{"$any":"string","default":"…"}},
        "protocol": 4,
        "implementation": {"name":{"$any":"string"},"version":{"$any":"string"}}
      },
      "replyTo": "again"
    }
  ]
}
