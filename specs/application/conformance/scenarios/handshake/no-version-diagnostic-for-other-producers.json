{
  "format": "runic.views.scenario/1",
  "id": "handshake.no-version-diagnostic-for-other-producers.v1",
  "contract": {"id":"runic.views","version":4},
  "set": "handshake",
  "roles": ["client"],
  "description": "Another producer's version is not compared: no diagnostic.",
  "view": "notes",
  "ids": {
    "c1": {"kind":"connection"},
    "hello-c1": {"kind":"request"},
    "session": {"kind":"wire","value":"s-1"},
    "open-notes": {"kind":"call"},
    "open-notes-request": {"kind":"request"},
    "presentation": {"kind":"wire","value":"p-1"}
  },
  "arrange": {"model":{}},
  "steps": [
    {"connect":"c1"},
    {
      "send": {
        "kind": "hello",
        "protocol": 4,
        "session": {"$id":"session"},
        "client": {"name":{"$any":"string"},"version":{"$any":"string"}},
        "features": {"$any":"array","default":["text-splice/1"]}
      },
      "id": "hello-c1"
    },
    {
      "receive": {"ok":true,"protocol":4,"implementation":{"name":"conformance-producer","version":"0.0.0-conformance"}},
      "replyTo": "hello-c1"
    },
    {"call":{"id":"open-notes","op":"open","route":"notes"}},
    {"send":{"kind":"open","route":"notes","presentation":{"$id":"presentation"}},"id":"open-notes-request"},
    {
      "receive": {
        "ok": true,
        "revision": 0,
        "state": {
          "title": "",
          "note": "",
          "priority": "Normal",
          "due": null,
          "elapsed": "PT0S",
          "rows": [],
          "count": 0,
          "summary": "rows: 0",
          "detail": {"kind":"detail","id":"0123456789abcdef0123456789abcdef"},
          "canClear": false,
          "canTouch": true,
          "canSave": true,
          "canConfirmClear": false,
          "isSlowImportExecuting": false,
          "isConfirmClearExecuting": false
        },
        "fields": {"note":{"version":0}},
        "presentation": "ok"
      },
      "replyTo": "open-notes-request"
    },
    {"expect":{"call":{"id":"open-notes","resolved":null}}},
    {"expect":{"diagnostics":[]}}
  ]
}
