{
  "format": "runic.views.scenario/1",
  "id": "handshake.appearance-is-not-pushed-without-the-feature.v1",
  "contract": {"id":"runic.views","version":4},
  "set": "handshake",
  "roles": ["producer"],
  "description": "A connection whose hello does not list appearance/1 receives no appearance push, after its hello or when the appearance changes.",
  "view": "form",
  "requires": ["appearance/1"],
  "ids": {
    "c1": {"kind":"connection"},
    "hello-c1": {"kind":"request"},
    "session": {"kind":"wire","value":"s-1"},
    "snapshot-request": {"kind":"request"}
  },
  "arrange": {"model":{}},
  "steps": [
    {"setAppearance":{"colorScheme":"dark","contrast":"more","reducedMotion":true,"textScale":1.25,"accentColor":"#3584e4","systemColors":null}},
    {"connect":"c1"},
    {"send":{"kind":"hello","protocol":4,"session":{"$id":"session"},"client":{"name":{"$any":"string","default":"conformance-client"},"version":{"$any":"string","default":"1.0.0"}},"features":{"$any":"array","default":["text-splice/1"]}},"id":"hello-c1"},
    {"receive":{"ok":true,"protocol":4,"implementation":{"name":{"$any":"string","default":"conformance-producer"},"version":{"$any":"string","default":"1.0.0"}},"features":{"$any":"array","default":["text-splice/1"]}},"replyTo":"hello-c1"},
    {"setAppearance":{"colorScheme":"dark","contrast":"forced-colors","reducedMotion":false,"textScale":1,"accentColor":"#0078d4","systemColors":{"canvas":"#000000","canvasText":"#ffffff","linkText":"#ffff00","grayText":"#3ff23f","highlight":"#1aebff","highlightText":"#000000","buttonFace":"#000000","buttonText":"#ffffff"}}},
    {"send":{"kind":"snapshot","route":"form"},"id":"snapshot-request"},
    {"receive":{"ok":true,"revision":0,"state":{"name":"","nameErrors":[],"validation":{"hasErrors":false,"truncated":false,"errors":[]}}},"replyTo":"snapshot-request","note":"No appearance push came before the reply."}
  ]
}
