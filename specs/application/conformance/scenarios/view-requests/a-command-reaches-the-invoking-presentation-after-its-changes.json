{
  "format": "runic.views.scenario/1",
  "id": "view-requests.a-command-reaches-the-invoking-presentation-after-its-changes.v1",
  "contract": {
    "id": "runic.views",
    "version": 4
  },
  "set": "view-requests",
  "roles": [
    "producer",
    "client"
  ],
  "description": "touch changes the title without announcing it and raises focus: the page receives the request with the revision of the frame that publishes the title, and its handler runs once the page reached it.",
  "view": "notes",
  "requires": [
    "view-requests/1"
  ],
  "ids": {
    "c1": {
      "kind": "connection"
    },
    "hello-c1": {
      "kind": "request"
    },
    "session": {
      "kind": "wire",
      "value": "s-1"
    },
    "open-notes": {
      "kind": "call"
    },
    "open-request": {
      "kind": "request"
    },
    "presentation": {
      "kind": "wire",
      "value": "p-1"
    },
    "handle-focus": {
      "kind": "call"
    },
    "register": {
      "kind": "request"
    },
    "focusContract": {
      "kind": "provided"
    },
    "touch": {
      "kind": "call"
    },
    "touch-request": {
      "kind": "request"
    }
  },
  "arrange": {
    "model": {}
  },
  "steps": [
    {
      "connect": "c1"
    },
    {
      "send": {
        "kind": "hello",
        "protocol": 4,
        "session": {
          "$id": "session"
        },
        "client": {
          "name": {
            "$any": "string",
            "default": "conformance-client"
          },
          "version": {
            "$any": "string",
            "default": "1.0.0"
          }
        },
        "features": {
          "$any": "array",
          "default": [
            "text-splice/1",
            "view-requests/1"
          ]
        }
      },
      "id": "hello-c1"
    },
    {
      "receive": {
        "ok": true,
        "protocol": 4,
        "implementation": {
          "name": {
            "$any": "string",
            "default": "conformance-producer"
          },
          "version": {
            "$any": "string",
            "default": "1.0.0"
          }
        },
        "features": {
          "$any": "array",
          "default": [
            "text-splice/1",
            "view-requests/1"
          ]
        }
      },
      "replyTo": "hello-c1"
    },
    {
      "call": {
        "id": "open-notes",
        "op": "open",
        "route": "notes"
      }
    },
    {
      "send": {
        "kind": "open",
        "route": "notes",
        "presentation": {
          "$id": "presentation"
        }
      },
      "id": "open-request"
    },
    {
      "receive": {
        "ok": true,
        "revision": 0,
        "state": {
          "title": "",
          "note": "",
          "priority": "Normal",
          "due": null,
          "elapsed": "PT0S",
          "rows": [],
          "count": 0,
          "summary": "rows: 0",
          "detail": {
            "kind": "detail",
            "id": "0123456789abcdef0123456789abcdef"
          },
          "canClear": false,
          "canTouch": true,
          "canSave": true,
          "canConfirmClear": false,
          "isSlowImportExecuting": false,
          "isConfirmClearExecuting": false
        },
        "fields": {
          "note": {
            "version": 0
          }
        },
        "presentation": "ok"
      },
      "replyTo": "open-request"
    },
    {
      "call": {
        "id": "handle-focus",
        "op": "handle",
        "route": "notes",
        "request": "focus"
      }
    },
    {
      "send": {
        "kind": "view-requests",
        "route": "notes",
        "presentation": {
          "$id": "presentation"
        },
        "generation": 1,
        "requests": [
          {
            "name": "focus",
            "contract": {
              "$id": "focusContract"
            }
          }
        ]
      },
      "id": "register"
    },
    {
      "receive": {
        "ok": true,
        "registration": "ok"
      },
      "replyTo": "register"
    },
    {
      "call": {
        "id": "touch",
        "op": "command",
        "route": "notes",
        "member": "touch"
      }
    },
    {
      "send": {
        "kind": "command",
        "route": "notes",
        "member": "touch"
      },
      "id": "touch-request"
    },
    {
      "receive": {
        "kind": "frame",
        "route": "notes",
        "baseRevision": 0,
        "revision": 1,
        "changes": [
          {
            "field": "title",
            "kind": "set",
            "value": "!"
          }
        ]
      },
      "unordered": true
    },
    {
      "receive": {
        "kind": "view-request",
        "route": "notes",
        "presentation": {
          "$id": "presentation"
        },
        "revision": 1,
        "name": "focus",
        "contract": {
          "$id": "focusContract"
        },
        "input": {
          "member": "title"
        }
      },
      "unordered": true
    },
    {
      "receive": {
        "ok": true,
        "revision": 1
      },
      "replyTo": "touch-request",
      "unordered": true
    },
    {
      "expect": {
        "call": {
          "id": "touch",
          "resolved": null
        }
      }
    },
    {
      "expect": {
        "requests": {
          "route": "notes",
          "request": "focus",
          "inputs": [
            {
              "member": "title"
            }
          ]
        }
      }
    }
  ]
}
