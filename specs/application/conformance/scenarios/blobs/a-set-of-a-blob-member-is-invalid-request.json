{
  "format": "runic.views.scenario/1",
  "id": "blobs.a-set-of-a-blob-member-is-invalid-request.v1",
  "contract": {"id":"runic.views","version":4},
  "set": "blobs",
  "roles": ["producer"],
  "requires": ["blobs/1"],
  "description": "A member that holds a blob is never settable by the page: a set of it is rejected with invalid-request, as for any member that is not settable.",
  "view": "files",
  "ids": {
    "c1": {"kind":"connection"},
    "hello-c1": {"kind":"request"},
    "open-files": {"kind":"request"},
    "set-avatar": {"kind":"request"},
