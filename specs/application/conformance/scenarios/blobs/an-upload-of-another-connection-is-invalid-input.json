{
  "format": "runic.views.scenario/1",
  "id": "blobs.an-upload-of-another-connection-is-invalid-input.v1",
  "contract": {"id":"runic.views","version":4},
  "set": "blobs",
  "roles": ["producer"],
  "requires": ["blobs/1"],
  "description": "An upload belongs to the connection that uploaded it: its id in a request of another connection is invalid-input, and the uploading connection can still claim it.",
  "view": "files",
  "ids": {
    "c1": {"kind":"connection"},
    "c2": {"kind":"connection"},
    "hello-c1": {"kind":"request"},
    "hello-c2": {"kind":"request"},
    "open-files": {"kind":"request"},
    "open-files-2": {"kind":"request"},
    "other": {"kind":"request"},
    "own": {"kind":"request"},
    "session": {"kind":"wire","value":"s-1"},
    "session-2": {"kind":"wire","value":"s-2"},
    "presentation": {"kind":"wire","value":"p-1"},
    "presentation-2": {"kind":"wire","value":"p-2"},
    "upload": {"kind":"provided"}
  },
  "arrange": {"model":{}},
  "steps": [
    {"connect":"c1"},
    {"send":{"kind":"hello","protocol":4,"session":{"$id":"session"},"client":{"name":{"$any":"string","default":"conformance-client"},"version":{"$any":"string","default":"1.0.0"}},"features":{"$any":"array","default":["blobs/1"]}},"id":"hello-c1"},
    {"receive":{"ok":true,"protocol":4,"implementation":{"name":{"$any":"string","default":"conformance-producer"},"version":{"$any":"string","default":"1.0.0"}},"features":{"$any":"array","default":["blobs/1"]},"blobs":{"upload":{"$any":"string","default":"http://conformance.test/_runic/upload"},"token":{"$any":"string","default":"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"},"maximumBytes":268435456}},"replyTo":"hello-c1"},
    {"connect":"c2"},
    {"send":{"kind":"hello","protocol":4,"session":{"$id":"session-2"},"client":{"name":{"$any":"string","default":"conformance-client"},"version":{"$any":"string","default":"1.0.0"}},"features":{"$any":"array","default":["blobs/1"]}},"id":"hello-c2","connection":"c2"},
    {"receive":{"ok":true,"protocol":4,"implementation":{"name":{"$any":"string","default":"conformance-producer"},"version":{"$any":"string","default":"1.0.0"}},"features":{"$any":"array","default":["blobs/1"]},"blobs":{"upload":{"$any":"string","default":"http://conformance.test/_runic/upload"},"token":{"$any":"string","default":"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"},"maximumBytes":268435456}},"replyTo":"hello-c2","connection":"c2"},
    {"send":{"kind":"open","route":"files","presentation":{"$id":"presentation"}},"id":"open-files"},
    {"receive":{"ok":true,"revision":0,"state":{"avatar":null,"lastUpload":null},"presentation":"ok"},"replyTo":"open-files"},
    {"send":{"kind":"open","route":"files","presentation":{"$id":"presentation-2"}},"id":"open-files-2","connection":"c2"},
    {"receive":{"ok":true,"revision":0,"state":{"avatar":null,"lastUpload":null},"presentation":"ok"},"replyTo":"open-files-2","connection":"c2"},
    {"upload":{"name":"notes.txt","type":"text/plain","text":"hello"},"answer":{"status":201,"body":{"ok":true,"upload":{"id":{"$id":"upload"},"name":"notes.txt","type":"text/plain","size":5}}}},
    {"send":{"kind":"command","route":"files","member":"attach","input":{"id":{"$id":"upload"},"name":"notes.txt","type":"text/plain","size":5}},"id":"other","connection":"c2"},
    {"receive":{"ok":false,"error":{"kind":"rejected","reason":"invalid-input","message":{"$any":"string"}}},"replyTo":"other","connection":"c2"},
    {"send":{"kind":"command","route":"files","member":"attach","input":{"id":{"$id":"upload"},"name":"notes.txt","type":"text/plain","size":5}},"id":"own"},
    {"receive":{"kind":"frame","route":"files","baseRevision":0,"revision":1,"changes":[{"field":"lastUpload","kind":"set","value":"notes.txt"}]}},
    {"receive":{"kind":"frame","route":"files","baseRevision":0,"revision":1,"changes":[{"field":"lastUpload","kind":"set","value":"notes.txt"}]},"connection":"c2"},
    {"receive":{"ok":true,"revision":1},"replyTo":"own"}
  ]
}
