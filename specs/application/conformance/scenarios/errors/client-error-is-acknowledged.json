{
  "format": "runic.views.scenario/1",
  "id": "errors.client-error-is-acknowledged.v1",
  "contract": {"id":"runic.views","version":4},
  "set": "errors",
  "roles": ["producer"],
  "description": "With client-errors/1, a page's error report is answered ok whatever the producer does with it; a report with only its required members is one too.",
  "view": "notes",
  "requires": ["client-errors/1"],
  "ids": {
    "c1": {"kind":"connection"},
    "hello-c1": {"kind":"request"},
    "session": {"kind":"wire","value":"s-1"},
    "report": {"kind":"request"},
    "bare-report": {"kind":"request"}
  },
  "arrange": {"model":{}},
  "steps": [
    {"connect":"c1"},
    {"send":{"kind":"hello","protocol":4,"session":{"$id":"session"},"client":{"name":{"$any":"string","default":"conformance-client"},"version":{"$any":"string","default":"1.0.0"}},"features":["client-errors/1"]},"id":"hello-c1"},
    {"receive":{"ok":true,"protocol":4,"implementation":{"name":{"$any":"string","default":"conformance-producer"},"version":{"$any":"string","default":"1.0.0"}},"features":{"$any":"array","default":["client-errors/1"]}},"replyTo":"hello-c1"},
    {"send":{"kind":"client-error","source":"error","name":"TypeError","message":"x is not a function","stack":"TypeError: x is not a function\n    at load (main.js:10:5)","url":"https://app.example/index.html","route":"notes","dropped":2},"id":"report"},
    {"receive":{"ok":true},"replyTo":"report"},
    {"send":{"kind":"client-error","source":"unhandled-rejection","message":""},"id":"bare-report"},
    {"receive":{"ok":true},"replyTo":"bare-report"}
  ]
}
