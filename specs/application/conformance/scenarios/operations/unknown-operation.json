{
  "format": "runic.views.scenario/1",
  "id": "operations.unknown-operation.v1",
  "contract": {"id":"runic.views","version":4},
  "set": "operations",
  "roles": ["producer"],
  "description": "The status of an operation the producer does not know is unknown.",
  "view": "notes",
  "ids": {
    "c1": {"kind":"connection"},
    "hello-c1": {"kind":"request"},
    "session": {"kind":"wire","value":"s-1"},
    "status-request": {"kind":"request"},
    "operation": {"kind":"wire","value":"op-1"},
    "contract": {"kind":"provided"}
  },
  "arrange": {"model":{}},
  "steps": [
    {"connect":"c1"},
    {
      "send": {
        "kind": "hello",
        "protocol": 4,
        "session": {"$id":"session"},
        "client": {"name":{"$any":"string","default":"conformance-client"},"version":{"$any":"string","default":"1.0.0"}},
        "features": {"$any":"array","default":["text-splice/1"]}
      },
      "id": "hello-c1"
    },
    {
      "receive": {
        "ok": true,
        "protocol": 4,
        "implementation": {"name":{"$any":"string","default":"conformance-producer"},"version":{"$any":"string","default":"1.0.0"}},
        "features": {"$any":"array","default":["text-splice/1"]}
      },
      "replyTo": "hello-c1"
    },
    {
      "send": {
        "kind": "status",
        "route": "notes",
        "member": "slowImport",
        "operation": {"$id":"operation"},
        "contract": {"$id":"contract"}
      },
      "id": "status-request"
    },
    {"receive":{"ok":true,"status":{"kind":"unknown"}},"replyTo":"status-request"}
  ]
}
