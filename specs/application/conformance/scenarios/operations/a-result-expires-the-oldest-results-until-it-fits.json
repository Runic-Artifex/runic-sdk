{
  "format": "runic.views.scenario/1",
  "id": "operations.a-result-expires-the-oldest-results-until-it-fits.v1",
  "contract": {"id": "runic.views", "version": 4},
  "set": "operations",
  "roles": ["producer"],
  "requires": [],
  "description": "A window retains 256 KiB of results, counted as the UTF-8 bytes of their encoding (README, \"Limits and window close\"). A result that does not fit beside the retained ones expires the oldest terminal operations until it fits, never itself; one larger than the bound on its own is kept without its value, with delivery result-too-large, and expires nothing. A result of exactly 256 KiB fits.",
  "view": "retention",
  "ids": {"c1":{"kind":"connection"},"hello-c1":{"kind":"request"},"session":{"kind":"wire","value":"s-1"},"open-retention":{"kind":"request"},"presentation":{"kind":"wire","value":"p-1"},"contract":{"kind":"provided"},"op-a":{"kind":"wire","value":"op-a"},"start-a":{"kind":"request"},"op-b":{"kind":"wire","value":"op-b"},"start-b":{"kind":"request"},"op-c":{"kind":"wire","value":"op-c"},"start-c":{"kind":"request"},"op-d":{"kind":"wire","value":"op-d"},"start-d":{"kind":"request"},"status-a":{"kind":"request"},"status-b":{"kind":"request"},"status-b-again":{"kind":"request"},"status-b-last":{"kind":"request"},"status-c":{"kind":"request"},"status-d":{"kind":"request"}},
  "arrange": {"model":{}},
  "steps": [
    {"connect":"c1"},
    {"send":{"kind":"hello","protocol":4,"session":{"$id":"session"},"client":{"name":{"$any":"string","default":"conformance-client"},"version":{"$any":"string","default":"1.0.0"}},"features":{"$any":"array","default":["text-splice/1"]}},"id":"hello-c1"},
    {"receive":{"ok":true,"protocol":4,"implementation":{"name":{"$any":"string","default":"conformance-producer"},"version":{"$any":"string","default":"1.0.0"}},"features":{"$any":"array","default":["text-splice/1"]}},"replyTo":"hello-c1"},
    {"send":{"kind":"open","route":"retention","presentation":{"$id":"presentation"}},"id":"open-retention"},
    {"receive":{"ok":true,"revision":0,"state":{"canHold":true},"presentation":"ok"},"replyTo":"open-retention"},
    {"send":{"kind":"start","route":"retention","member":"produce","operation":{"$id":"op-a"},"contract":{"$id":"contract"},"input":200000},"id":"start-a"},
    {"receive":{"ok":true,"revision":0,"admission":"accepted","status":{"kind":"succeeded","revision":0,"result":{"$any":"string"}}},"replyTo":"start-a","note":"200002 bytes of the 262144 the window retains."},
    {"send":{"kind":"start","route":"retention","member":"produce","operation":{"$id":"op-b"},"contract":{"$id":"contract"},"input":100000},"id":"start-b"},
    {"receive":{"ok":true,"revision":0,"admission":"accepted","status":{"kind":"succeeded","revision":0,"result":{"$any":"string"}}},"replyTo":"start-b","note":"100002 more bytes do not fit: op-a, the oldest terminal operation, expires; op-b keeps its result."},
    {"send":{"kind":"status","route":"retention","member":"produce","operation":{"$id":"op-a"},"contract":{"$id":"contract"}},"id":"status-a"},
    {"receive":{"ok":true,"status":{"kind":"expired"}},"replyTo":"status-a"},
    {"send":{"kind":"status","route":"retention","member":"produce","operation":{"$id":"op-b"},"contract":{"$id":"contract"}},"id":"status-b"},
    {"receive":{"ok":true,"status":{"kind":"succeeded","revision":0,"result":{"$any":"string"}}},"replyTo":"status-b"},
    {"send":{"kind":"start","route":"retention","member":"produce","operation":{"$id":"op-c"},"contract":{"$id":"contract"},"input":262143},"id":"start-c"},
    {"receive":{"ok":true,"revision":0,"admission":"accepted","status":{"kind":"succeeded","revision":0,"delivery":{"kind":"result-too-large","message":{"$any":"string"}}}},"replyTo":"start-c","note":"262145 bytes exceed the bound on their own: op-c is kept without its result, and expires nothing."},
    {"send":{"kind":"status","route":"retention","member":"produce","operation":{"$id":"op-b"},"contract":{"$id":"contract"}},"id":"status-b-again"},
    {"receive":{"ok":true,"status":{"kind":"succeeded","revision":0,"result":{"$any":"string"}}},"replyTo":"status-b-again"},
    {"send":{"kind":"start","route":"retention","member":"produce","operation":{"$id":"op-d"},"contract":{"$id":"contract"},"input":262142},"id":"start-d"},
    {"receive":{"ok":true,"revision":0,"admission":"accepted","status":{"kind":"succeeded","revision":0,"result":{"$any":"string"}}},"replyTo":"start-d","note":"Exactly 262144 bytes fit once op-b expired; op-c, which retains no value, stays."},
    {"send":{"kind":"status","route":"retention","member":"produce","operation":{"$id":"op-b"},"contract":{"$id":"contract"}},"id":"status-b-last"},
    {"receive":{"ok":true,"status":{"kind":"expired"}},"replyTo":"status-b-last"},
    {"send":{"kind":"status","route":"retention","member":"produce","operation":{"$id":"op-c"},"contract":{"$id":"contract"}},"id":"status-c"},
    {"receive":{"ok":true,"status":{"kind":"succeeded","revision":0,"delivery":{"kind":"result-too-large","message":{"$any":"string"}}}},"replyTo":"status-c"},
    {"send":{"kind":"status","route":"retention","member":"produce","operation":{"$id":"op-d"},"contract":{"$id":"contract"}},"id":"status-d"},
    {"receive":{"ok":true,"status":{"kind":"succeeded","revision":0,"result":{"$any":"string"}}},"replyTo":"status-d"}
  ]
}
