{
  "format": "runic.views.scenario/1",
  "id": "operations.cancel.v1",
  "contract": {"id":"runic.views","version":4},
  "set": "operations",
  "roles": ["producer","client"],
  "description": "cancel requests cancellation without waiting; the operation ends cancelled, with the revision of its last frame.",
  "view": "notes",
  "ids": {
    "c1": {"kind":"connection"},
    "hello-c1": {"kind":"request"},
    "session": {"kind":"wire","value":"s-1"},
    "open-notes": {"kind":"call"},
    "open-notes-request": {"kind":"request"},
    "presentation": {"kind":"wire","value":"p-1"},
    "start": {"kind":"call"},
    "operation": {"kind":"wire","value":"op-1"},
    "start-request": {"kind":"request"},
    "contract": {"kind":"provided"},
    "cancel": {"kind":"call"},
    "cancel-request": {"kind":"request"},
    "status": {"kind":"call"},
    "status-request": {"kind":"request"}
  },
  "arrange": {"model":{}},
  "steps": [
    {"connect":"c1"},
    {
      "send": {
        "kind": "hello",
        "protocol": 4,
        "session": {"$id":"session"},
        "client": {"name":{"$any":"string","default":"conformance-client"},"version":{"$any":"string","default":"1.0.0"}}
      },
      "id": "hello-c1"
    },
    {
      "receive": {
        "ok": true,
        "protocol": 4,
        "implementation": {"name":{"$any":"string","default":"conformance-producer"},"version":{"$any":"string","default":"1.0.0"}}
      },
      "replyTo": "hello-c1"
    },
    {"call":{"id":"open-notes","op":"open","route":"notes"}},
    {"send":{"kind":"open","route":"notes","presentation":{"$id":"presentation"}},"id":"open-notes-request"},
    {
      "receive": {
        "ok": true,
        "revision": 0,
        "state": {
          "title": "",
          "note": "",
          "priority": "Normal",
          "due": null,
          "elapsed": "PT0S",
          "rows": [],
          "count": 0,
          "summary": "rows: 0",
          "detail": {"kind":"detail","id":"0123456789abcdef0123456789abcdef"},
          "canClear": false,
          "canTouch": true,
          "canSave": true,
          "canConfirmClear": false,
          "isSlowImportExecuting": false,
          "isConfirmClearExecuting": false
        },
        "fields": {"note":{"version":0}},
        "presentation": "ok"
      },
      "replyTo": "open-notes-request"
    },
    {
      "call": {
        "id": "start",
        "op": "start",
        "route": "notes",
        "member": "slowImport",
        "operation": "operation",
        "input": {"source":"a","limit":2}
      }
    },
    {
      "send": {
        "kind": "start",
        "route": "notes",
        "member": "slowImport",
        "operation": {"$id":"operation"},
        "contract": {"$id":"contract"},
        "input": {"source":"a","limit":2}
      },
      "id": "start-request"
    },
    {
      "receive": {
        "kind": "frame",
        "route": "notes",
        "baseRevision": 0,
        "revision": 1,
        "changes": [{"field":"isSlowImportExecuting","kind":"set","value":true}]
      }
    },
    {"receive":{"ok":true,"revision":1,"admission":"accepted","status":{"kind":"running"}},"replyTo":"start-request"},
    {"call":{"id":"cancel","op":"cancel","operation":"operation"}},
    {
      "send": {
        "kind": "cancel",
        "route": "notes",
        "member": "slowImport",
        "operation": {"$id":"operation"},
        "contract": {"$id":"contract"}
      },
      "id": "cancel-request"
    },
    {"receive":{"ok":true,"cancellation":"cancellation-requested"},"replyTo":"cancel-request"},
    {"mutate":[{"op":"finish","member":"slowImport","outcome":"cancelled"}]},
    {
      "receive": {
        "kind": "frame",
        "route": "notes",
        "baseRevision": 1,
        "revision": 2,
        "changes": [{"field":"isSlowImportExecuting","kind":"set","value":false}]
      }
    },
    {"call":{"id":"status","op":"status","operation":"operation"}},
    {
      "send": {
        "kind": "status",
        "route": "notes",
        "member": "slowImport",
        "operation": {"$id":"operation"},
        "contract": {"$id":"contract"}
      },
      "id": "status-request"
    },
    {"receive":{"ok":true,"status":{"kind":"cancelled","revision":2}},"replyTo":"status-request"},
    {"expect":{"operation":{"id":"operation","status":{"kind":"cancelled"}}}}
  ]
}
