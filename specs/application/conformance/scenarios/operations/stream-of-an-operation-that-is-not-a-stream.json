  "arrange": {"model":{}},
  "steps": [
    {"connect":"c1"},
    {"send":{"kind":"hello","protocol":4,"session":{"$id":"session"},"client":{"name":{"$any":"string","default":"conformance-client"},"version":{"$any":"string","default":"1.0.0"}},"features":{"$any":"array","default":["text-splice/1"]}},"id":"hello-c1"},
    {"receive":{"ok":true,"protocol":4,"implementation":{"name":{"$any":"string","default":"conformance-producer"},"version":{"$any":"string","default":"1.0.0"}},"features":{"$any":"array","default":["text-splice/1"]}},"replyTo":"hello-c1"},
    {"send":{"kind":"open","route":"notes","presentation":{"$id":"presentation"}},"id":"open-notes"},
    {"receive":{"ok":true,"revision":0,"state":{"title":"","note":"","priority":"Normal","due":null,"elapsed":"PT0S","rows":[],"count":0,"summary":"rows: 0","detail":{"kind":"detail","id":"0123456789abcdef0123456789abcdef"},"canClear":false,"canTouch":true,"canSave":true,"canConfirmClear":false,"isSlowImportExecuting":false,"isConfirmClearExecuting":false},"fields":{"note":{"version":0}},"presentation":"ok"},"replyTo":"open-notes"},
    {"send":{"kind":"start","route":"notes","member":"slowImport","operation":{"$id":"operation"},"contract":{"$id":"contract"},"input":{"source":"a","limit":2}},"id":"start-request"},
    {"receive":{"kind":"frame","route":"notes","baseRevision":0,"revision":1,"changes":[{"field":"isSlowImportExecuting","kind":"set","value":true}]}},
    {"receive":{"ok":true,"revision":1,"admission":"accepted","status":{"kind":"running"}},"replyTo":"start-request"},
    {"send":{"kind":"stream","route":"notes","member":"slowImport","operation":{"$id":"operation"},"contract":{"$id":"contract"},"cursor":0},"id":"running-page"},
