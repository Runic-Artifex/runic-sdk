{
  "format": "runic.views.scenario/1",
  "id": "presentations.epoch-without-the-feature-commands-are-not-scoped.v1",
  "contract": {"id":"runic.views","version":4},
  "set": "presentations",
  "roles": ["producer","client"],
  "description": "Without presentation-epoch/1, replies and states carry no epoch and scoped commands carry none. An epoch in a command is an unknown member to the producer and the command runs; an epoch in a state is an unknown member to the client. A renewal is still a full state.",
  "view": "wizard",
  "ids": {
    "c1": {"kind":"connection"},
    "hello-c1": {"kind":"request"},
    "session": {"kind":"wire","value":"s-1"},
    "open-wizard": {"kind":"call"},
    "open-wizard-request": {"kind":"request"},
    "presentation": {"kind":"wire","value":"p-1"},
    "next": {"kind":"call"},
    "next-request": {"kind":"request"},
    "next-with-an-epoch-request": {"kind":"request"},
    "back": {"kind":"call"},
    "back-request": {"kind":"request"}
  },
  "arrange": {"model":{}},
  "steps": [
    {"connect":"c1"},
    {"send":{"kind":"hello","protocol":4,"session":{"$id":"session"},"client":{"name":{"$any":"string","default":"conformance-client"},"version":{"$any":"string","default":"1.0.0"}},"features":{"$any":"array","default":["text-splice/1"]}},"id":"hello-c1"},
    {"receive":{"ok":true,"protocol":4,"implementation":{"name":{"$any":"string","default":"conformance-producer"},"version":{"$any":"string","default":"1.0.0"}},"features":{"$any":"array","default":["text-splice/1"]}},"replyTo":"hello-c1"},
    {"call":{"id":"open-wizard","op":"open","route":"wizard"}},
    {"send":{"kind":"open","route":"wizard","presentation":{"$id":"presentation"}},"id":"open-wizard-request"},
    {"receive":{"ok":true,"revision":0,"state":{"page":1,"canNext":true,"canBack":false,"canPing":true},"presentation":"ok"},"replyTo":"open-wizard-request"},
    {"call":{"id":"next","op":"command","route":"wizard","member":"next"}},
    {"send":{"kind":"command","route":"wizard","member":"next"},"id":"next-request","role":"client"},
    {"send":{"kind":"command","route":"wizard","member":"next","epoch":7},"id":"next-with-an-epoch-request","role":"producer","note":"An epoch that is not the route's: ignored without the feature."},
    {"receive":{"kind":"state","route":"wizard","revision":1,"state":{"page":2,"canNext":true,"canBack":true,"canPing":true}}},
    {"receive":{"ok":true,"revision":1},"replyTo":"next-request","role":"client"},
    {"receive":{"ok":true,"revision":1},"replyTo":"next-with-an-epoch-request","role":"producer"},
    {"expect":{"call":{"id":"next","resolved":null}}},
    {"receive":{"kind":"state","route":"wizard","revision":2,"epoch":2,"state":{"page":2,"canNext":true,"canBack":true,"canPing":true}},"role":"client","note":"As in a window where another connection uses the feature."},
    {"call":{"id":"back","op":"command","route":"wizard","member":"back"}},
    {"send":{"kind":"command","route":"wizard","member":"back"},"id":"back-request"},
    {"receive":{"kind":"state","route":"wizard","revision":3,"state":{"page":1,"canNext":true,"canBack":false,"canPing":true}}},
    {"receive":{"ok":true,"revision":3},"replyTo":"back-request"},
    {"expect":{"call":{"id":"back","resolved":null}}},
    {"expect":{"state":{"route":"wizard","value":{"page":1,"canNext":true,"canBack":false,"canPing":true}}}},
    {"expect":{"model":{"page":1}}}
  ]
}
