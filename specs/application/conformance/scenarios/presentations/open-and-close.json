{
  "format": "runic.views.scenario/1",
  "id": "presentations.open-and-close.v1",
  "contract": {"id":"runic.views","version":4},
  "set": "presentations",
  "roles": ["producer","client"],
  "description": "open registers a presentation and returns the full state; close answers ok, also when repeated.",
  "view": "notes",
  "ids": {
    "c1": {"kind":"connection"},
    "hello-c1": {"kind":"request"},
    "session": {"kind":"wire","value":"s-1"},
    "open-notes": {"kind":"call"},
    "open-notes-request": {"kind":"request"},
    "presentation": {"kind":"wire","value":"p-1"},
    "close": {"kind":"call"},
    "close-request": {"kind":"request"},
    "close-again": {"kind":"request"}
  },
  "arrange": {"model":{}},
  "steps": [
    {"connect":"c1"},
    {
      "send": {
        "kind": "hello",
        "protocol": 4,
        "session": {"$id":"session"},
        "client": {"name":{"$any":"string","default":"conformance-client"},"version":{"$any":"string","default":"1.0.0"}}
      },
      "id": "hello-c1"
    },
    {
      "receive": {
        "ok": true,
        "protocol": 4,
        "implementation": {"name":{"$any":"string","default":"conformance-producer"},"version":{"$any":"string","default":"1.0.0"}}
      },
      "replyTo": "hello-c1"
    },
    {"call":{"id":"open-notes","op":"open","route":"notes"}},
    {"send":{"kind":"open","route":"notes","presentation":{"$id":"presentation"}},"id":"open-notes-request"},
    {
      "receive": {
        "ok": true,
        "revision": 0,
        "state": {
          "title": "",
          "note": "",
          "priority": "Normal",
          "due": null,
          "elapsed": "PT0S",
          "rows": [],
          "count": 0,
          "summary": "rows: 0",
          "detail": {"kind":"detail","id":"0123456789abcdef0123456789abcdef"},
          "canClear": false,
          "canTouch": true,
          "canSave": true,
          "canConfirmClear": false,
          "isSlowImportExecuting": false,
          "isConfirmClearExecuting": false
        },
        "fields": {"note":{"version":0}},
        "presentation": "ok"
      },
      "replyTo": "open-notes-request"
    },
    {"call":{"id":"close","op":"close","route":"notes"}},
    {"send":{"kind":"close","route":"notes","presentation":{"$id":"presentation"}},"id":"close-request"},
    {"receive":{"ok":true,"presentation":"ok"},"replyTo":"close-request"},
    {"send":{"kind":"close","route":"notes","presentation":{"$id":"presentation"}},"id":"close-again","role":"producer"},
    {"receive":{"ok":true,"presentation":"ok"},"replyTo":"close-again","role":"producer"}
  ]
}
