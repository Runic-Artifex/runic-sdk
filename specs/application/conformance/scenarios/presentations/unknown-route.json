{
  "format": "runic.views.scenario/1",
  "id": "presentations.unknown-route.v1",
  "contract": {"id":"runic.views","version":4},
  "set": "presentations",
  "roles": ["producer"],
  "description": "A request for a route the producer does not serve answers released.",
  "view": "notes",
  "ids": {
    "c1": {"kind":"connection"},
    "hello-c1": {"kind":"request"},
    "session": {"kind":"wire","value":"s-1"},
    "open-missing": {"kind":"request"},
    "presentation": {"kind":"wire","value":"p-1"}
  },
  "arrange": {"model":{}},
  "steps": [
    {"connect":"c1"},
    {
      "send": {
        "kind": "hello",
        "protocol": 4,
        "session": {"$id":"session"},
        "client": {"name":{"$any":"string","default":"conformance-client"},"version":{"$any":"string","default":"1.0.0"}}
      },
      "id": "hello-c1"
    },
    {
      "receive": {
        "ok": true,
        "protocol": 4,
        "implementation": {"name":{"$any":"string","default":"conformance-producer"},"version":{"$any":"string","default":"1.0.0"}}
      },
      "replyTo": "hello-c1"
    },
    {
      "send": {"kind":"open","route":"content00000000000000000000000000000000","presentation":{"$id":"presentation"}},
      "id": "open-missing"
    },
    {"receive":{"ok":false,"error":{"kind":"released","message":{"$any":"string"}}},"replyTo":"open-missing"}
  ]
}
