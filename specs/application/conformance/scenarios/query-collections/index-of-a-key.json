{
  "format": "runic.views.scenario/1",
  "id": "query-collections.index-of-a-key.v1",
  "contract": {
    "id": "runic.views",
    "version": 4
  },
  "set": "query-collections",
  "roles": [
    "producer",
    "client"
  ],
  "description": "query-index answers the position of a key in the current query's order, or -1 when no row of the query has it, so a page can scroll a row into view.",
  "view": "catalog",
  "requires": [
    "query-collections/1"
  ],
  "ids": {
    "c1": {
      "kind": "connection"
    },
    "hello-c1": {
      "kind": "request"
    },
    "session": {
      "kind": "wire",
      "value": "s-1"
    },
    "open-catalog": {
      "kind": "call"
    },
    "open-catalog-request": {
      "kind": "request"
    },
    "presentation": {
      "kind": "wire",
      "value": "p-1"
    },
    "even": {
      "kind": "call"
    },
    "even-request": {
      "kind": "request"
    },
    "find": {
      "kind": "call"
    },
    "find-request": {
      "kind": "request"
    },
    "missing": {
      "kind": "call"
    },
    "missing-request": {
      "kind": "request"
    }
  },
  "arrange": {
    "model": {
      "rows": [
        {
          "$rows": [
            1,
            5
          ]
        }
      ]
    }
  },
  "steps": [
    {
      "connect": "c1"
    },
    {
      "send": {
        "kind": "hello",
        "protocol": 4,
        "session": {
          "$id": "session"
        },
        "client": {
          "name": {
            "$any": "string",
            "default": "conformance-client"
          },
          "version": {
            "$any": "string",
            "default": "1.0.0"
          }
        },
        "features": {
          "$any": "array",
          "default": [
            "text-splice/1",
            "query-collections/1"
          ]
        }
      },
      "id": "hello-c1"
    },
    {
      "receive": {
        "ok": true,
        "protocol": 4,
        "implementation": {
          "name": {
            "$any": "string",
            "default": "conformance-producer"
          },
          "version": {
            "$any": "string",
            "default": "1.0.0"
          }
        },
        "features": {
          "$any": "array",
          "default": [
            "text-splice/1",
            "query-collections/1"
          ]
        }
      },
      "replyTo": "hello-c1"
    },
    {
      "call": {
        "id": "open-catalog",
        "op": "open",
        "route": "catalog"
      }
    },
    {
      "send": {
        "kind": "open",
        "route": "catalog",
        "presentation": {
          "$id": "presentation"
        }
      },
      "id": "open-catalog-request"
    },
    {
      "receive": {
        "ok": true,
        "revision": 0,
        "state": {
          "rows": {
            "query": {
              "sort": [],
              "filters": []
            },
            "total": 5,
            "version": 0
          }
        },
        "presentation": "ok"
      },
      "replyTo": "open-catalog-request"
    },
    {
      "expect": {
        "call": {
          "id": "open-catalog",
          "resolved": null
        }
      }
    },
    {
      "call": {
        "id": "even",
        "op": "setQuery",
        "route": "catalog",
        "member": "rows",
        "value": {
          "filters": [
            {
              "field": "even",
              "op": "custom"
            }
          ]
        }
      }
    },
    {
      "send": {
        "kind": "query-set",
        "route": "catalog",
        "member": "rows",
        "query": {
          "sort": [],
          "filters": [
            {
              "field": "even",
              "op": "custom"
            }
          ]
        }
      },
      "id": "even-request"
    },
    {
      "receive": {
        "kind": "frame",
        "route": "catalog",
        "baseRevision": 0,
        "revision": 1,
        "changes": [
          {
            "field": "rows",
            "kind": "set",
            "value": {
              "query": {
                "sort": [],
                "filters": [
                  {
                    "field": "even",
                    "op": "custom"
                  }
                ]
              },
              "total": 5,
              "version": 1
            }
          }
        ]
      }
    },
    {
      "receive": {
        "kind": "frame",
        "route": "catalog",
        "baseRevision": 1,
        "revision": 2,
        "changes": [
          {
            "field": "rows",
            "kind": "set",
            "value": {
              "query": {
                "sort": [],
                "filters": [
                  {
                    "field": "even",
                    "op": "custom"
                  }
                ]
              },
              "total": 2,
              "version": 1
            }
          }
        ]
      },
      "unordered": true
    },
    {
      "receive": {
        "ok": true,
        "revision": 1
      },
      "replyTo": "even-request",
      "unordered": true
    },
    {
      "expect": {
        "call": {
          "id": "even",
          "resolved": null
        }
      }
    },
    {
      "call": {
        "id": "find",
        "op": "indexOf",
        "route": "catalog",
        "member": "rows",
        "value": "4"
      }
    },
    {
      "send": {
        "kind": "query-index",
        "route": "catalog",
        "member": "rows",
        "key": "4"
      },
      "id": "find-request"
    },
    {
      "receive": {
        "ok": true,
        "version": 1,
        "index": 1
      },
      "replyTo": "find-request"
    },
    {
      "expect": {
        "call": {
          "id": "find",
          "resolved": 1
        }
      }
    },
    {
      "call": {
        "id": "missing",
        "op": "indexOf",
        "route": "catalog",
        "member": "rows",
        "value": "3"
      }
    },
    {
      "send": {
        "kind": "query-index",
        "route": "catalog",
        "member": "rows",
        "key": "3"
      },
      "id": "missing-request"
    },
    {
      "receive": {
        "ok": true,
        "version": 1,
        "index": -1
      },
      "replyTo": "missing-request"
    },
    {
      "expect": {
        "call": {
          "id": "missing",
          "resolved": null
        }
      }
    },
    {
      "expect": {
        "state": {
          "route": "catalog",
          "value": {
            "rows": {
              "query": {
                "sort": [],
                "filters": [
                  {
                    "field": "even",
                    "op": "custom"
                  }
                ]
              },
              "total": 2,
              "version": 1
            }
          }
        }
      }
    },
    {
      "expect": {
        "diagnostics": []
      }
    }
  ]
}
