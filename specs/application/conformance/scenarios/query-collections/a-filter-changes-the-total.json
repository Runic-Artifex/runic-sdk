{
  "format": "runic.views.scenario/1",
  "id": "query-collections.a-filter-changes-the-total.v1",
  "contract": {
    "id": "runic.views",
    "version": 4
  },
  "set": "query-collections",
  "roles": [
    "producer",
    "client"
  ],
  "description": "After a query change the total is unknown (null): it belonged to the old query. A range of the new query counts it, and the reply and a frame carry the new total. The client asks for no position past it.",
  "view": "catalog",
  "requires": [
    "query-collections/1"
  ],
  "ids": {
    "c1": {
      "kind": "connection"
    },
    "hello-c1": {
      "kind": "request"
    },
    "session": {
      "kind": "wire",
      "value": "s-1"
    },
    "open-catalog": {
      "kind": "call"
    },
    "open-catalog-request": {
      "kind": "request"
    },
    "presentation": {
      "kind": "wire",
      "value": "p-1"
    },
    "even": {
      "kind": "call"
    },
    "even-request": {
      "kind": "request"
    },
    "range": {
      "kind": "call"
    },
    "rows-request": {
      "kind": "request"
    }
  },
  "arrange": {
    "model": {
      "rows": [
        {
          "$rows": [
            1,
            5
          ]
        }
      ]
    }
  },
  "steps": [
    {
      "connect": "c1"
    },
    {
      "send": {
        "kind": "hello",
        "protocol": 4,
        "session": {
          "$id": "session"
        },
        "client": {
          "name": {
            "$any": "string",
            "default": "conformance-client"
          },
          "version": {
            "$any": "string",
            "default": "1.0.0"
          }
        },
        "features": {
          "$any": "array",
          "default": [
            "text-splice/1",
            "query-collections/1"
          ]
        }
      },
      "id": "hello-c1"
    },
    {
      "receive": {
        "ok": true,
        "protocol": 4,
        "implementation": {
          "name": {
            "$any": "string",
            "default": "conformance-producer"
          },
          "version": {
            "$any": "string",
            "default": "1.0.0"
          }
        },
        "features": {
          "$any": "array",
          "default": [
            "text-splice/1",
            "query-collections/1"
          ]
        }
      },
      "replyTo": "hello-c1"
    },
    {
      "call": {
        "id": "open-catalog",
        "op": "open",
        "route": "catalog"
      }
    },
    {
      "send": {
        "kind": "open",
        "route": "catalog",
        "presentation": {
          "$id": "presentation"
        }
      },
      "id": "open-catalog-request"
    },
    {
      "receive": {
        "ok": true,
        "revision": 0,
        "state": {
          "rows": {
            "query": {
              "sort": [],
              "filters": []
            },
            "total": 5,
            "version": 0
          }
        },
        "presentation": "ok"
      },
      "replyTo": "open-catalog-request"
    },
    {
      "expect": {
        "call": {
          "id": "open-catalog",
          "resolved": null
        }
      }
    },
    {
      "call": {
        "id": "even",
        "op": "setQuery",
        "route": "catalog",
        "member": "rows",
        "value": {
          "filters": [
            {
              "field": "even",
              "op": "custom"
            }
          ]
        }
      }
    },
    {
      "send": {
        "kind": "query-set",
        "route": "catalog",
        "member": "rows",
        "query": {
          "sort": [],
          "filters": [
            {
              "field": "even",
              "op": "custom"
            }
          ]
        }
      },
      "id": "even-request"
    },
    {
      "receive": {
        "kind": "frame",
        "route": "catalog",
        "baseRevision": 0,
        "revision": 1,
        "changes": [
          {
            "field": "rows",
            "kind": "set",
            "value": {
              "query": {
                "sort": [],
                "filters": [
                  {
                    "field": "even",
                    "op": "custom"
                  }
                ]
              },
              "total": null,
              "version": 1
            }
          }
        ]
      }
    },
    {
      "receive": {
        "ok": true,
        "revision": 1
      },
      "replyTo": "even-request"
    },
    {
      "expect": {
        "call": {
          "id": "even",
          "resolved": null
        }
      }
    },
    {
      "call": {
        "id": "range",
        "op": "queryRange",
        "route": "catalog",
        "member": "rows",
        "start": 0,
        "count": 5
      }
    },
    {
      "send": {
        "kind": "query-rows",
        "route": "catalog",
        "member": "rows",
        "start": 0,
        "count": 5
      },
      "id": "rows-request"
    },
    {
      "receive": {
        "ok": true,
        "version": 1,
        "total": 2,
        "start": 0,
        "keys": [
          "2",
          "4"
        ],
        "rows": [
          {
            "id": 2,
            "label": "row 2"
          },
          {
            "id": 4,
            "label": "row 4"
          }
        ]
      },
      "replyTo": "rows-request",
      "unordered": true
    },
    {
      "receive": {
        "kind": "frame",
        "route": "catalog",
        "baseRevision": 1,
        "revision": 2,
        "changes": [
          {
            "field": "rows",
            "kind": "set",
            "value": {
              "query": {
                "sort": [],
                "filters": [
                  {
                    "field": "even",
                    "op": "custom"
                  }
                ]
              },
              "total": 2,
              "version": 1
            }
          }
        ]
      },
      "unordered": true
    },
    {
      "expect": {
        "call": {
          "id": "range",
          "resolved": [
            "2",
            "4"
          ]
        }
      }
    },
    {
      "expect": {
        "state": {
          "route": "catalog",
          "value": {
            "rows": {
              "query": {
                "sort": [],
                "filters": [
                  {
                    "field": "even",
                    "op": "custom"
                  }
                ]
              },
              "total": 2,
              "version": 1
            }
          }
        }
      }
    },
    {
      "expect": {
        "diagnostics": []
      }
    }
  ]
}
