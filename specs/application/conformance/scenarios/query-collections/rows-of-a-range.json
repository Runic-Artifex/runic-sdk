{
  "format": "runic.views.scenario/1",
  "id": "query-collections.rows-of-a-range.v1",
  "contract": {
    "id": "runic.views",
    "version": 4
  },
  "set": "query-collections",
  "roles": [
    "producer",
    "client"
  ],
  "description": "The state carries the query, the total and the version, not the rows. A presentation reads the rows of its range with query-rows, and only that connection receives them.",
  "view": "catalog",
  "requires": [
    "query-collections/1"
  ],
  "ids": {
    "c1": {
      "kind": "connection"
    },
    "hello-c1": {
      "kind": "request"
    },
    "session": {
      "kind": "wire",
      "value": "s-1"
    },
    "open-catalog": {
      "kind": "call"
    },
    "open-catalog-request": {
      "kind": "request"
    },
    "presentation": {
      "kind": "wire",
      "value": "p-1"
    },
    "range": {
      "kind": "call"
    },
    "rows-request": {
      "kind": "request"
    }
  },
  "arrange": {
    "model": {
      "rows": [
        {
          "$rows": [
            1,
            5
          ]
        }
      ]
    }
  },
  "steps": [
    {
      "connect": "c1"
    },
    {
      "send": {
        "kind": "hello",
        "protocol": 4,
        "session": {
          "$id": "session"
        },
        "client": {
          "name": {
            "$any": "string",
            "default": "conformance-client"
          },
          "version": {
            "$any": "string",
            "default": "1.0.0"
          }
        },
        "features": {
          "$any": "array",
          "default": [
            "text-splice/1",
            "query-collections/1"
          ]
        }
      },
      "id": "hello-c1"
    },
    {
      "receive": {
        "ok": true,
        "protocol": 4,
        "implementation": {
          "name": {
            "$any": "string",
            "default": "conformance-producer"
          },
          "version": {
            "$any": "string",
            "default": "1.0.0"
          }
        },
        "features": {
          "$any": "array",
          "default": [
            "text-splice/1",
            "query-collections/1"
          ]
        }
      },
      "replyTo": "hello-c1"
    },
    {
      "call": {
        "id": "open-catalog",
        "op": "open",
        "route": "catalog"
      }
    },
    {
      "send": {
        "kind": "open",
        "route": "catalog",
        "presentation": {
          "$id": "presentation"
        }
      },
      "id": "open-catalog-request"
    },
    {
      "receive": {
        "ok": true,
        "revision": 0,
        "state": {
          "rows": {
            "query": {
              "sort": [],
              "filters": []
            },
            "total": 5,
            "version": 0
          }
        },
        "presentation": "ok"
      },
      "replyTo": "open-catalog-request"
    },
    {
      "expect": {
        "call": {
          "id": "open-catalog",
          "resolved": null
        }
      }
    },
    {
      "call": {
        "id": "range",
        "op": "queryRange",
        "route": "catalog",
        "member": "rows",
        "start": 1,
        "count": 3
      }
    },
    {
      "send": {
        "kind": "query-rows",
        "route": "catalog",
        "member": "rows",
        "start": 1,
        "count": 3
      },
      "id": "rows-request"
    },
    {
      "expect": {
        "call": {
          "id": "range",
          "pending": true
        }
      }
    },
    {
      "receive": {
        "ok": true,
        "version": 0,
        "total": 5,
        "start": 1,
        "keys": [
          "2",
          "3",
          "4"
        ],
        "rows": [
          {
            "id": 2,
            "label": "row 2"
          },
          {
            "id": 3,
            "label": "row 3"
          },
          {
            "id": 4,
            "label": "row 4"
          }
        ]
      },
      "replyTo": "rows-request"
    },
    {
      "expect": {
        "call": {
          "id": "range",
          "resolved": [
            "2",
            "3",
            "4"
          ]
        }
      }
    },
    {
      "expect": {
        "state": {
          "route": "catalog",
          "value": {
            "rows": {
              "query": {
                "sort": [],
                "filters": []
              },
              "total": 5,
              "version": 0
            }
          }
        }
      }
    },
    {
      "expect": {
        "diagnostics": []
      }
    }
  ]
}
