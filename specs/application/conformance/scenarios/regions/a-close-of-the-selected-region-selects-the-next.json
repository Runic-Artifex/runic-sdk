{
  "format": "runic.views.scenario/1",
  "id": "regions.a-close-of-the-selected-region-selects-the-next.v1",
  "contract": {"id":"runic.views","version":4},
  "set": "regions",
  "roles": ["producer","client"],
  "description": "A close of the selected first region removes it, and the next region, now at the same index, becomes selected. A close of the selected last region selects the previous one.",
  "view": "tabs",
  "requires": ["region-collections/1"],
  "ids": {
    "c1": {"kind":"connection"},
    "hello-c1": {"kind":"request"},
    "session": {"kind":"wire","value":"s-1"},
    "open-tabs": {"kind":"call"},
    "open-tabs-request": {"kind":"request"},
    "presentation": {"kind":"wire","value":"p-1"},
    "close-first": {"kind":"call"},
    "close-first-request": {"kind":"request"},
    "select-last": {"kind":"call"},
    "select-last-request": {"kind":"request"},
    "close-last": {"kind":"call"},
    "close-last-request": {"kind":"request"}
  },
  "arrange": {"model":{}},
  "steps": [
    {"connect":"c1"},
    {"send":{"kind":"hello","protocol":4,"session":{"$id":"session"},"client":{"name":{"$any":"string","default":"conformance-client"},"version":{"$any":"string","default":"1.0.0"}},"features":{"$any":"array","default":["text-splice/1","region-collections/1"]}},"id":"hello-c1"},
    {"receive":{"ok":true,"protocol":4,"implementation":{"name":{"$any":"string","default":"conformance-producer"},"version":{"$any":"string","default":"1.0.0"}},"features":{"$any":"array","default":["text-splice/1","region-collections/1"]}},"replyTo":"hello-c1"},
    {"call":{"id":"open-tabs","op":"open","route":"tabs"}},
    {"send":{"kind":"open","route":"tabs","presentation":{"$id":"presentation"}},"id":"open-tabs-request"},
    {"receive":{"ok":true,"revision":0,"state":{"documents":{"regions":[{"key":"1","content":{"kind":"page","id":"00000000000000000000000000000001"}},{"key":"2","content":{"kind":"page","id":"00000000000000000000000000000002"}},{"key":"3","content":{"kind":"page","id":"00000000000000000000000000000003"}}],"selected":0},"pinned":{"regions":[],"selected":null}},"presentation":"ok"},"replyTo":"open-tabs-request"},
    {"call":{"id":"close-first","op":"region","route":"tabs","member":"documents","action":"close","key":"1"}},
    {"send":{"kind":"region","route":"tabs","member":"documents","action":"close","key":"1"},"id":"close-first-request"},
    {"receive":{"kind":"frame","route":"tabs","baseRevision":0,"revision":1,"changes":[{"field":"documents","kind":"set","value":{"regions":[{"key":"2","content":{"kind":"page","id":"00000000000000000000000000000002"}},{"key":"3","content":{"kind":"page","id":"00000000000000000000000000000003"}}],"selected":0}}]}},
    {"receive":{"ok":true,"revision":1,"outcome":{"kind":"Committed","rejection":null,"arrival":"None"}},"replyTo":"close-first-request"},
    {"expect":{"call":{"id":"close-first","resolved":{"kind":"Committed","rejection":null,"arrival":"None"}}}},
    {"expect":{"state":{"route":"tabs","value":{"documents":{"regions":[{"key":"2","content":{"kind":"page","id":"00000000000000000000000000000002"}},{"key":"3","content":{"kind":"page","id":"00000000000000000000000000000003"}}],"selected":0},"pinned":{"regions":[],"selected":null}}}}},
    {"call":{"id":"select-last","op":"region","route":"tabs","member":"documents","action":"select","key":"3"}},
    {"send":{"kind":"region","route":"tabs","member":"documents","action":"select","key":"3"},"id":"select-last-request"},
    {"receive":{"kind":"frame","route":"tabs","baseRevision":1,"revision":2,"changes":[{"field":"documents","kind":"set","value":{"regions":[{"key":"2","content":{"kind":"page","id":"00000000000000000000000000000002"}},{"key":"3","content":{"kind":"page","id":"00000000000000000000000000000003"}}],"selected":1}}]}},
    {"receive":{"ok":true,"revision":2,"outcome":{"kind":"Committed","rejection":null,"arrival":"None"}},"replyTo":"select-last-request"},
    {"call":{"id":"close-last","op":"region","route":"tabs","member":"documents","action":"close","key":"3"}},
    {"send":{"kind":"region","route":"tabs","member":"documents","action":"close","key":"3"},"id":"close-last-request"},
    {"receive":{"kind":"frame","route":"tabs","baseRevision":2,"revision":3,"changes":[{"field":"documents","kind":"set","value":{"regions":[{"key":"2","content":{"kind":"page","id":"00000000000000000000000000000002"}}],"selected":0}}]}},
    {"receive":{"ok":true,"revision":3,"outcome":{"kind":"Committed","rejection":null,"arrival":"None"}},"replyTo":"close-last-request"},
    {"expect":{"call":{"id":"close-last","resolved":{"kind":"Committed","rejection":null,"arrival":"None"}}}},
    {"expect":{"state":{"route":"tabs","value":{"documents":{"regions":[{"key":"2","content":{"kind":"page","id":"00000000000000000000000000000002"}}],"selected":0},"pinned":{"regions":[],"selected":null}}}}},
    {"expect":{"diagnostics":[]}}
  ]
}
