{
  "format": "runic.views.scenario/1",
  "id": "regions.the-key-of-a-closed-region-is-unresolved.v1",
  "contract": {"id":"runic.views","version":4},
  "set": "regions",
  "roles": ["producer","client"],
  "description": "A close of a region that is not selected keeps the selected region. Its key then names no region: a select or close with it is rejected with unresolved-key, runs nothing and publishes nothing.",
  "view": "tabs",
  "requires": ["region-collections/1"],
  "ids": {
    "c1": {"kind":"connection"},
    "hello-c1": {"kind":"request"},
    "session": {"kind":"wire","value":"s-1"},
    "open-tabs": {"kind":"call"},
    "open-tabs-request": {"kind":"request"},
    "presentation": {"kind":"wire","value":"p-1"},
    "close": {"kind":"call"},
    "close-request": {"kind":"request"},
    "select": {"kind":"call"},
    "select-request": {"kind":"request"},
    "close-again": {"kind":"call"},
    "close-again-request": {"kind":"request"}
  },
  "arrange": {"model":{}},
  "steps": [
    {"connect":"c1"},
    {"send":{"kind":"hello","protocol":4,"session":{"$id":"session"},"client":{"name":{"$any":"string","default":"conformance-client"},"version":{"$any":"string","default":"1.0.0"}},"features":{"$any":"array","default":["text-splice/1","region-collections/1"]}},"id":"hello-c1"},
    {"receive":{"ok":true,"protocol":4,"implementation":{"name":{"$any":"string","default":"conformance-producer"},"version":{"$any":"string","default":"1.0.0"}},"features":{"$any":"array","default":["text-splice/1","region-collections/1"]}},"replyTo":"hello-c1"},
    {"call":{"id":"open-tabs","op":"open","route":"tabs"}},
    {"send":{"kind":"open","route":"tabs","presentation":{"$id":"presentation"}},"id":"open-tabs-request"},
    {"receive":{"ok":true,"revision":0,"state":{"documents":{"regions":[{"key":"1","content":{"kind":"page","id":"00000000000000000000000000000001"}},{"key":"2","content":{"kind":"page","id":"00000000000000000000000000000002"}},{"key":"3","content":{"kind":"page","id":"00000000000000000000000000000003"}}],"selected":0},"pinned":{"regions":[],"selected":null}},"presentation":"ok"},"replyTo":"open-tabs-request"},
    {"call":{"id":"close","op":"region","route":"tabs","member":"documents","action":"close","key":"3"}},
    {"send":{"kind":"region","route":"tabs","member":"documents","action":"close","key":"3"},"id":"close-request"},
    {"receive":{"kind":"frame","route":"tabs","baseRevision":0,"revision":1,"changes":[{"field":"documents","kind":"set","value":{"regions":[{"key":"1","content":{"kind":"page","id":"00000000000000000000000000000001"}},{"key":"2","content":{"kind":"page","id":"00000000000000000000000000000002"}}],"selected":0}}]}},
    {"receive":{"ok":true,"revision":1,"outcome":{"kind":"Committed","rejection":null,"arrival":"None"}},"replyTo":"close-request"},
    {"expect":{"call":{"id":"close","resolved":{"kind":"Committed","rejection":null,"arrival":"None"}}}},
    {"call":{"id":"select","op":"region","route":"tabs","member":"documents","action":"select","key":"3"}},
    {"send":{"kind":"region","route":"tabs","member":"documents","action":"select","key":"3"},"id":"select-request"},
    {"receive":{"ok":false,"error":{"kind":"rejected","reason":"unresolved-key","message":{"$any":"string","default":"…"}}},"replyTo":"select-request"},
    {"expect":{"call":{"id":"select","rejected":{"kind":"rejected","reason":"unresolved-key"}}}},
    {"call":{"id":"close-again","op":"region","route":"tabs","member":"documents","action":"close","key":"3"}},
    {"send":{"kind":"region","route":"tabs","member":"documents","action":"close","key":"3"},"id":"close-again-request"},
    {"receive":{"ok":false,"error":{"kind":"rejected","reason":"unresolved-key","message":{"$any":"string","default":"…"}}},"replyTo":"close-again-request"},
    {"expect":{"call":{"id":"close-again","rejected":{"kind":"rejected","reason":"unresolved-key"}}}},
    {"expect":{"state":{"route":"tabs","value":{"documents":{"regions":[{"key":"1","content":{"kind":"page","id":"00000000000000000000000000000001"}},{"key":"2","content":{"kind":"page","id":"00000000000000000000000000000002"}}],"selected":0},"pinned":{"regions":[],"selected":null}}}}},
    {"expect":{"diagnostics":["rejected","rejected"]}}
  ]
}
