{
  "format": "runic.views.scenario/1",
  "id": "interactions.confirm-answered.v1",
  "contract": {"id":"runic.views","version":4},
  "set": "interactions",
  "roles": ["producer","client"],
  "description": "A command asks the presentation's confirm handler; the answer is accepted once and a repeat of it is already-completed.",
  "view": "notes",
  "ids": {
    "c1": {"kind":"connection"},
    "hello-c1": {"kind":"request"},
    "session": {"kind":"wire","value":"s-1"},
    "handler": {"kind":"call"},
    "open-notes": {"kind":"call"},
    "open-notes-request": {"kind":"request"},
    "presentation": {"kind":"wire","value":"p-1"},
    "confirmContract": {"kind":"provided"},
    "confirm-clear": {"kind":"call"},
    "command-request": {"kind":"request"},
    "interactionRequest": {"kind":"provided"},
    "ownerEpoch": {"kind":"provided"},
    "answer": {"kind":"request"},
    "repeat": {"kind":"request"}
  },
  "arrange": {"model":{"rows":[{"id":1,"label":"one"}]}},
  "steps": [
    {"connect":"c1"},
    {
      "send": {
        "kind": "hello",
        "protocol": 4,
        "session": {"$id":"session"},
        "client": {"name":{"$any":"string","default":"conformance-client"},"version":{"$any":"string","default":"1.0.0"}}
      },
      "id": "hello-c1"
    },
    {
      "receive": {
        "ok": true,
        "protocol": 4,
        "implementation": {"name":{"$any":"string","default":"conformance-producer"},"version":{"$any":"string","default":"1.0.0"}}
      },
      "replyTo": "hello-c1"
    },
    {
      "call": {"id":"handler","op":"register","route":"notes","interaction":"confirm","answer":{"output":{"accepted":true}}}
    },
    {"call":{"id":"open-notes","op":"open","route":"notes"}},
    {
      "send": {
        "kind": "open",
        "route": "notes",
        "presentation": {"$id":"presentation"},
        "handlers": [{"name":"confirm","contract":{"$id":"confirmContract"}}]
      },
      "id": "open-notes-request"
    },
    {
      "receive": {
        "ok": true,
        "revision": 0,
        "state": {
          "title": "",
          "note": "",
          "priority": "Normal",
          "due": null,
          "elapsed": "PT0S",
          "rows": [{"id":1,"label":"one"}],
          "count": 1,
          "summary": "rows: 1",
          "detail": {"kind":"detail","id":"0123456789abcdef0123456789abcdef"},
          "canClear": true,
          "canTouch": true,
          "canSave": true,
          "canConfirmClear": true,
          "isSlowImportExecuting": false,
          "isConfirmClearExecuting": false
        },
        "fields": {"note":{"version":0}},
        "presentation": "ok",
        "registration": "ok"
      },
      "replyTo": "open-notes-request"
    },
    {"call":{"id":"confirm-clear","op":"command","route":"notes","member":"confirmClear"}},
    {"send":{"kind":"command","route":"notes","member":"confirmClear"},"id":"command-request"},
    {
      "receive": {
        "kind": "frame",
        "route": "notes",
        "baseRevision": 0,
        "revision": 1,
        "changes": [
          {"field":"isConfirmClearExecuting","kind":"set","value":true},
          {"field":"canConfirmClear","kind":"set","value":false}
        ]
      }
    },
    {
      "receive": {
        "kind": "interaction",
        "route": "notes",
        "presentation": {"$id":"presentation"},
        "requestId": {"$id":"interactionRequest"},
        "ownerEpoch": {"$id":"ownerEpoch"},
        "name": "confirm",
        "contract": {"$id":"confirmContract"},
        "expiresAt": {"$any":"string","default":"2026-10-28T12:02:00Z"},
        "input": {"question":"Clear all rows?"}
      }
    },
    {
      "send": {
        "kind": "interaction-reply",
        "route": "notes",
        "presentation": {"$id":"presentation"},
        "requestId": {"$id":"interactionRequest"},
        "ownerEpoch": {"$id":"ownerEpoch"},
        "name": "confirm",
        "contract": {"$id":"confirmContract"},
        "outcome": "answered",
        "output": {"accepted":true}
      },
      "id": "answer"
    },
    {"receive":{"ok":true,"result":"ok"},"replyTo":"answer"},
    {
      "receive": {
        "kind": "frame",
        "route": "notes",
        "baseRevision": 1,
        "revision": 2,
        "changes": [
          {"field":"rows","kind":"set","value":[]},
          {"field":"count","kind":"set","value":0},
          {"field":"summary","kind":"set","value":"rows: 0"},
          {"field":"canClear","kind":"set","value":false},
          {"field":"isConfirmClearExecuting","kind":"set","value":false}
        ]
      }
    },
    {"receive":{"ok":true,"revision":2},"replyTo":"command-request"},
    {"expect":{"call":{"id":"confirm-clear","resolved":null}}},
    {
      "send": {
        "kind": "interaction-reply",
        "route": "notes",
        "presentation": {"$id":"presentation"},
        "requestId": {"$id":"interactionRequest"},
        "ownerEpoch": {"$id":"ownerEpoch"},
        "name": "confirm",
        "contract": {"$id":"confirmContract"},
        "outcome": "answered",
        "output": {"accepted":true}
      },
      "id": "repeat",
      "role": "producer"
    },
    {"receive":{"ok":true,"result":"already-completed"},"replyTo":"repeat","role":"producer"}
  ]
}
