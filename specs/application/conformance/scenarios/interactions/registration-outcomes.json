{
  "format": "runic.views.scenario/1",
  "id": "interactions.registration-outcomes.v1",
  "contract": {"id":"runic.views","version":4},
  "set": "interactions",
  "roles": ["producer"],
  "description": "Registration answers unsupported for an unknown handler, ok for a higher generation and stale for a lower one.",
  "view": "notes",
  "ids": {
    "c1": {"kind":"connection"},
    "hello-c1": {"kind":"request"},
    "session": {"kind":"wire","value":"s-1"},
    "open-notes-request": {"kind":"request"},
    "presentation": {"kind":"wire","value":"p-1"},
    "unknown": {"kind":"request"},
    "register": {"kind":"request"},
    "confirmContract": {"kind":"provided"},
    "older": {"kind":"request"},
    "not-open": {"kind":"request"},
    "presentation2": {"kind":"wire","value":"p-2"}
  },
  "arrange": {"model":{}},
  "steps": [
    {"connect":"c1"},
    {
      "send": {
        "kind": "hello",
        "protocol": 4,
        "session": {"$id":"session"},
        "client": {"name":{"$any":"string","default":"conformance-client"},"version":{"$any":"string","default":"1.0.0"}},
        "features": {"$any":"array","default":["text-splice/1"]}
      },
      "id": "hello-c1"
    },
    {
      "receive": {
        "ok": true,
        "protocol": 4,
        "implementation": {"name":{"$any":"string","default":"conformance-producer"},"version":{"$any":"string","default":"1.0.0"}},
        "features": {"$any":"array","default":["text-splice/1"]}
      },
      "replyTo": "hello-c1"
    },
    {"send":{"kind":"open","route":"notes","presentation":{"$id":"presentation"}},"id":"open-notes-request"},
    {
      "receive": {
        "ok": true,
        "revision": 0,
        "state": {
          "title": "",
          "note": "",
          "priority": "Normal",
          "due": null,
          "elapsed": "PT0S",
          "rows": [],
          "count": 0,
          "summary": "rows: 0",
          "detail": {"kind":"detail","id":"0123456789abcdef0123456789abcdef"},
          "canClear": false,
          "canTouch": true,
          "canSave": true,
          "canConfirmClear": false,
          "isSlowImportExecuting": false,
          "isConfirmClearExecuting": false
        },
        "fields": {"note":{"version":0}},
        "presentation": "ok"
      },
      "replyTo": "open-notes-request"
    },
    {
      "send": {
        "kind": "interactions",
        "route": "notes",
        "presentation": {"$id":"presentation"},
        "generation": 1,
        "handlers": [{"name":"unknown","contract":"none"}]
      },
      "id": "unknown"
    },
    {"receive":{"ok":true,"registration":"unsupported"},"replyTo":"unknown"},
    {
      "send": {
        "kind": "interactions",
        "route": "notes",
        "presentation": {"$id":"presentation"},
        "generation": 2,
        "handlers": [{"name":"confirm","contract":{"$id":"confirmContract"}}]
      },
      "id": "register"
    },
    {"receive":{"ok":true,"registration":"ok"},"replyTo":"register"},
    {
      "send": {"kind":"interactions","route":"notes","presentation":{"$id":"presentation"},"generation":1,"handlers":[]},
      "id": "older"
    },
    {"receive":{"ok":true,"registration":"stale"},"replyTo":"older"},
    {
      "send": {
        "kind": "interactions",
        "route": "notes",
        "presentation": {"$id":"presentation2"},
        "generation": 3,
        "handlers": [{"name":"confirm","contract":{"$id":"confirmContract"}}]
      },
      "id": "not-open"
    },
    {"receive":{"ok":true,"registration":"ignored"},"replyTo":"not-open"}
  ]
}
