{
  "format": "runic.views.scenario/1",
  "id": "edits.a-path-write-changes-a-row-cell.v1",
  "contract": {
    "id": "runic.views",
    "version": 4
  },
  "set": "edits",
  "roles": [
    "producer",
    "client"
  ],
  "description": "A write of a keyed collection's cell names the row key and the cell: the row editor replaces the row, the frame replaces it, and the receipt carries the cell's value and the reply's revision.",
  "view": "invoice",
  "requires": [
    "field-paths/1"
  ],
  "ids": {
    "c1": {
      "kind": "connection"
    },
    "hello-c1": {
      "kind": "request"
    },
    "session": {
      "kind": "wire",
      "value": "s-1"
    },
    "open-invoice": {
      "kind": "call"
    },
    "open-invoice-request": {
      "kind": "request"
    },
    "presentation": {
      "kind": "wire",
      "value": "p-1"
    },
    "quantity": {
      "kind": "call"
    },
    "quantity-request": {
      "kind": "request"
    },
    "quantityId": {
      "kind": "wire",
      "value": "w-quantity"
    }
  },
  "arrange": {
    "model": {
      "address": {
        "street": "",
        "city": "Bern"
      },
      "lines": [
        {
          "id": 1,
          "label": "Pens",
          "quantity": 1
        },
        {
          "id": 2,
          "label": "Ink",
          "quantity": 4
        }
      ]
    }
  },
  "steps": [
    {
      "connect": "c1"
    },
    {
      "send": {
        "kind": "hello",
        "protocol": 4,
        "session": {
          "$id": "session"
        },
        "client": {
          "name": {
            "$any": "string",
            "default": "conformance-client"
          },
          "version": {
            "$any": "string",
            "default": "1.0.0"
          }
        },
        "features": {
          "$any": "array",
          "default": [
            "text-splice/1",
            "field-paths/1"
          ]
        }
      },
      "id": "hello-c1"
    },
    {
      "receive": {
        "ok": true,
        "protocol": 4,
        "implementation": {
          "name": {
            "$any": "string",
            "default": "conformance-producer"
          },
          "version": {
            "$any": "string",
            "default": "1.0.0"
          }
        },
        "features": {
          "$any": "array",
          "default": [
            "text-splice/1",
            "field-paths/1"
          ]
        }
      },
      "replyTo": "hello-c1"
    },
    {
      "call": {
        "id": "open-invoice",
        "op": "open",
        "route": "invoice"
      }
    },
    {
      "send": {
        "kind": "open",
        "route": "invoice",
        "presentation": {
          "$id": "presentation"
        }
      },
      "id": "open-invoice-request"
    },
    {
      "receive": {
        "ok": true,
        "revision": 0,
        "state": {
          "address": {
            "street": "",
            "city": "Bern"
          },
          "lines": [
            {
              "id": 1,
              "label": "Pens",
              "quantity": 1
            },
            {
              "id": 2,
              "label": "Ink",
              "quantity": 4
            }
          ]
        },
        "fields": {
          "address": {
            "version": 0
          }
        },
        "presentation": "ok"
      },
      "replyTo": "open-invoice-request"
    },
    {
      "call": {
        "id": "quantity",
        "op": "write",
        "route": "invoice",
        "member": "lines",
        "path": [
          "2",
          "quantity"
        ],
        "requestId": "w-quantity",
        "baseline": {
          "value": 4,
          "version": 0
        },
        "value": 5
      }
    },
    {
      "send": {
        "kind": "write",
        "route": "invoice",
        "member": "lines",
        "path": [
          "2",
          "quantity"
        ],
        "requestId": {
          "$id": "quantityId"
        },
        "expectedVersion": 0,
        "expectedValue": 4,
        "value": 5
      },
      "id": "quantity-request"
    },
    {
      "receive": {
        "kind": "frame",
        "route": "invoice",
        "baseRevision": 0,
        "revision": 1,
        "changes": [
          {
            "field": "lines",
            "kind": "replace",
            "index": 1,
            "oldIndex": 1,
            "keys": [
              "2"
            ],
            "items": [
              {
                "id": 2,
                "label": "Ink",
                "quantity": 5
              }
            ]
          }
        ]
      }
    },
    {
      "receive": {
        "ok": true,
        "revision": 1,
        "receipt": {
          "kind": "applied",
          "snapshot": {
            "value": 5,
            "version": 1
          }
        }
      },
      "replyTo": "quantity-request"
    },
    {
      "expect": {
        "call": {
          "id": "quantity",
          "resolved": {
            "kind": "applied",
            "snapshot": {
              "value": 5,
              "version": 1
            }
          }
        }
      }
    },
    {
      "expect": {
        "model": {
          "lines": [
            {
              "id": 1,
              "label": "Pens",
              "quantity": 1
            },
            {
              "id": 2,
              "label": "Ink",
              "quantity": 5
            }
          ]
        }
      },
      "role": "producer"
    }
  ]
}
