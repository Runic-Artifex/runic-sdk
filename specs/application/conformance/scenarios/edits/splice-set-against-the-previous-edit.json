{
  "format": "runic.views.scenario/1",
  "id": "edits.splice-set-against-the-previous-edit.v1",
  "contract": {"id":"runic.views","version":4},
  "set": "edits",
  "roles": ["producer","client"],
  "description": "A keystroke typed while the previous edit is on its way is a splice against that edit's value; the producer holds the value of each connection's latest edit as the base.",
  "view": "log",
  "requires": ["text-splice/1"],
  "ids": {
    "c1": {"kind":"connection"},
    "hello-c1": {"kind":"request"},
    "session": {"kind":"wire","value":"s-1"},
    "open-log": {"kind":"call"},
    "open-log-request": {"kind":"request"},
    "type-1": {"kind":"call"},
    "type-2": {"kind":"call"},
    "edit-1": {"kind":"request"},
    "edit-2": {"kind":"request"},
    "final-read": {"kind":"request"},
    "presentation": {"kind":"wire","value":"p-1"}
  },
  "arrange": {"model":{"title":"Splices keep the text a page already has and send only what changed in it, here and now."}},
  "steps": [
    {"connect":"c1"},
    {"send":{"kind":"hello","protocol":4,"session":{"$id":"session"},"client":{"name":{"$any":"string","default":"conformance-client"},"version":{"$any":"string","default":"1.0.0"}},"features":["text-splice/1"]},"id":"hello-c1"},
    {"receive":{"ok":true,"protocol":4,"implementation":{"name":{"$any":"string","default":"conformance-producer"},"version":{"$any":"string","default":"1.0.0"}},"features":{"$any":"array","default":["text-splice/1"]}},"replyTo":"hello-c1"},
    {"call":{"id":"open-log","op":"open","route":"log"}},
    {"send":{"kind":"open","route":"log","presentation":{"$id":"presentation"}},"id":"open-log-request"},
    {"receive":{"ok":true,"revision":0,"state":{"log":"","title":"Splices keep the text a page already has and send only what changed in it, here and now."},"presentation":"ok"},"replyTo":"open-log-request"},
    {"call":{"id":"type-1","op":"set","route":"log","member":"title","value":"Splices keep the text a page already has and send only what changed in it, here and now.!"}},
    {"send":{"kind":"set","route":"log","member":"title","edit":1,"splice":{"baseRevision":0,"length":88,"index":88,"delete":0,"text":"!"}},"id":"edit-1"},
    {"call":{"id":"type-2","op":"set","route":"log","member":"title","value":"Splices keep the text a page already has and send only what changed in it, here and now.!?"}},
    {"send":{"kind":"set","route":"log","member":"title","edit":2,"splice":{"baseEdit":1,"length":89,"index":89,"delete":0,"text":"?"}},"id":"edit-2"},
    {"expect":{"state":{"route":"log","value":{"log":"","title":"Splices keep the text a page already has and send only what changed in it, here and now.!?"}}}},
    {"receive":{"kind":"frame","route":"log","baseRevision":0,"revision":1,"changes":[{"field":"title","kind":"splice","length":88,"index":88,"delete":0,"text":"!"}]}},
    {"receive":{"ok":true,"revision":1},"replyTo":"edit-1","unordered":true},
    {"expect":{"call":{"id":"type-1","resolved":null}}},
    {"expect":{"state":{"route":"log","value":{"log":"","title":"Splices keep the text a page already has and send only what changed in it, here and now.!?"}}}},
    {"receive":{"kind":"frame","route":"log","baseRevision":1,"revision":2,"changes":[{"field":"title","kind":"splice","length":89,"index":89,"delete":0,"text":"?"}]},"unordered":true},
    {"receive":{"ok":true,"revision":2},"replyTo":"edit-2","unordered":true},
    {"expect":{"call":{"id":"type-2","resolved":null}}},
    {"send":{"kind":"snapshot","route":"log"},"id":"final-read","role":"producer"},
    {"receive":{"ok":true,"revision":2,"state":{"log":"","title":"Splices keep the text a page already has and send only what changed in it, here and now.!?"}},"replyTo":"final-read","role":"producer"},
    {"expect":{"state":{"route":"log","value":{"log":"","title":"Splices keep the text a page already has and send only what changed in it, here and now.!?"}}}}
  ]
}
