{
  "format": "runic.views.scenario/1",
  "id": "edits.a-path-write-without-the-feature-is-invalid.v1",
  "contract": {
    "id": "runic.views",
    "version": 4
  },
  "set": "edits",
  "roles": [
    "producer"
  ],
  "description": "A write with a path on a connection that does not use field-paths/1 is rejected with invalid-request, and nothing runs.",
  "view": "invoice",
  "requires": [],
  "ids": {
    "c1": {
      "kind": "connection"
    },
    "hello-c1": {
      "kind": "request"
    },
    "session": {
      "kind": "wire",
      "value": "s-1"
    },
    "open-invoice-request": {
      "kind": "request"
    },
    "presentation": {
      "kind": "wire",
      "value": "p-1"
    },
    "without": {
      "kind": "request"
    },
    "w1": {
      "kind": "wire",
      "value": "w-1"
    }
  },
  "arrange": {
    "model": {
      "address": {
        "street": "",
        "city": "Bern"
      },
      "lines": [
        {
          "id": 1,
          "label": "Pens",
          "quantity": 1
        },
        {
          "id": 2,
          "label": "Ink",
          "quantity": 4
        }
      ]
    }
  },
  "steps": [
    {
      "connect": "c1"
    },
    {
      "send": {
        "kind": "hello",
        "protocol": 4,
        "session": {
          "$id": "session"
        },
        "client": {
          "name": {
            "$any": "string",
            "default": "conformance-client"
          },
          "version": {
            "$any": "string",
            "default": "1.0.0"
          }
        },
        "features": {
          "$any": "array",
          "default": [
            "text-splice/1"
          ]
        }
      },
      "id": "hello-c1"
    },
    {
      "receive": {
        "ok": true,
        "protocol": 4,
        "implementation": {
          "name": {
            "$any": "string",
            "default": "conformance-producer"
          },
          "version": {
            "$any": "string",
            "default": "1.0.0"
          }
        },
        "features": {
          "$any": "array",
          "default": [
            "text-splice/1"
          ]
        }
      },
      "replyTo": "hello-c1"
    },
    {
      "send": {
        "kind": "open",
        "route": "invoice",
        "presentation": {
          "$id": "presentation"
        }
      },
      "id": "open-invoice-request"
    },
    {
      "receive": {
        "ok": true,
        "revision": 0,
        "state": {
          "address": {
            "street": "",
            "city": "Bern"
          },
          "lines": [
            {
              "id": 1,
              "label": "Pens",
              "quantity": 1
            },
            {
              "id": 2,
              "label": "Ink",
              "quantity": 4
            }
          ]
        },
        "fields": {
          "address": {
            "version": 0
          }
        },
        "presentation": "ok"
      },
      "replyTo": "open-invoice-request"
    },
    {
      "send": {
        "kind": "write",
        "route": "invoice",
        "member": "lines",
        "path": [
          "1",
          "quantity"
        ],
        "requestId": {
          "$id": "w1"
        },
        "expectedVersion": 0,
        "expectedValue": 1,
        "value": 2
      },
      "id": "without"
    },
    {
      "receive": {
        "ok": false,
        "error": {
          "kind": "rejected",
          "reason": "invalid-request",
          "message": {
            "$any": "string"
          }
        }
      },
      "replyTo": "without"
    },
    {
      "expect": {
        "model": {
          "lines": [
            {
              "id": 1,
              "label": "Pens",
              "quantity": 1
            },
            {
              "id": 2,
              "label": "Ink",
              "quantity": 4
            }
          ]
        }
      }
    }
  ]
}
