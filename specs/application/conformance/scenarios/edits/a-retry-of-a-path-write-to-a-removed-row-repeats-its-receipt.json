{
  "format": "runic.views.scenario/1",
  "id": "edits.a-retry-of-a-path-write-to-a-removed-row-repeats-its-receipt.v1",
  "contract": {"id":"runic.views","version":4},
  "set": "edits",
  "roles": ["producer"],
  "requires": ["field-paths/1"],
  "description": "A path write whose row is gone is rejected, and the producer retains that receipt for its requestId: a retry after a row with the key was added again receives the same rejection and writes nothing.",
  "view": "invoice",
  "ids": {
    "c1": {"kind":"connection"},
    "hello-c1": {"kind":"request"},
    "open-invoice": {"kind":"request"},
    "write": {"kind":"request"},
    "retry": {"kind":"request"},
    "session": {"kind":"wire","value":"s-1"},
    "presentation": {"kind":"wire","value":"p-1"},
    "writeId": {"kind":"wire","value":"w-1"}
  },
  "arrange": {"model":{"lines":[{"id":1,"label":"Pens","quantity":1}]}},
  "steps": [
    {"connect":"c1"},
    {"send":{"kind":"hello","protocol":4,"session":{"$id":"session"},"client":{"name":{"$any":"string","default":"conformance-client"},"version":{"$any":"string","default":"1.0.0"}},"features":{"$any":"array","default":["text-splice/1","field-paths/1"]}},"id":"hello-c1"},
    {"receive":{"ok":true,"protocol":4,"implementation":{"name":{"$any":"string","default":"conformance-producer"},"version":{"$any":"string","default":"1.0.0"}},"features":{"$any":"array","default":["text-splice/1","field-paths/1"]}},"replyTo":"hello-c1"},
    {"send":{"kind":"open","route":"invoice","presentation":{"$id":"presentation"}},"id":"open-invoice"},
    {"receive":{"ok":true,"revision":0,"state":{"address":{"street":"","city":""},"billing":null,"lines":[{"id":1,"label":"Pens","quantity":1}]},"fields":{"address":{"version":0},"billing":{"version":0}},"presentation":"ok"},"replyTo":"open-invoice"},
    {"send":{"kind":"write","route":"invoice","member":"lines","path":["2","quantity"],"requestId":{"$id":"writeId"},"expectedVersion":0,"expectedValue":4,"value":5},"id":"write"},
    {"receive":{"ok":true,"revision":0,"receipt":{"kind":"rejected","message":{"$any":"string"}}},"replyTo":"write"},
    {"mutate":[{"op":"insert","member":"lines","index":1,"item":{"id":2,"label":"Ink","quantity":4}}]},
    {"receive":{"kind":"frame","route":"invoice","baseRevision":0,"revision":1,"changes":[{"field":"lines","kind":"add","index":1,"oldIndex":-1,"keys":["2"],"items":[{"id":2,"label":"Ink","quantity":4}]}]}},
    {"send":{"kind":"write","route":"invoice","member":"lines","path":["2","quantity"],"requestId":{"$id":"writeId"},"expectedVersion":0,"expectedValue":4,"value":5},"id":"retry"},
    {"receive":{"ok":true,"revision":1,"receipt":{"kind":"rejected","message":{"$any":"string"}}},"replyTo":"retry"},
    {"expect":{"model":{"lines":[{"id":1,"label":"Pens","quantity":1},{"id":2,"label":"Ink","quantity":4}]}}}
  ]
}
