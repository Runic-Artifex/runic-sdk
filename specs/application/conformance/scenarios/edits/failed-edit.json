{
  "format": "runic.views.scenario/1",
  "id": "edits.failed-edit.v1",
  "contract": {"id":"runic.views","version":4},
  "set": "edits",
  "roles": ["producer","client"],
  "description": "A setter value that is not valid is rejected with invalid-input; the call rejects and the client shows the producer's value again.",
  "view": "notes",
  "ids": {
    "c1": {"kind":"connection"},
    "hello-c1": {"kind":"request"},
    "session": {"kind":"wire","value":"s-1"},
    "open-notes": {"kind":"call"},
    "open-notes-request": {"kind":"request"},
    "presentation": {"kind":"wire","value":"p-1"},
    "choose": {"kind":"call"},
    "edit-1": {"kind":"request"}
  },
  "arrange": {"model":{}},
  "steps": [
    {"connect":"c1"},
    {
      "send": {
        "kind": "hello",
        "protocol": 4,
        "session": {"$id":"session"},
        "client": {"name":{"$any":"string","default":"conformance-client"},"version":{"$any":"string","default":"1.0.0"}},
        "features": {"$any":"array","default":["text-splice/1"]}
      },
      "id": "hello-c1"
    },
    {
      "receive": {
        "ok": true,
        "protocol": 4,
        "implementation": {"name":{"$any":"string","default":"conformance-producer"},"version":{"$any":"string","default":"1.0.0"}},
        "features": {"$any":"array","default":["text-splice/1"]}
      },
      "replyTo": "hello-c1"
    },
    {"call":{"id":"open-notes","op":"open","route":"notes"}},
    {"send":{"kind":"open","route":"notes","presentation":{"$id":"presentation"}},"id":"open-notes-request"},
    {
      "receive": {
        "ok": true,
        "revision": 0,
        "state": {
          "title": "",
          "note": "",
          "priority": "Normal",
          "due": null,
          "elapsed": "PT0S",
          "rows": [],
          "count": 0,
          "summary": "rows: 0",
          "detail": {"kind":"detail","id":"0123456789abcdef0123456789abcdef"},
          "canClear": false,
          "canTouch": true,
          "canSave": true,
          "canConfirmClear": false,
          "isSlowImportExecuting": false,
          "isConfirmClearExecuting": false
        },
        "fields": {"note":{"version":0}},
        "presentation": "ok"
      },
      "replyTo": "open-notes-request"
    },
    {"call":{"id":"choose","op":"set","route":"notes","member":"priority","value":"Urgent"}},
    {"send":{"kind":"set","route":"notes","member":"priority","value":"Urgent","edit":1},"id":"edit-1"},
    {
      "receive": {"ok":false,"error":{"kind":"rejected","reason":"invalid-input","message":{"$any":"string","default":"…"}}},
      "replyTo": "edit-1"
    },
    {"expect":{"call":{"id":"choose","rejected":{"kind":"rejected","reason":"invalid-input"}}}},
    {
      "expect": {
        "state": {
          "route": "notes",
          "value": {
            "title": "",
            "note": "",
            "priority": "Normal",
            "due": null,
            "elapsed": "PT0S",
            "rows": [],
            "count": 0,
            "summary": "rows: 0",
            "detail": {"kind":"detail","id":"0123456789abcdef0123456789abcdef"},
            "canClear": false,
            "canTouch": true,
            "canSave": true,
            "canConfirmClear": false,
            "isSlowImportExecuting": false,
            "isConfirmClearExecuting": false
          }
        }
      }
    },
    {"expect":{"model":{"priority":"Normal"}}}
  ]
}
