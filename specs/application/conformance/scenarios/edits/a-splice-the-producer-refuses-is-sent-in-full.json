{
  "format": "runic.views.scenario/1",
  "id": "edits.a-splice-the-producer-refuses-is-sent-in-full.v1",
  "contract": {"id":"runic.views","version":4},
  "set": "edits",
  "roles": ["client"],
  "description": "When the producer answers a splice with splice-base, the client sends the same value in full as a new edit, and the setter's call settles with that edit.",
  "view": "log",
  "requires": ["text-splice/1"],
  "ids": {
    "c1": {"kind":"connection"},
    "hello-c1": {"kind":"request"},
    "session": {"kind":"wire","value":"s-1"},
    "open-log": {"kind":"call"},
    "open-log-request": {"kind":"request"},
    "type": {"kind":"call"},
    "edit-1": {"kind":"request"},
    "edit-2": {"kind":"request"},
    "presentation": {"kind":"wire","value":"p-1"}
  },
  "arrange": {"model":{}},
  "steps": [
    {"connect":"c1"},
    {"send":{"kind":"hello","protocol":4,"session":{"$id":"session"},"client":{"name":{"$any":"string","default":"conformance-client"},"version":{"$any":"string","default":"1.0.0"}},"features":{"$any":"array","default":["text-splice/1"]}},"id":"hello-c1"},
    {"receive":{"ok":true,"protocol":4,"implementation":{"name":{"$any":"string","default":"conformance-producer"},"version":{"$any":"string","default":"1.0.0"}},"features":{"$any":"array","default":["text-splice/1"]}},"replyTo":"hello-c1"},
    {"call":{"id":"open-log","op":"open","route":"log"}},
    {"send":{"kind":"open","route":"log","presentation":{"$id":"presentation"}},"id":"open-log-request"},
    {"receive":{"ok":true,"revision":0,"state":{"log":"","title":"Splices keep the text a page already has and send only what changed in it, here and now."},"presentation":"ok"},"replyTo":"open-log-request"},
    {"call":{"id":"type","op":"set","route":"log","member":"title","value":"Splices keep the text a page already has and send only what changed in it, here and now.!"}},
    {"send":{"kind":"set","route":"log","member":"title","edit":1,"splice":{"baseRevision":0,"length":88,"index":88,"delete":0,"text":"!"}},"id":"edit-1"},
    {"receive":{"ok":false,"error":{"kind":"rejected","reason":"splice-base","message":{"$any":"string","default":"…"}}},"replyTo":"edit-1"},
    {"send":{"kind":"set","route":"log","member":"title","value":"Splices keep the text a page already has and send only what changed in it, here and now.!","edit":2},"id":"edit-2"},
    {"expect":{"call":{"id":"type","pending":true}}},
    {"expect":{"state":{"route":"log","value":{"log":"","title":"Splices keep the text a page already has and send only what changed in it, here and now.!"}}}},
    {"receive":{"kind":"frame","route":"log","baseRevision":0,"revision":1,"changes":[{"field":"title","kind":"set","value":"Splices keep the text a page already has and send only what changed in it, here and now.!"}]}},
    {"receive":{"ok":true,"revision":1},"replyTo":"edit-2"},
    {"expect":{"call":{"id":"type","resolved":null}}},
    {"expect":{"state":{"route":"log","value":{"log":"","title":"Splices keep the text a page already has and send only what changed in it, here and now.!"}}}}
  ]
}
