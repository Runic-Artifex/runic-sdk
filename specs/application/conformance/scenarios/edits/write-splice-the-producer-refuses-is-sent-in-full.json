    {"receive":{"ok":true,"revision":0,"state":{"title":"","note":"Splices keep the text a page already has and send only what changed in it, here and now.","priority":"Normal","due":null,"elapsed":"PT0S","rows":[],"count":0,"summary":"rows: 0","detail":{"kind":"detail","id":"0123456789abcdef0123456789abcdef"},"canClear":false,"canTouch":true,"canSave":true,"canConfirmClear":false,"isSlowImportExecuting":false,"isConfirmClearExecuting":false},"fields":{"note":{"version":0}},"presentation":"ok"},"replyTo":"open-notes-request"},
    {"call":{"id":"write","op":"write","route":"notes","member":"note","requestId":"w-1","baseline":{"value":"Splices keep the text a page already has and send only what changed in it, here and now.","version":0},"value":"Splices keep the text a page already has and send only what changed in it, here and now.!"}},
    {"send":{"kind":"write","route":"notes","member":"note","requestId":{"$id":"writeRequest"},"expectedVersion":0,"splice":{"length":88,"index":88,"delete":0,"text":"!"}},"id":"write-request"},
