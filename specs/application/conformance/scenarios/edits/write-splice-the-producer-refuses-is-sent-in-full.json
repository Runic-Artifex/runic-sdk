    "presentation": {"kind":"wire","value":"p-1"},
    "write": {"kind":"call"},
    "write-request": {"kind":"request"},
    "full": {"kind":"request"},
    "writeRequest": {"kind":"wire","value":"w-1"}
  },
  "arrange": {"model":{"note":"Splices keep the text a page already has and send only what changed in it, here and now."}},
  "steps": [
