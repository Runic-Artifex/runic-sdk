{
  "format": "runic.views.vector/1",
  "id": "values.dates-and-times",
  "contract": {"id":"runic.views","version":4},
  "area": "values",
  "description": "local-date, local-time, date-time and offset-date-time.",
  "cases": [
    {
      "id": "values.dates-and-times.local-date-leap-day",
      "operation": "decode",
      "type": "local-date",
      "input": {"encoding":"json","value":"2024-02-29"},
      "expect": {"value":"2024-02-29"}
    },
    {
      "id": "values.dates-and-times.local-date-not-leap-day",
      "operation": "decode",
      "type": "local-date",
      "input": {"encoding":"json","value":"2023-02-29"},
      "expect": {"error":{"code":"invalid-value"}}
    },
    {
      "id": "values.dates-and-times.local-date-first",
      "operation": "decode",
      "type": "local-date",
      "input": {"encoding":"json","value":"0001-01-01"},
      "expect": {"value":"0001-01-01"}
    },
    {
      "id": "values.dates-and-times.local-date-year-zero",
      "operation": "decode",
      "type": "local-date",
      "input": {"encoding":"json","value":"0000-01-01"},
      "expect": {"error":{"code":"invalid-value"}}
    },
    {
      "id": "values.dates-and-times.local-date-last",
      "operation": "decode",
      "type": "local-date",
      "input": {"encoding":"json","value":"9999-12-31"},
      "expect": {"value":"9999-12-31"}
    },
    {
      "id": "values.dates-and-times.local-date-month-13",
      "operation": "decode",
      "type": "local-date",
      "input": {"encoding":"json","value":"2024-13-01"},
      "expect": {"error":{"code":"invalid-value"}}
    },
    {
      "id": "values.dates-and-times.local-date-short-month",
      "operation": "decode",
      "type": "local-date",
      "input": {"encoding":"json","value":"2024-1-01"},
      "expect": {"error":{"code":"invalid-value"}}
    },
    {
      "id": "values.dates-and-times.local-date-basic-format",
      "operation": "decode",
      "type": "local-date",
      "input": {"encoding":"json","value":"20240101"},
      "expect": {"error":{"code":"invalid-value"}}
    },
    {
      "id": "values.dates-and-times.local-date-with-time",
      "operation": "decode",
      "type": "local-date",
      "input": {"encoding":"json","value":"2024-01-01T00:00:00"},
      "expect": {"error":{"code":"invalid-value"}}
    },
    {
      "id": "values.dates-and-times.local-time-midnight",
      "operation": "decode",
      "type": "local-time",
      "input": {"encoding":"json","value":"00:00:00"},
      "expect": {"value":"00:00:00"}
    },
    {
      "id": "values.dates-and-times.local-time-last",
      "operation": "decode",
      "type": "local-time",
      "input": {"encoding":"json","value":"23:59:59.9999999"},
      "expect": {"value":"23:59:59.9999999"}
    },
    {
      "id": "values.dates-and-times.local-time-trailing-zeros",
      "operation": "decode",
      "type": "local-time",
      "input": {"encoding":"json","value":"10:30:00.5000000"},
      "expect": {"value":"10:30:00.5"}
    },
    {
      "id": "values.dates-and-times.local-time-zero-fraction",
      "operation": "decode",
      "type": "local-time",
      "input": {"encoding":"json","value":"10:30:00.0"},
      "expect": {"value":"10:30:00"}
    },
    {
      "id": "values.dates-and-times.local-time-hour-24",
      "operation": "decode",
      "type": "local-time",
      "input": {"encoding":"json","value":"24:00:00"},
      "expect": {"error":{"code":"invalid-value"}}
    },
    {
      "id": "values.dates-and-times.local-time-leap-second",
      "operation": "decode",
      "type": "local-time",
      "input": {"encoding":"json","value":"23:59:60"},
      "expect": {"error":{"code":"invalid-value"}}
    },
    {
      "id": "values.dates-and-times.local-time-no-seconds",
      "operation": "decode",
      "type": "local-time",
      "input": {"encoding":"json","value":"10:30"},
      "expect": {"error":{"code":"invalid-value"}}
    },
    {
      "id": "values.dates-and-times.local-time-eight-digits",
      "operation": "decode",
      "type": "local-time",
      "input": {"encoding":"json","value":"10:30:00.12345678"},
      "expect": {"error":{"code":"invalid-value"}}
    },
    {
      "id": "values.dates-and-times.local-time-with-zone",
      "operation": "decode",
      "type": "local-time",
      "input": {"encoding":"json","value":"10:30:00Z"},
      "expect": {"error":{"code":"invalid-value"}}
    },
    {
      "id": "values.dates-and-times.date-time-local",
      "operation": "decode",
      "type": "date-time",
      "input": {"encoding":"json","value":"2026-10-28T12:00:00"},
      "expect": {"value":"2026-10-28T12:00:00"}
    },
    {
      "id": "values.dates-and-times.date-time-utc",
      "operation": "decode",
      "type": "date-time",
      "input": {"encoding":"json","value":"2026-10-28T12:00:00Z"},
      "expect": {"value":"2026-10-28T12:00:00Z"}
    },
    {
      "id": "values.dates-and-times.date-time-offset",
      "operation": "decode",
      "type": "date-time",
      "input": {"encoding":"json","value":"2026-10-28T12:00:00.1230000+02:00"},
      "expect": {"value":"2026-10-28T12:00:00.123+02:00"}
    },
    {
      "id": "values.dates-and-times.date-time-zero-offset",
      "description": "A date-time keeps the offset as read.",
      "operation": "decode",
      "type": "date-time",
      "input": {"encoding":"json","value":"2026-10-28T12:00:00+00:00"},
      "expect": {"value":"2026-10-28T12:00:00+00:00"}
    },
    {
      "id": "values.dates-and-times.date-time-lowercase",
      "operation": "decode",
      "type": "date-time",
      "input": {"encoding":"json","value":"2026-10-28t12:00:00z"},
      "expect": {"error":{"code":"invalid-value"}}
    },
    {
      "id": "values.dates-and-times.date-time-space",
      "operation": "decode",
      "type": "date-time",
      "input": {"encoding":"json","value":"2026-10-28 12:00:00"},
      "expect": {"error":{"code":"invalid-value"}}
    },
    {
      "id": "values.dates-and-times.date-time-offset-too-large",
      "operation": "decode",
      "type": "date-time",
      "input": {"encoding":"json","value":"2026-10-28T12:00:00+15:00"},
      "expect": {"error":{"code":"invalid-value"}}
    },
    {
      "id": "values.dates-and-times.date-time-offset-without-colon",
      "operation": "decode",
      "type": "date-time",
      "input": {"encoding":"json","value":"2026-10-28T12:00:00+0200"},
      "expect": {"error":{"code":"invalid-value"}}
    },
    {
      "id": "values.dates-and-times.date-time-date-only",
      "operation": "decode",
      "type": "date-time",
      "input": {"encoding":"json","value":"2026-10-28"},
      "expect": {"error":{"code":"invalid-value"}}
    },
    {
      "id": "values.dates-and-times.offset-date-time-utc",
      "operation": "decode",
      "type": "offset-date-time",
      "input": {"encoding":"json","value":"2026-10-28T12:00:00Z"},
      "expect": {"value":"2026-10-28T12:00:00Z"}
    },
    {
      "id": "values.dates-and-times.offset-date-time-zero-offset",
      "description": "A zero offset is written Z.",
      "operation": "decode",
      "type": "offset-date-time",
      "input": {"encoding":"json","value":"2026-10-28T12:00:00+00:00"},
      "expect": {"value":"2026-10-28T12:00:00Z"}
    },
    {
      "id": "values.dates-and-times.offset-date-time-negative-zero-offset",
      "operation": "decode",
      "type": "offset-date-time",
      "input": {"encoding":"json","value":"2026-10-28T12:00:00-00:00"},
      "expect": {"value":"2026-10-28T12:00:00Z"}
    },
    {
      "id": "values.dates-and-times.offset-date-time-half-hour",
      "operation": "decode",
      "type": "offset-date-time",
      "input": {"encoding":"json","value":"2026-10-28T12:00:00.5-05:30"},
      "expect": {"value":"2026-10-28T12:00:00.5-05:30"}
    },
    {
      "id": "values.dates-and-times.offset-date-time-largest-offset",
      "operation": "decode",
      "type": "offset-date-time",
      "input": {"encoding":"json","value":"2026-10-28T12:00:00+14:00"},
      "expect": {"value":"2026-10-28T12:00:00+14:00"}
    },
    {
      "id": "values.dates-and-times.offset-date-time-offset-beyond",
      "operation": "decode",
      "type": "offset-date-time",
      "input": {"encoding":"json","value":"2026-10-28T12:00:00+14:01"},
      "expect": {"error":{"code":"invalid-value"}}
    },
    {
      "id": "values.dates-and-times.offset-date-time-no-offset",
      "operation": "decode",
      "type": "offset-date-time",
      "input": {"encoding":"json","value":"2026-10-28T12:00:00"},
      "expect": {"error":{"code":"invalid-value"}}
    }
  ]
}
