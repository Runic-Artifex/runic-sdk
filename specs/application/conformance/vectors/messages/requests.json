{
  "format": "runic.views.vector/1",
  "id": "messages.requests",
  "contract": {"id":"runic.views","version":4},
  "area": "messages",
  "description": "Requests as a producer reads them. Only the envelope is checked: routes and members are checked by the scenarios.",
  "cases": [
    {
      "id": "messages.requests.hello",
      "operation": "read-request",
      "input": {
        "encoding": "json",
        "value": {"kind":"hello","protocol":4,"session":"s-1","client":{"name":"test-client","version":"1.0.0"}}
      },
      "expect": {"result":"valid"}
    },
    {
      "id": "messages.requests.hello-without-session",
      "operation": "read-request",
      "input": {"encoding":"json","value":{"kind":"hello","protocol":4,"client":{"name":"test-client","version":"1.0.0"}}},
      "expect": {"result":"invalid","error":{"kind":"rejected","reason":"invalid-request"}}
    },
    {
      "id": "messages.requests.hello-with-unknown-member",
      "description": "Unknown members are ignored.",
      "operation": "read-request",
      "input": {
        "encoding": "json",
        "value": {"kind":"hello","protocol":4,"session":"s-1","client":{"name":"test-client","version":"1.0.0"},"future":true}
      },
      "expect": {"result":"valid"}
    },
    {
      "id": "messages.requests.hello-session-too-long",
      "operation": "read-request",
      "input": {
        "encoding": "json",
        "value": {
          "kind": "hello",
          "protocol": 4,
          "session": "sssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssss",
          "client": {"name":"test-client","version":"1.0.0"}
        }
      },
      "expect": {"result":"invalid","error":{"kind":"rejected","reason":"invalid-request"}}
    },
    {
      "id": "messages.requests.set",
      "operation": "read-request",
      "input": {"encoding":"json","value":{"kind":"set","route":"notes","member":"title","value":"Draft","edit":7}},
      "expect": {"result":"valid"}
    },
    {
      "id": "messages.requests.set-without-edit",
      "operation": "read-request",
      "input": {"encoding":"json","value":{"kind":"set","route":"notes","member":"title","value":"Draft"}},
      "expect": {"result":"invalid","error":{"kind":"rejected","reason":"invalid-request"}}
    },
    {
      "id": "messages.requests.set-edit-zero",
      "description": "Edit numbers are positive.",
      "operation": "read-request",
      "input": {"encoding":"json","value":{"kind":"set","route":"notes","member":"title","value":"Draft","edit":0}},
      "expect": {"result":"invalid","error":{"kind":"rejected","reason":"invalid-request"}}
    },
    {
      "id": "messages.requests.set-edit-beyond-safe-integer",
      "operation": "read-request",
      "input": {
        "encoding": "utf8",
        "value": "{\"kind\":\"set\",\"route\":\"notes\",\"member\":\"title\",\"value\":\"x\",\"edit\":9007199254740992}"
      },
      "expect": {"result":"invalid","error":{"kind":"rejected","reason":"invalid-request"}}
    },
    {
      "id": "messages.requests.set-without-value",
      "operation": "read-request",
      "input": {"encoding":"json","value":{"kind":"set","route":"notes","member":"title","edit":7}},
      "expect": {"result":"invalid","error":{"kind":"rejected","reason":"invalid-request"}}
    },
    {
      "id": "messages.requests.set-null-value",
