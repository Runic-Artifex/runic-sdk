{
  "format": "runic.views.vector/1",
  "id": "messages.requests",
  "contract": {"id":"runic.views","version":4},
  "area": "messages",
  "description": "Requests as a producer reads them. Only the envelope is checked: routes and members are checked by the scenarios.",
  "cases": [
    {
      "id": "messages.requests.hello",
      "operation": "read-request",
      "input": {
        "encoding": "json",
        "value": {"kind":"hello","protocol":4,"session":"s-1","client":{"name":"test-client","version":"1.0.0"}}
      },
      "expect": {"result":"valid"}
    },
    {
      "id": "messages.requests.hello-without-session",
      "operation": "read-request",
      "input": {"encoding":"json","value":{"kind":"hello","protocol":4,"client":{"name":"test-client","version":"1.0.0"}}},
      "expect": {"result":"invalid","error":{"kind":"rejected","reason":"invalid-request"}}
    },
    {
      "id": "messages.requests.hello-with-unknown-member",
      "description": "Unknown members are ignored.",
      "operation": "read-request",
      "input": {
        "encoding": "json",
        "value": {"kind":"hello","protocol":4,"session":"s-1","client":{"name":"test-client","version":"1.0.0"},"future":true}
      },
      "expect": {"result":"valid"}
    },
    {
      "id": "messages.requests.hello-session-too-long",
      "operation": "read-request",
      "input": {
        "encoding": "json",
        "value": {
          "kind": "hello",
          "protocol": 4,
          "session": "sssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssss",
          "client": {"name":"test-client","version":"1.0.0"}
        }
      },
      "expect": {"result":"invalid","error":{"kind":"rejected","reason":"invalid-request"}}
    },
    {
      "id": "messages.requests.set",
      "operation": "read-request",
      "input": {"encoding":"json","value":{"kind":"set","route":"notes","member":"title","value":"Draft","edit":7}},
      "expect": {"result":"valid"}
    },
    {
      "id": "messages.requests.set-without-edit",
      "operation": "read-request",
      "input": {"encoding":"json","value":{"kind":"set","route":"notes","member":"title","value":"Draft"}},
      "expect": {"result":"invalid","error":{"kind":"rejected","reason":"invalid-request"}}
    },
    {
      "id": "messages.requests.set-edit-zero",
      "description": "Edit numbers are positive.",
      "operation": "read-request",
      "input": {"encoding":"json","value":{"kind":"set","route":"notes","member":"title","value":"Draft","edit":0}},
      "expect": {"result":"invalid","error":{"kind":"rejected","reason":"invalid-request"}}
    },
    {
      "id": "messages.requests.set-edit-beyond-safe-integer",
      "operation": "read-request",
      "input": {
        "encoding": "utf8",
        "value": "{\"kind\":\"set\",\"route\":\"notes\",\"member\":\"title\",\"value\":\"x\",\"edit\":9007199254740992}"
      },
      "expect": {"result":"invalid","error":{"kind":"rejected","reason":"invalid-request"}}
    },
    {
      "id": "messages.requests.set-without-value",
      "operation": "read-request",
      "input": {"encoding":"json","value":{"kind":"set","route":"notes","member":"title","edit":7}},
      "expect": {"result":"invalid","error":{"kind":"rejected","reason":"invalid-request"}}
    },
    {
      "id": "messages.requests.set-null-value",
      "description": "null is a value; whether the member accepts it is the member's type.",
      "operation": "read-request",
      "input": {"encoding":"json","value":{"kind":"set","route":"notes","member":"title","value":null,"edit":7}},
      "expect": {"result":"valid"}
    },
    {
      "id": "messages.requests.unknown-kind",
      "description": "A producer rejects a request kind it does not know.",
      "operation": "read-request",
      "input": {"encoding":"json","value":{"kind":"teleport","route":"notes"}},
      "expect": {"result":"invalid","error":{"kind":"rejected","reason":"invalid-request"}}
    },
    {
      "id": "messages.requests.without-kind",
      "operation": "read-request",
      "input": {"encoding":"json","value":{"route":"notes"}},
      "expect": {"result":"invalid","error":{"kind":"rejected","reason":"invalid-request"}}
    },
    {
      "id": "messages.requests.array",
      "operation": "read-request",
      "input": {"encoding":"json","value":[{"kind":"set","route":"notes","member":"title","value":"Draft","edit":7}]},
      "expect": {"result":"invalid","error":{"kind":"rejected","reason":"invalid-request"}}
    },
    {
      "id": "messages.requests.duplicate-member",
      "operation": "read-request",
      "input": {
        "encoding": "utf8",
        "value": "{\"kind\":\"set\",\"route\":\"notes\",\"member\":\"title\",\"value\":\"a\",\"value\":\"b\",\"edit\":1}"
      },
      "expect": {"result":"invalid","error":{"kind":"rejected","reason":"invalid-request"}}
    },
    {
      "id": "messages.requests.depth-65",
      "description": "The message is nested 65 deep.",
      "operation": "read-request",
      "input": {
        "encoding": "utf8",
        "value": "{\"kind\":\"set\",\"route\":\"notes\",\"member\":\"data\",\"edit\":1,\"value\":[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]}"
      },
      "expect": {"result":"invalid","error":{"kind":"rejected","reason":"invalid-request"}}
    },
    {
      "id": "messages.requests.over-input-limit",
      "description": "A request larger than the input limit.",
      "operation": "read-request",
      "limits": {"inputBytes":1024},
      "input": {
        "encoding": "json",
        "value": {
          "kind": "set",
          "route": "notes",
          "member": "title",
          "value": "",
          "edit": 7
        }
      },
      "expect": {"result":"invalid","error":{"kind":"rejected","reason":"invalid-input"}}
    },
    {
      "id": "messages.requests.command-without-input",
      "operation": "read-request",
      "input": {"encoding":"json","value":{"kind":"command","route":"notes","member":"clear"}},
      "expect": {"result":"valid"}
    },
    {
      "id": "messages.requests.command-null-input",
      "operation": "read-request",
      "input": {"encoding":"json","value":{"kind":"command","route":"notes","member":"addRow","input":null}},
      "expect": {"result":"valid"}
    },
    {
      "id": "messages.requests.content-route",
      "operation": "read-request",
      "input": {"encoding":"json","value":{"kind":"snapshot","route":"content0123456789abcdef0123456789abcdef"}},
      "expect": {"result":"valid"}
    },
    {
      "id": "messages.requests.route-with-space",
      "operation": "read-request",
      "input": {"encoding":"json","value":{"kind":"snapshot","route":"my notes"}},
      "expect": {"result":"invalid","error":{"kind":"rejected","reason":"invalid-request"}}
    },
    {
      "id": "messages.requests.start",
      "operation": "read-request",
      "input": {
        "encoding": "json",
        "value": {"kind":"start","route":"notes","member":"slowImport","operation":"op-1","contract":"Tests.Notes:fp-1"}
      },
      "expect": {"result":"valid"}
    },
    {
      "id": "messages.requests.start-contract-without-colon",
      "operation": "read-request",
      "input": {
        "encoding": "json",
        "value": {"kind":"start","route":"notes","member":"slowImport","operation":"op-1","contract":"Tests.Notes"}
      },
      "expect": {"result":"invalid","error":{"kind":"rejected","reason":"invalid-request"}}
    },
    {
      "id": "messages.requests.start-empty-operation",
      "operation": "read-request",
      "input": {
        "encoding": "json",
        "value": {"kind":"start","route":"notes","member":"slowImport","operation":"","contract":"Tests.Notes:fp-1"}
      },
      "expect": {"result":"invalid","error":{"kind":"rejected","reason":"invalid-request"}}
    },
    {
      "id": "messages.requests.start-operation-too-long",
      "operation": "read-request",
      "input": {
        "encoding": "json",
        "value": {
          "kind": "start",
          "route": "notes",
          "member": "slowImport",
          "operation": "ooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooo",
          "contract": "Tests.Notes:fp-1"
        }
      },
      "expect": {"result":"invalid","error":{"kind":"rejected","reason":"invalid-request"}}
    },
    {
      "id": "messages.requests.stream-without-cursor",
      "operation": "read-request",
      "input": {
        "encoding": "json",
        "value": {"kind":"stream","route":"notes","member":"slowImport","operation":"op-1","contract":"Tests.Notes:fp-1"}
      },
      "expect": {"result":"invalid","error":{"kind":"rejected","reason":"invalid-request"}}
    },
    {
      "id": "messages.requests.open-with-handlers",
      "operation": "read-request",
      "input": {
        "encoding": "json",
        "value": {"kind":"open","route":"notes","presentation":"p-1","handlers":[{"name":"confirm","contract":"c-1"}]}
      },
      "expect": {"result":"valid"}
    },
    {
      "id": "messages.requests.open-handlers-not-array",
      "operation": "read-request",
      "input": {"encoding":"json","value":{"kind":"open","route":"notes","presentation":"p-1","handlers":{"name":"confirm"}}},
      "expect": {"result":"invalid","error":{"kind":"rejected","reason":"invalid-request"}}
    },
    {
      "id": "messages.requests.write-without-expected-value",
      "operation": "read-request",
      "input": {
        "encoding": "json",
        "value": {"kind":"write","route":"notes","member":"note","requestId":"w-1","expectedVersion":0,"value":"x"}
      },
      "expect": {"result":"invalid","error":{"kind":"rejected","reason":"invalid-request"}}
    },
    {
      "id": "messages.requests.interaction-reply-answered",
      "operation": "read-request",
      "input": {
        "encoding": "json",
        "value": {
          "kind": "interaction-reply",
          "route": "notes",
          "presentation": "p-1",
          "requestId": "r-1",
          "ownerEpoch": 1,
          "name": "confirm",
          "contract": "c-1",
          "outcome": "answered",
          "output": {"accepted":true}
        }
      },
      "expect": {"result":"valid"}
    },
    {
      "id": "messages.requests.interaction-reply-answered-without-output",
      "operation": "read-request",
      "input": {
        "encoding": "json",
        "value": {
          "kind": "interaction-reply",
          "route": "notes",
          "presentation": "p-1",
          "requestId": "r-1",
          "ownerEpoch": 1,
          "name": "confirm",
          "contract": "c-1",
          "outcome": "answered"
        }
      },
      "expect": {"result":"invalid","error":{"kind":"rejected","reason":"invalid-request"}}
    },
    {
      "id": "messages.requests.interaction-reply-cancelled",
      "operation": "read-request",
      "input": {
        "encoding": "json",
        "value": {
          "kind": "interaction-reply",
          "route": "notes",
          "presentation": "p-1",
          "requestId": "r-1",
          "ownerEpoch": 1,
          "name": "confirm",
          "contract": "c-1",
          "outcome": "cancelled"
        }
      },
      "expect": {"result":"valid"}
    },
    {
      "id": "messages.requests.interaction-reply-unknown-outcome",
      "operation": "read-request",
      "input": {
        "encoding": "json",
        "value": {
          "kind": "interaction-reply",
          "route": "notes",
          "presentation": "p-1",
          "requestId": "r-1",
          "ownerEpoch": 1,
          "name": "confirm",
          "contract": "c-1",
          "outcome": "ignored"
        }
      },
      "expect": {"result":"invalid","error":{"kind":"rejected","reason":"invalid-request"}}
    },
    {
      "id": "messages.requests.receive",
      "operation": "read-request",
      "input": {"encoding":"json","value":{"kind":"receive"}},
      "expect": {"result":"valid"}
    },
    {
      "id": "messages.requests.hello-with-features",
      "description": "Features the producer does not implement are ignored.",
      "operation": "read-request",
      "input": {"encoding":"json","value":{"kind":"hello","protocol":4,"session":"s-1","client":{"name":"test-client","version":"1.0.0"},"features":["text-splice/1","unknown-feature/2"]}},
      "expect": {"result":"valid"}
    },
    {
      "id": "messages.requests.hello-with-features-that-are-not-an-array",
      "operation": "read-request",
      "input": {"encoding":"json","value":{"kind":"hello","protocol":4,"session":"s-1","client":{"name":"test-client","version":"1.0.0"},"features":"text-splice/1"}},
      "expect": {"result":"invalid","error":{"kind":"rejected","reason":"invalid-request"}}
    },
    {
      "id": "messages.requests.hello-with-a-feature-that-is-not-a-string",
      "operation": "read-request",
      "input": {"encoding":"json","value":{"kind":"hello","protocol":4,"session":"s-1","client":{"name":"test-client","version":"1.0.0"},"features":[1]}},
      "expect": {"result":"invalid","error":{"kind":"rejected","reason":"invalid-request"}}
    },
    {
      "id": "messages.requests.set-with-a-splice-against-an-edit",
      "operation": "read-request",
      "input": {"encoding":"json","value":{"kind":"set","route":"notes","member":"title","edit":8,"splice":{"baseEdit":7,"length":100,"index":5,"delete":0,"text":"x"}}},
      "expect": {"result":"valid"}
    },
    {
      "id": "messages.requests.set-with-a-splice-against-a-revision",
      "operation": "read-request",
      "input": {"encoding":"json","value":{"kind":"set","route":"notes","member":"title","edit":1,"splice":{"baseRevision":0,"length":100,"index":0,"delete":100,"text":""}}},
      "expect": {"result":"valid"}
    },
    {
      "id": "messages.requests.set-with-a-value-and-a-splice",
      "operation": "read-request",
      "input": {"encoding":"json","value":{"kind":"set","route":"notes","member":"title","value":"x","edit":1,"splice":{"baseRevision":0,"length":0,"index":0,"delete":0,"text":"x"}}},
      "expect": {"result":"invalid","error":{"kind":"rejected","reason":"invalid-request"}}
    },
    {
      "id": "messages.requests.set-with-a-splice-with-two-bases",
      "operation": "read-request",
      "input": {"encoding":"json","value":{"kind":"set","route":"notes","member":"title","edit":2,"splice":{"baseEdit":1,"baseRevision":0,"length":0,"index":0,"delete":0,"text":"x"}}},
      "expect": {"result":"invalid","error":{"kind":"rejected","reason":"invalid-request"}}
    },
    {
      "id": "messages.requests.set-with-a-splice-without-a-base",
      "operation": "read-request",
      "input": {"encoding":"json","value":{"kind":"set","route":"notes","member":"title","edit":2,"splice":{"length":0,"index":0,"delete":0,"text":"x"}}},
      "expect": {"result":"invalid","error":{"kind":"rejected","reason":"invalid-request"}}
    },
    {
      "id": "messages.requests.set-with-a-negative-splice-index",
      "operation": "read-request",
      "input": {"encoding":"json","value":{"kind":"set","route":"notes","member":"title","edit":2,"splice":{"baseRevision":0,"length":5,"index":-1,"delete":0,"text":"x"}}},
      "expect": {"result":"invalid","error":{"kind":"rejected","reason":"invalid-request"}}
    },
    {
      "id": "messages.requests.write-with-a-splice",
      "description": "A checked write of a text member may carry a splice of the field's value at expectedVersion.",
      "operation": "read-request",
      "input": {"encoding":"json","value":{"kind":"write","route":"notes","member":"note","requestId":"w-1","expectedVersion":7,"splice":{"length":100,"index":5,"delete":0,"text":"x"}}},
      "expect": {"result":"valid"}
    },
    {
      "id": "messages.requests.write-with-a-value-and-a-splice",
      "operation": "read-request",
      "input": {"encoding":"json","value":{"kind":"write","route":"notes","member":"note","requestId":"w-1","expectedVersion":7,"value":"x","splice":{"length":100,"index":5,"delete":0,"text":"x"}}},
      "expect": {"result":"invalid","error":{"kind":"rejected","reason":"invalid-request"}}
    },
    {
      "id": "messages.requests.write-with-an-expected-value-and-a-splice",
      "operation": "read-request",
      "input": {"encoding":"json","value":{"kind":"write","route":"notes","member":"note","requestId":"w-1","expectedVersion":7,"expectedValue":"","splice":{"length":100,"index":5,"delete":0,"text":"x"}}},
      "expect": {"result":"invalid","error":{"kind":"rejected","reason":"invalid-request"}}
    },
    {
      "id": "messages.requests.write-with-a-splice-with-a-base",
      "operation": "read-request",
      "input": {"encoding":"json","value":{"kind":"write","route":"notes","member":"note","requestId":"w-1","expectedVersion":7,"splice":{"baseRevision":3,"length":100,"index":5,"delete":0,"text":"x"}}},
      "expect": {"result":"invalid","error":{"kind":"rejected","reason":"invalid-request"}}
    },
    {
      "id": "messages.requests.write-with-a-splice-that-is-not-an-object",
      "operation": "read-request",
      "input": {"encoding":"json","value":{"kind":"write","route":"notes","member":"note","requestId":"w-1","expectedVersion":7,"splice":"x"}},
      "expect": {"result":"invalid","error":{"kind":"rejected","reason":"invalid-request"}}
    },
    {
      "id": "messages.requests.write-with-a-splice-without-text",
      "operation": "read-request",
      "input": {"encoding":"json","value":{"kind":"write","route":"notes","member":"note","requestId":"w-1","expectedVersion":7,"splice":{"length":100,"index":5,"delete":0}}},
      "expect": {"result":"invalid","error":{"kind":"rejected","reason":"invalid-request"}}
    },
    {
      "id": "messages.requests.write-with-a-negative-splice-delete",
      "operation": "read-request",
      "input": {"encoding":"json","value":{"kind":"write","route":"notes","member":"note","requestId":"w-1","expectedVersion":7,"splice":{"length":100,"index":5,"delete":-1,"text":"x"}}},
      "expect": {"result":"invalid","error":{"kind":"rejected","reason":"invalid-request"}}
    },
    {
      "id": "messages.requests.command-with-an-epoch",
      "description": "presentation-epoch/1: a scoped command carries the epoch of the state it was issued on.",
      "operation": "read-request",
      "input": {"encoding":"json","value":{"kind":"command","route":"wizard","member":"next","epoch":40}},
      "expect": {"result":"valid"}
    },
    {
      "id": "messages.requests.command-with-a-negative-epoch",
      "operation": "read-request",
      "input": {"encoding":"json","value":{"kind":"command","route":"wizard","member":"next","epoch":-1}},
      "expect": {"result":"invalid","error":{"kind":"rejected","reason":"invalid-request"}}
    },
    {
      "id": "messages.requests.command-with-an-epoch-that-is-not-a-number",
      "operation": "read-request",
      "input": {"encoding":"json","value":{"kind":"command","route":"wizard","member":"next","epoch":"40"}},
      "expect": {"result":"invalid","error":{"kind":"rejected","reason":"invalid-request"}}
    },
    {
      "id": "messages.requests.presented",
      "description": "presented/1: the page painted the route at the revision.",
      "operation": "read-request",
      "input": {"encoding":"json","value":{"kind":"presented","route":"result","revision":57}},
      "expect": {"result":"valid"}
    },
    {
      "id": "messages.requests.presented-with-a-negative-revision",
      "operation": "read-request",
      "input": {"encoding":"json","value":{"kind":"presented","route":"result","revision":-1}},
      "expect": {"result":"invalid","error":{"kind":"rejected","reason":"invalid-request"}}
    },
    {
      "id": "messages.requests.presented-without-a-route",
      "operation": "read-request",
      "input": {"encoding":"json","value":{"kind":"presented","revision":57}},
      "expect": {"result":"invalid","error":{"kind":"rejected","reason":"invalid-request"}}
    },
    {
      "id": "messages.requests.closing-reply",
      "description": "presented/1: the page acknowledges a window close.",
      "operation": "read-request",
      "input": {"encoding":"json","value":{"kind":"closing-reply"}},
      "expect": {"result":"valid"}
    }
  ]
}
