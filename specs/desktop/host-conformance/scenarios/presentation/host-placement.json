{
  "format": "runic.host.scenario/1",
  "id": "presentation.host-placement.v1",
  "contract": {"id":"runic-host","version":1},
  "set": "presentation",
  "roles": ["host"],
  "description": "A host whose windows can be placed lists maximize and placement, starts the guest's placement in the window-open reply, lets its policy refuse maximize and clamp set-placement, pushes placement with the restored bounds, and rejects a set-placement out of form with invalid-request.",
  "ids": {
    "c1": {"kind":"connection"},
    "hello": {"kind":"request"},
    "open-w1": {"kind":"request"},
    "m1": {"kind":"request"},
    "s1": {"kind":"request"},
    "s2": {"kind":"request"},
    "r1": {"kind":"request"},
    "bad1": {"kind":"request"},
    "bad2": {"kind":"request"},
    "bad3": {"kind":"request"}
  },
  "arrange": {"limits":{"startTimeout":2000,"stopTimeout":2000,"unauthenticatedTimeout":1000,"presentRate":20},"host":{"name":"Conformance Host","version":"1.0.0","policy":"limits-placement","windowPlacement":true}},
  "steps": [
    {"start":{"host":true}},
    {"offer":{"protocols":[1],"nonce":{"$secret":"nonce"},"host":{"name":"Conformance Host","version":"1.0.0"}}},
    {"line":{"channel":{"url":{"$any":"string"},"key":{"$any":"string"},"protocol":1}}},
    {"accept":"c1"},
    {"receive":{"id":{"$id":"hello"},"kind":"hello","protocol":1,"key":{"$secret":"key"},"proof":{"$secret":"host-proof"},"host":{"name":"Conformance Host","version":"1.0.0"},"features":{"$any":"array"},"locale":{"$any":["string","null"]},"languages":{"$any":"array"},"appearance":{"$any":["object","null"]}},"connection":"c1"},
    {"send":{"id":{"$id":"hello"},"ok":true,"protocol":1,"proof":{"$secret":"guest-proof"},"guest":{"name":"Conformance Guest","version":"1.0.0","applicationId":"dev.runic.conformance-guest"},"features":[]},"connection":"c1"},
    {"expect":{"started":true}},
    {"send":{"id":{"$id":"open-w1"},"kind":"window-open","window":"w1","type":"Conformance.Main","url":"http://127.0.0.1:38211/_runic_launch/AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA","owner":null,"modality":"none","guardClose":false,"permissions":[]},"connection":"c1"},
    {"receive":{"id":{"$id":"open-w1"},"ok":true,"features":["present","minimize","visibility","full-screen","maximize","placement"],"activity":{"$any":"object"},"colorScheme":{"$any":"string"},"placement":{"restored":{"x":100,"y":100,"width":800,"height":600},"maximized":false,"fullScreen":false}},"connection":"c1","note":"The reply's placement starts the guest's Placement."},
    {"send":{"id":{"$id":"m1"},"kind":"maximize","window":"w1"},"connection":"c1"},
    {"receive":{"id":{"$id":"m1"},"ok":false,"error":{"kind":"rejected","reason":"refused","message":"The host keeps its windows unmaximized."}},"connection":"c1","note":"The host's policy refuses maximize."},
    {"send":{"id":{"$id":"s1"},"kind":"set-placement","window":"w1","x":50,"y":60,"width":1600,"height":1000,"maximized":false,"fullScreen":false},"connection":"c1"},
    {"receive":{"id":{"$id":"s1"},"ok":true,"outcome":"success"},"connection":"c1","note":"The policy clamps the size to 1,200 by 900 and the host applies it."},
    {"receive":{"kind":"placement","window":"w1","bounds":{"x":50,"y":60,"width":1200,"height":900},"maximized":false,"fullScreen":false,"monitor":null,"restored":{"x":50,"y":60,"width":1200,"height":900}},"connection":"c1"},
    {"send":{"id":{"$id":"s2"},"kind":"set-placement","window":"w1","width":0,"height":0,"maximized":true,"fullScreen":false},"connection":"c1","note":"Without a position, keeping the size: the window maximizes and keeps its restored bounds."},
    {"receive":{"id":{"$id":"s2"},"ok":true,"outcome":"success"},"connection":"c1"},
    {"receive":{"kind":"placement","window":"w1","bounds":{"x":0,"y":0,"width":1920,"height":1040},"maximized":true,"fullScreen":false,"monitor":null,"restored":{"x":50,"y":60,"width":1200,"height":900}},"connection":"c1"},
    {"send":{"id":{"$id":"r1"},"kind":"restore","window":"w1"},"connection":"c1"},
    {"receive":{"id":{"$id":"r1"},"ok":true,"outcome":"success"},"connection":"c1"},
    {"receive":{"kind":"placement","window":"w1","bounds":{"x":50,"y":60,"width":1200,"height":900},"maximized":false,"fullScreen":false,"monitor":null,"restored":{"x":50,"y":60,"width":1200,"height":900}},"connection":"c1"},
    {"send":{"id":{"$id":"bad1"},"kind":"set-placement","window":"w1","x":50,"width":800,"height":600,"maximized":false,"fullScreen":false},"connection":"c1"},
    {"receive":{"id":{"$id":"bad1"},"ok":false,"error":{"kind":"rejected","reason":"invalid-request","message":{"$any":"string"}}},"connection":"c1","note":"x without y."},
    {"send":{"id":{"$id":"bad2"},"kind":"set-placement","window":"w1","width":-1,"height":600,"maximized":false,"fullScreen":false},"connection":"c1"},
    {"receive":{"id":{"$id":"bad2"},"ok":false,"error":{"kind":"rejected","reason":"invalid-request","message":{"$any":"string"}}},"connection":"c1","note":"A width out of range."},
    {"send":{"id":{"$id":"bad3"},"kind":"set-placement","window":"w1","width":800,"height":600,"maximized":false},"connection":"c1"},
    {"receive":{"id":{"$id":"bad3"},"ok":false,"error":{"kind":"rejected","reason":"invalid-request","message":{"$any":"string"}}},"connection":"c1","note":"fullScreen is missing."}
  ]
}
