{
  "format": "runic.host.scenario/1",
  "id": "presentation.placement.v1",
  "contract": {"id":"runic-host","version":1},
  "set": "presentation",
  "roles": ["guest"],
  "description": "maximize, restore and set-placement carry their members, a policy's refusal fails with permission-denied, and the Window's placement follows the window-open reply's placement and the placement push: restored when the host sends it, else the current frame.",
  "ids": {
    "c1": {"kind":"connection"},
    "hello": {"kind":"request"},
    "w1": {"kind":"window"},
    "open-w1": {"kind":"request"},
    "open-w1-action": {"kind":"action"},
    "pl0": {"kind":"action"},
    "p1": {"kind":"action"},
    "p1-request": {"kind":"request"},
    "p2": {"kind":"action"},
    "p2-request": {"kind":"request"},
    "p3": {"kind":"action"},
    "p3-request": {"kind":"request"},
    "p4": {"kind":"action"},
    "p4-request": {"kind":"request"},
    "pl1": {"kind":"action"},
    "pl2": {"kind":"action"}
  },
  "arrange": {"limits":{"startTimeout":2000,"stopTimeout":2000,"unauthenticatedTimeout":1000},"application":{"name":"Conformance Guest","version":"1.0.0","applicationId":"dev.runic.conformance-guest"}},
  "steps": [
    {"start":{"offer":{"protocols":[1],"nonce":{"$secret":"nonce"},"host":{"name":"Conformance Host","version":"1.0.0"}}}},
    {"line":{"channel":{"url":{"$any":"string"},"key":{"$any":"string"},"protocol":1}}},
    {"connect":"c1"},
    {"send":{"id":{"$id":"hello"},"kind":"hello","protocol":1,"key":{"$secret":"key"},"proof":{"$secret":"host-proof"},"host":{"name":"Conformance Host","version":"1.0.0"},"features":[],"locale":null,"languages":[],"appearance":null},"connection":"c1"},
    {"receive":{"id":{"$id":"hello"},"ok":true,"protocol":1,"proof":{"$secret":"guest-proof"},"guest":{"name":"Conformance Guest","version":"1.0.0","applicationId":"dev.runic.conformance-guest"},"features":{"$any":"array","default":[]}},"connection":"c1"},
    {"guest":{"action":"open","window":"w1","type":"Main"},"as":"open-w1-action"},
    {"receive":{"id":{"$id":"open-w1"},"kind":"window-open","window":{"$id":"w1"},"type":{"$any":"string","default":"Conformance.Main"},"url":{"$secret":"launch-url"},"width":{"$any":"integer","default":800},"height":{"$any":"integer","default":600},"owner":null,"modality":"none","guardClose":false,"permissions":[]},"connection":"c1"},
    {"send":{"id":{"$id":"open-w1"},"ok":true,"features":["present","minimize","visibility","full-screen","document-edited","color-scheme","activity","owned-windows","maximize","placement"],"activity":{"active":true,"minimized":false,"visible":true},"colorScheme":"no-preference","placement":{"restored":{"x":10,"y":20,"width":800,"height":600},"maximized":false,"fullScreen":false}},"connection":"c1"},
    {"expect":{"action":"open-w1-action","opened":true}},
    {"guest":{"action":"placement","window":"w1"},"as":"pl0"},
    {"expect":{"action":"pl0","placement":{"x":10,"y":20,"width":800,"height":600,"maximized":false,"fullScreen":false}}},
    {"guest":{"action":"maximize","window":"w1"},"as":"p1"},
    {"receive":{"id":{"$id":"p1-request"},"kind":"maximize","window":{"$id":"w1"}},"connection":"c1"},
    {"send":{"id":{"$id":"p1-request"},"ok":true,"outcome":"success"},"connection":"c1"},
    {"expect":{"action":"p1","outcome":{"success":{}}}},
    {"guest":{"action":"restore","window":"w1"},"as":"p2"},
    {"receive":{"id":{"$id":"p2-request"},"kind":"restore","window":{"$id":"w1"}},"connection":"c1"},
    {"send":{"id":{"$id":"p2-request"},"ok":true,"outcome":"success"},"connection":"c1"},
    {"expect":{"action":"p2","outcome":{"success":{}}}},
    {"guest":{"action":"setPlacement","window":"w1","value":{"x":-1920,"y":40,"width":1280,"height":720,"maximized":true,"fullScreen":false}},"as":"p3"},
    {"receive":{"id":{"$id":"p3-request"},"kind":"set-placement","window":{"$id":"w1"},"x":-1920,"y":40,"width":1280,"height":720,"maximized":true,"fullScreen":false},"connection":"c1"},
    {"send":{"id":{"$id":"p3-request"},"ok":false,"error":{"kind":"rejected","reason":"refused","message":"The host keeps its windows on its own monitor."}},"connection":"c1"},
    {"expect":{"action":"p3","outcome":{"failed":"permission-denied"}}},
    {"guest":{"action":"setPlacement","window":"w1","value":{"width":1024,"height":0,"maximized":false,"fullScreen":false}},"as":"p4","note":"Without a position, as on Wayland; a height of 0 keeps it."},
    {"receive":{"id":{"$id":"p4-request"},"kind":"set-placement","window":{"$id":"w1"},"width":1024,"height":0,"maximized":false,"fullScreen":false},"connection":"c1"},
    {"send":{"id":{"$id":"p4-request"},"ok":true,"outcome":"success"},"connection":"c1"},
    {"expect":{"action":"p4","outcome":{"success":{}}}},
    {"send":{"kind":"placement","window":{"$id":"w1"},"bounds":{"x":0,"y":0,"width":1920,"height":1040},"maximized":true,"fullScreen":false,"monitor":null,"restored":{"x":10,"y":20,"width":1024,"height":600}},"connection":"c1","note":"Maximized: the current frame fills the monitor, and restored keeps the bounds it returns to."},
    {"guest":{"action":"placement","window":"w1"},"as":"pl1"},
    {"expect":{"action":"pl1","placement":{"x":10,"y":20,"width":1024,"height":600,"maximized":true,"fullScreen":false}}},
    {"send":{"kind":"placement","window":{"$id":"w1"},"bounds":{"x":30,"y":40,"width":640,"height":480},"maximized":false,"fullScreen":false,"monitor":null},"connection":"c1","note":"A host without restored: the current frame."},
    {"guest":{"action":"placement","window":"w1"},"as":"pl2"},
    {"expect":{"action":"pl2","placement":{"x":30,"y":40,"width":640,"height":480,"maximized":false,"fullScreen":false}}}
  ]
}
