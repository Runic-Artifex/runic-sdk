{
  "format": "runic.host.scenario/1",
  "id": "menus.host-superseded-bar.v1",
  "contract": {"id":"runic-host","version":1},
  "set": "menus",
  "roles": ["host"],
  "description": "A choice or shortcut of the bar the window showed before the guest's latest bar carries an id of that bar: the host pushes menu-invoke only for an id the latest bar has, which names the same item, and drops any other, so a click during a change runs the item the user chose or nothing.",
  "requires": ["menus/1"],
  "ids": {
    "c1": {"kind":"connection"},
    "hello": {"kind":"request"},
    "open-w1": {"kind":"request"},
    "bar-1": {"kind":"request"},
    "bar-2": {"kind":"request"}
  },
  "arrange": {"limits":{"startTimeout":2000,"stopTimeout":2000,"unauthenticatedTimeout":1000},"host":{"name":"Conformance Host","version":"1.0.0"}},
  "steps": [
    {"start":{"host":true}},
    {"offer":{"protocols":[1],"nonce":{"$secret":"nonce"},"host":{"name":"Conformance Host","version":"1.0.0"}}},
    {"line":{"channel":{"url":{"$any":"string"},"key":{"$any":"string"},"protocol":1}}},
    {"accept":"c1"},
    {"receive":{"id":{"$id":"hello"},"kind":"hello","protocol":1,"key":{"$secret":"key"},"proof":{"$secret":"host-proof"},"host":{"name":"Conformance Host","version":"1.0.0"},"features":{"$any":"array"},"locale":{"$any":["string","null"]},"languages":{"$any":"array"},"appearance":{"$any":["object","null"]}},"connection":"c1"},
    {"send":{"id":{"$id":"hello"},"ok":true,"protocol":1,"proof":{"$secret":"guest-proof"},"guest":{"name":"Conformance Guest","version":"1.0.0","applicationId":"dev.runic.conformance-guest"},"features":["menus/1","dialogs/1"]},"connection":"c1"},
    {"expect":{"started":true}},
    {"send":{"id":{"$id":"open-w1"},"kind":"window-open","window":"w1","type":"Conformance.Main","url":"http://127.0.0.1:38211/_runic_launch/AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA","owner":null,"modality":"none","guardClose":false,"permissions":[]},"connection":"c1"},
    {"receive":{"id":{"$id":"open-w1"},"ok":true,"features":{"$any":"array"},"activity":{"$any":"object"},"colorScheme":{"$any":"string"}},"connection":"c1"},
    {"send":{"id":{"$id":"bar-1"},"kind":"set-menu-bar","window":"w1","menu":[{"kind":"submenu","title":"File","role":"file","enabled":true,"items":[{"kind":"item","id":"i1","title":"Open","shortcut":"Primary+O","enabled":true,"checked":null},{"kind":"item","id":"i2","title":"Save","shortcut":"Primary+S","enabled":true,"checked":null},{"kind":"separator"},{"kind":"submenu","title":"Recent","role":null,"enabled":true,"items":[{"kind":"item","id":"i3","title":"notes.txt","shortcut":null,"enabled":true,"checked":null}]}]},{"kind":"submenu","title":"View","role":null,"enabled":true,"items":[{"kind":"item","id":"i4","title":"Grid","shortcut":null,"enabled":true,"checked":false}]}]},"connection":"c1"},
    {"receive":{"id":{"$id":"bar-1"},"ok":true,"outcome":"success"},"connection":"c1"},
    {"send":{"id":{"$id":"bar-2"},"kind":"set-menu-bar","window":"w1","menu":[{"kind":"submenu","title":"File","role":"file","enabled":true,"items":[{"kind":"item","id":"i1","title":"Open","shortcut":"Primary+O","enabled":true,"checked":null},{"kind":"item","id":"i5","title":"Save As…","shortcut":"Primary+Shift+S","enabled":true,"checked":null},{"kind":"separator"},{"kind":"submenu","title":"Recent","role":null,"enabled":true,"items":[{"kind":"item","id":"i6","title":"notes.txt","shortcut":null,"enabled":true,"checked":null},{"kind":"item","id":"i7","title":"todo.txt","shortcut":null,"enabled":true,"checked":null}]}]},{"kind":"submenu","title":"View","role":null,"enabled":true,"items":[{"kind":"item","id":"i8","title":"Grid","shortcut":null,"enabled":true,"checked":false}]}]},"connection":"c1","note":"The guest's recent list grew: Open keeps its id i1, every other item has a new one, and i2 to i4 name no item any more."},
    {"receive":{"id":{"$id":"bar-2"},"ok":true,"outcome":"success"},"connection":"c1"},
    {"expect":{"window":"w1","menuBar":[{"kind":"submenu","title":"File","role":"file","enabled":true,"items":[{"kind":"item","title":"Open","shortcut":"Primary+O","enabled":true,"checked":null},{"kind":"item","title":"Save As…","shortcut":"Primary+Shift+S","enabled":true,"checked":null},{"kind":"separator"},{"kind":"submenu","title":"Recent","role":null,"enabled":true,"items":[{"kind":"item","title":"notes.txt","shortcut":null,"enabled":true,"checked":null},{"kind":"item","title":"todo.txt","shortcut":null,"enabled":true,"checked":null}]}]},{"kind":"submenu","title":"View","role":null,"enabled":true,"items":[{"kind":"item","title":"Grid","shortcut":null,"enabled":true,"checked":false}]}]}},
    {"user":{"action":"chooseMenuItem","window":"w1","titles":["File","Save"],"bar":"previous"},"note":"A click on the bar the window showed before bar-2 arrived: i2 is not in the window's bar, so the host pushes nothing."},
    {"user":{"action":"chooseMenuItem","window":"w1","titles":["File","Open"],"bar":"previous"},"note":"i1 names the same item in both bars."},
    {"receive":{"kind":"menu-invoke","window":"w1","itemId":"i1"},"connection":"c1"},
    {"user":{"action":"chooseMenuItem","window":"w1","titles":["File","Recent","todo.txt"]}},
    {"receive":{"kind":"menu-invoke","window":"w1","itemId":"i7"},"connection":"c1"}
  ]
}
