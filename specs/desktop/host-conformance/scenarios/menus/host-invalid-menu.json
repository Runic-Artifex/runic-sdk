{
  "format": "runic.host.scenario/1",
  "id": "menus.host-invalid-menu.v1",
  "contract": {"id":"runic-host","version":1},
  "set": "menus",
  "roles": ["host"],
  "description": "Menu entries that break the rules of menus/1 (an item on the bar's top level, a duplicate item id, a blank title, an empty context menu) are rejected with invalid-request; a menu bar deeper than 8 levels and a context menu deeper than 5 are rejected with capacity.",
  "requires": ["menus/1"],
  "ids": {
    "c1": {"kind":"connection"},
    "hello": {"kind":"request"},
    "open-w1": {"kind":"request"},
    "bad-1": {"kind":"request"},
    "bad-2": {"kind":"request"},
    "bad-3": {"kind":"request"},
    "bad-4": {"kind":"request"},
    "deep-bar": {"kind":"request"},
    "deep-context": {"kind":"request"}
  },
  "arrange": {"limits":{"startTimeout":2000,"stopTimeout":2000,"unauthenticatedTimeout":1000},"host":{"name":"Conformance Host","version":"1.0.0"}},
  "steps": [
    {"start":{"host":true}},
    {"offer":{"protocols":[1],"nonce":{"$secret":"nonce"},"host":{"name":"Conformance Host","version":"1.0.0"}}},
    {"line":{"channel":{"url":{"$any":"string"},"key":{"$any":"string"},"protocol":1}}},
    {"accept":"c1"},
    {"receive":{"id":{"$id":"hello"},"kind":"hello","protocol":1,"key":{"$secret":"key"},"proof":{"$secret":"host-proof"},"host":{"name":"Conformance Host","version":"1.0.0"},"features":{"$any":"array"},"locale":{"$any":["string","null"]},"languages":{"$any":"array"},"appearance":{"$any":["object","null"]}},"connection":"c1"},
    {"send":{"id":{"$id":"hello"},"ok":true,"protocol":1,"proof":{"$secret":"guest-proof"},"guest":{"name":"Conformance Guest","version":"1.0.0","applicationId":"dev.runic.conformance-guest"},"features":["menus/1","dialogs/1"]},"connection":"c1"},
    {"expect":{"started":true}},
    {"send":{"id":{"$id":"open-w1"},"kind":"window-open","window":"w1","type":"Conformance.Main","url":"http://127.0.0.1:38211/_runic_launch/AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA","owner":null,"modality":"none","guardClose":false,"permissions":[]},"connection":"c1"},
    {"receive":{"id":{"$id":"open-w1"},"ok":true,"features":{"$any":"array"},"activity":{"$any":"object"},"colorScheme":{"$any":"string"}},"connection":"c1"},
    {"send":{"id":{"$id":"bad-1"},"kind":"set-menu-bar","window":"w1","menu":[{"kind":"item","id":"i1","title":"Open","shortcut":null,"enabled":true,"checked":null}]},"connection":"c1","note":"An item on the bar's top level."},
    {"receive":{"id":{"$id":"bad-1"},"ok":false,"error":{"kind":"rejected","reason":"invalid-request","message":{"$any":"string"}}},"connection":"c1"},
    {"send":{"id":{"$id":"bad-2"},"kind":"set-menu-bar","window":"w1","menu":[{"kind":"submenu","title":"File","role":null,"enabled":true,"items":[{"kind":"item","id":"i1","title":"Open","shortcut":null,"enabled":true,"checked":null},{"kind":"item","id":"i1","title":"Save","shortcut":null,"enabled":true,"checked":null}]}]},"connection":"c1","note":"Two items with the id i1."},
    {"receive":{"id":{"$id":"bad-2"},"ok":false,"error":{"kind":"rejected","reason":"invalid-request","message":{"$any":"string"}}},"connection":"c1"},
    {"send":{"id":{"$id":"bad-3"},"kind":"set-menu-bar","window":"w1","menu":[{"kind":"submenu","title":"File","role":null,"enabled":true,"items":[{"kind":"item","id":"i1","title":" ","shortcut":null,"enabled":true,"checked":null}]}]},"connection":"c1","note":"A blank title."},
    {"receive":{"id":{"$id":"bad-3"},"ok":false,"error":{"kind":"rejected","reason":"invalid-request","message":{"$any":"string"}}},"connection":"c1"},
    {"send":{"id":{"$id":"bad-4"},"kind":"show-context-menu","window":"w1","menu":[],"point":null},"connection":"c1","note":"A context menu without entries."},
    {"receive":{"id":{"$id":"bad-4"},"ok":false,"error":{"kind":"rejected","reason":"invalid-request","message":{"$any":"string"}}},"connection":"c1"},
    {"send":{"id":{"$id":"deep-bar"},"kind":"set-menu-bar","window":"w1","menu":[{"kind":"submenu","title":"Level 1","role":null,"enabled":true,"items":[{"kind":"submenu","title":"Level 2","role":null,"enabled":true,"items":[{"kind":"submenu","title":"Level 3","role":null,"enabled":true,"items":[{"kind":"submenu","title":"Level 4","role":null,"enabled":true,"items":[{"kind":"submenu","title":"Level 5","role":null,"enabled":true,"items":[{"kind":"submenu","title":"Level 6","role":null,"enabled":true,"items":[{"kind":"submenu","title":"Level 7","role":null,"enabled":true,"items":[{"kind":"submenu","title":"Level 8","role":null,"enabled":true,"items":[{"kind":"item","id":"i1","title":"Leaf","shortcut":null,"enabled":true,"checked":null}]}]}]}]}]}]}]}]}]},"connection":"c1","note":"Nine levels of entry arrays; a bar has at most eight."},
    {"receive":{"id":{"$id":"deep-bar"},"ok":false,"error":{"kind":"rejected","reason":"capacity","message":{"$any":"string"}}},"connection":"c1"},
    {"send":{"id":{"$id":"deep-context"},"kind":"show-context-menu","window":"w1","menu":[{"kind":"submenu","title":"Level 1","role":null,"enabled":true,"items":[{"kind":"submenu","title":"Level 2","role":null,"enabled":true,"items":[{"kind":"submenu","title":"Level 3","role":null,"enabled":true,"items":[{"kind":"submenu","title":"Level 4","role":null,"enabled":true,"items":[{"kind":"submenu","title":"Level 5","role":null,"enabled":true,"items":[{"kind":"item","id":"i1","title":"Leaf","shortcut":null,"enabled":true,"checked":null}]}]}]}]}]}],"point":null},"connection":"c1","note":"Six levels of entry arrays; a context menu has at most five."},
    {"receive":{"id":{"$id":"deep-context"},"ok":false,"error":{"kind":"rejected","reason":"capacity","message":{"$any":"string"}}},"connection":"c1"}
  ]
}
