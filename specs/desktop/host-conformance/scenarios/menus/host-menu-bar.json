{
  "format": "runic.host.scenario/1",
  "id": "menus.host-menu-bar.v1",
  "contract": {"id":"runic-host","version":1},
  "set": "menus",
  "roles": ["host"],
  "description": "The host's hello lists menus/1 and dialogs/1. A set-menu-bar shows the guest's menus as the window's native menu bar and is answered success; choosing an item pushes menu-invoke with its id; update-menu-items changes an item's enabled state and ignores an id that names no item.",
  "requires": ["menus/1"],
  "ids": {
    "c1": {"kind":"connection"},
    "hello": {"kind":"request"},
    "open-w1": {"kind":"request"},
    "bar-1": {"kind":"request"},
    "update-1": {"kind":"request"},
    "update-2": {"kind":"request"}
  },
  "arrange": {"limits":{"startTimeout":2000,"stopTimeout":2000,"unauthenticatedTimeout":1000},"host":{"name":"Conformance Host","version":"1.0.0"}},
  "steps": [
    {"start":{"host":true}},
    {"offer":{"protocols":[1],"nonce":{"$secret":"nonce"},"host":{"name":"Conformance Host","version":"1.0.0"}}},
    {"line":{"channel":{"url":{"$any":"string"},"key":{"$any":"string"},"protocol":1}}},
    {"accept":"c1"},
    {"receive":{"id":{"$id":"hello"},"kind":"hello","protocol":1,"key":{"$secret":"key"},"proof":{"$secret":"host-proof"},"host":{"name":"Conformance Host","version":"1.0.0"},"features":["menus/1","dialogs/1"],"locale":{"$any":["string","null"]},"languages":{"$any":"array"},"appearance":{"$any":["object","null"]}},"connection":"c1"},
    {"send":{"id":{"$id":"hello"},"ok":true,"protocol":1,"proof":{"$secret":"guest-proof"},"guest":{"name":"Conformance Guest","version":"1.0.0","applicationId":"dev.runic.conformance-guest"},"features":["menus/1","dialogs/1"]},"connection":"c1"},
    {"expect":{"started":true}},
    {"send":{"id":{"$id":"open-w1"},"kind":"window-open","window":"w1","type":"Conformance.Main","url":"http://127.0.0.1:38211/_runic_launch/AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA","owner":null,"modality":"none","guardClose":false,"permissions":[]},"connection":"c1"},
    {"receive":{"id":{"$id":"open-w1"},"ok":true,"features":{"$any":"array"},"activity":{"$any":"object"},"colorScheme":{"$any":"string"}},"connection":"c1"},
    {"send":{"id":{"$id":"bar-1"},"kind":"set-menu-bar","window":"w1","menu":[{"kind":"submenu","title":"File","role":"file","enabled":true,"items":[{"kind":"item","id":"i1","title":"Open","shortcut":"Primary+O","enabled":true,"checked":null},{"kind":"item","id":"i2","title":"Save","shortcut":"Primary+S","enabled":true,"checked":null},{"kind":"separator"},{"kind":"submenu","title":"Recent","role":null,"enabled":true,"items":[{"kind":"item","id":"i3","title":"notes.txt","shortcut":null,"enabled":true,"checked":null}]}]},{"kind":"submenu","title":"View","role":null,"enabled":true,"items":[{"kind":"item","id":"i4","title":"Grid","shortcut":null,"enabled":true,"checked":false}]}]},"connection":"c1"},
    {"receive":{"id":{"$id":"bar-1"},"ok":true,"outcome":"success"},"connection":"c1"},
    {"expect":{"window":"w1","menuBar":[{"kind":"submenu","title":"File","role":"file","enabled":true,"items":[{"kind":"item","title":"Open","shortcut":"Primary+O","enabled":true,"checked":null},{"kind":"item","title":"Save","shortcut":"Primary+S","enabled":true,"checked":null},{"kind":"separator"},{"kind":"submenu","title":"Recent","role":null,"enabled":true,"items":[{"kind":"item","title":"notes.txt","shortcut":null,"enabled":true,"checked":null}]}]},{"kind":"submenu","title":"View","role":null,"enabled":true,"items":[{"kind":"item","title":"Grid","shortcut":null,"enabled":true,"checked":false}]}]}},
    {"user":{"action":"chooseMenuItem","window":"w1","titles":["File","Recent","notes.txt"]}},
    {"receive":{"kind":"menu-invoke","window":"w1","itemId":"i3"},"connection":"c1"},
    {"send":{"id":{"$id":"update-1"},"kind":"update-menu-items","window":"w1","items":[{"id":"i2","enabled":false},{"id":"i9","enabled":false}]},"connection":"c1","note":"i9 names no item of the bar: the host ignores it."},
    {"receive":{"id":{"$id":"update-1"},"ok":true,"outcome":"success"},"connection":"c1"},
    {"expect":{"window":"w1","menuBar":[{"kind":"submenu","title":"File","role":"file","enabled":true,"items":[{"kind":"item","title":"Open","shortcut":"Primary+O","enabled":true,"checked":null},{"kind":"item","title":"Save","shortcut":"Primary+S","enabled":false,"checked":null},{"kind":"separator"},{"kind":"submenu","title":"Recent","role":null,"enabled":true,"items":[{"kind":"item","title":"notes.txt","shortcut":null,"enabled":true,"checked":null}]}]},{"kind":"submenu","title":"View","role":null,"enabled":true,"items":[{"kind":"item","title":"Grid","shortcut":null,"enabled":true,"checked":false}]}]}},
    {"send":{"id":{"$id":"update-2"},"kind":"update-menu-items","window":"w1","items":[{"id":"i2","enabled":true}]},"connection":"c1"},
    {"receive":{"id":{"$id":"update-2"},"ok":true,"outcome":"success"},"connection":"c1"},
    {"user":{"action":"chooseMenuItem","window":"w1","titles":["File","Save"]}},
    {"receive":{"kind":"menu-invoke","window":"w1","itemId":"i2"},"connection":"c1"}
  ]
}
