{
  "format": "runic.host.scenario/1",
  "id": "menus.context-menu.v1",
  "contract": {"id":"runic-host","version":1},
  "set": "menus",
  "roles": ["guest"],
  "description": "A context menu of a hosted Window sends show-context-menu with its entries and point (null for the pointer) and returns the guest's own item that the host's itemId names, or none for null; when the application cancels it, the guest pushes cancel with the request's id and ignores the later reply.",
  "requires": ["menus/1"],
  "ids": {
    "c1": {"kind":"connection"},
    "hello": {"kind":"request"},
    "w1": {"kind":"window"},
    "open-w1": {"kind":"request"},
    "open-w1-action": {"kind":"action"},
    "bar-1": {"kind":"request"},
    "m1": {"kind":"action"},
    "m1-request": {"kind":"request"},
    "m1-copy": {"kind":"item"},
    "m2": {"kind":"action"},
    "m2-request": {"kind":"request"},
    "m3": {"kind":"action"},
    "m3-request": {"kind":"request"}
  },
  "arrange": {"limits":{"startTimeout":2000,"stopTimeout":2000,"unauthenticatedTimeout":1000},"application":{"name":"Conformance Guest","version":"1.0.0","applicationId":"dev.runic.conformance-guest"}},
  "steps": [
    {"start":{"offer":{"protocols":[1],"nonce":{"$secret":"nonce"},"host":{"name":"Conformance Host","version":"1.0.0"}}}},
    {"line":{"channel":{"url":{"$any":"string"},"key":{"$any":"string"},"protocol":1}}},
    {"connect":"c1"},
    {"send":{"id":{"$id":"hello"},"kind":"hello","protocol":1,"key":{"$secret":"key"},"proof":{"$secret":"host-proof"},"host":{"name":"Conformance Host","version":"1.0.0"},"features":["menus/1"],"locale":null,"languages":[],"appearance":null},"connection":"c1"},
    {"receive":{"id":{"$id":"hello"},"ok":true,"protocol":1,"proof":{"$secret":"guest-proof"},"guest":{"name":"Conformance Guest","version":"1.0.0","applicationId":"dev.runic.conformance-guest"},"features":{"$any":"array","default":[]}},"connection":"c1"},
    {"guest":{"action":"open","window":"w1","type":"Main"},"as":"open-w1-action"},
    {"receive":{"id":{"$id":"open-w1"},"kind":"window-open","window":{"$id":"w1"},"type":{"$any":"string","default":"Conformance.Main"},"url":{"$secret":"launch-url"},"width":{"$any":"integer","default":800},"height":{"$any":"integer","default":600},"owner":null,"modality":"none","guardClose":false,"permissions":[]},"connection":"c1"},
    {"send":{"id":{"$id":"open-w1"},"ok":true,"features":["present","minimize","visibility","full-screen","document-edited","color-scheme","activity","owned-windows"],"activity":{"active":true,"minimized":false,"visible":true},"colorScheme":"no-preference"},"connection":"c1"},
    {"expect":{"action":"open-w1-action","opened":true}},
    {"receive":{"id":{"$id":"bar-1"},"kind":"set-menu-bar","window":{"$id":"w1"},"menu":[{"kind":"submenu","title":"File","role":"file","enabled":true,"items":[{"kind":"item","id":{"$any":"string"},"title":"Open","shortcut":"Primary+O","enabled":true,"checked":null},{"kind":"item","id":{"$any":"string"},"title":"Save","shortcut":"Primary+S","enabled":true,"checked":null},{"kind":"separator"},{"kind":"submenu","title":"Recent","role":null,"enabled":true,"items":[{"kind":"item","id":{"$any":"string"},"title":"notes.txt","shortcut":null,"enabled":true,"checked":null}]}]},{"kind":"submenu","title":"View","role":null,"enabled":true,"items":[{"kind":"item","id":{"$any":"string"},"title":"Grid","shortcut":null,"enabled":true,"checked":false}]}]},"connection":"c1"},
    {"send":{"id":{"$id":"bar-1"},"ok":true,"outcome":"success"},"connection":"c1"},
    {"guest":{"action":"contextMenu","window":"w1","point":{"x":10,"y":20}},"as":"m1"},
    {"receive":{"id":{"$id":"m1-request"},"kind":"show-context-menu","window":{"$id":"w1"},"menu":[{"kind":"item","id":{"$any":"string"},"title":"Cut","shortcut":null,"enabled":true,"checked":null},{"kind":"item","id":{"$id":"m1-copy"},"title":"Copy","shortcut":"Primary+C","enabled":true,"checked":null},{"kind":"separator"},{"kind":"item","id":{"$any":"string"},"title":"Paste","shortcut":null,"enabled":false,"checked":null}],"point":{"x":10,"y":20}},"connection":"c1"},
    {"send":{"id":{"$id":"m1-request"},"ok":true,"outcome":"success","itemId":{"$id":"m1-copy"}},"connection":"c1"},
    {"expect":{"action":"m1","chosen":"edit.copy"}},
    {"guest":{"action":"contextMenu","window":"w1"},"as":"m2"},
    {"receive":{"id":{"$id":"m2-request"},"kind":"show-context-menu","window":{"$id":"w1"},"menu":[{"kind":"item","id":{"$any":"string"},"title":"Cut","shortcut":null,"enabled":true,"checked":null},{"kind":"item","id":{"$any":"string"},"title":"Copy","shortcut":"Primary+C","enabled":true,"checked":null},{"kind":"separator"},{"kind":"item","id":{"$any":"string"},"title":"Paste","shortcut":null,"enabled":false,"checked":null}],"point":null},"connection":"c1"},
    {"send":{"id":{"$id":"m2-request"},"ok":true,"outcome":"success","itemId":null},"connection":"c1"},
    {"expect":{"action":"m2","chosen":null}},
    {"guest":{"action":"contextMenu","window":"w1"},"as":"m3"},
    {"receive":{"id":{"$id":"m3-request"},"kind":"show-context-menu","window":{"$id":"w1"},"menu":[{"kind":"item","id":{"$any":"string"},"title":"Cut","shortcut":null,"enabled":true,"checked":null},{"kind":"item","id":{"$any":"string"},"title":"Copy","shortcut":"Primary+C","enabled":true,"checked":null},{"kind":"separator"},{"kind":"item","id":{"$any":"string"},"title":"Paste","shortcut":null,"enabled":false,"checked":null}],"point":null},"connection":"c1"},
    {"guest":{"action":"cancelDialog","window":"w1"}},
    {"receive":{"kind":"cancel","request":{"$id":"m3-request"}},"connection":"c1"},
    {"expect":{"action":"m3","cancelled":true}},
    {"send":{"id":{"$id":"m3-request"},"ok":false,"error":{"kind":"cancelled","message":"The guest gave the request up."}},"connection":"c1","note":"The guest ignores the reply to a request it gave up."}
  ]
}
