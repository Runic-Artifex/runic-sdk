{
  "format": "runic.host.scenario/1",
  "id": "menus.menu-bar.v1",
  "contract": {"id":"runic-host","version":1},
  "set": "menus",
  "roles": ["guest"],
  "description": "With menus/1 in both hellos (the guest lists menus/1 and dialogs/1), the guest sends its application's menu bar with set-menu-bar after the window-open reply, with each item's id of its choosing, shortcut, enabled and checked state; when a command can no longer run it sends update-menu-items with that item.",
  "requires": ["menus/1"],
  "ids": {
    "c1": {"kind":"connection"},
    "hello": {"kind":"request"},
    "w1": {"kind":"window"},
    "open-w1": {"kind":"request"},
    "open-w1-action": {"kind":"action"},
    "bar-1": {"kind":"request"},
    "item-save": {"kind":"item"},
    "update-1": {"kind":"request"}
  },
  "arrange": {"limits":{"startTimeout":2000,"stopTimeout":2000,"unauthenticatedTimeout":1000},"application":{"name":"Conformance Guest","version":"1.0.0","applicationId":"dev.runic.conformance-guest"}},
  "steps": [
    {"start":{"offer":{"protocols":[1],"nonce":{"$secret":"nonce"},"host":{"name":"Conformance Host","version":"1.0.0"}}}},
    {"line":{"channel":{"url":{"$any":"string"},"key":{"$any":"string"},"protocol":1}}},
    {"connect":"c1"},
    {"send":{"id":{"$id":"hello"},"kind":"hello","protocol":1,"key":{"$secret":"key"},"proof":{"$secret":"host-proof"},"host":{"name":"Conformance Host","version":"1.0.0"},"features":["menus/1","dialogs/1"],"locale":null,"languages":[],"appearance":null},"connection":"c1"},
    {"receive":{"id":{"$id":"hello"},"ok":true,"protocol":1,"proof":{"$secret":"guest-proof"},"guest":{"name":"Conformance Guest","version":"1.0.0","applicationId":"dev.runic.conformance-guest"},"features":["menus/1","dialogs/1","window-services/1"]},"connection":"c1"},
    {"guest":{"action":"open","window":"w1","type":"Main"},"as":"open-w1-action"},
    {"receive":{"id":{"$id":"open-w1"},"kind":"window-open","window":{"$id":"w1"},"type":{"$any":"string","default":"Conformance.Main"},"url":{"$secret":"launch-url"},"width":{"$any":"integer","default":800},"height":{"$any":"integer","default":600},"owner":null,"modality":"none","guardClose":false,"permissions":[]},"connection":"c1"},
    {"send":{"id":{"$id":"open-w1"},"ok":true,"features":["present","minimize","visibility","full-screen","document-edited","color-scheme","activity","owned-windows"],"activity":{"active":true,"minimized":false,"visible":true},"colorScheme":"no-preference"},"connection":"c1"},
    {"expect":{"action":"open-w1-action","opened":true}},
    {"receive":{"id":{"$id":"bar-1"},"kind":"set-menu-bar","window":{"$id":"w1"},"menu":[{"kind":"submenu","title":"File","role":"file","enabled":true,"items":[{"kind":"item","id":{"$any":"string"},"title":"Open","shortcut":"Primary+O","enabled":true,"checked":null},{"kind":"item","id":{"$id":"item-save"},"title":"Save","shortcut":"Primary+S","enabled":true,"checked":null},{"kind":"separator"},{"kind":"submenu","title":"Recent","role":null,"enabled":true,"items":[{"kind":"item","id":{"$any":"string"},"title":"notes.txt","shortcut":null,"enabled":true,"checked":null}]}]},{"kind":"submenu","title":"View","role":null,"enabled":true,"items":[{"kind":"item","id":{"$any":"string"},"title":"Grid","shortcut":null,"enabled":true,"checked":false}]}]},"connection":"c1"},
    {"send":{"id":{"$id":"bar-1"},"ok":true,"outcome":"success"},"connection":"c1"},
    {"guest":{"action":"setCommandEnabled","command":"file.save","value":false}},
    {"receive":{"id":{"$id":"update-1"},"kind":"update-menu-items","window":{"$id":"w1"},"items":[{"id":{"$id":"item-save"},"enabled":false,"checked":null}]},"connection":"c1"},
    {"send":{"id":{"$id":"update-1"},"ok":true,"outcome":"success"},"connection":"c1"}
  ]
}
