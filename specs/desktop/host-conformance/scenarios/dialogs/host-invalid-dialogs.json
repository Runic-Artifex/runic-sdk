{
  "format": "runic.host.scenario/1",
  "id": "dialogs.host-invalid-dialogs.v1",
  "contract": {"id":"runic-host","version":1},
  "set": "dialogs",
  "roles": ["host"],
  "description": "A file dialog or message box that breaks the shape rules is rejected with invalid-request and shows nothing: a relative initial directory, a suggested name for an open dialog or one that is not a file name, filters for a folder dialog, a title over 1,024 characters, more than 6 buttons or two default buttons, a message or detail over 4,096 characters. A box at the limits shows.",
  "requires": ["dialogs/1"],
  "ids": {
    "c1": {"kind":"connection"},
    "hello": {"kind":"request"},
    "open-w1": {"kind":"request"},
    "f1": {"kind":"request"},
    "f2": {"kind":"request"},
    "f3": {"kind":"request"},
    "f4": {"kind":"request"},
    "f5": {"kind":"request"},
    "f6": {"kind":"request"},
    "f7": {"kind":"request"},
    "m1": {"kind":"request"},
    "m2": {"kind":"request"},
    "m3": {"kind":"request"},
    "m4": {"kind":"request"},
    "m5": {"kind":"request"},
    "ok": {"kind":"request"}
  },
  "arrange": {"limits":{"startTimeout":2000,"stopTimeout":2000,"unauthenticatedTimeout":1000},"host":{"name":"Conformance Host","version":"1.0.0"}},
  "steps": [
    {"start":{"host":true}},
    {"offer":{"protocols":[1],"nonce":{"$secret":"nonce"},"host":{"name":"Conformance Host","version":"1.0.0"}}},
    {"line":{"channel":{"url":{"$any":"string"},"key":{"$any":"string"},"protocol":1}}},
    {"accept":"c1"},
    {"receive":{"id":{"$id":"hello"},"kind":"hello","protocol":1,"key":{"$secret":"key"},"proof":{"$secret":"host-proof"},"host":{"name":"Conformance Host","version":"1.0.0"},"features":{"$any":"array"},"locale":{"$any":["string","null"]},"languages":{"$any":"array"},"appearance":{"$any":["object","null"]}},"connection":"c1"},
    {"send":{"id":{"$id":"hello"},"ok":true,"protocol":1,"proof":{"$secret":"guest-proof"},"guest":{"name":"Conformance Guest","version":"1.0.0","applicationId":"dev.runic.conformance-guest"},"features":["menus/1","dialogs/1"]},"connection":"c1"},
    {"expect":{"started":true}},
    {"send":{"id":{"$id":"open-w1"},"kind":"window-open","window":"w1","type":"Conformance.Main","url":"http://127.0.0.1:38211/_runic_launch/AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA","owner":null,"modality":"none","guardClose":false,"permissions":[]},"connection":"c1"},
    {"receive":{"id":{"$id":"open-w1"},"ok":true,"features":{"$any":"array"},"activity":{"$any":"object"},"colorScheme":{"$any":"string"}},"connection":"c1"},
    {"send":{"id":{"$id":"f1"},"kind":"file-dialog","window":"w1","dialog":"open","initialDirectory":"documents/reports"},"connection":"c1","note":"A relative initial directory."},
    {"receive":{"id":{"$id":"f1"},"ok":false,"error":{"kind":"rejected","reason":"invalid-request","message":{"$any":"string"}}},"connection":"c1"},
    {"send":{"id":{"$id":"f2"},"kind":"file-dialog","window":"w1","dialog":"open","suggestedName":"notes.txt"},"connection":"c1","note":"A suggested name for an open dialog."},
    {"receive":{"id":{"$id":"f2"},"ok":false,"error":{"kind":"rejected","reason":"invalid-request","message":{"$any":"string"}}},"connection":"c1"},
    {"send":{"id":{"$id":"f3"},"kind":"file-dialog","window":"w1","dialog":"folder","filters":[{"name":"Text","extensions":["txt"]}]},"connection":"c1","note":"Filters for a folder dialog."},
    {"receive":{"id":{"$id":"f3"},"ok":false,"error":{"kind":"rejected","reason":"invalid-request","message":{"$any":"string"}}},"connection":"c1"},
    {"send":{"id":{"$id":"f4"},"kind":"file-dialog","window":"w1","dialog":"save","suggestedName":"../../autostart/notes.txt"},"connection":"c1","note":"A suggested name with path separators."},
    {"receive":{"id":{"$id":"f4"},"ok":false,"error":{"kind":"rejected","reason":"invalid-request","message":{"$any":"string"}}},"connection":"c1"},
    {"send":{"id":{"$id":"f5"},"kind":"file-dialog","window":"w1","dialog":"save","suggestedName":"C:\\Users\\u\\AppData\\Roaming\\notes.txt"},"connection":"c1","note":"A suggested name that is a Windows path."},
    {"receive":{"id":{"$id":"f5"},"ok":false,"error":{"kind":"rejected","reason":"invalid-request","message":{"$any":"string"}}},"connection":"c1"},
    {"send":{"id":{"$id":"f6"},"kind":"file-dialog","window":"w1","dialog":"save","suggestedName":".."},"connection":"c1","note":"A suggested name that is not a file name."},
    {"receive":{"id":{"$id":"f6"},"ok":false,"error":{"kind":"rejected","reason":"invalid-request","message":{"$any":"string"}}},"connection":"c1"},
    {"send":{"id":{"$id":"f7"},"kind":"file-dialog","window":"w1","dialog":"open","title":""},"connection":"c1","note":"A title of 1,025 characters."},
    {"receive":{"id":{"$id":"f7"},"ok":false,"error":{"kind":"rejected","reason":"invalid-request","message":{"$any":"string"}}},"connection":"c1"},
    {"send":{"id":{"$id":"m1"},"kind":"message-box","window":"w1","icon":"warning","message":"Pick one","buttons":[{"id":"b0","label":"B0"},{"id":"b1","label":"B1"},{"id":"b2","label":"B2"},{"id":"b3","label":"B3"},{"id":"b4","label":"B4"},{"id":"b5","label":"B5"},{"id":"b6","label":"B6"}]},"connection":"c1","note":"Seven buttons."},
    {"receive":{"id":{"$id":"m1"},"ok":false,"error":{"kind":"rejected","reason":"invalid-request","message":{"$any":"string"}}},"connection":"c1"},
    {"send":{"id":{"$id":"m2"},"kind":"message-box","window":"w1","icon":"warning","message":"Pick one","buttons":[{"id":"a","label":"A","role":"default"},{"id":"b","label":"B","role":"default"}]},"connection":"c1","note":"Two default buttons."},
    {"receive":{"id":{"$id":"m2"},"ok":false,"error":{"kind":"rejected","reason":"invalid-request","message":{"$any":"string"}}},"connection":"c1"},
    {"send":{"id":{"$id":"m3"},"kind":"message-box","window":"w1","icon":"warning","message":""},"connection":"c1","note":"A message of 4,097 characters."},
    {"receive":{"id":{"$id":"m3"},"ok":false,"error":{"kind":"rejected","reason":"invalid-request","message":{"$any":"string"}}},"connection":"c1"},
    {"send":{"id":{"$id":"m4"},"kind":"message-box","window":"w1","icon":"warning","message":"Hi","title":""},"connection":"c1","note":"A title of 1,025 characters."},
    {"receive":{"id":{"$id":"m4"},"ok":false,"error":{"kind":"rejected","reason":"invalid-request","message":{"$any":"string"}}},"connection":"c1"},
    {"send":{"id":{"$id":"m5"},"kind":"message-box","window":"w1","icon":"warning","message":"Hi","detail":""},"connection":"c1","note":"A detail of 4,097 characters."},
    {"receive":{"id":{"$id":"m5"},"ok":false,"error":{"kind":"rejected","reason":"invalid-request","message":{"$any":"string"}}},"connection":"c1"},
    {"send":{"id":{"$id":"ok"},"kind":"message-box","window":"w1","icon":"none","message":"","title":"","detail":""},"connection":"c1"},
    {"user":{"action":"answerDialog","dialog":"message-box","dismiss":true}},
    {"receive":{"id":{"$id":"ok"},"ok":true,"outcome":"success","button":null},"connection":"c1"}
  ]
}
