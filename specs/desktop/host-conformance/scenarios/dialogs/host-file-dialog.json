{
  "format": "runic.host.scenario/1",
  "id": "dialogs.host-file-dialog.v1",
  "contract": {"id":"runic-host","version":1},
  "set": "dialogs",
  "roles": ["host"],
  "description": "file-dialog shows the host's dialog of its kind owned by the window and answers success with the paths the user chose and the index of the chosen filter (null without filters); a dismissed dialog is answered failed with user-dismissed.",
  "requires": ["dialogs/1"],
  "ids": {
    "c1": {"kind":"connection"},
    "hello": {"kind":"request"},
    "open-w1": {"kind":"request"},
    "open-w2": {"kind":"request"},
    "open-w3": {"kind":"request"},
    "open-w4": {"kind":"request"},
    "d1": {"kind":"request"},
    "d2": {"kind":"request"},
    "d3": {"kind":"request"},
    "d4": {"kind":"request"}
  },
  "arrange": {"limits":{"startTimeout":2000,"stopTimeout":2000,"unauthenticatedTimeout":1000},"host":{"name":"Conformance Host","version":"1.0.0"}},
  "steps": [
    {"start":{"host":true}},
    {"offer":{"protocols":[1],"nonce":{"$secret":"nonce"},"host":{"name":"Conformance Host","version":"1.0.0"}}},
    {"line":{"channel":{"url":{"$any":"string"},"key":{"$any":"string"},"protocol":1}}},
    {"accept":"c1"},
    {"receive":{"id":{"$id":"hello"},"kind":"hello","protocol":1,"key":{"$secret":"key"},"proof":{"$secret":"host-proof"},"host":{"name":"Conformance Host","version":"1.0.0"},"features":{"$any":"array"},"locale":{"$any":["string","null"]},"languages":{"$any":"array"},"appearance":{"$any":["object","null"]}},"connection":"c1"},
    {"send":{"id":{"$id":"hello"},"ok":true,"protocol":1,"proof":{"$secret":"guest-proof"},"guest":{"name":"Conformance Guest","version":"1.0.0","applicationId":"dev.runic.conformance-guest"},"features":["menus/1","dialogs/1"]},"connection":"c1"},
    {"expect":{"started":true}},
    {"send":{"id":{"$id":"open-w1"},"kind":"window-open","window":"w1","type":"Conformance.Main","url":"http://127.0.0.1:38211/_runic_launch/AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA","owner":null,"modality":"none","guardClose":false,"permissions":[]},"connection":"c1"},
    {"receive":{"id":{"$id":"open-w1"},"ok":true,"features":{"$any":"array"},"activity":{"$any":"object"},"colorScheme":{"$any":"string"}},"connection":"c1"},
    {"send":{"id":{"$id":"open-w2"},"kind":"window-open","window":"w2","type":"Conformance.Main","url":"http://127.0.0.1:38211/_runic_launch/AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA","owner":null,"modality":"none","guardClose":false,"permissions":[]},"connection":"c1"},
    {"receive":{"id":{"$id":"open-w2"},"ok":true,"features":{"$any":"array"},"activity":{"$any":"object"},"colorScheme":{"$any":"string"}},"connection":"c1"},
    {"send":{"id":{"$id":"open-w3"},"kind":"window-open","window":"w3","type":"Conformance.Main","url":"http://127.0.0.1:38211/_runic_launch/AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA","owner":null,"modality":"none","guardClose":false,"permissions":[]},"connection":"c1"},
    {"receive":{"id":{"$id":"open-w3"},"ok":true,"features":{"$any":"array"},"activity":{"$any":"object"},"colorScheme":{"$any":"string"}},"connection":"c1"},
    {"send":{"id":{"$id":"open-w4"},"kind":"window-open","window":"w4","type":"Conformance.Main","url":"http://127.0.0.1:38211/_runic_launch/AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA","owner":null,"modality":"none","guardClose":false,"permissions":[]},"connection":"c1"},
    {"receive":{"id":{"$id":"open-w4"},"ok":true,"features":{"$any":"array"},"activity":{"$any":"object"},"colorScheme":{"$any":"string"}},"connection":"c1"},
    {"send":{"id":{"$id":"d1"},"kind":"file-dialog","window":"w1","dialog":"open","title":"Open","filters":[{"name":"Text","extensions":["txt"],"mimeTypes":[]}]},"connection":"c1"},
    {"user":{"action":"answerDialog","dialog":"open","paths":[{"$file":"notes.txt"}]}},
    {"receive":{"id":{"$id":"d1"},"ok":true,"outcome":"success","paths":[{"$file":"notes.txt"}],"filter":0},"connection":"c1"},
    {"send":{"id":{"$id":"d2"},"kind":"file-dialog","window":"w2","dialog":"open","title":"Open","filters":[{"name":"Text","extensions":["txt"],"mimeTypes":[]}]},"connection":"c1"},
    {"user":{"action":"answerDialog","dialog":"open","dismiss":true}},
    {"receive":{"id":{"$id":"d2"},"ok":true,"outcome":"failed","code":"user-dismissed"},"connection":"c1"},
    {"send":{"id":{"$id":"d3"},"kind":"file-dialog","window":"w3","dialog":"save","suggestedName":"notes.txt"},"connection":"c1"},
    {"user":{"action":"answerDialog","dialog":"save","paths":[{"$file":"saved.txt"}]}},
    {"receive":{"id":{"$id":"d3"},"ok":true,"outcome":"success","paths":[{"$file":"saved.txt"}],"filter":null},"connection":"c1"},
    {"send":{"id":{"$id":"d4"},"kind":"file-dialog","window":"w4","dialog":"folder-multiple"},"connection":"c1"},
    {"user":{"action":"answerDialog","dialog":"folder-multiple","paths":[{"$directory":"a"},{"$directory":"b"}]}},
    {"receive":{"id":{"$id":"d4"},"ok":true,"outcome":"success","paths":[{"$directory":"a"},{"$directory":"b"}],"filter":null},"connection":"c1"}
  ]
}
