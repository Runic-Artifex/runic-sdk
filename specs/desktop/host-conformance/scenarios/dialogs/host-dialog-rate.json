{
  "format": "runic.host.scenario/1",
  "id": "dialogs.host-dialog-rate.v1",
  "contract": {"id":"runic-host","version":1},
  "set": "dialogs",
  "roles": ["host"],
  "description": "The host limits the dialogs a guest shows to its rate, here one per ten seconds, across the guest's windows: a dialog request over it is rejected with busy, also once the guest cancelled its dialog, so a guest cannot bring dialogs to the front one after another.",
  "requires": ["dialogs/1"],
  "ids": {
    "c1": {"kind":"connection"},
    "hello": {"kind":"request"},
    "open-w1": {"kind":"request"},
    "open-w2": {"kind":"request"},
    "b1": {"kind":"request"},
    "b2": {"kind":"request"}
  },
  "arrange": {"limits":{"startTimeout":2000,"stopTimeout":2000,"unauthenticatedTimeout":1000,"dialogRate":1},"host":{"name":"Conformance Host","version":"1.0.0"}},
  "steps": [
    {"start":{"host":true}},
    {"offer":{"protocols":[1],"nonce":{"$secret":"nonce"},"host":{"name":"Conformance Host","version":"1.0.0"}}},
    {"line":{"channel":{"url":{"$any":"string"},"key":{"$any":"string"},"protocol":1}}},
    {"accept":"c1"},
    {"receive":{"id":{"$id":"hello"},"kind":"hello","protocol":1,"key":{"$secret":"key"},"proof":{"$secret":"host-proof"},"host":{"name":"Conformance Host","version":"1.0.0"},"features":{"$any":"array"},"locale":{"$any":["string","null"]},"languages":{"$any":"array"},"appearance":{"$any":["object","null"]}},"connection":"c1"},
    {"send":{"id":{"$id":"hello"},"ok":true,"protocol":1,"proof":{"$secret":"guest-proof"},"guest":{"name":"Conformance Guest","version":"1.0.0","applicationId":"dev.runic.conformance-guest"},"features":["menus/1","dialogs/1"]},"connection":"c1"},
    {"expect":{"started":true}},
    {"send":{"id":{"$id":"open-w1"},"kind":"window-open","window":"w1","type":"Conformance.Main","url":"http://127.0.0.1:38211/_runic_launch/AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA","owner":null,"modality":"none","guardClose":false,"permissions":[]},"connection":"c1"},
    {"receive":{"id":{"$id":"open-w1"},"ok":true,"features":{"$any":"array"},"activity":{"$any":"object"},"colorScheme":{"$any":"string"}},"connection":"c1"},
    {"send":{"id":{"$id":"open-w2"},"kind":"window-open","window":"w2","type":"Conformance.Main","url":"http://127.0.0.1:38211/_runic_launch/AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA","owner":null,"modality":"none","guardClose":false,"permissions":[]},"connection":"c1"},
    {"receive":{"id":{"$id":"open-w2"},"ok":true,"features":{"$any":"array"},"activity":{"$any":"object"},"colorScheme":{"$any":"string"}},"connection":"c1"},
    {"send":{"id":{"$id":"b1"},"kind":"message-box","window":"w1","message":"Saved."},"connection":"c1"},
    {"user":{"action":"awaitDialog","dialog":"message-box"}},
    {"send":{"kind":"cancel","request":{"$id":"b1"}},"connection":"c1"},
    {"receive":{"id":{"$id":"b1"},"ok":false,"error":{"kind":"cancelled","message":{"$any":"string"}}},"connection":"c1"},
    {"send":{"id":{"$id":"b2"},"kind":"message-box","window":"w2","message":"Saved."},"connection":"c1","note":"The guest's one dialog of these ten seconds was b1, which it cancelled; w2 shows none."},
    {"receive":{"id":{"$id":"b2"},"ok":false,"error":{"kind":"rejected","reason":"busy","message":{"$any":"string"}}},"connection":"c1"}
  ]
}
