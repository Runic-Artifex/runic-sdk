{
  "format": "runic.host.scenario/1",
  "id": "launch.offer-not-json.v1",
  "contract": {"id":"runic-host","version":1},
  "set": "launch",
  "roles": ["guest"],
  "description": "An offer line that is not a JSON object is refused with offer-invalid.",
  "ids": {},
  "arrange": {"limits":{"startTimeout":2000,"stopTimeout":2000,"unauthenticatedTimeout":1000},"application":{"name":"Conformance Guest","version":"1.0.0","applicationId":"dev.runic.conformance-guest"}},
  "steps": [
    {"start":{"offerLine":"RUNIC_HOST_OFFER=protocols=1"}},
    {"line":{"refused":{"code":"offer-invalid","message":{"$any":"string"}}}},
    {"expect":{"startFailure":"offer-invalid"}},
    {"expect":{"exited":true}}
  ]
}
