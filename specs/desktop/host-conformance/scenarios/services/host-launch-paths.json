{
  "format": "runic.host.scenario/1",
  "id": "services.host-launch-paths.v1",
  "contract": {"id":"runic-host","version":1},
  "set": "services",
  "roles": ["host"],
  "description": "The host opens only the files the user gave the guest in an open dialog or a drop: no file or javascript links, no path through a given file's directory, and no path of a save dialog, whose content the guest wrote.",
  "requires": ["window-services/1"],
  "ids": {
    "c1": {"kind":"connection"},
    "hello": {"kind":"request"},
    "open-w1": {"kind":"request"},
    "lf": {"kind":"request"},
    "lj": {"kind":"request"},
    "ld": {"kind":"request"},
    "d1": {"kind":"request"},
    "ls": {"kind":"request"},
    "la": {"kind":"request"}
  },
  "arrange": {"limits":{"startTimeout":2000,"stopTimeout":2000,"unauthenticatedTimeout":1000},"host":{"name":"Conformance Host","version":"1.0.0"}},
  "steps": [
    {"start":{"host":true}},
    {"offer":{"protocols":[1],"nonce":{"$secret":"nonce"},"host":{"name":"Conformance Host","version":"1.0.0"}}},
    {"line":{"channel":{"url":{"$any":"string"},"key":{"$any":"string"},"protocol":1}}},
    {"accept":"c1"},
    {"receive":{"id":{"$id":"hello"},"kind":"hello","protocol":1,"key":{"$secret":"key"},"proof":{"$secret":"host-proof"},"host":{"name":"Conformance Host","version":"1.0.0"},"features":{"$any":"array"},"locale":{"$any":["string","null"]},"languages":{"$any":"array"},"appearance":{"$any":["object","null"]}},"connection":"c1"},
    {"send":{"id":{"$id":"hello"},"ok":true,"protocol":1,"proof":{"$secret":"guest-proof"},"guest":{"name":"Conformance Guest","version":"1.0.0","applicationId":"dev.runic.conformance-guest"},"features":["menus/1","dialogs/1","window-services/1"]},"connection":"c1"},
    {"expect":{"started":true}},
    {"send":{"id":{"$id":"open-w1"},"kind":"window-open","window":"w1","type":"Conformance.Main","url":"http://127.0.0.1:38211/_runic_launch/AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA","owner":null,"modality":"none","guardClose":false,"permissions":[],"fileDrops":true},"connection":"c1"},
    {"receive":{"id":{"$id":"open-w1"},"ok":true,"features":{"$any":"array"},"activity":{"$any":"object"},"colorScheme":{"$any":"string"}},"connection":"c1"},
    {"user":{"action":"dropFiles","window":"w1","paths":[{"$file":"a.txt"}]},"note":"The user drops a file onto the window, and works in it."},
    {"receive":{"kind":"files-dropped","window":"w1","paths":[{"$file":"a.txt"}],"effect":"copy"},"connection":"c1"},
    {"send":{"id":{"$id":"lf"},"kind":"launch","window":"w1","uri":"file:///etc/hosts"},"connection":"c1"},
    {"receive":{"id":{"$id":"lf"},"ok":false,"error":{"kind":"rejected","reason":"refused","message":{"$any":"string"}}},"connection":"c1"},
    {"send":{"id":{"$id":"lj"},"kind":"launch","window":"w1","uri":"javascript:alert(1)"},"connection":"c1"},
    {"receive":{"id":{"$id":"lj"},"ok":false,"error":{"kind":"rejected","reason":"refused","message":{"$any":"string"}}},"connection":"c1"},
    {"send":{"id":{"$id":"ld"},"kind":"launch","window":"w1","path":{"$file":"a.txt","then":["..","b.txt"]},"operation":"open"},"connection":"c1"},
    {"receive":{"id":{"$id":"ld"},"ok":false,"error":{"kind":"rejected","reason":"refused","message":{"$any":"string"}}},"connection":"c1","note":"Not a given file: the path leaves a.txt."},
    {"send":{"id":{"$id":"d1"},"kind":"file-dialog","window":"w1","dialog":"save","suggestedName":"notes.html"},"connection":"c1"},
    {"user":{"action":"answerDialog","dialog":"save","paths":[{"$file":"notes.html"}]}},
    {"receive":{"id":{"$id":"d1"},"ok":true,"outcome":"success","paths":[{"$file":"notes.html"}],"filter":null},"connection":"c1"},
    {"send":{"id":{"$id":"ls"},"kind":"launch","window":"w1","path":{"$file":"notes.html"},"operation":"open"},"connection":"c1"},
    {"receive":{"id":{"$id":"ls"},"ok":false,"error":{"kind":"rejected","reason":"refused","message":{"$any":"string"}}},"connection":"c1","note":"The user chose where the guest saves, not what it wrote."},
    {"send":{"id":{"$id":"la"},"kind":"launch","window":"w1","path":{"$file":"a.txt"},"operation":"open"},"connection":"c1"},
    {"receive":{"id":{"$id":"la"},"ok":true,"outcome":"success"},"connection":"c1"},
    {"expect":{"launched":[{"$file":"a.txt"}]}}
  ]
}
