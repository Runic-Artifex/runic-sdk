{
  "format": "runic.host.scenario/1",
  "id": "services.not-in-use.v1",
  "contract": {"id":"runic-host","version":1},
  "set": "services",
  "roles": ["guest"],
  "description": "Without window-services/1 in the host's hello, a hosted Window's clipboard, launcher and monitors report unavailable with owner-unavailable without a message to the host, and window-open names no fileDrops.",
  "requires": ["window-services/1"],
  "ids": {
    "c1": {"kind":"connection"},
    "hello": {"kind":"request"},
    "w1": {"kind":"window"},
    "open-w1": {"kind":"request"},
    "open-w1-action": {"kind":"action"},
    "r": {"kind":"action"},
    "u": {"kind":"action"},
    "m": {"kind":"action"},
    "p1": {"kind":"action"},
    "p1-request": {"kind":"request"}
  },
  "arrange": {"limits":{"startTimeout":2000,"stopTimeout":2000,"unauthenticatedTimeout":1000},"application":{"name":"Conformance Guest","version":"1.0.0","applicationId":"dev.runic.conformance-guest"}},
  "steps": [
    {"start":{"offer":{"protocols":[1],"nonce":{"$secret":"nonce"},"host":{"name":"Conformance Host","version":"1.0.0"}}}},
    {"line":{"channel":{"url":{"$any":"string"},"key":{"$any":"string"},"protocol":1}}},
    {"connect":"c1"},
    {"send":{"id":{"$id":"hello"},"kind":"hello","protocol":1,"key":{"$secret":"key"},"proof":{"$secret":"host-proof"},"host":{"name":"Conformance Host","version":"1.0.0"},"features":[],"locale":null,"languages":[],"appearance":null},"connection":"c1"},
    {"receive":{"id":{"$id":"hello"},"ok":true,"protocol":1,"proof":{"$secret":"guest-proof"},"guest":{"name":"Conformance Guest","version":"1.0.0","applicationId":"dev.runic.conformance-guest"},"features":{"$any":"array","default":[]}},"connection":"c1"},
    {"guest":{"action":"open","window":"w1","type":"Drop"},"as":"open-w1-action"},
    {"receive":{"id":{"$id":"open-w1"},"kind":"window-open","window":{"$id":"w1"},"type":{"$any":"string","default":"Conformance.Drop"},"url":{"$secret":"launch-url"},"width":{"$any":"integer","default":800},"height":{"$any":"integer","default":600},"owner":null,"modality":"none","guardClose":false,"permissions":[]},"connection":"c1"},
    {"send":{"id":{"$id":"open-w1"},"ok":true,"features":["present","minimize","visibility","full-screen","document-edited","color-scheme","activity","owned-windows"],"activity":{"active":true,"minimized":false,"visible":true},"colorScheme":"no-preference"},"connection":"c1"},
    {"expect":{"action":"open-w1-action","opened":true}},
    {"guest":{"action":"readClipboard","window":"w1"},"as":"r"},
    {"expect":{"action":"r","outcome":{"unavailable":"owner-unavailable"}}},
    {"guest":{"action":"launch","window":"w1","value":"https://runic.dev/docs"},"as":"u"},
    {"expect":{"action":"u","outcome":{"unavailable":"owner-unavailable"}}},
    {"guest":{"action":"monitors","window":"w1"},"as":"m"},
    {"expect":{"action":"m","outcome":{"unavailable":"owner-unavailable"}}},
    {"guest":{"action":"present","window":"w1"},"as":"p1","note":"The next message is present: the guest asked the host for no service."},
    {"receive":{"id":{"$id":"p1-request"},"kind":"present","window":{"$id":"w1"}},"connection":"c1"},
    {"send":{"id":{"$id":"p1-request"},"ok":true,"outcome":"success"},"connection":"c1"},
    {"expect":{"action":"p1","outcome":{"success":{}}}}
  ]
}
