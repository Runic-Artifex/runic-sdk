{
  "format": "runic.host.scenario/1",
  "id": "services.host-drop.v1",
  "contract": {"id":"runic-host","version":1},
  "set": "services",
  "roles": ["host"],
  "description": "The host forwards the files the user drops onto a window whose Window takes them (fileDrops) with files-dropped, and the guest may then open them; a window without fileDrops gets no drops.",
  "requires": ["window-services/1"],
  "ids": {
    "c1": {"kind":"connection"},
    "hello": {"kind":"request"},
    "open-w1": {"kind":"request"},
    "open-w2": {"kind":"request"},
    "l1": {"kind":"request"},
    "m": {"kind":"request"}
  },
  "arrange": {"limits":{"startTimeout":2000,"stopTimeout":2000,"unauthenticatedTimeout":1000},"host":{"name":"Conformance Host","version":"1.0.0"}},
  "steps": [
    {"start":{"host":true}},
    {"offer":{"protocols":[1],"nonce":{"$secret":"nonce"},"host":{"name":"Conformance Host","version":"1.0.0"}}},
    {"line":{"channel":{"url":{"$any":"string"},"key":{"$any":"string"},"protocol":1}}},
    {"accept":"c1"},
    {"receive":{"id":{"$id":"hello"},"kind":"hello","protocol":1,"key":{"$secret":"key"},"proof":{"$secret":"host-proof"},"host":{"name":"Conformance Host","version":"1.0.0"},"features":{"$any":"array"},"locale":{"$any":["string","null"]},"languages":{"$any":"array"},"appearance":{"$any":["object","null"]}},"connection":"c1"},
    {"send":{"id":{"$id":"hello"},"ok":true,"protocol":1,"proof":{"$secret":"guest-proof"},"guest":{"name":"Conformance Guest","version":"1.0.0","applicationId":"dev.runic.conformance-guest"},"features":["menus/1","dialogs/1","window-services/1"]},"connection":"c1"},
    {"expect":{"started":true}},
    {"send":{"id":{"$id":"open-w1"},"kind":"window-open","window":"w1","type":"Conformance.Main","url":"http://127.0.0.1:38211/_runic_launch/AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA","owner":null,"modality":"none","guardClose":false,"permissions":[],"fileDrops":true},"connection":"c1"},
    {"receive":{"id":{"$id":"open-w1"},"ok":true,"features":{"$any":"array"},"activity":{"$any":"object"},"colorScheme":{"$any":"string"}},"connection":"c1"},
    {"send":{"id":{"$id":"open-w2"},"kind":"window-open","window":"w2","type":"Conformance.Main","url":"http://127.0.0.1:38211/_runic_launch/AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA","owner":null,"modality":"none","guardClose":false,"permissions":[]},"connection":"c1"},
    {"receive":{"id":{"$id":"open-w2"},"ok":true,"features":{"$any":"array"},"activity":{"$any":"object"},"colorScheme":{"$any":"string"}},"connection":"c1"},
    {"user":{"action":"dropFiles","window":"w2","paths":[{"$file":"ignored.txt"}]},"note":"w2 takes no drops: nothing is forwarded."},
    {"user":{"action":"dropFiles","window":"w1","paths":[{"$file":"a.txt"}]}},
    {"receive":{"kind":"files-dropped","window":"w1","paths":[{"$file":"a.txt"}],"effect":"copy"},"connection":"c1"},
    {"send":{"id":{"$id":"l1"},"kind":"launch","window":"w1","path":{"$file":"a.txt"},"operation":"reveal"},"connection":"c1"},
    {"receive":{"id":{"$id":"l1"},"ok":true,"outcome":"success"},"connection":"c1","note":"The user gave the guest the file."},
    {"send":{"id":{"$id":"m"},"kind":"monitors","window":"w1"},"connection":"c1"},
    {"receive":{"id":{"$id":"m"},"ok":true,"outcome":"success","monitors":{"$any":"array"},"current":{"$any":["string","null"]}},"connection":"c1"},
    {"expect":{"launched":[{"$file":"a.txt"}]}}
  ]
}
