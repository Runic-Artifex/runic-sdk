{
  "format": "runic.host.scenario/1",
  "id": "services.locale.v1",
  "contract": {"id":"runic-host","version":1},
  "set": "services",
  "roles": ["guest"],
  "description": "The guest's application locale follows the host's: hello's locale before any Window opens, which window-open names, then each locale push, with the window's direction; once the application sets a locale of its own, the host's no longer replaces it.",
  "requires": [],
  "ids": {
    "c1": {"kind":"connection"},
    "hello": {"kind":"request"},
    "w1": {"kind":"window"},
    "open-w1": {"kind":"request"},
    "open-w1-action": {"kind":"action"},
    "l1": {"kind":"action"},
    "l2": {"kind":"action"},
    "l3": {"kind":"action"},
    "own": {"kind":"action"},
    "rtl": {"kind":"request"},
    "ltr": {"kind":"request"}
  },
  "arrange": {"limits":{"startTimeout":2000,"stopTimeout":2000,"unauthenticatedTimeout":1000},"application":{"name":"Conformance Guest","version":"1.0.0","applicationId":"dev.runic.conformance-guest"}},
  "steps": [
    {"start":{"offer":{"protocols":[1],"nonce":{"$secret":"nonce"},"host":{"name":"Conformance Host","version":"1.0.0"}}}},
    {"line":{"channel":{"url":{"$any":"string"},"key":{"$any":"string"},"protocol":1}}},
    {"connect":"c1"},
    {"send":{"id":{"$id":"hello"},"kind":"hello","protocol":1,"key":{"$secret":"key"},"proof":{"$secret":"host-proof"},"host":{"name":"Conformance Host","version":"1.0.0"},"features":[],"locale":"de-CH","languages":["de-CH","en"],"appearance":null},"connection":"c1"},
    {"receive":{"id":{"$id":"hello"},"ok":true,"protocol":1,"proof":{"$secret":"guest-proof"},"guest":{"name":"Conformance Guest","version":"1.0.0","applicationId":"dev.runic.conformance-guest"},"features":{"$any":"array","default":[]}},"connection":"c1"},
    {"guest":{"action":"locale"},"as":"l1"},
    {"expect":{"action":"l1","locale":"de-CH"},"note":"The application starts in the host's locale."},
    {"guest":{"action":"open","window":"w1","type":"Main"},"as":"open-w1-action"},
    {"receive":{"id":{"$id":"open-w1"},"kind":"window-open","window":{"$id":"w1"},"type":{"$any":"string","default":"Conformance.Main"},"url":{"$secret":"launch-url"},"width":{"$any":"integer","default":800},"height":{"$any":"integer","default":600},"owner":null,"modality":"none","guardClose":false,"permissions":[],"locale":"de-CH"},"connection":"c1"},
    {"send":{"id":{"$id":"open-w1"},"ok":true,"features":["present","minimize","visibility","full-screen","document-edited","color-scheme","activity","owned-windows"],"activity":{"active":true,"minimized":false,"visible":true},"colorScheme":"no-preference"},"connection":"c1"},
    {"expect":{"action":"open-w1-action","opened":true}},
    {"send":{"kind":"locale","locale":"ar","languages":["ar","en"]},"connection":"c1"},
    {"guest":{"action":"locale"},"as":"l2"},
    {"expect":{"action":"l2","locale":"ar"}},
    {"receive":{"id":{"$id":"rtl"},"kind":"set-layout-direction","window":{"$id":"w1"},"direction":"right-to-left"},"connection":"c1","note":"The Window follows the application, and its direction the locale."},
    {"send":{"id":{"$id":"rtl"},"ok":true,"outcome":"success"},"connection":"c1"},
    {"guest":{"action":"setLocale","value":"en"},"as":"own"},
    {"receive":{"id":{"$id":"ltr"},"kind":"set-layout-direction","window":{"$id":"w1"},"direction":"left-to-right"},"connection":"c1"},
    {"send":{"id":{"$id":"ltr"},"ok":true,"outcome":"success"},"connection":"c1"},
    {"send":{"kind":"locale","locale":"fr","languages":["fr"]},"connection":"c1"},
    {"guest":{"action":"locale"},"as":"l3"},
    {"expect":{"action":"l3","locale":"en"},"note":"The application's own locale stays."}
  ]
}
