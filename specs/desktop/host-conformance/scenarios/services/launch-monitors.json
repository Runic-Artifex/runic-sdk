{
  "format": "runic.host.scenario/1",
  "id": "services.launch-monitors.v1",
  "contract": {"id":"runic-host","version":1},
  "set": "services",
  "roles": ["guest"],
  "description": "With window-services/1, a hosted Window's launcher asks the host to open a link or a file, and its monitors are the host's; the host's outcome is the launcher's.",
  "requires": ["window-services/1"],
  "ids": {
    "c1": {"kind":"connection"},
    "hello": {"kind":"request"},
    "w1": {"kind":"window"},
    "open-w1": {"kind":"request"},
    "open-w1-action": {"kind":"action"},
    "u": {"kind":"action"},
    "u-request": {"kind":"request"},
    "f": {"kind":"action"},
    "f-request": {"kind":"request"},
    "m": {"kind":"action"},
    "m-request": {"kind":"request"}
  },
  "arrange": {"limits":{"startTimeout":2000,"stopTimeout":2000,"unauthenticatedTimeout":1000},"application":{"name":"Conformance Guest","version":"1.0.0","applicationId":"dev.runic.conformance-guest"}},
  "steps": [
    {"start":{"offer":{"protocols":[1],"nonce":{"$secret":"nonce"},"host":{"name":"Conformance Host","version":"1.0.0"}}}},
    {"line":{"channel":{"url":{"$any":"string"},"key":{"$any":"string"},"protocol":1}}},
    {"connect":"c1"},
    {"send":{"id":{"$id":"hello"},"kind":"hello","protocol":1,"key":{"$secret":"key"},"proof":{"$secret":"host-proof"},"host":{"name":"Conformance Host","version":"1.0.0"},"features":["window-services/1"],"locale":null,"languages":[],"appearance":null},"connection":"c1"},
    {"receive":{"id":{"$id":"hello"},"ok":true,"protocol":1,"proof":{"$secret":"guest-proof"},"guest":{"name":"Conformance Guest","version":"1.0.0","applicationId":"dev.runic.conformance-guest"},"features":{"$any":"array","default":[]}},"connection":"c1"},
    {"guest":{"action":"open","window":"w1","type":"Main"},"as":"open-w1-action"},
    {"receive":{"id":{"$id":"open-w1"},"kind":"window-open","window":{"$id":"w1"},"type":{"$any":"string","default":"Conformance.Main"},"url":{"$secret":"launch-url"},"width":{"$any":"integer","default":800},"height":{"$any":"integer","default":600},"owner":null,"modality":"none","guardClose":false,"permissions":[]},"connection":"c1"},
    {"send":{"id":{"$id":"open-w1"},"ok":true,"features":["present","minimize","visibility","full-screen","document-edited","color-scheme","activity","owned-windows"],"activity":{"active":true,"minimized":false,"visible":true},"colorScheme":"no-preference"},"connection":"c1"},
    {"expect":{"action":"open-w1-action","opened":true}},
    {"guest":{"action":"launch","window":"w1","value":"https://runic.dev/docs"},"as":"u"},
    {"receive":{"id":{"$id":"u-request"},"kind":"launch","window":{"$id":"w1"},"uri":"https://runic.dev/docs"},"connection":"c1"},
    {"send":{"id":{"$id":"u-request"},"ok":true,"outcome":"success"},"connection":"c1"},
    {"expect":{"action":"u","outcome":{"success":{}}}},
    {"guest":{"action":"launch","window":"w1","value":{"$file":"report.txt"}},"as":"f"},
    {"receive":{"id":{"$id":"f-request"},"kind":"launch","window":{"$id":"w1"},"path":{"$file":"report.txt"},"operation":"reveal"},"connection":"c1"},
    {"send":{"id":{"$id":"f-request"},"ok":false,"error":{"kind":"rejected","reason":"refused","message":"The host opens only files the user gave the application."}},"connection":"c1"},
    {"expect":{"action":"f","outcome":{"failed":"permission-denied"}}},
    {"guest":{"action":"monitors","window":"w1"},"as":"m"},
    {"receive":{"id":{"$id":"m-request"},"kind":"monitors","window":{"$id":"w1"}},"connection":"c1"},
    {"send":{"id":{"$id":"m-request"},"ok":true,"outcome":"success","monitors":[{"id":"m1","name":"Built-in","bounds":{"x":0,"y":0,"width":1440,"height":900},"workArea":{"x":0,"y":25,"width":1440,"height":875},"scale":2,"primary":true},{"id":"m2","name":"External","bounds":{"x":1440,"y":0,"width":2560,"height":1440},"workArea":{"x":1440,"y":0,"width":2560,"height":1440},"scale":1,"primary":false}],"current":"m1"},"connection":"c1"},
    {"expect":{"action":"m","monitors":["m1","m2"]}}
  ]
}
