{
  "format": "runic.host.scenario/1",
  "id": "services.host-rates.v1",
  "contract": {"id":"runic-host","version":1},
  "set": "services",
  "roles": ["host"],
  "description": "The host's rates of a guest's clipboard and monitor requests, launches, requests that bring a window to the front and announcements: a request over its rate is rejected with capacity.",
  "requires": ["window-services/1"],
  "ids": {
    "c1": {"kind":"connection"},
    "hello": {"kind":"request"},
    "open-w1": {"kind":"request"},
    "m1": {"kind":"request"},
    "m2": {"kind":"request"},
    "l1": {"kind":"request"},
    "l2": {"kind":"request"},
    "a1": {"kind":"request"},
    "a2": {"kind":"request"},
    "p1": {"kind":"request"},
    "p2": {"kind":"request"}
  },
  "arrange": {"limits":{"startTimeout":2000,"stopTimeout":2000,"unauthenticatedTimeout":1000,"serviceRate":1,"launchRate":1,"presentRate":1,"announcementRate":1,"guestActivation":2000},"host":{"name":"Conformance Host","version":"1.0.0"}},
  "steps": [
    {"start":{"host":true}},
    {"offer":{"protocols":[1],"nonce":{"$secret":"nonce"},"host":{"name":"Conformance Host","version":"1.0.0"}}},
    {"line":{"channel":{"url":{"$any":"string"},"key":{"$any":"string"},"protocol":1}}},
    {"accept":"c1"},
    {"receive":{"id":{"$id":"hello"},"kind":"hello","protocol":1,"key":{"$secret":"key"},"proof":{"$secret":"host-proof"},"host":{"name":"Conformance Host","version":"1.0.0"},"features":{"$any":"array"},"locale":{"$any":["string","null"]},"languages":{"$any":"array"},"appearance":{"$any":["object","null"]}},"connection":"c1"},
    {"send":{"id":{"$id":"hello"},"ok":true,"protocol":1,"proof":{"$secret":"guest-proof"},"guest":{"name":"Conformance Guest","version":"1.0.0","applicationId":"dev.runic.conformance-guest"},"features":["menus/1","dialogs/1","window-services/1"]},"connection":"c1"},
    {"expect":{"started":true}},
    {"send":{"id":{"$id":"open-w1"},"kind":"window-open","window":"w1","type":"Conformance.Main","url":"http://127.0.0.1:38211/_runic_launch/AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA","owner":null,"modality":"none","guardClose":false,"permissions":[]},"connection":"c1"},
    {"receive":{"id":{"$id":"open-w1"},"ok":true,"features":{"$any":"array"},"activity":{"$any":"object"},"colorScheme":{"$any":"string"}},"connection":"c1"},
    {"advance":"guestActivation","note":"Any activation of the guest's windows right after its own request counts as the guest's."},
    {"user":{"action":"deactivateWindow","window":"w1"}},
    {"user":{"action":"activateWindow","window":"w1"},"note":"The user switches to the window: the user activated it."},
    {"send":{"id":{"$id":"m1"},"kind":"monitors","window":"w1"},"connection":"c1"},
    {"receive":{"id":{"$id":"m1"},"ok":true,"outcome":"success","monitors":{"$any":"array"},"current":{"$any":["string","null"]}},"connection":"c1"},
    {"send":{"id":{"$id":"m2"},"kind":"monitors","window":"w1"},"connection":"c1"},
    {"receive":{"id":{"$id":"m2"},"ok":false,"error":{"kind":"rejected","reason":"capacity","message":{"$any":"string"}}},"connection":"c1"},
    {"send":{"id":{"$id":"l1"},"kind":"launch","window":"w1","uri":"https://runic.dev/a"},"connection":"c1"},
    {"receive":{"id":{"$id":"l1"},"ok":true,"outcome":"success"},"connection":"c1"},
    {"send":{"id":{"$id":"l2"},"kind":"launch","window":"w1","uri":"https://runic.dev/b"},"connection":"c1"},
    {"receive":{"id":{"$id":"l2"},"ok":false,"error":{"kind":"rejected","reason":"capacity","message":{"$any":"string"}}},"connection":"c1"},
    {"send":{"id":{"$id":"a1"},"kind":"announce","window":"w1","text":"Saved","priority":"polite"},"connection":"c1"},
    {"receive":{"id":{"$id":"a1"},"ok":true,"outcome":{"$any":"string"},"reason":{"$any":["string","null"]}},"connection":"c1","note":"Any platform outcome: a window without a screen reader has none."},
    {"send":{"id":{"$id":"a2"},"kind":"announce","window":"w1","text":"Saved again","priority":"polite"},"connection":"c1"},
    {"receive":{"id":{"$id":"a2"},"ok":false,"error":{"kind":"rejected","reason":"capacity","message":{"$any":"string"}}},"connection":"c1"},
    {"send":{"id":{"$id":"p1"},"kind":"present","window":"w1"},"connection":"c1"},
    {"receive":{"id":{"$id":"p1"},"ok":true,"outcome":"success"},"connection":"c1"},
    {"send":{"id":{"$id":"p2"},"kind":"present","window":"w1"},"connection":"c1"},
    {"receive":{"id":{"$id":"p2"},"ok":false,"error":{"kind":"rejected","reason":"capacity","message":{"$any":"string"}}},"connection":"c1"},
    {"expect":{"launched":["https://runic.dev/a"]}}
  ]
}
