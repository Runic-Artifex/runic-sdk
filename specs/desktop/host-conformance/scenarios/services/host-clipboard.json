{
  "format": "runic.host.scenario/1",
  "id": "services.host-clipboard.v1",
  "contract": {"id":"runic-host","version":1},
  "set": "services",
  "roles": ["host"],
  "description": "The host reads and writes its clipboard for a guest only while the user works in the window, not while the guest's own request made it active; it reports the formats it has, never reads more than a reply can carry, and allows a write within a second after the user left the window.",
  "requires": ["window-services/1"],
  "ids": {
    "c1": {"kind":"connection"},
    "hello": {"kind":"request"},
    "open-w1": {"kind":"request"},
    "r0": {"kind":"request"},
    "r1": {"kind":"request"},
    "big": {"kind":"request"},
    "f1": {"kind":"request"},
    "huge": {"kind":"request"},
    "w1-write": {"kind":"request"},
    "r2": {"kind":"request"}
  },
  "arrange": {"limits":{"startTimeout":2000,"stopTimeout":2000,"unauthenticatedTimeout":1000},"host":{"name":"Conformance Host","version":"1.0.0"}},
  "steps": [
    {"start":{"host":true}},
    {"offer":{"protocols":[1],"nonce":{"$secret":"nonce"},"host":{"name":"Conformance Host","version":"1.0.0"}}},
    {"line":{"channel":{"url":{"$any":"string"},"key":{"$any":"string"},"protocol":1}}},
    {"accept":"c1"},
    {"receive":{"id":{"$id":"hello"},"kind":"hello","protocol":1,"key":{"$secret":"key"},"proof":{"$secret":"host-proof"},"host":{"name":"Conformance Host","version":"1.0.0"},"features":{"$any":"array"},"locale":{"$any":["string","null"]},"languages":{"$any":"array"},"appearance":{"$any":["object","null"]}},"connection":"c1"},
    {"send":{"id":{"$id":"hello"},"ok":true,"protocol":1,"proof":{"$secret":"guest-proof"},"guest":{"name":"Conformance Guest","version":"1.0.0","applicationId":"dev.runic.conformance-guest"},"features":["menus/1","dialogs/1","window-services/1"]},"connection":"c1"},
    {"expect":{"started":true}},
    {"send":{"id":{"$id":"open-w1"},"kind":"window-open","window":"w1","type":"Conformance.Main","url":"http://127.0.0.1:38211/_runic_launch/AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA","owner":null,"modality":"none","guardClose":false,"permissions":[]},"connection":"c1"},
    {"receive":{"id":{"$id":"open-w1"},"ok":true,"features":{"$any":"array"},"activity":{"$any":"object"},"colorScheme":{"$any":"string"}},"connection":"c1"},
    {"user":{"action":"copyText","text":"Pasted"},"note":"The user copied text in another application."},
    {"send":{"id":{"$id":"r0"},"kind":"clipboard-read","window":"w1","format":"text","maximum":1024},"connection":"c1"},
    {"receive":{"id":{"$id":"r0"},"ok":false,"error":{"kind":"rejected","reason":"refused","message":{"$any":"string"}}},"connection":"c1","note":"w1 is active because the guest opened it."},
    {"user":{"action":"deactivateWindow","window":"w1"}},
    {"user":{"action":"activateWindow","window":"w1"},"note":"The user switches to the window: the user activated it."},
    {"send":{"id":{"$id":"r1"},"kind":"clipboard-read","window":"w1","format":"text","maximum":1024},"connection":"c1"},
    {"receive":{"id":{"$id":"r1"},"ok":true,"outcome":"success","value":"Pasted"},"connection":"c1"},
    {"send":{"id":{"$id":"big"},"kind":"clipboard-read","window":"w1","format":"text","maximum":3},"connection":"c1"},
    {"receive":{"id":{"$id":"big"},"ok":true,"outcome":"failed","code":"too-large"},"connection":"c1"},
    {"send":{"id":{"$id":"f1"},"kind":"clipboard-read","window":"w1","format":"formats"},"connection":"c1"},
    {"receive":{"id":{"$id":"f1"},"ok":true,"outcome":"success","value":["text"]},"connection":"c1"},
    {"user":{"action":"copyText","text":"a","repeat":1100000},"note":"More text than a message carries."},
    {"send":{"id":{"$id":"huge"},"kind":"clipboard-read","window":"w1","format":"text","maximum":16777216},"connection":"c1"},
    {"receive":{"id":{"$id":"huge"},"ok":true,"outcome":"failed","code":"too-large"},"connection":"c1","note":"Within the guest's bound, but more than a reply carries."},
    {"user":{"action":"deactivateWindow","window":"w1"}},
    {"send":{"id":{"$id":"w1-write"},"kind":"clipboard-write","window":"w1","content":{"text":"Copied"}},"connection":"c1"},
    {"receive":{"id":{"$id":"w1-write"},"ok":true,"outcome":"success"},"connection":"c1","note":"Within a second after the user left the window, as for a copy that closes it."},
    {"send":{"id":{"$id":"r2"},"kind":"clipboard-read","window":"w1","format":"text","maximum":1024},"connection":"c1"},
    {"receive":{"id":{"$id":"r2"},"ok":false,"error":{"kind":"rejected","reason":"refused","message":{"$any":"string"}}},"connection":"c1","note":"Not for a window the user is not working in."},
    {"expect":{"clipboard":"Copied"}}
  ]
}
