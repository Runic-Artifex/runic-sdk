{
  "format": "runic.host.scenario/1",
  "id": "host.window-open-invalid-owner.v1",
  "contract": {"id":"runic-host","version":1},
  "set": "host",
  "roles": ["host"],
  "description": "A window-open whose owner is not an open window of the channel is rejected with invalid-request.",
  "ids": {
    "c1": {"kind":"connection"},
    "hello": {"kind":"request"},
    "open-1": {"kind":"request"}
  },
  "arrange": {"limits":{"startTimeout":2000,"stopTimeout":2000,"unauthenticatedTimeout":1000},"host":{"name":"Conformance Host","version":"1.0.0"}},
  "steps": [
    {"start":{"host":true}},
    {"offer":{"protocols":[1],"nonce":{"$secret":"nonce"},"host":{"name":"Conformance Host","version":"1.0.0"}}},
    {"line":{"channel":{"url":{"$any":"string"},"key":{"$any":"string"},"protocol":1}}},
    {"accept":"c1"},
    {"receive":{"id":{"$id":"hello"},"kind":"hello","protocol":1,"key":{"$secret":"key"},"proof":{"$secret":"host-proof"},"host":{"name":"Conformance Host","version":"1.0.0"},"features":{"$any":"array"},"locale":{"$any":["string","null"]},"languages":{"$any":"array"},"appearance":{"$any":["object","null"]}},"connection":"c1"},
    {"send":{"id":{"$id":"hello"},"ok":true,"protocol":1,"proof":{"$secret":"guest-proof"},"guest":{"name":"Conformance Guest","version":"1.0.0","applicationId":"dev.runic.conformance-guest"},"features":[]},"connection":"c1"},
    {"expect":{"started":true}},
    {"send":{"id":{"$id":"open-1"},"kind":"window-open","window":"w2","type":"Conformance.Main","url":"http://127.0.0.1:38211/_runic_launch/AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA","owner":"w1","modality":"window","guardClose":false,"permissions":[]},"connection":"c1","note":"w1 was never opened."},
    {"receive":{"id":{"$id":"open-1"},"ok":false,"error":{"kind":"rejected","reason":"invalid-request","message":{"$any":"string"}}},"connection":"c1"}
  ]
}
