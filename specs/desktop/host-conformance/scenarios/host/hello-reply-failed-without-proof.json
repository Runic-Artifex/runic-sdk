{
  "format": "runic.host.scenario/1",
  "id": "host.hello-reply-failed-without-proof.v1",
  "contract": {"id":"runic-host","version":1},
  "set": "host",
  "roles": ["host"],
  "description": "A failed hello reply without the guest proof, as from a process that took the guest's port, fails the host's start with guest-not-hostable, whatever its error says.",
  "ids": {
    "c1": {"kind":"connection"},
    "hello": {"kind":"request"}
  },
  "arrange": {"limits":{"startTimeout":2000,"stopTimeout":2000,"unauthenticatedTimeout":1000},"host":{"name":"Conformance Host","version":"1.0.0"}},
  "steps": [
    {"start":{"host":true}},
    {"offer":{"protocols":[1],"nonce":{"$secret":"nonce"},"host":{"name":"Conformance Host","version":"1.0.0"}}},
    {"line":{"channel":{"url":{"$any":"string"},"key":{"$any":"string"},"protocol":1}}},
    {"accept":"c1"},
    {"receive":{"id":{"$id":"hello"},"kind":"hello","protocol":1,"key":{"$secret":"key"},"proof":{"$secret":"host-proof"},"host":{"name":"Conformance Host","version":"1.0.0"},"features":{"$any":"array"},"locale":{"$any":["string","null"]},"languages":{"$any":"array"},"appearance":{"$any":["object","null"]}},"connection":"c1"},
    {"send":{"id":{"$id":"hello"},"ok":false,"protocol":1,"error":{"kind":"failed","reason":"protocol-mismatch","message":"Another version."}},"connection":"c1"},
    {"closed":{"connection":"c1"}},
    {"expect":{"startFailure":"guest-not-hostable"}}
  ]
}
