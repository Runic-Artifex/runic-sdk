{
  "format": "runic.host.scenario/1",
  "id": "host.channel-line-not-loopback.v1",
  "contract": {"id":"runic-host","version":1},
  "set": "host",
  "roles": ["host"],
  "description": "A channel line whose url is not a loopback literal fails the host's start with guest-not-hostable; the host connects nowhere, so the key and the host proof never leave the machine.",
  "ids": {},
  "arrange": {"limits":{"startTimeout":2000,"stopTimeout":2000,"unauthenticatedTimeout":1000},"host":{"name":"Conformance Host","version":"1.0.0"}},
  "steps": [
    {"start":{"host":true}},
    {"offer":{"protocols":[1],"nonce":{"$secret":"nonce"},"host":{"name":"Conformance Host","version":"1.0.0"}}},
    {"line":{"text":"RUNIC_HOST_CHANNEL={\"url\":\"ws://example.com:41234/_runic_host\",\"key\":\"Jm8pXcQ0yB4rT6wZ1aN3dF5hK7lP9sV2uE4iO6gH8jA\",\"protocol\":1}"}},
    {"expect":{"startFailure":"guest-not-hostable"}}
  ]
}
