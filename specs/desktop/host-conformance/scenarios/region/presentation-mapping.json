{
  "format": "runic.host.scenario/1",
  "id": "region.presentation-mapping.v1",
  "contract": {"id":"runic-host","version":1},
  "set": "region",
  "roles": ["guest"],
  "description": "A region window's minimize, set-visible, set-full-screen and set-color-scheme are unavailable with backend-unavailable without a message to the host; a request the host answers unavailable with embedded reads as backend-unavailable.",
  "requires": ["region/1"],
  "ids": {
    "c1": {"kind":"connection"},
    "hello": {"kind":"request"},
    "w1": {"kind":"window"},
    "open-w1": {"kind":"request"},
    "open-w1-action": {"kind":"action"},
    "p1": {"kind":"action"},
    "p2": {"kind":"action"},
    "p3": {"kind":"action"},
    "p4": {"kind":"action"},
    "p5": {"kind":"action"},
    "p5-request": {"kind":"request"},
    "p6": {"kind":"action"},
    "p6-request": {"kind":"request"}
  },
  "arrange": {"limits":{"startTimeout":2000,"stopTimeout":2000,"unauthenticatedTimeout":1000},"application":{"name":"Conformance Guest","version":"1.0.0","applicationId":"dev.runic.conformance-guest"}},
  "steps": [
    {"start":{"offer":{"protocols":[1],"nonce":{"$secret":"nonce"},"host":{"name":"Conformance Host","version":"1.0.0"}}}},
    {"line":{"channel":{"url":{"$any":"string"},"key":{"$any":"string"},"protocol":1}}},
    {"connect":"c1"},
    {"send":{"id":{"$id":"hello"},"kind":"hello","protocol":1,"key":{"$secret":"key"},"proof":{"$secret":"host-proof"},"host":{"name":"Conformance Host","version":"1.0.0"},"features":["region/1"],"locale":null,"languages":[],"appearance":null},"connection":"c1"},
    {"receive":{"id":{"$id":"hello"},"ok":true,"protocol":1,"proof":{"$secret":"guest-proof"},"guest":{"name":"Conformance Guest","version":"1.0.0","applicationId":"dev.runic.conformance-guest"},"features":{"$any":"array","default":[]}},"connection":"c1"},
    {"guest":{"action":"open","window":"w1","type":"Main"},"as":"open-w1-action"},
    {"receive":{"id":{"$id":"open-w1"},"kind":"window-open","window":{"$id":"w1"},"type":{"$any":"string","default":"Conformance.Main"},"url":{"$secret":"launch-url"},"width":{"$any":"integer","default":800},"height":{"$any":"integer","default":600},"owner":null,"modality":"none","guardClose":false,"permissions":[]},"connection":"c1"},
    {"send":{"id":{"$id":"open-w1"},"ok":true,"presentation":"region","features":["present","document-edited","activity","owned-windows"],"activity":{"active":false,"minimized":false,"visible":false},"region":null},"connection":"c1"},
    {"expect":{"action":"open-w1-action","opened":true}},
    {"guest":{"action":"minimize","window":"w1"},"as":"p1"},
    {"expect":{"action":"p1","outcome":{"unavailable":"backend-unavailable"}}},
    {"guest":{"action":"setVisible","window":"w1","value":false},"as":"p2"},
    {"expect":{"action":"p2","outcome":{"unavailable":"backend-unavailable"}}},
    {"guest":{"action":"setFullScreen","window":"w1","value":true},"as":"p3"},
    {"expect":{"action":"p3","outcome":{"unavailable":"backend-unavailable"}}},
    {"guest":{"action":"setColorScheme","window":"w1","value":"dark"},"as":"p4"},
    {"expect":{"action":"p4","outcome":{"unavailable":"backend-unavailable"}}},
    {"guest":{"action":"present","window":"w1"},"as":"p5"},
    {"receive":{"id":{"$id":"p5-request"},"kind":"present","window":{"$id":"w1"}},"connection":"c1"},
    {"send":{"id":{"$id":"p5-request"},"ok":true,"outcome":"unavailable","reason":"embedded"},"connection":"c1"},
    {"expect":{"action":"p5","outcome":{"unavailable":"backend-unavailable"}}},
    {"guest":{"action":"setDocumentEdited","window":"w1","value":true},"as":"p6"},
    {"receive":{"id":{"$id":"p6-request"},"kind":"set-document-edited","window":{"$id":"w1"},"edited":true},"connection":"c1"},
    {"send":{"id":{"$id":"p6-request"},"ok":true,"outcome":"success"},"connection":"c1"},
    {"expect":{"action":"p6","outcome":{"success":{}}}}
  ]
}
