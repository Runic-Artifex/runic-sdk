{
  "format": "runic.host.scenario/1",
  "id": "region.appearance-more-on-forced-desktop.v1",
  "contract": {"id":"runic-host","version":1},
  "set": "region",
  "roles": ["guest"],
  "description": "The override contrast more on a desktop that forces colours: the pages receive contrast more and systemColors null. Without the override's contrast they receive the desktop's forced colours and palette again.",
  "requires": ["region/1","region-appearance/1"],
  "ids": {
    "c1": {"kind":"connection"},
    "hello": {"kind":"request"},
    "w1": {"kind":"window"},
    "open-w1": {"kind":"request"},
    "open-w1-action": {"kind":"action"},
    "a1": {"kind":"action"},
    "a2": {"kind":"action"}
  },
  "arrange": {"limits":{"startTimeout":2000,"stopTimeout":2000,"unauthenticatedTimeout":1000},"application":{"name":"Conformance Guest","version":"1.0.0","applicationId":"dev.runic.conformance-guest"}},
  "steps": [
    {"start":{"offer":{"protocols":[1],"nonce":{"$secret":"nonce"},"host":{"name":"Conformance Host","version":"1.0.0"}}}},
    {"line":{"channel":{"url":{"$any":"string"},"key":{"$any":"string"},"protocol":1}}},
    {"connect":"c1"},
    {"send":{"id":{"$id":"hello"},"kind":"hello","protocol":1,"key":{"$secret":"key"},"proof":{"$secret":"host-proof"},"host":{"name":"Conformance Host","version":"1.0.0"},"features":["region/1","region-appearance/1"],"locale":null,"languages":[],"appearance":{"colorScheme":"dark","contrast":"forced-colors","reducedMotion":false,"textScale":1.25,"accentColor":"#3366cc","systemColors":{"canvas":"#000000","canvasText":"#ffffff","linkText":"#ffff00","grayText":"#3fff00","highlight":"#1ae6ff","highlightText":"#000000","buttonFace":"#000000","buttonText":"#ffffff"}}},"connection":"c1"},
    {"receive":{"id":{"$id":"hello"},"ok":true,"protocol":1,"proof":{"$secret":"guest-proof"},"guest":{"name":"Conformance Guest","version":"1.0.0","applicationId":"dev.runic.conformance-guest"},"features":{"$any":"array","default":[]}},"connection":"c1"},
    {"guest":{"action":"open","window":"w1","type":"Main"},"as":"open-w1-action"},
    {"receive":{"id":{"$id":"open-w1"},"kind":"window-open","window":{"$id":"w1"},"type":{"$any":"string","default":"Conformance.Main"},"url":{"$secret":"launch-url"},"width":{"$any":"integer","default":800},"height":{"$any":"integer","default":600},"owner":null,"modality":"none","guardClose":false,"permissions":[]},"connection":"c1"},
    {"send":{"id":{"$id":"open-w1"},"ok":true,"presentation":"region","features":["present","document-edited","activity","owned-windows"],"activity":{"active":false,"minimized":false,"visible":false},"region":null,"appearance":{"colorScheme":null,"contrast":"more","reducedMotion":null,"textScale":null,"accentColor":null,"systemColors":null}},"connection":"c1"},
    {"expect":{"action":"open-w1-action","opened":true}},
    {"guest":{"action":"appearance","window":"w1"},"as":"a1"},
    {"expect":{"action":"a1","appearance":{"colorScheme":"dark","contrast":"more","reducedMotion":false,"textScale":1.25,"accentColor":"#3366cc","systemColors":null,"override":["contrast"]}}},
    {"send":{"kind":"region-appearance","window":{"$id":"w1"},"appearance":{"colorScheme":null,"contrast":null,"reducedMotion":null,"textScale":null,"accentColor":"#00aa55","systemColors":null}},"connection":"c1"},
    {"guest":{"action":"appearance","window":"w1"},"as":"a2"},
    {"expect":{"action":"a2","appearance":{"colorScheme":"dark","contrast":"forced-colors","reducedMotion":false,"textScale":1.25,"accentColor":"#00aa55","systemColors":{"canvas":"#000000","canvasText":"#ffffff","linkText":"#ffff00","grayText":"#3fff00","highlight":"#1ae6ff","highlightText":"#000000","buttonFace":"#000000","buttonText":"#ffffff"}}}}
  ]
}
