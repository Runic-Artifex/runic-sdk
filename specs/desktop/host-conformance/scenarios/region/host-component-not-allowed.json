{
  "format": "runic.host.scenario/1",
  "id": "region.host-component-not-allowed.v1",
  "contract": {"id":"runic-host","version":1},
  "set": "region",
  "roles": ["host"],
  "description": "A policy's EmbedComponent for a guest that does not list region-component/1 fails the guest's window-open; the host page shows no component.",
  "requires": ["region/1"],
  "ids": {
    "c1": {"kind":"connection"},
    "hello": {"kind":"request"},
    "open-w1": {"kind":"request"}
  },
  "arrange": {"limits":{"startTimeout":2000,"stopTimeout":2000,"unauthenticatedTimeout":1000},"host":{"name":"Conformance Host","version":"1.0.0","embed":"check","embedComponent":true}},
  "steps": [
    {"start":{"host":true}},
    {"offer":{"protocols":[1],"nonce":{"$secret":"nonce"},"host":{"name":"Conformance Host","version":"1.0.0"}}},
    {"line":{"channel":{"url":{"$any":"string"},"key":{"$any":"string"},"protocol":1}}},
    {"accept":"c1"},
    {"receive":{"id":{"$id":"hello"},"kind":"hello","protocol":1,"key":{"$secret":"key"},"proof":{"$secret":"host-proof"},"host":{"name":"Conformance Host","version":"1.0.0"},"features":{"$any":"array"},"locale":{"$any":["string","null"]},"languages":{"$any":"array"},"appearance":{"$any":["object","null"]}},"connection":"c1"},
    {"send":{"id":{"$id":"hello"},"ok":true,"protocol":1,"proof":{"$secret":"guest-proof"},"guest":{"name":"Conformance Guest","version":"1.0.0","applicationId":"dev.runic.conformance-guest"},"features":["menus/1","dialogs/1","window-services/1","region/1"]},"connection":"c1"},
    {"expect":{"started":true}},
    {"user":{"action":"declareRegion","window":"h1","name":"check"}},
    {"send":{"id":{"$id":"open-w1"},"kind":"window-open","window":"w1","type":"Conformance.Check","url":"http://127.0.0.1:38211/_runic_launch/AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA","owner":null,"modality":"none","guardClose":true,"permissions":[]},"connection":"c1"},
    {"receive":{"id":{"$id":"open-w1"},"ok":false,"error":{"kind":"failed","message":{"$any":"string"}}},"connection":"c1"},
    {"expect":{"window":"h1","page":{"name":"check","shows":"waiting","module":null}}}
  ]
}
