{
  "format": "runic.host.scenario/1",
  "id": "region.host-presentation-mapping.v1",
  "contract": {"id":"runic-host","version":1},
  "set": "region",
  "roles": ["host"],
  "description": "A region window's presentation requests map to the region: minimize, set-visible, set-full-screen and set-color-scheme are not in its features and answer unavailable with backend-unavailable; toggle-maximized, move and set-represented-file answer unavailable with embedded, as resize does while the region's height follows the host page; set-document-edited and set-layout-direction succeed.",
  "requires": ["region/1"],
  "ids": {
    "c1": {"kind":"connection"},
    "hello": {"kind":"request"},
    "open-w1": {"kind":"request"},
    "attach-1": {"kind":"request"},
    "p0": {"kind":"request"},
    "p1": {"kind":"request"},
    "p2": {"kind":"request"},
    "p3": {"kind":"request"},
    "p4": {"kind":"request"},
    "p5": {"kind":"request"},
    "p6": {"kind":"request"},
    "p7": {"kind":"request"},
    "p8": {"kind":"request"},
    "p9": {"kind":"request"}
  },
  "arrange": {"limits":{"startTimeout":2000,"stopTimeout":2000,"unauthenticatedTimeout":1000},"host":{"name":"Conformance Host","version":"1.0.0","embed":"check"}},
  "steps": [
    {"start":{"host":true}},
    {"offer":{"protocols":[1],"nonce":{"$secret":"nonce"},"host":{"name":"Conformance Host","version":"1.0.0"}}},
    {"line":{"channel":{"url":{"$any":"string"},"key":{"$any":"string"},"protocol":1}}},
    {"accept":"c1"},
    {"receive":{"id":{"$id":"hello"},"kind":"hello","protocol":1,"key":{"$secret":"key"},"proof":{"$secret":"host-proof"},"host":{"name":"Conformance Host","version":"1.0.0"},"features":{"$any":"array"},"locale":{"$any":["string","null"]},"languages":{"$any":"array"},"appearance":{"$any":["object","null"]}},"connection":"c1"},
    {"send":{"id":{"$id":"hello"},"ok":true,"protocol":1,"proof":{"$secret":"guest-proof"},"guest":{"name":"Conformance Guest","version":"1.0.0","applicationId":"dev.runic.conformance-guest"},"features":["menus/1","dialogs/1","window-services/1","region/1"]},"connection":"c1"},
    {"expect":{"started":true}},
    {"user":{"action":"declareRegion","window":"h1","name":"check"}},
    {"send":{"id":{"$id":"open-w1"},"kind":"window-open","window":"w1","type":"Conformance.Check","url":"http://127.0.0.1:38211/_runic_launch/AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA","owner":null,"modality":"none","guardClose":true,"permissions":[]},"connection":"c1"},
    {"receive":{"id":{"$id":"open-w1"},"ok":true,"presentation":"region","features":["present","document-edited","activity","owned-windows"],"activity":{"active":false,"minimized":false,"visible":false},"region":{"width":800,"height":520,"scale":1.5}},"connection":"c1"},
    {"receive":{"id":{"$id":"attach-1"},"kind":"region-attach","window":"w1","embedding":"frame","embedder":{"$any":"string"},"width":800,"height":520,"scale":1.5,"sizing":"fill","allowSameSite":true},"connection":"c1"},
    {"send":{"id":{"$id":"attach-1"},"ok":true,"frame":{"url":"http://[::1]:40117/_runic_frame/AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA","sameSite":false}},"connection":"c1"},
    {"receive":{"kind":"activity","window":"w1","active":false,"minimized":false,"visible":true},"connection":"c1"},
    {"send":{"kind":"region-page","window":"w1","page":"connected"},"connection":"c1"},
    {"expect":{"window":"w1","region":{"state":"attached"}}},
    {"send":{"id":{"$id":"p0"},"kind":"minimize","window":"w1"},"connection":"c1"},
    {"receive":{"id":{"$id":"p0"},"ok":true,"outcome":"unavailable","reason":"backend-unavailable"},"connection":"c1"},
    {"send":{"id":{"$id":"p1"},"kind":"set-visible","window":"w1","visible":false},"connection":"c1"},
    {"receive":{"id":{"$id":"p1"},"ok":true,"outcome":"unavailable","reason":"backend-unavailable"},"connection":"c1"},
    {"send":{"id":{"$id":"p2"},"kind":"set-full-screen","window":"w1","fullScreen":true},"connection":"c1"},
    {"receive":{"id":{"$id":"p2"},"ok":true,"outcome":"unavailable","reason":"backend-unavailable"},"connection":"c1"},
    {"send":{"id":{"$id":"p3"},"kind":"set-color-scheme","window":"w1","colorScheme":"dark"},"connection":"c1"},
    {"receive":{"id":{"$id":"p3"},"ok":true,"outcome":"unavailable","reason":"backend-unavailable"},"connection":"c1"},
    {"send":{"id":{"$id":"p4"},"kind":"toggle-maximized","window":"w1"},"connection":"c1"},
    {"receive":{"id":{"$id":"p4"},"ok":true,"outcome":"unavailable","reason":"embedded"},"connection":"c1"},
    {"send":{"id":{"$id":"p5"},"kind":"move","window":"w1","x":10,"y":20},"connection":"c1"},
    {"receive":{"id":{"$id":"p5"},"ok":true,"outcome":"unavailable","reason":"embedded"},"connection":"c1"},
    {"send":{"id":{"$id":"p6"},"kind":"set-represented-file","window":"w1","path":null},"connection":"c1"},
    {"receive":{"id":{"$id":"p6"},"ok":true,"outcome":"unavailable","reason":"embedded"},"connection":"c1"},
    {"send":{"id":{"$id":"p7"},"kind":"resize","window":"w1","width":640,"height":300},"connection":"c1"},
    {"receive":{"id":{"$id":"p7"},"ok":true,"outcome":"unavailable","reason":"embedded"},"connection":"c1"},
    {"send":{"id":{"$id":"p8"},"kind":"set-document-edited","window":"w1","edited":true},"connection":"c1"},
    {"receive":{"id":{"$id":"p8"},"ok":true,"outcome":"success"},"connection":"c1"},
    {"send":{"id":{"$id":"p9"},"kind":"set-layout-direction","window":"w1","direction":"right-to-left"},"connection":"c1"},
    {"receive":{"id":{"$id":"p9"},"ok":true,"outcome":"success"},"connection":"c1"},
    {"expect":{"window":"w1","region":{"documentEdited":true}}}
  ]
}
