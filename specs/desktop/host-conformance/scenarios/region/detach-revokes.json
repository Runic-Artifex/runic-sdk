{
  "format": "runic.host.scenario/1",
  "id": "region.detach-revokes.v1",
  "contract": {"id":"runic-host","version":1},
  "set": "region",
  "roles": ["guest"],
  "description": "After region-detach, the window's frame token is refused, the Window stays open and its activity reports visible false, and a new region-attach answers a new frame launch address while the earlier one is refused.",
  "requires": ["region/1"],
  "ids": {
    "c1": {"kind":"connection"},
    "hello": {"kind":"request"},
    "w1": {"kind":"window"},
    "open-w1": {"kind":"request"},
    "open-w1-action": {"kind":"action"},
    "attach-1": {"kind":"request"},
    "attach-2": {"kind":"request"},
    "a1": {"kind":"action"}
  },
  "arrange": {"limits":{"startTimeout":2000,"stopTimeout":2000,"unauthenticatedTimeout":1000},"application":{"name":"Conformance Guest","version":"1.0.0","applicationId":"dev.runic.conformance-guest"}},
  "steps": [
    {"start":{"offer":{"protocols":[1],"nonce":{"$secret":"nonce"},"host":{"name":"Conformance Host","version":"1.0.0"}}}},
    {"line":{"channel":{"url":{"$any":"string"},"key":{"$any":"string"},"protocol":1}}},
    {"connect":"c1"},
    {"send":{"id":{"$id":"hello"},"kind":"hello","protocol":1,"key":{"$secret":"key"},"proof":{"$secret":"host-proof"},"host":{"name":"Conformance Host","version":"1.0.0"},"features":["region/1"],"locale":null,"languages":[],"appearance":null},"connection":"c1"},
    {"receive":{"id":{"$id":"hello"},"ok":true,"protocol":1,"proof":{"$secret":"guest-proof"},"guest":{"name":"Conformance Guest","version":"1.0.0","applicationId":"dev.runic.conformance-guest"},"features":{"$any":"array","default":[]}},"connection":"c1"},
    {"guest":{"action":"open","window":"w1","type":"Main"},"as":"open-w1-action"},
    {"receive":{"id":{"$id":"open-w1"},"kind":"window-open","window":{"$id":"w1"},"type":{"$any":"string","default":"Conformance.Main"},"url":{"$secret":"launch-url"},"width":{"$any":"integer","default":800},"height":{"$any":"integer","default":600},"owner":null,"modality":"none","guardClose":false,"permissions":[]},"connection":"c1"},
    {"send":{"id":{"$id":"open-w1"},"ok":true,"presentation":"region","features":["present","document-edited","activity","owned-windows"],"activity":{"active":false,"minimized":false,"visible":false},"region":null},"connection":"c1"},
    {"expect":{"action":"open-w1-action","opened":true}},
    {"send":{"id":{"$id":"attach-1"},"kind":"region-attach","window":{"$id":"w1"},"embedding":"frame","embedder":"http://127.0.0.1:38200","width":800,"height":520,"scale":1.5,"sizing":"fill"},"connection":"c1"},
    {"receive":{"id":{"$id":"attach-1"},"ok":true,"frame":{"url":{"$secret":"frame-url"},"sameSite":false}},"connection":"c1"},
    {"send":{"kind":"activity","window":{"$id":"w1"},"active":true,"minimized":false,"visible":true},"connection":"c1"},
    {"frame":{"request":"launch","status":303}},
    {"frame":{"request":"upgrade","token":{"$secret":"frame-token"},"status":101}},
    {"receive":{"kind":"region-page","window":{"$id":"w1"},"page":"connected"},"connection":"c1"},
    {"send":{"kind":"region-detach","window":{"$id":"w1"},"reason":"removed"},"connection":"c1"},
    {"send":{"kind":"activity","window":{"$id":"w1"},"active":false,"minimized":false,"visible":false},"connection":"c1"},
    {"frame":{"request":"upgrade","token":{"$secret":"frame-token"},"refused":true}},
    {"guest":{"action":"activity","window":"w1"},"as":"a1"},
    {"expect":{"action":"a1","activity":{"active":false,"minimized":false,"visible":false}}},
    {"send":{"id":{"$id":"attach-2"},"kind":"region-attach","window":{"$id":"w1"},"embedding":"frame","embedder":"http://127.0.0.1:38200","width":800,"height":520,"scale":1.5,"sizing":"fill"},"connection":"c1"},
    {"receive":{"id":{"$id":"attach-2"},"ok":true,"frame":{"url":{"$secret":"frame-url"},"sameSite":false}},"connection":"c1"},
    {"frame":{"request":"launch","url":"previous","refused":true}},
    {"frame":{"request":"launch","status":303}}
  ]
}
