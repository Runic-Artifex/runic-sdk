{
  "format": "runic.host.scenario/1",
  "id": "region.host-present-keeps-host-focus.v1",
  "contract": {"id":"runic-host","version":1},
  "set": "region",
  "roles": ["host"],
  "description": "present of a region window never takes the focus from the host page: with a focused element of the host page it answers success and leaves the focus; with none, the page moves the focus into the region and the host pushes region-focus programmatic.",
  "requires": ["region/1"],
  "ids": {
    "c1": {"kind":"connection"},
    "hello": {"kind":"request"},
    "open-w1": {"kind":"request"},
    "attach-1": {"kind":"request"},
    "p1": {"kind":"request"},
    "p2": {"kind":"request"},
    "t1": {"kind":"request"}
  },
  "arrange": {"limits":{"startTimeout":2000,"stopTimeout":2000,"unauthenticatedTimeout":1000},"host":{"name":"Conformance Host","version":"1.0.0","embed":"check"}},
  "steps": [
    {"start":{"host":true}},
    {"offer":{"protocols":[1],"nonce":{"$secret":"nonce"},"host":{"name":"Conformance Host","version":"1.0.0"}}},
    {"line":{"channel":{"url":{"$any":"string"},"key":{"$any":"string"},"protocol":1}}},
    {"accept":"c1"},
    {"receive":{"id":{"$id":"hello"},"kind":"hello","protocol":1,"key":{"$secret":"key"},"proof":{"$secret":"host-proof"},"host":{"name":"Conformance Host","version":"1.0.0"},"features":{"$any":"array"},"locale":{"$any":["string","null"]},"languages":{"$any":"array"},"appearance":{"$any":["object","null"]}},"connection":"c1"},
    {"send":{"id":{"$id":"hello"},"ok":true,"protocol":1,"proof":{"$secret":"guest-proof"},"guest":{"name":"Conformance Guest","version":"1.0.0","applicationId":"dev.runic.conformance-guest"},"features":["menus/1","dialogs/1","window-services/1","region/1"]},"connection":"c1"},
    {"expect":{"started":true}},
    {"user":{"action":"declareRegion","window":"h1","name":"check"}},
    {"send":{"id":{"$id":"open-w1"},"kind":"window-open","window":"w1","type":"Conformance.Check","url":"http://127.0.0.1:38211/_runic_launch/AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA","owner":null,"modality":"none","guardClose":true,"permissions":[]},"connection":"c1"},
    {"receive":{"id":{"$id":"open-w1"},"ok":true,"presentation":"region","features":["present","document-edited","activity","owned-windows"],"activity":{"active":false,"minimized":false,"visible":false},"region":{"width":800,"height":520,"scale":1.5}},"connection":"c1"},
    {"receive":{"id":{"$id":"attach-1"},"kind":"region-attach","window":"w1","embedding":"frame","embedder":{"$any":"string"},"width":800,"height":520,"scale":1.5,"sizing":"fill","allowSameSite":true},"connection":"c1"},
    {"send":{"id":{"$id":"attach-1"},"ok":true,"frame":{"url":"http://[::1]:40117/_runic_frame/AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA","sameSite":false}},"connection":"c1"},
    {"receive":{"kind":"activity","window":"w1","active":false,"minimized":false,"visible":true},"connection":"c1"},
    {"send":{"kind":"region-page","window":"w1","page":"connected"},"connection":"c1"},
    {"expect":{"window":"w1","region":{"state":"attached"}}},
    {"user":{"action":"focusHost","window":"h1"},"note":"The user works in a field of the host page."},
    {"send":{"id":{"$id":"p1"},"kind":"present","window":"w1"},"connection":"c1"},
    {"receive":{"id":{"$id":"p1"},"ok":true,"outcome":"success"},"connection":"c1"},
    {"send":{"id":{"$id":"t1"},"kind":"set-title","window":"w1","title":"Check"},"connection":"c1"},
    {"receive":{"id":{"$id":"t1"},"ok":true,"outcome":"success"},"connection":"c1"},
    {"expect":{"window":"w1","region":{"focused":false}},"note":"The focus stays where the user has it: no region-focus came before the reply."},
    {"user":{"action":"focusHost","window":"h1","focused":false},"note":"The page holds no focus."},
    {"send":{"id":{"$id":"p2"},"kind":"present","window":"w1"},"connection":"c1"},
    {"receive":{"id":{"$id":"p2"},"ok":true,"outcome":"success"},"connection":"c1"},
    {"receive":{"kind":"region-focus","window":"w1","focus":"enter","direction":"programmatic"},"connection":"c1"},
    {"receive":{"kind":"activity","window":"w1","active":true,"minimized":false,"visible":true},"connection":"c1"}
  ]
}
