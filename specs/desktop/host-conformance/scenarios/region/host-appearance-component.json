{
  "format": "runic.host.scenario/1",
  "id": "region.host-appearance-component.v1",
  "contract": {"id":"runic-host","version":1},
  "set": "region",
  "roles": ["host"],
  "description": "EmbedComponent with the override colour scheme dark: the window-open reply carries the override, and the host's hosted-region-content to its page carries colorScheme dark. SetAppearanceAsync with the light scheme pushes region-appearance with the new override as a whole, returns true, and updates the page's colour scheme.",
  "requires": ["region/1","region-component/1","region-appearance/1"],
  "ids": {
    "c1": {"kind":"connection"},
    "hello": {"kind":"request"},
    "open-w1": {"kind":"request"},
    "attach-1": {"kind":"request"}
  },
  "arrange": {"limits":{"startTimeout":2000,"stopTimeout":2000,"unauthenticatedTimeout":1000},"host":{"name":"Conformance Host","version":"1.0.0","embed":"check","embedComponent":true,"embedOptions":{"appearance":{"colorScheme":"dark","contrast":null,"reducedMotion":null,"textScale":null,"accentColor":null,"systemColors":null}}}},
  "steps": [
    {"start":{"host":true}},
    {"offer":{"protocols":[1],"nonce":{"$secret":"nonce"},"host":{"name":"Conformance Host","version":"1.0.0"}}},
    {"line":{"channel":{"url":{"$any":"string"},"key":{"$any":"string"},"protocol":1}}},
    {"accept":"c1"},
    {"receive":{"id":{"$id":"hello"},"kind":"hello","protocol":1,"key":{"$secret":"key"},"proof":{"$secret":"host-proof"},"host":{"name":"Conformance Host","version":"1.0.0"},"features":{"$any":"array"},"locale":{"$any":["string","null"]},"languages":{"$any":"array"},"appearance":{"$any":["object","null"]}},"connection":"c1"},
    {"send":{"id":{"$id":"hello"},"ok":true,"protocol":1,"proof":{"$secret":"guest-proof"},"guest":{"name":"Conformance Guest","version":"1.0.0","applicationId":"dev.runic.conformance-guest"},"features":["menus/1","dialogs/1","window-services/1","region/1","region-component/1","region-appearance/1"]},"connection":"c1"},
    {"expect":{"started":true}},
    {"user":{"action":"declareRegion","window":"h1","name":"check"}},
    {"send":{"id":{"$id":"open-w1"},"kind":"window-open","window":"w1","type":"Conformance.Check","url":"http://127.0.0.1:38211/_runic_launch/AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA","owner":null,"modality":"none","guardClose":true,"permissions":[]},"connection":"c1"},
    {"receive":{"id":{"$id":"open-w1"},"ok":true,"presentation":"region","features":["present","document-edited","activity","owned-windows"],"activity":{"active":false,"minimized":false,"visible":false},"region":{"width":800,"height":520,"scale":1.5},"appearance":{"colorScheme":"dark","contrast":null,"reducedMotion":null,"textScale":null,"accentColor":null,"systemColors":null}},"connection":"c1"},
    {"receive":{"id":{"$id":"attach-1"},"kind":"region-attach","window":"w1","embedding":"component","embedder":{"$any":"string"},"width":800,"height":520,"scale":1.5,"sizing":"fill","allowSameSite":true},"connection":"c1"},
    {"send":{"id":{"$id":"attach-1"},"ok":true,"component":{"module":"http://127.0.0.1:40117/w1/_runic_component/component.js","url":"ws://127.0.0.1:40117/w1/_webui_ws_connect","token":"CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC","sameSite":true}},"connection":"c1"},
    {"receive":{"kind":"activity","window":"w1","active":false,"minimized":false,"visible":true},"connection":"c1"},
    {"expect":{"window":"h1","page":{"name":"check","shows":"component","colorScheme":"dark"}}},
    {"user":{"action":"setRegionAppearance","window":"w1","appearance":{"colorScheme":"light","contrast":"more","reducedMotion":null,"textScale":null,"accentColor":null,"systemColors":null}}},
    {"receive":{"kind":"region-appearance","window":"w1","appearance":{"colorScheme":"light","contrast":"more","reducedMotion":null,"textScale":null,"accentColor":null,"systemColors":null}},"connection":"c1"},
    {"expect":{"applied":true}},
    {"expect":{"window":"h1","page":{"name":"check","shows":"component","colorScheme":"light"}}},
    {"user":{"action":"setRegionAppearance","window":"w1","appearance":null}},
    {"receive":{"kind":"region-appearance","window":"w1","appearance":null},"connection":"c1"},
    {"expect":{"applied":true}},
    {"expect":{"window":"h1","page":{"name":"check","shows":"component","colorScheme":null}}}
  ]
}
