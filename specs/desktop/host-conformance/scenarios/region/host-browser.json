{
  "format": "runic.host.scenario/1",
  "id": "region.host-browser.v1",
  "contract": {"id":"runic-host","version":1},
  "set": "region",
  "roles": ["host"],
  "description": "A browser (serve-only) host lists region/1 and region-component/1 alone in its hello, shows a guest's window only in a region, without present or owned windows, attaches it with browser true and never allows the same site, answers present and announce unavailable with backend-unavailable, and refuses a window of the guest's own.",
  "requires": ["region/1"],
  "ids": {
    "c1": {"kind":"connection"},
    "hello": {"kind":"request"},
    "open-w1": {"kind":"request"},
    "open-w2": {"kind":"request"},
    "attach-1": {"kind":"request"},
    "p1": {"kind":"request"},
    "p2": {"kind":"request"},
    "f1": {"kind":"request"}
  },
  "arrange": {"limits":{"startTimeout":2000,"stopTimeout":2000,"unauthenticatedTimeout":1000},"host":{"name":"Conformance Host","version":"1.0.0","embed":"check","browser":true}},
  "steps": [
    {"start":{"host":true}},
    {"offer":{"protocols":[1],"nonce":{"$secret":"nonce"},"host":{"name":"Conformance Host","version":"1.0.0"}}},
    {"line":{"channel":{"url":{"$any":"string"},"key":{"$any":"string"},"protocol":1}}},
    {"accept":"c1"},
    {"receive":{"id":{"$id":"hello"},"kind":"hello","protocol":1,"key":{"$secret":"key"},"proof":{"$secret":"host-proof"},"host":{"name":"Conformance Host","version":"1.0.0"},"features":["region/1","region-component/1"],"locale":{"$any":["string","null"]},"languages":{"$any":"array"},"appearance":{"$any":["object","null"]}},"connection":"c1"},
    {"send":{"id":{"$id":"hello"},"ok":true,"protocol":1,"proof":{"$secret":"guest-proof"},"guest":{"name":"Conformance Guest","version":"1.0.0","applicationId":"dev.runic.conformance-guest"},"features":["menus/1","dialogs/1","window-services/1","region/1"]},"connection":"c1"},
    {"expect":{"started":true}},
    {"user":{"action":"declareRegion","window":"h1","name":"check"},"note":"The host's page runs in the user's browser; no native window shows it."},
    {"send":{"id":{"$id":"open-w1"},"kind":"window-open","window":"w1","type":"Conformance.Check","url":"http://127.0.0.1:38211/_runic_launch/AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA","owner":null,"modality":"none","guardClose":true,"permissions":[]},"connection":"c1"},
    {"receive":{"id":{"$id":"open-w1"},"ok":true,"presentation":"region","features":["document-edited","activity"],"activity":{"active":false,"minimized":false,"visible":false},"region":{"width":800,"height":520,"scale":1.5}},"connection":"c1"},
    {"receive":{"id":{"$id":"attach-1"},"kind":"region-attach","window":"w1","embedding":"frame","embedder":{"$any":"string"},"width":800,"height":520,"scale":1.5,"sizing":"fill","allowSameSite":false,"browser":true},"connection":"c1"},
    {"send":{"id":{"$id":"attach-1"},"ok":true,"frame":{"url":"http://[::1]:40117/_runic_frame/AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA","sameSite":false}},"connection":"c1"},
    {"receive":{"kind":"activity","window":"w1","active":false,"minimized":false,"visible":true},"connection":"c1"},
    {"send":{"kind":"region-page","window":"w1","page":"connected"},"connection":"c1"},
    {"expect":{"window":"w1","region":{"state":"attached"}}},
    {"user":{"action":"focusRegion","window":"h1","name":"check","source":"tab"},"note":"The page's focus is the only activity a browser reports."},
    {"receive":{"kind":"region-focus","window":"w1","focus":"enter","direction":"forward"},"connection":"c1"},
    {"receive":{"kind":"activity","window":"w1","active":true,"minimized":false,"visible":true},"connection":"c1"},
    {"send":{"id":{"$id":"p1"},"kind":"present","window":"w1"},"connection":"c1"},
    {"receive":{"id":{"$id":"p1"},"ok":true,"outcome":"unavailable","reason":"backend-unavailable"},"connection":"c1"},
    {"send":{"id":{"$id":"p2"},"kind":"announce","window":"w1","text":"Saved","priority":"polite"},"connection":"c1"},
    {"receive":{"id":{"$id":"p2"},"ok":true,"outcome":"unavailable","reason":"backend-unavailable"},"connection":"c1"},
    {"send":{"id":{"$id":"f1"},"kind":"region-focus","window":"w1","focus":"leave","direction":"next"},"connection":"c1"},
    {"receive":{"id":{"$id":"f1"},"ok":true,"outcome":"success"},"connection":"c1"},
    {"send":{"id":{"$id":"open-w2"},"kind":"window-open","window":"w2","type":"Conformance.Settings","url":"http://127.0.0.1:38211/_runic_launch/BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB","owner":"w1","modality":"none","guardClose":false,"permissions":[]},"connection":"c1","note":"The policy opens an owned window in a window of its own, which a browser host cannot show."},
    {"receive":{"id":{"$id":"open-w2"},"ok":false,"error":{"kind":"rejected","reason":"refused","message":{"$any":"string"}}},"connection":"c1"}
  ]
}
