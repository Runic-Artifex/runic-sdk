{
  "format": "runic.host.scenario/1",
  "id": "region.host-set-title-rate.v1",
  "contract": {"id":"runic-host","version":1},
  "set": "region",
  "roles": ["host"],
  "description": "A region window's set-title names the region's frame; the host allows 10 a second after a burst of 10 and rejects the 11th with capacity, and a title longer than 1,024 characters with invalid-request.",
  "requires": ["region/1"],
  "ids": {
    "c1": {"kind":"connection"},
    "hello": {"kind":"request"},
    "open-w1": {"kind":"request"},
    "attach-1": {"kind":"request"},
    "bad": {"kind":"request"},
    "t1": {"kind":"request"},
    "t2": {"kind":"request"},
    "t3": {"kind":"request"},
    "t4": {"kind":"request"},
    "t5": {"kind":"request"},
    "t6": {"kind":"request"},
    "t7": {"kind":"request"},
    "t8": {"kind":"request"},
    "t9": {"kind":"request"},
    "t10": {"kind":"request"},
    "t11": {"kind":"request"}
  },
  "arrange": {"limits":{"startTimeout":2000,"stopTimeout":2000,"unauthenticatedTimeout":1000},"host":{"name":"Conformance Host","version":"1.0.0","embed":"check"}},
  "steps": [
    {"start":{"host":true}},
    {"offer":{"protocols":[1],"nonce":{"$secret":"nonce"},"host":{"name":"Conformance Host","version":"1.0.0"}}},
    {"line":{"channel":{"url":{"$any":"string"},"key":{"$any":"string"},"protocol":1}}},
    {"accept":"c1"},
    {"receive":{"id":{"$id":"hello"},"kind":"hello","protocol":1,"key":{"$secret":"key"},"proof":{"$secret":"host-proof"},"host":{"name":"Conformance Host","version":"1.0.0"},"features":{"$any":"array"},"locale":{"$any":["string","null"]},"languages":{"$any":"array"},"appearance":{"$any":["object","null"]}},"connection":"c1"},
    {"send":{"id":{"$id":"hello"},"ok":true,"protocol":1,"proof":{"$secret":"guest-proof"},"guest":{"name":"Conformance Guest","version":"1.0.0","applicationId":"dev.runic.conformance-guest"},"features":["menus/1","dialogs/1","window-services/1","region/1"]},"connection":"c1"},
    {"expect":{"started":true}},
    {"user":{"action":"declareRegion","window":"h1","name":"check"}},
    {"send":{"id":{"$id":"open-w1"},"kind":"window-open","window":"w1","type":"Conformance.Check","url":"http://127.0.0.1:38211/_runic_launch/AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA","owner":null,"modality":"none","guardClose":true,"permissions":[]},"connection":"c1"},
    {"receive":{"id":{"$id":"open-w1"},"ok":true,"presentation":"region","features":["present","document-edited","activity","owned-windows"],"activity":{"active":false,"minimized":false,"visible":false},"region":{"width":800,"height":520,"scale":1.5}},"connection":"c1"},
    {"receive":{"id":{"$id":"attach-1"},"kind":"region-attach","window":"w1","embedding":"frame","embedder":{"$any":"string"},"width":800,"height":520,"scale":1.5,"sizing":"fill","allowSameSite":true},"connection":"c1"},
    {"send":{"id":{"$id":"attach-1"},"ok":true,"frame":{"url":"http://[::1]:40117/_runic_frame/AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA","sameSite":false}},"connection":"c1"},
    {"receive":{"kind":"activity","window":"w1","active":false,"minimized":false,"visible":true},"connection":"c1"},
    {"send":{"kind":"region-page","window":"w1","page":"connected"},"connection":"c1"},
    {"expect":{"window":"w1","region":{"state":"attached"}}},
    {"send":{"id":{"$id":"t1"},"kind":"set-title","window":"w1","title":"Step 1"},"connection":"c1"},
    {"receive":{"id":{"$id":"t1"},"ok":true,"outcome":"success"},"connection":"c1"},
    {"send":{"id":{"$id":"t2"},"kind":"set-title","window":"w1","title":"Step 2"},"connection":"c1"},
    {"receive":{"id":{"$id":"t2"},"ok":true,"outcome":"success"},"connection":"c1"},
    {"send":{"id":{"$id":"t3"},"kind":"set-title","window":"w1","title":"Step 3"},"connection":"c1"},
    {"receive":{"id":{"$id":"t3"},"ok":true,"outcome":"success"},"connection":"c1"},
    {"send":{"id":{"$id":"t4"},"kind":"set-title","window":"w1","title":"Step 4"},"connection":"c1"},
    {"receive":{"id":{"$id":"t4"},"ok":true,"outcome":"success"},"connection":"c1"},
    {"send":{"id":{"$id":"t5"},"kind":"set-title","window":"w1","title":"Step 5"},"connection":"c1"},
    {"receive":{"id":{"$id":"t5"},"ok":true,"outcome":"success"},"connection":"c1"},
    {"send":{"id":{"$id":"t6"},"kind":"set-title","window":"w1","title":"Step 6"},"connection":"c1"},
    {"receive":{"id":{"$id":"t6"},"ok":true,"outcome":"success"},"connection":"c1"},
    {"send":{"id":{"$id":"t7"},"kind":"set-title","window":"w1","title":"Step 7"},"connection":"c1"},
    {"receive":{"id":{"$id":"t7"},"ok":true,"outcome":"success"},"connection":"c1"},
    {"send":{"id":{"$id":"t8"},"kind":"set-title","window":"w1","title":"Step 8"},"connection":"c1"},
    {"receive":{"id":{"$id":"t8"},"ok":true,"outcome":"success"},"connection":"c1"},
    {"send":{"id":{"$id":"t9"},"kind":"set-title","window":"w1","title":"Step 9"},"connection":"c1"},
    {"receive":{"id":{"$id":"t9"},"ok":true,"outcome":"success"},"connection":"c1"},
    {"send":{"id":{"$id":"t10"},"kind":"set-title","window":"w1","title":"Step 10"},"connection":"c1"},
    {"receive":{"id":{"$id":"t10"},"ok":true,"outcome":"success"},"connection":"c1"},
    {"send":{"id":{"$id":"t11"},"kind":"set-title","window":"w1","title":"Step 11"},"connection":"c1"},
    {"receive":{"id":{"$id":"t11"},"ok":false,"error":{"kind":"rejected","reason":"capacity","message":{"$any":"string"}}},"connection":"c1","note":"The 11th within a second after a burst of 10."},
    {"expect":{"window":"w1","region":{"title":"Step 10"}}},
    {"expect":{"window":"h1","page":{"name":"check","title":"Step 10"}},"note":"The page names the frame with the guest's title."},
    {"send":{"id":{"$id":"bad"},"kind":"set-title","window":"w1","title":""},"connection":"c1"},
    {"receive":{"id":{"$id":"bad"},"ok":false,"error":{"kind":"rejected","reason":"invalid-request","message":{"$any":"string"}}},"connection":"c1"}
  ]
}
