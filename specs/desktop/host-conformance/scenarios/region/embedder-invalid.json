{
  "format": "runic.host.scenario/1",
  "id": "region.embedder-invalid.v1",
  "contract": {"id":"runic-host","version":1},
  "set": "region",
  "roles": ["guest"],
  "description": "An embedder with a path, another scheme, a host other than a loopback literal or localhost, no port, a port with a leading zero or over 256 characters, and a size or scale out of range, are each rejected with invalid-request.",
  "requires": ["region/1"],
  "ids": {
    "c1": {"kind":"connection"},
    "hello": {"kind":"request"},
    "w1": {"kind":"window"},
    "open-w1": {"kind":"request"},
    "open-w1-action": {"kind":"action"},
    "attach-1": {"kind":"request"},
    "attach-2": {"kind":"request"},
    "attach-3": {"kind":"request"},
    "attach-4": {"kind":"request"},
    "attach-5": {"kind":"request"},
    "attach-6": {"kind":"request"},
    "attach-size": {"kind":"request"},
    "attach-scale": {"kind":"request"}
  },
  "arrange": {"limits":{"startTimeout":2000,"stopTimeout":2000,"unauthenticatedTimeout":1000},"application":{"name":"Conformance Guest","version":"1.0.0","applicationId":"dev.runic.conformance-guest"}},
  "steps": [
    {"start":{"offer":{"protocols":[1],"nonce":{"$secret":"nonce"},"host":{"name":"Conformance Host","version":"1.0.0"}}}},
    {"line":{"channel":{"url":{"$any":"string"},"key":{"$any":"string"},"protocol":1}}},
    {"connect":"c1"},
    {"send":{"id":{"$id":"hello"},"kind":"hello","protocol":1,"key":{"$secret":"key"},"proof":{"$secret":"host-proof"},"host":{"name":"Conformance Host","version":"1.0.0"},"features":["region/1"],"locale":null,"languages":[],"appearance":null},"connection":"c1"},
    {"receive":{"id":{"$id":"hello"},"ok":true,"protocol":1,"proof":{"$secret":"guest-proof"},"guest":{"name":"Conformance Guest","version":"1.0.0","applicationId":"dev.runic.conformance-guest"},"features":{"$any":"array","default":[]}},"connection":"c1"},
    {"guest":{"action":"open","window":"w1","type":"Main"},"as":"open-w1-action"},
    {"receive":{"id":{"$id":"open-w1"},"kind":"window-open","window":{"$id":"w1"},"type":{"$any":"string","default":"Conformance.Main"},"url":{"$secret":"launch-url"},"width":{"$any":"integer","default":800},"height":{"$any":"integer","default":600},"owner":null,"modality":"none","guardClose":false,"permissions":[]},"connection":"c1"},
    {"send":{"id":{"$id":"open-w1"},"ok":true,"presentation":"region","features":["present","document-edited","activity","owned-windows"],"activity":{"active":false,"minimized":false,"visible":false},"region":null},"connection":"c1"},
    {"expect":{"action":"open-w1-action","opened":true}},
    {"send":{"id":{"$id":"attach-1"},"kind":"region-attach","window":{"$id":"w1"},"embedding":"frame","embedder":"http://127.0.0.1:38200/index.html","width":800,"height":520,"scale":1.5,"sizing":"fill"},"connection":"c1"},
    {"receive":{"id":{"$id":"attach-1"},"ok":false,"error":{"kind":"rejected","reason":"invalid-request","message":{"$any":"string"}}},"connection":"c1"},
    {"send":{"id":{"$id":"attach-2"},"kind":"region-attach","window":{"$id":"w1"},"embedding":"frame","embedder":"https://127.0.0.1:38200","width":800,"height":520,"scale":1.5,"sizing":"fill"},"connection":"c1"},
    {"receive":{"id":{"$id":"attach-2"},"ok":false,"error":{"kind":"rejected","reason":"invalid-request","message":{"$any":"string"}}},"connection":"c1"},
    {"send":{"id":{"$id":"attach-3"},"kind":"region-attach","window":{"$id":"w1"},"embedding":"frame","embedder":"http://example.com:38200","width":800,"height":520,"scale":1.5,"sizing":"fill"},"connection":"c1"},
    {"receive":{"id":{"$id":"attach-3"},"ok":false,"error":{"kind":"rejected","reason":"invalid-request","message":{"$any":"string"}}},"connection":"c1"},
    {"send":{"id":{"$id":"attach-4"},"kind":"region-attach","window":{"$id":"w1"},"embedding":"frame","embedder":"http://127.0.0.1","width":800,"height":520,"scale":1.5,"sizing":"fill"},"connection":"c1"},
    {"receive":{"id":{"$id":"attach-4"},"ok":false,"error":{"kind":"rejected","reason":"invalid-request","message":{"$any":"string"}}},"connection":"c1"},
    {"send":{"id":{"$id":"attach-5"},"kind":"region-attach","window":{"$id":"w1"},"embedding":"frame","embedder":"http://127.0.0.1:038200","width":800,"height":520,"scale":1.5,"sizing":"fill"},"connection":"c1"},
    {"receive":{"id":{"$id":"attach-5"},"ok":false,"error":{"kind":"rejected","reason":"invalid-request","message":{"$any":"string"}}},"connection":"c1"},
    {"send":{"id":{"$id":"attach-6"},"kind":"region-attach","window":{"$id":"w1"},"embedding":"frame","embedder":"http://aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.localhost:38200","width":800,"height":520,"scale":1.5,"sizing":"fill"},"connection":"c1"},
    {"receive":{"id":{"$id":"attach-6"},"ok":false,"error":{"kind":"rejected","reason":"invalid-request","message":{"$any":"string"}}},"connection":"c1"},
    {"send":{"id":{"$id":"attach-size"},"kind":"region-attach","window":{"$id":"w1"},"embedding":"frame","embedder":"http://127.0.0.1:38200","width":32768,"height":520,"scale":1.5,"sizing":"fill"},"connection":"c1"},
    {"receive":{"id":{"$id":"attach-size"},"ok":false,"error":{"kind":"rejected","reason":"invalid-request","message":{"$any":"string"}}},"connection":"c1"},
    {"send":{"id":{"$id":"attach-scale"},"kind":"region-attach","window":{"$id":"w1"},"embedding":"frame","embedder":"http://127.0.0.1:38200","width":800,"height":520,"scale":9,"sizing":"fill"},"connection":"c1"},
    {"receive":{"id":{"$id":"attach-scale"},"ok":false,"error":{"kind":"rejected","reason":"invalid-request","message":{"$any":"string"}}},"connection":"c1"}
  ]
}
