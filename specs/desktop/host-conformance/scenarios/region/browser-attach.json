{
  "format": "runic.host.scenario/1",
  "id": "region.browser-attach.v1",
  "contract": {"id":"runic-host","version":1},
  "set": "region",
  "roles": ["guest"],
  "description": "A region-attach for a browser host's page (browser true, allowSameSite false) answers a frame launch address cross-site to the embedder, with sameSite false; a browser member that is not a boolean is rejected with invalid-request.",
  "requires": ["region/1"],
  "ids": {
    "c1": {"kind":"connection"},
    "hello": {"kind":"request"},
    "w1": {"kind":"window"},
    "open-w1": {"kind":"request"},
    "open-w1-action": {"kind":"action"},
    "attach-1": {"kind":"request"},
    "attach-2": {"kind":"request"}
  },
  "arrange": {"limits":{"startTimeout":2000,"stopTimeout":2000,"unauthenticatedTimeout":1000},"application":{"name":"Conformance Guest","version":"1.0.0","applicationId":"dev.runic.conformance-guest"}},
  "steps": [
    {"start":{"offer":{"protocols":[1],"nonce":{"$secret":"nonce"},"host":{"name":"Conformance Host","version":"1.0.0"}}}},
    {"line":{"channel":{"url":{"$any":"string"},"key":{"$any":"string"},"protocol":1}}},
    {"connect":"c1"},
    {"send":{"id":{"$id":"hello"},"kind":"hello","protocol":1,"key":{"$secret":"key"},"proof":{"$secret":"host-proof"},"host":{"name":"Conformance Host","version":"1.0.0"},"features":["region/1"],"locale":null,"languages":[],"appearance":null},"connection":"c1"},
    {"receive":{"id":{"$id":"hello"},"ok":true,"protocol":1,"proof":{"$secret":"guest-proof"},"guest":{"name":"Conformance Guest","version":"1.0.0","applicationId":"dev.runic.conformance-guest"},"features":{"$any":"array","default":[]}},"connection":"c1"},
    {"guest":{"action":"open","window":"w1","type":"Main"},"as":"open-w1-action"},
    {"receive":{"id":{"$id":"open-w1"},"kind":"window-open","window":{"$id":"w1"},"type":{"$any":"string","default":"Conformance.Main"},"url":{"$secret":"launch-url"},"width":{"$any":"integer","default":800},"height":{"$any":"integer","default":600},"owner":null,"modality":"none","guardClose":false,"permissions":[]},"connection":"c1"},
    {"send":{"id":{"$id":"open-w1"},"ok":true,"presentation":"region","features":["document-edited","activity"],"activity":{"active":false,"minimized":false,"visible":false},"region":null},"connection":"c1"},
    {"expect":{"action":"open-w1-action","opened":true}},
    {"send":{"id":{"$id":"attach-1"},"kind":"region-attach","window":{"$id":"w1"},"embedding":"frame","embedder":"http://127.0.0.1:38200","width":800,"height":520,"scale":1.5,"sizing":"fill","allowSameSite":false,"browser":"yes"},"connection":"c1"},
    {"receive":{"id":{"$id":"attach-1"},"ok":false,"error":{"kind":"rejected","reason":"invalid-request","message":{"$any":"string"}}},"connection":"c1"},
    {"send":{"id":{"$id":"attach-2"},"kind":"region-attach","window":{"$id":"w1"},"embedding":"frame","embedder":"http://127.0.0.1:38200","width":800,"height":520,"scale":1.5,"sizing":"fill","allowSameSite":false,"browser":true},"connection":"c1"},
    {"receive":{"id":{"$id":"attach-2"},"ok":true,"frame":{"url":{"$secret":"frame-url"},"sameSite":false}},"connection":"c1"},
    {"frame":{"request":"launch","status":303}}
  ]
}
