{
  "format": "runic.host.scenario/1",
  "id": "region.component-attach.v1",
  "contract": {"id":"runic-host","version":1},
  "set": "region",
  "roles": ["guest"],
  "description": "With both opt-ins, region-attach with embedding component answers the component's module, its surface's WebSocket address and a new component token, from the guest's own 127.0.0.1 listener when the embedder is of that site and allows it. The module is served to the embedder alone with CORS; the WebSocket is admitted only from the embedder's Origin with the token, one page at a time; after region-detach both are refused.",
  "requires": ["region/1","region-component/1"],
  "ids": {
    "c1": {"kind":"connection"},
    "hello": {"kind":"request"},
    "w1": {"kind":"window"},
    "open-w1": {"kind":"request"},
    "open-w1-action": {"kind":"action"},
    "attach-1": {"kind":"request"}
  },
  "arrange": {"limits":{"startTimeout":2000,"stopTimeout":2000,"unauthenticatedTimeout":1000},"application":{"name":"Conformance Guest","version":"1.0.0","applicationId":"dev.runic.conformance-guest","allowComponentEmbedding":true,"componentBuild":true}},
  "steps": [
    {"start":{"offer":{"protocols":[1],"nonce":{"$secret":"nonce"},"host":{"name":"Conformance Host","version":"1.0.0"}}}},
    {"line":{"channel":{"url":{"$any":"string"},"key":{"$any":"string"},"protocol":1}}},
    {"connect":"c1"},
    {"send":{"id":{"$id":"hello"},"kind":"hello","protocol":1,"key":{"$secret":"key"},"proof":{"$secret":"host-proof"},"host":{"name":"Conformance Host","version":"1.0.0"},"features":["region/1","region-component/1"],"locale":null,"languages":[],"appearance":null},"connection":"c1"},
    {"receive":{"id":{"$id":"hello"},"ok":true,"protocol":1,"proof":{"$secret":"guest-proof"},"guest":{"name":"Conformance Guest","version":"1.0.0","applicationId":"dev.runic.conformance-guest"},"features":["menus/1","dialogs/1","window-services/1","region/1","region-component/1","region-appearance/1"]},"connection":"c1"},
    {"guest":{"action":"open","window":"w1","type":"Main"},"as":"open-w1-action"},
    {"receive":{"id":{"$id":"open-w1"},"kind":"window-open","window":{"$id":"w1"},"type":{"$any":"string","default":"Conformance.Main"},"url":{"$secret":"launch-url"},"width":{"$any":"integer","default":800},"height":{"$any":"integer","default":600},"owner":null,"modality":"none","guardClose":false,"permissions":[]},"connection":"c1"},
    {"send":{"id":{"$id":"open-w1"},"ok":true,"presentation":"region","features":["present","document-edited","activity","owned-windows"],"activity":{"active":false,"minimized":false,"visible":false},"region":null},"connection":"c1"},
    {"expect":{"action":"open-w1-action","opened":true}},
    {"send":{"id":{"$id":"attach-1"},"kind":"region-attach","window":{"$id":"w1"},"embedding":"component","embedder":"http://127.0.0.1:38200","width":800,"height":520,"scale":1.5,"sizing":"fill","allowSameSite":true},"connection":"c1"},
    {"receive":{"id":{"$id":"attach-1"},"ok":true,"component":{"module":{"$secret":"component-module"},"url":{"$secret":"component-url"},"token":{"$secret":"component-token"},"sameSite":true}},"connection":"c1"},
    {"component":{"request":"module","status":200}},
    {"component":{"request":"module","origin":"http://127.0.0.1:38201","status":403},"note":"Another origin gets no component build."},
    {"component":{"request":"upgrade","origin":"http://127.0.0.1:38201","token":{"$secret":"component-token"},"status":403},"note":"Another origin, even with the token."},
    {"component":{"request":"upgrade","status":401},"note":"The embedder without the token."},
    {"component":{"request":"upgrade","token":"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA","status":401},"note":"The embedder with another token."},
    {"component":{"request":"upgrade","token":{"$secret":"component-token"},"status":101}},
    {"receive":{"kind":"region-page","window":{"$id":"w1"},"page":"connected"},"connection":"c1"},
    {"component":{"request":"upgrade","token":{"$secret":"component-token"},"status":403},"note":"One page at a time."},
    {"send":{"kind":"region-detach","window":{"$id":"w1"},"reason":"removed"},"connection":"c1"},
    {"component":{"request":"upgrade","token":{"$secret":"component-token"},"refused":true}},
    {"component":{"request":"module","status":403}}
  ]
}
