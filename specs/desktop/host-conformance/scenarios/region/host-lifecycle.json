{
  "format": "runic.host.scenario/1",
  "id": "region.host-lifecycle.v1",
  "contract": {"id":"runic-host","version":1},
  "set": "region",
  "roles": ["host"],
  "description": "A window the host's policy embeds opens without a page and attaches when a host page declares its region; the page removing the region detaches it, declaring it again attaches it with a new frame launch address, and the window's close empties the region.",
  "requires": ["region/1"],
  "ids": {
    "c1": {"kind":"connection"},
    "hello": {"kind":"request"},
    "open-w1": {"kind":"request"},
    "attach-1": {"kind":"request"},
    "attach-2": {"kind":"request"},
    "attach-3": {"kind":"request"}
  },
  "arrange": {"limits":{"startTimeout":2000,"stopTimeout":2000,"unauthenticatedTimeout":1000},"host":{"name":"Conformance Host","version":"1.0.0","embed":"check"}},
  "steps": [
    {"start":{"host":true}},
    {"offer":{"protocols":[1],"nonce":{"$secret":"nonce"},"host":{"name":"Conformance Host","version":"1.0.0"}}},
    {"line":{"channel":{"url":{"$any":"string"},"key":{"$any":"string"},"protocol":1}}},
    {"accept":"c1"},
    {"receive":{"id":{"$id":"hello"},"kind":"hello","protocol":1,"key":{"$secret":"key"},"proof":{"$secret":"host-proof"},"host":{"name":"Conformance Host","version":"1.0.0"},"features":{"$any":"array"},"locale":{"$any":["string","null"]},"languages":{"$any":"array"},"appearance":{"$any":["object","null"]}},"connection":"c1"},
    {"send":{"id":{"$id":"hello"},"ok":true,"protocol":1,"proof":{"$secret":"guest-proof"},"guest":{"name":"Conformance Guest","version":"1.0.0","applicationId":"dev.runic.conformance-guest"},"features":["menus/1","dialogs/1","window-services/1","region/1"]},"connection":"c1"},
    {"expect":{"started":true}},
    {"user":{"action":"declareRegion","window":"h1","name":"check"},"note":"The host page declares the region before the guest opens its window."},
    {"expect":{"window":"h1","page":{"name":"check","shows":"waiting"}}},
    {"send":{"id":{"$id":"open-w1"},"kind":"window-open","window":"w1","type":"Conformance.Check","url":"http://127.0.0.1:38211/_runic_launch/AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA","owner":null,"modality":"none","guardClose":true,"permissions":[]},"connection":"c1"},
    {"receive":{"id":{"$id":"open-w1"},"ok":true,"presentation":"region","features":["present","document-edited","activity","owned-windows"],"activity":{"active":false,"minimized":false,"visible":false},"region":{"width":800,"height":520,"scale":1.5}},"connection":"c1"},
    {"receive":{"id":{"$id":"attach-1"},"kind":"region-attach","window":"w1","embedding":"frame","embedder":{"$any":"string"},"width":800,"height":520,"scale":1.5,"sizing":"fill","allowSameSite":true},"connection":"c1"},
    {"send":{"id":{"$id":"attach-1"},"ok":true,"frame":{"url":"http://[::1]:40117/_runic_frame/AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA","sameSite":false}},"connection":"c1"},
    {"receive":{"kind":"activity","window":"w1","active":false,"minimized":false,"visible":true},"connection":"c1"},
    {"expect":{"window":"h1","page":{"name":"check","shows":"content","src":"http://[::1]:40117/_runic_frame/AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA","allow":""}}},
    {"expect":{"window":"w1","region":{"state":"loading"}}},
    {"send":{"kind":"region-page","window":"w1","page":"connected"},"connection":"c1"},
    {"expect":{"window":"w1","region":{"state":"attached"}}},
    {"user":{"action":"removeRegion","window":"h1","name":"check"},"note":"The page removes the region, such as for another wizard step."},
    {"receive":{"kind":"region-detach","window":"w1","reason":"removed"},"connection":"c1"},
    {"receive":{"kind":"activity","window":"w1","active":false,"minimized":false,"visible":false},"connection":"c1"},
    {"expect":{"window":"w1","region":{"state":"detached"}}},
    {"user":{"action":"declareRegion","window":"h1","name":"check"},"note":"The step comes back: the window attaches again with a new code."},
    {"receive":{"id":{"$id":"attach-2"},"kind":"region-attach","window":"w1","embedding":"frame","embedder":{"$any":"string"},"width":800,"height":520,"scale":1.5,"sizing":"fill","allowSameSite":true},"connection":"c1"},
    {"send":{"id":{"$id":"attach-2"},"ok":true,"frame":{"url":"http://[::1]:40117/_runic_frame/BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB","sameSite":false}},"connection":"c1"},
    {"receive":{"kind":"activity","window":"w1","active":false,"minimized":false,"visible":true},"connection":"c1"},
    {"expect":{"window":"h1","page":{"name":"check","shows":"content","src":"http://[::1]:40117/_runic_frame/BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB"}}},
    {"user":{"action":"removeRegion","window":"h1","name":"check","reason":"reload"},"note":"The page reloads."},
    {"receive":{"kind":"region-detach","window":"w1","reason":"reload"},"connection":"c1"},
    {"receive":{"kind":"activity","window":"w1","active":false,"minimized":false,"visible":false},"connection":"c1"},
    {"user":{"action":"declareRegion","window":"h1","name":"check"}},
    {"receive":{"id":{"$id":"attach-3"},"kind":"region-attach","window":"w1","embedding":"frame","embedder":{"$any":"string"},"width":800,"height":520,"scale":1.5,"sizing":"fill","allowSameSite":true},"connection":"c1"},
    {"send":{"id":{"$id":"attach-3"},"ok":true,"frame":{"url":"http://[::1]:40117/_runic_frame/CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC","sameSite":false}},"connection":"c1"},
    {"receive":{"kind":"activity","window":"w1","active":false,"minimized":false,"visible":true},"connection":"c1"},
    {"send":{"kind":"window-closed","window":"w1"},"connection":"c1","note":"The guest closes its Window."},
    {"expect":{"window":"w1","closed":true}},
    {"expect":{"window":"w1","region":{"state":"ended"}}},
    {"expect":{"window":"h1","page":{"name":"check","shows":"ended"}}}
  ]
}
