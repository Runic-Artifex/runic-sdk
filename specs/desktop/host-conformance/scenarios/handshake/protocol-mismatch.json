{
  "format": "runic.host.scenario/1",
  "id": "handshake.protocol-mismatch.v1",
  "contract": {"id":"runic-host","version":1},
  "set": "handshake",
  "roles": ["guest"],
  "description": "An authenticated hello of another protocol version is answered failed with protocol-mismatch, with the guest proof, and closed with 1002; the key is spent and the guest exits.",
  "ids": {
    "c1": {"kind":"connection"},
    "hello": {"kind":"request"}
  },
  "arrange": {"limits":{"startTimeout":2000,"stopTimeout":2000,"unauthenticatedTimeout":1000},"application":{"name":"Conformance Guest","version":"1.0.0","applicationId":"dev.runic.conformance-guest"}},
  "steps": [
    {"start":{"offer":{"protocols":[1,2],"nonce":{"$secret":"nonce"},"host":{"name":"Conformance Host","version":"1.0.0"}}}},
    {"line":{"channel":{"url":{"$any":"string"},"key":{"$any":"string"},"protocol":1}}},
    {"connect":"c1"},
    {"send":{"id":{"$id":"hello"},"kind":"hello","protocol":2,"key":{"$secret":"key"},"proof":{"$secret":"host-proof"},"host":{"name":"Conformance Host","version":"1.0.0"},"features":[],"locale":null,"languages":[],"appearance":null},"connection":"c1"},
    {"receive":{"id":{"$id":"hello"},"ok":false,"protocol":1,"proof":{"$secret":"guest-proof"},"error":{"kind":"failed","reason":"protocol-mismatch","message":{"$any":"string"}}},"connection":"c1"},
    {"closed":{"connection":"c1","status":1002}},
    {"expect":{"startFailure":"protocol-unsupported"}},
    {"expect":{"exited":true}}
  ]
}
