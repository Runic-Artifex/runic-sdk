{
  "format": "runic.host.scenario/1",
  "id": "handshake.oldest-pending-connection-closed.v1",
  "contract": {"id":"runic-host","version":1},
  "set": "handshake",
  "roles": ["guest"],
  "description": "With 8 connections that have not completed the handshake, a ninth closes the oldest one instead of being refused, so the host still gets in; when it authenticates, the other pending connections are closed.",
  "ids": {
    "c1": {"kind":"connection"},
    "c2": {"kind":"connection"},
    "c3": {"kind":"connection"},
    "c4": {"kind":"connection"},
    "c5": {"kind":"connection"},
    "c6": {"kind":"connection"},
    "c7": {"kind":"connection"},
    "c8": {"kind":"connection"},
    "c9": {"kind":"connection"},
    "hello": {"kind":"request"}
  },
  "arrange": {"limits":{"startTimeout":2000,"stopTimeout":2000,"unauthenticatedTimeout":5000,"helloTimeout":5000},"application":{"name":"Conformance Guest","version":"1.0.0","applicationId":"dev.runic.conformance-guest"}},
  "steps": [
    {"start":{"offer":{"protocols":[1],"nonce":{"$secret":"nonce"},"host":{"name":"Conformance Host","version":"1.0.0"}}}},
    {"line":{"channel":{"url":{"$any":"string"},"key":{"$any":"string"},"protocol":1}}},
    {"connect":"c1"},
    {"connect":"c2"},
    {"connect":"c3"},
    {"connect":"c4"},
    {"connect":"c5"},
    {"connect":"c6"},
    {"connect":"c7"},
    {"connect":"c8"},
    {"connect":"c9","note":"The ninth pending connection."},
    {"closed":{"connection":"c1"},"note":"The oldest one made room."},
    {"send":{"id":{"$id":"hello"},"kind":"hello","protocol":1,"key":{"$secret":"key"},"proof":{"$secret":"host-proof"},"host":{"name":"Conformance Host","version":"1.0.0"},"features":[],"locale":null,"languages":[],"appearance":null},"connection":"c9"},
    {"receive":{"id":{"$id":"hello"},"ok":true,"protocol":1,"proof":{"$secret":"guest-proof"},"guest":{"name":"Conformance Guest","version":"1.0.0","applicationId":"dev.runic.conformance-guest"},"features":{"$any":"array","default":[]}},"connection":"c9"},
    {"closed":{"connection":"c2"}},
    {"closed":{"connection":"c3"}},
    {"closed":{"connection":"c4"}},
    {"closed":{"connection":"c5"}},
    {"closed":{"connection":"c6"}},
    {"closed":{"connection":"c7"}},
    {"closed":{"connection":"c8"}}
  ]
}
