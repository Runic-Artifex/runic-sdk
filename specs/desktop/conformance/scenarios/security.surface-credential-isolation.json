{
  "format": "runic.desktop.conformance-scenario/1",
  "id": "security.surface-credential-isolation.v1",
  "contract": { "id": "runic.desktop.presentation", "version": 1 },
  "area": "security",
  "requires": ["session-authentication", "surface-isolation"],
  "ids": {
    "host": "host-1",
    "surfaceA": "surface-a",
    "surfaceB": "surface-b",
    "session": "session-1"
  },
  "policy": {
    "binding": "loopback",
    "origins": ["same-origin"],
    "credential": "required"
  },
  "arrange": [
    { "op": "host.createStarted", "target": "host-1" },
    { "op": "surface.createStarted", "target": "surface-a", "arguments": { "host": "host-1", "credential": "credential-a" } },
    { "op": "surface.createStarted", "target": "surface-b", "arguments": { "host": "host-1", "credential": "credential-b" } }
  ],
  "steps": [
    { "op": "session.connect", "target": "session-1", "arguments": { "surface": "surface-b", "credential": "credential-a", "origin": "same-origin" } }
  ],
  "expect": {
    "events": [
      { "type": "session.rejected", "subject": "session-1", "data": { "category": "authenticationDenied", "code": "credential-scope-mismatch" } }
    ],
    "states": [
      { "subject": "surface-a", "state": "running" },
      { "subject": "surface-b", "state": "running" },
      { "subject": "session-1", "state": "closed" }
    ],
    "outcomes": [
      { "subject": "session-1", "terminal": "failed", "category": "authenticationDenied", "code": "credential-scope-mismatch", "message": "The session credential is not valid for this surface.", "retryable": false }
    ],
    "absentEvents": [
      { "type": "session.authenticated", "subject": "session-1" },
      { "type": "capability.invoked", "subject": "surface-b" }
    ]
  }
}
