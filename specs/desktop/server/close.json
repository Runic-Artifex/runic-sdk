        },
        {
          "response": "a",
          "expect": {
            "status": 101
          }
        },
        {
          "hostSend": "a",
          "kind": "text",
          "data": {
            "text": "last"
          }
        },
        {
          "hostClose": "a",
          "code": 1001,
          "reason": "going away"
        },
        {
          "frame": "a",
          "expect": {
            "opcode": "text",
            "payload": {
              "text": "last"
            }
          }
        },
        {
          "frame": "a",
          "expect": {
            "opcode": "close",
            "code": 1001,
            "reason": "going away"
          }
        },
