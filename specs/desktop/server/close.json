{
  "format": "rax.desktop.server-vector/1",
  "id": "server.close",
  "description": "The WebSocket closing handshake (RFC 6455 sections 5.5.1, 7 and 7.4): answering and reporting the peer's close, the host's close, and close frames that break the protocol.",
  "cases": [
    {
      "id": "server.close.peer-close-answered",
      "level": "must",
      "rule": "ws-close",
      "steps": [
        {
          "connect": "a"
        },
        {
          "send": "a",
          "upgrade": {
            "target": "/ws"
          }
        },
        {
          "response": "a",
          "expect": {
            "status": 101
          }
        },
        {
          "send": "a",
          "frames": [
            {
              "opcode": "close",
              "close": {
                "code": 1000
              }
            }
          ]
        },
        {
          "frame": "a",
          "expect": {
            "opcode": "close"
          }
        },
        {
          "end": "a",
          "shutdown": true
        },
        {
          "host": "a",
          "expect": [
            {
              "type": "request",
              "websocket": true
            },
            {
              "type": "closed",
              "code": 1000,
              "reason": ""
            }
          ]
        }
      ]
    },
    {
