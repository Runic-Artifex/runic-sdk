{
  "format": "rax.desktop.server-vector/1",
  "id": "server.frames",
  "description": "WebSocket data and control frames (RFC 6455 sections 5 and 8): what the server delivers to the host, what it answers, what it writes, and how it fails a connection that breaks the protocol or the message limit.",
  "cases": [
    {
      "id": "server.frames.fragments-joined-around-a-ping",
      "level": "must",
      "rule": "ws-messages",
      "steps": [
        {
          "connect": "a"
        },
        {
          "send": "a",
          "upgrade": {
            "target": "/ws"
          }
        },
        {
          "response": "a",
          "expect": {
            "status": 101
          }
        },
        {
          "send": "a",
          "frames": [
            {
              "opcode": "binary",
              "fin": false,
              "payload": {
                "text": "ab"
              }
            },
            {
              "opcode": "ping",
              "payload": {
                "text": "ping"
              }
            },
            {
              "opcode": "continuation",
              "fin": false,
              "payload": {
                "text": "cd"
              }
            },
            {
              "opcode": "continuation",
              "payload": {
                "text": "ef"
              }
            }
          ]
        },
        {
          "frame": "a",
          "expect": {
            "opcode": "pong",
            "payload": {
              "text": "ping"
            }
          }
        },
        {
          "host": "a",
          "expect": [
            {
              "type": "request",
              "websocket": true
            },
            {
              "type": "message",
              "kind": "binary",
              "data": {
                "text": "abcdef"
              }
            }
          ]
        }
      ]
    },
