{
  "schemaVersion": 1,
  "catalog": "app",
  "code": {
    "namespace": "RunicTranslations.Examples.Localization",
    "className": "AppText",
    "visibility": "public"
  },
  "defaultLocale": "en",
  "locales": [
    { "tag": "en" },
    { "tag": "de", "fallback": "en" }
  ],
  "layers": [
    { "name": "base", "priority": 0 },
    { "name": "application", "priority": 100 }
  ],
  "validation": {
    "translationCompleteness": "error",
    "extraLocaleKeys": "error",
    "emptyValues": "error"
  },
  "runtime": {
    "unsupportedLocale": "parentsThenDefault",
    "missingKey": "throw"
  }
}
