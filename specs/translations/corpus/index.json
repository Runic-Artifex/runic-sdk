    {
      "id": "valid-minimal-source-contracts",
      "valid": true,
      "manifest": "valid/minimal/manifest.json",
      "documents": ["valid/minimal/en.json"],
      "expected": {
        "diagnostics": [],
        "catalog": "minimal",
        "locales": ["en"],
        "orderedKeys": ["Hello"],
        "effectiveValues": { "en/Hello": "Hello" }
      }
    },
    {
      "id": "valid-layer-merge-fallback-and-policies",
      "valid": true,
      "manifest": "valid/merge/manifest.json",
      "documents": [
        "valid/merge/en-application.json",
        "valid/merge/en-base-b.json",
        "valid/merge/en-gb.json",
        "valid/merge/en-base-a.json"
      ],
      "expected": {
        "diagnostics": [],
        "catalog": "merge",
        "locales": ["en", "en-GB", "fr-CA"],
        "layers": ["base", "application"],
        "orderedKeys": ["Alpha", "Common.Cancel", "Common.Save", "Zulu"],
        "effectiveValues": {
          "en/Common.Save": "Save now",
          "en-GB/Common.Cancel": "Cancel"
        },
        "fallbackValues": {
          "en-GB/Common.Save": "Save now",
          "fr-CA/Common.Save": "Save now"
        }
      }
    },
