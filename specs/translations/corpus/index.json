    "catalogSchemaVersion": 1,
    "resourceSchemaVersion": 1,
    "messageGrammarVersion": 1
  },
  "locationConvention": {
    "lineBase": 1,
    "columnBase": 1,
    "startInclusive": true,
    "endExclusive": true,
    "columnUnits": "UTF-16"
  },
  "excludedDiagnostics": [
    {
      "id": "RTR0020",
      "reason": "Output path containment and collision validation belongs to the build/CLI surface, not the Wave A pure compiler kernel."
    }
  ],
