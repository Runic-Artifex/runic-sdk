    { "id": "contract-fingerprint-mismatch", "expected": "RTR0023/contract-fingerprint-mismatch", "template": "{\"artifactVersion\":%VERSION%,\"messageGrammarVersion\":%GRAMMAR%,\"catalog\":\"%CATALOG%\",\"locale\":\"%LOCALE%\",\"contractFingerprint\":\"%OTHER_FINGERPRINT%\",\"messages\":{\"Parity.Message\":{\"astVersion\":2,\"inputs\":{\"name\":{\"type\":\"string\",\"format\":\"none\"}},\"selectors\":[{\"name\":\"who\",\"input\":\"name\",\"function\":\"literal\"}],\"variants\":[{\"matches\":{\"who\":\"*\"},\"nodes\":[{\"kind\":\"text\",\"value\":\"Hello \"},{\"kind\":\"input\",\"input\":\"name\"}]}]}}}" },
    { "id": "catalog-mismatch", "expected": "RTR0023/catalog-mismatch", "template": "{\"artifactVersion\":%VERSION%,\"messageGrammarVersion\":%GRAMMAR%,\"catalog\":\"%OTHER_CATALOG%\",\"locale\":\"%LOCALE%\",\"contractFingerprint\":\"%FINGERPRINT%\",\"messages\":{\"Parity.Message\":{\"astVersion\":2,\"inputs\":{\"name\":{\"type\":\"string\",\"format\":\"none\"}},\"selectors\":[{\"name\":\"who\",\"input\":\"name\",\"function\":\"literal\"}],\"variants\":[{\"matches\":{\"who\":\"*\"},\"nodes\":[{\"kind\":\"text\",\"value\":\"Hello \"},{\"kind\":\"input\",\"input\":\"name\"}]}]}}}" },
