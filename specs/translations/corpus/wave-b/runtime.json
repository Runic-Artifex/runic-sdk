{
  "formatVersion": 1,
  "identity": "RunicTextResources.Runtime.Conformance",
  "cases": [
    {
      "id": "fallback-is-per-key",
      "requestedLocale": "fr-CA",
      "fallbackChain": [
        "fr-CA",
        "fr",
        "en"
      ],
      "directValues": {
        "fr-CA/OnlyCanada": "ca",
        "fr/Common": "fr",
        "en/DefaultOnly": "en"
      },
      "expectedResolvedOrigins": {
        "OnlyCanada": "fr-CA",
        "Common": "fr",
        "DefaultOnly": "en"
      }
    },
    {
      "id": "unsupported-parents-then-default",
      "requestedLocale": "zh-Hant-HK-x-private",
      "declaredLocales": [
        "en",
        "zh-Hant"
      ],
      "policy": "parentsThenDefault",
      "expectedSnapshotLocale": "zh-Hant"
    },
    {
      "id": "successful-swap-linearization",
      "initialLocale": "en",
      "requestedLocale": "de",
      "loadResult": "success",
      "expected": {
        "oldReaders": "complete-en",
        "newReaders": "complete-de",
        "mixedSnapshotObservable": false,
        "notifications": 1,
        "notificationAfterPublication": true
      }
    },
    {
      "id": "failed-swap-preserves-current",
      "initialLocale": "en",
      "requestedLocale": "de",
      "loadResult": "packRejected",
      "expected": {
        "currentLocale": "en",
        "notifications": 0,
        "successfulCacheEntry": false
      }
    },
    {
      "id": "cancelled-swap-preserves-current",
      "initialLocale": "en",
      "requestedLocale": "de",
      "loadResult": "cancelledBeforePublication",
      "expected": {
        "currentLocale": "en",
        "notifications": 0,
        "successfulCacheEntry": false
      }
    },
    {
      "id": "same-locale-load-coalesces",
      "requestedLocales": [
        "DE",
        "de"
      ],
      "concurrentCallers": 32,
      "expected": {
        "canonicalLocale": "de",
        "externalLoads": 1,
        "snapshotInstances": 1
      }
    },
    {
      "id": "one-waiter-cancellation-does-not-poison-shared-load",
      "requestedLocale": "de",
      "concurrentCallers": 2,
      "cancelledWaiters": 1,
      "expected": {
        "externalLoads": 1,
        "successfulWaiters": 1,
        "successfulCacheEntry": true
      }
    },
    {
      "id": "accessor-observes-current-snapshot",
      "accessorCreatedAtLocale": "en",
      "successfulSwaps": [
        "de",
        "fr"
      ],
      "expectedCallLocales": [
        "en",
        "de",
        "fr"
      ]
    }
  ]
}
