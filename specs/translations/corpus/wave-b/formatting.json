{
  "formatVersion": 1,
  "identity": "RunicTranslations.Formatting.Conformance",
  "messageGrammarVersion": 1,
  "valueEncoding": {
    "int": "base-10 signed integer string",
    "number": "base-10 decimal string",
    "date": "ISO 8601 calendar date",
    "time": "ISO 8601 local time",
    "datetime": "ISO 8601 timestamp with explicit offset",
    "guid": "RFC 4122 hexadecimal string"
  },
  "cases": [
    {
      "id": "text-unchanged",
      "locale": "en-US",
      "pattern": "Hello, {value}!",
      "arguments": [
        {
          "name": "value",
          "type": "string",
          "format": "none",
          "value": "München <&>"
        }
      ],
      "expected": {
        "kind": "exact",
        "text": "Hello, München <&>!"
      }
    },
    {
      "id": "escaped-and-repeated",
      "locale": "en",
      "pattern": "{{{value}}} = {value}",
      "arguments": [
        {
          "name": "value",
          "type": "string",
          "format": "none",
          "value": "x"
        }
      ],
      "expected": {
        "kind": "exact",
        "text": "{x} = x"
      }
    },
    {
      "id": "int-plain-is-invariant",
      "locale": "de-DE",
      "pattern": "{value}",
      "arguments": [
        {
          "name": "value",
          "type": "int",
          "format": "plain",
          "value": "-1200000"
        }
      ],
      "expected": {
        "kind": "exact",
        "text": "-1200000"
      }
    },
    {
      "id": "number-plain-is-invariant",
      "locale": "fr-FR",
      "pattern": "{value}",
      "arguments": [
        {
          "name": "value",
          "type": "number",
          "format": "plain",
          "value": "-1234.500"
        }
      ],
      "expected": {
        "kind": "exact",
        "text": "-1234.5"
      }
    },
    {
      "id": "bool-lower-true",
      "locale": "tr-TR",
      "pattern": "{value}",
      "arguments": [
        {
          "name": "value",
          "type": "bool",
          "format": "lower",
          "value": true
        }
      ],
      "expected": {
        "kind": "exact",
        "text": "true"
      }
    },
    {
      "id": "date-iso",
      "locale": "ja-JP",
      "pattern": "{value}",
      "arguments": [
        {
          "name": "value",
          "type": "date",
          "format": "iso",
          "value": "2024-02-29"
        }
      ],
      "expected": {
        "kind": "exact",
        "text": "2024-02-29"
      }
    },
    {
      "id": "time-iso-whole-second",
      "locale": "ar-EG",
      "pattern": "{value}",
      "arguments": [
        {
          "name": "value",
          "type": "time",
          "format": "iso",
          "value": "09:07:05"
        }
      ],
      "expected": {
        "kind": "exact",
        "text": "09:07:05"
      }
    },
    {
      "id": "datetime-iso-normalizes-utc",
      "locale": "en-US",
      "pattern": "{value}",
      "arguments": [
        {
          "name": "value",
          "type": "datetime",
          "format": "iso",
          "value": "2026-07-22T09:08:07+02:30"
        }
      ],
      "expected": {
        "kind": "exact",
        "text": "2026-07-22T06:38:07.0000000Z"
      }
    },
    {
      "id": "guid-d-lower",
      "locale": "en",
      "pattern": "{value}",
      "arguments": [
        {
          "name": "value",
          "type": "guid",
          "format": "d",
          "value": "00112233-4455-6677-8899-AABBCCDDEEFF"
        }
      ],
      "expected": {
        "kind": "exact",
        "text": "00112233-4455-6677-8899-aabbccddeeff"
      }
    },
    {
      "id": "guid-n-lower",
      "locale": "en",
      "pattern": "{value}",
      "arguments": [
        {
          "name": "value",
          "type": "guid",
          "format": "n",
          "value": "00112233-4455-6677-8899-AABBCCDDEEFF"
        }
      ],
      "expected": {
        "kind": "exact",
        "text": "00112233445566778899aabbccddeeff"
      }
    },
    {
      "id": "grouped-number-semantic",
      "locale": "de-DE",
      "pattern": "{value}",
      "arguments": [
        {
          "name": "value",
          "type": "number",
          "format": "grouped",
          "value": "1234.5"
        }
      ],
      "expected": {
        "kind": "localeSemantic",
        "numericValue": "1234.5",
        "usesGrouping": true
      }
    },
    {
      "id": "fixed2-number-semantic",
      "locale": "fr-FR",
      "pattern": "{value}",
      "arguments": [
        {
          "name": "value",
          "type": "number",
          "format": "fixed2",
          "value": "12.5"
        }
      ],
      "expected": {
        "kind": "localeSemantic",
        "numericValue": "12.50",
        "fractionDigits": 2
      }
    },
    {
      "id": "percent1-number-semantic",
      "locale": "en-US",
      "pattern": "{value}",
      "arguments": [
        {
          "name": "value",
          "type": "number",
          "format": "percent1",
          "value": "0.125"
        }
      ],
      "expected": {
        "kind": "localeSemantic",
        "percentValue": "12.5",
        "fractionDigits": 1
      }
    },
    {
      "id": "date-long-semantic",
      "locale": "de-DE",
      "pattern": "{value}",
      "arguments": [
        {
          "name": "value",
          "type": "date",
          "format": "long",
          "value": "2024-02-29"
        }
      ],
      "expected": {
        "kind": "localeSemantic",
        "calendarDate": "2024-02-29",
        "style": "long"
      }
    },
    {
      "id": "argument-order-independent",
      "locale": "en",
      "pattern": "{alpha}/{zulu}",
      "arguments": [
        {
          "name": "zulu",
          "type": "string",
          "format": "none",
          "value": "Z"
        },
        {
          "name": "alpha",
          "type": "string",
          "format": "none",
          "value": "A"
        }
      ],
      "expected": {
        "kind": "exact",
        "text": "A/Z"
      }
    },
    {
      "id": "invalid-missing-argument",
      "locale": "en",
      "pattern": "{required}",
      "arguments": [],
      "expected": {
        "kind": "error",
        "reason": "missingArgument",
        "name": "required"
      }
    },
    {
      "id": "invalid-duplicate-argument",
      "locale": "en",
      "pattern": "{value}",
      "arguments": [
        {
          "name": "value",
          "type": "string",
          "format": "none",
          "value": "one"
        },
        {
          "name": "value",
          "type": "string",
          "format": "none",
          "value": "two"
        }
      ],
      "expected": {
        "kind": "error",
        "reason": "duplicateArgument",
        "name": "value"
      }
    },
    {
      "id": "invalid-unknown-argument",
      "locale": "en",
      "pattern": "literal",
      "arguments": [
        {
          "name": "extra",
          "type": "string",
          "format": "none",
          "value": "value"
        }
      ],
      "expected": {
        "kind": "error",
        "reason": "unknownArgument",
        "name": "extra"
      }
    },
    {
      "id": "invalid-argument-type",
      "locale": "en",
      "pattern": "{count}",
      "arguments": [
        {
          "name": "count",
          "type": "string",
          "format": "none",
          "value": "12"
        }
      ],
      "contract": [
        {
          "name": "count",
          "type": "int",
          "format": "plain"
        }
      ],
      "expected": {
        "kind": "error",
        "reason": "argumentTypeMismatch",
        "name": "count"
      }
    }
  ],
  "coverage": {
    "types": [
      "string",
      "int",
      "number",
      "bool",
      "date",
      "time",
      "datetime",
      "guid"
    ],
    "formatFamilies": [
      "none",
      "plain",
      "grouped",
      "fixed0-fixed6",
      "percent0-percent4",
      "lower",
      "iso",
      "short-medium-long",
      "d",
      "n"
    ]
  }
}
