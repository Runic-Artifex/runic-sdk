    ],
    "time": [
      "style"
    ],
    "datetime": [
      "style"
    ],
    "runic:uuid": [
      "style"
    ],
    "runic:boolean": [
      "select"
    ],
    "runic:relative-time": [
      "unit",
      "numeric"
    ]
  },
  "precision": "Fixed precision only: minimumFractionDigits and maximumFractionDigits must both be present and equal, 0..6 (percent 0..4).",
  "unsupportedDiagnostic": "RTR0065"
