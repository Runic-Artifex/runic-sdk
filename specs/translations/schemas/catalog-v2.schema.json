{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Runic Translations catalog manifest v2",
  "type": "object",
  "required": ["schemaVersion", "catalog", "code", "defaultLocale", "locales", "layers"],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schemaVersion": { "const": 2 },
    "catalog": { "$ref": "#/$defs/id" },
    "code": { "$ref": "#/$defs/code" },
    "defaultLocale": { "$ref": "#/$defs/localeTag" },
    "locales": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/locale" } },
    "layers": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/layer" } },
    "validation": { "$ref": "#/$defs/validation" },
    "runtime": { "$ref": "#/$defs/runtime" },
    "outputs": { "$ref": "#/$defs/outputs" }
  },
  "additionalProperties": false,
  "unevaluatedProperties": false,
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9.-]*$" },
    "localeTag": { "type": "string", "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$" },
    "code": { "type": "object", "required": ["namespace", "className"], "properties": { "namespace": { "type": "string", "minLength": 1 }, "className": { "type": "string", "minLength": 1 }, "visibility": { "enum": ["public", "internal"] } }, "additionalProperties": false },
    "locale": { "type": "object", "required": ["tag"], "properties": { "tag": { "$ref": "#/$defs/localeTag" }, "fallback": { "$ref": "#/$defs/localeTag" } }, "additionalProperties": false },
    "layer": { "type": "object", "required": ["name", "priority"], "properties": { "name": { "$ref": "#/$defs/id" }, "priority": { "type": "integer" } }, "additionalProperties": false },
    "policy": { "enum": ["allow", "warning", "error"] },
    "validation": { "type": "object", "properties": { "translationCompleteness": { "$ref": "#/$defs/policy" }, "extraLocaleKeys": { "$ref": "#/$defs/policy" }, "emptyValues": { "$ref": "#/$defs/policy" } }, "additionalProperties": false },
    "runtime": { "type": "object", "properties": { "unsupportedLocale": { "enum": ["exact", "parentsThenDefault", "default"] }, "missingKey": { "enum": ["throw", "returnKey", "returnMarker"] } }, "additionalProperties": false },
    "outputs": { "type": "object", "properties": { "typescript": { "type": "object", "properties": { "enabled": { "type": "boolean" }, "moduleName": { "type": "string" } }, "additionalProperties": false }, "templateManifest": { "type": "object", "properties": { "enabled": { "type": "boolean" } }, "additionalProperties": false } }, "additionalProperties": false }
  }
}
