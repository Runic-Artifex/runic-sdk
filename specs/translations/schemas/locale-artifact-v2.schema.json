{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://runic-artifex.eu/schemas/translations/locale-artifact-v2.schema.json",
  "title": "Runic Translations resolved locale artifact v2",
  "type": "object",
  "required": ["artifactVersion", "messageGrammarVersion", "catalog", "locale", "contractFingerprint", "messages"],
  "properties": {
    "artifactVersion": { "const": 2 },
    "messageGrammarVersion": { "const": 2 },
    "catalog": { "type": "string", "pattern": "^[a-z][a-z0-9.-]*$" },
    "locale": { "type": "string", "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$" },
    "contractFingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "messages": {
      "type": "object",
      "maxProperties": 50000,
      "propertyNames": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*$" },
      "additionalProperties": { "$ref": "#/$defs/message" }
    }
  },
  "additionalProperties": false,
  "unevaluatedProperties": false,
  "$defs": {
    "name": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
    "input": {
      "type": "object",
      "required": ["type", "format"],
      "properties": {
        "type": { "enum": ["string", "int", "number", "bool", "date", "time", "datetime", "guid"] },
        "format": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false,
      "unevaluatedProperties": false
    },
    "selector": {
      "type": "object",
      "required": ["name", "input", "function"],
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "input": { "$ref": "#/$defs/name" },
        "function": { "enum": ["literal", "plural", "ordinal"] }
      },
      "additionalProperties": false,
      "unevaluatedProperties": false
    },
    "message": {
      "type": "object",
      "required": ["astVersion", "inputs", "selectors", "variants"],
      "properties": {
        "astVersion": { "const": 2 },
        "inputs": { "type": "object", "maxProperties": 32, "propertyNames": { "$ref": "#/$defs/name" }, "additionalProperties": { "$ref": "#/$defs/input" } },
        "selectors": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/selector" } },
        "variants": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "$ref": "#/$defs/variant" } }
      },
      "additionalProperties": false,
      "unevaluatedProperties": false
    },
    "variant": {
      "type": "object",
      "required": ["matches", "nodes"],
      "properties": {
        "matches": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } },
        "nodes": { "type": "array", "maxItems": 4096, "items": { "$ref": "#/$defs/node" } }
      },
      "additionalProperties": false,
      "unevaluatedProperties": false
    },
    "node": {
      "oneOf": [
        { "type": "object", "required": ["kind", "value"], "properties": { "kind": { "const": "text" }, "value": { "type": "string", "maxLength": 65536 } }, "additionalProperties": false },
        { "type": "object", "required": ["kind", "input"], "properties": { "kind": { "const": "input" }, "input": { "$ref": "#/$defs/name" } }, "additionalProperties": false },
        { "type": "object", "required": ["kind", "input", "function", "format"], "properties": { "kind": { "const": "format" }, "input": { "$ref": "#/$defs/name" }, "function": { "enum": ["string", "integer", "number", "date", "time", "datetime", "uuid", "relativeTime"] }, "format": { "type": "string" }, "unit": { "enum": ["second", "minute", "hour", "day", "week", "month", "year"] }, "numeric": { "enum": ["always", "auto"] } }, "additionalProperties": false },
        { "type": "object", "required": ["kind", "name", "attributes", "children"], "properties": { "kind": { "const": "markup" }, "name": { "$ref": "#/$defs/name" }, "attributes": { "type": "object", "propertyNames": { "$ref": "#/$defs/name" }, "additionalProperties": { "type": "string" } }, "children": { "type": "array", "maxItems": 4096, "items": { "$ref": "#/$defs/node" } } }, "additionalProperties": false }
      ]
    }
  }
}
