{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Runic Translations Document v1",
  "description": "Normative schema for a Runic Translations resource document with schemaVersion 1.",
  "type": "object",
  "required": [
    "schemaVersion",
    "catalog",
    "locale",
    "layer",
    "resources"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1,
      "description": "Optional editor hint. Supported canonical values are validated by the compiler."
    },
    "schemaVersion": {
      "const": 1
    },
    "catalog": {
      "$ref": "#/$defs/catalogId"
    },
    "locale": {
      "$ref": "#/$defs/localeTag"
    },
    "layer": {
      "$ref": "#/$defs/catalogId"
    },
    "resources": {
      "$ref": "#/$defs/resourceGroup"
    }
  },
  "additionalProperties": false,
  "unevaluatedProperties": false,
  "$defs": {
    "catalogId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]*$"
    },
    "localeTag": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "resourceGroup": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/identifier"
      },
      "additionalProperties": {
        "$ref": "#/$defs/resourceNode"
      },
      "unevaluatedProperties": false
    },
    "resourceNode": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/metadataLeaf"
        },
        {
          "$ref": "#/$defs/resourceGroup"
        }
      ]
    },
    "metadataLeaf": {
      "type": "object",
      "required": [
        "$value"
      ],
      "properties": {
        "$value": {
          "type": "string"
        },
        "$description": {
          "type": "string"
        },
        "$placeholders": {
          "$ref": "#/$defs/placeholders"
        },
        "$since": {
          "type": "string"
        },
        "$deprecated": {
          "type": "string"
        },
        "$tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false,
      "unevaluatedProperties": false
    },
    "placeholders": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/identifier"
      },
      "additionalProperties": {
        "$ref": "#/$defs/placeholderDescriptor"
      },
      "unevaluatedProperties": false
    },
    "placeholderDescriptor": {
      "oneOf": [
        {
          "$ref": "#/$defs/stringPlaceholder"
        },
        {
          "$ref": "#/$defs/intPlaceholder"
        },
        {
          "$ref": "#/$defs/numberPlaceholder"
        },
        {
          "$ref": "#/$defs/boolPlaceholder"
        },
        {
          "$ref": "#/$defs/datePlaceholder"
        },
        {
          "$ref": "#/$defs/timePlaceholder"
        },
        {
          "$ref": "#/$defs/datetimePlaceholder"
        },
        {
          "$ref": "#/$defs/guidPlaceholder"
        }
      ]
    },
    "stringPlaceholder": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "const": "string"
        }
      },
      "additionalProperties": false,
      "unevaluatedProperties": false
    },
    "intPlaceholder": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "const": "int"
        },
        "format": {
          "type": "string",
          "enum": [
            "plain",
            "grouped"
          ]
        }
      },
      "additionalProperties": false,
      "unevaluatedProperties": false
    },
    "numberPlaceholder": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "const": "number"
        },
        "format": {
          "type": "string",
          "enum": [
            "plain",
            "grouped",
            "fixed0",
            "fixed1",
            "fixed2",
            "fixed3",
            "fixed4",
            "fixed5",
            "fixed6",
            "percent0",
            "percent1",
            "percent2",
            "percent3",
            "percent4"
          ]
        }
      },
      "additionalProperties": false,
      "unevaluatedProperties": false
    },
    "boolPlaceholder": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "const": "bool"
        },
        "format": {
          "const": "lower"
        }
      },
      "additionalProperties": false,
      "unevaluatedProperties": false
    },
    "datePlaceholder": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "const": "date"
        },
        "format": {
          "type": "string",
          "enum": [
            "iso",
            "short",
            "medium",
            "long"
          ]
        }
      },
      "additionalProperties": false,
      "unevaluatedProperties": false
    },
    "timePlaceholder": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "const": "time"
        },
        "format": {
          "type": "string",
          "enum": [
            "iso",
            "short",
            "medium"
          ]
        }
      },
      "additionalProperties": false,
      "unevaluatedProperties": false
    },
    "datetimePlaceholder": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "const": "datetime"
        },
        "format": {
          "type": "string",
          "enum": [
            "iso",
            "short",
            "medium",
            "long"
          ]
        }
      },
      "additionalProperties": false,
      "unevaluatedProperties": false
    },
    "guidPlaceholder": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "const": "guid"
        },
        "format": {
          "type": "string",
          "enum": [
            "d",
            "n"
          ]
        }
      },
      "additionalProperties": false,
      "unevaluatedProperties": false
    }
  }
}
