{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RunicTextResources Text Resources Asset Manifest v1",
  "description": "Versioned edge contract describing deterministic Text Resources artifacts for a host or packaging layer. It does not grant the host authority to redefine artifact bytes.",
  "type": "object",
  "required": [
    "assetManifestVersion",
    "catalog",
    "assets"
  ],
  "properties": {
    "assetManifestVersion": {
      "const": 1
    },
    "catalog": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]*$"
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      }
    }
  },
  "additionalProperties": false,
  "unevaluatedProperties": false,
  "$defs": {
    "asset": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "byteLength",
        "mediaType",
        "locale"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "byteLength": {
          "type": "integer",
          "minimum": 0
        },
        "mediaType": {
          "type": "string",
          "pattern": "^[A-Za-z0-9!#$&^_.+-]+/[A-Za-z0-9!#$&^_.+-]+$"
        },
        "locale": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "unevaluatedProperties": false
    }
  }
}
