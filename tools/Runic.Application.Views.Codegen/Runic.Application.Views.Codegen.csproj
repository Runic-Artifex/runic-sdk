<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../eng/build/application.props" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- This executable is a build tool, never part of the app's runtime closure. -->
    <ShouldBeValidatedAsExecutableReference>false</ShouldBeValidatedAsExecutableReference>
    <AssemblyName>BridgeCodegen</AssemblyName>
    <!-- Build tool: run on a newer .NET runtime when the 10.0 runtime is absent (#614). With 10.0 installed it still runs on 10.0. -->
    <RollForward>Major</RollForward>
    <TargetFramework>$(RunicApplicationDefaultTargetFramework)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Internal build tool shipped inside Runic.Application.Views; it has no public API surface. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Generated source must not depend on the developer's locale. With invariant
         globalization every interpolation is culture-neutral, so CA1305 is moot. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <NoWarn>$(NoWarn);CA1305</NoWarn>
    <!-- Diagnostics link to their catalog entry at the release tag. -->
    <RunicGenerateReleaseLinks>true</RunicGenerateReleaseLinks>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="Runic.Application.Views.Generated" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../packages/dotnet/Runic.Application.Views/Runic.Application.Views.csproj" />
    <ProjectReference Include="../Runic.Application.Views.Codegen.Toolkit/Runic.Application.Views.Codegen.Toolkit.csproj" />
    <ProjectReference Include="../Runic.Application.Views.Codegen.ReactiveUI/Runic.Application.Views.Codegen.ReactiveUI.csproj" />
  </ItemGroup>
  <Import Project="../../eng/build/application.targets" />
</Project>
