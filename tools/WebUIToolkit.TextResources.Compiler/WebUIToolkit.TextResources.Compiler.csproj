<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(WebUIToolkitGeneratorTargetFramework)</TargetFramework>
    <AssemblyName>WebUIToolkit.TextResources.Compiler</AssemblyName>
    <RootNamespace>WebUIToolkit.TextResources.Compiler</RootNamespace>
    <Description>Pure deterministic compiler kernel for WebUIToolkit text resources.</Description>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- These names deliberately mirror the normative serialized descriptor vocabulary. -->
    <NoWarn>$(NoWarn);CA1720</NoWarn>
  </PropertyGroup>
</Project>
