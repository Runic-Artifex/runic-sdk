<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>WebUIToolkitStarter</RootNamespace>
    <WebUIToolkitFrontendWorkspace>@webuitoolkit/webuitoolkitstarter-angular</WebUIToolkitFrontendWorkspace>
    <WebUIToolkitFrontendPackageDirectory>$(MSBuildProjectDirectory)/Frontend</WebUIToolkitFrontendPackageDirectory>
    <WebUIToolkitFrontendOutputDirectory>$(MSBuildProjectDirectory)/Frontend/dist</WebUIToolkitFrontendOutputDirectory>
    <WebUIToolkitFrontendWorkspaceRoot>$(MSBuildProjectDirectory)</WebUIToolkitFrontendWorkspaceRoot>
    <WebUIToolkitFrontendViteDevServerEnabled>false</WebUIToolkitFrontendViteDevServerEnabled>
    <WebUIToolkitFrontendDevServerKind>angular</WebUIToolkitFrontendDevServerKind>
    <WebUIToolkitFrontendDevServerDocument>index.html</WebUIToolkitFrontendDevServerDocument>
    <WebUIToolkitFrontendContractCSharpFirst>true</WebUIToolkitFrontendContractCSharpFirst>
    <WebUIToolkitFrontendContractTypeScriptOutput>$(MSBuildProjectDirectory)/Frontend/src/counter-contract.g.ts</WebUIToolkitFrontendContractTypeScriptOutput>
    <WebUIToolkitFrontendContractAngularOutput>$(MSBuildProjectDirectory)/Frontend/src/counter-bindings.g.ts</WebUIToolkitFrontendContractAngularOutput>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="WebUIToolkit.Frontend.Sdk" Version="1.0.0" PrivateAssets="all" />
    <PackageReference Include="WebUIToolkit.Hosting.Build" Version="1.0.0" />
    <PackageReference Include="WebUIToolkit.Hosting.CsWebUi.App" Version="1.0.0-beta.1" />
    <PackageReference Include="WebUIToolkit.Hosting.CsWebUi.Mvvm" Version="1.0.0-beta.1" />
    <PackageReference Include="WebUIToolkit.MVVM.CommunityToolkit" Version="1.0.0" />
  </ItemGroup>
</Project>
