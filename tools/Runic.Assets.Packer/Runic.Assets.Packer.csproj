<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../eng/build/assets.props" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RunicAssetsShippingProject>true</RunicAssetsShippingProject>
    <AssemblyName>Runic.Assets.Packer</AssemblyName>
    <RootNamespace>Runic.Assets.Packer</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../packages/dotnet/Runic.Assets/Runic.Assets.csproj" />
    <ProjectReference Include="../../packages/dotnet/Runic.CommandLine/Runic.CommandLine.csproj" />
    <ProjectReference Include="../../packages/dotnet/Runic.CommandLine.Generators/Runic.CommandLine.Generators.csproj"
                      PrivateAssets="all"
                      ReferenceOutputAssembly="false"
                      OutputItemType="Analyzer" />
  </ItemGroup>
  <Import Project="../../eng/build/assets.targets" />
</Project>
