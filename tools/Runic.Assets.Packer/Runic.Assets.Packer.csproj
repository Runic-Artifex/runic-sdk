<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../eng/build/assets.props" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RunicAssetsShippingProject>true</RunicAssetsShippingProject>
    <AssemblyName>Runic.Assets.Packer</AssemblyName>
    <RootNamespace>Runic.Assets.Packer</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <!-- Faults link to their catalog entry at the release tag of Runic.Assets, which ships this tool. -->
    <RunicGenerateReleaseLinks>true</RunicGenerateReleaseLinks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../packages/dotnet/Runic.Assets/Runic.Assets.csproj" />
    <PackageReference Include="Runic.CommandLine" />
    <Compile Include="../Shared/OutputSelectorAlias.cs" Link="Shared/OutputSelectorAlias.cs" />
  </ItemGroup>
  <Import Project="../../eng/build/assets.targets" />
  <ItemGroup>
    <PackageReference Include="Runic.CommandLine.Spectre" />
  </ItemGroup>
</Project>
