<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(WebUIToolkitDefaultTargetFramework)</TargetFramework>
    <AssemblyName>WebUIToolkit.MVVM.BindingCompiler</AssemblyName>
    <RootNamespace>WebUIToolkit.MVVM.BindingCompiler</RootNamespace>
    <PackageId>WebUIToolkit.MVVM.BindingCompiler</PackageId>
    <Version>1.0.0</Version>
    <Description>Deterministic command-line compiler for WebUIToolkit MVVM binding contracts.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>wut-bindings</ToolCommandName>
    <WebUIToolkitShippingProject>true</WebUIToolkitShippingProject>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <WebUIToolkitMvvmBindingEnabled>false</WebUIToolkitMvvmBindingEnabled>
    <RestoreAdditionalProjectSources Condition="'$(WebUIToolkitLocalPackageSource)' != ''">$(RestoreAdditionalProjectSources);$(WebUIToolkitLocalPackageSource)</RestoreAdditionalProjectSources>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WebUIToolkit.MVVM.Build" Version="[1.0.0]" />
    <None Update="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
