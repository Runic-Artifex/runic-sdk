<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../eng/build/application.props" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>Runic.Application.Templates</PackageId>
    <PackageVersion Condition="'$(PackageVersion)' == ''">$(RunicSdkVersion)</PackageVersion>
    <Title>Runic Application project template</Title>
    <Description>The dotnet new runic-app template for Runic Views Window applications with a React, Vue, Svelte, or Angular frontend.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageType>Template</PackageType>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <TemplatePackContentRoot>$(MSBuildProjectDirectory)/obj/template-pack-content/</TemplatePackContentRoot>
    <RunicTemplateNpmDirectory Condition="'$(RunicTemplateNpmDirectory)' == ''">$(MSBuildProjectDirectory)/../../artifacts/packages/npm</RunicTemplateNpmDirectory>
    <RunicNuGetTemplateVersion Condition="'$(RunicNuGetTemplateVersion)' == ''">$(RunicSdkVersion)</RunicNuGetTemplateVersion>
    <RunicNpmTemplateVersion Condition="'$(RunicNpmTemplateVersion)' == ''">$(RunicSdkVersion)</RunicNpmTemplateVersion>
    <BunTemplateVersion Condition="'$(BunTemplateVersion)' == ''">1.4.2</BunTemplateVersion>
    <NpmTemplateVersion Condition="'$(NpmTemplateVersion)' == ''">12.2.0</NpmTemplateVersion>
    <PnpmTemplateVersion Condition="'$(PnpmTemplateVersion)' == ''">12.9.1</PnpmTemplateVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="**/*" />
    <Content Include="content/**/*"
             Exclude="content/**/bin/**/*;content/**/obj/**/*;content/**/node_modules/**/*;content/**/dist/**/*;content/**/.angular/**/*" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <Target Name="PrepareTemplatePackContent" BeforeTargets="_GetPackageFiles">
    <RemoveDir Directories="$(TemplatePackContentRoot)" />
    <Copy SourceFiles="content/runic-app/.template.config/template.json"
          DestinationFiles="$(TemplatePackContentRoot)runic-app/.template.config/template.json" />

    <PropertyGroup>
      <_TemplateJson>$([System.IO.File]::ReadAllText('$(TemplatePackContentRoot)runic-app/.template.config/template.json'))</_TemplateJson>
      <_StampedTemplateJson>$([System.String]::Copy('$(_TemplateJson)').Replace('__RUNIC_NUGET_VERSION_DEFAULT__', '$(RunicNuGetTemplateVersion)').Replace('__RUNIC_NPM_VERSION_DEFAULT__', '$(RunicNpmTemplateVersion)').Replace('__BUN_PACKAGE_MANAGER_VERSION__', '$(BunTemplateVersion)').Replace('__NPM_PACKAGE_MANAGER_VERSION__', '$(NpmTemplateVersion)').Replace('__PNPM_PACKAGE_MANAGER_VERSION__', '$(PnpmTemplateVersion)'))</_StampedTemplateJson>
    </PropertyGroup>
    <WriteLinesToFile File="$(TemplatePackContentRoot)runic-app/.template.config/template.json"
                      Lines="$(_StampedTemplateJson)"
                      Overwrite="true" />

    <Exec Command="bun &quot;$(MSBuildProjectDirectory)/../../eng/release/stage-template-locks.mjs&quot; &quot;$(MSBuildProjectDirectory)/content&quot; &quot;$(RunicTemplateNpmDirectory)&quot; &quot;$(TemplatePackContentRoot)&quot;" />

    <ItemGroup>
      <Content Remove="content/**/package-lock.json;content/**/pnpm-lock.yaml;content/**/bun.lock" />
      <Content Remove="content/runic-app/.template.config/template.json" />
      <Content Remove="$(TemplatePackContentRoot)**/*" />
      <Content Include="$(TemplatePackContentRoot)runic-app/.template.config/template.json" Pack="true" PackagePath="content/content/runic-app/.template.config/" />
      <Content Include="$(TemplatePackContentRoot)runic-app/frontends/react/*" Pack="true" PackagePath="content/content/runic-app/frontends/react/" />
      <Content Include="$(TemplatePackContentRoot)runic-app/frontends/vue/*" Pack="true" PackagePath="content/content/runic-app/frontends/vue/" />
      <Content Include="$(TemplatePackContentRoot)runic-app/frontends/svelte/*" Pack="true" PackagePath="content/content/runic-app/frontends/svelte/" />
      <Content Include="$(TemplatePackContentRoot)runic-app/frontends/angular/*" Pack="true" PackagePath="content/content/runic-app/frontends/angular/" />
    </ItemGroup>
  </Target>
  <Import Project="../../eng/build/application.targets" />
</Project>
