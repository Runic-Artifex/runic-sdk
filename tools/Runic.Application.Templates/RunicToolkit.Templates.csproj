<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>RunicToolkit.Templates</PackageId>
    <PackageVersion>1.0.0-beta.1</PackageVersion>
    <Title>RunicToolkit project templates</Title>
    <Description>dotnet new templates for native CsWebUi applications using C# markup, cwhtml, React, Vue, Svelte, or Angular.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageType>Template</PackageType>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="**/*" />
    <Content Include="content/**/*"
             Exclude="content/**/bin/**/*;content/**/obj/**/*;content/**/node_modules/**/*;content/**/dist/**/*;content/**/.angular/**/*" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <None Include="content/cwhtml/package.json" Pack="true" PackagePath="content/content/csharp-markup/package.json" />
    <None Include="content/cwhtml/package-lock.json" Pack="true" PackagePath="content/content/csharp-markup/package-lock.json" />
    <None Include="content/cwhtml/Frontend/package.json" Pack="true" PackagePath="content/content/csharp-markup/Frontend/package.json" />
    <None Include="content/cwhtml/Frontend/vite.config.mjs" Pack="true" PackagePath="content/content/csharp-markup/Frontend/vite.config.mjs" />
    <None Include="content/cwhtml/Frontend/src/main.js" Pack="true" PackagePath="content/content/csharp-markup/Frontend/src/main.js" />
    <None Include="content/cwhtml/.config/dotnet-tools.json" Pack="true" PackagePath="content/content/csharp-markup/.config/dotnet-tools.json" />
    <None Include="content/cwhtml/.gitignore" Pack="true" PackagePath="content/content/csharp-markup/.gitignore" />
  </ItemGroup>
</Project>
