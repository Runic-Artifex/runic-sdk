using System;
using System.Globalization;
using System.Linq;
using RunicMarkup.Csharp;
using RunicMarkup.RunicToolkit.Htmx;

namespace RunicToolkitStarter;

public static partial class CounterViews
{
    [HtmlHtmxView(
        "counter",
        "counter",
        typeof(CounterViewModel),
        typeof(CounterJsonContext))]
    [HtmlHtmxAction("increment", nameof(CounterViewModel.IncrementCommand))]
    [HtmlHtmxField(
        "increment",
        "step",
        nameof(CounterViewModel.Step),
        Required = true,
        Format = "int32",
        Message = "Choose an increment from 1 to 10.")]
    public static HtmlContent Counter(
        CounterRenderModel model,
        HtmxRenderContext htmx) =>
        <main id="counter" class="container py-5" data-webui-view="counter">
            <section class="card border-0 shadow">
                <div class="card-body p-5">
                    <span class="badge text-bg-primary mb-3">C# markup + HTMX + CsWebUi</span>
                    <h1 class="display-5">Native C# counter</h1>
                    <p class="lead">{model.Summary}</p>
                    <p class="display-1 fw-bold" aria-live="polite">
                        {model.Count.ToString(CultureInfo.InvariantCulture)}
                    </p>
                    <form
                        data-hx-post={htmx.ActionRoute(CounterGenerated.HtmxActions.Increment)}
                        data-hx-target="#counter"
                        data-hx-swap="outerHTML">
                        <label class="form-label" for="step">Increment step</label>
                        <input
                            id="step"
                            class={model.StepErrors.Count > 0 ? "form-control is-invalid" : "form-control"}
                            type="number"
                            name="step"
                            min="1"
                            max="10"
                            value={model.Step}
                            aria-invalid={model.StepErrors.Count > 0 ? "true" : null} />
                        {model.StepErrors.Count > 0
                            ? <div class="invalid-feedback">
                                {string.Join(" ", model.StepErrors)}
                              </div>
                            : null}
                        <button class="btn btn-primary btn-lg" type="submit">
                            <i class="fa-solid fa-plus" aria-hidden="true"></i>
                            Increment in C#
                        </button>
                    </form>
                    <h2 class="h6 mt-4">History</h2>
                    <div class="d-flex flex-wrap gap-2">
                        {model.History.Select(value =>
                            <span class="badge text-bg-light">
                                {value.ToString(CultureInfo.InvariantCulture)}
                            </span>)}
                    </div>
                </div>
            </section>
        </main>;

    [HtmlDocumentView]
    public static HtmlContent CounterDocument(CounterDocumentModel model) =>
        <html lang="en">
            <head>
                <meta charset="utf-8" />
                <meta name="viewport" content="width=device-width, initial-scale=1" />
                <title>RunicToolkitStarter</title>
                {!model.Assets.IsViteDevelopment
                    ? <link rel="stylesheet" href="cwhtml.css" />
                    : null}
            </head>
            <body>
                {model.Application}
                <script src="webui.js"></script>
                <script src="_content/RunicMarkup.RunicToolkit.Htmx.CsWebUi/runic-toolkit-htmx-cswebui-1.0.0.js"></script>
                {model.Assets.IsViteDevelopment
                    ? model.Assets
                    : <script src="cwhtml.js"></script>}
            </body>
        </html>;
}
