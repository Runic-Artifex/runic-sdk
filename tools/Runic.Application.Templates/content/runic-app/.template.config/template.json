{
  "$schema": "http://json.schemastore.org/template",
  "author": "Runic Artifex",
  "classifications": [
    "Desktop",
    "Runic Views",
    "React",
    "Vue",
    "Svelte",
    "SvelteKit",
    "Angular"
  ],
  "identity": "Runic.Application.Templates.App",
  "name": "Runic application",
  "description": "A desktop application in a native window, with C# ViewModels and a React, Vue, Svelte, SvelteKit, or Angular frontend.",
  "shortName": "runic-app",
  "sourceName": "RunicWindowApp",
  "preferNameDirectory": true,
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "sources": [
    {
      "source": "./",
      "target": "./",
      "exclude": [
        ".template.config/**/*",
        "frontends/**/*",
        "**/*.filelist",
        "**/*.user"
      ],
      "copyOnly": [ "icons/*.png", "icons/*.ico" ],
      "modifiers": [
        { "condition": "(!tests)", "exclude": [ "RunicWindowApp.Tests/**/*", "global.json" ] },
        { "condition": "(!nix)", "exclude": [ "flake.nix" ] },
        { "condition": "(!packaging)", "exclude": [ "packaging/**/*" ] }
      ]
    },
    {
      "source": "./frontends/react/",
      "target": "./Frontend/",
      "condition": "(frontend == 'react')",
      "modifiers": [
        { "condition": "(packageManager != 'npm')", "exclude": [ "package-lock.json" ] },
        { "condition": "(packageManager != 'pnpm')", "exclude": [ "pnpm-lock.yaml" ] },
        { "condition": "(packageManager != 'bun')", "exclude": [ "bun.lock" ] }
      ]
    },
    {
      "source": "./frontends/vue/",
      "target": "./Frontend/",
      "condition": "(frontend == 'vue')",
      "modifiers": [
        { "condition": "(packageManager != 'npm')", "exclude": [ "package-lock.json" ] },
        { "condition": "(packageManager != 'pnpm')", "exclude": [ "pnpm-lock.yaml" ] },
        { "condition": "(packageManager != 'bun')", "exclude": [ "bun.lock" ] }
      ]
    },
    {
      "source": "./frontends/svelte/",
      "target": "./Frontend/",
      "condition": "(frontend == 'svelte')",
      "modifiers": [
        { "condition": "(packageManager != 'npm')", "exclude": [ "package-lock.json" ] },
        { "condition": "(packageManager != 'pnpm')", "exclude": [ "pnpm-lock.yaml" ] },
        { "condition": "(packageManager != 'bun')", "exclude": [ "bun.lock" ] }
      ]
    },
    {
      "source": "./frontends/sveltekit/",
      "target": "./Frontend/",
      "condition": "(frontend == 'sveltekit')",
      "modifiers": [
        { "condition": "(packageManager != 'npm')", "exclude": [ "package-lock.json" ] },
        { "condition": "(packageManager != 'pnpm')", "exclude": [ "pnpm-lock.yaml" ] },
        { "condition": "(packageManager != 'bun')", "exclude": [ "bun.lock" ] }
      ]
    },
    {
      "source": "./frontends/angular/",
      "target": "./Frontend/",
      "condition": "(frontend == 'angular')",
      "modifiers": [
        { "condition": "(packageManager != 'npm')", "exclude": [ "package-lock.json" ] },
        { "condition": "(packageManager != 'pnpm')", "exclude": [ "pnpm-lock.yaml", "pnpm-workspace.yaml" ] },
        { "condition": "(packageManager != 'bun')", "exclude": [ "bun.lock" ] }
      ]
    }
  ],
  "symbols": {
    "frontend": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "react",
      "displayName": "Frontend",
      "description": "The web framework that renders the ViewModels.",
      "choices": [
        { "choice": "react", "displayName": "React", "description": "React 19 with Vite" },
        { "choice": "vue", "displayName": "Vue", "description": "Vue 3 with Vite" },
        { "choice": "svelte", "displayName": "Svelte", "description": "Svelte 5 with Vite" },
        { "choice": "sveltekit", "displayName": "SvelteKit", "description": "SvelteKit 3 with Vite, prerendered by the Runic SvelteKit adapter" },
        { "choice": "angular", "displayName": "Angular", "description": "Angular with the Angular CLI" }
      ]
    },
    "packageManager": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "npm",
      "replaces": "__PACKAGE_MANAGER_NAME__",
      "displayName": "Package manager",
      "description": "JavaScript package manager used for frontend restore and development.",
      "choices": [
        { "choice": "npm", "displayName": "npm", "description": "npm with package-lock.json" },
        { "choice": "pnpm", "displayName": "pnpm", "description": "pnpm with pnpm-lock.yaml" },
        { "choice": "bun", "displayName": "Bun", "description": "Bun with bun.lock" }
      ]
    },
    "host": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "desktop",
      "displayName": "Window host",
      "description": "How the application presents its Window.",
      "choices": [
        { "choice": "desktop", "displayName": "Runic Desktop", "description": "Opens a native window with the embedded WebView, native file dialogs and the clipboard" },
        { "choice": "cswebui", "displayName": "CS-WebUI", "description": "Opens a browser window (an installed browser in app mode, then the platform WebView); best effort, without native dialogs or clipboard" }
      ]
    },
    "linuxGtk": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "3",
      "displayName": "Linux GTK version",
      "description": "The GTK version Runic Desktop uses on Linux. Windows and macOS, and the CS-WebUI host, are the same with either.",
      "choices": [
        { "choice": "3", "displayName": "GTK 3", "description": "GTK 3 and WebKitGTK 4.1" },
        { "choice": "4", "displayName": "GTK 4", "description": "GTK 4, WebKitGTK 6 and portal pickers" }
      ]
    },
    "desktopServer": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "native",
      "displayName": "Desktop server",
      "description": "The server Runic Desktop serves the page from. The CS-WebUI host has its own.",
      "choices": [
        { "choice": "native", "displayName": "Native", "description": "Runic.Desktop.NativeServer (Rust): no ASP.NET Core in the application, smaller and faster to start" },
        { "choice": "kestrel", "displayName": "Kestrel", "description": "Runic.Desktop.Kestrel: ASP.NET Core Kestrel, for an application that uses ASP.NET Core itself" }
      ]
    },
    "desktopHost": {
      "type": "computed",
      "value": "(host == 'desktop')"
    },
    "nativeServer": {
      "type": "computed",
      "value": "(host == 'desktop' && desktopServer == 'native')"
    },
    "gtk4": {
      "type": "computed",
      "value": "(host == 'desktop' && linuxGtk == '4')"
    },
    "nixHost": {
      "type": "generated",
      "generator": "switch",
      "replaces": "__RUNIC_HOST__",
      "description": "The host name that the Runic SDK's Nix functions take: desktop, desktop-gtk4 or cswebui.",
      "parameters": {
        "evaluator": "C++",
        "datatype": "string",
        "cases": [
          { "condition": "(host == 'cswebui')", "value": "cswebui" },
          { "condition": "(linuxGtk == '4')", "value": "desktop-gtk4" },
          { "value": "desktop" }
        ]
      }
    },
    "viewModels": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "reactiveui",
      "displayName": "ViewModels",
      "description": "The MVVM library for the C# ViewModels.",
      "choices": [
        { "choice": "reactiveui", "displayName": "ReactiveUI", "description": "ReactiveUI 26 Primitives: reactive objects and commands on the Window's model context" },
        { "choice": "toolkit", "displayName": "CommunityToolkit.Mvvm", "description": "Source-generated properties and relay commands" }
      ]
    },
    "tests": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "displayName": "Test project",
      "description": "Adds a TUnit test project that drives the Window headlessly with Runic.Application.Testing."
    },
    "nix": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "displayName": "Nix flake",
      "description": "Adds a Nix flake that builds the application in the Nix sandbox with the Runic SDK's buildRunicApplication, from packages.lock.json and the frontend's lock file."
    },
    "packaging": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "displayName": "Packaging manifests",
      "description": "Adds the packaging/ manifests that dotnet runic package fills (MSIX, macOS bundle, desktop entry, AppStream metadata, Flatpak manifest), so you can edit them; the command has the same defaults built in."
    },
    "restore": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "displayName": "Restore packages",
      "description": "Restores the project's NuGet packages after creating it, for an IDE that opens it next. dotnet runic dev and dotnet build restore them, and the frontend packages, anyway."
    },
    "applicationId": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "",
      "displayName": "Application ID",
      "description": "The reverse-DNS application ID, such as org.example.Notes: the desktop entry and Flatpak ID on Linux, the bundle identifier on macOS and the package name on Windows. Default: com.example. and the project name's ASCII letters and digits, at most 50 characters, as an MSIX package name allows."
    },
    "applicationDisplayName": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "identity",
      "replaces": "__RUNIC_APPLICATION_NAME__",
      "description": "The project name as users see it."
    },
    "derivedApplicationName": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "applicationIdName",
      "description": "The project name with only ASCII letters and digits, starting with a letter; empty when none remain."
    },
    "fallbackApplicationName": {
      "type": "generated",
      "generator": "constant",
      "parameters": { "value": "App" }
    },
    "applicationName": {
      "type": "generated",
      "generator": "coalesce",
      "parameters": {
        "sourceVariableName": "derivedApplicationName",
        "fallbackVariableName": "fallbackApplicationName"
      }
    },
    "defaultApplicationId": {
      "type": "generated",
      "generator": "join",
      "parameters": {
        "symbols": [
          { "type": "const", "value": "com.example" },
          { "type": "ref", "value": "applicationName" }
        ],
        "separator": "."
      }
    },
    "applicationIdValue": {
      "type": "generated",
      "generator": "coalesce",
      "parameters": {
        "sourceVariableName": "applicationId",
        "fallbackVariableName": "defaultApplicationId"
      },
      "replaces": "__RUNIC_APPLICATION_ID__",
      "description": "The application ID that the project file declares."
    },
    "runicVersion": {
      "type": "generated",
      "generator": "constant",
      "parameters": { "value": "__RUNIC_NUGET_VERSION_DEFAULT__" },
      "replaces": "__RUNIC_NUGET_VERSION__",
      "description": "Version of the Runic NuGet packages and the dotnet-runic tool, stamped when the template is packed."
    },
    "runicCsWebUiVersion": {
      "type": "generated",
      "generator": "constant",
      "parameters": { "value": "__RUNIC_CSWEBUI_NUGET_VERSION_DEFAULT__" },
      "replaces": "__RUNIC_CSWEBUI_NUGET_VERSION__",
      "description": "Version of the preview Runic.Application.Views.CsWebUi package, which ships on a prerelease version with each release, stamped when the template is packed."
    },
    "runicNpmVersion": {
      "type": "generated",
      "generator": "constant",
      "parameters": { "value": "__RUNIC_NPM_VERSION_DEFAULT__" },
      "replaces": "__RUNIC_NPM_VERSION__",
      "description": "Version of the Runic npm packages, stamped when the template is packed."
    },
    "packageManagerDeclaration": {
      "type": "generated",
      "generator": "switch",
      "replaces": "__PACKAGE_MANAGER__",
      "parameters": {
        "evaluator": "C++",
        "datatype": "string",
        "cases": [
          { "condition": "(packageManager == 'pnpm')", "value": "pnpm@__PNPM_PACKAGE_MANAGER_VERSION__" },
          { "condition": "(packageManager == 'bun')", "value": "bun@__BUN_PACKAGE_MANAGER_VERSION__" },
          { "value": "npm@__NPM_PACKAGE_MANAGER_VERSION__" }
        ]
      }
    },
    "frontendName": {
      "type": "generated",
      "generator": "switch",
      "replaces": "__FRONTEND_NAME__",
      "parameters": {
        "evaluator": "C++",
        "datatype": "string",
        "cases": [
          { "condition": "(frontend == 'vue')", "value": "Vue" },
          { "condition": "(frontend == 'svelte')", "value": "Svelte" },
          { "condition": "(frontend == 'sveltekit')", "value": "SvelteKit" },
          { "condition": "(frontend == 'angular')", "value": "Angular" },
          { "value": "React" }
        ]
      }
    },
    "developmentServerName": {
      "type": "generated",
      "generator": "switch",
      "replaces": "__DEVELOPMENT_SERVER_NAME__",
      "parameters": {
        "evaluator": "C++",
        "datatype": "string",
        "cases": [
          { "condition": "(frontend == 'angular')", "value": "Angular CLI" },
          { "value": "Vite" }
        ]
      }
    },
    "derivedFrontendPackageName": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "npmPackageName",
      "description": "The project name as an npm package name; empty when no npm characters remain."
    },
    "fallbackFrontendPackageName": {
      "type": "generated",
      "generator": "constant",
      "parameters": { "value": "app" }
    },
    "frontendPackageName": {
      "type": "generated",
      "generator": "coalesce",
      "parameters": {
        "sourceVariableName": "derivedFrontendPackageName",
        "fallbackVariableName": "fallbackFrontendPackageName"
      },
      "replaces": "@runic-artifex/runic-app-starter",
      "description": "The frontend package.json name, derived from the project name."
    }
  },
  "forms": {
    "npmKebabCase": {
      "identifier": "kebabCase"
    },
    "npmUrlSafeCharacters": {
      "identifier": "replace",
      "pattern": "-*[^a-z0-9._-][^a-z0-9._]*",
      "replacement": "-"
    },
    "npmMaximumLength": {
      "identifier": "replace",
      "pattern": "^(.{214}).+$",
      "replacement": "$1"
    },
    "npmTrimmedSeparators": {
      "identifier": "replace",
      "pattern": "^[._-]+|[._-]+$",
      "replacement": ""
    },
    "applicationIdCharacters": {
      "identifier": "replace",
      "pattern": "[^A-Za-z0-9]",
      "replacement": ""
    },
    "applicationIdLeadingLetter": {
      "identifier": "replace",
      "pattern": "^([0-9])",
      "replacement": "App$1"
    },
    "applicationIdMaximumLength": {
      "identifier": "replace",
      "pattern": "^(.{38}).+$",
      "replacement": "$1"
    },
    "applicationIdName": {
      "identifier": "chain",
      "steps": [ "applicationIdCharacters", "applicationIdLeadingLetter", "applicationIdMaximumLength" ]
    },
    "npmPackageName": {
      "identifier": "chain",
      "steps": [ "npmKebabCase", "npmUrlSafeCharacters", "npmMaximumLength", "npmTrimmedSeparators" ]
    }
  },
  "SpecialCustomOperations": {
    "**/*.nix": {
      "operations": [
        { "type": "conditional", "configuration": { "if": [ "#if" ], "else": [ "#else" ], "elseif": [ "#elif" ], "endif": [ "#endif" ], "trim": true, "wholeLine": true } }
      ]
    },
    "**/.gitignore": {
      "operations": [
        { "type": "conditional", "configuration": { "if": [ "#if" ], "else": [ "#else" ], "elseif": [ "#elif" ], "endif": [ "#endif" ], "trim": true, "wholeLine": true } }
      ]
    }
  },
  "primaryOutputs": [
    {
      "path": "RunicWindowApp.csproj"
    },
    {
      "condition": "(tests)",
      "path": "RunicWindowApp.Tests/RunicWindowApp.Tests.csproj"
    }
  ],
  "postActions": [
    {
      "condition": "(restore)",
      "description": "Restores the NuGet packages of the created projects.",
      "manualInstructions": [ { "text": "Run 'dotnet restore'" } ],
      "actionId": "210D431B-A78B-4D2F-B762-4ED3E3EA9025",
      "continueOnError": true
    }
  ]
}
