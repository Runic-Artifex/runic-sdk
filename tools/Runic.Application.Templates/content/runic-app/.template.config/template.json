{
  "$schema": "http://json.schemastore.org/template",
  "author": "Runic Artifex",
  "classifications": [
    "Desktop",
    "Runic Views",
    "React",
    "Vue",
    "Svelte",
    "SvelteKit",
    "Angular"
  ],
  "identity": "Runic.Application.Templates.App",
  "name": "Runic application",
  "description": "A desktop application in a native window, with C# ViewModels and a React, Vue, Svelte, SvelteKit, or Angular frontend.",
  "shortName": "runic-app",
  "sourceName": "RunicWindowApp",
  "preferNameDirectory": true,
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "sources": [
    {
      "source": "./",
      "target": "./",
      "exclude": [
        ".template.config/**/*",
        "frontends/**/*",
        "translations/**/*",
        "library/**/*",
        "**/*.filelist",
        "**/*.user"
      ],
      "copyOnly": [ "icons/*.png", "icons/*.ico" ],
      "modifiers": [
        { "condition": "(!tests)", "exclude": [ "RunicWindowApp.Tests/**/*", "global.json" ] },
        { "condition": "(!withNix)", "exclude": [ "flake.nix" ] },
        { "condition": "(hasLibrary)", "exclude": [ "flake.nix" ] },
        { "condition": "(!packaging)", "exclude": [ "packaging/**/*" ] },
        { "condition": "(editor != 'vscode')", "exclude": [ ".vscode/**/*" ] },
        {
          "condition": "(hasLibrary)",
          "rename": {
            "RunicWindowApp.csproj": "RunicWindowApp/RunicWindowApp.csproj",
            "Program.cs": "RunicWindowApp/Program.cs",
            "Views.cs": "RunicWindowApp/Views.cs",
            "WorkspaceViewModel.cs": "RunicWindowApp/WorkspaceViewModel.cs",
            "WorkspaceServices.cs": "RunicWindowApp/WorkspaceServices.cs",
            "ApplicationIdentity.cs": "RunicWindowApp/ApplicationIdentity.cs",
            "README.md": "RunicWindowApp/README.md",
            "Properties/": "RunicWindowApp/Properties/",
            "icons/": "RunicWindowApp/icons/",
            "packaging/": "RunicWindowApp/packaging/"
          }
        }
      ]
    },
    {
      "source": "./frontends/react/",
      "target": "./Frontend/",
      "condition": "(!hasLibrary && frontend == 'react')",
      "modifiers": [
        { "condition": "(withTranslations)", "exclude": [ "src/main.tsx", "src/App.tsx", "src/pages/WelcomePage.tsx", "src/pages/CounterPage.tsx", "src/App.test.tsx", "vite.config.ts", "package.json", "package-lock.json", "pnpm-lock.yaml", "bun.lock" ] },
        { "condition": "(packageManager != 'npm')", "exclude": [ "package-lock.json" ] },
        { "condition": "(packageManager != 'pnpm')", "exclude": [ "pnpm-lock.yaml" ] },
        { "condition": "(packageManager != 'bun')", "exclude": [ "bun.lock" ] }
      ]
    },
    {
      "source": "./frontends/vue/",
      "target": "./Frontend/",
      "condition": "(!hasLibrary && frontend == 'vue')",
      "modifiers": [
        { "condition": "(withTranslations)", "exclude": [ "src/main.ts", "src/App.vue", "src/pages/WelcomePage.vue", "src/pages/CounterPage.vue", "src/App.test.ts", "vite.config.ts", "package.json", "package-lock.json", "pnpm-lock.yaml", "bun.lock" ] },
        { "condition": "(packageManager != 'npm')", "exclude": [ "package-lock.json" ] },
        { "condition": "(packageManager != 'pnpm')", "exclude": [ "pnpm-lock.yaml" ] },
        { "condition": "(packageManager != 'bun')", "exclude": [ "bun.lock" ] }
      ]
    },
    {
      "source": "./frontends/svelte/",
      "target": "./Frontend/",
      "condition": "(!hasLibrary && frontend == 'svelte')",
      "modifiers": [
        { "condition": "(withTranslations)", "exclude": [ "src/main.ts", "src/App.svelte", "src/pages/WelcomePage.svelte", "src/pages/CounterPage.svelte", "src/App.test.ts", "vite.config.ts", "package.json", "package-lock.json", "pnpm-lock.yaml", "bun.lock" ] },
        { "condition": "(packageManager != 'npm')", "exclude": [ "package-lock.json" ] },
        { "condition": "(packageManager != 'pnpm')", "exclude": [ "pnpm-lock.yaml" ] },
        { "condition": "(packageManager != 'bun')", "exclude": [ "bun.lock" ] }
      ]
    },
    {
      "source": "./frontends/sveltekit/",
      "target": "./Frontend/",
      "condition": "(!hasLibrary && frontend == 'sveltekit')",
      "modifiers": [
        { "condition": "(withTranslations)", "exclude": [ "src/hooks.client.ts", "src/routes/+page.svelte", "src/lib/pages/WelcomePage.svelte", "src/lib/pages/CounterPage.svelte", "src/routes/page.test.ts", "vite.config.ts", "package.json", "package-lock.json", "pnpm-lock.yaml", "bun.lock" ] },
        { "condition": "(packageManager != 'npm')", "exclude": [ "package-lock.json" ] },
        { "condition": "(packageManager != 'pnpm')", "exclude": [ "pnpm-lock.yaml" ] },
        { "condition": "(packageManager != 'bun')", "exclude": [ "bun.lock" ] }
      ]
    },
    {
      "source": "./frontends/angular/",
      "target": "./Frontend/",
      "condition": "(!hasLibrary && frontend == 'angular')",
      "modifiers": [
        { "condition": "(withTranslations)", "exclude": [ "src/main.ts", "src/app/app.ts", "src/app/app.html", "src/app/welcome.ts", "src/app/welcome.html", "src/app/counter.ts", "src/app/counter.html", "src/app/app.spec.ts" ] },
        { "condition": "(angularVite)", "exclude": [ "angular.json", "proxy.conf.mjs", "src/index.html", "src/main.ts", "package.json", "package-lock.json", "pnpm-lock.yaml", "bun.lock" ] },
        { "condition": "(packageManager != 'npm')", "exclude": [ "package-lock.json" ] },
        { "condition": "(packageManager != 'pnpm')", "exclude": [ "pnpm-lock.yaml", "pnpm-workspace.yaml" ] },
        { "condition": "(!angularVite)", "exclude": [ "pnpm-workspace.yaml" ] },
        { "condition": "(packageManager != 'bun')", "exclude": [ "bun.lock" ] }
      ]
    },
    {
      "source": "./frontends/angular-vite/",
      "target": "./Frontend/",
      "condition": "(!hasLibrary && angularVite)",
      "modifiers": [
        { "condition": "(withTranslations)", "exclude": [ "src/main.ts", "vite.config.ts", "package.json", "package-lock.json", "pnpm-lock.yaml", "bun.lock" ] },
        { "condition": "(packageManager != 'npm')", "exclude": [ "package-lock.json" ] },
        { "condition": "(packageManager != 'pnpm')", "exclude": [ "pnpm-lock.yaml" ] },
        { "condition": "(packageManager != 'bun')", "exclude": [ "bun.lock" ] }
      ]
    },
    {
      "source": "./library/",
      "target": "./",
      "condition": "(hasLibrary)",
      "exclude": [ "frontends/**/*", "workspaces/**/*" ]
    },
    {
      "source": "./frontends/react/",
      "target": "./RunicWindowApp/Frontend/",
      "condition": "(hasLibrary && frontend == 'react')",
      "modifiers": [
        { "condition": "(hasLibrary)", "exclude": [ "package.json", "package-lock.json", "pnpm-lock.yaml", "bun.lock", "src/App.tsx", "src/App.test.tsx" ] }
      ]
    },
    {
      "source": "./library/frontends/react/",
      "target": "./RunicWindowApp/Frontend/",
      "condition": "(hasLibrary && frontend == 'react')"
    },
    {
      "source": "./frontends/vue/",
      "target": "./RunicWindowApp/Frontend/",
      "condition": "(hasLibrary && frontend == 'vue')",
      "modifiers": [
        { "condition": "(hasLibrary)", "exclude": [ "package.json", "package-lock.json", "pnpm-lock.yaml", "bun.lock", "src/App.vue", "src/App.test.ts" ] }
      ]
    },
    {
      "source": "./library/frontends/vue/",
      "target": "./RunicWindowApp/Frontend/",
      "condition": "(hasLibrary && frontend == 'vue')"
    },
    {
      "source": "./frontends/svelte/",
      "target": "./RunicWindowApp/Frontend/",
      "condition": "(hasLibrary && frontend == 'svelte')",
      "modifiers": [
        { "condition": "(hasLibrary)", "exclude": [ "package.json", "package-lock.json", "pnpm-lock.yaml", "bun.lock", "src/App.svelte", "src/App.test.ts" ] }
      ]
    },
    {
      "source": "./library/frontends/svelte/",
      "target": "./RunicWindowApp/Frontend/",
      "condition": "(hasLibrary && frontend == 'svelte')"
    },
    {
      "source": "./frontends/sveltekit/",
      "target": "./RunicWindowApp/Frontend/",
      "condition": "(hasLibrary && frontend == 'sveltekit')",
      "modifiers": [
        { "condition": "(hasLibrary)", "exclude": [ "package.json", "package-lock.json", "pnpm-lock.yaml", "bun.lock", "src/routes/+page.svelte", "src/routes/page.test.ts" ] }
      ]
    },
    {
      "source": "./library/frontends/sveltekit/",
      "target": "./RunicWindowApp/Frontend/",
      "condition": "(hasLibrary && frontend == 'sveltekit')"
    },
    {
      "source": "./frontends/angular/",
      "target": "./RunicWindowApp/Frontend/",
      "condition": "(hasLibrary && frontend == 'angular')",
      "modifiers": [
        { "condition": "(angularVite)", "exclude": [ "angular.json", "proxy.conf.mjs", "src/index.html", "src/main.ts" ] },
        { "condition": "(hasLibrary)", "exclude": [ "package.json", "package-lock.json", "pnpm-lock.yaml", "bun.lock", "pnpm-workspace.yaml", "src/app/app.ts", "src/app/app.html", "src/app/app.spec.ts" ] }
      ]
    },
    {
      "source": "./library/frontends/angular/",
      "target": "./RunicWindowApp/Frontend/",
      "condition": "(hasLibrary && frontend == 'angular')",
      "modifiers": [
        { "condition": "(angularVite)", "exclude": [ "package.json" ] }
      ]
    },
    {
      "source": "./frontends/angular-vite/",
      "target": "./RunicWindowApp/Frontend/",
      "condition": "(hasLibrary && angularVite)",
      "modifiers": [
        { "condition": "(hasLibrary)", "exclude": [ "package.json", "package-lock.json", "pnpm-lock.yaml", "bun.lock" ] }
      ]
    },
    {
      "source": "./library/frontends/angular-vite/",
      "target": "./RunicWindowApp/Frontend/",
      "condition": "(hasLibrary && angularVite)"
    },
    {
      "source": "./library/workspaces/react/",
      "target": "./",
      "condition": "(hasLibrary && frontend == 'react')",
      "modifiers": [
        { "condition": "(packageManager != 'npm')", "exclude": [ "package-lock.json" ] },
        { "condition": "(packageManager != 'pnpm')", "exclude": [ "pnpm-lock.yaml", "pnpm-workspace.yaml" ] },
        { "condition": "(packageManager != 'bun')", "exclude": [ "bun.lock" ] }
      ]
    },
    {
      "source": "./library/workspaces/vue/",
      "target": "./",
      "condition": "(hasLibrary && frontend == 'vue')",
      "modifiers": [
        { "condition": "(packageManager != 'npm')", "exclude": [ "package-lock.json" ] },
        { "condition": "(packageManager != 'pnpm')", "exclude": [ "pnpm-lock.yaml", "pnpm-workspace.yaml" ] },
        { "condition": "(packageManager != 'bun')", "exclude": [ "bun.lock" ] }
      ]
    },
    {
      "source": "./library/workspaces/svelte/",
      "target": "./",
      "condition": "(hasLibrary && frontend == 'svelte')",
      "modifiers": [
        { "condition": "(packageManager != 'npm')", "exclude": [ "package-lock.json" ] },
        { "condition": "(packageManager != 'pnpm')", "exclude": [ "pnpm-lock.yaml", "pnpm-workspace.yaml" ] },
        { "condition": "(packageManager != 'bun')", "exclude": [ "bun.lock" ] }
      ]
    },
    {
      "source": "./library/workspaces/sveltekit/",
      "target": "./",
      "condition": "(hasLibrary && frontend == 'sveltekit')",
      "modifiers": [
        { "condition": "(packageManager != 'npm')", "exclude": [ "package-lock.json" ] },
        { "condition": "(packageManager != 'pnpm')", "exclude": [ "pnpm-lock.yaml", "pnpm-workspace.yaml" ] },
        { "condition": "(packageManager != 'bun')", "exclude": [ "bun.lock" ] }
      ]
    },
    {
      "source": "./library/workspaces/angular/",
      "target": "./",
      "condition": "(hasLibrary && angularCli)",
      "modifiers": [
        { "condition": "(packageManager != 'npm')", "exclude": [ "package-lock.json" ] },
        { "condition": "(packageManager != 'pnpm')", "exclude": [ "pnpm-lock.yaml", "pnpm-workspace.yaml" ] },
        { "condition": "(packageManager != 'bun')", "exclude": [ "bun.lock" ] }
      ]
    },
    {
      "source": "./library/workspaces/angular-vite/",
      "target": "./",
      "condition": "(hasLibrary && angularVite)",
      "modifiers": [
        { "condition": "(packageManager != 'npm')", "exclude": [ "package-lock.json" ] },
        { "condition": "(packageManager != 'pnpm')", "exclude": [ "pnpm-lock.yaml", "pnpm-workspace.yaml" ] },
        { "condition": "(packageManager != 'bun')", "exclude": [ "bun.lock" ] }
      ]
    },
    {
      "source": "./translations/catalog/",
      "target": "./Frontend/translations/",
      "condition": "(withTranslations)"
    },
    {
      "source": "./translations/react/",
      "target": "./Frontend/",
      "condition": "(withTranslations && frontend == 'react')",
      "modifiers": [
        { "condition": "(packageManager != 'npm')", "exclude": [ "package-lock.json" ] },
        { "condition": "(packageManager != 'pnpm')", "exclude": [ "pnpm-lock.yaml" ] },
        { "condition": "(packageManager != 'bun')", "exclude": [ "bun.lock" ] }
      ]
    },
    {
      "source": "./translations/vue/",
      "target": "./Frontend/",
      "condition": "(withTranslations && frontend == 'vue')",
      "modifiers": [
        { "condition": "(packageManager != 'npm')", "exclude": [ "package-lock.json" ] },
        { "condition": "(packageManager != 'pnpm')", "exclude": [ "pnpm-lock.yaml" ] },
        { "condition": "(packageManager != 'bun')", "exclude": [ "bun.lock" ] }
      ]
    },
    {
      "source": "./translations/svelte/",
      "target": "./Frontend/",
      "condition": "(withTranslations && frontend == 'svelte')",
      "modifiers": [
        { "condition": "(packageManager != 'npm')", "exclude": [ "package-lock.json" ] },
        { "condition": "(packageManager != 'pnpm')", "exclude": [ "pnpm-lock.yaml" ] },
        { "condition": "(packageManager != 'bun')", "exclude": [ "bun.lock" ] }
      ]
    },
    {
      "source": "./translations/sveltekit/",
      "target": "./Frontend/",
      "condition": "(withTranslations && frontend == 'sveltekit')",
      "modifiers": [
        { "condition": "(packageManager != 'npm')", "exclude": [ "package-lock.json" ] },
        { "condition": "(packageManager != 'pnpm')", "exclude": [ "pnpm-lock.yaml" ] },
        { "condition": "(packageManager != 'bun')", "exclude": [ "bun.lock" ] }
      ]
    },
    {
      "source": "./translations/angular/",
      "target": "./Frontend/",
      "condition": "(withTranslations && frontend == 'angular')",
      "modifiers": [
        { "condition": "(angularVite)", "exclude": [ "src/main.ts", "src/translations.ts", "src/app/app.spec.ts" ] }
      ]
    },
    {
      "source": "./translations/angular-vite/",
      "target": "./Frontend/",
      "condition": "(withTranslations && angularVite)",
      "modifiers": [
        { "condition": "(packageManager != 'npm')", "exclude": [ "package-lock.json" ] },
        { "condition": "(packageManager != 'pnpm')", "exclude": [ "pnpm-lock.yaml" ] },
        { "condition": "(packageManager != 'bun')", "exclude": [ "bun.lock" ] }
      ]
    }
  ],
  "symbols": {
    "frontend": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "react",
      "displayName": "Frontend",
      "description": "The web framework that renders the ViewModels.",
      "choices": [
        { "choice": "react", "displayName": "React", "description": "React 19 with Vite" },
        { "choice": "vue", "displayName": "Vue", "description": "Vue 3 with Vite" },
        { "choice": "svelte", "displayName": "Svelte", "description": "Svelte 5 with Vite" },
        { "choice": "sveltekit", "displayName": "SvelteKit", "description": "SvelteKit 3 with Vite, prerendered by the Runic SvelteKit adapter" },
        { "choice": "angular", "displayName": "Angular", "description": "Angular 22, built with the Angular CLI or with Vite (--angular-build)" }
      ]
    },
    "angularBuild": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "cli",
      "displayName": "Angular build",
      "description": "What builds, serves and tests an Angular frontend. The other frontends build with Vite.",
      "choices": [
        { "choice": "cli", "displayName": "Angular CLI", "description": "The Angular CLI: ng build, ng serve and ng test" },
        { "choice": "vite", "displayName": "Vite", "description": "Vite with the Analog Angular plugin and the Runic Vite plugins: the Translations development loop, the Vite DevTools dock and the component build target" }
      ]
    },
    "angularVite": {
      "type": "computed",
      "value": "(frontend == 'angular' && angularBuild == 'vite')"
    },
    "angularCli": {
      "type": "computed",
      "value": "(frontend == 'angular' && angularBuild != 'vite')"
    },
    "packageManager": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "npm",
      "replaces": "__PACKAGE_MANAGER_NAME__",
      "displayName": "Package manager",
      "description": "JavaScript package manager used for frontend restore and development.",
      "choices": [
        { "choice": "npm", "displayName": "npm", "description": "npm with package-lock.json" },
        { "choice": "pnpm", "displayName": "pnpm", "description": "pnpm with pnpm-lock.yaml" },
        { "choice": "bun", "displayName": "Bun", "description": "Bun with bun.lock" }
      ]
    },
    "host": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "desktop",
      "displayName": "Window host",
      "description": "How the application presents its Window.",
      "choices": [
        { "choice": "desktop", "displayName": "Runic Desktop", "description": "Opens a native window with the embedded WebView, native file dialogs and the clipboard" },
        { "choice": "cswebui", "displayName": "CS-WebUI", "description": "Opens a browser window (an installed browser in app mode, then the platform WebView); best effort, without native dialogs or clipboard" }
      ]
    },
    "linuxGtk": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "3",
      "displayName": "Linux GTK version",
      "description": "The GTK version Runic Desktop uses on Linux. Windows and macOS, and the CS-WebUI host, are the same with either.",
      "choices": [
        { "choice": "3", "displayName": "GTK 3", "description": "GTK 3 and WebKitGTK 4.1" },
        { "choice": "4", "displayName": "GTK 4", "description": "GTK 4, WebKitGTK 6 and portal pickers" }
      ]
    },
    "desktopServer": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "native",
      "displayName": "Desktop server",
      "description": "The server Runic Desktop serves the page from. The CS-WebUI host has its own.",
      "choices": [
        { "choice": "native", "displayName": "Native", "description": "Runic.Desktop.NativeServer (Rust): no ASP.NET Core in the application, smaller and faster to start" },
        { "choice": "kestrel", "displayName": "Kestrel", "description": "Runic.Desktop.Kestrel: ASP.NET Core Kestrel, for an application that uses ASP.NET Core itself" }
      ]
    },
    "desktopHost": {
      "type": "computed",
      "value": "(host == 'desktop')"
    },
    "nativeServer": {
      "type": "computed",
      "value": "(host == 'desktop' && desktopServer == 'native')"
    },
    "gtk4": {
      "type": "computed",
      "value": "(host == 'desktop' && linuxGtk == '4')"
    },
    "nixHost": {
      "type": "generated",
      "generator": "switch",
      "replaces": "__RUNIC_HOST__",
      "description": "The host name that the Runic SDK's Nix functions take: desktop, desktop-gtk4 or cswebui.",
      "parameters": {
        "evaluator": "C++",
        "datatype": "string",
        "cases": [
          { "condition": "(host == 'cswebui')", "value": "cswebui" },
          { "condition": "(linuxGtk == '4')", "value": "desktop-gtk4" },
          { "value": "desktop" }
        ]
      }
    },
    "viewModels": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "reactiveui",
      "displayName": "ViewModels",
      "description": "The MVVM library for the C# ViewModels.",
      "choices": [
        { "choice": "reactiveui", "displayName": "ReactiveUI", "description": "ReactiveUI 26 Primitives: reactive objects and commands on the Window's model context" },
        { "choice": "toolkit", "displayName": "CommunityToolkit.Mvvm", "description": "Source-generated properties and relay commands" }
      ]
    },
    "editor": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "none",
      "displayName": "Editor files",
      "description": "Editor configuration to add beside Properties/launchSettings.json, which Visual Studio, Rider and dotnet run read.",
      "choices": [
        { "choice": "none", "displayName": "None", "description": "No editor folder; Visual Studio and Rider use the launch profiles" },
        { "choice": "vscode", "displayName": "VS Code", "description": "Adds .vscode/ with tasks for dotnet runic dev, debug configurations for the C# extension and the recommended extensions" }
      ]
    },
    "library": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "",
      "replaces": "RunicCoreLibrary",
      "fileRename": "RunicCoreLibrary",
      "displayName": "Library project",
      "description": "Creates a solution: the application in a folder of its own, and a library project with this name, such as Notes.Core, for ViewModels and Views that more applications can share. The library's build generates their TypeScript clients into its frontend package, which the application's page imports from one JavaScript workspace with a lock file at the solution's root. Not with --translations or --nix yet: with them, the template warns and leaves them out."
    },
    "hasLibrary": {
      "type": "computed",
      "value": "(library != '')"
    },
    "libraryNamespace": {
      "type": "derived",
      "valueSource": "library",
      "valueTransform": "namespaceName",
      "replaces": "RunicCoreNamespace",
      "description": "The library's name as a C# namespace."
    },
    "derivedLibraryPackageName": {
      "type": "derived",
      "valueSource": "library",
      "valueTransform": "npmPackageName",
      "description": "The library's name as an npm package name; empty when no npm characters remain."
    },
    "fallbackLibraryPackageName": {
      "type": "generated",
      "generator": "constant",
      "parameters": { "value": "library" }
    },
    "libraryPackageName": {
      "type": "generated",
      "generator": "coalesce",
      "parameters": {
        "sourceVariableName": "derivedLibraryPackageName",
        "fallbackVariableName": "fallbackLibraryPackageName"
      },
      "replaces": "runic-library-starter",
      "description": "The library's frontend package name, derived from the library's name."
    },
    "libraryDependency": {
      "type": "generated",
      "generator": "switch",
      "replaces": "__LIBRARY_DEPENDENCY__",
      "description": "How the application's frontend depends on the library's package in the workspace: pnpm and Bun link it with the workspace protocol, npm links the workspace whose name it has.",
      "parameters": {
        "evaluator": "C++",
        "datatype": "string",
        "cases": [
          { "condition": "(packageManager == 'npm')", "value": "*" },
          { "value": "workspace:*" }
        ]
      }
    },
    "tests": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "displayName": "Test project",
      "description": "Adds a TUnit test project that drives the Window headlessly with Runic.Application.Testing."
    },
    "translations": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "displayName": "Translations",
      "description": "Translates the application with Runic Translations 0.9: one catalog in English and German for the page and C#, a language switch, the application's language for every window, RUNIC_LOCALE for test runs, and a test of the translated text. Not with --library yet."
    },
    "withTranslations": {
      "type": "computed",
      "value": "(translations && library == '')",
      "description": "--translations applies: --library does not support it yet, and a post-action warns that it was left out (sdk#1386)."
    },
    "translationsVitePlugin": {
      "type": "computed",
      "value": "(withTranslations && (frontend != 'angular' || angularBuild == 'vite'))",
      "description": "The page compiles the catalog with the Translations Vite plugin (every frontend Vite builds); the Angular CLI imports the ESM that the .NET build generates."
    },
    "nix": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "displayName": "Nix flake",
      "description": "Adds a Nix flake that builds the application in the Nix sandbox with the Runic SDK's buildRunicApplication, from packages.lock.json and the frontend's lock file. Not with --library yet."
    },
    "withNix": {
      "type": "computed",
      "value": "(nix && library == '')",
      "description": "--nix applies: --library does not support it yet, and a post-action warns that it was left out (sdk#1386)."
    },
    "packaging": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "displayName": "Packaging manifests",
      "description": "Adds the packaging/ manifests that dotnet runic package fills (MSIX, macOS bundle, desktop entry, AppStream metadata, Flatpak manifest), so you can edit them; the command has the same defaults built in."
    },
    "restore": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "displayName": "Restore packages",
      "description": "Restores the project's NuGet packages after creating it, for an IDE that opens it next. dotnet runic dev and dotnet build restore them, and the frontend packages, anyway."
    },
    "applicationId": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "",
      "displayName": "Application ID",
      "description": "The reverse-DNS application ID, such as org.example.Notes: the desktop entry and Flatpak ID on Linux, the bundle identifier on macOS and the package name on Windows. Default: com.example. and the project name's ASCII letters and digits, at most 50 characters, as an MSIX package name allows."
    },
    "applicationDisplayName": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "identity",
      "replaces": "__RUNIC_APPLICATION_NAME__",
      "description": "The project name as users see it."
    },
    "derivedApplicationName": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "applicationIdName",
      "description": "The project name with only ASCII letters and digits, starting with a letter; empty when none remain."
    },
    "fallbackApplicationName": {
      "type": "generated",
      "generator": "constant",
      "parameters": { "value": "App" }
    },
    "applicationName": {
      "type": "generated",
      "generator": "coalesce",
      "parameters": {
        "sourceVariableName": "derivedApplicationName",
        "fallbackVariableName": "fallbackApplicationName"
      }
    },
    "defaultApplicationId": {
      "type": "generated",
      "generator": "join",
      "parameters": {
        "symbols": [
          { "type": "const", "value": "com.example" },
          { "type": "ref", "value": "applicationName" }
        ],
        "separator": "."
      }
    },
    "applicationIdValue": {
      "type": "generated",
      "generator": "coalesce",
      "parameters": {
        "sourceVariableName": "applicationId",
        "fallbackVariableName": "defaultApplicationId"
      },
      "replaces": "__RUNIC_APPLICATION_ID__",
      "description": "The application ID that the project file declares."
    },
    "runicVersion": {
      "type": "generated",
      "generator": "constant",
      "parameters": { "value": "__RUNIC_NUGET_VERSION_DEFAULT__" },
      "replaces": "__RUNIC_NUGET_VERSION__",
      "description": "Version of the Runic NuGet packages and the dotnet-runic tool, stamped when the template is packed."
    },
    "runicCsWebUiVersion": {
      "type": "generated",
      "generator": "constant",
      "parameters": { "value": "__RUNIC_CSWEBUI_NUGET_VERSION_DEFAULT__" },
      "replaces": "__RUNIC_CSWEBUI_NUGET_VERSION__",
      "description": "Version of the preview Runic.Application.Views.CsWebUi package, which ships on a prerelease version with each release, stamped when the template is packed."
    },
    "runicNpmVersion": {
      "type": "generated",
      "generator": "constant",
      "parameters": { "value": "__RUNIC_NPM_VERSION_DEFAULT__" },
      "replaces": "__RUNIC_NPM_VERSION__",
      "description": "Version of the Runic npm packages, stamped when the template is packed."
    },
    "packageManagerDeclaration": {
      "type": "generated",
      "generator": "switch",
      "replaces": "__PACKAGE_MANAGER__",
      "parameters": {
        "evaluator": "C++",
        "datatype": "string",
        "cases": [
          { "condition": "(packageManager == 'pnpm')", "value": "pnpm@__PNPM_PACKAGE_MANAGER_VERSION__" },
          { "condition": "(packageManager == 'bun')", "value": "bun@__BUN_PACKAGE_MANAGER_VERSION__" },
          { "value": "npm@__NPM_PACKAGE_MANAGER_VERSION__" }
        ]
      }
    },
    "frontendName": {
      "type": "generated",
      "generator": "switch",
      "replaces": "__FRONTEND_NAME__",
      "parameters": {
        "evaluator": "C++",
        "datatype": "string",
        "cases": [
          { "condition": "(frontend == 'vue')", "value": "Vue" },
          { "condition": "(frontend == 'svelte')", "value": "Svelte" },
          { "condition": "(frontend == 'sveltekit')", "value": "SvelteKit" },
          { "condition": "(frontend == 'angular')", "value": "Angular" },
          { "value": "React" }
        ]
      }
    },
    "developmentServerName": {
      "type": "generated",
      "generator": "switch",
      "replaces": "__DEVELOPMENT_SERVER_NAME__",
      "parameters": {
        "evaluator": "C++",
        "datatype": "string",
        "cases": [
          { "condition": "(frontend == 'angular' && angularBuild != 'vite')", "value": "Angular CLI" },
          { "value": "Vite" }
        ]
      }
    },
    "derivedFrontendPackageName": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "npmPackageName",
      "description": "The project name as an npm package name; empty when no npm characters remain."
    },
    "fallbackFrontendPackageName": {
      "type": "generated",
      "generator": "constant",
      "parameters": { "value": "app" }
    },
    "frontendPackageName": {
      "type": "generated",
      "generator": "coalesce",
      "parameters": {
        "sourceVariableName": "derivedFrontendPackageName",
        "fallbackVariableName": "fallbackFrontendPackageName"
      },
      "replaces": "@runic-artifex/runic-app-starter",
      "description": "The frontend package.json name, derived from the project name."
    }
  },
  "forms": {
    "npmKebabCase": {
      "identifier": "kebabCase"
    },
    "npmUrlSafeCharacters": {
      "identifier": "replace",
      "pattern": "-*[^a-z0-9._-][^a-z0-9._]*",
      "replacement": "-"
    },
    "npmMaximumLength": {
      "identifier": "replace",
      "pattern": "^(.{214}).+$",
      "replacement": "$1"
    },
    "npmTrimmedSeparators": {
      "identifier": "replace",
      "pattern": "^[._-]+|[._-]+$",
      "replacement": ""
    },
    "applicationIdCharacters": {
      "identifier": "replace",
      "pattern": "[^A-Za-z0-9]",
      "replacement": ""
    },
    "applicationIdLeadingLetter": {
      "identifier": "replace",
      "pattern": "^([0-9])",
      "replacement": "App$1"
    },
    "applicationIdMaximumLength": {
      "identifier": "replace",
      "pattern": "^(.{38}).+$",
      "replacement": "$1"
    },
    "applicationIdName": {
      "identifier": "chain",
      "steps": [ "applicationIdCharacters", "applicationIdLeadingLetter", "applicationIdMaximumLength" ]
    },
    "namespaceCharacters": {
      "identifier": "replace",
      "pattern": "[^A-Za-z0-9_.]",
      "replacement": "_"
    },
    "namespaceLeadingCharacter": {
      "identifier": "replace",
      "pattern": "(^|[.])([0-9])",
      "replacement": "$1_$2"
    },
    "namespaceName": {
      "identifier": "chain",
      "steps": [ "namespaceCharacters", "namespaceLeadingCharacter" ]
    },
    "npmPackageName": {
      "identifier": "chain",
      "steps": [ "npmKebabCase", "npmUrlSafeCharacters", "npmMaximumLength", "npmTrimmedSeparators" ]
    }
  },
  "SpecialCustomOperations": {
    "**/*.nix": {
      "operations": [
        { "type": "conditional", "configuration": { "if": [ "#if" ], "else": [ "#else" ], "elseif": [ "#elif" ], "endif": [ "#endif" ], "trim": true, "wholeLine": true } }
      ]
    },
    "**/*.slnx": {
      "operations": [
        { "type": "conditional", "configuration": { "if": [ "<!--#if" ], "else": [ "<!--#else" ], "elseif": [ "<!--#elif" ], "endif": [ "<!--#endif" ], "trim": true, "wholeLine": true } }
      ]
    },
    "**/.gitignore": {
      "operations": [
        { "type": "conditional", "configuration": { "if": [ "#if" ], "else": [ "#else" ], "elseif": [ "#elif" ], "endif": [ "#endif" ], "trim": true, "wholeLine": true } }
      ]
    }
  },
  "primaryOutputs": [
    {
      "condition": "(!hasLibrary)",
      "path": "RunicWindowApp.csproj"
    },
    {
      "condition": "(hasLibrary)",
      "path": "RunicWindowApp/RunicWindowApp.csproj"
    },
    {
      "condition": "(hasLibrary)",
      "path": "RunicCoreLibrary/RunicCoreLibrary.csproj"
    },
    {
      "condition": "(tests)",
      "path": "RunicWindowApp.Tests/RunicWindowApp.Tests.csproj"
    }
  ],
  "postActions": [
    {
      "condition": "(hasLibrary && translations)",
      "description": "Warning: --translations was left out. --library does not support Translations yet, so the solution has no translation catalog.",
      "manualInstructions": [ { "text": "Create the application without --library to translate it (https://github.com/Runic-Artifex/runic-sdk/blob/main/tools/Runic.Application.Templates/README.md#a-solution-with-a-library)." } ],
      "actionId": "AC1156F7-BB77-4DB8-B28F-24EEBCCA1E5C",
      "continueOnError": true
    },
    {
      "condition": "(hasLibrary && nix)",
      "description": "Warning: --nix was left out. --library does not support the Nix flake yet, so the solution has no flake.nix.",
      "manualInstructions": [ { "text": "Create the application without --library to get the flake (https://github.com/Runic-Artifex/runic-sdk/blob/main/tools/Runic.Application.Templates/README.md#a-solution-with-a-library)." } ],
      "actionId": "AC1156F7-BB77-4DB8-B28F-24EEBCCA1E5C",
      "continueOnError": true
    },
    {
      "condition": "(restore)",
      "description": "Restores the NuGet packages of the created projects.",
      "manualInstructions": [ { "text": "Run 'dotnet restore'" } ],
      "actionId": "210D431B-A78B-4D2F-B762-4ED3E3EA9025",
      "continueOnError": true
    }
  ]
}
