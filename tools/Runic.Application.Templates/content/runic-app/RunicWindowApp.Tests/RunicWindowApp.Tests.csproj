<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
<!--#if (nix) -->
    <!-- dotnet restore writes packages.lock.json, from which flake.nix restores the tests in locked mode for
         linux-x64 and runs them (doCheck). They run under the JIT, also in the NativeAOT package. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RuntimeIdentifiers>linux-x64</RuntimeIdentifiers>
<!--#endif -->
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="TUnit" Version="1.73.19" />
    <PackageReference Include="Runic.Application.Testing" Version="__RUNIC_NUGET_VERSION__" />
  </ItemGroup>
  <ItemGroup>
    <!-- The tests need the application's assembly, not its built frontend. -->
    <ProjectReference Include="../RunicWindowApp.csproj" AdditionalProperties="RunicApplicationFrontendBuildEnabled=false" />
  </ItemGroup>
</Project>
