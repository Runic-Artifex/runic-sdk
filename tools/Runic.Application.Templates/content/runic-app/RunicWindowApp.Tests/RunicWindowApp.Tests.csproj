<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- dotnet restore writes packages.lock.json with the exact version and content hash of every NuGet package. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
<!--#if (nix) -->
    <!-- flake.nix restores the tests from it in locked mode for linux-x64 and runs them (doCheck). They run under
         the JIT, also in the NativeAOT package. -->
    <RuntimeIdentifiers>linux-x64</RuntimeIdentifiers>
<!--#endif -->
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="TUnit" Version="1.73.19" />
    <PackageReference Include="Runic.Application.Testing" Version="__RUNIC_NUGET_VERSION__" />
  </ItemGroup>
  <ItemGroup>
    <!-- The tests need the application's assembly, not its built frontend. -->
    <ProjectReference Include="../RunicWindowApp.csproj" AdditionalProperties="RunicApplicationFrontendBuildEnabled=false" />
  </ItemGroup>
</Project>
