<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Windows builds are GUI applications, so no console window opens next to the app. -->
    <OutputType Condition="$(RuntimeIdentifier.StartsWith('win')) Or ('$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('Windows')))">WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RunicApplicationFrontendWindowProject>true</RunicApplicationFrontendWindowProject>
    <!-- The application's identity, in one place: the desktop entry, Flatpak and GTK application ID on Linux, the
         bundle identifier on macOS and the package name on Windows. Program.cs reads it from the assembly. -->
    <ApplicationId>__RUNIC_APPLICATION_ID__</ApplicationId>
    <ApplicationTitle>__RUNIC_APPLICATION_NAME__</ApplicationTitle>
    <Version>1.0.0</Version>
<!--#if (packaging) -->
    <!-- dotnet runic package reads these too. The summary software centers and the Start menu show. -->
    <Description>A Runic desktop application</Description>
    <PackageProjectUrl>https://example.com</PackageProjectUrl>
    <!-- The MSIX package's publisher: the subject of the certificate that signs it. -->
    <RunicApplicationPublisher>CN=Example</RunicApplicationPublisher>
    <!-- URL schemes the application opens, separated by semicolons, such as the redirect of an OAuth sign-in. The
         packages register them; see "Package it" in the README. -->
    <RunicApplicationUrlSchemes></RunicApplicationUrlSchemes>
    <!-- File types the application opens, separated by semicolons: an extension with its dot, optionally with its MIME
         type, such as .notes=application/x-example-notes. The packages declare each as the application's own type. -->
    <RunicApplicationFileTypes></RunicApplicationFileTypes>
    <!-- Hosts whose https links the application opens, separated by semicolons, such as notes.example.org: Windows app
         URI handlers and macOS universal links, which also need a file on each host; see the README. -->
    <RunicApplicationWebLinkHosts></RunicApplicationWebLinkHosts>
    <!-- true when the application serves D-Bus activation on Linux (PortalApplication.ExportApplicationAsync): the
         desktop entry sets DBusActivatable=true and the Flatpak exports a D-Bus service file. -->
    <RunicApplicationDBusActivatable>false</RunicApplicationDBusActivatable>
<!--#endif -->
    <!-- The Explorer and taskbar icon; icons/ holds the same placeholder as SVG and PNG. -->
    <ApplicationIcon>icons/icon.ico</ApplicationIcon>
    <!-- dotnet restore writes packages.lock.json with the exact version and content hash of every NuGet package.
         Commit it: a later restore that resolves a different package fails instead of using it. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
<!--#if (nix) -->
    <!-- dotnet restore -p:PublishAot=true writes packages.aot.lock.json, whose graph adds the NativeAOT compiler.
         flake.nix restores from both lock files in locked mode for linux-x64, so they list that runtime's packages
         too. -->
    <RuntimeIdentifiers>linux-x64</RuntimeIdentifiers>
    <NuGetLockFilePath Condition="'$(PublishAot)' == 'true'">packages.aot.lock.json</NuGetLockFilePath>
<!--#endif -->
<!--#if (tests) -->
    <!-- The test project has its own sources and build output. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);RunicWindowApp.Tests/**</DefaultItemExcludes>
<!--#endif -->
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="ApplicationId" Value="$(ApplicationId)" />
    <AssemblyMetadata Include="ApplicationTitle" Value="$(ApplicationTitle)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
<!--#if (viewModels == "reactiveui") -->
    <PackageReference Include="Runic.Application.Views.ReactiveUI" Version="__RUNIC_NUGET_VERSION__" />
<!--#else -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
<!--#endif -->
<!--#if (desktopHost) -->
    <PackageReference Include="Runic.Application.Views.Desktop" Version="__RUNIC_NUGET_VERSION__" />
<!--#if (gtk4) -->
    <PackageReference Include="Runic.Desktop.Gtk4" Version="__RUNIC_NUGET_VERSION__" />
<!--#endif -->
<!--#else -->
    <PackageReference Include="Runic.Application.Views.CsWebUi" Version="__RUNIC_CSWEBUI_NUGET_VERSION__" />
<!--#endif -->
  </ItemGroup>
</Project>
