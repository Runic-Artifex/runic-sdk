{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dotnet: tool restore",
      "detail": "Installs the project's dotnet runic tool",
      "type": "process",
      "command": "dotnet",
      "args": ["tool", "restore"],
      "problemMatcher": []
    },
    {
      // dotnet runic dev: the development server and the Window, restarted after each C# edit. While it runs, the errors of
      // each rebuild and its failures (RAPPDEV) go to the Problems panel; the task is ready at each [dev] Ready. VS Code
      // removes a background task's problems when its process ends, so a failure that ends dev, such as a failed first
      // build, stays in this terminal. Runic DevKit's "Start dotnet runic dev" runs this task in DevKit's own terminal,
      // which keeps it in Problems.
      "label": "runic: dev",
      "detail": "dotnet runic dev",
      "type": "process",
      "command": "dotnet",
//#if (hasLibrary)
      "args": ["runic", "dev", "--project", "RunicWindowApp/RunicWindowApp.csproj"],
//#else
      "args": ["runic", "dev"],
//#endif
      "dependsOn": ["dotnet: tool restore"],
      "isBackground": true,
      "problemMatcher": {
        // VS Code's $msCompile, after an optional "[host] ", "[app] " or "[vite] ": dev puts its child process's label
        // before each of that process's lines, so a rebuild's errors read "[host] /path/File.cs(18,5): error CS1002: ...".
        // The file holds no ": " and the subcategory before "error" no colon: dev also prints a failure as a sentence
        // ("..., so dev did not start: /path/index.ts(12,14): error TS2322: ..."), which is not a file.
        "owner": "msCompile",
        "applyTo": "allDocuments",
        "fileLocation": "absolute",
        "pattern": {
          "regexp": "^(?:\\[(?:host|app|vite)\\] )?\\s*(?:\\s*\\d+>)?(\\S(?:(?!:\\s).)*?)(?:\\((\\d+|\\d+,\\d+|\\d+,\\d+,\\d+,\\d+)\\))?\\s*:\\s+(?:([^\\s:]+)\\s+)?((?:fatal +)?error|warning|info)\\s+(\\w+\\d+)?\\s*:\\s*(.*)$",
          "file": 1,
          "location": 2,
          "severity": 4,
          "code": 5,
          "message": 6
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^\\[dev\\] (Evaluating|Window exited|Reloading)",
          "endsPattern": "^\\[dev\\] Ready$"
        }
      }
    },
    {
      // Only the frontend: the Window runs under the debugger instead (launch.json, "Window").
      "label": "runic: dev --no-window",
      "detail": "dotnet runic dev --no-window",
      "type": "process",
      "command": "dotnet",
//#if (hasLibrary)
      "args": ["runic", "dev", "--no-window", "--project", "RunicWindowApp/RunicWindowApp.csproj"],
//#else
      "args": ["runic", "dev", "--no-window"],
//#endif
      "dependsOn": ["dotnet: tool restore"],
      "isBackground": true,
      "problemMatcher": {
        // VS Code's $msCompile, after an optional "[host] ", "[app] " or "[vite] ": dev puts its child process's label
        // before each of that process's lines, so a rebuild's errors read "[host] /path/File.cs(18,5): error CS1002: ...".
        // The file holds no ": " and the subcategory before "error" no colon: dev also prints a failure as a sentence
        // ("..., so dev did not start: /path/index.ts(12,14): error TS2322: ..."), which is not a file.
        "owner": "msCompile",
        "applyTo": "allDocuments",
        "fileLocation": "absolute",
        "pattern": {
          "regexp": "^(?:\\[(?:host|app|vite)\\] )?\\s*(?:\\s*\\d+>)?(\\S(?:(?!:\\s).)*?)(?:\\((\\d+|\\d+,\\d+|\\d+,\\d+,\\d+,\\d+)\\))?\\s*:\\s+(?:([^\\s:]+)\\s+)?((?:fatal +)?error|warning|info)\\s+(\\w+\\d+)?\\s*:\\s*(.*)$",
          "file": 1,
          "location": 2,
          "severity": 4,
          "code": 5,
          "message": 6
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^\\[dev\\] Evaluating",
          "endsPattern": "^\\[dev\\] Ready$"
        }
      }
    },
    {
      // The Window served to a browser instead of a native window (launch.json, "Window in Chrome"); ready once it serves.
      "label": "runic: dev --browser",
      "detail": "dotnet runic dev --browser",
      "type": "process",
      "command": "dotnet",
//#if (hasLibrary)
      "args": ["runic", "dev", "--browser", "--project", "RunicWindowApp/RunicWindowApp.csproj"],
//#else
      "args": ["runic", "dev", "--browser"],
//#endif
      "dependsOn": ["dotnet: tool restore"],
      "isBackground": true,
      "problemMatcher": {
        // VS Code's $msCompile, after an optional "[host] ", "[app] " or "[vite] ": dev puts its child process's label
        // before each of that process's lines, so a rebuild's errors read "[host] /path/File.cs(18,5): error CS1002: ...".
        // The file holds no ": " and the subcategory before "error" no colon: dev also prints a failure as a sentence
        // ("..., so dev did not start: /path/index.ts(12,14): error TS2322: ..."), which is not a file.
        "owner": "msCompile",
        "applyTo": "allDocuments",
        "fileLocation": "absolute",
        "pattern": {
          "regexp": "^(?:\\[(?:host|app|vite)\\] )?\\s*(?:\\s*\\d+>)?(\\S(?:(?!:\\s).)*?)(?:\\((\\d+|\\d+,\\d+|\\d+,\\d+,\\d+,\\d+)\\))?\\s*:\\s+(?:([^\\s:]+)\\s+)?((?:fatal +)?error|warning|info)\\s+(\\w+\\d+)?\\s*:\\s*(.*)$",
          "file": 1,
          "location": 2,
          "severity": 4,
          "code": 5,
          "message": 6
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^\\[dev\\] (Evaluating|Window exited|Reloading)",
          "endsPattern": "^\\[dev\\] Ready$"
        }
      }
    },
    {
      "label": "build",
      "detail": "dotnet build",
      "type": "process",
      "command": "dotnet",
//#if (hasLibrary)
      "args": ["build", "${workspaceFolder}/RunicWindowApp/RunicWindowApp.csproj", "-p:GenerateFullPaths=true", "-consoleLoggerParameters:NoSummary;ForceNoAlign"],
//#else
      "args": ["build", "${workspaceFolder}/RunicWindowApp.csproj", "-p:GenerateFullPaths=true", "-consoleLoggerParameters:NoSummary;ForceNoAlign"],
//#endif
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$msCompile"
    },
    {
      // The frontend first, then the build, which keeps dev's development page in www/.
      "label": "runic: window",
      "dependsOn": ["runic: dev --no-window", "build"],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "runic: doctor",
      "detail": "dotnet runic doctor",
      "type": "process",
      "command": "dotnet",
//#if (hasLibrary)
      "args": ["runic", "doctor", "--project", "RunicWindowApp/RunicWindowApp.csproj"],
//#else
      "args": ["runic", "doctor"],
//#endif
      "dependsOn": ["dotnet: tool restore"],
      "problemMatcher": []
    }
  ]
}
