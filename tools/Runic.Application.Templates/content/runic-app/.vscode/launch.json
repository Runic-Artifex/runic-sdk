{
  "version": "0.2.0",
  "configurations": [
    {
      // F5: runs dotnet runic dev --no-window for the frontend, builds, then starts the Window under the debugger.
      "name": "Window",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "runic: window",
      "program": "${workspaceFolder}/bin/Debug/net10.0/RunicWindowApp",
      "windows": {
        "program": "${workspaceFolder}/bin/Debug/net10.0/RunicWindowApp.exe"
      },
      "cwd": "${workspaceFolder}",
      "env": {
        "DOTNET_ENVIRONMENT": "Development"
      },
      "console": "internalConsole"
    },
    {
      // dotnet runic dev starts the Window; pick the process from "[dev] Window started: process <pid>".
      // The session ends when dotnet watch restarts the Window after a C# edit.
      "name": "Attach to the Window (dotnet runic dev)",
      "type": "coreclr",
      "request": "attach",
      "preLaunchTask": "runic: dev",
      "processId": "${command:pickProcess}"
    },
    {
      // Every OS: dotnet runic dev --browser serves the Window without a native window, and VS Code's JavaScript debugger
      // opens it in Chrome through dev's address, so breakpoints in Frontend/src work on Linux and macOS too. The file is
      // the page dev writes, readable only by you, which opens the address with its one-time code. The pages run on
      // Chromium, not the Window's WebView, without native window features. For Edge, set "type": "msedge".
      "name": "Window in Chrome",
      "type": "chrome",
      "request": "launch",
      "preLaunchTask": "runic: dev --browser",
      "file": "${workspaceFolder}/obj/runic/dev-browser.html",
      "webRoot": "${workspaceFolder}/Frontend"
//#if (desktopHost)
    },
    {
      // Windows: the Window with WebView2's DevTools Protocol on port 9222, for "Window + WebView2 (Windows)". WebView2
      // ignores the variable in an elevated process, so start VS Code without elevation.
      "name": "Window with WebView2 debugging (Windows)",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/bin/Debug/net10.0/RunicWindowApp.exe",
      "cwd": "${workspaceFolder}",
      "env": {
        "DOTNET_ENVIRONMENT": "Development",
        "WEBVIEW2_ADDITIONAL_BROWSER_ARGUMENTS": "--remote-debugging-port=9222"
      },
      "console": "internalConsole"
    },
    {
      // Linux: the Window with WebKit's inspector on the port that dotnet runic dev --no-window's CDP adapter
      // attaches to, for "Window + WebKitGTK (Linux)".
      "name": "Window with JavaScript debugging (Linux)",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/bin/Debug/net10.0/RunicWindowApp",
      "cwd": "${workspaceFolder}",
      "env": {
        "DOTNET_ENVIRONMENT": "Development",
        "WEBKIT_INSPECTOR_SERVER": "127.0.0.1:9223"
      },
      "console": "internalConsole"
    },
    {
      // The page's JavaScript debugger on port 9222, which obj/runic/dev-session.json lists under debugEndpoints.
      // Windows: WebView2's DevTools Protocol endpoint (WEBVIEW2_ADDITIONAL_BROWSER_ARGUMENTS). Linux: dotnet
      // runic dev's CDP adapter for WebKitGTK, for a Window that dev starts, or "Window with JavaScript debugging (Linux)".
      // When another program holds 9222, dev starts its adapter on another port and warns that this configuration would
      // reach that program: set "port" to the one dev names while it runs. Under --no-window dev stops instead (RAPPDEV1017).
      "name": "Attach to the page (JavaScript)",
      "type": "msedge",
      "request": "attach",
      // 127.0.0.1, where the endpoint listens: js-debug's default, localhost, may connect to [::1] first.
      "address": "127.0.0.1",
      "port": 9222,
      "useWebView": true,
      "timeout": 30000,
      "webRoot": "${workspaceFolder}/Frontend"
//#endif
    }
//#if (desktopHost)
  ],
  "compounds": [
    {
      "name": "Window + WebView2 (Windows)",
      "configurations": ["Window with WebView2 debugging (Windows)", "Attach to the page (JavaScript)"],
      "preLaunchTask": "runic: window",
      "stopAll": true
    },
    {
      "name": "Window + WebKitGTK (Linux)",
      "configurations": ["Window with JavaScript debugging (Linux)", "Attach to the page (JavaScript)"],
      "preLaunchTask": "runic: window",
      "stopAll": true
    }
  ]
//#else
  ]
//#endif
}
