<?xml version="1.0" encoding="utf-8"?>
<!-- The MSIX manifest that dotnet runic package windows fills in from the project file (the fields in double braces). Publisher must equal the subject of the
     certificate that signs the package. Windows passes an opened URL or file to the application as its argument, and several selected
     files to one process, which DesktopPlatformServices.GetLaunch reads. -->
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
         xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
         xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
         IgnorableNamespaces="uap uap3 desktop rescap">
  <Identity Name="{{ApplicationId}}" Publisher="{{Publisher}}" Version="{{PackageVersion}}" ProcessorArchitecture="{{Architecture}}" />
  <Properties>
    <DisplayName>{{ApplicationName}}</DisplayName>
    <PublisherDisplayName>{{ApplicationName}}</PublisherDisplayName>
    <Logo>Assets\icon.png</Logo>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Resources>
    <Resource Language="en-us" />
  </Resources>
  <Applications>
    <Application Id="App" Executable="{{Executable}}.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="{{ApplicationName}}" Description="{{Description}}" BackgroundColor="transparent"
                          Square150x150Logo="Assets\icon.png" Square44x44Logo="Assets\icon.png" />
      <!-- Extensions for RunicApplicationUrlSchemes, RunicApplicationFileTypes and RunicApplicationWebLinkHosts, and the
           startup task (TaskId LoginStartup) that the application's login startup turns on and off. An app URI
           handler opens links only once each host serves /.well-known/windows-app-web-link naming this package. -->{{Extensions}}
    </Application>
  </Applications>
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
