{
  "$schema": "http://json.schemastore.org/template",
  "author": "Runic Artifex",
  "classifications": ["Desktop", "Runic Desktop", "Svelte"],
  "identity": "Runic.Application.Templates.Svelte",
  "name": "Runic Application Svelte",
  "shortName": "runic-app-svelte",
  "sourceName": "RunicDesktopApp",
  "preferNameDirectory": true,
  "tags": { "language": "C#", "type": "project" },
  "sources": [{
    "source": "./",
    "target": "./",
    "modifiers": [
      { "condition": "(packageManager != 'npm')", "exclude": ["Frontend/package-lock.json"] },
      { "condition": "(packageManager != 'pnpm')", "exclude": ["Frontend/pnpm-lock.yaml"] },
      { "condition": "(packageManager != 'bun')", "exclude": ["Frontend/bun.lock"] }
    ]
  }],
  "symbols": {
    "packageManager": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "npm",
      "replaces": "__PACKAGE_MANAGER_NAME__",
      "description": "JavaScript package manager used for install, build, and development scripts.",
      "choices": [
        { "choice": "npm", "description": "npm with package-lock.json" },
        { "choice": "pnpm", "description": "pnpm with pnpm-lock.yaml" },
        { "choice": "bun", "description": "Bun with bun.lock" }
      ]
    },
    "packageManagerDeclaration": {
      "type": "generated",
      "generator": "switch",
      "replaces": "__PACKAGE_MANAGER__",
      "parameters": {
        "evaluator": "C++",
        "datatype": "string",
        "cases": [
          { "condition": "(packageManager == 'pnpm')", "value": "pnpm@__PNPM_PACKAGE_MANAGER_VERSION__" },
          { "condition": "(packageManager == 'bun')", "value": "bun@__BUN_PACKAGE_MANAGER_VERSION__" },
          { "value": "npm@__NPM_PACKAGE_MANAGER_VERSION__" }
        ]
      }
    },
    "runicApplicationVersion": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "__RUNIC_APPLICATION_PACKAGE_VERSION__",
      "replaces": "__RUNIC_TOOLKIT_VERSION__"
    },
    "runicAssetsVersion": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "__RUNIC_ASSETS_PACKAGE_VERSION__",
      "replaces": "__RUNIC_ASSETS_VERSION__"
    },
    "runicDesktopVersion": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "__RUNIC_DESKTOP_PACKAGE_VERSION__",
      "replaces": "__RUNIC_DESKTOP_VERSION__"
    },
    "applicationBridgeNpm": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "__APPLICATION_BRIDGE_NPM_VERSION__",
      "replaces": "__APPLICATION_BRIDGE_NPM__"
    },
    "runicDesktopNpm": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "__RUNIC_DESKTOP_NPM_VERSION__",
      "replaces": "__RUNIC_DESKTOP_NPM__"
    },
    "runicSvelteNpm": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "__RUNIC_SVELTE_NPM_VERSION__",
      "replaces": "__RUNIC_SVELTE_NPM__"
    },
    "runicViteNpm": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "__RUNIC_VITE_NPM_VERSION__",
      "replaces": "__RUNIC_VITE_NPM__"
    }
  },
  "primaryOutputs": [{ "path": "RunicDesktopApp.csproj" }]
}
