{
  "$schema": "http://json.schemastore.org/template",
  "author": "Runic Artifex",
  "classifications": ["Desktop", "CS-WebUI", "Svelte"],
  "identity": "RunicToolkit.Templates.Svelte",
  "name": "RunicToolkit Svelte application",
  "shortName": "runic-toolkit-svelte",
  "sourceName": "RunicToolkitStarter",
  "preferNameDirectory": true,
  "tags": { "language": "C#", "type": "project" },
  "symbols": {
    "runicToolkitVersion": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "1.0.0-beta.1",
      "replaces": "__RUNIC_TOOLKIT_VERSION__"
    },
    "applicationBridgeNpm": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "0.1.0",
      "replaces": "__APPLICATION_BRIDGE_NPM__"
    },
    "runicSvelteNpm": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "0.1.0-preview.7.1",
      "replaces": "__RUNIC_SVELTE_NPM__"
    },
    "runicViteNpm": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "0.1.0-preview.7.1",
      "replaces": "__RUNIC_VITE_NPM__"
    }
  },
  "primaryOutputs": [{ "path": "RunicToolkitStarter.csproj" }]
}
