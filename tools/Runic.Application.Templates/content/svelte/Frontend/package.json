{
  "name": "@runic-artifex/runic-toolkitstarter-svelte",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "packageManager": "__PACKAGE_MANAGER__",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "type": "module",
  "scripts": {
    "build": "vite build",
    "contract:generate": "runic-bridge generate --authority csharp --project ../RunicDesktopApp.csproj",
    "contract:check": "runic-bridge check --authority csharp --project ../RunicDesktopApp.csproj",
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "7.3.1",
    "@popperjs/core": "2.11.8",
    "@runic-artifex/application-bridge": "__APPLICATION_BRIDGE_NPM__",
    "@runic-artifex/desktop": "__RUNIC_DESKTOP_NPM__",
    "@runic-artifex/svelte": "__RUNIC_SVELTE_NPM__",
    "bootstrap": "5.3.8",
    "effect": "3.22.1",
    "svelte": "5.57.0"
  },
  "devDependencies": {
    "@runic-artifex/application-bridge-tooling": "__APPLICATION_BRIDGE_NPM__",
    "@runic-artifex/vite-plugin-runic": "__RUNIC_VITE_NPM__",
    "@vitejs/devtools": "0.5.2",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.2.2"
  }
}
