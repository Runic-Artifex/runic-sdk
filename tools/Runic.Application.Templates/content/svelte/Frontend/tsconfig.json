{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "allowJs": true,
    "types": ["svelte", "vite/client", "@runic-artifex/vite-plugin-runic/virtual"]
  },
  "include": ["src/**/*.ts", "src/**/*.svelte.ts", "src/**/*.svelte", "vite.config.ts"]
}
