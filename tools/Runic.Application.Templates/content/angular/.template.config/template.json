{
  "$schema": "http://json.schemastore.org/template",
  "author": "Runic Artifex",
  "classifications": ["Desktop", "Runic Desktop", "Angular"],
  "identity": "Runic.Application.Templates.Angular",
  "name": "Runic Application Angular",
  "shortName": "runic-app-angular",
  "sourceName": "RunicDesktopApp",
  "preferNameDirectory": true,
  "tags": { "language": "C#", "type": "project" },
  "symbols": {
    "runicApplicationVersion": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "__RUNIC_APPLICATION_PACKAGE_VERSION__",
      "replaces": "__RUNIC_TOOLKIT_VERSION__"
    },
    "runicAssetsVersion": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "__RUNIC_ASSETS_PACKAGE_VERSION__",
      "replaces": "__RUNIC_ASSETS_VERSION__"
    },
    "runicDesktopVersion": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "__RUNIC_DESKTOP_PACKAGE_VERSION__",
      "replaces": "__RUNIC_DESKTOP_VERSION__"
    },
    "applicationBridgeNpm": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "__APPLICATION_BRIDGE_NPM_VERSION__",
      "replaces": "__APPLICATION_BRIDGE_NPM__"
    },
    "runicDesktopNpm": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "__RUNIC_DESKTOP_NPM_VERSION__",
      "replaces": "__RUNIC_DESKTOP_NPM__"
    },
    "runicAngularNpm": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "__RUNIC_ANGULAR_NPM_VERSION__",
      "replaces": "__RUNIC_ANGULAR_NPM__"
    }
  },
  "primaryOutputs": [{ "path": "RunicDesktopApp.csproj" }]
}
