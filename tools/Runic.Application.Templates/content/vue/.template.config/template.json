{
  "$schema": "http://json.schemastore.org/template",
  "author": "Runic Artifex",
  "classifications": [
    "Desktop",
    "Runic Views",
    "Vue"
  ],
  "identity": "Runic.Application.Templates.Vue",
  "name": "Runic Views Vue",
  "shortName": "runic-app-vue",
  "sourceName": "RunicWindowApp",
  "preferNameDirectory": true,
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "sources": [
    {
      "source": "./",
      "target": "./",
      "modifiers": [
        {
          "condition": "(packageManager != 'npm')",
          "exclude": [
            "Frontend/package-lock.json"
          ]
        },
        {
          "condition": "(packageManager != 'pnpm')",
          "exclude": [
            "Frontend/pnpm-lock.yaml"
          ]
        },
        {
          "condition": "(packageManager != 'bun')",
          "exclude": [
            "Frontend/bun.lock"
          ]
        }
      ]
    }
  ],
  "symbols": {
    "packageManager": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "npm",
      "replaces": "__PACKAGE_MANAGER_NAME__",
      "description": "JavaScript package manager used for frontend restore and development.",
      "choices": [
        {
          "choice": "npm",
          "description": "npm with package-lock.json"
        },
        {
          "choice": "pnpm",
          "description": "pnpm with pnpm-lock.yaml"
        },
        {
          "choice": "bun",
          "description": "Bun with bun.lock"
        }
      ]
    },
    "packageManagerDeclaration": {
      "type": "generated",
      "generator": "switch",
      "replaces": "__PACKAGE_MANAGER__",
      "parameters": {
        "evaluator": "C++",
        "datatype": "string",
        "cases": [
          {
            "condition": "(packageManager == 'pnpm')",
            "value": "pnpm@__PNPM_PACKAGE_MANAGER_VERSION__"
          },
          {
            "condition": "(packageManager == 'bun')",
            "value": "bun@__BUN_PACKAGE_MANAGER_VERSION__"
          },
          {
            "value": "npm@__NPM_PACKAGE_MANAGER_VERSION__"
          }
        ]
      }
    },
    "frontendBuildCommand": {
      "type": "generated",
      "generator": "switch",
      "replaces": "__FRONTEND_BUILD_COMMAND__",
      "parameters": {
        "evaluator": "C++",
        "datatype": "string",
        "cases": [
          {
            "condition": "(packageManager == 'pnpm')",
            "value": "pnpm run build"
          },
          {
            "condition": "(packageManager == 'bun')",
            "value": "bun run --bun build"
          },
          {
            "value": "npm run build"
          }
        ]
      }
    },
    "runicViewsVersion": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "__RUNIC_VIEWS_NUGET_VERSION_DEFAULT__",
      "replaces": "__RUNIC_VIEWS_NUGET_VERSION__"
    },
    "dotnetRunicVersion": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "__DOTNET_RUNIC_VERSION_DEFAULT__",
      "replaces": "__DOTNET_RUNIC_VERSION__"
    }
  },
  "primaryOutputs": [
    {
      "path": "RunicWindowApp.csproj"
    }
  ]
}
