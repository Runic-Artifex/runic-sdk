<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>RunicToolkitStarter</RootNamespace>
    <RunicToolkitFrontendNodeEnabled>true</RunicToolkitFrontendNodeEnabled>
    <RunicToolkitFrontendCompilerEnabled>true</RunicToolkitFrontendCompilerEnabled>
    <RunicMarkupCsharpMarkupEnabled>false</RunicMarkupCsharpMarkupEnabled>
    <RunicToolkitFrontendWorkspace>@runic-artifex/runic-toolkitstarter-cwhtml</RunicToolkitFrontendWorkspace>
    <RunicToolkitFrontendPackageDirectory>$(MSBuildProjectDirectory)/Frontend</RunicToolkitFrontendPackageDirectory>
    <RunicToolkitFrontendOutputDirectory>$(MSBuildProjectDirectory)/Frontend/dist</RunicToolkitFrontendOutputDirectory>
    <RunicToolkitFrontendWorkspaceRoot>$(MSBuildProjectDirectory)</RunicToolkitFrontendWorkspaceRoot>
    <RunicToolkitFrontendViteDevServerEnabled>true</RunicToolkitFrontendViteDevServerEnabled>
    <RunicToolkitFrontendViteDevServerEntry>/src/main.js</RunicToolkitFrontendViteDevServerEntry>
    <RunicToolkitFrontendBuildArguments>-- --mode production</RunicToolkitFrontendBuildArguments>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="RunicToolkit.Frontend.Sdk" Version="1.0.0" PrivateAssets="all" />
    <PackageReference Include="RunicMarkup.Build" Version="1.0.0" PrivateAssets="all" />
    <PackageReference Include="RunicMarkup.RunicToolkit.CommunityToolkit" Version="1.0.0" PrivateAssets="all" />
    <PackageReference Include="RunicMarkup.RunicToolkit.Htmx.CsWebUi.App" Version="1.0.0-beta.1" />
    <PackageReference Include="RunicMarkup.RunicToolkit.Htmx.Js" Version="1.0.0" />
    <PackageReference Include="RunicToolkit.MVVM.CommunityToolkit" Version="1.0.0" />
    <PackageReference Include="RunicToolkit.MVVM" Version="1.0.0" />
  </ItemGroup>

  <ItemGroup>
    <CwhtmlCodeBehind Include="CounterRenderModel.cs" />
  </ItemGroup>
</Project>
