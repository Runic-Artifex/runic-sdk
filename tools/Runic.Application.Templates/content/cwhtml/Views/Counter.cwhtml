@namespace RunicToolkitStarter
@view CounterView(RunicToolkitStarter.CounterRenderModel model)
main #counter .container .py-5 data-webui-view="counter"
    data-rtk-adapter="community-toolkit" {
    section .card .border-0 .shadow {
        div .card-body .p-5 {
            span .badge .text-bg-primary .mb-3 { "cwhtml + HTMX + CsWebUi" }
            h1 .display-5 { "Native C# counter" }
            p .lead { (model.Summary) }
            p .display-1 .fw-bold aria-live="polite" {
                (model.Count.ToString(System.Globalization.CultureInfo.InvariantCulture))
            }
            form data-rtk-action="increment"
                data-rtk-command=(nameof(CounterViewModel.IncrementCommand))
                data-hx-target="#counter"
                data-hx-swap="outerHTML" {
                label .form-label for="step" { "Increment step" }
                input #step .form-control
                    class=(model.StepErrors.Count > 0 ? "is-invalid" : null)
                    type="number"
                    name="step"
                    min="1"
                    max="10"
                    value=(model.Step.ToString(System.Globalization.CultureInfo.InvariantCulture))
                    data-rtk-member=(nameof(CounterViewModel.Step))
                    data-rtk-convert="int32"
                    aria-invalid=(model.StepErrors.Count > 0 ? "true" : null);
                @if (model.StepErrors.Count > 0) {
                    div .invalid-feedback { (string.Join(" ", model.StepErrors)) }
                }
                button .btn .btn-primary .btn-lg type="submit" {
                    i .fa-solid .fa-plus aria-hidden="true" {}
                    " Increment in C#"
                }
            }
            h2 .h6 .mt-4 { "History" }
            div .d-flex .flex-wrap .gap-2 {
                @foreach (int value in model.History) {
                    span .badge .text-bg-light {
                        (value.ToString(System.Globalization.CultureInfo.InvariantCulture))
                    }
                }
            }
        }
    }
}
