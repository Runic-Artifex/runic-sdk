{
  "$schema": "http://json.schemastore.org/template",
  "author": "RunicArtifex",
  "classifications": ["Localization", "Resources", "Runic"],
  "identity": "RunicArtifex.TextResources.Item",
  "name": "Runic Text Resources files",
  "shortName": "runic-textresources",
  "description": "Adds a minimal compiler-valid schema-v2 text-resource catalog and default locale document.",
  "tags": {
    "language": "JSON",
    "type": "item"
  },
  "preferNameDirectory": false,
  "symbols": {
    "catalog": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "product",
      "description": "Portable catalog identifier.",
      "replaces": "__CATALOG__",
      "fileRename": "_catalog_"
    },
    "defaultLocale": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "en",
      "description": "Default BCP-47 locale tag.",
      "replaces": "__DEFAULT_LOCALE__",
      "fileRename": "_defaultLocale_"
    },
    "namespace": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "Customer.Product",
      "description": "Namespace for generated C# APIs.",
      "replaces": "__NAMESPACE__"
    },
    "className": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "ProductText",
      "description": "Class name for generated C# APIs.",
      "replaces": "__CLASS_NAME__"
    }
  }
}
