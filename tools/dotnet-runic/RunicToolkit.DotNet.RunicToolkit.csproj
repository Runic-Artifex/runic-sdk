<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>RunicToolkit.DotNet.RunicToolkit</AssemblyName>
    <RootNamespace>RunicToolkit.DotNet.RunicToolkit</RootNamespace>
    <PackageId>RunicToolkit.DotNet.RunicToolkit</PackageId>
    <Description>Coordinated development loop for native CsWebUi RunicToolkit applications.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>dotnet-runic-toolkit</ToolCommandName>
    <RunicToolkitShippingProject>true</RunicToolkitShippingProject>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <None Update="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
