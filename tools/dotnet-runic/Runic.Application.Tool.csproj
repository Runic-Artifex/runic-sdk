<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../eng/build/application.props" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(RunicApplicationDefaultTargetFramework)</TargetFramework>
    <AssemblyName>dotnet-runic</AssemblyName>
    <RootNamespace>Runic.Application.Tool</RootNamespace>
    <PackageId>dotnet-runic</PackageId>
    <Description>Generated-command development coordination for Runic Views Window projects.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>dotnet-runic</ToolCommandName>
    <!-- Build tool: run on a newer .NET runtime when the 10.0 runtime is absent (#614). With 10.0 installed it still runs on 10.0. -->
    <RollForward>Major</RollForward>
    <RunicApplicationShippingProject>true</RunicApplicationShippingProject>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Faults link to their catalog entry at the release tag. -->
    <RunicGenerateReleaseLinks>true</RunicGenerateReleaseLinks>
    <!-- LibraryImport for the signals that stop the application gracefully. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- assets pack compiles the packer's command source as a subcommand (AssetPackCommand.cs). -->
    <DefineConstants>$(DefineConstants);RUNIC_ASSETS_PACK_SUBCOMMAND</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <None Update="README.md" Pack="true" PackagePath="\" />
    <EmbeddedResource Include="metadata/runic.compatibility-set.json"
                      LogicalName="Runic.Application.Tool.runic.compatibility-set.json" />
    <PackageReference Include="Runic.CommandLine" />
    <ProjectReference Include="../../packages/dotnet/Runic.Assets/Runic.Assets.csproj" />
    <Compile Include="../Runic.Assets.Packer/AssetPackCommand.cs" Link="Shared/AssetPackCommand.cs" />
  </ItemGroup>
  <!-- package: the runic-app template's manifests are the embedded defaults that a project's packaging directory overrides. -->
  <ItemGroup>
    <EmbeddedResource Include="../Runic.Application.Templates/content/runic-app/packaging/windows/AppxManifest.xml" LogicalName="Runic.Application.Tool.Packaging.windows.AppxManifest.xml" />
    <EmbeddedResource Include="../Runic.Application.Templates/content/runic-app/packaging/macos/Info.plist" LogicalName="Runic.Application.Tool.Packaging.macos.Info.plist" />
    <EmbeddedResource Include="../Runic.Application.Templates/content/runic-app/packaging/macos/entitlements.plist" LogicalName="Runic.Application.Tool.Packaging.macos.entitlements.plist" />
    <EmbeddedResource Include="../Runic.Application.Templates/content/runic-app/packaging/linux/app.desktop" LogicalName="Runic.Application.Tool.Packaging.linux.app.desktop" />
    <EmbeddedResource Include="../Runic.Application.Templates/content/runic-app/packaging/linux/app.metainfo.xml" LogicalName="Runic.Application.Tool.Packaging.linux.app.metainfo.xml" />
    <EmbeddedResource Include="../Runic.Application.Templates/content/runic-app/packaging/linux/app.service" LogicalName="Runic.Application.Tool.Packaging.linux.app.service" />
    <EmbeddedResource Include="../Runic.Application.Templates/content/runic-app/packaging/linux/flatpak.yml" LogicalName="Runic.Application.Tool.Packaging.linux.flatpak.yml" />
    <Compile Include="../../packages/dotnet/Runic.Desktop/Internal/Gtk4NativeLibraries.cs" Link="Shared/Gtk4NativeLibraries.cs" />
    <Compile Include="../../packages/dotnet/Runic.Desktop/Internal/Gtk3NativeLibraries.cs" Link="Shared/Gtk3NativeLibraries.cs" />
  </ItemGroup>
  <Import Project="../../eng/build/application.targets" />
  <ItemGroup>
    <PackageReference Include="Runic.CommandLine.Spectre" />
  </ItemGroup>
</Project>
