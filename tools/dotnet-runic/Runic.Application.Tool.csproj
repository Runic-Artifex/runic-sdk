<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(RunicToolkitDefaultTargetFramework)</TargetFramework>
    <AssemblyName>dotnet-runic</AssemblyName>
    <RootNamespace>Runic.Application.Tool</RootNamespace>
    <PackageId>dotnet-runic</PackageId>
    <Description>Generated-command development coordination for Runic Application projects.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>dotnet-runic</ToolCommandName>
    <RunicToolkitShippingProject>true</RunicToolkitShippingProject>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Runic.Application.Bridge.Inspector/Runic.Application.Bridge.Inspector.csproj" ReferenceOutputAssembly="false" GlobalPropertiesToRemove="PublishAot;PublishTrimmed;RuntimeIdentifier;SelfContained" />
  </ItemGroup>
  <Target Name="IncludeBridgeInspector" BeforeTargets="GetCopyToOutputDirectoryItems;_GetPackageFiles;GenerateNuspec" DependsOnTargets="ResolveProjectReferences">
    <ItemGroup>
      <Content Include="../Runic.Application.Bridge.Inspector/bin/$(Configuration)/net10.0/**/*" Exclude="../Runic.Application.Bridge.Inspector/bin/$(Configuration)/net10.0/**/*.pdb">
        <Link>bridge-inspector/%(RecursiveDir)%(Filename)%(Extension)</Link>
        <TargetPath>bridge-inspector/%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <Pack>false</Pack>
      </Content>
    </ItemGroup>
  </Target>
  <Target Name="CopyBridgeInspector" AfterTargets="Build;Publish">
    <ItemGroup><_BridgeInspectorOutput Include="../Runic.Application.Bridge.Inspector/bin/$(Configuration)/net10.0/**/*" /></ItemGroup>
    <Copy SourceFiles="@(_BridgeInspectorOutput)" DestinationFiles="@(_BridgeInspectorOutput->'$(TargetDir)bridge-inspector/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_BridgeInspectorOutput)" DestinationFiles="@(_BridgeInspectorOutput->'$(PublishDir)bridge-inspector/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" Condition="'$(PublishDir)' != ''" />
  </Target>
  <ItemGroup>
    <None Update="README.md" Pack="true" PackagePath="\" />
    <EmbeddedResource Include="../../eng/runic.compatibility-set.json"
                      LogicalName="Runic.Application.Tool.runic.compatibility-set.json" />
    <ProjectReference Include="../../../runic-command-line/src/Runic.CommandLine/Runic.CommandLine.csproj" />
    <ProjectReference Include="../../../runic-command-line/src/Runic.CommandLine.Generators/Runic.CommandLine.Generators.csproj"
                      PrivateAssets="all"
                      ReferenceOutputAssembly="false"
                      OutputItemType="Analyzer" />
  </ItemGroup>
</Project>
