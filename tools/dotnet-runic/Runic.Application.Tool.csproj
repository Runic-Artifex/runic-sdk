<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../eng/build/application.props" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(RunicApplicationDefaultTargetFramework)</TargetFramework>
    <AssemblyName>dotnet-runic</AssemblyName>
    <RootNamespace>Runic.Application.Tool</RootNamespace>
    <PackageId>dotnet-runic</PackageId>
    <Description>Generated-command development coordination for Runic Views Window projects.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>dotnet-runic</ToolCommandName>
    <RunicApplicationShippingProject>true</RunicApplicationShippingProject>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <None Update="README.md" Pack="true" PackagePath="\" />
    <EmbeddedResource Include="metadata/runic.compatibility-set.json"
                      LogicalName="Runic.Application.Tool.runic.compatibility-set.json" />
    <PackageReference Include="Runic.CommandLine" />
    <Compile Include="../../packages/dotnet/Runic.Desktop/Internal/Gtk4NativeLibraries.cs" Link="Shared/Gtk4NativeLibraries.cs" />
  </ItemGroup>
  <Import Project="../../eng/build/application.targets" />
  <ItemGroup>
    <PackageReference Include="Runic.CommandLine.Spectre" />
  </ItemGroup>
</Project>
