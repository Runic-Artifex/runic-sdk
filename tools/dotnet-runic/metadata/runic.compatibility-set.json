  "support": {
    "statuses": {
      "ci-verified": "Runic CI builds and runs the host's native window layer on this RID for changes that affect it.",
      "packaged-unverified": "The packages ship native assets for it, but Runic CI does not run it. Test the published application on a real target machine.",
      "unsupported": "Runic does not ship the native assets the host needs."
    },
    "hosts": [
      {
        "id": "desktop",
        "name": "Runic Desktop",
        "package": "Runic.Application.Desktop",
        "targets": [
          {
            "rid": "linux-x64",
            "status": "ci-verified",
            "reason": "Covered by the Native / linux-x64 CI job."
          },
          {
            "rid": "win-x64",
            "status": "ci-verified",
            "reason": "Covered by the Native / win-x64 CI job."
          },
          {
            "rid": "osx-arm64",
            "status": "ci-verified",
            "reason": "Covered by the Native / osx-arm64 CI job."
          },
          {
            "rid": "linux-arm64",
            "status": "packaged-unverified",
            "reason": "Uses the system GTK and WebKitGTK libraries; no arm64 Linux CI runner."
          },
          {
            "rid": "linux-musl-x64",
            "status": "packaged-unverified",
            "reason": "Uses the system GTK and WebKitGTK libraries; no musl CI runner."
          },
          {
            "rid": "linux-musl-arm64",
            "status": "packaged-unverified",
            "reason": "Uses the system GTK and WebKitGTK libraries; no musl CI runner."
          },
          {
            "rid": "win-arm64",
            "status": "packaged-unverified",
            "reason": "Ships the arm64 WebView2 loader; no Windows on Arm CI runner."
          },
          {
            "rid": "osx-x64",
            "status": "packaged-unverified",
            "reason": "Uses the system WKWebView; no Intel macOS CI runner."
          }
        ]
      },
      {
        "id": "cswebui",
        "name": "CS-WebUI",
        "package": "Runic.Application.CsWebUi",
        "targets": [
          {
            "rid": "linux-x64",
            "status": "ci-verified",
            "reason": "Covered by the Native / linux-x64 CI job."
          },
          {
            "rid": "win-x64",
            "status": "ci-verified",
            "reason": "Covered by the Native / win-x64 CI job."
          },
          {
            "rid": "osx-arm64",
            "status": "ci-verified",
            "reason": "Covered by the Native / osx-arm64 CI job."
          },
          {
            "rid": "linux-arm64",
            "status": "packaged-unverified",
            "reason": "CsWebUi.Native ships a glibc linux-arm64 library; no arm64 Linux CI runner."
          },
          {
            "rid": "linux-musl-x64",
            "status": "unsupported",
            "reason": "CS-WebUI ships no native library for linux-musl-x64; its Linux library needs glibc 2.34 or newer.",
            "remediation": "Publish for a glibc distribution (linux-x64 or linux-arm64), or use the Runic Desktop host."
          },
          {
            "rid": "linux-musl-arm64",
            "status": "unsupported",
            "reason": "CS-WebUI ships no native library for linux-musl-arm64; its Linux library needs glibc 2.34 or newer.",
            "remediation": "Publish for a glibc distribution (linux-x64 or linux-arm64), or use the Runic Desktop host."
          },
          {
            "rid": "win-arm64",
            "status": "unsupported",
            "reason": "CS-WebUI ships no native library for win-arm64.",
            "remediation": "Publish for win-x64, which runs under emulation on Windows on Arm, or use the Runic Desktop host."
          },
          {
            "rid": "osx-x64",
            "status": "packaged-unverified",
            "reason": "CsWebUi.Native ships an osx-x64 library; no Intel macOS CI runner."
          }
        ]
      }
    ],
    "requirements": [
      {
        "id": "windows",
        "os": "win",
        "hosts": [
          "desktop",
          "cswebui"
        ],
        "component": "Windows 11, or a Windows 10 release that .NET 10 supports",
        "minimum": null,
        "note": "The .NET 10 supported-OS policy."
      },
      {
        "id": "webview2",
        "os": "win",
        "hosts": [
          "desktop",
          "cswebui"
        ],
        "component": "Microsoft Edge WebView2 Runtime",
        "minimum": null,
        "note": "Evergreen runtime; Windows 11 includes it. CS-WebUI uses it only when no Chromium-family browser is installed."
      },
      {
        "id": "macos-desktop",
        "os": "osx",
        "hosts": [
          "desktop"
        ],
        "component": "macOS",
        "minimum": "15",
        "note": "The oldest macOS in the .NET 10 supported-OS policy. WKWebView is part of macOS."
      },
      {
        "id": "macos-cswebui",
        "os": "osx",
        "hosts": [
          "cswebui"
        ],
        "component": "macOS",
        "minimum": "15",
        "note": "The bundled native library loads on macOS 15 (cs-webui package smoke on macos-15)."
      },
      {
        "id": "glibc",
        "os": "linux",
        "hosts": [
          "cswebui"
        ],
        "component": "glibc",
        "minimum": "2.34",
        "note": "The CsWebUi.Native Linux library; musl distributions are unsupported."
      },
      {
        "id": "gtk3",
        "os": "linux",
        "hosts": [
          "desktop",
          "cswebui"
        ],
        "component": "GTK 3 and WebKitGTK 4.1",
        "minimum": null,
        "note": "Runic Desktop's default Linux host, and CS-WebUI's fallback when no Chromium-family browser is installed."
      },
      {
        "id": "gtk4",
        "os": "linux",
        "hosts": [
          "desktop"
        ],
        "component": "GTK",
        "minimum": "4.12",
        "note": "With Runic.Desktop.Gtk4."
      },
      {
        "id": "webkitgtk6",
        "os": "linux",
        "hosts": [
          "desktop"
        ],
        "component": "WebKitGTK",
        "minimum": "6.0",
        "note": "With Runic.Desktop.Gtk4."
      }
    ]
