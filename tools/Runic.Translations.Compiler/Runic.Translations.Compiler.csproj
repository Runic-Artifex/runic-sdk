<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(RunicTranslationsGeneratorTargetFramework)</TargetFramework>
    <AssemblyName>Runic.Translations.Compiler</AssemblyName>
    <RootNamespace>Runic.Translations.Compiler</RootNamespace>
    <Description>Pure deterministic compiler kernel for Runic Translations.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- These names deliberately mirror the normative serialized descriptor vocabulary. -->
    <NoWarn>$(NoWarn);CA1720</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Update="README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" />
    <None Include="..\..\..\eng\cldr\LICENSE" Pack="true" PackagePath="licenses" />
  </ItemGroup>
</Project>
