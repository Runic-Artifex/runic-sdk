<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../eng/build/translations.props" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>dotnet-runic-translations</AssemblyName>
    <RootNamespace>Runic.Translations.Tool</RootNamespace>
    <PackageId>dotnet-runic-translations</PackageId>
    <Description>Deterministic validation and generation tool for Runic Translations.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>runic-translations</ToolCommandName>
    <RunicTranslationsShippingProject>true</RunicTranslationsShippingProject>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <CopyDocumentationFilesFromPackages>true</CopyDocumentationFilesFromPackages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../packages/dotnet/Runic.CommandLine/Runic.CommandLine.csproj" />
    <ProjectReference Include="..\..\packages\dotnet\Runic.Translations.Authoring\Runic.Translations.Authoring.csproj" />
    <ProjectReference Include="..\Runic.Translations.Compiler\Runic.Translations.Compiler.csproj" />
    <ProjectReference Include="..\..\packages\dotnet\Runic.Translations.Tooling\Runic.Translations.Tooling.csproj" />
    <EmbeddedResource Include="..\..\specs\translations\schemas\locale-artifact-v1.schema.json" LogicalName="Runic.Translations.Tool.Schemas.locale-artifact-v1.schema.json" />
    <EmbeddedResource Include="..\..\specs\translations\schemas\locale-artifact-v2.schema.json" LogicalName="Runic.Translations.Tool.Schemas.locale-artifact-v2.schema.json" />
    <EmbeddedResource Include="..\..\specs\translations\schemas\external-pack-v1.schema.json" LogicalName="Runic.Translations.Tool.Schemas.external-pack-v1.schema.json" />
    <EmbeddedResource Include="..\..\specs\translations\schemas\template-manifest-v1.schema.json" LogicalName="Runic.Translations.Tool.Schemas.template-manifest-v1.schema.json" />
    <EmbeddedResource Include="..\..\specs\translations\schemas\asset-manifest-v1.schema.json" LogicalName="Runic.Translations.Tool.Schemas.asset-manifest-v1.schema.json" />
    <EmbeddedResource Include="..\..\specs\translations\schemas\web-module-manifest-v1.schema.json" LogicalName="Runic.Translations.Tool.Schemas.web-module-manifest-v1.schema.json" />
    <EmbeddedResource Include="..\..\specs\translations\schemas\message-ast-v2.schema.json" LogicalName="Runic.Translations.Tool.Schemas.message-ast-v2.schema.json" />
    <EmbeddedResource Include="..\..\specs\translations\schemas\locale-pack-v2.schema.json" LogicalName="Runic.Translations.Tool.Schemas.locale-pack-v2.schema.json" />
    <EmbeddedResource Include="..\..\specs\translations\schemas\editor-state-v1.schema.json" LogicalName="Runic.Translations.Tool.Schemas.editor-state-v1.schema.json" />
    <EmbeddedResource Include="..\..\specs\translations\schemas\capabilities-v1.schema.json" LogicalName="Runic.Translations.Tool.Schemas.capabilities-v1.schema.json" />
    <EmbeddedResource Include="..\..\specs\translations\schemas\project-v1.schema.json" LogicalName="Runic.Translations.Tool.Schemas.project-v1.schema.json" />
    <None Include="../../specs/translations/licenses/Tomlyn-LICENSE.txt" Pack="true" PackagePath="licenses" />
    <None Update="README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\specs\translations\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" />
    <None Include="..\..\specs\translations\cldr\LICENSE" Pack="true" PackagePath="licenses" />
  </ItemGroup>
  <Import Project="../../eng/build/translations.targets" />
  <ItemGroup>
    <ProjectReference Include="../../packages/dotnet/Runic.CommandLine.Spectre/Runic.CommandLine.Spectre.csproj" />
  </ItemGroup>
</Project>
