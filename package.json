{
  "name": "@runic-artifex/sdk-workspace",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": "1.4.2",
    "node": ">=24.18.0 <25"
  },
  "workspaces": [
    "packages/web/angular",
    "packages/web/vite-plugin-runic",
    "packages/web/svelte",
    "packages/web/sveltekit",
    "packages/web/views",
    "packages/web/react",
    "packages/web/vue"
  ],
  "scripts": {
    "bootstrap": "bun eng/run.mjs bootstrap",
    "build": "bun eng/run.mjs build",
    "test": "bun eng/test.mjs",
    "verify": "bun eng/test.mjs",
    "pack": "bun eng/run.mjs pack",
    "verify-packages": "bun eng/run.mjs verify-packages",
    "affected": "bun eng/run.mjs affected",
    "example:first-window": "bun eng/run.mjs example:first-window",
    "example:notes": "bun eng/run.mjs example:notes",
    "verify:templates": "bun eng/verify-templates.mjs",
    "version:bump": "bun eng/version.mjs bump",
    "regen": "bun tools/dotnet-runic/metadata/generate.mjs --write && bun eng/generate-shipping-projects.mjs && bun eng/run.mjs build",
    "ci": "bun eng/ci/local.mjs",
    "dependencies:audit": "bun eng/dependencies/audit.mjs"
  },
  "devDependencies": {
    "@runic-artifex/views": "workspace:*",
    "typescript": "6.0.3",
    "effect": "4.0.0",
    "esbuild": "0.28.2",
    "playwright-core": "1.63.0"
  }
}
