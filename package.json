{
  "name": "@runic-artifex/sdk-workspace",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "workspaces": [
    "packages/runic-toolkit",
    "packages/web/application-bridge",
    "packages/web/application-bridge-tooling",
    "packages/web/angular",
    "packages/runic-desktop",
    "packages/web/desktop",
    "packages/web/vite-plugin-runic-translations",
    "packages/web/vite-plugin-runic",
    "packages/runic-svelte",
    "packages/web/svelte",
    "packages/web/sveltekit",
    "apps/translations-editor/Frontend",
    "docs",
    "examples/current/customer-migration/Host/Frontend"
  ],
  "scripts": {
    "bootstrap": "node eng/run.mjs bootstrap",
    "build": "node eng/run.mjs build",
    "test": "node eng/run.mjs test",
    "verify": "node eng/run.mjs verify",
    "pack": "node eng/run.mjs pack",
    "verify-packages": "node eng/run.mjs verify-packages",
    "dev:docs": "node eng/run.mjs dev:docs",
    "dev:editor": "node eng/run.mjs dev:editor",
    "affected": "node eng/run.mjs affected",
    "example:counter": "dotnet run --project examples/current/counter/Counter.csproj",
    "verify:templates": "node eng/verify-templates.mjs",
    "example:customers": "node eng/run.mjs example:customers",
    "verify:customers": "node eng/run.mjs verify:customers"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "effect": "3.22.1"
  }
}
