{
  "name": "@runic-artifex/sdk-workspace",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": "1.4.2",
    "node": ">=24.18.0 <25"
  },
  "workspaces": [
    "packages/web/application-bridge",
    "packages/web/application-bridge-tooling",
    "packages/web/angular",
    "packages/web/desktop",
    "packages/web/vite-plugin-runic-translations",
    "packages/web/vite-plugin-runic",
    "packages/web/svelte",
    "packages/web/sveltekit",
    "apps/translations-editor/Frontend",
    "docs",
    "examples/customer-migration/Host/Frontend"
  ],
  "scripts": {
    "bootstrap": "bun eng/run.mjs bootstrap",
    "build": "bun eng/run.mjs build",
    "test": "bun run ci",
    "verify": "bun run ci",
    "pack": "bun eng/run.mjs pack",
    "verify-packages": "bun eng/run.mjs verify-packages",
    "dev:docs": "bun eng/run.mjs dev:docs",
    "dev:editor": "bun eng/run.mjs dev:editor",
    "affected": "bun eng/run.mjs affected",
    "example:counter": "dotnet run --project examples/counter/Counter.csproj",
    "verify:footprint": "bun eng/verify-host-footprint.mjs",
    "verify:templates": "bun eng/verify-templates.mjs",
    "example:customers": "bun eng/run.mjs example:customers",
    "verify:customers": "bun eng/run.mjs verify:customers",
    "verify:bridge": "bun eng/bridge/verify-artifacts.mjs",
    "ci": "bun eng/ci/local.mjs",
    "dependencies:audit": "bun eng/dependencies/audit.mjs"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "effect": "4.0.0-rc.112",
    "esbuild": "0.28.2",
    "playwright-core": "1.63.0"
  }
}
